{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scrapmycaruae-headless",
  "compatibility_date": "2026-09-21",
  "pages_build_output_dir": "./dist",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "STATIC_ASSETS"
  }
}