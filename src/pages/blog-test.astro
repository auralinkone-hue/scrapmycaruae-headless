---
export const prerender = false;

import { wixClient } from '../lib/wix';
import BaseLayout from '../layouts/BaseLayout.astro';

let blogPosts = [];
let errorMessage = '';

try {
  const result = await wixClient.posts
    .queryPosts()
    .limit(10)
    .find();

  blogPosts = result.items ?? [];
} catch (error) {
  errorMessage =
    error instanceof Error ? error.message : String(error);
}
---

<BaseLayout
  title="Wix Blog Connection Test"
  description="Internal Wix Blog connection diagnostic."
  canonical="/blog-test"
  noindex={true}
>
  <main>
      <h1>Wix Blog Connection Test</h1>

      {errorMessage && (
        <div>
          <strong>Error:</strong>
          <pre>{errorMessage}</pre>
        </div>
      )}

      {!errorMessage && (
        <>
          <p>Posts returned: {blogPosts.length}</p>

          <ul>
            {blogPosts.map((post) => (
              <li>
                <strong>{post.title}</strong>
                <br />
                <span>/post/{post.slug}</span>
              </li>
            ))}
          </ul>
        </>
      )}
  </main>
</BaseLayout>
