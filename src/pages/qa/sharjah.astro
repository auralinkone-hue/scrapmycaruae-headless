---
export const prerender = false;
const widths=[390,430,768,1024,1440];
const requested=Number(Astro.url.searchParams.get('width'));
const width=widths.includes(requested)?requested:390;
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Sharjah responsive QA</title><style>body{margin:0;background:#dfe8d8;font:14px system-ui;color:#183c29}nav{display:flex;gap:20px;padding:15px;background:white}nav a{color:#174b28}p{margin:12px}iframe{display:block;border:0;margin:0 0 20px 0;background:white}</style></head><body><nav aria-label="QA viewport">{widths.map(value=><a href={`?width=${value}`}>Viewport {value}</a>)}</nav><p>Staging layout review — {width}px</p><iframe title="Sharjah page preview" src="/locations/sharjah/" width={width} height="1100"></iframe></body></html>
