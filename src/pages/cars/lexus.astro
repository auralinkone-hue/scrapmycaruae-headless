---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import ConditionGraphic from '../../components/manufacturer/ConditionGraphic.astro';
import '../../components/manufacturer/manufacturer-body.css';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels,modelLabel,resolveModelGuidance} from '../../lib/manufacturer-models';
import {lexusPreferred,lexusProfiles,lexusConditions,lexusFactors,lexusFaqs} from '../../lib/lexus-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const models=manufacturerModels(vehicleData.models,'LEXUS').map(item=>item.model);
const choices=lexusPreferred.filter(model=>models.includes(model));const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,lexusProfiles);const condition=lexusConditions[0];
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['Lexus','/cars/lexus/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:lexusFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\u003c');
---
<BaseLayout title="Scrap Lexus Car in UAE | Free Valuation | Scrap My Car UAE" description="Request a free Lexus scrap-car valuation in the UAE. Explore model and condition guidance for damaged, non-running, old or unwanted vehicles and collection." canonical="/cars/lexus/" ogImage="/sections/lexus-es-valuation.webp">
 <Fragment slot="head"><script type="application/ld+json" set:html={json(breadcrumb)} /><script type="application/ld+json" set:html={json(faqSchema)} /></Fragment>
 <main class="lexus-page" data-manufacturer-page>
 <div class="lexus-shell"><nav class="lexus-breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
 <section class="lexus-hero" aria-labelledby="lexus-title"><header><p class="eyebrow">Lexus / UAE scrap valuation</p><h1 id="lexus-title"><span>Scrap Your Lexus</span> <span>Car in the UAE</span></h1><p class="hero-intro">Request a free scrap valuation for a damaged, non-running, old or unwanted Lexus. Share your model, year and the condition you know.</p><span class="hero-rule" aria-hidden="true"></span></header>
 <figure class="lexus-hero-photo"><img src="/sections/lexus-es-valuation.webp" srcset="/sections/lexus-es-valuation-640.webp 640w, /sections/lexus-es-valuation-960.webp 960w, /sections/lexus-es-valuation.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 43vw, 510px" width="1440" height="960" fetchpriority="high" alt="Used early-2010s ES-style Lexus sedan with front-wing wear and bumper scuffs at an independent UAE assessment forecourt" /></figure>
 <div class="lexus-quote" id="lexus-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
 <ul class="lexus-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running cars</li><li><i class="ph ph-key" aria-hidden="true"></i>Individual recovery review</li></ul></section>
 <section class="lexus-condition" data-condition-explorer aria-labelledby="condition-title"><header class="section-heading"><div><p class="eyebrow">01 / Describe the vehicle</p><h2 id="condition-title">What is your Lexus<br /><span>like today?</span></h2></div><p>Choose a condition for practical assessment notes. Share what you already know about the vehicle.</p></header><script type="application/json" data-condition-config set:html={json(lexusConditions)} /><div class="condition-tabs" role="tablist" aria-label="Lexus condition guidance">{lexusConditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-controls="condition-guidance" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i><span>{item.label}</span></button>)}</div><div class="condition-record"><div class="condition-illustration"><ConditionGraphic /><p>Existing photographs and workshop notes can help explain the condition. You do not need to test a damaged vehicle.</p></div><div class="condition-notes" id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0"><p class="eyebrow" data-condition-category>{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul><a class="text-link" data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div></div><p class="selection-status" data-condition-status role="status" aria-live="polite"></p></section>
 </div>
 <section class="lexus-models" id="lexus-models" data-model-explorer aria-labelledby="model-title"><div class="lexus-shell"><header class="section-heading"><div><p class="eyebrow">02 / Identify your Lexus</p><h2 id="model-title">Find your model.<br /><span>See what to prepare.</span></h2></div><p>Lexus guidance only. Selecting a model here adds it to your valuation form. You can still choose another make in the form.</p></header>
 {models.length?<><script type="application/json" data-model-config set:html={json({make:'LEXUS',models,profiles:lexusProfiles,initial})} /><div class="model-workspace"><aside class="model-directory"><label for="manufacturer-all-models">All {models.length} Lexus models<select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{model}</option>)}</select></label><div class="model-tabs" role="tablist" aria-label="Lexus model guidance">{choices.map((model,i)=><button type="button" role="tab" id={'model-tab-'+i} data-model-choice={model} aria-controls="model-guidance" aria-selected={model===initial?'true':'false'} tabindex={model===initial?0:-1}><span>{model}</span><i class="ph ph-car-profile" aria-hidden="true"></i></button>)}</div></aside><div class="model-result" id="model-guidance" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="model-id"><p class="eyebrow" data-model-category>{guidance.category}</p><strong data-model-name>{initial}</strong></div><h3 data-model-heading>{guidance.title}</h3><p data-model-copy>{guidance.copy}</p><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><SectionActionButton href="#lexus-quote" label={'Value my '+initial} intent="valuation" /></div></div><p class="selection-status" data-model-status role="status" aria-live="polite"></p></>:<p>Catalogue options are temporarily unavailable. <a href="/contact-us/">Ask about your Lexus</a>.</p>}
 </div></section>
 <div class="lexus-shell"><section class="lexus-assessment" aria-labelledby="value-title"><header class="section-heading"><div><p class="eyebrow">03 / Valuation notes</p><h2 id="value-title">The details behind<br /><span>a Lexus scrap valuation.</span></h2></div><p>Current condition, completeness and practical access shape the review. There is no automatic price from a model name.</p></header><div class="assessment-layout"><div class="assessment-register">{lexusFactors.map(([number,icon,title,copy],i)=><details open={i===0}><summary><span>{number}</span><i class:list={['ph',icon]} aria-hidden="true"></i><h3>{title}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}<a class="text-link" href="/scrap-car-value/">Understand scrap-car value <i class="ph ph-book-open" aria-hidden="true"></i></a></div><figure data-manufacturer-reveal><img src="/sections/lexus-rx-assessment.webp" srcset="/sections/lexus-rx-assessment-640.webp 640w, /sections/lexus-rx-assessment-960.webp 960w, /sections/lexus-rx-assessment.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 49vw, 580px" width="1440" height="960" loading="lazy" decoding="async" alt="Used early-2010s dark-blue RX-style Lexus SUV with lower-door scratches and rear bumper wear in an independent UAE workshop" /></figure></div></section>
 <section class="lexus-collection" aria-labelledby="collection-title"><header><p class="eyebrow">04 / Collection preparation</p><h2 id="collection-title">Collection starts<br /><span>with access.</span></h2><p>Open the notes to prepare for a recovery discussion. Arrangements depend on the vehicle, location and available documents.</p></header><div class="collection-notes"><details open><summary><span class="collection-icon"><i class="ph ph-map-pin" aria-hidden="true"></i></span><h3>The parking position</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Share the exact location, entrances, basement clearance, gates and surrounding space. Explain any permissions needed and explore our <a href="/locations/">UAE locations</a>.</p></details><details><summary><span class="collection-icon"><i class="ph ph-tire" aria-hidden="true"></i></span><h3>Movement &amp; keys</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Explain known restrictions on rolling or steering, key availability and tyre condition. Do not start or move a damaged car simply to enquire. Read our <a href="/car-removal/">vehicle recovery guide</a>.</p></details><details><summary><span class="collection-icon"><i class="ph ph-identification-card" aria-hidden="true"></i></span><h3>Documents &amp; release</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Share available ownership and registration information and who can authorise handover. Confirm required paperwork and any relevant transfer or deregistration steps before arrangements are agreed.</p></details></div></section>
 <section class="lexus-faq" data-manufacturer-faq aria-labelledby="faq-title"><header><p class="eyebrow">Lexus scrap-car questions</p><h2 id="faq-title">Before you<br /><span>send the details.</span></h2><p>Answers about Lexus models, assessment and handover.</p><a class="text-link" href="/contact-us/">Ask about your vehicle <i class="ph ph-chats-circle" aria-hidden="true"></i></a></header><div class="faq-list">{lexusFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></section>
 <section class="lexus-final" aria-labelledby="final-title"><div><p class="eyebrow">Start with your Lexus</p><h2 id="final-title">Your vehicle details.<br /><span>Your next step.</span></h2><p>Request a free valuation for the Lexus you have today.</p></div><SectionActionButton href="#lexus-quote" label="Get my Lexus valuation" intent="valuation" /><p class="independent">Independent service. No Lexus affiliation, authorisation or endorsement is implied.</p></section></div>
 <ManufacturerInteractions />
 </main>
</BaseLayout>
<style>
.lexus-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.lexus-breadcrumb{display:flex;align-items:center;gap:10px;font-size:11px;color:#6b7866;padding:21px 0 27px}.lexus-breadcrumb a{color:inherit;text-decoration:none}.lexus-breadcrumb a:hover{text-decoration:underline}.lexus-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-areas:'heading photo' 'form form' 'points points';gap:24px 38px;padding-bottom:35px;align-items:center}.lexus-hero header{grid-area:heading}.lexus-hero h1{font-size:clamp(36px,4.1vw,57px);line-height:1.05;letter-spacing:-.055em;font-weight:600}.lexus-hero h1 span{display:block}.lexus-hero h1 span:last-child{color:var(--smc-green)}.hero-intro{font-size:14px;line-height:1.8;max-width:420px;margin-top:20px!important;color:#64715e}.hero-rule{display:block;width:55px;height:2px;background:#6d8760;margin-top:24px}.lexus-hero-photo{grid-area:photo;border-radius:4px 36px 4px 4px;overflow:hidden;aspect-ratio:3/2;background:#e8e9e2}.lexus-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.lexus-quote{grid-area:form;scroll-margin-top:25px;min-width:0}.lexus-quote :global(.quote-card--free-quote){display:grid;grid-template-columns:230px minmax(0,1fr);gap:30px;padding:25px;border-radius:14px;border:1px solid #d7dfd1;box-shadow:0 12px 35px #253c2210}.lexus-quote :global(.quote-head){align-self:center}.lexus-quote :global(.quote-head h2){font-size:25px;line-height:1.15;letter-spacing:-.04em}.lexus-quote :global(.quote-head p){font-size:12px;line-height:1.7}.lexus-quote :global(.quote-kicker){font-size:9px}.lexus-quote :global(.quote-card--free-quote form){grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 15px;margin-top:0;align-items:end}.lexus-quote :global(.quote-card--free-quote .field-grid){grid-column:1/-1;grid-template-columns:1.25fr 1.1fr .65fr 1fr;gap:12px 10px}.lexus-quote :global(.model-availability){order:5;margin:0;font-size:10px}.lexus-quote :global(.quote-card--free-quote input),.lexus-quote :global(.quote-card--free-quote select){height:49px;font-size:13px;padding-left:32px;padding-right:24px;border-radius:8px}.lexus-quote :global(.with-icon i){left:10px;font-size:17px}.lexus-quote :global(.field-label){font-size:11px}.lexus-quote :global(.submit){height:49px;min-height:49px;font-size:12px;margin:0;justify-content:space-between;padding-left:18px}.lexus-quote :global(.submit i){width:30px;height:30px}.lexus-quote :global(.data-error),.lexus-quote :global(.submit-message){grid-column:1/-1}.lexus-assurances{grid-area:points;list-style:none;display:flex;justify-content:center;gap:45px;margin:0;padding:0;font-size:11px;color:#5d7354;line-height:1.5}.lexus-assurances li{display:flex;gap:8px;align-items:center}.lexus-assurances i{font-size:19px}@media(max-width:1100px){.lexus-hero{gap:25px}.lexus-hero h1{font-size:43px}.lexus-quote :global(.quote-card--free-quote){grid-template-columns:190px minmax(0,1fr);gap:22px;padding:21px}.lexus-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr}}@media(max-width:900px){.lexus-hero{grid-template-columns:1fr;grid-template-areas:'heading' 'form' 'photo' 'points'}.lexus-hero-photo{width:100%;max-width:680px;justify-self:center}.lexus-quote :global(.quote-card--free-quote){display:block}.lexus-quote :global(.quote-card--free-quote form){margin-top:20px}.lexus-assurances{justify-content:start;gap:25px}}@media(max-width:760px){.lexus-shell{width:calc(100% - 36px)}.lexus-breadcrumb{font-size:10px;padding:16px 0 22px}.lexus-hero{gap:20px;padding-bottom:30px}.lexus-hero h1{font-size:clamp(29px,6.7vw,44px);line-height:1.07;letter-spacing:-.055em}.hero-intro{font-size:13px;line-height:1.75;margin-top:16px!important}.hero-rule{display:none}.lexus-hero-photo{border-radius:4px 25px 4px 4px}.lexus-quote :global(.quote-card--free-quote){padding:18px;border-radius:14px}.lexus-quote :global(.quote-head h2){font-size:22px}.lexus-quote :global(.quote-head p){font-size:11px}.lexus-quote :global(.quote-card--free-quote form){grid-template-columns:1fr;gap:12px;margin-top:15px}.lexus-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr;gap:11px 9px}.lexus-quote :global(.form-field[data-field="make"]),.lexus-quote :global(.form-field[data-field="model"]){grid-column:1/-1}.lexus-quote :global(.model-availability){order:0}.lexus-quote :global(.quote-card--free-quote input),.lexus-quote :global(.quote-card--free-quote select){font-size:16px;height:49px;padding-left:33px;padding-right:24px}.lexus-quote :global(.submit){min-height:50px;margin-top:2px}.lexus-assurances{display:grid;gap:9px;font-size:11px}}
.lexus-page{background:#faf9f5;color:#263a2d}.lexus-page :is(h1,h2,h3,p,figure){margin:0}.lexus-page :is(section,header,aside,figure){min-width:0}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.13em;font-weight:750;color:#2f6f2d;margin-bottom:16px!important}.lexus-page h2{font-size:clamp(31px,3.4vw,44px);line-height:1.12;letter-spacing:-.045em;font-weight:600}.lexus-page h2 span{color:var(--smc-green)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:25px}.section-heading>p{font-size:13px;line-height:1.85;max-width:345px;color:#60705f}.lexus-condition{padding:30px 0 35px}.condition-tabs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:7px}.condition-tabs button{display:flex;align-items:center;gap:8px;min-height:58px;padding:12px 10px;border:1px solid #d5dfce;background:#fff;border-radius:8px;font:inherit;font-size:11px;line-height:1.5;color:#3e6240;text-align:left;cursor:pointer}.condition-tabs button i{font-size:23px;flex-shrink:0}.condition-record{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.3fr);border-bottom:1px solid #d3decb;padding:25px 0;gap:35px;align-items:center}.condition-illustration{min-width:0}.condition-illustration :global(.condition-graphic){display:block;margin:0;padding:22px 25px;background:#edf4e6;border-radius:13px}.condition-illustration :global(.condition-graphic svg){max-width:320px;margin:0 auto 18px}.condition-illustration>p{font-size:11px;line-height:1.8;color:#64715d;padding:14px 8px 0}.condition-notes{min-width:0}.condition-notes h3{font-size:26px;line-height:1.25;letter-spacing:-.03em;font-weight:600}.condition-notes>p:not(.eyebrow){font-size:13px;line-height:1.9;color:#5b6c59;margin-top:15px}.condition-notes ul{padding-left:17px;display:grid;gap:7px;font-size:12px;line-height:1.8;color:#476449;margin:18px 0 9px}.text-link{display:inline-flex;align-items:center;gap:12px;min-height:44px;font-size:12px;font-weight:700;color:#2f6f2d;text-underli