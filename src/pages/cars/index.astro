---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ConditionGraphic from '../../components/manufacturer/ConditionGraphic.astro';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import '../../components/manufacturer/manufacturer-body.css';
import '../../styles/car-hub.css';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {buildCarGallery} from '../../lib/car-gallery';
import {manufacturerHref} from '../../lib/car-manufacturers';
import {modelLabel} from '../../lib/manufacturer-models';
import {hubConditions,hubFactors,hubSteps,hubFaqs} from '../../lib/car-hub-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const gallery=buildCarGallery(vehicleData.models);const featured=gallery[0];const condition=hubConditions[0];
const crumbs=[['Home','/'],['Car makes','/cars/']];
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\u003c');
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const collection={'@context':'https://schema.org','@type':'CollectionPage',name:'Scrap cars by make in the UAE',url:'https://www.scrapmycaruae.com/cars/',mainEntity:{'@type':'ItemList',numberOfItems:gallery.length,itemListElement:gallery.map((make,i)=>({'@type':'ListItem',position:i+1,name:make.name,url:'https://www.scrapmycaruae.com'+manufacturerHref(make.slug)}))}};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:hubFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<BaseLayout title="Scrap Cars by Make in UAE | Free Valuation | Scrap My Car UAE" description="Explore scrap-car valuation by make in the UAE. Find your manufacturer, choose a real catalogue model and request a free valuation for your damaged or unwanted car." canonical="/cars/" ogImage="/sections/bmw-sedan-valuation.webp">
 <Fragment slot="head"><script type="application/ld+json" set:html={json(breadcrumb)} /><script type="application/ld+json" set:html={json(collection)} /><script type="application/ld+json" set:html={json(faqSchema)} /></Fragment>
 <main class="cars-hub" data-car-hub data-manufacturer-page>
  <div class="hub-shell"><nav class="hub-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Car makes</span></nav>
   <section class="hub-hero" aria-labelledby="hub-title">
    <header><p class="eyebrow">Your car. Your make. Your next step.</p><h1 id="hub-title"><span>Scrap Your <em>Car</em></span> <span>by Make <em>in the UAE</em></span></h1><p class="hero-intro">Find familiar model guidance. Understand what matters. Request a free valuation for the car you have today.</p><a class="hero-explore" href="#make-explorer">Explore the makes <i class="ph ph-arrow-down" aria-hidden="true"></i></a></header>
    <figure class="hub-hero-photo"><div class="visual-orbit" aria-hidden="true"></div><img class="visual-main" src="/sections/bmw-sedan-valuation.webp" srcset="/sections/bmw-sedan-valuation-640.webp 640w, /sections/bmw-sedan-valuation-960.webp 960w, /sections/bmw-sedan-valuation.webp 1440w" sizes="(max-width:900px) calc(100vw - 64px), 510px" width="1440" height="960" fetchpriority="high" alt="Older BMW-style sedan with modest wear, ready for an individual vehicle assessment" /><div class="visual-inset"><img src="/sections/nissan-patrol-assessment-640.webp" width="640" height="427" alt="Used Nissan Patrol-style SUV" loading="lazy" /></div><figcaption><span class="visual-dot"></span>Every make. An individual assessment.</figcaption></figure>
    <div class="hub-quote" id="cars-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
    <ul class="hub-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-car-profile" aria-hidden="true"></i>All catalogue makes in the form</li><li><i class="ph ph-truck" aria-hidden="true"></i>UAE collection guidance</li></ul>
   </section>
  </div>
  <section class="make-explorer" id="make-explorer" data-make-gallery aria-labelledby="gallery-title"><div class="hub-shell">
   <header class="section-heading"><div><p class="eyebrow">01 / The manufacturer studio</p><h2 id="gallery-title">Find your make.<br /><span>Meet your next step.</span></h2></div><p>Select a vehicle card to change the preview and set the make in your form. Choose a model below to add that too.</p></header>
   <script type="application/json" data-gallery-config set:html={json(gallery)} />
   <div class="gallery-composition">
    <div class="featured-vehicle" id="featured-vehicle" data-featured-vehicle role="tabpanel" aria-labelledby="make-tab-0" tabindex="0"><figure><img data-featured-image src={'/sections/'+featured.image+'.webp'} srcset={'/sections/'+featured.image+'-640.webp 640w, /sections/'+featured.image+'-960.webp 960w, /sections/'+featured.image+'.webp 1440w'} sizes="(max-width:760px) calc(100vw - 36px), 650px" width="1440" height="960" loading="lazy" alt={featured.alt} /><figcaption>Illustrative used vehicle. Every car is reviewed individually.</figcaption></figure><div class="featured-copy"><div class="featured-topline"><span>Manufacturer guide</span><span data-featured-index>01 / 10</span></div><h3 data-featured-name>{featured.name}</h3><p data-featured-copy>{featured.description}</p><div class="featured-focus"><i class="ph ph-note-pencil" aria-hidden="true"></i><span data-featured-note>{featured.note}</span></div><p class="model-caption" data-model-caption>Models from the current {featured.name} catalogue. Choose one to add it to the form.</p><div class="featured-models" data-featured-models>{featured.models.slice(0,6).map(model=><button type="button" data-gallery-model={model} aria-pressed="false">{modelLabel(model)}</button>)}</div><div data-featured-action><SectionActionButton href={manufacturerHref(featured.slug)} label={'Explore '+featured.name+' Scrap Valuation'} intent="valuation" /></div></div></div>
    <div class="make-grid" role="tablist" aria-label="Manufacturer gallery">{gallery.map((make,i)=><button class="make-card" type="button" role="tab" id={'make-tab-'+i} data-make-choice={i} aria-label={make.name} aria-controls="featured-vehicle" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span class="card-image"><img src={'/sections/'+make.image+'-640.webp'} width="640" height="427" loading="lazy" decoding="async" alt="" /></span><span class="card-label"><strong>{make.name}</strong><i class="ph ph-plus" aria-hidden="true"></i></span></button>)}</div>
   </div><p class="gallery-status" data-gallery-status role="status" aria-live="polite">Explore a make or select a model to update your form.</p>
   <nav class="make-links" aria-label="All manufacturer guides"><span>Read a guide:</span>{gallery.map(make=><a href={manufacturerHref(make.slug)}>{make.name}</a>)}</nav>
  </div></section>
  <div class="hub-shell">
   <section class="hub-condition" data-condition-explorer aria-labelledby="condition-title"><header class="section-heading"><div><p class="eyebrow">02 / Look beyond the badge</p><h2 id="condition-title">What is your car<br /><span>like today?</span></h2></div><p>A model is a starting point. Choose a condition to see the information that helps an individual review.</p></header><script type="application/json" data-condition-config set:html={json(hubConditions)} /><div class="condition-console"><div class="condition-visual"><span class="console-label"><i class="ph ph-magnifying-glass" aria-hidden="true"></i> Condition explorer</span><ConditionGraphic /><p>Guidance only. No diagnosis or automatic price.</p></div><div class="condition-controls"><div class="condition-tabs" role="tablist" aria-label="Vehicle condition guidance">{hubConditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-controls="condition-guidance" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i>{item.label}</button>)}</div><div class="condition-notes" id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0"><p class="eyebrow" data-condition-category>{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul><a class="text-link" data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div></div></div><p class="selection-status" data-condition-status role="status" aria-live="polite"></p></section>
   <section class="hub-value" aria-labelledby="value-title"><header><p class="eyebrow">03 / The valuation picture</p><h2 id="value-title">Four details.<br /><span>One clearer picture.</span></h2><p>Open a factor to see what matters. There is no fixed value attached to a badge, age or original purchase price.</p><SectionActionButton href="/scrap-car-value/" label="Understand scrap-car value" intent="process" icon="ph-book-open" /></header><div class="factor-register">{hubFactors.map(([icon,category,title,copy],i)=><details open={i===0}><summary><span>0{i+1}</span><i class:list={['ph',icon]} aria-hidden="true"></i><div><small>{category}</small><h3>{title}</h3></div><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></section>
   <section class="hub-process" data-hub-process data-step="0" aria-labelledby="process-title"><header class="section-heading"><div><p class="eyebrow">04 / From enquiry to next step</p><h2 id="process-title">A short route.<br /><span>Clear at every stage.</span></h2></div><p>Explore the three stages before sending your details.</p></header><div class="process-track" aria-hidden="true"><div class="track-line"></div><span class="track-car"><i class="ph ph-car-profile"></i></span><span>01</span><span>02</span><span>03</span></div><div class="process-tabs" role="tablist" aria-label="Valuation process">{hubSteps.map((step,i)=><button type="button" role="tab" id={'process-tab-'+i} data-process-step={i} aria-controls={'process-panel-'+i} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',step.icon]} aria-hidden="true"></i><span>{step.label}</span></button>)}</div>{hubSteps.map((step,i)=><div class="process-panel" id={'process-panel-'+i} data-process-panel hidden={i!==0} role="tabpanel" aria-labelledby={'process-tab-'+i} tabindex="0"><div><h3>{step.title}</h3><p>{step.copy}</p></div><p class="process-note"><i class="ph ph-info" aria-hidden="true"></i>{step.note}</p></div>)}</section>
   <section class="hub-collection" aria-labelledby="collection-title" data-manufacturer-reveal><figure><img src="/sections/ford-escape-assessment.webp" srcset="/sections/ford-escape-assessment-640.webp 640w, /sections/ford-escape-assessment-960.webp 960w, /sections/ford-escape-assessment.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), 590px" width="1440" height="960" loading="lazy" decoding="async" alt="Used older Ford-style SUV with modest rear bumper and door wear" /><figcaption>Tell us where the vehicle is parked and what is already known about its mobility.</figcaption></figure><div><p class="eyebrow">05 / UAE collection preparation</p><h2 id="collection-title">The car matters.<br /><span>So does the access.</span></h2><details open><summary><i class="ph ph-map-pin" aria-hidden="true"></i><h3>Location &amp; clearance</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Share the parking level, entrance height, gates and space around the vehicle. Check our <a href="/locations/">UAE location guides</a> and explain site permissions.</p></details><details><summary><i class="ph ph-key" aria-hidden="true"></i><h3>Keys &amp; movement</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Mention missing keys, flat tyres, locked wheels or steering restrictions already known. Do not move a damaged car simply to enquire.</p></details><details><summary><i class="ph ph-identification-card" aria-hidden="true"></i><h3>Documents &amp; release</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Discuss ownership and registration documents, the authorised handover contact and required paperwork. Confirm relevant transfer or deregistration steps before arrangements are agreed.</p></details><a class="text-link" href="/car-removal/">Read vehicle collection guidance <i class="ph ph-book-open" aria-hidden="true"></i></a></div></section>
   <section class="hub-faq" data-manufacturer-faq aria-labelledby="faq-title"><header class="section-heading"><div><p class="eyebrow">Before you decide</p><h2 id="faq-title">A few questions.<br /><span>Practical answers.</span></h2></div><a class="text-link" href="/contact-us/">Ask about your vehicle <i class="ph ph-chats-circle" aria-hidden="true"></i></a></header><div class="faq-list">{hubFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></section>
   <section class="hub-final"><div><p class="eyebrow">Start with the car you have</p><h2>Ready for<br /><span>your next step?</span></h2><p>Choose the exact vehicle. Request an individual valuation.</p></div><SectionActionButton href="#cars-quote" label="Start my free valuation" intent="valuation" /><p class="independent">Independent service. Manufacturer names identify the vehicles discussed; no affiliation, authorisation or endorsement is implied.</p></section>
  </div><ManufacturerInteractions />
 </main>
</BaseLayout>
<script>import '../../scripts/car-hub';</script>
