---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import ConditionGraphic from '../../components/manufacturer/ConditionGraphic.astro';
import '../../components/manufacturer/manufacturer-body.css';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels,modelLabel,resolveModelGuidance} from '../../lib/manufacturer-models';
import {fordPreferred,fordProfiles,fordConditions,fordFactors,fordFaqs} from '../../lib/ford-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const models=manufacturerModels(vehicleData.models,'FORD').map(item=>item.model);
const choices=fordPreferred.filter(model=>models.includes(model));const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,fordProfiles);const condition=fordConditions[0];
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['Ford','/cars/ford/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:fordFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\u003c');
---
<BaseLayout title="Scrap Ford Car in UAE | Free Valuation | Scrap My Car UAE" description="Scrap your Ford car in the UAE. Request a free valuation for a damaged, non-running or unwanted Focus, Fusion, Explorer, Escape or other Ford model." canonical="/cars/ford/" ogImage="/sections/ford-fusion-valuation.webp"><Fragment slot="head"><script type="application/ld+json" set:html={json(breadcrumb)} /><script type="application/ld+json" set:html={json(faqSchema)} /></Fragment><main class="ford-page" data-manufacturer-page><div class="ford-shell"><nav class="ford-breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
 <section class="ford-hero" aria-labelledby="ford-title"><header><p class="eyebrow">Ford / UAE scrap valuation</p><h1 id="ford-title"><span>Scrap Your Ford</span> <span>Car in the UAE</span></h1><p class="hero-intro">Request a free scrap valuation for a damaged, non-running, old or unwanted Ford. Share your model, year and the condition you know.</p><span class="hero-rule" aria-hidden="true"></span></header>
 <figure class="ford-hero-photo"><img src="/sections/ford-fusion-valuation.webp" srcset="/sections/ford-fusion-valuation-640.webp 640w, /sections/ford-fusion-valuation-960.webp 960w, /sections/ford-fusion-valuation.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 43vw, 510px" width="1440" height="960" fetchpriority="high" alt="Used early-2010s Fusion-style Ford sedan with bumper scrapes, a small fender dent and light door scratches at a UAE assessment forecourt" /></figure>
 <div class="ford-quote" id="ford-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
 <ul class="ford-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running cars</li><li><i class="ph ph-key" aria-hidden="true"></i>Individual recovery review</li></ul></section>




<div class="ford-workbench">
<section class="ford-models" data-model-explorer aria-labelledby="model-title">
 <header><p class="eyebrow">01 / Model notes</p><h2 id="model-title">Which Ford<br /><span>are you moving on?</span></h2><p>Choose a live catalogue model to add it to your valuation form. All makes remain available in the form above.</p></header>
 {models.length?<><script type="application/json" data-model-config set:html={json({make:'FORD',models,profiles:fordProfiles,initial})} /><label class="model-select" for="manufacturer-all-models">All {models.length} Ford models<select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{modelLabel(model)}</option>)}</select></label><div class="model-tabs" role="tablist" aria-label="Ford model guidance">{choices.map((model,i)=><button type="button" role="tab" id={'model-tab-'+i} data-model-choice={model} aria-controls="model-guidance" aria-selected={model===initial?'true':'false'} tabindex={model===initial?0:-1}>{modelLabel(model)}</button>)}</div><div class="model-result" id="model-guidance" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="model-id"><div><span data-model-category>{guidance.category}</span><strong data-model-name>{modelLabel(initial)}</strong></div><i class="ph ph-car-profile" aria-hidden="true"></i></div><h3 data-model-heading>{guidance.title}</h3><p data-model-copy>{guidance.copy}</p><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><SectionActionButton href="#ford-quote" label={'Value my '+modelLabel(initial)} intent="valuation" /></div><p class="selection-status" data-model-status role="status" aria-live="polite"></p></>:<p>Catalogue options are temporarily unavailable. <a href="/contact-us/">Ask about your Ford</a>.</p>}
</section>
<section class="ford-condition" data-condition-explorer aria-labelledby="condition-title"><header><p class="eyebrow">02 / Condition notes</p><h2 id="condition-title">What should we know<br /><span>about its condition?</span></h2><p>Explore the details to discuss. These selections guide your enquiry and do not diagnose a fault or calculate a price.</p></header><script type="application/json" data-condition-config set:html={json(fordConditions)} /><div class="condition-tabs" role="tablist" aria-label="Ford condition guidance">{fordConditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-controls="condition-guidance" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i>{item.label}</button>)}</div><ConditionGraphic /><div class="condition-notes" id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0"><p class="eyebrow" data-condition-category>{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul><a class="text-link" data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div><p class="selection-status" data-condition-status role="status" aria-live="polite"></p></section>
</div>
<section class="ford-value" aria-labelledby="value-title"><header class="section-heading"><div><p class="eyebrow">03 / What shapes the assessment</p><h2 id="value-title">A valuation for your Ford.<br /><span>Based on the vehicle today.</span></h2></div><a class="text-link" href="/scrap-car-value/">Understand scrap-car value <i class="ph ph-book-open" aria-hidden="true"></i></a></header><div class="value-ledger">{fordFactors.map(([icon,title,copy],i)=><details open={i===0}><summary><span>0{i+1}</span><i class:list={['ph',icon]} aria-hidden="true"></i><h3>{title}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></section>
<section class="ford-collection" aria-labelledby="collection-title"><div class="collection-copy"><p class="eyebrow">04 / Recovery &amp; handover</p><h2 id="collection-title">Plan around<br /><span>where it is parked.</span></h2><p>A family SUV, sedan or pickup can have different access requirements. Discuss what is already known before arrangements are agreed.</p><div class="collection-notes"><details open><summary><i class="ph ph-map-pin" aria-hidden="true"></i><h3>Location &amp; clearance</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Share the exact parking level, entrance height, gates and surrounding space. Mention site permissions and see our <a href="/locations/">UAE locations</a>.</p></details><details><summary><i class="ph ph-key" aria-hidden="true"></i><h3>Keys, tyres &amp; movement</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Mention missing keys, flat tyres, locked wheels or steering restrictions already known. For an F-150, explain any load-bed contents. Do not test or move a damaged vehicle simply to enquire.</p></details><details><summary><i class="ph ph-identification-card" aria-hidden="true"></i><h3>Documents &amp; authorisation</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Explain which ownership and registration documents you hold and who may release the vehicle. Confirm required paperwork and relevant transfer or deregistration steps before handover.</p></details></div><SectionActionButton href="/car-removal/" label="Read collection guidance" intent="process" icon="ph-truck" /></div><figure data-manufacturer-reveal><img src="/sections/ford-escape-assessment.webp" srcset="/sections/ford-escape-assessment-640.webp 640w, /sections/ford-escape-assessment-960.webp 960w, /sections/ford-escape-assessment.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), 600px" width="1440" height="960" loading="lazy" decoding="async" alt="Used early-2010s dark red Escape-style Ford SUV with rear bumper scrapes, a shallow door dent and lower-panel scratches" /><figcaption>Describe the Ford as it stands. Existing photos and access details help prepare the recovery discussion.</figcaption></figure></section>
<section class="ford-faq" data-manufacturer-faq aria-labelledby="faq-title"><header class="section-heading"><div><p class="eyebrow">Ford scrap-car questions</p><h2 id="faq-title">Before you<br /><span>take the next step.</span></h2></div><p>Answers about Ford models, individual assessment and collection. <a class="text-link" href="/contact-us/">Ask about your Ford <i class="ph ph-chats-circle" aria-hidden="true"></i></a></p></header><div class="faq-list">{fordFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></section>
<section class="ford-final" aria-labelledby="final-title"><div><p class="eyebrow">Your Ford, your next step</p><h2 id="final-title">Ready for a<br /><span>free valuation?</span></h2><p>Start with your Ford model, year and contact details.</p></div><SectionActionButton href="#ford-quote" label="Get my Ford valuation" intent="valuation" /><p class="independent">Independent service. No Ford affiliation, authorisation or endorsement is implied.</p></section></div><ManufacturerInteractions /></main></BaseLayout>
<style>
.ford-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.ford-breadcrumb{display:flex;align-items:center;gap:10px;font-size:11px;color:#6b7866;padding:21px 0 27px}.ford-breadcrumb a{color:inherit;text-decoration:none}.ford-breadcrumb a:hover{text-decoration:underline}.ford-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-areas:'heading photo' 'form form' 'points points';gap:24px 38px;padding-bottom:35px;align-items:center}.ford-hero header{grid-area:heading}.ford-hero h1{font-size:clamp(36px,4.1vw,57px);line-height:1.05;letter-spacing:-.055em;font-weight:600}.ford-hero h1 span{display:block}.ford-hero h1 span:last-child{color:var(--smc-green)}.hero-intro{font-size:14px;line-height:1.8;max-width:420px;margin-top:20px!important;color:#64715e}.hero-rule{display:block;width:55px;height:2px;background:#6d8760;margin-top:24px}.ford-hero-photo{grid-area:photo;border-radius:4px 36px 4px 4px;overflow:hidden;aspect-ratio:3/2;background:#e8e9e2}.ford-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.ford-quote{grid-area:form;scroll-margin-top:25px;min-width:0}.ford-quote :global(.quote-card--free-quote){display:grid;grid-template-columns:230px minmax(0,1fr);gap:30px;padding:25px;border-radius:14px;border:1px solid #d7dfd1;box-shadow:0 12px 35px #253c2210}.ford-quote :global(.quote-head){align-self:center}.ford-quote :global(.quote-head h2){font-size:25px;line-height:1.15;letter-spacing:-.04em}.ford-quote :global(.quote-head p){font-size:12px;line-height:1.7}.ford-quote :global(.quote-kicker){font-size:9px}.ford-quote :global(.quote-card--free-quote form){grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 15px;margin-top:0;align-items:end}.ford-quote :global(.quote-card--free-quote .field-grid){grid-column:1/-1;grid-template-columns:1.25fr 1.1fr .65fr 1fr;gap:12px 10px}.ford-quote :global(.model-availability){order:5;margin:0;font-size:10px}.ford-quote :global(.quote-card--free-quote input),.ford-quote :global(.quote-card--free-quote select){height:49px;font-size:13px;padding-left:32px;padding-right:24px;border-radius:8px}.ford-quote :global(.with-icon i){left:10px;font-size:17px}.ford-quote :global(.field-label){font-size:11px}.ford-quote :global(.submit){height:49px;min-height:49px;font-size:12px;margin:0;justify-content:space-between;padding-left:18px}.ford-quote :global(.submit i){width:30px;height:30px}.ford-quote :global(.data-error),.ford-quote :global(.submit-message){grid-column:1/-1}.ford-assurances{grid-area:points;list-style:none;display:flex;justify-content:center;gap:45px;margin:0;padding:0;font-size:11px;color:#5d7354;line-height:1.5}.ford-assurances li{display:flex;gap:8px;align-items:center}.ford-assurances i{font-size:19px}@media(max-width:1100px){.ford-hero{gap:25px}.ford-hero h1{font-size:43px}.ford-quote :global(.quote-card--free-quote){grid-template-columns:190px minmax(0,1fr);gap:22px;padding:21px}.ford-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr}}@media(max-width:900px){.ford-hero{grid-template-columns:1fr;grid-template-areas:'heading' 'form' 'photo' 'points'}.ford-hero-photo{width:100%;max-width:680px;justify-self:center}.ford-quote :global(.quote-card--free-quote){display:block}.ford-quote :global(.quote-card--free-quote form){margin-top:20px}.ford-assurances{justify-content:start;gap:25px}}@media(max-width:760px){.ford-shell{width:calc(100% - 36px)}.ford-breadcrumb{font-size:10px;padding:16px 0 22px}.ford-hero{gap:20px;padding-bottom:30px}.ford-hero h1{font-size:clamp(29px,6.7vw,44px);line-height:1.07;letter-spacing:-.055em}.hero-intro{font-size:13px;line-height:1.75;margin-top:16px!important}.hero-rule{display:none}.ford-hero-photo{border-radius:4px 25px 4px 4px}.ford-quote :global(.quote-card--free-quote){padding:18px;border-radius:14px}.ford-quote :global(.quote-head h2){font-size:22px}.ford-quote :global(.quote-head p){font-size:11px}.ford-quote :global(.quote-card--free-quote form){grid-template-columns:1fr;gap:12px;margin-top:15px}.ford-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr;gap:11px 9px}.ford-quote :global(.form-field[data-field="make"]),.ford-quote :global(.form-field[data-field="model"]){grid-column:1/-1}.ford-quote :global(.model-availability){order:0}.ford-quote :global(.quote-card--free-quote input),.ford-quote :global(.quote-card--free-quote select){font-size:16px;height:49px;padding-left:33px;padding-right:24px}.ford-quote :global(.submit){min-height:50px;margin-top:2px}.ford-assurances{display:grid;gap:9px;font-size:11px}}
.ford-page{background:#f7f8f3;color:#273a2d}.ford-page :is(h1,h2,h3,p,figure){margin:0}.ford-page :is(section,header,figure,article){min-width:0}.ford-page h2{font-size:clamp(30px,3.2vw,43px);line-height:1.12;letter-spacing:-.045em;font-weight:600}.ford-page h2 span{color:var(--smc-green)}.eyebrow{font-size:10px;font-weight:750;text-transform:uppercase;letter-spacing:.12em;color:#2f6f2d;margin-bottom:15px!important}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:35px;margin-bottom:25px}.section-heading>p{max-width:340px;font-size:13px;line-height:1.85;color:#61765a}.ford-workbench{display:grid;grid-template-columns:1fr 1fr;gap:32px;padding:30px 0}.ford-workbench h2{font-size:33px}.ford-workbench header>p:not(.eyebrow){font-size:13px;line-height:1.85;color:#5f7555;max-width:470px;margin-top:17px}.ford-models{border-right:1px solid #c9d9bf;padding-right:32px}.model-select{display:grid;gap:8px;font-size:10px;font-weight:650;color:#517548;margin-top:22px}.model-select select{width:100%;min-width:0;min-height:47px;border:1px solid #bbd0ae;border-radius:8px;background:#fff;color:#30562c;font:inherit;font-size:14px;padding:10px 12px}.model-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:12px}.model-tabs button{font:inherit;font-size:11px;color:#355e2d;background:#fff;border:1px solid #bfd4b1;border-radius:7px;min-height:45px;padding:10px 8px;cursor:pointer}.model-result{margin-top:18px;border:1px solid #ccddc0;background:#fff;padding:24px;min-height:440px}.model-id{display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid #d6e3cc;padding-bottom:18px;margin-bottom:21px}.model-id span{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.09em;color:#6d885d;line-height:1.8}.model-id strong{display:block;font-size:39px;line-height:1.15;color:#2f6f2d;letter-spacing:-.045em;font-weight:550;margin-top:9px;overflow-wrap:anywhere}.model-id>i{font-size:53px;color:#a