0 18px;transition:background .18s}.value-ledger details:nth-child(odd){border-right:1px solid #bfd4b0}.value-ledger summary{display:flex;align-items:center;gap:14px;min-height:73px;cursor:pointer;list-style:none}.value-ledger summary>span{font-size:10px;color:#668756}.value-ledger summary>i:first-of-type{font-size:25px;color:#2f6f2d}.value-ledger h3{flex:1;font-size:18px;font-weight:600;letter-spacing:-.02em;line-height:1.5}.value-ledger summary>i:last-child{font-size:18px;color:#2f6f2d}.value-ledger details>p{font-size:12px;line-height:1.85;color:#557749;padding:0 15px 21px 36px}.value-ledger details[open]{background:#edf5e6}.ford-page summary::-webkit-details-marker{display:none}.ford-page details[open] summary>i:last-child{transform:rotate(45deg)}.ford-collection{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:38px;align-items:center;padding:28px 0 35px}.collection-copy>p:not(.eyebrow){font-size:13px;line-height:1.85;color:#5b7651;margin:17px 0}.collection-notes details{border-top:1px solid #c5d8b7}.collection-notes summary{display:flex;align-items:center;gap:12px;min-height:58px;list-style:none;cursor:pointer}.collection-notes summary>i:first-child{font-size:23px;color:#2f6f2d}.collection-notes summary>i:last-child{font-size:18px;color:#2f6f2d}.collection-notes h3{font-size:16px;line-height:1.5;font-weight:600;flex:1}.collection-notes details>p{font-size:12px;line-height:1.85;color:#547449;padding:0 6px 19px 35px}.collection-notes a{color:#2f6f2d;text-underline-offset:4px}.collection-copy :global(.section-action){margin-top:17px;font-size:11px;min-height:45px;box-shadow:none}.ford-collection figure{overflow:hidden;border-radius:4px 20px 4px 20px;background:#fff;border:1px solid #ccddc0}.ford-collection img{width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;display:block}.ford-collection figcaption{font-size:14px;line-height:1.7;color:#526e45;padding:17px 20px;background:#fff}.ford-faq{padding:30px 0;border-top:1px solid #c8d9bc}.for