nter;flex:1;min-width:0;font-size:11px;font-weight:700;color:#52654b}.faq-search label>i{font-size:19px}.faq-search input{grid-column:1/-1;width:100%;min-height:48px;padding:10px 13px;background:#fff;border:1px solid #c8d6c0;border-radius:9px;font:inherit;font-size:16px;font-weight:400;color:#273b2b}.faq-search button{flex:0 0 44px;width:44px;height:48px;border:1px solid #c8d6c0;border-radius:9px;background:#edf2e7;color:#344f2e;cursor:pointer;font-size:19px}.faq-count{font-size:10px;color:#74826c;min-height:18px;margin:0 0 12px!important}.faq-empty{font-size:13px;line-height:1.8;padding:20px 0}.manufacturer-final{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;background:#e4ecda;border-radius:20px;padding:38px 40px;margin-bottom:50px}.manufacturer-final h2{font-size:40px;line-height:1.08;letter-spacing:-.05em}.manufacturer-final h2 span{color:#5c7b50}.manufacturer-final>div>p:not(.overline){font-size:13px;color:#596d52;line-height:1.8;margin-top:17px}.manufacturer-final :global(.section-action){font-size:12px;box-shadow:none}.independent-note{grid-column:1/-1;font-size:11px;line-height:1.8;color:#65765d;border-top:1px solid #c9d7bd;padding-top:18px}.toyota-page :is(a,button,summary,[tabindex]):focus-visible{outline:3px solid #5688bc;outline-offset:4px}.toyota-page :global(.reveal-ready){opacity:0;transform:translateY(12px);transition:opacity .45s ease,transform .45s ease}.toyota-page :global(.is-revealed){opacity:1;transform:none}
@media(hover:hover){.assessment-photo:hover img{transform:scale(1.02)}}
@media(max-width:1024px){.hero-editorial{gap:30px}.hero-editorial h1{font-size:48px}.hero-intro{max-width:260px;font-size:13px}.hero-stage{grid-template-columns:1.25fr 1fr;gap:0 18px}.hero-vehicle img{object-fit:contain;min-height:0}.hero-assurances{font-size:9px;flex-wrap:wrap;justify-content:start;gap:10px 18px}.valuation-panel :global(.quote-card){padding:21px}.value-editorial{gap:45px}.manufacturer-faq{gap:45px}.assessment-photo{height:auto}}
@media(min-width:761px) and (max-width:900px){.hero-editorial{display:block}.hero-intro{max-width:520px;margin-top:18px!important;font-size:14px}.hero-stage{grid-template-columns:1fr;grid-template-areas:"form" "points" "photo";grid-template-rows:auto auto auto}.hero-assurances{justify-content:flex-start;gap:25px;font-size:11px;padding:18px 0 22px;align-self:start}.hero-vehicle{aspect-ratio:3/2}.hero-vehicle img{height:auto;min-height:0;object-fit:contain}}
