---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ModelExplorer from '../../components/manufacturer/ModelExplorer.astro';
import ConditionSelector from '../../components/manufacturer/ConditionSelector.astro';
import EnquiryJourney from '../../components/manufacturer/EnquiryJourney.astro';
import '../../components/manufacturer/manufacturer-body.css';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels} from '../../lib/manufacturer-models';
import {toyotaModelGuidance,toyotaConditions,toyotaFaqs} from '../../lib/toyota-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const models=manufacturerModels(vehicleData.models,'TOYOTA');
const factors=[
 ['Model & year','The model, generation and year establish which vehicle is being assessed. Add the specification or mileage if already known.'],
 ['Condition & mechanical state','Known accident damage, engine and gearbox faults, water exposure and mobility all provide context. Share existing findings rather than guessing a diagnosis.'],
 ['Completeness & components','Mention missing engine parts, wheels, interior items or other removed components. The presence and condition of potentially recoverable components can affect the review.'],
 ['Access & collection','The exact parking position, keys, rolling and steering condition, space for recovery equipment and permissions may affect practical arrangements.']
];
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['Car makes','/cars/'],['Toyota','/cars/toyota/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:toyotaFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<BaseLayout title="Scrap Toyota Car in UAE | Free Valuation | Scrap My Car UAE" description="Request a free Toyota scrap-car valuation in the UAE. Explore model and condition guidance for damaged, non-running, old or unwanted Toyota vehicles." canonical="/cars/toyota/" ogImage="/sections/toyota-prado-valuation.webp">
 <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumb).replace(/</g,'\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g,'\\u003c')} /></Fragment>
 <main class="toyota-page" data-manufacturer-page>
  <div class="manufacturer-shell">
   <nav class="manufacturer-breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
   <section class="manufacturer-hero" aria-labelledby="toyota-title">

    <div class="hero-stage"><header class="hero-editorial"><div><p class="overline"><span class="brand-mark" aria-hidden="true"><i class="ph ph-car-profile"></i></span> Toyota / Scrap valuation</p><h1 id="toyota-title"><span>Scrap Your Toyota</span> <span>Car in the UAE</span></h1></div><p class="hero-intro">Request a free scrap valuation for a damaged, non-running, old or unwanted Toyota.</p></header><figure class="hero-vehicle"><img src="/sections/toyota-prado-valuation.webp" srcset="/sections/toyota-prado-valuation-640.webp 640w, /sections/toyota-prado-valuation-960.webp 960w, /sections/toyota-prado-valuation.webp 1440w" sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1250px) 43vw, 510px" width="1440" height="960" fetchpriority="high" alt="Champagne Prado-style Toyota SUV with minor bumper scuffs at a UAE automotive assessment forecourt" /></figure><div class="valuation-panel" id="toyota-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div><ul class="hero-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running</li><li><i class="ph ph-key" aria-hidden="true"></i>Access considered</li></ul></div>
    <nav class="experience-nav" aria-label="Toyota valuation sections"><a href="#toyota-models"><span>01</span> Find your model <i class="ph ph-car-profile" aria-hidden="true"></i></a><a href="#condition-title"><span>02</span> Vehicle condition <i class="ph ph-sliders-horizontal" aria-hidden="true"></i></a><a href="#toyota-value"><span>03</span> Understand value <i class="ph ph-list-checks" aria-hidden="true"></i></a></nav>
   </section>
   <ModelExplorer make="TOYOTA" models={models.map(item=>item.model)} profiles={toyotaModelGuidance} preferred={['COROLLA','CAMRY','YARIS','LAND CRUISER','PRADO','HILUX']} />
   <ConditionSelector conditions={toyotaConditions} makeLabel="Toyota" />
   <section class="value-editorial" id="toyota-value" aria-labelledby="value-title"><header data-manufacturer-reveal><p class="overline">03 / Understand the assessment</p><h2 id="value-title">What affects the<br />scrap value of<br /><em>your Toyota?</em></h2><p>A model name isn't a price.<br />The details explain the vehicle.</p><a class="text-link" href="/scrap-car-value/">Explore scrap-car value <i class="ph ph-book-open" aria-hidden="true"></i></a></header><div class="value-factors">{factors.map(([title,copy],index)=><details open={index===0}><summary><span class="factor-number">0{index+1}</span><h3>{title}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}<p class="value-note"><i class="ph ph-info" aria-hidden="true"></i>A free valuation starts a review. There are no automatic prices or guaranteed offers.</p></div></section>
   <section class="assessment-editorial" aria-labelledby="assessment-title"><header><p class="overline">The car beyond the model name</p><h2 id="assessment-title">Photos, documents<br /><span>and collection access.</span></h2><p>Describe the car as it stands. Existing photos, documents and workshop information help make the next discussion useful.</p></header><div class="assessment-dossier"><figure class="assessment-photo" data-manufacturer-reveal><img src="/sections/toyota-sedan-assessment.webp" srcset="/sections/toyota-sedan-assessment-640.webp 640w, /sections/toyota-sedan-assessment-960.webp 960w, /sections/toyota-sedan-assessment.webp 1440w" sizes="(max-width: 1250px) calc(100vw - 36px), 1180px" width="1440" height="960" loading="lazy" decoding="async" alt="Dark-blue Camry-style Toyota sedan with modest door and bumper wear beside inspection tools in a UAE workshop" /></figure><div class="assessment-notes"><div><i class="ph ph-camera" aria-hidden="true"></i><h3>Show what you know</h3><p>Existing photos and fault reports can explain damage. No need to test a damaged car.</p></div><div><i class="ph ph-identification-card" aria-hidden="true"></i><h3>Prepare the handover</h3><p>Share available ownership documents and who can authorise the vehicle's release.</p></div><div><i class="ph ph-truck" aria-hidden="true"></i><h3>Explain the way out</h3><p>Keys, wheel movement and the parking position help the <a href="/car-removal/">collection discussion</a>.</p></div></div></div></section>
  </div>
  <div class="manufacturer-shell"><EnquiryJourney makeLabel="Toyota" quoteId="toyota-quote" /></div>
  <div class="manufacturer-shell"><section class="manufacturer-faq" aria-labelledby="faq-title" data-manufacturer-faq><header><p class="overline">Before you decide</p><h2 id="faq-title">Your Toyota.<br />Your questions.</h2><p>Practical answers about scrap valuation, vehicle details and the next step.</p><a class="text-link" href="/contact-us/">Ask about your vehicle <i class="ph ph-chats-circle" aria-hidden="true"></i></a></header><div class="faq-answers"><div class="faq-search" data-faq-search hidden><label for="toyota-faq-search"><i class="ph ph-magnifying-glass" aria-hidden="true"></i><span>Search Toyota questions</span><input id="toyota-faq-search" data-faq-input type="search" placeholder="Try documents, model or access" aria-describedby="toyota-faq-count" maxlength="120" /></label><button type="button" data-faq-clear aria-label="Clear question search" hidden><i class="ph ph-x" aria-hidden="true"></i></button></div><p id="toyota-faq-count" class="faq-count" data-faq-count role="status" aria-live="polite">{toyotaFaqs.length} questions</p><div>{toyotaFaqs.map(([question,answer],index)=><details open={index===0}><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><p class="faq-empty" data-faq-empty hidden>No matching questions. <a href="/contact-us/">Ask us about your Toyota</a>.</p></div></section>
  <section class="manufacturer-final" aria-labelledby="final-title"><div><p class="overline">Start with the Toyota you have</p><h2 id="final-title">Ready to value<br /><span>your Toyota?</span></h2><p>Share your model, year and contact details to request a free valuation.</p></div><SectionActionButton href="#toyota-quote" label="Get my Toyota valuation" intent="valuation" /><p class="independent-note">Independent service. No affiliation with or endorsement by Toyota is implied.</p></section></div>
  <ManufacturerInteractions />
 </main>
</BaseLayout>
<style>
.toyota-page{--manufacturer-ink:#202b24;--manufacturer-muted:#616d62;background:#fafbf7;color:var(--manufacturer-ink);overflow:clip}.manufacturer-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.toyota-page :is(h1,h2,h3,p,figure){margin:0}.toyota-page h2{font-weight:650}.manufacturer-breadcrumb{display:flex;gap:10px;align-items:center;font-size:11px;color:#667365;padding:21px 0 0}.manufacturer-breadcrumb a{text-decoration:none}.manufacturer-breadcrumb a:hover{text-decoration:underline}.overline{font-size:11px;letter-spacing:.11em;text-transform:uppercase;font-weight:750;color:#4c6950;margin-bottom:17px!important}.manufacturer-hero{padding-top:28px}.hero-editorial{display:flex;align-items:end;gap:45px;justify-content:space-between;margin-bottom:28px}.hero-editorial .overline{display:flex;align-items:center;gap:10px}.brand-mark{display:grid;place-items:center;width:28px;height:28px;border:1px solid #c7d4bf;border-radius:50%;font-size:17px;color:#3f6c3c}.hero-editorial h1{font-size:clamp(44px,4.8vw,66px);line-height:1.02;font-weight:650;letter-spacing:-.06em}.hero-editorial h1 span{display:block}.hero-editorial h1 span:last-child{color:#52744b}.hero-intro{max-width:315px;line-height:1.8;font-size:14px;color:#626c61;padding-bottom:4px}.hero-stage{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);grid-template-areas:'photo form' 'points form';column-gap:24px;row-gap:0;align-items:stretch}.hero-vehicle{grid-area:photo;min-width:0;border-radius:16px;overflow:hidden;background:#e4e5db;align-self:stretch;position:relative}.hero-vehicle img{width:100%;height:100%;object-fit:cover;display:block;aspect-ratio:3/2;min-height:380px}.valuation-panel{grid-area:form;min-width:0;scroll-margin-top:24px}.valuation-panel :global(.quote-card){height:100%;padding:23px;border:1px solid #dce3d6;border-radius:16px;background:#fff;box-shadow:none}.valuation-panel :global(.quote-kicker){font-size:9px;letter-spacing:.06em}.valuation-panel :global(.quote-head h2){font-size:23px;line-height:1.2;letter-spacing:-.035em}.valuation-panel :global(.quote-head p){font-size:12px;line-height:1.6}.valuation-panel :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr;gap:13px 10px}.valuation-panel :global(form){gap:13px;margin-top:20px}.valuation-panel :global(.quote-card--free-quote input),.valuation-panel :global(.quote-card--free-quote select){height:49px;font-size:14px;padding-left:35px;padding-right:27px;border-radius:9px}.valuation-panel :global(.with-icon i){left:11px;font-size:17px}.valuation-panel :global(.field-label){font-size:11px}.valuation-panel :global(.submit){min-height:50px;font-size:12px;margin-top:5px;justify-content:space-between;padding-left:17px}.valuation-panel :global(.submit i){width:30px;height:30px}.hero-assurances{grid-area:points;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 2px 0;margin:0;font-size:11px;color:#4f654b;font-weight:650;line-height:1.4}.hero-assurances li{display:flex;align-items:center;gap:6px}.hero-assurances i{font-size:18px;flex-shrink:0}.experience-nav{display:flex;justify-content:space-between;border-top:1px solid #d9e0d4;border-bottom:1px solid #d9e0d4;margin-top:32px}.experience-nav a{display:flex;align-items:center;gap:14px;min-height:60px;text-decoration:none;font-size:12px;color:#384f37;font-weight:650}.experience-nav a span{font-size:10px;color:#7f9077}.experience-nav a i{font-size:19px;margin-left:12px}.experience-nav a:hover{color:#204d20}.value-editorial{display:grid;grid-template-columns:1fr 1.3fr;gap:80px;padding:0 0 75px}.value-editorial h2{font-size:clamp(34px,4vw,51px);letter-spacing:-.055em;line-height:1.06}.value-editorial h2 em{font-style:normal;color:#638156}.value-editorial header>p:not(.overline){font-size:14px;color:#65715f;line-height:1.8;margin:24px 0 14px}.text-link{display:inline-flex;align-items:center;gap:12px;min-height:44px;color:#375e30;text-decoration:none;font-size:12px;font-weight:750;border-bottom:1px solid #8aa07e}.text-link i{font-size:20px}.value-factors details{border-top:1px solid #cfd9c8}.value-factors details:last-of-type{border-bottom:1px solid #cfd9c8}.value-factors summary{display:flex;align-items:center;gap:18px;cursor:pointer;list-style:none;min-height:82px}.value-factors summary::-webkit-details-marker,.manufacturer-faq summary::-webkit-details-marker{display:none}.factor-number{font-size:12px;color:#69815f}.value-factors h3{font-size:19px;font-weight:600;letter-spacing:-.025em;flex:1;line-height:1.4}.value-factors summary i{font-size:19px}.value-factors details>p{font-size:14px;line-height:1.8;color:#65715f;padding:0 31px 23px}.value-factors details[open] summary i,.manufacturer-faq details[open] summary i{transform:rotate(45deg)}.value-note{display:flex;align-items:flex-start;gap:9px;font-size:11px;line-height:1.7;color:#6b7863;margin-top:21px!important}.value-note i{font-size:18px;flex-shrink:0}.assessment-editorial{padding-bottom:65px}.assessment-editorial header{display:grid;grid-template-columns:1.3fr 1fr;gap:0 60px;align-items:end;margin-bottom:25px}.assessment-editorial .overline{grid-column:1/-1}.assessment-editorial h2{font-size:clamp(32px,3.8vw,48px);line-height:1.08;letter-spacing:-.05em}.assessment-editorial h2 span{color:#64815b}.assessment-editorial header>p:not(.overline){font-size:14px;line-height:1.8;color:#6b7665;max-width:360px}.assessment-dossier{display:grid;grid-template-columns:1.65fr 1fr;gap:24px;align-items:stretch}.assessment-photo{height:auto;aspect-ratio:3/2;align-self:center;overflow:hidden;border-radius:16px;background:#d9dfd8}.assessment-photo img{width:100%;height:100%;object-fit:contain;object-position:50% 50%;display:block;transition:transform .5s ease}.assessment-notes{display:flex;flex-direction:column;justify-content:center;gap:25px;padding:28px;background:#edf1e7;border-radius:16px}.assessment-notes>div{position:relative;padding-left:33px}.assessment-notes>div>i{position:absolute;left:0;top:0;f