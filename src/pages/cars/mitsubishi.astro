---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import ConditionGraphic from '../../components/manufacturer/ConditionGraphic.astro';
import '../../components/manufacturer/manufacturer-body.css';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels,modelLabel,resolveModelGuidance} from '../../lib/manufacturer-models';
import {mitsubishiPreferred,mitsubishiProfiles,mitsubishiConditions,mitsubishiFactors,mitsubishiFaqs} from '../../lib/mitsubishi-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const models=manufacturerModels(vehicleData.models,'MITSUBISHI').map(item=>item.model);
const choices=mitsubishiPreferred.filter(model=>models.includes(model));const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,mitsubishiProfiles);const condition=mitsubishiConditions[0];
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['Car makes','/cars/'],['Mitsubishi','/cars/mitsubishi/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:mitsubishiFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\u003c');
---
<BaseLayout title="Scrap Mitsubishi Car in UAE | Free Valuation | Scrap My Car UAE" description="Scrap your Mitsubishi car in the UAE. Request a free valuation for a damaged, non-running or unwanted Lancer, Pajero, Outlander or other Mitsubishi model." canonical="/cars/mitsubishi/" ogImage="/sections/mitsubishi-lancer-valuation.webp">
 <Fragment slot="head"><script type="application/ld+json" set:html={json(breadcrumb)} /><script type="application/ld+json" set:html={json(faqSchema)} /></Fragment>
 <main class="mitsubishi-page" data-manufacturer-page><div class="mitsubishi-shell"><nav class="mitsubishi-breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
 <section class="mitsubishi-hero" aria-labelledby="mitsubishi-title"><header><p class="eyebrow">Mitsubishi / UAE scrap valuation</p><h1 id="mitsubishi-title"><span>Scrap Your Mitsubishi</span> <span>Car in the UAE</span></h1><p class="hero-intro">Request a free scrap valuation for a damaged, non-running, old or unwanted Mitsubishi. Share your model, year and the condition you know.</p><span class="hero-rule" aria-hidden="true"></span></header>
 <figure class="mitsubishi-hero-photo"><img src="/sections/mitsubishi-lancer-valuation.webp" srcset="/sections/mitsubishi-lancer-valuation-640.webp 640w, /sections/mitsubishi-lancer-valuation-960.webp 960w, /sections/mitsubishi-lancer-valuation.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 43vw, 510px" width="1440" height="960" fetchpriority="high" alt="Used 2012 Lancer-style Mitsubishi sedan with bumper scrapes and a small front-fender dent at a UAE assessment forecourt" /></figure>
 <div class="mitsubishi-quote" id="mitsubishi-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
 <ul class="mitsubishi-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running cars</li><li><i class="ph ph-key" aria-hidden="true"></i>Individual recovery review</li></ul></section>

 <section class="mitsubishi-models" data-model-explorer aria-labelledby="model-title"><header class="section-heading"><div><p class="eyebrow">01 / Find your Mitsubishi</p><h2 id="model-title">Daily driver. Family SUV. Work pickup.<br /><span>Which one are you moving on?</span></h2></div><p>Explore Mitsubishi models from the live catalogue. Choose one to add it to the valuation form above.</p></header>
 {models.length?<><script type="application/json" data-model-config set:html={json({make:'MITSUBISHI',models,profiles:mitsubishiProfiles,initial})} /><div class="model-controls"><div class="model-tabs" role="tablist" aria-label="Mitsubishi model guidance">{choices.map((model,i)=><button type="button" role="tab" id={'model-tab-'+i} data-model-choice={model} aria-controls="model-guidance" aria-selected={model===initial?'true':'false'} tabindex={model===initial?0:-1}>{modelLabel(model)}</button>)}</div><label for="manufacturer-all-models">All {models.length} Mitsubishi models<select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{modelLabel(model)}</option>)}</select></label></div>
 <div class="model-result" id="model-guidance" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="model-identity"><i class="ph ph-car-profile" aria-hidden="true"></i><strong data-model-name>{modelLabel(initial)}</strong><p class="eyebrow" data-model-category>{guidance.category}</p><span class="identity-note">Your model, your vehicle details.</span></div><div class="model-notes"><h3 data-model-heading>{guidance.title}</h3><p data-model-copy>{guidance.copy}</p><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><SectionActionButton href="#mitsubishi-quote" label={'Value my '+modelLabel(initial)} intent="valuation" /></div></div><p class="selection-status" data-model-status role="status" aria-live="polite"></p></>:<p>Catalogue options are temporarily unavailable. <a href="/contact-us/">Contact us about your Mitsubishi</a>.</p>}
 </section></div>
 <section class="mitsubishi-condition" data-condition-explorer aria-labelledby="condition-title"><div class="mitsubishi-shell"><header class="section-heading"><div><p class="eyebrow">02 / Condition &amp; next steps</p><h2 id="condition-title">What should we know<br /><span>about your Mitsubishi?</span></h2></div><p>Choose the closest description. The graphic highlights information to discuss, without diagnosing the vehicle or estimating a price.</p></header><script type="application/json" data-condition-config set:html={json(mitsubishiConditions)} /><div class="condition-workspace"><div class="condition-tabs" role="tablist" aria-label="Mitsubishi condition guidance">{mitsubishiConditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-controls="condition-guidance" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i>{item.label}<span aria-hidden="true">0{i+1}</span></button>)}</div><div class="condition-view"><ConditionGraphic /><div class="condition-notes" id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0"><p class="eyebrow" data-condition-category>{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul><a class="text-link" data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div></div></div><p class="selection-status" data-condition-status role="status" aria-live="polite"></p></div></section>
 <div class="mitsubishi-shell"><section class="mitsubishi-value" aria-labelledby="value-title"><header class="section-heading"><div><p class="eyebrow">03 / What shapes the assessment</p><h2 id="value-title">A clear valuation starts<br /><span>with four useful details.</span></h2></div><a class="text-link" href="/scrap-car-value/">How scrap-car value is assessed <i class="ph ph-book-open" aria-hidden="true"></i></a></header><div class="value-register">{mitsubishiFactors.map(([icon,label,title,copy],i)=><details open={i===0}><summary><span class="value-number">0{i+1}</span><i class:list={['ph',icon]} aria-hidden="true"></i><span class="value-label">{label}</span><h3>{title}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></section>
 <section class="mitsubishi-collection" aria-labelledby="collection-title"><figure data-manufacturer-reveal><img src="/sections/mitsubishi-pajero-assessment.webp" srcset="/sections/mitsubishi-pajero-assessment-640.webp 640w, /sections/mitsubishi-pajero-assessment-960.webp 960w, /sections/mitsubishi-pajero-assessment.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), 560px" width="1440" height="960" loading="lazy" decoding="async" alt="Used 2013 Pajero-style Mitsubishi SUV with rear bumper scuffs, a shallow quarter-panel dent and dusty paint" /><figcaption>Parked for a while? Known access and movement details help prepare the recovery discussion.</figcaption></figure><div class="collection-notes"><p class="eyebrow">04 / Before collection</p><h2 id="collection-title">A little preparation.<br /><span>A clearer handover.</span></h2><p>Open the notes that match your vehicle’s situation. Collection arrangements depend on review of the car and its location.</p><details open><summary><i class="ph ph-map-pin" aria-hidden="true"></i><h3>Location &amp; clearance</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Share the exact parking position, entrance height, gates and available space. A Pajero or L200 in a restricted bay needs access details before recovery is arranged. See our <a href="/locations/">UAE locations</a>.</p></details><details><summary><i class="ph ph-key" aria-hidden="true"></i><h3>Movement &amp; keys</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Mention missing keys, flat tyres, locked wheels or steering restrictions already known. Explain any load remaining in a pickup. Do not test or move a damaged car to enquire. Read our <a href="/car-removal/">car-removal guide</a>.</p></details><details><summary><i class="ph ph-identification-card" aria-hidden="true"></i><h3>Documents &amp; release</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Explain which ownership and registration documents you hold and who can authorise release. Confirm required paperwork, any transfer or deregistration steps and site permissions before handover.</p></details></div></section>
 <section class="mitsubishi-faq" data-manufacturer-faq aria-labelledby="faq-title"><header><p class="eyebrow">Mitsubishi scrap-car questions</p><h2 id="faq-title">A few things<br /><span>before you decide.</span></h2><p>Model selection, condition and collection explained.</p><a class="text-link" href="/contact-us/">Ask about your vehicle <i class="ph ph-chats-circle" aria-hidden="true"></i></a></header><div class="faq-list">{mitsubishiFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></section>
 <section class="mitsubishi-final" aria-labelledby="final-title"><div><p class="eyebrow">Start with the car you have</p><h2 id="final-title">Ready to move your<br /><span>Mitsubishi on?</span></h2><p>Request a free valuation with your model, year and contact details.</p></div><SectionActionButton href="#mitsubishi-quote" label="Get my Mitsubishi valuation" intent="valuation" /><p class="independent">Independent service. No Mitsubishi affiliation, authorisation or endorsement is implied.</p></section></div>
 <ManufacturerInteractions /></main></BaseLayout>
<style>
.mitsubishi-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.mitsubishi-breadcrumb{display:flex;align-items:center;gap:10px;font-size:11px;color:#6b7866;padding:21px 0 27px}.mitsubishi-breadcrumb a{color:inherit;text-decoration:none}.mitsubishi-breadcrumb a:hover{text-decoration:underline}.mitsubishi-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-areas:'heading photo' 'form form' 'points points';gap:24px 38px;padding-bottom:35px;align-items:center}.mitsubishi-hero header{grid-area:heading}.mitsubishi-hero h1{font-size:clamp(36px,4.1vw,57px);line-height:1.05;letter-spacing:-.055em;font-weight:600}.mitsubishi-hero h1 span{display:block}.mitsubishi-hero h1 span:last-child{color:var(--smc-green)}.hero-intro{font-size:14px;line-height:1.8;max-width:420px;margin-top:20px!important;color:#64715e}.hero-rule{display:block;width:55px;height:2px;background:#6d8760;margin-top:24px}.mitsubishi-hero-photo{grid-area:photo;border-radius:4px 36px 4px 4px;overflow:hidden;aspect-ratio:3/2;background:#e8e9e2}.mitsubishi-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.mitsubishi-quote{grid-area:form;scroll-margin-top:25px;min-width:0}.mitsubishi-quote :global(.quote-card--free-quote){display:grid;grid-template-columns:230px minmax(0,1fr);gap:30px;padding:25px;border-radius:14px;border:1px solid #d7dfd1;box-shadow:0 12px 35px #253c2210}.mitsubishi-quote :global(.quote-head){align-self:center}.mitsubishi-quote :global(.quote-head h2){font-size:25px;line-height:1.15;letter-spacing:-.04em}.mitsubishi-quote :global(.quote-head p){font-size:12px;line-height:1.7}.mitsubishi-quote :global(.quote-kicker){font-size:9px}.mitsubishi-quote :global(.quote-card--free-quote form){grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 15px;margin-top:0;align-items:end}.mitsubishi-quote :global(.quote-card--free-quote .field-grid){grid-column:1/-1;grid-template-columns:1.25fr 1.1fr .65fr 1fr;gap:12px 10px}.mitsubishi-quote :global(.model-availability){order:5;margin:0;font-size:10px}.mitsubishi-quote :global(.quote-card--free-quote input),.mitsubishi-quote :global(.quote-card--free-quote select){height:49px;font-size:13px;padding-left:32px;padding-right:24px;border-radius:8px}.mitsubishi-quote :global(.with-icon i){left:10px;font-size:17px}.mitsubishi-quote :global(.field-label){font-size:11px}.mitsubishi-quote :global(.submit){height:49px;min-height:49px;font-size:12px;margin:0;justify-content:space-between;padding-left:18px}.mitsubishi-quote :global(.submit i){width:30px;height:30px}.mitsubishi-quote :global(.data-error),.mitsubishi-quote :global(.submit-message){grid-column:1/-1}.mitsubishi-assurances{grid-area:points;list-style:none;display:flex;justify-content:center;gap:45px;margin:0;padding:0;font-size:11px;color:#5d7354;line-height:1.5}.mitsubishi-assurances li{display:flex;gap:8px;align-items:center}.mitsubishi-assurances i{font-size:19px}@media(max-width:1100px){.mitsubishi-hero{gap:25px}.mitsubishi-hero h1{font-size:43px}.mitsubishi-quote :global(.quote-card--free-quote){grid-template-columns:190px minmax(0,1fr);gap:22px;padding:21px}.mitsubishi-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr}}@media(max-width:900px){.mitsubishi-hero{grid-template-columns:1fr;grid-template-areas:'heading' 'form' 'photo' 'points'}.mitsubishi-hero-photo{width:100%;max-width:680px;justify-self:center}.mitsubishi-quote :global(.quote-card--free-quote){display:block}.mitsubishi-quote :global(.quote-card--free-quote form){margin-top:20px}.mitsubishi-assurances{justify-content:start;gap:25px}}@media(max-width:760px){.mitsubishi-shell{width:calc(100% - 36px)}.mitsubishi-breadcrumb{font-size:10px;padding:16px 0 22px}.mitsubishi-hero{gap:20px;padding-bottom:30px}.mitsubishi-hero h1{font-size:clamp(29px,6.7vw,44px);line-height:1.07;letter-spacing:-.055em}.hero-intro{font-size:13px;line-height:1.75;margin-top:16px!important}.hero-rule{display:none}.mitsubishi-hero-photo{border-radius:4px 25px 4px 4px}.mitsubishi-quote :global(.quote-card--free-quote){padding:18px;border-radius:14px}.mitsubishi-quote :global(.quote-head h2){font-size:22px}.mitsubishi-quote :global(.quote-head p){font-size:11px}.mitsubishi-quote :global(.quote-card--free-quote form){grid-template-columns:1fr;gap:12px;margin-top:15px}.mitsubishi-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr;gap:11px 9px}.mitsubishi-quote :global(.form-field[data-field="make"]),.mitsubishi-quote :global(.form-field[data-field="model"]){grid-column:1/-1}.mitsubishi-quote :global(.model-availability){order:0}.mitsubishi-quote :global(.quote-card--free-quote input),.mitsubishi-quote :global(.quote-card--free-quote select){font-size:16px;height:49px;padding-left:33px;padding-right:24px}.mitsubishi-quote :global(.submit){min-height:50px;margin-top:2px}.mitsubishi-assurances{display:grid;gap:9px;font-size:11px}}
.mitsubishi-page{background:#f7f8f2;color:#25382b}.mitsubishi-page :is(h1,h2,h3,p,figure){margin:0}.mitsubishi-page :is(section,header,figure,article){min-width:0}.mitsubishi-page h2{font-size:clamp(29px,3.1vw,42px);line-height:1.14;letter-spacing:-.045em;font-weight:600}.mitsubishi-page h2 span{color:var(--smc-green)}.eyebrow{font-size:10px;font-weight:750;letter-spacing:.12em;text-transform:uppercase;color:#2f6f2d;margin-bottom:15px!important}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:36px;margin-bottom:25px}.section-heading>p{max-width:330px;font-size:13px;line-height:1.8;color:#5f725c}.mitsubishi-models{padding:30px 0}.model-controls{display:flex;justify-content:space-between;gap:25px;align-items:end;margin-bottom:18px}.model-tabs{display:flex;flex-wrap:wrap;gap:7px}.model-tabs button{min-height:46px;border:1px solid #b9cfaf;border-radius:8px;padding:10px 18px;font:inherit;font-size:12px;color:#355d31;background:#fff;cursor:pointer}.model-controls label{display:grid;gap:8px;font-size:10px;color:#54714b;min-width:230px}.model-controls select{width:100%;min-width:0;min-height:46px;background:#fff;border:1px solid #b9cfaf;border-radius:8px;padding:10px 12px;color:#294d2a;font:inherit;font-size:14px}.model-result{display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.6fr);background:#fff;border:1px solid #c7dabd;overflow:hidden}.model-identity{background:#edf4e5;padding:25px;display:flex;flex-direction:column;justify-content:center;border-right:1px solid #cfdfc5}.model-identity>i{font-size:75px;color:#2f6f2d;margin-bottom:10px}.model-identity strong{font-size:38px;letter-spacing:-.04em;overflow-wrap:anywhere;line-height:1.15}.model-identity .eyebrow{margin-top:15px!important;font-size:9px;line-height:1.8}.identity-note{font-size:11px;color:#61745a;line-height:1.8}.model-notes{padding:27px 30px;min-height:330px}.model-notes h3,.condition-notes h3{font-size:25px;line-height:1.25;letter-spacing:-.03em;font-weight:600}.model-n