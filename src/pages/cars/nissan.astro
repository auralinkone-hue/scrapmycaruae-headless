---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import NissanWorkspace from '../../components/manufacturer/NissanWorkspace.astro';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels} from '../../lib/manufacturer-models';
import {nissanFactors,nissanFaqs} from '../../lib/nissan-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const makes=vehicleData.makes.filter(make=>make.make==='NISSAN');
const models=manufacturerModels(vehicleData.models,'NISSAN');
if(!makes.length&&!dataError)dataError='Nissan options are currently unavailable.';
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['Nissan','/cars/nissan/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:nissanFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<BaseLayout title="Scrap Nissan Car in UAE | Free Valuation | Scrap My Car UAE" description="Request a free Nissan scrap-car valuation in the UAE. Share your model, year, known damage or faults and collection access for an individual vehicle review." canonical="/cars/nissan/" ogImage="/sections/nissan-patrol-assessment.webp">
 <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumb).replace(/</g,'\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g,'\u003c')} /></Fragment>
 <main class="nissan-page" data-manufacturer-page>
 <section class="nissan-hero" aria-labelledby="nissan-title"><div class="nissan-shell">
  <nav class="breadcrumbs" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
  <div class="hero-composition"><header class="hero-heading"><p class="eyebrow"><i class="ph ph-car-profile" aria-hidden="true"></i>Nissan / Individual scrap assessment</p><h1 id="nissan-title"><span>Scrap Your Nissan</span> <span>Car in the UAE</span></h1><p class="hero-intro">Request a free scrap valuation for your damaged, non-running, old or unwanted Nissan.</p></header>
  <div class="nissan-form" id="nissan-quote" data-manufacturer-quote><QuoteForm makes={makes} models={models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
  <figure class="hero-photo"><img src="/sections/nissan-patrol-assessment.webp" srcset="/sections/nissan-patrol-assessment-640.webp 640w, /sections/nissan-patrol-assessment-960.webp 960w, /sections/nissan-patrol-assessment.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 52vw, 640px" width="1440" height="960" fetchpriority="high" alt="Graphite Patrol-style Nissan SUV with modest bumper scuffs at a UAE automotive assessment forecourt in warm daylight" /></figure>
  <ul class="hero-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running</li><li><i class="ph ph-key" aria-hidden="true"></i>Recovery access reviewed</li></ul></div>
  <div class="hero-footnote"><span>Condition first. A considered next step.</span><a href="#nissan-condition">Explore your vehicle’s condition <i class="ph ph-sliders-horizontal" aria-hidden="true"></i></a></div>
 </div></section>
 <div class="nissan-shell"><NissanWorkspace models={models.map(model=>model.model)} /></div>
 <section class="nissan-review" aria-labelledby="review-title"><div class="nissan-shell"><header><p class="eyebrow">04 / What goes into the review</p><h2 id="review-title">What affects the scrap<br />value of your Nissan?</h2><p>The vehicle, its condition and the practical next step.<br />No automatic prices or assumed outcomes.</p></header>
 <div class="review-composition"><figure data-manufacturer-reveal><img src="/sections/nissan-altima-workshop.webp" srcset="/sections/nissan-altima-workshop-640.webp 640w, /sections/nissan-altima-workshop-960.webp 960w, /sections/nissan-altima-workshop.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 48vw, 570px" width="1440" height="960" loading="lazy" decoding="async" alt="Silver Altima-style Nissan sedan with modest door wear awaiting assessment outside a UAE workshop in soft morning daylight" /></figure><div class="valuation-factors">{nissanFactors.map(([title,copy],i)=><details open={i===0}><summary><span>0{i+1}</span><h3>{title}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}<a href="/scrap-car-value/">Understand scrap-car value <i class="ph ph-book-open" aria-hidden="true"></i></a></div></div>
 <div class="review-links"><p>Start with an existing assessment, if you have one. Share what is known rather than guessing a diagnosis.</p><a href="/sell-damaged-car/">Damaged vehicles <i class="ph ph-car-profile" aria-hidden="true"></i></a><a href="/locations/">UAE collection locations <i class="ph ph-map-pin" aria-hidden="true"></i></a></div>
 </div></section>
 <div class="nissan-shell"><section class="nissan-journey" aria-labelledby="journey-title"><header><p class="eyebrow">A clear route forward</p><h2 id="journey-title">From your Nissan<br />to the next conversation.</h2></header><ol><li><i class="ph ph-car-profile" aria-hidden="true"></i><div><span>01 / Identify</span><h3>Model. Year. Your details.</h3><p>Select the exact catalogue options and provide your contact details in the form.</p></div></li><li><i class="ph ph-list-checks" aria-hidden="true"></i><div><span>02 / Explain</span><h3>Known condition &amp; access.</h3><p>Discuss damage, faults, missing parts and where the vehicle is parked.</p></div></li><li><i class="ph ph-chats-circle" aria-hidden="true"></i><div><span>03 / Discuss</span><h3>Valuation &amp; next steps.</h3><p>Review the individual vehicle and clarify collection and handover requirements.</p></div></li></ol></section>
 <section class="nissan-faq" data-manufacturer-faq aria-labelledby="faq-title"><header><div><p class="eyebrow">Nissan, explained</p><h2 id="faq-title">A few useful answers.</h2></div><div data-faq-search hidden class="faq-search"><label for="nissan-faq-search">Search Nissan questions<input type="search" id="nissan-faq-search" data-faq-input maxlength="120" placeholder="Try keys, documents or models" aria-describedby="nissan-faq-count" /></label><button type="button" data-faq-clear aria-label="Clear question search" hidden><i class="ph ph-x" aria-hidden="true"></i></button></div></header><p data-faq-count id="nissan-faq-count" role="status" aria-live="polite">{nissanFaqs.length} questions</p><div class="faq-list">{nissanFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><p data-faq-empty hidden>No matching questions. <a href="/contact-us/">Ask about your Nissan</a>.</p></section>
 <section class="nissan-final" aria-labelledby="final-title"><div><p class="eyebrow">Start with the vehicle you have</p><h2 id="final-title">Your Nissan.<br /><span>A clearer next step.</span></h2><p>Share your model, year and contact details for a free valuation request.</p></div><SectionActionButton href="#nissan-quote" label="Start my Nissan valuation" intent="valuation" /><p class="independent">Independent service. No Nissan affiliation, authorisation or endorsement is implied.</p></section></div>
 <ManufacturerInteractions />
 </main>
</BaseLayout>
<style>
.nissan-page{background:#f6f5ef;color:#253128}.nissan-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.nissan-page :is(h1,h2,h3,p,figure){margin:0}.nissan-page h2{font-size:clamp(32px,3.5vw,47px);line-height:1.08;letter-spacing:-.055em;font-weight:650}.eyebrow{font-size:10px;letter-spacing:.12em;text-transform:uppercase;font-weight:750;margin-bottom:17px!important;color:#63815a}.nissan-hero{background:#222826;color:#f4f4ed;padding-bottom:22px}.breadcrumbs{display:flex;align-items:center;gap:10px;font-size:11px;color:#b3c0b2;padding:20px 0 24px}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{text-decoration:underline}.hero-composition{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);grid-template-areas:'heading form' 'photo form' 'points form';gap:20px 34px;align-items:start}.hero-heading{grid-area:heading}.hero-heading .eyebrow{display:flex;align-items:center;gap:10px;color:#b2c8a3;font-size:9px;margin-bottom:16px!important}.hero-heading .eyebrow i{font-size:22px}.hero-heading h1{font-size:clamp(38px,4.2vw,58px);font-weight:650;letter-spacing:-.06em;line-height:1.02}.hero-heading h1 span{display:block}.hero-heading h1 span:last-child{color:#c1cfb6}.hero-intro{font-size:13px;line-height:1.8;max-width:480px;color:#c9d0c5;margin-top:18px!important}.hero-photo{grid-area:photo;border-radius:12px;overflow:hidden;background:#3b3d36;aspect-ratio:3/2;max-width:100%}.hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.nissan-form{grid-area:form;min-width:0;scroll-margin-top:20px;padding-top:0}.nissan-form :global(.quote-card){border:0;border-radius:16px;padding:24px;box-shadow:none;background:#fff}.nissan-form :global(.quote-kicker){font-size:9px;letter-spacing:.07em}.nissan-form :global(.quote-head h2){font-size:24px;line-height:1.2;letter-spacing:-.04em}.nissan-form :global(.quote-head p){font-size:12px;line-height:1.6}.nissan-form :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr;gap:14px 10px}.nissan-form :global(form){gap:14px;margin-top:22px}.nissan-form :global(.quote-card--free-quote input),.nissan-form :global(.quote-card--free-quote select){height:49px;font-size:14px;padding-left:34px;padding-right:25px;border-radius:9px}.nissan-form :global(.field-label){font-size:11px}.nissan-form :global(.with-icon i){left:10px;font-size:17px}.nissan-form :global(.submit){min-height:50px;font-size:12px;justify-content:space-between;margin-top:6px;padding-left:17px}.nissan-form :global(.submit i){width:30px;height:30px}.hero-assurances{grid-area:points;list-style:none;padding:0;margin:0;display:flex;gap:14px;justify-content:space-between;font-size:10px;color:#c4d0bb;line-height:1.5}.hero-assurances li{display:flex;align-items:center;gap:7px}.hero-assurances i{font-size:18px;flex-shrink:0}.hero-footnote{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #495047;margin-top:26px;padding-top:18px;font-size:11px;color:#acbca5}.hero-footnote a{display:inline-flex;align-items:center;gap:13px;min-height:44px;color:#d5dfce;font-weight:600;text-underline-offset:4px}.hero-footnote i{font-size:19px}.nissan-review{background:#e9ece2;padding:45px 0 30px}.nissan-review header{display:grid;grid-template-columns:1fr 1fr;gap:0 50px;align-items:end;margin-bottom:30px}.nissan-review .eyebrow{grid-column:1/-1}.nissan-review header>p:last-child{font-size:13px;line-height:1.8;color:#62715a;max-width:370px;justify-self:end}.review-composition{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center}.review-composition figure{border-radius:13px;overflow:hidden;aspect-ratio:3/2}.review-composition img{width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;display:block;transition:filter .3s}.valuation-factors details{border-top:1px solid #c5d0bd}.valuation-factors summary{display:flex;align-items:center;gap:15px;list-style:none;cursor:pointer;min-height:61px}.valuation-factors summary>span{font-size:10px;color:#6e8263}.valuation-factors h3{font-size:16px;line-height:1.4;font-weight:600;flex:1}.valuation-factors summary>i{font-size:18px}.valuation-factors details>p{font-size:12px;color:#607058;line-height:1.85;padding:0 22px 18px 29px}.valuation-factors a,.review-links a{display:inline-flex;align-items:center;gap:12px;min-height:46px;color:#3e6135;font-size:12px;text-underline-offset:4px;font-weight:600}.review-links{display:flex;align-items:center;gap:28px;border-top:1px solid #c6d0be;margin-top:29px;padding-top:21px}.review-links>p{font-size:12px;color:#62735a;line-height:1.8;max-width:510px;margin-right:auto}.review-links a{flex-shrink:0}.nissan-journey{display:grid;grid-template-columns:1fr 1.2fr;gap:65px;padding:55px 0;border-bottom:1px solid #d6ddcf}.nissan-journey ol{list-style:none;padding:0;margin:0;display:grid;gap:25px}.nissan-journey li{display:flex;gap:20px}.nissan-journey li>i{font-size:26px;color:#6a815f;border:1px solid #d1dbc9;border-radius:50%;width:49px;height:49px;display:grid;place-items:center;flex-shrink:0}.nissan-journey li span{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#6c7c63}.nissan-journey h3{font-size:20px;line-height:1.3;letter-spacing:-.025em;font-weight:600;margin:8px 0 10px}.nissan-journey li p{font-size:13px;color:#66735f;line-height:1.8}.nissan-faq{padding:50px 0}.nissan-faq header{display:flex;align-items:end;justify-content:space-between;gap:40px}.faq-search{display:flex;gap:8px;align-items:end;width:340px;max-width:100%}.faq-search[hidden],.faq-search button[hidden]{display:none}.faq-search label{display:grid;gap:9px;font-size:11px;color:#63765a;flex:1;min-width:0}.faq-search input{width:100%;min-height:48px;border:1px solid #c7d3be;border-radius:8px;background:#fff;padding:11px;font:inherit;font-size:16px;color:#30492c}.faq-search button{width:44px;height:48px;flex-shrink:0;border:1px solid #c7d3be;border-radius:8px;background:#e7eddf;font-size:20px;color:#395331;cursor:pointer}.nissan-faq [data-faq-count]{font-size:10px;color:#708166;margin:20px 0 12px}.faq-list{display:grid;grid-template-columns:1fr 1fr;gap:0 45px;align-items:start}.faq-list details{border-top:1px solid #d0dac8}.faq-list summary{display:flex;gap:20px;align-items:center;list-style:none;min-height:83px;padding:17px 0;cursor:pointer}.faq-list h3{font-size:13px;font-weight:650;line-height:1.7;flex:1}.faq-list summary i{font-size:19px;flex-shrink:0}.faq-list details>p{font-size:12px;color:#63745a;line-height:1.9;padding:0 25px 24px 0}.nissan-page summary::-webkit-details-marker{display:none}.nissan-page details[open] summary>i{transform:rotate(45deg)}.nissan-final{display:grid;grid-template-columns:1fr auto;gap:25px;align-items:center;border-radius:16px;padding:34px;background:#24362d;color:#f6f6ed;margin-bottom:40px}.nissan-final h2 span{color:#bbceb0}.nissan-final .eyebrow{color:#aec79d}.nissan-final>div>p:last-child{font-size:13px;line-height:1.8;color:#c3d1ba;margin-top:19px}.nissan-final :global(.section-action){font-size:12px;background:#e2edda;color:#264522;box-shadow:none}.independent{grid-column:1/-1;border-top:1px solid #4b604b;padding-top:20px;font-size:11px;line-height:1.8;color:#b8c7af}.nissan-page :is(a,button,input,select,summary,[tabindex]):focus-visible{outline:3px solid #6d9fcf;outline-offset:4px}.nissan-page :global(.reveal-ready){opacity:0;transform:translateY(10px);transition:opacity .4s,transform .4s}.nissan-page :global(.is-revealed){opacity:1;transform:none}
@media(hover:hover){.review-composition figure:hover img{filter:brightness(1.04)}}
@media(max-width:1100px){.hero-composition{grid-template-columns:1.2fr 1fr;gap:22px}.hero-heading h1{font-size:43px}.hero-assurances{flex-wrap:wrap;justify-content:start;gap:10px 20px}.nissan-form :global(.quote-card){padding:21px}.review-composition{gap:28px}.review-links{flex-wrap:wrap;gap:10px 25px}.review-links>p{width:100%;max-width:none}.nissan-journey{gap:35px}}
@media(max-width:900px){.hero-composition{grid-template-columns:1fr;grid-template-areas:'heading' 'form' 'points' 'photo';gap:23px}.hero-heading h1{font-size:50px}.hero-heading .hero-intro{max-width:540px}.hero-photo{max-width:100%;width:100%}.hero-assurances{font-size:11px;gap:22px}.nissan-form :global(.quote-card){padding:24px}.review-composition{grid-template-columns:1fr}.review-composition figure{max-width:650px;width:100%;justify-self:center}.nissan-review header{gap:30px}.nissan-review header>p:last-child{font-size:12px}.faq-list{gap:0 25px}}
@media(max-width:760px){.nissan-shell{width:calc(100% - 36px)}.nissan-hero{padding-bottom:17px}.breadcrumbs{font-size:10px;padding:16px 0 21px}.hero-heading .eyebrow{font-size:8px;margin-bottom:13px!important;gap:8px}.hero-heading .eyebrow i{font-size:18px}.hero-heading h1{font-size:clamp(33px,6.8vw,48px);line-height:1.04;letter-spacing:-.055em}.hero-intro{font-size:13px;line-height:1.75;margin-top:16px!important}.hero-composition{gap:20px}.nissan-form :global(.quote-card){padding:19px}.nissan-form :global(.quote-head h2){font-size:22px}.nissan-form :global(.quote-head p){font-size:11px}.nissan-form :global(form){margin-top:16px;gap:12px}.nissan-form :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr;gap:11px 9px}.nissan-form :global(.quote-card--free-quote input),.nissan-form :global(.quote-card--free-quote select){font-size:16px;height:49px;padding-left:34px;padding-right:24px}.nissan-form :global(.quote-card--free-quote .form-field[data-field="make"]),.nissan-form :global(.quote-card--free-quote .form-field[data-field="model"]){grid-column:1/-1}.nissan-form :global(.submit){margin-top:2px;min-height:50px;font-size:12px}.hero-assurances{display:grid;gap:9px;font-size:11px}.hero-photo{border-radius:11px}.hero-footnote{display:block;margin-top:20px;padding-top:18px;font-size:10px}.hero-footnote>span{display:none}.hero-footnote a{min-height:44px;font-size:11px}.nissan-page h2{font-size:33px}.nissan-review{padding:32px 0 23px}.nissan-review header{display:block;margin-bottom:23px}.nissan-review header>p:last-child{font-size:13px;margin-top:17px}.review-composition{gap:23px}.valuation-factors summary{min-height:64px;gap:12px}.valuation-factors h3{font-size:15px}.valuation-factors details>p{font-size:12px;padding-left:25px}.review-links{margin-top:19px;padding-top:19px;gap:8px 20px}.review-links>p{font-size:12px}.review-links a{font-size:11px}.nissan-journey{display:block;padding:35px 0}.nissan-journey ol{margin-top:26px;gap:25px}.nissan-journey li{gap:16px}.nissan-journey h3{font-size:19px}.nissan-journey li p{font-size:12px}.nissan-faq{padding:35px 0}.nissan-faq header{display:block}.faq-search{margin-top:25px;width:100%}.nissan-faq [data-faq-count]{margin:16px 0 10px}.faq-list{display:block}.faq-list summary{min-height:75px;gap:16px}.faq-list h3{font-size:13px}.faq-list details>p{font-size:12px}.nissan-final{display:block;padding:26px 23px;margin-bottom:32px}.nissan-final>div>p:last-child{font-size:12px;margin-top:17px}.nissan-final :global(.section-action){margin-top:23px;min-height:48px;font-size:12px}.independent{margin-top:25px!important;font-size:11px}.eyebrow{font-size:9px;margin-bottom:14px!important}}
@media(prefers-reduced-motion:reduce){.nissan-page :global(.reveal-ready){opacity:1;transform:none;transition:none}.review-composition img,.nissan-page :global(.section-action){transition:none;transform:none}}
</style>
