---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import ConditionGraphic from '../../components/manufacturer/ConditionGraphic.astro';
import '../../components/manufacturer/manufacturer-body.css';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels,modelLabel,resolveModelGuidance} from '../../lib/manufacturer-models';
import {kiaPreferred,kiaProfiles,kiaConditions,kiaFactors,kiaFaqs} from '../../lib/kia-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const models=manufacturerModels(vehicleData.models,'KIA').map(item=>item.model);
const choices=kiaPreferred.filter(model=>models.includes(model));const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,kiaProfiles);const condition=kiaConditions[0];
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['Car makes','/cars/'],['Kia','/cars/kia/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:kiaFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\u003c');
---
<BaseLayout title="Scrap Kia Car in UAE | Free Valuation | Scrap My Car UAE" description="Scrap your Kia car in the UAE. Request a free valuation for a damaged, non-running or unwanted Cerato, Optima, Sportage, Sorento, Rio or other Kia model." canonical="/cars/kia/" ogImage="/sections/kia-cerato-valuation.webp"><Fragment slot="head"><script type="application/ld+json" set:html={json(breadcrumb)} /><script type="application/ld+json" set:html={json(faqSchema)} /></Fragment><main class="kia-page" data-manufacturer-page><div class="kia-shell"><nav class="kia-breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
 <section class="kia-hero" aria-labelledby="kia-title"><header><p class="eyebrow">Kia / UAE scrap valuation</p><h1 id="kia-title"><span>Scrap Your Kia</span> <span>Car in the UAE</span></h1><p class="hero-intro">Request a free scrap valuation for a damaged, non-running, old or unwanted Kia. Share your model, year and the condition you know.</p><span class="hero-rule" aria-hidden="true"></span></header>
 <figure class="kia-hero-photo"><img src="/sections/kia-cerato-valuation.webp" srcset="/sections/kia-cerato-valuation-640.webp 640w, /sections/kia-cerato-valuation-960.webp 960w, /sections/kia-cerato-valuation.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 43vw, 510px" width="1440" height="960" fetchpriority="high" alt="Used early-2010s Cerato-style Kia sedan with front bumper scrapes, a shallow fender dent and door scratches at a UAE assessment forecourt" /></figure>
 <div class="kia-quote" id="kia-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
 <ul class="kia-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running cars</li><li><i class="ph ph-key" aria-hidden="true"></i>Individual recovery review</li></ul></section>



<section class="kia-models" data-model-explorer aria-labelledby="model-title">
 <header class="section-heading"><div><p class="eyebrow">01 / Identify your Kia</p><h2 id="model-title">Choose your model.<br /><span>Make the details count.</span></h2></div><p>Select a Kia from the live vehicle catalogue. Your choice updates the valuation form above; the form also accepts other makes.</p></header>
 {models.length?<><script type="application/json" data-model-config set:html={json({make:'KIA',models,profiles:kiaProfiles,initial})} /><div class="model-directory"><div class="model-tabs" role="tablist" aria-label="Kia model guidance">{choices.map((model,i)=><button type="button" role="tab" id={'model-tab-'+i} data-model-choice={model} aria-controls="model-guidance" aria-selected={model===initial?'true':'false'} tabindex={model===initial?0:-1}>{modelLabel(model)}</button>)}</div><label for="manufacturer-all-models">All {models.length} Kia models<select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{modelLabel(model)}</option>)}</select></label></div>
 <div class="model-result" id="model-guidance" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="model-display"><span class="model-kicker">Your selected Kia</span><strong data-model-name>{modelLabel(initial)}</strong><p data-model-category>{guidance.category}</p><div class="model-route" aria-hidden="true"><i class="ph ph-car-profile"></i><span></span><i class="ph ph-list-checks"></i><span></span><i class="ph ph-truck"></i></div><span class="display-note">Model details · Condition · Collection</span></div><div class="model-notes"><h3 data-model-heading>{guidance.title}</h3><p data-model-copy>{guidance.copy}</p><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><SectionActionButton href="#kia-quote" label={'Value my '+modelLabel(initial)} intent="valuation" /></div></div><p class="selection-status" data-model-status role="status" aria-live="polite"></p></>:<p>Catalogue options are temporarily unavailable. <a href="/contact-us/">Ask about your Kia</a>.</p>}
</section>
<section class="kia-value" aria-labelledby="value-title"><header class="section-heading"><div><p class="eyebrow">02 / What informs the valuation</p><h2 id="value-title">Your Kia’s value starts<br /><span>with its condition today.</span></h2></div><a class="text-link" href="/scrap-car-value/">Explore scrap-car value <i class="ph ph-book-open" aria-hidden="true"></i></a></header><div class="value-layout"><figure data-manufacturer-reveal><img src="/sections/kia-sportage-assessment.webp" srcset="/sections/kia-sportage-assessment-640.webp 640w, /sections/kia-sportage-assessment-960.webp 960w, /sections/kia-sportage-assessment.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), 650px" width="1440" height="960" loading="lazy" decoding="async" alt="Used early-2010s bronze Sportage-style Kia SUV with rear bumper scuffs, lower-panel scratches and a shallow rear door dent" /><figcaption>Known condition, completeness and collection access matter more than assumptions about a model.</figcaption></figure><div class="value-notes"><p class="value-intro">Open each factor to see what helps an individual assessment. There is no automatic price from the model name.</p>{kiaFactors.map(([icon,title,copy],i)=><details open={i===0}><summary><span>0{i+1}</span><i class:list={['ph',icon]} aria-hidden="true"></i><h3>{title}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></div></section></div>
<section class="kia-condition" data-condition-explorer aria-labelledby="condition-title"><div class="kia-shell"><header class="section-heading"><div><p class="eyebrow">03 / A closer look</p><h2 id="condition-title">What is your Kia<br /><span>like right now?</span></h2></div><p>Choose a condition for useful details to discuss. The graphic is a guide to information, without diagnosing a fault or setting a price.</p></header><script type="application/json" data-condition-config set:html={json(kiaConditions)} /><div class="condition-tabs" role="tablist" aria-label="Kia condition guidance">{kiaConditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-controls="condition-guidance" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i><span>{item.label}</span><span class="condition-dot" aria-hidden="true"></span></button>)}</div><div class="condition-layout"><div class="condition-visual"><ConditionGraphic /><p>Use existing photos and workshop notes. You do not need to test a damaged vehicle to request a review.</p></div><div class="condition-notes" id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0"><p class="eyebrow" data-condition-category>{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul><a class="text-link" data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div></div><p class="selection-status" data-condition-status role="status" aria-live="polite"></p></div></section>
<div class="kia-shell"><section class="kia-collection" aria-labelledby="collection-title"><header><p class="eyebrow">04 / Before collection</p><h2 id="collection-title">Three checks for<br /><span>a clearer handover.</span></h2><p>Explain the vehicle’s current position and confirm practical requirements before agreeing arrangements.</p><SectionActionButton href="/car-removal/" label="Read collection guidance" intent="process" icon="ph-truck" /></header><div class="collection-timeline"><details open><summary><span class="step-number">01</span><div><small>Access</small><h3>Where is your Kia parked?</h3></div><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Share the exact location, entrance clearance, gates and surrounding space. A Sportage or Sorento in a basement needs access details before recovery is arranged. Check our <a href="/locations/">UAE locations</a>.</p></details><details><summary><span class="step-number">02</span><div><small>Mobility</small><h3>What is already known about movement?</h3></div><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Mention key availability, flat tyres, locked wheels and steering restrictions already known. Do not start or move a damaged car simply to enquire.</p></details><details><summary><span class="step-number">03</span><div><small>Release</small><h3>Who can authorise handover?</h3></div><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Explain available ownership and registration documents and who may release the vehicle. Confirm required paperwork, any relevant transfer or deregistration steps and site permissions before collection is agreed.</p></details></div></section>
<section class="kia-faq" data-manufacturer-faq aria-labelledby="faq-title"><header class="section-heading"><div><p class="eyebrow">Kia scrap-car questions</p><h2 id="faq-title">A few answers<br /><span>before you get started.</span></h2></div><a class="text-link" href="/contact-us/">Ask about your Kia <i class="ph ph-chats-circle" aria-hidden="true"></i></a></header><div class="faq-list">{kiaFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></section>
<section class="kia-final" aria-labelledby="final-title"><div><p class="eyebrow">Start with your vehicle details</p><h2 id="final-title">Ready to move<br /><span>your Kia on?</span></h2><p>Request a free valuation for your damaged, non-running or unwanted Kia.</p></div><SectionActionButton href="#kia-quote" label="Get my Kia valuation" intent="valuation" /><p class="independent">Independent service. No Kia affiliation, authorisation or endorsement is implied.</p></section></div><ManufacturerInteractions /></main></BaseLayout>
<style>
.kia-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.kia-breadcrumb{display:flex;align-items:center;gap:10px;font-size:11px;color:#6b7866;padding:21px 0 27px}.kia-breadcrumb a{color:inherit;text-decoration:none}.kia-breadcrumb a:hover{text-decoration:underline}.kia-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-areas:'heading photo' 'form form' 'points points';gap:24px 38px;padding-bottom:35px;align-items:center}.kia-hero header{grid-area:heading}.kia-hero h1{font-size:clamp(36px,4.1vw,57px);line-height:1.05;letter-spacing:-.055em;font-weight:600}.kia-hero h1 span{display:block}.kia-hero h1 span:last-child{color:var(--smc-green)}.hero-intro{font-size:14px;line-height:1.8;max-width:420px;margin-top:20px!important;color:#64715e}.hero-rule{display:block;width:55px;height:2px;background:#6d8760;margin-top:24px}.kia-hero-photo{grid-area:photo;border-radius:4px 36px 4px 4px;overflow:hidden;aspect-ratio:3/2;background:#e8e9e2}.kia-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.kia-quote{grid-area:form;scroll-margin-top:25px;min-width:0}.kia-quote :global(.quote-card--free-quote){display:grid;grid-template-columns:230px minmax(0,1fr);gap:30px;padding:25px;border-radius:14px;border:1px solid #d7dfd1;box-shadow:0 12px 35px #253c2210}.kia-quote :global(.quote-head){align-self:center}.kia-quote :global(.quote-head h2){font-size:25px;line-height:1.15;letter-spacing:-.04em}.kia-quote :global(.quote-head p){font-size:12px;line-height:1.7}.kia-quote :global(.quote-kicker){font-size:9px}.kia-quote :global(.quote-card--free-quote form){grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 15px;margin-top:0;align-items:end}.kia-quote :global(.quote-card--free-quote .field-grid){grid-column:1/-1;grid-template-columns:1.25fr 1.1fr .65fr 1fr;gap:12px 10px}.kia-quote :global(.model-availability){order:5;margin:0;font-size:10px}.kia-quote :global(.quote-card--free-quote input),.kia-quote :global(.quote-card--free-quote select){height:49px;font-size:13px;padding-left:32px;padding-right:24px;border-radius:8px}.kia-quote :global(.with-icon i){left:10px;font-size:17px}.kia-quote :global(.field-label){font-size:11px}.kia-quote :global(.submit){height:49px;min-height:49px;font-size:12px;margin:0;justify-content:space-between;padding-left:18px}.kia-quote :global(.submit i){width:30px;height:30px}.kia-quote :global(.data-error),.kia-quote :global(.submit-message){grid-column:1/-1}.kia-assurances{grid-area:points;list-style:none;display:flex;justify-content:center;gap:45px;margin:0;padding:0;font-size:11px;color:#5d7354;line-height:1.5}.kia-assurances li{display:flex;gap:8px;align-items:center}.kia-assurances i{font-size:19px}@media(max-width:1100px){.kia-hero{gap:25px}.kia-hero h1{font-size:43px}.kia-quote :global(.quote-card--free-quote){grid-template-columns:190px minmax(0,1fr);gap:22px;padding:21px}.kia-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr}}@media(max-width:900px){.kia-hero{grid-template-columns:1fr;grid-template-areas:'heading' 'form' 'photo' 'points'}.kia-hero-photo{width:100%;max-width:680px;justify-self:center}.kia-quote :global(.quote-card--free-quote){display:block}.kia-quote :global(.quote-card--free-quote form){margin-top:20px}.kia-assurances{justify-content:start;gap:25px}}@media(max-width:760px){.kia-shell{width:calc(100% - 36px)}.kia-breadcrumb{font-size:10px;padding:16px 0 22px}.kia-hero{gap:20px;padding-bottom:30px}.kia-hero h1{font-size:clamp(29px,6.7vw,44px);line-height:1.07;letter-spacing:-.055em}.hero-intro{font-size:13px;line-height:1.75;margin-top:16px!important}.hero-rule{display:none}.kia-hero-photo{border-radius:4px 25px 4px 4px}.kia-quote :global(.quote-card--free-quote){padding:18px;border-radius:14px}.kia-quote :global(.quote-head h2){font-size:22px}.kia-quote :global(.quote-head p){font-size:11px}.kia-quote :global(.quote-card--free-quote form){grid-template-columns:1fr;gap:12px;margin-top:15px}.kia-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr;gap:11px 9px}.kia-quote :global(.form-field[data-field="make"]),.kia-quote :global(.form-field[data-field="model"]){grid-column:1/-1}.kia-quote :global(.model-availability){order:0}.kia-quote :global(.quote-card--free-quote input),.kia-quote :global(.quote-card--free-quote select){font-size:16px;height:49px;padding-left:33px;padding-right:24px}.kia-quote :global(.submit){min-height:50px;margin-top:2px}.kia-assurances{display:grid;gap:9px;font-size:11px}}
.kia-page{background:#f8f8f3;color:#263a2c}.kia-page :is(h1,h2,h3,p,figure){margin:0}.kia-page :is(section,header,figure,aside){min-width:0}.kia-page h2{font-size:clamp(30px,3.3vw,44px);line-height:1.12;font-weight:600;letter-spacing:-.045em}.kia-page h2 span{color:var(--smc-green)}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:750;color:#2f6f2d;margin-bottom:15px!important}.section-heading{display:flex;justify-content:space-between;gap:35px;align-items:end;margin-bottom:25px}.section-heading>p{max-width:340px;font-size:13px;line-height:1.85;color:#607459}.kia-models{padding:30px 0}.model-directory{display:flex;gap:25px;justify-content:space-between;align-items:end;padding-bottom:20px;border-bottom:1px solid #c7d8bc}.model-tabs{display:flex;flex-wrap:wrap;gap:7px}.model-tabs button{min-height:45px;padding:10px 17px;border:1px solid #bcd1af;background:#fff;color:#3c6534;border-radius:999px;font:inherit;font-size:12px;cursor:pointer}.model-directory label{display:grid;gap:8px;min-width:235px;font-size:10px;color:#527548}.model-directory select{width:100%;min-width:0;min-height:46px;padding:10px 12px;border:1px solid #b9cfae;background:#fff;border-radius:8px;color:#31562e;font:inherit;font-size:14px}.model-result{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.3fr);gap:38px;padding:28px 0 12px;min-height:340px}.model-display{display:flex;flex-direction:column;justify-content:center;padding-right:25px;border-right:1px solid #cfddc5;min-width:0}.model-kicker{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#66835a}.model-display strong{font-size:clamp(42px,5vw,66px);line-height:1.1;letter-spacing:-.055em;color:#2f6f2d;font-weight:550;overflow-wrap:anywhere;margin-top:13px}.model-display>p{font-size:11px;line-height:1.8;color:#5c7951;margin-top:12px}.model-route{display:flex;align-items:center;gap:12px;margin-top:25px;color:#2f6f2d;max-width:320px}.model-route i{font-size:29px;flex-shrink:0}