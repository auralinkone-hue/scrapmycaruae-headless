---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import ConditionGraphic from '../../components/manufacturer/ConditionGraphic.astro';
import HondaCollectionNotes from '../../components/manufacturer/HondaCollectionNotes.astro';
import '../../components/manufacturer/manufacturer-body.css';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels,modelLabel,resolveModelGuidance} from '../../lib/manufacturer-models';
import {hondaPreferred,hondaProfiles,hondaConditions,hondaFactors,hondaFaqs} from '../../lib/honda-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const models=manufacturerModels(vehicleData.models,'HONDA').map(item=>item.model);
const choices=hondaPreferred.filter(model=>models.includes(model));const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,hondaProfiles);const condition=hondaConditions[0];
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['Honda','/cars/honda/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:hondaFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\\u003c');
---
<BaseLayout title="Scrap Honda Car in UAE | Free Valuation | Scrap My Car UAE" description="Request a free Honda scrap-car valuation in the UAE. Explore model and condition guidance for damaged, non-running, old or unwanted cars and discuss collection." canonical="/cars/honda/" ogImage="/sections/honda-accord-valuation.webp">
 <Fragment slot="head"><script type="application/ld+json" set:html={json(breadcrumb)} /><script type="application/ld+json" set:html={json(faqSchema)} /></Fragment>
 <main class="honda-page" data-manufacturer-page>
 <div class="honda-shell"><nav class="honda-breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
 <section class="honda-hero" aria-labelledby="honda-title"><header><p class="eyebrow">Honda / UAE scrap valuation</p><h1 id="honda-title"><span>Scrap Your Honda</span> <span>Car in the UAE</span></h1><p class="hero-intro">Request a free scrap valuation for a damaged, non-running, old or unwanted Honda. Start with the model, year and details you know.</p><span class="hero-rule" aria-hidden="true"></span></header>
 <figure class="honda-hero-photo"><img src="/sections/honda-accord-valuation.webp" srcset="/sections/honda-accord-valuation-640.webp 640w, /sections/honda-accord-valuation-960.webp 960w, /sections/honda-accord-valuation.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 43vw, 510px" width="1440" height="960" fetchpriority="high" alt="Used silver 2013 Accord-style Honda sedan with a dented front wing and scuffed bumper at an independent UAE inspection forecourt" /></figure>
 <div class="honda-quote" id="honda-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
 <ul class="honda-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running cars</li><li><i class="ph ph-key" aria-hidden="true"></i>Recovery access reviewed</li></ul></section>
 <section class="honda-models" id="honda-models" data-model-explorer aria-labelledby="model-title"><header class="section-heading"><div><p class="eyebrow">01 / Model details</p><h2 id="model-title">Choose your Honda.<br /><span>Prepare the right details.</span></h2></div><p>Honda guidance only. Choose a model to add it to your form; the form also accepts other makes.</p></header>
 {models.length?<><script type="application/json" data-model-config set:html={json({make:'HONDA',models,profiles:hondaProfiles,initial})} /><div class="honda-model-controls"><div class="model-tabs" role="tablist" aria-label="Honda model guidance">{choices.map((model,i)=><button type="button" role="tab" id={'model-tab-'+i} data-model-choice={model} aria-controls="model-guidance" aria-selected={model===initial?'true':'false'} tabindex={model===initial?0:-1}>{modelLabel(model)}<i class="ph ph-car-profile" aria-hidden="true"></i></button>)}</div><label for="manufacturer-all-models">All {models.length} Honda models<select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{modelLabel(model)}</option>)}</select></label></div>
 <div class="honda-model-detail" id="model-guidance" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="selected-model"><span>Honda model guidance</span><strong data-model-name>{modelLabel(initial)}</strong><svg viewBox="0 0 300 125" fill="none" aria-hidden="true" focusable="false"><path d="m24 82 10-24 47-8 34-25h77l40 28 33 10 13 23v14h-24m-183 0h139M50 100H22V86l2-4Z"/><path d="m94 51 27-20h65l29 22H94Zm61-20v22M96 60v35m63-35v35m64-33 6 33M111 67h13m55 0h13M36 71h20m192 3h18"/><circle cx="71" cy="99" r="20"/><circle cx="232" cy="99" r="20"/><circle cx="71" cy="99" r="9"/><circle cx="232" cy="99" r="9"/><path class="model-ground" d="M10 122h280"/></svg><small>Choose the exact catalogue model and year.</small></div><div class="model-notes"><p class="eyebrow" data-model-category>{guidance.category}</p><h3 data-model-heading>{guidance.title}</h3><p data-model-copy>{guidance.copy}</p><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><SectionActionButton href="#honda-quote" label={'Value my '+modelLabel(initial)} intent="valuation" /></div></div><p class="selection-status" data-model-status role="status" aria-live="polite"></p></>:<p>The vehicle catalogue is temporarily unavailable. <a href="/contact-us/">Ask about your Honda</a>.</p>}
 </section>
 <section class="honda-value" aria-labelledby="value-title"><header class="section-heading"><div><p class="eyebrow">02 / The assessment</p><h2 id="value-title">What affects<br /><span>your Honda’s scrap value?</span></h2></div><a class="text-link" href="/scrap-car-value/">Explore scrap-car value <i class="ph ph-book-open" aria-hidden="true"></i></a></header><div class="value-register">{hondaFactors.map(([icon,title,copy],i)=><details open={i===0}><summary><span class="factor-index">0{i+1}</span><i class:list={['ph',icon]} aria-hidden="true"></i><h3>{title}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div><p class="value-footnote">These details support an individual review. They do not produce a fixed or automatic price.</p></section>
 </div>
 <section class="honda-condition" data-condition-explorer aria-labelledby="condition-title"><div class="honda-shell"><header class="section-heading"><div><p class="eyebrow">03 / Condition guide</p><h2 id="condition-title">What's the condition<br /><span>of your Honda?</span></h2></div><p>Choose a description to see what to share. Use existing knowledge, photographs or workshop findings.</p></header><script type="application/json" data-condition-config set:html={json(hondaConditions)} /><ConditionGraphic /><div class="condition-desk"><div class="condition-tabs" role="tablist" aria-label="Honda condition guidance">{hondaConditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-controls="condition-guidance" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i><span>{item.label}</span><i class="ph ph-caret-right" aria-hidden="true"></i></button>)}</div><div id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0" class="condition-notes"><p class="eyebrow" data-condition-category>{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p><div class="condition-checks"><span>Useful information to share</span><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul></div><a class="text-link" data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div></div><p class="selection-status" data-condition-status role="status" aria-live="polite"></p></div></section>
 <div class="honda-shell"><HondaCollectionNotes />
 <section class="honda-faq" data-manufacturer-faq aria-labelledby="faq-title"><header class="section-heading"><div><p class="eyebrow">Honda scrap-car questions</p><h2 id="faq-title">Model, documents, collection.<br /><span>Your questions answered.</span></h2></div><div class="faq-search" data-faq-search hidden><label for="honda-faq-search">Search Honda questions<input id="honda-faq-search" data-faq-input type="search" maxlength="120" placeholder="Try Civic, documents or access" aria-describedby="honda-faq-count" /></label><button type="button" data-faq-clear hidden aria-label="Clear question search"><i class="ph ph-x" aria-hidden="true"></i></button></div></header><p class="faq-count" data-faq-count id="honda-faq-count" role="status" aria-live="polite">{hondaFaqs.length} questions</p><div class="faq-list">{hondaFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><p class="faq-empty" data-faq-empty hidden>No matching questions. <a href="/contact-us/">Ask about your Honda</a>.</p></section>
 <section class="honda-final" aria-labelledby="final-title"><div><p class="eyebrow">Your Honda enquiry</p><h2 id="final-title">Ready to value<br /><span>the Honda you have?</span></h2><p>Share the model, year and contact details to request a free valuation.</p></div><SectionActionButton href="#honda-quote" label="Get my Honda valuation" intent="valuation" /><p class="independent">Independent service. No Honda affiliation, authorisation or endorsement is implied.</p></section></div>
 <ManufacturerInteractions />
 </main>
</BaseLayout>
<style>
.honda-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.honda-breadcrumb{display:flex;align-items:center;gap:10px;font-size:11px;color:#6b7866;padding:21px 0 27px}.honda-breadcrumb a{color:inherit;text-decoration:none}.honda-breadcrumb a:hover{text-decoration:underline}.honda-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-areas:'heading photo' 'form form' 'points points';gap:24px 38px;padding-bottom:35px;align-items:center}.honda-hero header{grid-area:heading}.honda-hero h1{font-size:clamp(36px,4.1vw,57px);line-height:1.05;letter-spacing:-.055em;font-weight:600}.honda-hero h1 span{display:block}.honda-hero h1 span:last-child{color:var(--smc-green)}.hero-intro{font-size:14px;line-height:1.8;max-width:420px;margin-top:20px!important;color:#64715e}.hero-rule{display:block;width:55px;height:2px;background:#6d8760;margin-top:24px}.honda-hero-photo{grid-area:photo;border-radius:4px 36px 4px 4px;overflow:hidden;aspect-ratio:3/2;background:#e8e9e2}.honda-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.honda-quote{grid-area:form;scroll-margin-top:25px;min-width:0}.honda-quote :global(.quote-card--free-quote){display:grid;grid-template-columns:230px minmax(0,1fr);gap:30px;padding:25px;border-radius:14px;border:1px solid #d7dfd1;box-shadow:0 12px 35px #253c2210}.honda-quote :global(.quote-head){align-self:center}.honda-quote :global(.quote-head h2){font-size:25px;line-height:1.15;letter-spacing:-.04em}.honda-quote :global(.quote-head p){font-size:12px;line-height:1.7}.honda-quote :global(.quote-kicker){font-size:9px}.honda-quote :global(.quote-card--free-quote form){grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 15px;margin-top:0;align-items:end}.honda-quote :global(.quote-card--free-quote .field-grid){grid-column:1/-1;grid-template-columns:1.25fr 1.1fr .65fr 1fr;gap:12px 10px}.honda-quote :global(.model-availability){order:5;margin:0;font-size:10px}.honda-quote :global(.quote-card--free-quote input),.honda-quote :global(.quote-card--free-quote select){height:49px;font-size:13px;padding-left:32px;padding-right:24px;border-radius:8px}.honda-quote :global(.with-icon i){left:10px;font-size:17px}.honda-quote :global(.field-label){font-size:11px}.honda-quote :global(.submit){height:49px;min-height:49px;font-size:12px;margin:0;justify-content:space-between;padding-left:18px}.honda-quote :global(.submit i){width:30px;height:30px}.honda-quote :global(.data-error),.honda-quote :global(.submit-message){grid-column:1/-1}.honda-assurances{grid-area:points;list-style:none;display:flex;justify-content:center;gap:45px;margin:0;padding:0;font-size:11px;color:#5d7354;line-height:1.5}.honda-assurances li{display:flex;gap:8px;align-items:center}.honda-assurances i{font-size:19px}@media(max-width:1100px){.honda-hero{gap:25px}.honda-hero h1{font-size:43px}.honda-quote :global(.quote-card--free-quote){grid-template-columns:190px minmax(0,1fr);gap:22px;padding:21px}.honda-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr}}@media(max-width:900px){.honda-hero{grid-template-columns:1fr;grid-template-areas:'heading' 'form' 'photo' 'points'}.honda-hero-photo{width:100%;max-width:680px;justify-self:center}.honda-quote :global(.quote-card--free-quote){display:block}.honda-quote :global(.quote-card--free-quote form){margin-top:20px}.honda-assurances{justify-content:start;gap:25px}}@media(max-width:760px){.honda-shell{width:calc(100% - 36px)}.honda-breadcrumb{font-size:10px;padding:16px 0 22px}.honda-hero{gap:20px;padding-bottom:30px}.honda-hero h1{font-size:clamp(29px,6.7vw,44px);line-height:1.07;letter-spacing:-.055em}.hero-intro{font-size:13px;line-height:1.75;margin-top:16px!important}.hero-rule{display:none}.honda-hero-photo{border-radius:4px 25px 4px 4px}.honda-quote :global(.quote-card--free-quote){padding:18px;border-radius:14px}.honda-quote :global(.quote-head h2){font-size:22px}.honda-quote :global(.quote-head p){font-size:11px}.honda-quote :global(.quote-card--free-quote form){grid-template-columns:1fr;gap:12px;margin-top:15px}.honda-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr;gap:11px 9px}.honda-quote :global(.form-field[data-field="make"]),.honda-quote :global(.form-field[data-field="model"]){grid-column:1/-1}.honda-quote :global(.model-availability){order:0}.honda-quote :global(.quote-card--free-quote input),.honda-quote :global(.quote-card--free-quote select){font-size:16px;height:49px;padding-left:33px;padding-right:24px}.honda-quote :global(.submit){min-height:50px;margin-top:2px}.honda-assurances{display:grid;gap:9px;font-size:11px}}
.honda-page{background:#f8faf5;color:#24392b}.honda-page :is(h1,h2,h3,p,figure){margin:0}.honda-page :is(header,figure,section){min-width:0}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#2f6f2d;font-weight:750;margin-bottom:16px!important}.honda-page h2{font-size:clamp(30px,3.3vw,43px);line-height:1.12;letter-spacing:-.045em;font-weight:650}.honda-page h2 span{color:var(--smc-green)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:35px;margin-bottom:26px}.section-heading>p{max-width:335px;font-size:13px;line-height:1.85;color:#5c715e}.honda-models{padding:35px 0 32px;border-bottom:1px solid #d7e2d0}.honda-model-controls{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:18px}.model-tabs{display:flex;flex-wrap:wrap;gap:7px}.model-tabs button{display:flex;gap:14px;align-items:center;justify-content:space-between;padding:11px 15px;min-height:46px;border:1px solid #cbdcc4;border-radius:8px;background:#fff;color:#345c37;font:inherit;font-size:12px;font-weight:650;cursor:pointer}.model-tabs i{font-size:19px}.honda-model-controls label{display:grid;gap:7px;font-size:10px;font-weight:700;color:#4e6b50;min-width:185px}.honda-model-controls select{min-height:46px;width:100%;padding:9px 12px;border:1px solid #cbdcc4;border-radius:8px;color:#2f4d32;background:#fff;font:inherit;font-size:13px}.honda-model-detail{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.7fr);border:1px solid #cbdcc4;border-radius:17px;overflow:hidden;background:#fff}.selected-model{padding:28px;background:#244b32;color:#fff;display:flex;flex-direction:column;align-items:start;justify-content:space-between;min-width:0}.selected-model>span{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#bce7a7}.selected-model strong{font-size:clamp(35px,4vw,55px);line-height:1.05;letter-spacing:-.045em;font-weight:600;margin-top:17px;overflow-wrap:anywhere}.selected-model svg{width:100%;max-width:240px;stroke:#bce7a7;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;margin:25px 0 17px;opacity:.9}.model-ground{stroke:#5f8560}.selected-model small{font-size:11px;color:#c4d8bd;line-height:1.8}.model-notes{padding:30px;min-height:340px}.model-notes h3{font-size:26px;font-weight:600;line-height:1.25;letter-spacing:-.03em}.model-notes>p:not(.eyebrow){font-size:13px;line-height:1.85;color:#576e59;margin-top:15px}.model-notes ul{list-style:none;padding:0;margin:20px 0;display:flex;gap:18px;border-top:1px solid #dfe9d8;padding-top:18px}.model-notes :global(li){display:flex;gap:7px;font-size:11px;line-height:1.7;color:#456548;flex:1}.model-notes :global(li i){font-size:18px;flex-shrink:0;color:#2f6f2d}.model-notes :global(.section-action){min-height:45px;font-size:12px;box-shadow:none}.selection-status{font-size:10px;line-height:1.7;min-height:18px;color:#517053;margin-top:12px!important}.honda-value{padding:32px 0 38px}.text-link{display:inline-flex;align-items:center;gap:12px;color:#2f6f2d;min-height:44px;font-size:12px;font-weight:700;text-underline-offset:4px}.text-link i{font-size:19px}.value-register{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.value-register details{border-top:2px solid #c9dcc1;padding-top:15px}.value-register details[open]{border-color:#2f6f2d}.value-register summary{display:grid;grid-template-columns:1fr auto;align-items:center;gap:12px;list-style:none;cursor:pointer;min-height:90px}.value-register summary::-webkit-details-marker{display:none}.factor-index{font-size:11px;color:#558056;grid-row:1;grid-column:1}.value-register summary>i:first-of-type{font-size:28px;color:#2f6f2d;grid-column:2;grid-row:1}.value-register h3{font-size:17px;line-height:1.4;font-weight:650;letter-spacing:-.02em}.value-register summary>i:last-child{font-size:17px;color:#2f6f2d}.value-register details[open] summary>i:last-child{transform:rotate(45deg)}.value-register details>p{font-size:12px;line-height:1.8;color:#536b55;padding-top:14px}.v