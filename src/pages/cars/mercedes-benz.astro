---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels,modelLabel,resolveModelGuidance} from '../../lib/manufacturer-models';
import {mercedesPreferred,mercedesProfiles,mercedesConditions,mercedesFactors,mercedesFaqs} from '../../lib/mercedes-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const models=manufacturerModels(vehicleData.models,'MERCEDES-BENZ').map(item=>item.model);
const choices=mercedesPreferred.filter(model=>models.includes(model));
const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,mercedesProfiles);
const condition=mercedesConditions[0];
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['Mercedes-Benz','/cars/mercedes-benz/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:mercedesFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\\u003c');
---
<BaseLayout title="Scrap Mercedes-Benz Car in UAE | Free Valuation" description="Request a free Mercedes-Benz scrap-car valuation in the UAE. Share your model, year, known condition and recovery access for an individual vehicle review." canonical="/cars/mercedes-benz/" ogImage="/sections/mercedes-sedan-valuation.webp">
 <Fragment slot="head"><script type="application/ld+json" set:html={json(breadcrumb)} /><script type="application/ld+json" set:html={json(faqSchema)} /></Fragment>
 <main class="mercedes-page" data-manufacturer-page>
 <div class="mb-shell"><nav class="mb-breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
 <section class="mb-hero" aria-labelledby="mb-title"><header><p class="eyebrow">Mercedes-Benz / UAE scrap valuation</p><h1 id="mb-title"><span>Scrap Your Mercedes-Benz</span> <span>Car in the UAE</span></h1><p class="hero-intro">A considered next step for your damaged, non-running or unwanted Mercedes-Benz. Start with a free valuation request.</p><span class="hero-rule" aria-hidden="true"></span></header>
 <figure class="mb-hero-photo"><img src="/sections/mercedes-sedan-valuation.webp" srcset="/sections/mercedes-sedan-valuation-640.webp 640w, /sections/mercedes-sedan-valuation-960.webp 960w, /sections/mercedes-sedan-valuation.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 43vw, 510px" width="1440" height="960" fetchpriority="high" alt="Champagne-silver E-Class-style Mercedes-Benz sedan with modest bumper wear at a quiet UAE inspection forecourt" /></figure>
 <div class="mb-quote" id="mercedes-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
 <ul class="mb-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running cars</li><li><i class="ph ph-key" aria-hidden="true"></i>Individual recovery review</li></ul></section></div>
 <section class="mb-model-studio" id="mercedes-models" data-model-explorer aria-labelledby="model-title"><div class="mb-shell"><header><div><p class="eyebrow">01 / Model perspective</p><h2 id="model-title">Start with the model.<br /><em>Then look closer.</em></h2></div><p>Mercedes-Benz guidance only. Choose a catalogue model to add it to your valuation form; the form also accepts other makes.</p></header>
 {models.length?<><script type="application/json" data-model-config set:html={json({make:'MERCEDES-BENZ',models,profiles:mercedesProfiles,initial})} /><div class="model-toolbar"><div class="model-tabs" role="tablist" aria-label="Mercedes-Benz model guidance">{choices.map((model,i)=><button type="button" role="tab" id={'model-tab-'+i} data-model-choice={model} aria-controls="model-guidance" aria-selected={model===initial?'true':'false'} tabindex={model===initial?0:-1}>{modelLabel(model)}</button>)}</div><label for="manufacturer-all-models">All {models.length} Mercedes-Benz models<select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{modelLabel(model)}</option>)}</select></label></div>
 <div class="model-result" id="model-guidance" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="model-title-row"><div><span data-model-category>{guidance.category}</span><h3 data-model-heading>{guidance.title}</h3></div><span class="model-name" data-model-name>{modelLabel(initial)}</span></div><p data-model-copy>{guidance.copy}</p><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><SectionActionButton href="#mercedes-quote" label={'Value my '+modelLabel(initial)} intent="valuation" /></div><p data-model-status role="status" aria-live="polite" class="selection-status"></p></>:<p class="unavailable">Catalogue options are temporarily unavailable. <a href="/contact-us/">Contact us about your vehicle</a>.</p>}
 </div></section>
 <div class="mb-shell"><section class="mb-factors" aria-labelledby="value-title"><header><p class="eyebrow">02 / The valuation lens</p><h2 id="value-title">Value comes from<br /><em>the individual vehicle.</em></h2><a href="/scrap-car-value/">Understand scrap-car value <i class="ph ph-book-open" aria-hidden="true"></i></a></header><div class="factor-list">{mercedesFactors.map(([category,title,copy],i)=><article><span class="factor-index">0{i+1}</span><div><p class="factor-category">{category}</p><h3>{title}</h3><p>{copy}</p></div></article>)}</div></section>
 <section class="mb-condition" data-condition-explorer aria-labelledby="condition-title"><header><p class="eyebrow">03 / Condition, without assumptions</p><h2 id="condition-title">What should we know<br />about your Mercedes-Benz?</h2><p>Choose the closest description for useful information to share. No automatic prices or model-specific fault assumptions.</p></header><div class="condition-composition"><figure data-manufacturer-reveal><img src="/sections/mercedes-suv-assessment.webp" srcset="/sections/mercedes-suv-assessment-640.webp 640w, /sections/mercedes-suv-assessment-960.webp 960w, /sections/mercedes-suv-assessment.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 48vw, 560px" width="1440" height="960" loading="lazy" decoding="async" alt="Burgundy GLE-style Mercedes-Benz SUV with light door wear being visually assessed outside an independent UAE workshop" /></figure><div class="condition-workspace"><script type="application/json" data-condition-config set:html={json(mercedesConditions)} /><div class="condition-tabs" role="tablist" aria-label="Mercedes-Benz condition guidance">{mercedesConditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-controls="condition-guidance" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i>{item.label}</button>)}</div><div id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0" class="condition-result"><p data-condition-category class="eyebrow">{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul><a data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div><p data-condition-status role="status" aria-live="polite" class="selection-status"></p></div></div></section>
 <section class="mb-handover" aria-labelledby="handover-title"><div><p class="eyebrow">04 / From enquiry to handover</p><h2 id="handover-title">A clear conversation.<br /><em>A practical next step.</em></h2><p>Start with the form. Discuss known condition and the collection location, then clarify any assessment, recovery and document requirements.</p><SectionActionButton href="#mercedes-quote" label="Request my free valuation" intent="valuation" /></div><div class="recovery-notes"><details open><summary><i class="ph ph-tire" aria-hidden="true"></i><h3>Movement &amp; keys</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Explain whether the wheels roll and steering turns, if already known. Flag missing keys, flat tyres or locked wheels. Do not test or move a damaged car just to enquire.</p></details><details><summary><i class="ph ph-garage" aria-hidden="true"></i><h3>Access &amp; permissions</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Share basement clearances, entrance width, obstructions, gates and site permission requirements. The exact parking position matters alongside the emirate. Explore <a href="/car-removal/">vehicle recovery information</a> and <a href="/locations/">UAE location coverage</a>.</p></details><details><summary><i class="ph ph-identification-card" aria-hidden="true"></i><h3>Documents &amp; authorised release</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Explain which ownership and registration documents are available and who may authorise handover. Required paperwork and relevant transfer or deregistration steps need confirmation before arrangements are agreed.</p></details></div></section>
 <section class="mb-faq" data-manufacturer-faq aria-labelledby="faq-title"><header><p class="eyebrow">Before you decide</p><h2 id="faq-title">Mercedes-Benz scrap<br /><em>valuation, explained.</em></h2><p>Practical answers about your vehicle and the next step.</p></header><div class="faq-list">{mercedesFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></section>
 <section class="mb-final" aria-labelledby="final-title"><div><p class="eyebrow">An individual review starts here</p><h2 id="final-title">Your Mercedes-Benz.<br />Your next step.</h2><p>Share accurate vehicle details to request a free valuation.</p></div><SectionActionButton href="#mercedes-quote" label="Start my valuation" intent="valuation" /><p class="independent">Independent service. No Mercedes-Benz affiliation, authorisation or endorsement is implied.</p></section></div>
 <ManufacturerInteractions />
 </main>
</BaseLayout>
<style>
.mercedes-page{background:#f7f7f2;color:#24342b}.mb-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.mercedes-page :is(h1,h2,h3,p,figure){margin:0}.mercedes-page :is(header,figure,article){min-width:0}.mercedes-page h2{font-size:clamp(32px,3.6vw,47px);line-height:1.1;letter-spacing:-.05em;font-weight:600}.mercedes-page h2 em{font-style:normal;color:#74806d}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:10px;font-weight:750;color:#63765b;margin-bottom:17px!important}.mb-breadcrumb{display:flex;align-items:center;gap:10px;font-size:11px;color:#6b7866;padding:21px 0 27px}.mb-breadcrumb a{color:inherit;text-decoration:none}.mb-breadcrumb a:hover{text-decoration:underline}.mb-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-areas:'heading photo' 'form form' 'points points';gap:24px 38px;padding-bottom:35px;align-items:center}.mb-hero header{grid-area:heading}.mb-hero h1{font-size:clamp(36px,4.1vw,57px);line-height:1.05;letter-spacing:-.055em;font-weight:600}.mb-hero h1 span{display:block}.mb-hero h1 span:last-child{color:#78866f}.hero-intro{font-size:14px;line-height:1.8;max-width:420px;margin-top:20px!important;color:#64715e}.hero-rule{display:block;width:55px;height:2px;background:#6d8760;margin-top:24px}.mb-hero-photo{grid-area:photo;border-radius:4px 36px 4px 4px;overflow:hidden;aspect-ratio:3/2;background:#e8e9e2}.mb-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.mb-quote{grid-area:form;scroll-margin-top:25px;min-width:0}.mb-quote :global(.quote-card--free-quote){display:grid;grid-template-columns:230px minmax(0,1fr);gap:30px;padding:25px;border-radius:14px;border:1px solid #d7dfd1;box-shadow:0 12px 35px #253c2210}.mb-quote :global(.quote-head){align-self:center}.mb-quote :global(.quote-head h2){font-size:25px;line-height:1.15;letter-spacing:-.04em}.mb-quote :global(.quote-head p){font-size:12px;line-height:1.7}.mb-quote :global(.quote-kicker){font-size:9px}.mb-quote :global(.quote-card--free-quote form){grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 15px;margin-top:0;align-items:end}.mb-quote :global(.quote-card--free-quote .field-grid){grid-column:1/-1;grid-template-columns:1.25fr 1.1fr .65fr 1fr;gap:12px 10px}.mb-quote :global(.model-availability){order:5;margin:0;font-size:10px}.mb-quote :global(.quote-card--free-quote input),.mb-quote :global(.quote-card--free-quote select){height:49px;font-size:13px;padding-left:32px;padding-right:24px;border-radius:8px}.mb-quote :global(.with-icon i){left:10px;font-size:17px}.mb-quote :global(.field-label){font-size:11px}.mb-quote :global(.submit){height:49px;min-height:49px;font-size:12px;margin:0;justify-content:space-between;padding-left:18px}.mb-quote :global(.submit i){width:30px;height:30px}.mb-quote :global(.data-error),.mb-quote :global(.submit-message){grid-column:1/-1}.mb-assurances{grid-area:points;list-style:none;display:flex;justify-content:center;gap:45px;margin:0;padding:0;font-size:11px;color:#5d7354;line-height:1.5}.mb-assurances li{display:flex;gap:8px;align-items:center}.mb-assurances i{font-size:19px}.mb-model-studio{background:#20382f;color:#f3f4ec;padding:40px 0 30px}.mb-model-studio header{display:flex;align-items:end;justify-content:space-between;gap:45px}.mb-model-studio .eyebrow{color:#afc5a5}.mb-model-studio h2 em{color:#b5c7aa}.mb-model-studio header>p{max-width:340px;font-size:13px;line-height:1.85;color:#b7c9b0}.model-toolbar{display:flex;justify-content:space-between;gap:25px;align-items:end;margin:28px 0 26px;padding-bottom:25px;border-bottom:1px solid #526955}.model-tabs{display:flex;flex-wrap:wrap;gap:6px}.model-tabs button{background:transparent;border:1px solid #6b806a;color:#d6e2cc;border-radius:999px;min-height:45px;padding:9px 15px;font:inherit;font-size:12px;cursor:pointer;transition:background .2s,color .2s}.model-tabs button[aria-selected=true]{background:#e4edda;border-color:#e4edda;color:#253f29}.model-tabs button:hover{border-color:#d5e4c9}.model-toolbar label{display:grid;gap:8px;font-size:10px;color:#c1d2b9;min-width:225px}.model-toolbar select{width:100%;min-height:45px;padding:10px 12px;background:#2c493a;border:1px solid #71866a;border-radius:8px;color:#edf1e6;font:inherit;font-size:14px}.model-result{min-height:270px}.model-title-row{display:flex;justify-content:space-between;align-items:center;gap:40px}.model-title-row [data-model-category]{display:block;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#adbf9f;margin-bottom:10px}.model-title-row h3{font-size:27px;font-weight:550;line-height:1.3;letter-spacing:-.03em}.model-name{font-size:49px;line-height:1.15;letter-spacing:-.04em;color:#c6d7b8;font-weight:550;flex-shrink:0;max-width:40%;overflow-wrap:anywhere}.model-result>p{max-width:760px;font-size:13px;line-height:1.9;color:#c4d0bc;margin-top:20px}.model-result ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding:20px 0;margin:20px 0 0;list-style:none;border-top:1px solid #4c6450;color:#d4dfca;font-size:12px;line-height:1.8}.model-result :global(li){display:flex;gap:9px}.model-result :global(li i){font-size:17px;flex-shrink:0}.model-result :global(.section-action){background:#e6eedc;color:#2b492c;font-size:12px;box-shadow:none;min-height:47px}.selection-status{font-size:10px;line-height:1.7;min-height:20px;color:#bccdb1;margin-top:15px!important}.unavailable a{color:inherit}.mb-factors{display:grid;grid-template-columns:1fr 1.5fr;gap:60px;padding:50px 0;border-bottom:1px solid #d8dfd2}.mb-factors header>a{display:inline-flex;align-items:center;gap:14px;min-height:45px;margin-top:20px;color:#426339;font-size:12px;text-underline-offset:4px}.factor-list{display:grid;grid-template-columns:1fr 1fr;gap:28px 30px}.factor-list article{display:flex;gap:15px;padding-top:16px;border-top:1px solid #c9d5c0}.factor-index{font-size:11px;color:#72876a;padding-top:3px}.factor-category{text-transform:uppercase;letter-spacing:.1em;font-size:9px;color:#71816a;margin-bottom:11px!important}.factor-list h3{font-size:18px;line-height:1.35;font-weight:600;letter-spacing:-.025em}.factor-list article p:last-child{font-size:12px;line-height:1.8;color:#65745c;margin-top:12px}.mb-condition{padding:45px 0}.mb-condition header{display:grid;grid-template-columns:1.3fr 1fr;gap:0 50px;margin-bottom:28px;align-items:end}.mb-condition header .eyebrow{grid-column:1/-1}.mb-condition header>p:last-child{font-size:13px;line-height:1.8;color:#67765e;max-width:360px;justify-self:end}.condition-composition{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:35px;align-items:start}.condition-composition figure{border-radius:4px 4px 30px 4px;overflow:hidden;aspect-ratio:3/2;margin-top:0}.condition-composition img{width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;display:block;transition:filter .3s}.condition-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.condition-tabs button{display:flex;align-items:center;gap:7px;min-height:45px;font:inherit;font-size:11px;text-align:left;border:1px solid #cbd7c2;border-radius:8px;background:#edf2e6;color:#4c6741;padding:8px;cursor:pointer;transition:background .2s,border-color .2s}.condition-tabs button[aria-selected=true]{background:#dbe6d0;border-color:#718d61;color:#244322}.condition-tabs i{font-size:20px;flex-shrink:0}.condition-result{padding-top:23px;min-height:325px}.condition-result .eyebrow{font-size:9px;margin-bottom:12px!important}.condition-result h3{font-size:24px;font-weight:550;line-height:1.2;letter-spacing:-.03em}.condition-result>p:not(.eyebrow){font-size:13px;line-height:1.85;color:#66775d;margin-top:14px}.condition-result ul{display:grid;gap:7px;padding-left:17px;margin:15px 0 5px;font-size:12px;line-height:1.8;color:#5a704f}.condition-result a{display:inline-flex;align-items:center;gap:15px;min-height:44px;color:#416334;font-size:12px;font-weight:650;text-underline-offset:4px}.condition-workspace .selection-status{color:#6c7f60}.mb-handover{display:grid;grid-template-columns:1fr 1fr;gap:55px;background:#e9eee1;border-radius:16px;padding:30px;margin:0 0 45px}.mb-handover>div>p:not(.eyebrow){font-size:13px;line-height:1.85;color:#617157;margin-top:20px}.mb-handover :global(.section-action){font-size:12px;margin-top:22px;box-shadow:none}.recovery-notes details{border-top:1px solid #c3d1b7}.recovery-notes summary{display:flex;align-items:center;gap:12px;list-style:none;min-height:65px;cursor:pointer}.recovery-notes h3{font-size:16px;font-weight:600;line-height:1.5;flex:1}.recovery-notes summary>i:first-child{font-size:23px;color:#6f885e}.recovery-notes summary>i:last-child{font-size:18px}.recovery-notes details>p{padding:0 0 20px 35px;font-size:12px;line-height:1.9;color:#617455}.recovery-notes a{color:#345c2d;text-underline-offset:4px}.mb-faq{display:grid;grid-template-columns:1fr 1.6fr;gap:65px;padding-bottom:45px}.mb-faq header>p:last-child{font-size:13px;line-height:1.8;color:#697b60;margin-top:20px;max-width:280px}.faq-list details{border-top:1px solid #d3dec9}.faq-list summary{display:flex;gap:20px;align-items:center;min-height:73px;padding:17px 0;cursor:pointer;list-style:none}.faq-list h3{font-size:13px;line-height:1.7;font-weight:650;flex:1}.faq-list summary i{font-size:18px;flex-shrink:0}.faq-list details>p{font-size:12px;line-height:1.9;color:#63775a;padding:0 25px 22px 0}.mercedes-page summary::-webkit-details-marker{display:none}.mercedes-page details[open] summary>i:last-child{transform:rotate(45deg)}.mb-final{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:28px 0;margin-bottom:30px;border-top:1px solid #c6d3bd;border-bottom:1px solid #c6d3bd}.mb-final>div>p:last-child{font-size:13px;line-height:1.8;color:#67795e;margin-top:15px}.mb-final :global(.section-action){font-size:12px;box-shadow:none}.independent{grid-column:1/-1;font-size:11px;line-height:1.8;color:#74846b}.mercedes-page :is(a,button,select,input,summary,[tabindex]):focus-visible{outline:3px solid #558bbf;outline-offset:4px}.panel-changed{animation:mb-panel .2s ease}@keyframes mb-panel{from{opacity:.6;transform:translateY(3px)}to{opacity:1;transform:none}}.mercedes-page :global(.reveal-ready){opacity:0;transform:translateY(10px);transition:opacity .4s,transform .4s}.mercedes-page :global(.is-revealed){opacity:1;transform:none}
@media(hover:hover){.condition-composition figure:hover img{filter:brightness(1.04)}}
