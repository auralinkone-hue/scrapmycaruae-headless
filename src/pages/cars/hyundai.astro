---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import ConditionGraphic from '../../components/manufacturer/ConditionGraphic.astro';
import '../../components/manufacturer/manufacturer-body.css';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels,modelLabel,resolveModelGuidance} from '../../lib/manufacturer-models';
import {hyundaiPreferred,hyundaiProfiles,hyundaiConditions,hyundaiFactors,hyundaiFaqs} from '../../lib/hyundai-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const models=manufacturerModels(vehicleData.models,'HYUNDAI').map(item=>item.model);
const choices=hyundaiPreferred.filter(model=>models.includes(model));const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,hyundaiProfiles);const condition=hyundaiConditions[0];
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['Car makes','/cars/'],['Hyundai','/cars/hyundai/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:hyundaiFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\u003c');
---
<BaseLayout title="Scrap Hyundai Car in UAE | Free Valuation | Scrap My Car UAE" description="Scrap your Hyundai car in the UAE. Request a free valuation for a damaged, non-running, old or unwanted Elantra, Sonata, Tucson, Santa Fe or other Hyundai." canonical="/cars/hyundai/" ogImage="/sections/hyundai-elantra-valuation.webp"><Fragment slot="head"><script type="application/ld+json" set:html={json(breadcrumb)} /><script type="application/ld+json" set:html={json(faqSchema)} /></Fragment><main class="hyundai-page" data-manufacturer-page><div class="hyundai-shell"><nav class="hyundai-breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
 <section class="hyundai-hero" aria-labelledby="hyundai-title"><header><p class="eyebrow">Hyundai / UAE scrap valuation</p><h1 id="hyundai-title"><span>Scrap Your Hyundai</span> <span>Car in the UAE</span></h1><p class="hero-intro">Request a free scrap valuation for a damaged, non-running, old or unwanted Hyundai. Share your model, year and the condition you know.</p><span class="hero-rule" aria-hidden="true"></span></header>
 <figure class="hyundai-hero-photo"><img src="/sections/hyundai-elantra-valuation.webp" srcset="/sections/hyundai-elantra-valuation-640.webp 640w, /sections/hyundai-elantra-valuation-960.webp 960w, /sections/hyundai-elantra-valuation.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 43vw, 510px" width="1440" height="960" fetchpriority="high" alt="Used early-2010s Elantra-style Hyundai sedan with front bumper scuffs and a shallow door dent at a UAE assessment forecourt" /></figure>
 <div class="hyundai-quote" id="hyundai-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
 <ul class="hyundai-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running cars</li><li><i class="ph ph-key" aria-hidden="true"></i>Individual recovery review</li></ul></section>


<section class="hyundai-models" data-model-explorer aria-labelledby="model-title"><div class="model-intro"><p class="eyebrow">01 / Your Hyundai model</p><h2 id="model-title">Find your car.<br /><span>Start with its details.</span></h2><p>Hyundai model guidance from the live catalogue. Choose a model here to add it to your valuation form.</p>{models.length>0&&<label for="manufacturer-all-models">All {models.length} Hyundai models<select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{modelLabel(model)}</option>)}</select></label>}</div>
{models.length?<div class="model-content"><script type="application/json" data-model-config set:html={json({make:'HYUNDAI',models,profiles:hyundaiProfiles,initial})} /><div class="model-tabs" role="tablist" aria-label="Hyundai model guidance">{choices.map((model,i)=><button type="button" role="tab" id={'model-tab-'+i} data-model-choice={model} aria-controls="model-guidance" aria-selected={model===initial?'true':'false'} tabindex={model===initial?0:-1}>{modelLabel(model)}</button>)}</div><div class="model-result" id="model-guidance" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="model-stamp"><p class="eyebrow" data-model-category>{guidance.category}</p><strong data-model-name>{modelLabel(initial)}</strong><i class="ph ph-car-profile" aria-hidden="true"></i></div><h3 data-model-heading>{guidance.title}</h3><p data-model-copy>{guidance.copy}</p><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><SectionActionButton href="#hyundai-quote" label={'Value my '+modelLabel(initial)} intent="valuation" /></div><p class="selection-status" data-model-status role="status" aria-live="polite"></p></div>:<p>Catalogue options are temporarily unavailable. <a href="/contact-us/">Ask about your Hyundai</a>.</p>}</section>
<section class="hyundai-condition" data-condition-explorer aria-labelledby="condition-title"><header class="section-heading"><div><p class="eyebrow">02 / Describe the car as it stands</p><h2 id="condition-title">Which condition<br /><span>best fits your Hyundai?</span></h2></div><p>Explore what to share for an individual review. These selections provide guidance and do not calculate a price.</p></header><script type="application/json" data-condition-config set:html={json(hyundaiConditions)} /><div class="condition-bench"><div class="condition-visual"><div class="visual-topline"><span><i class="ph ph-magnifying-glass" aria-hidden="true"></i> Vehicle condition guide</span><span>6 views</span></div><ConditionGraphic /><div class="condition-tabs" role="tablist" aria-label="Hyundai condition guidance">{hyundaiConditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-controls="condition-guidance" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i>{item.label}</button>)}</div></div><div class="condition-notes" id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0"><p class="eyebrow" data-condition-category>{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul><a class="text-link" data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div></div><p class="selection-status" data-condition-status role="status" aria-live="polite"></p></section>
<section class="hyundai-value" aria-labelledby="value-title"><header class="section-heading"><div><p class="eyebrow">03 / The valuation essentials</p><h2 id="value-title">Four details.<br /><span>A better-informed review.</span></h2></div><a class="text-link" href="/scrap-car-value/">Understand scrap-car value <i class="ph ph-book-open" aria-hidden="true"></i></a></header><div class="value-columns">{hyundaiFactors.map(([icon,title,copy],i)=><details open={i===0}><summary><span class="factor-icon"><i class:list={['ph',icon]} aria-hidden="true"></i></span><span class="factor-number">0{i+1}</span><h3>{title}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></section>
</div>
<section class="hyundai-collection" aria-labelledby="collection-title"><div class="hyundai-shell"><header class="section-heading"><div><p class="eyebrow">04 / Collection preparation</p><h2 id="collection-title">From parked car<br /><span>to a planned collection.</span></h2></div><p>Before arrangements are agreed, explain the location, movement restrictions and who can authorise handover.</p></header><div class="collection-scene"><figure data-manufacturer-reveal><img src="/sections/hyundai-tucson-assessment.webp" srcset="/sections/hyundai-tucson-assessment-640.webp 640w, /sections/hyundai-tucson-assessment-960.webp 960w, /sections/hyundai-tucson-assessment.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), 700px" width="1440" height="960" loading="lazy" decoding="async" alt="Used early-2010s Tucson-style Hyundai SUV with light rear bumper scuffing, lower-panel scratches and a shallow door dent" /><figcaption>Existing condition and parking details help clarify recovery requirements for your Hyundai.</figcaption></figure><aside class="collection-label"><i class="ph ph-truck" aria-hidden="true"></i><p class="eyebrow">The practical details</p><h3>Tell us what<br />access looks like.</h3><p>A Tucson in a basement and an H1 in a yard need different access information.</p><SectionActionButton href="/car-removal/" label="Read collection guidance" intent="process" icon="ph-truck" /></aside></div><div class="collection-notes"><details open><summary><span>01</span><h3>Parking &amp; clearance</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Share the exact location, entrance height, gates and surrounding space. Explain access permissions and check our <a href="/locations/">UAE locations</a>.</p></details><details><summary><span>02</span><h3>Keys &amp; mobility</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Mention missing keys, tyre condition and any rolling or steering restrictions already known. For an H1, explain any contents still inside. Do not test a damaged car simply to enquire.</p></details><details><summary><span>03</span><h3>Documents &amp; release</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Share available ownership and registration information and who may release the vehicle. Confirm required paperwork and relevant transfer or deregistration steps before handover.</p></details></div></div></section>
<div class="hyundai-shell"><section class="hyundai-faq" data-manufacturer-faq aria-labelledby="faq-title"><header><p class="eyebrow">Hyundai scrap-car questions</p><h2 id="faq-title">Before you<br /><span>request a valuation.</span></h2><p>Practical answers for your Hyundai enquiry.</p><div class="faq-search" data-faq-search hidden><label for="hyundai-faq-search">Find an answer</label><div><input id="hyundai-faq-search" type="search" placeholder="Try collection or documents" data-faq-input /><button type="button" data-faq-clear hidden>Clear</button></div><span data-faq-count role="status">{hyundaiFaqs.length} questions</span></div><a class="text-link" href="/contact-us/">Ask about your vehicle <i class="ph ph-chats-circle" aria-hidden="true"></i></a></header><div class="faq-list">{hyundaiFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}<p data-faq-empty hidden>No matching questions. Try another word or contact us about your Hyundai.</p></div></section>
<section class="hyundai-final" aria-labelledby="final-title"><div><p class="eyebrow">Your Hyundai, your next step</p><h2 id="final-title">Ready to request<br /><span>your free valuation?</span></h2><p>Start with your model, year and contact details.</p></div><SectionActionButton href="#hyundai-quote" label="Get my Hyundai valuation" intent="valuation" /><p class="independent">Independent service. No Hyundai affiliation, authorisation or endorsement is implied.</p></section></div><ManufacturerInteractions /></main></BaseLayout>
<style>
.hyundai-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.hyundai-breadcrumb{display:flex;align-items:center;gap:10px;font-size:11px;color:#6b7866;padding:21px 0 27px}.hyundai-breadcrumb a{color:inherit;text-decoration:none}.hyundai-breadcrumb a:hover{text-decoration:underline}.hyundai-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-areas:'heading photo' 'form form' 'points points';gap:24px 38px;padding-bottom:35px;align-items:center}.hyundai-hero header{grid-area:heading}.hyundai-hero h1{font-size:clamp(36px,4.1vw,57px);line-height:1.05;letter-spacing:-.055em;font-weight:600}.hyundai-hero h1 span{display:block}.hyundai-hero h1 span:last-child{color:var(--smc-green)}.hero-intro{font-size:14px;line-height:1.8;max-width:420px;margin-top:20px!important;color:#64715e}.hero-rule{display:block;width:55px;height:2px;background:#6d8760;margin-top:24px}.hyundai-hero-photo{grid-area:photo;border-radius:4px 36px 4px 4px;overflow:hidden;aspect-ratio:3/2;background:#e8e9e2}.hyundai-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.hyundai-quote{grid-area:form;scroll-margin-top:25px;min-width:0}.hyundai-quote :global(.quote-card--free-quote){display:grid;grid-template-columns:230px minmax(0,1fr);gap:30px;padding:25px;border-radius:14px;border:1px solid #d7dfd1;box-shadow:0 12px 35px #253c2210}.hyundai-quote :global(.quote-head){align-self:center}.hyundai-quote :global(.quote-head h2){font-size:25px;line-height:1.15;letter-spacing:-.04em}.hyundai-quote :global(.quote-head p){font-size:12px;line-height:1.7}.hyundai-quote :global(.quote-kicker){font-size:9px}.hyundai-quote :global(.quote-card--free-quote form){grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 15px;margin-top:0;align-items:end}.hyundai-quote :global(.quote-card--free-quote .field-grid){grid-column:1/-1;grid-template-columns:1.25fr 1.1fr .65fr 1fr;gap:12px 10px}.hyundai-quote :global(.model-availability){order:5;margin:0;font-size:10px}.hyundai-quote :global(.quote-card--free-quote input),.hyundai-quote :global(.quote-card--free-quote select){height:49px;font-size:13px;padding-left:32px;padding-right:24px;border-radius:8px}.hyundai-quote :global(.with-icon i){left:10px;font-size:17px}.hyundai-quote :global(.field-label){font-size:11px}.hyundai-quote :global(.submit){height:49px;min-height:49px;font-size:12px;margin:0;justify-content:space-between;padding-left:18px}.hyundai-quote :global(.submit i){width:30px;height:30px}.hyundai-quote :global(.data-error),.hyundai-quote :global(.submit-message){grid-column:1/-1}.hyundai-assurances{grid-area:points;list-style:none;display:flex;justify-content:center;gap:45px;margin:0;padding:0;font-size:11px;color:#5d7354;line-height:1.5}.hyundai-assurances li{display:flex;gap:8px;align-items:center}.hyundai-assurances i{font-size:19px}@media(max-width:1100px){.hyundai-hero{gap:25px}.hyundai-hero h1{font-size:43px}.hyundai-quote :global(.quote-card--free-quote){grid-template-columns:190px minmax(0,1fr);gap:22px;padding:21px}.hyundai-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr}}@media(max-width:900px){.hyundai-hero{grid-template-columns:1fr;grid-template-areas:'heading' 'form' 'photo' 'points'}.hyundai-hero-photo{width:100%;max-width:680px;justify-self:center}.hyundai-quote :global(.quote-card--free-quote){display:block}.hyundai-quote :global(.quote-card--free-quote form){margin-top:20px}.hyundai-assurances{justify-content:start;gap:25px}}@media(max-width:760px){.hyundai-shell{width:calc(100% - 36px)}.hyundai-breadcrumb{font-size:10px;padding:16px 0 22px}.hyundai-hero{gap:20px;padding-bottom:30px}.hyundai-hero h1{font-size:clamp(29px,6.7vw,44px);line-height:1.07;letter-spacing:-.055em}.hero-intro{font-size:13px;line-height:1.75;margin-top:16px!important}.hero-rule{display:none}.hyundai-hero-photo{border-radius:4px 25px 4px 4px}.hyundai-quote :global(.quote-card--free-quote){padding:18px;border-radius:14px}.hyundai-quote :global(.quote-head h2){font-size:22px}.hyundai-quote :global(.quote-head p){font-size:11px}.hyundai-quote :global(.quote-card--free-quote form){grid-template-columns:1fr;gap:12px;margin-top:15px}.hyundai-quote :global(.quote-card--free-quote .field-grid){grid-template-columns:1fr 1fr;gap:11px 9px}.hyundai-quote :global(.form-field[data-field="make"]),.hyundai-quote :global(.form-field[data-field="model"]){grid-column:1/-1}.hyundai-quote :global(.model-availability){order:0}.hyundai-quote :global(.quote-card--free-quote input),.hyundai-quote :global(.quote-card--free-quote select){font-size:16px;height:49px;padding-left:33px;padding-right:24px}.hyundai-quote :global(.submit){min-height:50px;margin-top:2px}.hyundai-assurances{display:grid;gap:9px;font-size:11px}}
.hyundai-page{background:#f8f9f4;color:#24362b}.hyundai-page :is(h1,h2,h3,p,figure){margin:0}.hyundai-page :is(section,header,figure,aside){min-width:0}.hyundai-page h2{font-size:clamp(30px,3.3vw,43px);line-height:1.12;font-weight:600;letter-spacing:-.045em}.hyundai-page h2 span{color:var(--smc-green)}.eyebrow{font-size:10px;font-weight:750;text-transform:uppercase;letter-spacing:.12em;color:#2f6f2d;margin-bottom:15px!important}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:25px}.section-heading>p{font-size:13px;line-height:1.85;color:#61725b;max-width:340px}.hyundai-models{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.5fr);gap:45px;padding:32px 0 28px}.model-intro>p:not(.eyebrow){font-size:13px;line-height:1.85;color:#61725b;max-width:300px;margin-top:20px}.model-intro label{display:grid;gap:8px;font-size:11px;font-weight:650;color:#436439;margin-top:24px}.model-intro select{width:100%;min-height:48px;min-width:0;padding:10px 13px;border:1px solid #b9cfaf;border-radius:8px;background:#fff;color:#294b2e;font:inherit;font-size:14px}.model-content{min-width:0}.model-tabs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px;margin-bottom:13px}.model-tabs button{font:inherit;font-size:11px;min-height:46px;padding:10px 7px;border:1px solid #c6d8bb;border-radius:7px;background:#fff;color:#365e30;cursor:pointer}.model-result{padding:25px;background:#fff;border:1px solid #cbdcc1;border-top:4px solid #2f6f2d;min-height:340px}.model-stamp{display:flex;align-items:center;gap:20px;padding-bottom:19px;border-bottom:1px solid #dce6d4;margin-bottom:22px}.model-stamp .eyebrow{margin:0!important;max-width:150px;font-size:9px;line-height:1.8}.model-stamp strong{margin-left:auto;font-size:35px;font-weight:600;line-height:1.2;letter-spacing:-.04em;overflow-wrap:anywhere;color:#2f6f2d}.model-stamp>i{font-size:46px;color:#a0bf8d}.model-result h3,.condition-notes h3{font-size:25px;line-height:1.3;font-weight: