---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import ConditionGraphic from '../../components/manufacturer/ConditionGraphic.astro';
import EnquiryJourney from '../../components/manufacturer/EnquiryJourney.astro';
import '../../components/manufacturer/manufacturer-body.css';
import ManufacturerInteractions from '../../components/manufacturer/ManufacturerInteractions.astro';
import {getVehicleData,type VehicleData} from '../../lib/vehicle-data';
import {manufacturerModels,modelLabel,resolveModelGuidance} from '../../lib/manufacturer-models';
import {bmwPreferred,bmwProfiles,bmwConditions,bmwFactors,bmwFaqs} from '../../lib/bmw-content';
let vehicleData:VehicleData={makes:[],models:[],years:[]};let dataError='';
try{vehicleData=await getVehicleData();}catch(error){dataError=error instanceof Error?error.message:String(error);}
const models=manufacturerModels(vehicleData.models,'BMW').map(item=>item.model);
const choices=bmwPreferred.filter(model=>models.includes(model));const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,bmwProfiles);const condition=bmwConditions[0];
const crumbs=[['Home','/'],['Scrap my car','/scrap-my-car/'],['BMW','/cars/bmw/']];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://www.scrapmycaruae.com'+path}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:bmwFaqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
const json=(value:unknown)=>JSON.stringify(value).replace(/</g,'\\u003c');
---
<BaseLayout title="Scrap BMW Car in UAE | Free Valuation | Scrap My Car UAE" description="Request a free BMW scrap-car valuation in the UAE. Share your model, year, known damage or mechanical condition and collection access for an individual review." canonical="/cars/bmw/" ogImage="/sections/bmw-sedan-valuation.webp">
 <Fragment slot="head"><script type="application/ld+json" set:html={json(breadcrumb)} /><script type="application/ld+json" set:html={json(faqSchema)} /></Fragment>
 <main class="bmw-page" data-manufacturer-page>
 <div class="bmw-shell"><nav class="bmw-breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name,path],i)=><>{i>0&&<span aria-hidden="true">/</span>}{i<crumbs.length-1?<a href={path}>{name}</a>:<span aria-current="page">{name}</span>}</>)}</nav>
 <section class="bmw-hero" aria-labelledby="bmw-title"><header><p class="eyebrow">BMW / UAE scrap valuation</p><h1 id="bmw-title"><span>Scrap Your BMW</span> <span>Car in the UAE</span></h1><p class="hero-intro">Request a free scrap valuation for a damaged, non-running, old or unwanted BMW. Share its details to start an individual review.</p><span class="hero-rule" aria-hidden="true"></span></header>
 <figure class="bmw-hero-photo"><img src="/sections/bmw-sedan-valuation.webp" srcset="/sections/bmw-sedan-valuation-640.webp 640w, /sections/bmw-sedan-valuation-960.webp 960w, /sections/bmw-sedan-valuation.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 43vw, 510px" width="1440" height="960" fetchpriority="high" alt="Steel-blue 5-Series-style BMW sedan with modest bumper scuffs at an independent UAE inspection forecourt" /></figure>
 <div class="bmw-quote" id="bmw-quote" data-manufacturer-quote><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
 <ul class="bmw-assurances"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-engine" aria-hidden="true"></i>Damaged &amp; non-running cars</li><li><i class="ph ph-key" aria-hidden="true"></i>Individual recovery review</li></ul></section></div>
 <div class="bmw-shell"><section class="bmw-explorer" id="bmw-models" data-model-explorer aria-labelledby="model-title"><header><div><p class="eyebrow">01 / Identify the vehicle</p><h2 id="model-title">Choose your BMW.<br /><em>See what details matter.</em></h2></div><p>BMW guidance only. Choose a model to add it to the form; you can still select any other make in the form itself.</p></header>
 {models.length?<><script type="application/json" data-model-config set:html={json({make:'BMW',models,profiles:bmwProfiles,initial})} /><div class="explorer-controls"><label for="manufacturer-all-models">Browse all {models.length} BMW models<select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{modelLabel(model)}</option>)}</select></label><div class="model-tabs" role="tablist" aria-label="BMW model guidance">{choices.map((model,i)=><button type="button" role="tab" id={'model-tab-'+i} data-model-choice={model} aria-selected={model===initial?'true':'false'} aria-controls="model-guidance" tabindex={model===initial?0:-1}>{modelLabel(model)}</button>)}</div></div>
 <div class="model-result" id="model-guidance" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="model-reading"><div class="model-label"><span data-model-category>{guidance.category}</span><span data-model-name>{modelLabel(initial)}</span></div><h3 data-model-heading>{guidance.title}</h3><p data-model-copy>{guidance.copy}</p><SectionActionButton href="#bmw-quote" label={'Value my '+modelLabel(initial)} intent="valuation" /></div><div class="model-checklist"><span class="checklist-label">Prepare these details</span><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><p>Choose the exact model and year. If an option is missing, <a href="/contact-us/">ask about your vehicle</a> rather than selecting a substitute.</p></div></div><p data-model-status role="status" aria-live="polite" class="selection-status"></p></>:<p>Catalogue options are temporarily unavailable. <a href="/contact-us/">Contact us about your BMW</a>.</p>}
 </section></div>
 <section class="bmw-ledger" aria-labelledby="value-title"><div class="bmw-shell"><header><p class="eyebrow">02 / An individual scrap assessment</p><h2 id="value-title">What affects<br /><span>your BMW’s scrap value?</span></h2><p>What affects your BMW’s scrap value? The car’s present condition and practical circumstances, not a model name alone.</p></header><div class="ledger-layout"><div class="ledger-factors">{bmwFactors.map(([number,title,copy],i)=><details open={i===0}><summary><span>{number}</span><h3>{title}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}<a href="/scrap-car-value/">Understand scrap-car value <i class="ph ph-book-open" aria-hidden="true"></i></a></div><figure data-manufacturer-reveal><img src="/sections/bmw-suv-assessment.webp" srcset="/sections/bmw-suv-assessment-640.webp 640w, /sections/bmw-suv-assessment-960.webp 960w, /sections/bmw-suv-assessment.webp 1440w" sizes="(max-width:900px) calc(100vw - 36px), (max-width:1250px) 51vw, 610px" width="1440" height="960" loading="lazy" decoding="async" alt="Mineral-white X3-style BMW SUV with light door wear being assessed at an independent UAE workshop" /></figure></div><div class="recovery-strip"><div><i class="ph ph-key" aria-hidden="true"></i><h3>Keys &amp; movement</h3><p>Share what is known about keys, tyres, rolling and steering. Do not test a damaged vehicle.</p></div><div><i class="ph ph-garage" aria-hidden="true"></i><h3>The way out</h3><p>Explain entrances, gates, obstructions and permissions when discussing <a href="/car-removal/">vehicle recovery</a>.</p></div><div><i class="ph ph-identification-card" aria-hidden="true"></i><h3>Authorised handover</h3><p>Explain available vehicle documents and who can authorise release before arrangements are agreed.</p></div></div></div></section>
 <div class="bmw-shell"><section class="bmw-condition" data-condition-explorer aria-labelledby="condition-title"><header><div><p class="eyebrow">03 / Describe the car you have</p><h2 id="condition-title">What's the condition<br />of your BMW?</h2></div><p>Select a description for practical guidance. These prompts help a conversation; they do not calculate a price or decide acceptance.</p></header><script type="application/json" data-condition-config set:html={json(bmwConditions)} /><div class="condition-tabs" role="tablist" aria-label="BMW condition guidance">{bmwConditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-controls="condition-guidance" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i>{item.label}</button>)}</div><ConditionGraphic /><div class="condition-result" id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0"><div><p class="eyebrow" data-condition-category>{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p></div><div><span class="checklist-label">Information to share</span><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul><a data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div></div><p data-condition-status role="status" aria-live="polite" class="selection-status"></p></section>
 <EnquiryJourney makeLabel="BMW" quoteId="bmw-quote" />
 <section class="bmw-faq" data-manufacturer-faq aria-labelledby="faq-title"><header><p class="eyebrow">The BMW enquiry, explained</p><h2 id="faq-title">BMW scrap valuation.<br /><em>Your questions answered.</em></h2><p>For practical coverage information, explore our <a href="/locations/">UAE locations</a>.</p></header><div class="faq-list">{bmwFaqs.map(([question,answer])=><details><summary><h3>{question}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></section>
 <section class="bmw-final" aria-labelledby="final-title"><div><p class="eyebrow">Start with your BMW</p><h2 id="final-title">Ready to value<br /><span>your BMW?</span></h2><p>Request a free valuation for the vehicle you have today.</p></div><SectionActionButton href="#bmw-quote" label="Get my BMW valuation" intent="valuation" /><p class="independent">Independent service. No BMW affiliation, authorisation or endorsement is implied.</p></section></div>
 <ManufacturerInteractions />
 </main>
</BaseLayout>
<style>
.bmw-page{background:#f7f7f2;color:#24342b}.bmw-shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.bmw-page :is(h1,h2,h3,p,figure){margin:0}.bmw-page :is(header,figure,article){min-width:0}.bmw-page h2{font-size:clamp(32px,3.6vw,47px);line-height:1.1;letter-spacing:-.05em;font-weight:600}.bmw-page h2 em{font-style:normal;color:#74806d}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:10px;font-weight:750;color:#63765b;margin-bottom:17px!important}.bmw-breadcrumb{display:flex;align-items:center;gap:10px;font-size:11px;color:#6b7866;padding:21px 0 27px}.bmw-breadcrumb a{color:inherit;text-decoration:none}.bmw-breadcrumb a:hover{text-decoration:underline}.bmw-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-areas:'heading photo' 'form form' 'points points';gap:24px 38px;padding-bottom:35px;align-items:center}.bmw-hero header{grid-area:heading}.bmw-hero h1{font-size:clamp(36px,4.1vw,57px);line-height:1.05;letter-spacing:-.055em;font-weight:600}.bmw-hero h1 span{display:block}.bmw-hero h1 span:last-child{color:var(--smc-green)}.hero-intro{font-size:14px;line-height:1.8;max-width:420px;margin-top:20px!important;color:#64715e}.hero-rule{display:block;width:55px;height:2px;background:#6d8760;margin-top:24px}.bmw-hero-photo{grid-area:photo;border-radius:4px 36px 4px 4px;overflow:hidden;aspect-ratio:3/2;background:#e8e9e2}.bmw-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.bmw-quote{grid-area:form;scroll-margin-top:25px;min-width:0}.bmw-quote :global(.quote-card--free-quote){display:grid;grid-template-columns:230px minmax(0,1fr);gap:30px;padding:25px;border-radius:14px;border:1px solid #d7dfd1;box-shadow:0 12px 35px #253c2210}.bmw-quote :global(.quote-head){align-self:center}.bmw-quote :global(.quote-head h2){font-size:25px;line-height:1.15;letter-spacing:-.04em}.bmw-quote :global(.quote-head p){font-size:12px;line-height:1.7}.bmw-quote :global(.quote-kicker){font-size:9px}.bmw-quote :global(.quote-card--free-quote form){grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 15px;margin-top:0;align-items:end}.bmw-quote :global(.quote-card--free-quote .field-grid){grid-column:1/-1;grid-template-columns:1.25fr 1.1fr .65fr 1fr;gap:12px 10px}.bmw-quote :global(.model-availability){order:5;margin:0;font-size:10px}.bmw-quote :global(.quote-card--free-quote input),.bmw-quote :global(.quote-card--free-quote select){height:49px;font-size:13px;padding-left:32px;padding-right:24px;border-radius:8px}.bmw-quote :global(.with-icon i){left:10px;font-size:17px}.bmw-quote :global(.field-label){font-size:11px}.bmw-quote :global(.submit){height:49px;min-height:49px;font-size:12px;margin:0;justify-content:space-between;padding-left:18px}.bmw-quote :global(.submit i){width:30px;height:30px}.bmw-quote :global(.data-error),.bmw-quote :global(.submit-message){grid-column:1/-1}.bmw-assurances{grid-area:points;list-style:none;display:flex;justify-content:center;gap:45px;margin:0;padding:0;font-size:11px;color:#5d7354;line-height:1.5}.bmw-assurances li{display:flex;gap:8px;align-items:center}.bmw-assurances i{font-size:19px}.bmw-explorer{padding:40px 0}.bmw-explorer header,.bmw-condition header{display:flex;justify-content:space-between;align-items:end;gap:45px;margin-bottom:25px}.bmw-explorer header>p,.bmw-condition header>p{max-width:350px;font-size:13px;line-height:1.85;color:#697560}.explorer-controls{display:flex;align-items:end;justify-content:space-between;gap:25px;padding:20px 0;border-top:1px solid #d3ddca;border-bottom:1px solid #d3ddca}.explorer-controls label{display:grid;gap:8px;min-width:235px;font-size:11px;font-weight:650;color:#5d7353}.explorer-controls select{min-height:47px;width:100%;max-width:100%;padding:10px 12px;border:1px solid #c3d2b9;border-radius:8px;background:#fff;color:#314e2c;font:inherit;font-size:14px}.model-tabs{display:flex;flex-wrap:wrap;gap:6px}.model-tabs button{min-height:45px;padding:9px 14px;border:1px solid #c6d4bc;border-radius:999px;color:#527245;background:#f2f6ec;font:inherit;font-size:12px;cursor:pointer;transition:background .18s,color .18s}.model-tabs button[aria-selected=true]{background:#2b522e;border-color:#2b522e;color:#fff}.model-result{display:grid;grid-template-columns:1.5fr 1fr;gap:40px;margin-top:25px;border:1px solid #dbe2d3;border-radius:16px;background:#fff;overflow:hidden;min-height:315px}.model-reading{padding:26px 0 26px 27px}.model-label{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:22px}.model-label>span:first-child{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#6a805e}.model-label>span:last-child{font-size:26px;letter-spacing:-.035em;font-weight:650;color:#446b36;text-align:right;overflow-wrap:anywhere}.model-result h3{font-size:26px;line-height:1.25;letter-spacing:-.035em;font-weight:600}.model-reading>p{font-size:13px;line-height:1.85;color:#67795d;margin-top:16px}.model-reading :global(.section-action){font-size:12px;min-height:47px;margin-top:22px;box-shadow:none}.model-checklist{padding:29px;background:#edf2e6}.checklist-label{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#647e56;font-weight:750}.model-checklist ul{list-style:none;padding:0;margin:23px 0;display:grid;gap:14px;font-size:13px;line-height:1.8;color:#526d43}.model-checklist :global(li){display:flex;gap:10px}.model-checklist :global(li i){font-size:18px;flex-shrink:0}.model-checklist>p{font-size:11px;line-height:1.9;color:#6b7f60}.model-checklist a{color:#3b602d;text-underline-offset:4px}.selection-status{font-size:10px;line-height:1.7;color:#6d805f;min-height:20px;margin-top:15px!important}.bmw-ledger{background:#24312e;color:#f5f6ef;padding:38px 0 28px}.bmw-ledger header{display:grid;grid-template-columns:1fr 1fr;gap:0 50px;align-items:end;margin-bottom:28px}.bmw-ledger .eyebrow{color:#b1c6a1;grid-column:1/-1}.bmw-ledger h2 span{color:#b2c8a4}.bmw-ledger header>p:last-child{font-size:13px;line-height:1.85;color:#c0cdb7;max-width:380px;justify-self:end}.ledger-layout{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.2fr);gap:40px;align-items:center}.ledger-layout figure{margin:0;overflow:hidden;border-radius:13px;aspect-ratio:3/2;min-width:0}.ledger-layout img{width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;display:block;transition:filter .3s}.ledger-factors details{border-top:1px solid #52614f}.ledger-factors summary{display:flex;align-items:center;gap:15px;min-height:62px;list-style:none;cursor:pointer}.ledger-factors summary>span{font-size:10px;color:#a0b991}.ledger-factors h3{font-size:18px;font-weight:550;line-height:1.3;flex:1;letter-spacing:-.025em}.ledger-factors summary>i{font-size:19px}.ledger-factors details>p{font-size:12px;line-height:1.9;color:#b9c9af;padding:0 24px 19px 28px}.ledger-factors>a{display:inline-flex;gap:15px;align-items:center;min-height:45px;color:#d6e6ca;font-size:12px;font-weight:650;text-underline-offset:4px}.recovery-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px;border-top:1px solid #52614f;margin-top:27px;padding-top:24px}.recovery-strip>div{padding-left:32px;position:relative}.recovery-strip i{position:absolute;left:0;top:0;font-size:22px;color:#abc49a}.recovery-strip h3{font-size:15px;line-height:1.3;font-weight:600;margin-bottom:10px}.recovery-strip p{font-size:12px;line-height:1.85;color:#b7c9ac}.recovery-strip a{color:inherit;text-underline-offset:4px}.bmw-condition{padding:40px 0;border-bottom:1px solid #d2dfc6}.condition-tabs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:7px}.condition-tabs button{display:flex;align-items:center;gap:8px;min-height:53px;font:inherit;font-size:11px;line-height:1.5;text-align:left;padding:10px;border:1px solid #cbd8c1;border-radius:9px;background:transparent;color:#4b6b3e;cursor:pointer;transition:background .18s,border-color .18s}.condition-tabs button[aria-selected=true]{background:#e2ecd8;border-color:#68885b;color:#244b29}.condition-tabs i{font-size:23px;flex-shrink:0}.condition-result{display:grid;grid-template-columns:1.5fr 1fr;gap:50px;padding-top:28px;min-height:275px}.condition-result h3{font-size:26px;line-height:1.25;letter-spacing:-.035em;font-weight:600}.condition-result>div>p:not(.eyebrow){font-size:13px;line-height:1.85;color:#67795d;margin-top:16px}.condition-result .eyebrow{font-size:9px;margin-bottom:13px!important}.condition-result>div:last-child{border-left:1px solid #cfdcc5;padding-left:30px}.condition-result ul{padding-left:17px;display:grid;gap:10px;font-size:12px;line-height:1.8;color:#5f7951;margin:20px 0 8px}.condition-result a{display:inline-flex;align-items:center;gap:15px;min-height:45px;color:#3b632f;font-size:12px;font-weight:650;text-underline-offset:4px}.bmw-next{display:grid;grid-template-columns:1fr 1.7fr;gap:50px;padding:37px 0;border-bottom:1px solid #d2dfc6}.bmw-next h2{font-size:31px}.bmw-next ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.bmw-next li>span{font-size:10px;color:#69805c;text-transform:uppercase;letter-spacing:.08em}.bmw-next h3{font-size:17px;line-height:1.4;font-weight:600;letter-spacing:-.02em;margin:14px 0 11px}.bmw-next li p{font-size:12px;line-height:1.8;color:#65795a}.bmw-faq{display:grid;grid-template-columns:1fr 1.6fr;gap:65px;padding:40px 0}.bmw-faq header>p:last-child{font-size:12px;line-height:1.9;color:#6b7e61;max-width:250px;margin-top:20px}.bmw-faq a{color:#406a32;text-underline-offset:4px}.faq-list details{border-top:1px solid #cfddc3}.faq-list summary{display:flex;align-items:center;gap:20px;min-height:73px;padding:17px 0;list-style:none;cursor:pointer}.faq-list h3{font-size:13px;line-height:1.7;font-weight:650;flex:1}.faq-list summary i{font-size:18px;flex-shrink:0}.faq-list details>p{font-size:12px;line-height:1.9;color:#627959;padding:0 25px 22px 0}.bmw-page summary::-webkit-details-marker{display:none}.bmw-page details[open] summary>i:last-child{transform:rotate(45deg)}.bmw-final{display:grid;grid-template-columns:1fr auto;gap:22px;align-items:center;padding:30px;background:#e6efdc;border-radius:16px;margin-bottom:35px}.bmw-final>div>p:last-child{font-size:13px;line-height:1.85;color:#627958;margin-top:17px}.bmw-final :global(.section-action){font-size:12px;box-shadow:none}.independent{grid-column:1/-1;border-top:1px solid #c9daba;padding-top:18px;font-size:11px;line-height:1.85;color:#657d5b}.bmw-page :is(a,button,input,select,summary,[tabindex]):focus-visible{outline:3px solid #558dc3;outline-offset:4px}.bmw-page :global(.reveal-ready){opacity:0;transform:translateY(10px);transition:opacity .4s,transform .4s}.bmw-page :global(.is-revealed){opacity:1;transform:none}.panel-changed{animation:bmw-panel .2s ease}@keyframes bmw-panel{from{opacity:.6;transform:translateY(3px)}to{opacity:1;transform:none}}
@media(hover:hover){.ledger-layout figure:hover img{filter:brightness(1.04)}}
