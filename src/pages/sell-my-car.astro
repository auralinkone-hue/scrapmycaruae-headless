---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { getHomepageContent } from '../lib/homepage-content';
import { getLatestPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';
import { wixResponsiveImage } from '../lib/wix-image';

const title = 'Sell My Car UAE | Free Valuation & Vehicle Collection';
const description = 'Sell your car in the UAE with a free vehicle valuation from Scrap My Car UAE. We consider damaged, old and non-running vehicles with collection available across the UAE.';

const conditions = [
  ['ph-car-profile', 'Damaged cars', 'Share the condition of a car with visible wear or repair needs so the team can review it as it is.'],
  ['ph-warning-octagon', 'Accident-damaged cars', 'Accident damage can be included in a valuation request alongside the vehicle’s make, model and year.'],
  ['ph-engine', 'Non-running cars', 'A vehicle does not need to start before you can send its details for a valuation.'],
  ['ph-wrench', 'Engine problems', 'Mechanical issues are useful context when the team reviews the vehicle information.'],
  ['ph-gear-six', 'Gearbox problems', 'Explain any transmission concerns clearly when you continue the conversation with the team.'],
  ['ph-clock-counter-clockwise', 'Old or unwanted cars', 'Older vehicles can still be assessed using their details and overall condition.']
];

const valuationFactors = [
  ['ph-car-profile', 'Make and model', 'Different vehicles have different demand and parts value.'],
  ['ph-calendar-blank', 'Vehicle year', 'The model year helps give useful context for the valuation.'],
  ['ph-magnifying-glass', 'Overall condition', 'Visible wear and the general state of the vehicle matter.'],
  ['ph-engine', 'Mechanical condition', 'Engine, electrical and drivability issues can affect the review.'],
  ['ph-warning', 'Accident or body damage', 'Damage information helps the team understand the car as it is.'],
  ['ph-chart-line-up', 'Current vehicle demand', 'Demand can vary between makes, models and vehicle types.']
];

const locations = ['Dubai', 'Abu Dhabi', 'Sharjah', 'Ajman', 'Ras Al Khaimah', 'Fujairah', 'Umm Al Quwain', 'Al Ain'];

const faqs = [
  ['What information do I need to request a car valuation?', 'Select the vehicle make, model and year, then provide your name and mobile number so the team can contact you about the request.'],
  ['Can I request a valuation for a damaged car?', 'Yes. Include the vehicle details and share the car’s actual condition when you continue the conversation with the team.'],
  ['Can I sell a car that is not running?', 'You can submit a valuation request for a non-running car. The team can review the details and discuss the next step with you.'],
  ['Do you collect vehicles across the UAE?', 'Collection is available across supported UAE locations. Availability can depend on the vehicle and location, so the team confirms the next step after reviewing the request.'],
  ['Am I required to accept the valuation?', 'No. Sending a valuation request starts a conversation; you can decide whether you want to proceed after speaking with the team.'],
  ['What happens after I submit the valuation form?', 'Your vehicle details are saved first, then the website opens WhatsApp so you can continue directly with the team.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let homepage = await getHomepageContent();
let helpfulPosts: any[] = [];

try {
  vehicleData = await getVehicleData();
} catch (error) {
  vehicleDataError = error instanceof Error ? error.message : String(error);
}

try {
  helpfulPosts = await getLatestPosts({});
} catch {
  helpfulPosts = [];
}

const preferredMakes = ['TOYOTA', 'NISSAN', 'MERCEDES-BENZ', 'BMW', 'HONDA', 'LEXUS', 'MITSUBISHI', 'HYUNDAI'];
const makeLookup = new Map(vehicleData.makes.map((item) => [item.make.toUpperCase(), item.make]));
const selectedMakes = preferredMakes.map((make) => makeLookup.get(make)).filter(Boolean) as string[];
const editorialImage = wixResponsiveImage(homepage.page.conditionsImage as string, {
  widths: [480, 720, 960, 1200],
  fit: 'fit'
});
const editorialImageAlt = String(homepage.page.conditionsImageAlt || 'Vehicle prepared for valuation and collection');
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
    { '@type': 'ListItem', position: 2, name: 'Sell My Car', item: 'https://www.scrapmycaruae.com/sell-my-car/' }
  ]
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({
    '@type': 'Question',
    name,
    acceptedAnswer: { '@type': 'Answer', text }
  }))
};
---

<BaseLayout title={title} description={description} canonical="/sell-my-car/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <main class="sell-page">
    <section class="sell-hero" aria-labelledby="sell-my-car-title">
      <div class="smc-container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">Sell My Car</span></nav>
        <div class="sell-hero__grid">
          <div class="sell-hero__copy">
            <p class="sell-kicker">Sell your car in the UAE</p>
            <h1 id="sell-my-car-title">Sell your car.<span>Skip the usual hassle.</span></h1>
            <p class="sell-hero__lead">Request a free valuation for your vehicle without creating listings, waiting for private buyers or arranging a separate collection. Tell us your make, model and year to get started.</p>
            <ul class="trust-points" aria-label="Valuation benefits">
              <li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li>
              <li><i class="ph ph-check" aria-hidden="true"></i>UAE-wide collection</li>
              <li><i class="ph ph-check" aria-hidden="true"></i>Cars in different conditions considered</li>
            </ul>
          </div>
          <div class="sell-hero__form">
            <QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" />
          </div>
        </div>
      </div>
    </section>

    <section class="section section--intro" aria-labelledby="simple-title">
      <div class="smc-container intro-layout">
        <div><p class="sell-kicker">Simple from the start</p><h2 id="simple-title">A simpler way to sell your car in the UAE.</h2></div>
        <div class="intro-layout__copy"><p>Selling privately can mean writing listings, answering repeated messages, negotiating with different buyers and arranging viewings. Scrap My Car UAE gives vehicle owners a more direct starting point: share the basic vehicle details, request a valuation and speak with the team about the next step.</p><div class="intro-cards"><article><i class="ph ph-note-pencil" aria-hidden="true"></i><h3>No classified listing</h3><p>Start with the details that matter instead of building an advert.</p></article><article><i class="ph ph-clipboard-text" aria-hidden="true"></i><h3>One valuation request</h3><p>Send the vehicle information once and continue directly with the team.</p></article><article><i class="ph ph-truck" aria-hidden="true"></i><h3>Collection across the UAE</h3><p>Collection can be arranged once the details are agreed.</p></article></div></div>
      </div>
    </section>

    <section class="section section--soft" aria-labelledby="condition-title">
      <div class="smc-container"><div class="section-heading"><p class="sell-kicker">Vehicle conditions</p><h2 id="condition-title">Cars do not have to be in perfect condition.</h2><p>Use the valuation request to describe the vehicle you have today. The team can consider a range of conditions when reviewing the information.</p></div><div class="condition-grid">{conditions.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><h3>{heading}</h3><p>{copy}</p></article>)}</div></div>
    </section>

    <section class="section editorial" aria-labelledby="editorial-title">
      <div class="smc-container editorial__grid">
        {editorialImage.src && <div class="editorial__image image-loading" data-image-loading><picture>{editorialImage.avifSrcset && <source srcset={editorialImage.avifSrcset} sizes="(max-width: 800px) 100vw, 48vw" type="image/avif" />}<img src={editorialImage.src} srcset={editorialImage.srcset || undefined} sizes="(max-width: 800px) 100vw, 48vw" width={editorialImage.width} height={editorialImage.height} alt={editorialImageAlt} loading="lazy" decoding="async" /></picture></div>}
        <div class="editorial__copy"><p class="sell-kicker">Your vehicle, as it is</p><h2 id="editorial-title">Start with the car you have — not the car you wish you had.</h2><p>Owners often delay selling because a vehicle needs repairs, will not start or has visible damage. The valuation request should reflect the vehicle's actual condition so the team can review the car as it is.</p><a class="smc-button smc-button-primary" href="/free-quote" data-analytics-quote-cta="sell_my_car_editorial">Get My Free Valuation <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
      </div>
    </section>

    <section class="section section--dark" aria-labelledby="process-title"><div class="smc-container"><div class="section-heading section-heading--dark"><p class="sell-kicker">How it works</p><h2 id="process-title">From vehicle details to collection in three clear steps.</h2></div><ol class="process-grid"><li><span>01</span><h3>Tell us about your car</h3><p>Select the make, model and year and send your contact details.</p></li><li><span>02</span><h3>Review your valuation</h3><p>Your vehicle information is saved and the conversation continues directly with the team.</p></li><li><span>03</span><h3>Arrange the next step</h3><p>If you decide to proceed, vehicle collection can be arranged based on the agreed details.</p></li></ol></div></section>

    <section class="section" aria-labelledby="factors-title"><div class="smc-container"><div class="section-heading"><p class="sell-kicker">Understanding a valuation</p><h2 id="factors-title">What can affect your car's valuation?</h2><p>Every vehicle is different. These are common details that give useful context; they are not a published pricing formula.</p></div><div class="factor-grid">{valuationFactors.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><h3>{heading}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section section--soft coverage" aria-labelledby="coverage-title"><div class="smc-container coverage__layout"><div><p class="sell-kicker">UAE coverage</p><h2 id="coverage-title">Vehicle collection across the UAE.</h2><p>Collection availability can depend on the vehicle and location. Start with the valuation form and the team can confirm the next step.</p><a class="text-link" href="/contact-us">Contact the team <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div><ul>{locations.map((location) => <li><i class="ph ph-map-pin" aria-hidden="true"></i>{location}</li>)}</ul></div></section>

    <section class="section makes" aria-labelledby="makes-title"><div class="smc-container"><div class="section-heading"><p class="sell-kicker">Vehicle database</p><h2 id="makes-title">Popular makes owners ask us about.</h2><p>The valuation form uses the current vehicle makes, models and years already maintained in the Scrap My Car UAE vehicle database.</p></div><ul class="make-list">{selectedMakes.map((make) => <li><i class="ph ph-car-profile" aria-hidden="true"></i>{make}</li>)}</ul></div></section>

    {helpfulPosts.length > 0 && <section class="section section--soft guides" aria-labelledby="guides-title"><div class="smc-container"><div class="section-heading guides__heading"><div><p class="sell-kicker">From the blog</p><h2 id="guides-title">Helpful guides for UAE car owners</h2></div><a class="text-link" href="/blogs">View all blogs <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div></div></section>}

    <section class="section sell-faq" aria-labelledby="sell-faq-title"><div class="smc-container sell-faq__layout"><div><p class="sell-kicker">Questions answered</p><h2 id="sell-faq-title">Before you request a valuation.</h2><p>For anything specific to your vehicle, the team can help after you send the basic details.</p><a class="smc-button smc-button-secondary" href="/faqs">View all FAQs <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>

    <section class="final-valuation"><div class="smc-container final-valuation__inner"><div><p class="sell-kicker">Ready when you are</p><h2>Tell us about the car you want to sell.</h2><p>Start with the make, model and year. The form saves your details before opening WhatsApp.</p></div><a class="smc-button" href="/free-quote" data-analytics-quote-cta="sell_my_car_final">Get My Free Valuation <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div></section>
  </main>
</BaseLayout>

<style>
  .sell-page { overflow: hidden; color: #151715; }.sell-hero { padding: 22px 0 clamp(56px,7vw,88px); border-bottom: 1px solid #dce6d9; background: radial-gradient(circle at 85% 12%,rgba(93,185,56,.12),transparent 32%),linear-gradient(180deg,#fbfdf9 0%,#f4f8f2 100%); }.breadcrumb { display: flex; gap: 8px; align-items: center; color: #687268; font-size: 13px; }.breadcrumb a { color: #315d37; text-decoration: none; }.breadcrumb a:hover { text-decoration: underline; }.sell-hero__grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(400px,.78fr); gap: clamp(48px,7vw,92px); align-items: center; margin-top: 32px; }.sell-hero__copy { max-width: 690px; }.sell-kicker { margin: 0 0 12px; color: #337238; font-size: 11px; font-weight: 800; letter-spacing: .095em; text-transform: uppercase; }.sell-hero h1 { margin: 0; font-size: clamp(3.8rem,5.6vw,5.8rem); font-weight: 700; line-height: .94; letter-spacing: -.055em; }.sell-hero h1 span { display: block; color: #3c8e2f; }.sell-hero__lead { max-width: 640px; margin: 34px 0 0; color: #626862; font-size: 18px; font-weight: 450; line-height: 1.55; letter-spacing: -.01em; }.trust-points { display: grid; gap: 10px; margin: 26px 0 0; padding: 0; list-style: none; }.trust-points li { display: flex; align-items: center; gap: 9px; color: #2a472f; font-size: 14px; font-weight: 650; }.trust-points i { display: grid; width: 22px; height: 22px; place-items: center; border-radius: 50%; background: #e4f1df; color: #2f7d32; font-size: 14px; }.section { padding: clamp(64px,8vw,112px) 0; }.section--soft { background: #f6f9f4; }.section--dark { background: #173d18; color: #fff; }.section-heading { max-width: 760px; margin-bottom: 34px; }.section-heading h2,.intro-layout h2,.editorial h2,.coverage h2,.sell-faq h2 { margin: 0; color: #17331d; font-size: clamp(2.1rem,4vw,3.3rem); line-height: 1.06; letter-spacing: -.05em; }.section-heading > p:not(.sell-kicker),.coverage p,.sell-faq > p,.intro-layout__copy > p,.editorial__copy > p { color: #5c685d; font-size: 16px; line-height: 1.7; }.intro-layout { display: grid; grid-template-columns: minmax(260px,.72fr) minmax(0,1.28fr); gap: clamp(46px,7vw,94px); }.intro-layout__copy > p { max-width: 760px; margin: 0; }.intro-cards { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin-top: 26px; }.intro-cards article,.condition-grid article,.factor-grid article { padding: 20px; border: 1px solid #dce6d9; border-radius: 16px; background: #fff; }.intro-cards i,.condition-grid i,.factor-grid i { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 12px; background: #e8f3e5; color: #32753a; font-size: 20px; }.intro-cards h3,.condition-grid h3,.factor-grid h3 { margin: 15px 0 7px; color: #17331d; font-size: 17px; letter-spacing: -.02em; }.intro-cards p,.condition-grid p,.factor-grid p { margin: 0; color: #657065; font-size: 14px; line-height: 1.6; }.condition-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; }.condition-grid article { min-height: 190px; }.editorial__grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(300px,.85fr); gap: clamp(40px,7vw,92px); align-items: center; }.editorial__image { overflow: hidden; border-radius: 24px; background: #edf3e9; box-shadow: 0 22px 48px rgba(23,63,39,.10),0 4px 12px rgba(23,63,39,.05); }.editorial__image picture,.editorial__image img { display: block; width: 100%; }.editorial__image img { height: auto; object-fit: contain; }.editorial__copy { max-width: 600px; }.editorial__copy > p:not(.sell-kicker) { margin: 20px 0 28px; }.section-heading--dark h2 { color: #fff; }.section-heading--dark .sell-kicker,.final-valuation .sell-kicker { color: #a9df96; }.process-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; margin: 0; padding: 0; list-style: none; }.process-grid li { padding: 25px 0 0; border-top: 1px solid rgba(255,255,255,.22); }.process-grid span { color: #a9df96; font-size: 11px; font-weight: 800; letter-spacing: .1em; }.process-grid h3 { margin: 17px 0 9px; font-size: 24px; letter-spacing: -.035em; }.process-grid p { margin: 0; color: #c9d7c5; line-height: 1.65; }.factor-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; }.coverage__layout { display: grid; grid-template-columns: minmax(0,.82fr) minmax(0,1.18fr); gap: clamp(38px,7vw,88px); align-items: center; }.coverage__layout > div > p:not(.sell-kicker) { max-width: 630px; margin: 20px 0 23px; }.coverage ul { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }.coverage li { display: flex; align-items: center; gap: 10px; min-height: 58px; padding: 14px; border: 1px solid #dce6d9; border-radius: 14px; background: #fff; color: #29442e; font-weight: 650; }.coverage li i { color: #3c8e2f; font-size: 19px; }.text-link { display: inline-flex; align-items: center; gap: 7px; color: #2f7d32; font-size: 14px; font-weight: 700; text-decoration: none; }.text-link:hover { color: #184d2b; }.text-link .ph { transition: transform 160ms ease; }.text-link:hover .ph { transform: translateX(3px); }.make-list { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }.make-list li { display: flex; align-items: center; gap: 9px; min-height: 58px; padding: 14px; border: 1px solid #dce6d9; border-radius: 14px; color: #234128; font-weight: 650; }.make-list i { color: #3c8e2f; font-size: 20px; }.guides__heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; }.guides__heading h2 { max-width: 650px; }.guide-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }.sell-faq__layout { display: grid; grid-template-columns: minmax(260px,.64fr) minmax(0,1.36fr); gap: clamp(44px,8vw,108px); align-items: start; }.sell-faq__layout > div > p:not(.sell-kicker) { margin: 18px 0 24px; color: #5c685d; line-height: 1.7; }.faq-stack { display: grid; }.faq-stack details { border-bottom: 1px solid #dce6d9; }.faq-stack details:first-child { border-top: 1px solid #dce6d9; }.faq-stack summary { display: flex; align-items: center; justify-content: space-between; gap: 18px; min-height: 76px; padding: 18px 0; list-style: none; cursor: pointer; color: #17331d; font-size: 17px; font-weight: 700; letter-spacing: -.02em; }.faq-stack summary::-webkit-details-marker { display: none; }.faq-stack summary i { display: grid; flex: 0 0 auto; width: 28px; height: 28px; place-items: center; border: 1px solid #d7e3d4; border-radius: 50%; color: #286633; transition: transform 160ms ease; }.faq-stack details[open] summary i { transform: rotate(45deg); }.faq-stack details p { max-width: 760px; margin: -3px 0 24px; color: #5c685d; line-height: 1.7; }.final-valuation { padding: 70px 0; background: #163d18; color: #fff; }.final-valuation__inner { display: flex; align-items: center; justify-content: space-between; gap: 34px; }.final-valuation h2 { max-width: 750px; margin: 0; font-size: clamp(2.15rem,4vw,3.5rem); line-height: 1.05; letter-spacing: -.05em; }.final-valuation p:not(.sell-kicker) { margin: 13px 0 0; color: #c9d7c5; }.final-valuation .smc-button { flex: 0 0 auto; min-height: 50px; background: #fff; color: #174020; }
  @media (max-width: 980px) { .sell-hero__grid,.intro-layout,.editorial__grid,.coverage__layout,.sell-faq__layout { grid-template-columns: 1fr; }.sell-hero__form { width: min(100%,650px); }.intro-cards { max-width: 760px; }.editorial__copy { max-width: 700px; }.process-grid { gap: 28px; }.make-list { grid-template-columns: repeat(3,minmax(0,1fr)); } }.section-heading > p:not(.sell-kicker) { max-width: 680px; }.section-heading--dark { max-width: 760px; }
  @media (max-width: 700px) { .sell-hero { padding-top: 16px; }.breadcrumb { font-size: 12px; }.sell-hero__grid { gap: 27px; margin-top: 23px; }.sell-hero h1 { font-size: clamp(2.65rem,12vw,3.6rem); line-height: .96; letter-spacing: -.045em; }.sell-hero__lead { margin-top: 22px; font-size: 16px; }.trust-points { gap: 9px; margin-top: 21px; }.trust-points li { font-size: 13px; }.section { padding: 64px 0; }.section-heading { margin-bottom: 26px; }.section-heading h2,.intro-layout h2,.editorial h2,.coverage h2,.sell-faq h2 { font-size: clamp(2rem,9vw,2.6rem); }.intro-cards,.condition-grid,.factor-grid,.process-grid,.guide-grid { grid-template-columns: 1fr; }.condition-grid article { min-height: 0; }.editorial__grid { gap: 28px; }.editorial__image { border-radius: 18px; }.process-grid { gap: 17px; }.process-grid h3 { font-size: 21px; }.coverage ul { grid-template-columns: 1fr 1fr; }.coverage li { min-height: 52px; padding: 12px; font-size: 13px; }.make-list { grid-template-columns: repeat(2,minmax(0,1fr)); }.make-list li { min-height: 52px; padding: 12px; font-size: 14px; }.guides__heading,.final-valuation__inner { align-items: flex-start; flex-direction: column; }.sell-faq__layout { gap: 28px; }.faq-stack summary { min-height: 68px; font-size: 16px; }.final-valuation { padding: 58px 0; }.final-valuation .smc-button { width: 100%; }.section--dark { padding: 62px 0; } }
</style>
