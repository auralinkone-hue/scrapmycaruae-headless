---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import MakeLogoRail from '../components/MakeLogoRail.astro';
import LocationCoverageList from '../components/LocationCoverageList.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { getHomepageContent } from '../lib/homepage-content';
import { getLatestPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';
import { wixResponsiveImage } from '../lib/wix-image';

const title = 'Sell My Car UAE | Free Valuation & Vehicle Collection';
const description = 'Sell your car in the UAE with a free vehicle valuation from Scrap My Car UAE. We consider damaged, old and non-running vehicles with collection available across the UAE.';

const conditions = [
  ['ph-car-profile', 'Damaged cars', 'Share the condition of a car with visible wear or repair needs so the team can review it as it is.', 'tone-green'],
  ['ph-warning-octagon', 'Accident-damaged cars', 'Accident damage can be included in a valuation request alongside the vehicle\'s make, model and year.', 'tone-amber'],
  ['ph-engine', 'Non-running cars', 'A vehicle does not need to start before you can send its details for a valuation.', 'tone-teal'],
  ['ph-wrench', 'Engine problems', 'Mechanical issues are useful context when the team reviews the vehicle information.', 'tone-green'],
  ['ph-gear-six', 'Gearbox problems', 'Explain any transmission concerns clearly when you continue the conversation with the team.', 'tone-slate'],
  ['ph-clock-counter-clockwise', 'Old or unwanted cars', 'Older vehicles can still be assessed using their details and overall condition.', 'tone-olive']
];

const valuationFactors = [
  ['ph-car-profile', 'Make and model', 'Different vehicles have different demand and parts value.'],
  ['ph-calendar-blank', 'Vehicle year', 'The model year helps give useful context for the valuation.'],
  ['ph-magnifying-glass', 'Overall condition', 'Visible wear and the general state of the vehicle matter.'],
  ['ph-engine', 'Mechanical condition', 'Engine, electrical and drivability issues can affect the review.'],
  ['ph-warning', 'Accident or body damage', 'Damage information helps the team understand the car as it is.'],
  ['ph-chart-line-up', 'Current vehicle demand', 'Demand can vary between makes, models and vehicle types.']
];

const rtaUrl = 'https://www.rta.ae/wps/portal/rta/ae/home';
const rtaOwnershipTransferUrl = 'https://rta.ae/wps/portal/rta/ae/home/rta-services/service-details?serviceId=600';
const uaeVehicleRegistrationUrl = 'https://u.ae/en/information-and-services/transportation/registering-vehicles';
const moiUrl = 'https://moi.gov.ae';
const fcscUrl = 'https://fcsc.gov.ae';
const faqs = [
  ['Valuation & process', 'What information do I need to request a car valuation?', 'Select the vehicle make, model and year, then provide your name and mobile number. Those basics let the team start reviewing the request and contact you about the next step.'],
  ['Valuation & process', 'Is the car valuation free?', 'Yes. You can request a valuation without paying to submit the form. A valuation starts a conversation about the vehicle; it does not require you to accept an offer or proceed with collection.'],
  ['Valuation & process', 'Am I required to accept the valuation?', 'No. You are not required to accept a valuation. You can review the discussion with the team and decide whether you want to continue before making arrangements for the vehicle.'],
  ['Valuation & process', 'What can affect my car\'s valuation?', 'The make, model, year, condition, mechanical issues, accident damage and current vehicle demand can affect a valuation. The review is based on the vehicle details you provide, not a public fixed-price list.'],
  ['Valuation & process', 'What happens after I submit the valuation form?', 'Your vehicle details are saved first, then WhatsApp opens so you can continue directly with the team. They can ask for useful condition details and explain the next practical step.'],
  ['Vehicle condition', 'Can I request a valuation for a damaged car?', 'Yes. Include the vehicle details and explain visible damage or repair needs so the team can review the car as it is.'],
  ['Vehicle condition', 'Can I sell an accident-damaged car in the UAE?', 'Yes, you can request a valuation for an accident-damaged vehicle. The final process depends on the vehicle status and applicable traffic-authority requirements.'],
  ['Vehicle condition', 'Can I sell a car that is not running?', 'Yes. Tell the team the make, model, year and known condition so they can review the request and discuss collection feasibility.'],
  ['Vehicle condition', 'Do I need to repair my car before requesting a valuation?', 'No. Describe the car’s actual condition, including known faults or damage, so the review is based on accurate information.'],
  ['Vehicle condition', 'Can I sell a car with engine or gearbox problems?', 'Yes. Explain the known symptoms or repair history when speaking with the team so the vehicle can be considered as it is.'],
  ['Vehicle condition', 'Can I sell an old or high-mileage car?', 'Yes. Older or high-mileage vehicles can still be assessed. Provide the correct make, model, year and condition, then the team can explain the available next step.'],
  ['Vehicle condition', 'Can I request a valuation for a flood-damaged car?', 'Yes. Disclose the damage clearly. Condition, safety and registration status can affect what is possible, so the team will review the details before discussing collection.'],
  ['Ownership & paperwork', 'Can I request a valuation if my Mulkiya has expired?', 'Yes. You can still request a valuation. The final ownership or registration process depends on the vehicle status and current traffic-authority requirements.'],
  ['Ownership & paperwork', 'Can I sell a car that still has an outstanding bank loan?', 'You can request a valuation, but an active vehicle mortgage generally needs to be cleared before ownership can change. Check current lender and authority requirements first.'],
  ['Ownership & paperwork', 'Do traffic fines need to be cleared before ownership changes?', 'Outstanding fines or other restrictions can affect a vehicle transaction. Check the vehicle status with the relevant traffic authority before completing an ownership or registration change.'],
  ['Ownership & paperwork', 'What documents may be needed when the vehicle is handed over or deregistered?', 'Requirements depend on the vehicle and process. Keep the Mulkiya, Emirates ID and any authority or lender paperwork available, then confirm current requirements before final handover.'],
  ['Ownership & paperwork', 'What is an RTA Possession Certificate and when can it apply to a damaged or scrap vehicle?', 'An RTA Possession Certificate may apply when a damaged vehicle is transferred as scrap. Eligibility and documents depend on the current vehicle record, so check current RTA requirements first.'],
  ['Ownership & paperwork', 'What happens to the number plates when a vehicle registration is cancelled?', 'Plate handling depends on the registration-cancellation process and the applicable authority. Confirm current authority instructions before cancelling registration.'],
  ['Collection', 'Do you collect vehicles across the UAE?', 'Collection is available across supported UAE locations. Availability can depend on the vehicle condition and location, so the team confirms the practical next step after reviewing your request.'],
  ['Collection', 'How long does valuation and collection take?', 'Timing depends on the vehicle details, condition, location and paperwork status. Send the form first; the team can give a realistic next-step timeline rather than a fixed promise.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let homepage = await getHomepageContent();
let helpfulPosts: any[] = [];

try {
  vehicleData = await getVehicleData();
} catch (error) {
  vehicleDataError = error instanceof Error ? error.message : String(error);
}

try {
  helpfulPosts = await getLatestPosts({});
} catch {
  helpfulPosts = [];
}

const preferredMakes = ['TOYOTA', 'NISSAN', 'MERCEDES-BENZ', 'BMW', 'HONDA', 'LEXUS', 'MITSUBISHI', 'HYUNDAI'];
const makeLookup = new Map(vehicleData.makes.map((item) => [item.make.toUpperCase(), item.make]));
const selectedMakes = preferredMakes.map((make) => makeLookup.get(make)).filter(Boolean) as string[];
const editorialImage = wixResponsiveImage(homepage.page.conditionsImage as string, {
  widths: [480, 720, 960, 1200],
  fit: 'fit'
});
const editorialImageAlt = String(homepage.page.conditionsImageAlt || 'Vehicle prepared for valuation and collection');
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
    { '@type': 'ListItem', position: 2, name: 'Sell My Car', item: 'https://www.scrapmycaruae.com/sell-my-car/' }
  ]
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([, name, text]) => ({
    '@type': 'Question',
    name,
    acceptedAnswer: { '@type': 'Answer', text }
  }))
};
---

<BaseLayout title={title} description={description} canonical="/sell-my-car/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <main class="sell-page">
    <section class="sell-hero" aria-labelledby="sell-my-car-title">
      <div class="smc-container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">Sell My Car</span></nav>
        <div class="sell-hero__grid">
          <div class="sell-hero__copy">
            <h1 id="sell-my-car-title">Sell your car.<span>Skip the usual hassle.</span></h1>
            <p class="sell-hero__lead"><span>Get a free valuation for your car.</span><span>Share its make, model and year to get started.</span></p>
          </div>
          <div class="sell-hero__form">
            <QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" />
          </div>
          <ul class="trust-points" aria-label="Valuation benefits">
            <li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>UAE-wide collection</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>Cars in different conditions considered</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mobile-makes" aria-labelledby="mobile-makes-title">
      <div class="smc-container">
        <p class="sell-kicker">Popular makes</p>
        <h2 id="mobile-makes-title">Popular makes we buy.</h2>
      </div>
      <MakeLogoRail makes={selectedMakes} />
    </section>

    <section class="section section--intro" aria-labelledby="simple-title">
      <div class="smc-container intro-bento">
        <div class="intro-bento__copy"><h2 id="simple-title">A simpler way to <span class="heading-accent">sell your car</span> in the UAE.</h2><p>Selling privately can mean writing listings, answering repeated messages, negotiating with different buyers and arranging viewings. Scrap My Car UAE gives vehicle owners a more direct starting point.</p><a class="smc-button smc-button-primary intro-bento__cta" href="/free-quote" data-analytics-quote-cta="sell_my_car_intro">Get My Free Valuation <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
        <article class="intro-bento__feature"><i class="ph ph-note-pencil" aria-hidden="true"></i><h3>No classified listing</h3><p>Start with the vehicle details that matter instead of building an advert or waiting for strangers to reply.</p></article>
        <article class="intro-bento__small"><i class="ph ph-clipboard-text" aria-hidden="true"></i><h3>One valuation request</h3><p>Send the information once and continue directly with the team.</p></article>
        <article class="intro-bento__small"><i class="ph ph-truck" aria-hidden="true"></i><h3>UAE collection</h3><p>Collection can be arranged once the details are agreed.</p></article>
      </div>
    </section>

    <section class="section section--soft" aria-labelledby="condition-title">
      <div class="smc-container"><div class="section-heading section-heading--centered"><h2 id="condition-title">Cars do not have to be in <span class="heading-accent">perfect condition.</span></h2><p>Use the valuation request to describe the vehicle you have today. The team can consider a range of conditions when reviewing the information.</p></div><div class="condition-grid">{conditions.map(([icon, heading, copy, tone]) => <article class={tone}><i class:list={['ph', icon]} aria-hidden="true"></i><h3>{heading}</h3><p>{copy}</p></article>)}</div></div>
    </section>

    <section class="section editorial" aria-labelledby="editorial-title">
      <div class="smc-container editorial__grid">
        {editorialImage.src && <div class="editorial__image image-loading" data-image-loading><picture>{editorialImage.avifSrcset && <source srcset={editorialImage.avifSrcset} sizes="(max-width: 800px) 100vw, 48vw" type="image/avif" />}<img src={editorialImage.src} srcset={editorialImage.srcset || undefined} sizes="(max-width: 800px) 100vw, 48vw" width={editorialImage.width} height={editorialImage.height} alt={editorialImageAlt} loading="lazy" decoding="async" /></picture></div>}
        <div class="editorial__copy"><h2 id="editorial-title">Start with the car you have — not the car you wish you had.</h2><p>Owners often delay selling because a vehicle needs repairs, will not start or has visible damage. The valuation request should reflect the vehicle's actual condition so the team can review the car as it is.</p><a class="smc-button smc-button-primary" href="/free-quote" data-analytics-quote-cta="sell_my_car_editorial">Get My Free Valuation <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
      </div>
    </section>

    <section class="section section--dark" aria-labelledby="process-title"><div class="smc-container"><div class="section-heading section-heading--dark section-heading--centered"><h2 id="process-title">From vehicle details to collection in three clear steps.</h2></div><ol class="process-grid"><li><span>01</span><h3>Tell us about your car</h3><p>Select the make, model and year and send your contact details.</p></li><li><span>02</span><h3>Review your valuation</h3><p>Your vehicle information is saved and the conversation continues directly with the team.</p></li><li><span>03</span><h3>Arrange the next step</h3><p>If you decide to proceed, vehicle collection can be arranged based on the agreed details.</p></li></ol></div></section>

    <section class="section valuation-section" aria-labelledby="factors-title"><div class="smc-container valuation-layout"><div class="section-heading section-heading--centered"><h2 id="factors-title">What can affect your <span class="heading-accent">car's valuation?</span></h2><p>Every vehicle is different. These are common details that give useful context; they are not a published pricing formula.</p></div><ul class="factor-list">{valuationFactors.map(([icon, heading, copy]) => <li><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></li>)}</ul></div></section>

    <section class="section vehicle-data" aria-labelledby="vehicle-data-title"><div class="smc-container"><div class="section-heading section-heading--centered"><h2 id="vehicle-data-title">UAE vehicle data at a glance</h2><p>Official vehicle processes can affect the steps needed before a transfer, registration change or collection is completed.</p></div><div class="data-grid"><article><i class="ph ph-arrows-left-right" aria-hidden="true"></i><p class="data-card__fact">RTA</p><h3>Ownership transfer</h3><p>Dubai's official service transfers a vehicle from the seller and registers it under the buyer, including a sale and purchase agreement.</p><a class="data-card__link" href={rtaOwnershipTransferUrl} target="_blank" rel="noopener noreferrer">View RTA service <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></article><article><i class="ph ph-car-profile" aria-hidden="true"></i><p class="data-card__fact">UAE</p><h3>Registration channels</h3><p>Vehicle registration services are available through emirate traffic departments and Ministry of Interior channels.</p><a class="data-card__link" href={uaeVehicleRegistrationUrl} target="_blank" rel="noopener noreferrer">View official guidance <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></article><article><i class="ph ph-receipt" aria-hidden="true"></i><p class="data-card__fact">Before</p><h3>Fines are settled</h3><p>The UAE's official registration guidance lists payment of fines as a step before applying to register a vehicle.</p><a class="data-card__link" href={uaeVehicleRegistrationUrl} target="_blank" rel="noopener noreferrer">Check registration steps <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></article><article><i class="ph ph-identification-card" aria-hidden="true"></i><p class="data-card__fact">ID + cover</p><h3>Key documents</h3><p>Official guidance lists Emirates ID and electronic insurance among the documents required for registration; mortgages must also be recorded where applicable.</p><a class="data-card__link" href={uaeVehicleRegistrationUrl} target="_blank" rel="noopener noreferrer">See required documents <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></article></div><p class="source-note">Sources: <a href={moiUrl} target="_blank" rel="noopener noreferrer">UAE Ministry of Interior</a> / <a href={fcscUrl} target="_blank" rel="noopener noreferrer">FCSC</a> / <a href={rtaOwnershipTransferUrl} target="_blank" rel="noopener noreferrer">Dubai RTA</a>.</p></div></section>

    <section class="section section--soft coverage" aria-labelledby="coverage-title"><div class="smc-container coverage__layout"><div class="coverage__copy"><h2 id="coverage-title">Vehicle collection <span class="heading-accent">across the UAE.</span></h2><p>Collection availability can depend on the vehicle and location. Start with the valuation form and the team can confirm the next step.</p></div><div class="coverage__locations"><LocationCoverageList /><div class="coverage__action"><SectionActionButton href="/contact-us" label="Contact the team" /></div></div></div></section>

    <section class="section makes" aria-labelledby="makes-title"><div class="smc-container"><div class="section-heading section-heading--centered"><h2 id="makes-title">Popular makes owners ask us about.</h2><p>The valuation form uses the current vehicle makes, models and years already maintained in the Scrap My Car UAE vehicle database.</p></div><MakeLogoRail makes={selectedMakes} /></div></section>

    {helpfulPosts.length > 0 && <section class="section section--soft guides" aria-labelledby="guides-title"><div class="smc-container"><div class="section-heading section-heading--centered"><h2 id="guides-title">Helpful guides for <span class="heading-accent">UAE car owners</span></h2><p>Helpful answers and practical guidance for selling, valuing and managing your vehicle in the UAE.</p></div><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div><div class="guides__action"><SectionActionButton href="/blogs" label="View all blogs" /></div></div></section>}

    <section class="section sell-faq" aria-labelledby="sell-faq-title"><div class="smc-container"><div class="faq-heading"><h2 id="sell-faq-title">Frequently asked questions</h2><p>Clear answers about valuations, damaged cars, ownership, registration and UAE collection.</p></div><div class="faq-stack">{faqs.map(([group, question, answer], index) => <Fragment>{(index === 0 || faqs[index - 1][0] !== group) && <p class="faq-group">{group}</p>}<details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}{group === 'Ownership & paperwork' && <> <a href={rtaUrl} target="_blank" rel="noopener noreferrer">Check current RTA requirements</a>.</>}</p></details></Fragment>)}</div></div></section>

    <section class="final-valuation"><div class="smc-container final-valuation__inner"><div><p class="sell-kicker">Ready when you are</p><h2>Tell us about the car you want to sell.</h2><p>Start with the make, model and year. The form saves your details before opening WhatsApp.</p></div><a class="smc-button" href="/free-quote" data-analytics-quote-cta="sell_my_car_final">Get My Free Valuation <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div></section>
  </main>
</BaseLayout>

<style>
  .sell-page { overflow: hidden; color: #151715; }.sell-hero { padding: 22px 0 clamp(56px,7vw,88px); border-bottom: 1px solid #dce6d9; background: radial-gradient(circle at 85% 12%,rgba(93,185,56,.12),transparent 32%),linear-gradient(180deg,#fbfdf9 0%,#f4f8f2 100%); }.breadcrumb { display: flex; gap: 8px; align-items: center; color: #687268; font-size: 13px; }.breadcrumb a { color: #315d37; text-decoration: none; }.breadcrumb a:hover { text-decoration: underline; }.sell-hero__grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(400px,.78fr); gap: clamp(48px,7vw,92px); align-items: center; margin-top: 32px; }.sell-hero__copy { max-width: 690px; }.sell-kicker { margin: 0 0 12px; color: #337238; font-size: 11px; font-weight: 800; letter-spacing: .095em; text-transform: uppercase; }.sell-hero h1 { margin: 0; font-size: clamp(3.8rem,5.6vw,5.8rem); font-weight: 700; line-height: .94; letter-spacing: -.055em; }.sell-hero h1 span { display: block; color: #3c8e2f; }.sell-hero__lead { max-width: 640px; margin: 34px 0 0; color: #626862; font-size: 18px; font-weight: 450; line-height: 1.55; letter-spacing: -.01em; }.trust-points { display: grid; gap: 10px; margin: 26px 0 0; padding: 0; list-style: none; }.trust-points li { display: flex; align-items: center; gap: 9px; color: #2a472f; font-size: 14px; font-weight: 650; }.trust-points i { display: grid; width: 22px; height: 22px; place-items: center; border-radius: 50%; background: #e4f1df; color: #2f7d32; font-size: 14px; }.section { padding: clamp(64px,8vw,112px) 0; }.section--soft { background: #f6f9f4; }.section--dark { background: #173d18; color: #fff; }.section-heading { max-width: 760px; margin-bottom: 34px; }.section-heading h2,.intro-layout h2,.editorial h2,.coverage h2,.sell-faq h2 { margin: 0; color: #17331d; font-size: clamp(2.1rem,4vw,3.3rem); line-height: 1.06; letter-spacing: -.05em; }.section-heading > p:not(.sell-kicker),.coverage p,.sell-faq > p,.intro-layout__copy > p,.editorial__copy > p { color: #5c685d; font-size: 16px; line-height: 1.7; }.intro-layout { display: grid; grid-template-columns: minmax(260px,.72fr) minmax(0,1.28fr); gap: clamp(46px,7vw,94px); }.intro-layout__copy > p { max-width: 760px; margin: 0; }.intro-cards { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin-top: 26px; }.intro-cards article,.condition-grid article,.factor-grid article { padding: 20px; border: 1px solid #dce6d9; border-radius: 16px; background: #fff; }.intro-cards i,.condition-grid i,.factor-grid i { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 12px; background: #e8f3e5; color: #32753a; font-size: 20px; }.intro-cards h3,.condition-grid h3,.factor-grid h3 { margin: 15px 0 7px; color: #17331d; font-size: 17px; letter-spacing: -.02em; }.intro-cards p,.condition-grid p,.factor-grid p { margin: 0; color: #657065; font-size: 14px; line-height: 1.6; }.condition-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; }.condition-grid article { min-height: 190px; }.editorial__grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(300px,.85fr); gap: clamp(40px,7vw,92px); align-items: center; }.editorial__image { overflow: hidden; border-radius: 24px; background: #edf3e9; box-shadow: 0 22px 48px rgba(23,63,39,.10),0 4px 12px rgba(23,63,39,.05); }.editorial__image picture,.editorial__image img { display: block; width: 100%; }.editorial__image img { height: auto; object-fit: contain; }.editorial__copy { max-width: 600px; }.editorial__copy > p:not(.sell-kicker) { margin: 20px 0 28px; }.section-heading--dark h2 { color: #fff; }.section-heading--dark .sell-kicker,.final-valuation .sell-kicker { color: #a9df96; }.process-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; margin: 0; padding: 0; list-style: none; }.process-grid li { padding: 25px 0 0; border-top: 1px solid rgba(255,255,255,.22); }.process-grid span { color: #a9df96; font-size: 11px; font-weight: 80