---
export const prerender = false;

import '../styles/global.css';
import QuoteForm from '../components/QuoteForm.astro';
import { getVehicleData } from '../lib/vehicle-data';

let vehicleData = {
  makes: [],
  models: [],
  years: []
};

let vehicleDataError = '';

try {
  vehicleData = await getVehicleData();
} catch (error) {
  vehicleDataError = error instanceof Error ? error.message : String(error);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css" />
    <title>Hero & valuation form preview | Scrap My Car UAE</title>
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="smc-container hero-grid">
          <div class="hero-copy">
            <h1>Sell your car.<span>Skip the hassle.</span></h1>
          </div>

          <p class="hero-lead hero-description">
            Get a free car valuation.<br class="mobile-line-break" /> Collection across the UAE.
          </p>

          <div id="valuation" class="hero-form">
            <QuoteForm
              makes={vehicleData.makes}
              models={vehicleData.models}
              years={vehicleData.years}
              dataError={vehicleDataError}
            />
          </div>

          <div class="hero-proof">
            <div><i class="ph ph-seal-check" aria-hidden="true"></i><span>Free valuation</span></div>
            <div><i class="ph ph-map-pin" aria-hidden="true"></i><span>UAE-wide collection</span></div>
            <div><i class="ph ph-car-profile" aria-hidden="true"></i><span>Any condition</span></div>
          </div>
        </div>
      </section>
    </main>

    <script>
      const markLoadedImages = () => {
        document.querySelectorAll('[data-image-loading]').forEach((container) => {
          const image = container.querySelector('img');
          if (!(image instanceof HTMLImageElement)) return;
          const complete = () => container.classList.add('is-loaded');
          if (image.complete) complete();
          else {
            image.addEventListener('load', complete, { once: true });
            image.addEventListener('error', complete, { once: true });
          }
        });
      };
      markLoadedImages();
    </script>
  </body>
</html>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 18%, rgba(82, 137, 69, .13), transparent 34%),
      linear-gradient(180deg, #f7faf5 0%, #fff 86%);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: .45;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(43, 88, 39, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(43, 88, 39, .045) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 76%);
  }

  .hero-grid {
    position: relative;
    min-height: 100dvh;
    padding: 52px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(440px, 550px);
    grid-template-rows: auto auto auto;
    column-gap: 88px;
    row-gap: 17px;
    align-content: center;
    align-items: start;
  }

  .hero-copy { grid-column: 1; grid-row: 1; }
  .hero-description { grid-column: 1; grid-row: 2; }

  .hero h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(64px, 5.8vw, 82px);
    line-height: .92;
    letter-spacing: -.068em;
    font-weight: 820;
  }

  .hero h1 span {
    display: block;
    color: var(--smc-green);
  }

  .hero-lead {
    max-width: 610px;
    margin: 0;
    color: var(--smc-muted);
    font-size: 18px;
    line-height: 1.55;
  }

  .mobile-line-break { display: none; }

  .hero-form {
    grid-column: 2;
    grid-row: 1 / span 3;
    width: 100%;
    max-width: 550px;
    position: relative;
    z-index: 1;
    align-self: center;
  }

  .hero-proof {
    grid-column: 1;
    grid-row: 3;
    margin: 0;
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }

  .hero-proof > div {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hero-proof span {
    color: #556054;
    font-size: 13px;
    font-weight: 760;
  }

  .hero-proof .ph {
    color: var(--smc-green);
    font-size: 17px;
  }

  @media (max-width: 1040px) {
    .hero { min-height: auto; }

    .hero-grid {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 54px;
      padding-bottom: 54px;
      align-items: start;
    }

    .hero-copy,
    .hero-description,
    .hero-form,
    .hero-proof {
      grid-column: 1;
      grid-row: auto;
    }

    .hero-form { max-width: 650px; }
  }

  @media (max-width: 720px) {
    .hero-grid {
      min-height: auto;
      padding: 20px 0 18px;
      gap: 12px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .hero-copy { order: 1; }
    .hero-description { order: 2; }
    .hero-form { order: 3; width: 100%; }
    .hero-proof { order: 4; }

    .hero h1 {
      max-width: 390px;
      margin: 0 auto;
      font-size: clamp(39px, 11.5vw, 46px);
      line-height: .94;
    }

    .hero-lead {
      max-width: 390px;
      margin-inline: auto;
      font-size: 15px;
      line-height: 1.4;
    }

    .mobile-line-break { display: block; }

    .hero-proof {
      justify-content: center;
      gap: 14px 18px;
      padding-top: 2px;
    }

    .hero-proof > div { gap: 5px; }
    .hero-proof span { font-size: 11px; }
    .hero-proof .ph { font-size: 15px; }
  }
</style>
