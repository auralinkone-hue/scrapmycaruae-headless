---
export const prerender = false;

import { media } from '@wix/sdk';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { getVehicleData } from '../lib/vehicle-data';
import { wixClient } from '../lib/wix';

const whatsappUrl = 'https://api.whatsapp.com/send?phone=%2B971557458322';

let vehicleData = {
  makes: [],
  models: [],
  years: []
};

let vehicleDataError = '';

try {
  vehicleData = await getVehicleData();
} catch (error) {
  vehicleDataError = error instanceof Error ? error.message : String(error);
}

const featuredMakes = vehicleData.makes
  .filter((item: any) => item.featuredMake)
  .slice(0, 5)
  .map((item: any) => item.make);

const popularMakes = [
  { name: 'Honda', icon: '/brands/honda.svg' },
  { name: 'Toyota', icon: '/brands/toyota.svg' },
  { name: 'Mercedes', icon: '/brands/mercedes.svg' },
  { name: 'Nissan', icon: '/brands/nissan.svg' }
];

let latestPosts: any[] = [];

try {
  const result = await wixClient.posts.queryPosts({
    paging: { limit: 3, offset: 0 },
    sort: [{ fieldName: 'firstPublishedDate', order: 'DESC' }]
  });
  latestPosts = result.posts ?? [];
} catch {
  latestPosts = [];
}

const getPostImage = (post: any) => {
  const image = post?.media?.wixMedia?.image;
  if (!image) return null;

  if (typeof image === 'string') {
    try {
      return media.getImageUrl(image);
    } catch {
      return null;
    }
  }

  return image?.url ? image : null;
};

const formatDate = (value: string | Date | undefined) => {
  if (!value) return '';
  return new Intl.DateTimeFormat('en-AE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(new Date(value));
};

const benefits = [
  {
    title: 'Any condition',
    text: 'Old, accident-damaged, non-running, high-mileage or mechanically faulty cars.',
    icon: 'car'
  },
  {
    title: 'Free collection',
    text: 'We arrange vehicle collection across Dubai, Sharjah and the wider UAE.',
    icon: 'truck'
  },
  {
    title: 'Straightforward paperwork',
    text: 'A simple handover process with guidance on the details needed to complete the sale.',
    icon: 'file'
  },
  {
    title: 'Direct support',
    text: 'Call or WhatsApp our team when you need help with your valuation or collection.',
    icon: 'chat'
  }
];

const steps = [
  {
    number: '01',
    title: 'Choose your vehicle',
    text: 'Select the make, model and year from our vehicle database.'
  },
  {
    number: '02',
    title: 'Get your valuation',
    text: 'Add your name and WhatsApp number and send your request to our team.'
  },
  {
    number: '03',
    title: 'Arrange collection',
    text: 'If you accept the offer, we arrange the vehicle handover and collection.'
  }
];

const conditions = [
  'Non-running cars',
  'Engine or gearbox faults',
  'Accident-damaged cars',
  'Electrical issues',
  'High-mileage vehicles',
  'Expired Mulkiya',
  'Old cars',
  'Running cars'
];

const locations = [
  'Dubai',
  'Sharjah',
  'Abu Dhabi',
  'Ajman',
  'Ras Al Khaimah',
  'Fujairah',
  'Al Ain',
  'Umm Al Quwain'
];

const faqs = [
  {
    question: 'Do you buy cars that are not running?',
    answer: 'Yes. We assess non-running cars as well as vehicles with engine, gearbox, electrical or accident damage.'
  },
  {
    question: 'Is vehicle collection free?',
    answer: 'Free vehicle collection is available as part of our service across supported UAE locations.'
  },
  {
    question: 'Can I request a valuation for a car with expired Mulkiya?',
    answer: 'Yes. Cars with expired Mulkiya can still be submitted for valuation. Our team can explain the required handover details for your situation.'
  },
  {
    question: 'What information do I need to get a quote?',
    answer: 'Choose the vehicle make, model and year, then enter your name and WhatsApp number so our team can contact you about the valuation.'
  },
  {
    question: 'Which areas do you cover?',
    answer: 'We serve customers across Dubai and the UAE, including Sharjah, Abu Dhabi, Ajman, Ras Al Khaimah, Fujairah, Al Ain and Umm Al Quwain.'
  }
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<BaseLayout
  title="Scrap My Car UAE | Free Quote & Collection - Dubai"
  description="Scrap My Car offers unbeatable prices & free scrap car valuation and collection service across all UAE locations. Obtaining a scrap car valuation has never been easier – simply share your name and contact number, and our expert car valuation team will reach out to you Shortly."
  canonical="https://www.scrapmycaruae.com/"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')}
    />
  </Fragment>

  <main>
    <section class="hero">
      <div class="smc-container hero-grid">
        <div class="hero-copy" data-reveal>
          <div class="eyebrow">
            <span class="live-dot"></span>
            Scrap car buyers across the UAE
          </div>

          <h1>
            Sell your car.
            <span>Skip the hassle.</span>
          </h1>
        </div>

        <p class="hero-lead hero-description" data-reveal>
          Get a free car valuation.<br class="mobile-line-break" /> Collection across the UAE.
        </p>

        <div id="valuation" class="hero-form" data-reveal>
          <QuoteForm
            makes={vehicleData.makes}
            models={vehicleData.models}
            years={vehicleData.years}
            dataError={vehicleDataError}
          />
        </div>

        <div class="hero-actions" data-reveal>
          <a class="smc-button smc-button-primary hero-primary" href="#valuation">
            Get Your Vehicle Price
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
          <a
            class="smc-button smc-button-secondary whatsapp-button"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
            WhatsApp Us
          </a>
        </div>

        <div class="hero-proof" data-reveal>
          <div>
            <i class="ph ph-seal-check" aria-hidden="true"></i>
            <span>Free valuation</span>
          </div>
          <div>
            <i class="ph ph-map-pin" aria-hidden="true"></i>
            <span>UAE-wide collection</span>
          </div>
          <div>
            <i class="ph ph-car-profile" aria-hidden="true"></i>
            <span>Any condition</span>
          </div>
        </div>
      </div>
    </section>

    <section class="make-strip">
        <div class="smc-container make-strip-inner">
          <span class="make-label">Popular makes we buy</span>
          <div class="make-marquee" aria-label="Popular makes we buy">
            <div class="make-list">
              {popularMakes.map((make) => (
                <div class="make-item">
                  <img src={make.icon} alt="" aria-hidden="true" loading="lazy" decoding="async" />
                  <strong>{make.name}</strong>
                </div>
              ))}
              {popularMakes.map((make) => (
                <div class="make-item" aria-hidden="true">
                  <img src={make.icon} alt="" aria-hidden="true" loading="lazy" decoding="async" />
                  <strong>{make.name}</strong>
                </div>
              ))}
            </div>
          </div>
          <a class="smc-button smc-button-secondary make-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
            WhatsApp Us
          </a>
        </div>
      </section>

    <section class="benefits smc-container">
      <div class="section-heading" data-reveal>
        <div class="smc-kicker">Why Scrap My Car UAE</div>
        <h2>A simpler way to move on from your car.</h2>
        <p>
          One straightforward process from valuation request to vehicle collection.
        </p>
      </div>

      <div class="benefit-grid">
        {benefits.map((benefit, index) => (
          <article class="benefit-card" data-reveal>
            <div class="benefit-top">
              <div class="benefit-icon">
                <i
                  class:list={[
                    'ph',
                    benefit.icon === 'car' && 'ph-car-profile',
                    benefit.icon === 'truck' && 'ph-truck',
                    benefit.icon === 'file' && 'ph-file-text',
                    benefit.icon === 'chat' && 'ph-chats-circle'
                  ]}
                  aria-hidden="true"
                ></i>
              </div>
              <span>0{index + 1}</span>
            </div>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="process-section">
      <div class="smc-container process-grid">
        <div class="process-copy" data-reveal>
          <div class="smc-kicker">How it works</div>
          <h2>From vehicle details to collection in three clear steps.</h2>
          <p>
            No classified ads, no endless buyer messages and no separate towing arrangement.
          </p>
          <a class="text-link" href="#valuation">
            Start your valuation <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>

        <div class="process-list">
          {steps.map((step) => (
            <article data-reveal>
              <span class="process-number">{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="condition-section">
      <div class="smc-container condition-grid">
        <div class="condition-visual" data-reveal>
          <div class="condition-image-wrap">
            <img
              src="/sections/vehicle-conditions.webp"
              alt="Cars in different conditions, including damaged vehicles"
              width="1456"
              height="1092"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="condition-copy" data-reveal>
          <div class="smc-kicker">We buy more than perfect cars</div>
          <h2>Your car can still have value even when it has problems.</h2>
          <p>
            We assess cars with mechanical faults, electrical problems, accident damage,
            expired registration and other issues.
          </p>

          <div class="condition-tags">
            {conditions.map((condition) => (
              <span><i class="ph ph-check" aria-hidden="true"></i>{condition}</span>
            ))}
          </div>

          <a class="smc-button condition-button" href="#valuation">
            Get a Free Valuation
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>

    <section class="value-section smc-container">
      <div class="value-intro" data-reveal>
        <div class="smc-kicker">Easy. Fast. Fair.</div>
        <h2>Designed around the way people actually want to sell a car.</h2>
      </div>

      <div class="value-grid">
        <article data-reveal>
          <span>01</span>
          <h3>Easy</h3>
          <p>Select your vehicle and send one short request. No long listing process.</p>
        </article>
        <article data-reveal>
          <span>02</span>
          <h3>Fast</h3>
          <p>Your details go directly to the team handling valuations and collections.</p>
        </article>
        <article data-reveal>
          <span>03</span>
          <h3>Fair</h3>
          <p>Your vehicle is assessed using its actual make, model, year and condition.</p>
        </article>
      </div>
    </section>

    <section class="coverage-section">
      <div class="smc-container coverage-grid">
        <div class="coverage-copy" data-reveal>
          <div class="smc-kicker">UAE vehicle collection</div>
          <h2>Wherever your car is, start with the same simple form.</h2>
          <p>
            Scrap My Car UAE serves customers across Dubai and other major UAE locations.
          </p>

          <div class="location-grid">
            {locations.map((location) => (
              <span>
                <i class="ph ph-map-pin" aria-hidden="true"></i>
                {location}
              </span>
            ))}
          </div>
        </div>

        <div class="coverage-art" data-reveal>
          <img
            src="/sections/uae-collection-coverage.webp"
            alt="UAE vehicle collection coverage map"
            width="1456"
            height="1092"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="testimonial-section smc-container">
      <div class="testimonial-card" data-reveal>
        <div class="quote-mark">“</div>
        <div class="stars" aria-label="5 star customer review">★★★★★</div>
        <blockquote>
          The process was quick and easy. After I filled out the online form,
          I got my car's valuation. The collection was handled professionally.
        </blockquote>
        <span>Customer feedback</span>
      </div>

      <div class="testimonial-side" data-reveal>
        <div class="smc-kicker">A straightforward service</div>
        <h2>Less chasing. More clarity.</h2>
        <p>
          Start online, speak directly with the team, and keep the whole vehicle-sale process simple.
        </p>
        <div class="mini-proof">
          <span><strong>01</strong> Online valuation request</span>
          <span><strong>02</strong> Direct WhatsApp support</span>
          <span><strong>03</strong> Collection arranged for you</span>
        </div>
      </div>
    </section>

    {latestPosts.length > 0 && (
      <section class="blog-section smc-container">
        <div class="blog-heading" data-reveal>
          <div>
            <div class="smc-kicker">Latest guides</div>
            <h2>Useful advice for UAE car owners.</h2>
          </div>
          <a class="text-link" href="/blogs">View all blogs <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>

        <div class="blog-grid">
          {latestPosts.map((post: any) => {
            const image = getPostImage(post);
            return (
              <article class="blog-card" data-reveal>
                <a href={`/post/${post.slug}`}>
                  <div class="blog-image">
                    {image?.url && (
                      <img
                        src={image.url}
                        alt={post?.media?.altText || post.title || ''}
                        width={image.width}
                        height={image.height}
                        loading="lazy"
                      />
                    )}
                  </div>
                  <div class="blog-meta">{formatDate(post.firstPublishedDate)}</div>
                  <h3>{post.title}</h3>
                  <span class="read-more">Read article <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <section class="faq-section smc-container">
      <div class="faq-heading" data-reveal>
        <div class="smc-kicker">Common questions</div>
        <h2>What customers usually want to know.</h2>
        <p>
          Need something else? Message our team directly on WhatsApp.
        </p>
        <a
          class="smc-button smc-button-secondary"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
          Ask on WhatsApp
        </a>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details data-reveal open={index === 0}>
            <summary>
              <span>{faq.question}</span>
              <i class="ph ph-plus" aria-hidden="true"></i>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final-cta">
      <div class="smc-container final-cta-inner" data-reveal>
        <div>
          <div class="smc-kicker">Ready when you are</div>
          <h2>Tell us which car you want to sell.</h2>
          <p>Choose your make, model and year to start your free valuation.</p>
        </div>
        <div class="final-actions">
          <a class="smc-button final-primary" href="#valuation">
            Get Your Vehicle Price
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
          <a
            class="smc-button final-whatsapp"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
            WhatsApp
          </a>
        </div>
      </div>
    </section>

    <a
      class="floating-whatsapp"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with Scrap My Car UAE on WhatsApp"
    >
      <img src="/whatsapp.svg" alt="" aria-hidden="true" />
    </a>
  </main>
</BaseLayout>

<script>
  const revealItems = document.querySelectorAll('[data-reveal]');

  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );

    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }
</script>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .65s ease, transform .65s cubic-bezier(.2,.7,.2,1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--smc-line);
    background:
      radial-gradient(circle at 78% 18%, rgba(82, 137, 69, .13), transparent 34%),
      linear-gradient(180deg, #f7faf5 0%, #fff 86%);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: .45;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(43, 88, 39, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(43, 88, 39, .045) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 76%);
  }

  .hero-grid {
    position: relative;
    min-height: 630px;
    padding: 70px 0;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(390px, .72fr);
    column-gap: 70px;
    row-gap: 20px;
    align-items: end;
  }

  .hero-copy {
    grid-column: 1;
  }

  .hero-description {
    grid-column: 1;
  }

  .eyebrow {
    width: fit-content;
    padding: 8px 12px;
    border: 1px solid #dce7d8;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,.7);
    color: #40503e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4f963f;
    box-shadow: 0 0 0 5px rgba(79,150,63,.11);
  }

  .hero h1 {
    max-width: 800px;
    margin: 18px 0 22px;
    font-size: clamp(58px, 7vw, 92px);
    line-height: .92;
    letter-spacing: -.068em;
    font-weight: 820;
  }

  .hero h1 span {
    display: block;
    color: var(--smc-green);
  }

  .hero-lead {
    max-width: 655px;
    margin: 0;
    color: var(--smc-muted);
    font-size: 19px;
    line-height: 1.68;
  }

  .mobile-line-break {
    display: none;
  }

  .hero-actions {
    grid-column: 1;
    margin-top: 30px;
    display: flex;
    gap: 11px;
    flex-wrap: wrap;
  }

  .hero-primary {
    min-width: 225px;
    justify-content: space-between;
  }

  .whatsapp-button .wa-icon {
    width: 18px;
    height: 18px;
  }

  .hero-proof {
    grid-column: 1;
    margin-top: 12px;
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }

  .hero-proof > div {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hero-proof span {
    color: #556054;
    font-size: 13px;
    font-weight: 760;
  }

  .hero-proof .ph {
    color: var(--smc-green);
    font-size: 17px;
  }

  .hero-form {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    z-index: 3;
    align-self: center;
    scroll-margin-top: 30px;
  }

  .make-strip {
    border-bottom: 1px solid var(--smc-line);
    background: #edf6ea;
  }

  .make-strip-inner {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
  }

  .make-label {
    color: #868d84;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .make-marquee {
    width: 100%;
    overflow: hidden;
  }

  .make-list {
    --marquee-step: 632px;
    width: max-content;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 130px;
    gap: 28px;
    align-items: center;
    animation: make-marquee 24s linear infinite;
  }

  .make-item {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #343a33;
  }

  .make-item img {
    width: 25px;
    height: 25px;
    object-fit: contain;
    opacity: .72;
    filter: grayscale(1);
  }

  .make-item strong {
    font-size: 13px;
    letter-spacing: .02em;
  }

  @keyframes make-marquee {
    to { transform: translateX(calc(-1 * var(--marquee-step))); }
  }

  @media (prefers-reduced-motion: reduce) {
    .make-list { animation: none; }
  }

  .make-whatsapp {
    display: none;
  }

  .benefits {
    padding: 112px 0 118px;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 50px;
  }

  .section-heading h2,
  .process-copy h2,
  .condition-copy h2,
  .value-intro h2,
  .coverage-copy h2,
  .testimonial-side h2,
  .blog-heading h2,
  .faq-heading h2,
  .final-cta h2 {
    margin: 9px 0 16px;
    font-size: clamp(40px, 5.2vw, 62px);
    line-height: 1.03;
    letter-spacing: -.05em;
  }

  .section-heading p,
  .process-copy > p,
  .condition-copy > p,
  .coverage-copy > p,
  .testimonial-side > p,
  .faq-heading > p,
  .final-cta p {
    margin: 0;
    color: var(--smc-muted);
    font-size: 17px;
    line-height: 1.68;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .benefit-card {
    min-height: 280px;
    padding: 24px;
