---
export const prerender = false;

import { media } from '@wix/sdk';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { carManufacturers, manufacturerHref } from '../lib/car-manufacturers';
import SectionActionButton from '../components/SectionActionButton.astro';
import { getHomepageContent } from '../lib/homepage-content';
import { getVehicleData } from '../lib/vehicle-data';
import { wixClient } from '../lib/wix';
import { wixResponsiveImage } from '../lib/wix-image';
import { makeLogoForName } from '../lib/make-logos';

const homepage = await getHomepageContent();
const home = homepage.page as Record<string, any>;
const settings = homepage.settings as Record<string, any>;
const whatsappUrl = String(settings.whatsappUrl || 'https://api.whatsapp.com/send?phone=%2B971557458322');

let vehicleData = {
  makes: [],
  models: [],
  years: []
};

let vehicleDataError = '';

try {
  vehicleData = await getVehicleData();
} catch (error) {
  vehicleDataError = error instanceof Error ? error.message : String(error);
}

// Retain CMS make names where present, with the ten published make routes as the catalogue.
const popularMakes = carManufacturers.map((manufacturer) => ({
  ...manufacturer,
  name: homepage.popularMakes.find((item) => item.name.toUpperCase() === manufacturer.make)?.name || manufacturer.name
}));
const servicePaths = [
  { title: 'Sell a damaged car', href: '/sell-damaged-car/', icon: 'ph-car-profile', description: 'Body damage or mechanical trouble? Start with its current condition.' },
  { title: 'Scrap your car', href: '/scrap-my-car/', icon: 'ph-recycle', description: 'For an older, unwanted car that is ready to move on.' },
  { title: 'Fleet disposal', href: '/fleet-disposal/', icon: 'ph-truck', description: 'Discuss several company vehicles and their collection requirements.' }
];
const valuationFactors = [
  { title: 'Vehicle identity', icon: 'ph-identification-card', description: 'Make, model, year and specification establish which vehicle is being assessed.' },
  { title: 'Present condition', icon: 'ph-wrench', description: 'Known faults, damage and missing components help explain what remains usable.' },
  { title: 'Parts demand', icon: 'ph-gear-six', description: 'Demand for reusable components can influence an individual assessment.' },
  { title: 'Collection access', icon: 'ph-truck', description: 'Parking position, wheel movement and recovery access affect collection planning.' }
];
const collectionLocations = [
  ['Dubai', '/locations/dubai/'], ['Abu Dhabi', '/locations/abu-dhabi/'],
  ['Sharjah', '/locations/sharjah/'], ['Ajman', '/locations/ajman/'],
  ['Ras Al Khaimah', '/locations/ras-al-khaimah/'], ['Fujairah', '/locations/fujairah/'],
  ['Umm Al Quwain', '/locations/umm-al-quwain/'], ['Al Ain', '/locations/al-ain/']
];
const conditionGuide = (title: string) => {
  if (/non.running/i.test(title)) return { href: '/sell-non-running-car/', label: 'Non-running car guidance' };
  if (/engine|gearbox|mechanical/i.test(title)) return { href: '/sell-car-with-engine-problems/', label: 'Mechanical fault guidance' };
  if (/accident|damage/i.test(title)) return { href: '/sell-accident-damaged-car/', label: 'Accident-damaged car guidance' };
  if (/expired|mulkiya/i.test(title)) return { href: '/sell-car-with-expired-registration/', label: 'Registration guidance' };
  if (/old|mileage/i.test(title)) return { href: '/scrap-old-car/', label: 'Older car guidance' };
  return { href: '/sell-damaged-car/', label: 'Vehicle condition guidance' };
};
const conditionsResponsiveImage = wixResponsiveImage(
  home.conditionsImage || '/sections/vehicle-conditions.webp',
  { widths: [480, 720, 960, 1280], aspectRatio: 1456 / 1092 }
);
const valueResponsiveImage = wixResponsiveImage(
  home.valueImage,
  { widths: [480, 720, 960, 1200], aspectRatio: 4 / 3, fit: 'fit' }
);
let latestPosts: any[] = [];

try {
  const result = await wixClient.posts.queryPosts({
    paging: { limit: 3, offset: 0 },
    sort: [{ fieldName: 'firstPublishedDate', order: 'DESC' }]
  });
  latestPosts = result.posts ?? [];
} catch {
  latestPosts = [];
}

const getPostImage = (post: any) => {
  const image = post?.media?.wixMedia?.image;
  if (!image) return null;

  if (typeof image === 'string') {
    try {
      return media.getImageUrl(image);
    } catch {
      return null;
    }
  }

  return image?.url ? image : null;
};

const formatDate = (value: string | Date | undefined) => {
  if (!value) return '';
  return new Intl.DateTimeFormat('en-AE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(new Date(value));
};

const benefits = homepage.badges.filter((item) => item.group === 'benefits');
const conditions = homepage.badges.filter((item) => item.group === 'conditions');
const heroProof = homepage.badges.filter((item) => item.group === 'heroProof');
const testimonialProof = homepage.badges.filter((item) => item.group === 'testimonialProof');
const reviews = homepage.reviewsSource === 'cms' ? homepage.reviews.filter(review => review.quote.trim()) : [];
const faqs = homepage.faqs;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<BaseLayout
  title={home.title}
  description={home.description}
  canonical="/"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')}
    />
  </Fragment>

  <main class="home-page">
    {home.heroVisible && <section class="hero">
      <div class="smc-container hero-grid">
        <div class="hero-message">
        <div class="hero-copy" data-reveal>
          <div class="eyebrow">
            <span class="live-dot"></span>
            {home.heroEyebrow}
          </div>

          <h1>
            {home.heroHeading}
            <span>{home.heroHeadingAccent}</span>
          </h1>
        </div>

        <p class="hero-lead hero-description" data-reveal>
          {home.heroDescription}
        </p>

        <div class="hero-proof" data-reveal>
          {heroProof.map((item) => (
            <div>
              <i class:list={['ph', item.icon]} aria-hidden="true"></i>
              <span>{item.title}</span>
            </div>
          ))}
        </div>
        </div>

        <div id="valuation" class="hero-form" data-reveal>
          <QuoteForm
            makes={vehicleData.makes}
            models={vehicleData.models}
            years={vehicleData.years}
            dataError={vehicleDataError}
          />
        </div>

        <div class="hero-actions" data-reveal>
          <a class="smc-button smc-button-primary hero-primary" href="#how-it-works">
            See how selling works
            <i class="ph ph-list-checks" aria-hidden="true"></i>
          </a>
          <a
            class="smc-button smc-button-secondary whatsapp-button"
            href={home.heroSecondaryButtonLink || whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
            {home.heroSecondaryButtonLabel}
          </a>
        </div>

      </div>
    </section>}

    {home.makesVisible && <section class="make-strip" aria-labelledby="popular-makes-title">
      <div class="smc-container">
        <div class="make-strip-heading">
          <h2 id="popular-makes-title" class="make-label">{home.makesHeading}</h2>
          <div class="make-tools">
            <button type="button" class="make-pause inline-link" data-make-pause aria-label="Pause manufacturer marquee" aria-controls="popular-makes-marquee" aria-pressed="false" hidden>Pause <i class="ph ph-pause" aria-hidden="true"></i></button>
            <a class="inline-link" href="/cars/">Explore all car makes <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          </div>
        </div>
        <div class="make-browser" id="popular-makes-marquee" aria-label="Popular car manufacturers">
          <div class="make-track">
            <nav class="make-list" aria-label="Car manufacturer pages">
              {popularMakes.map((make) => (
                <a class="make-item" href={manufacturerHref(make.slug)}>
                  <img src={makeLogoForName(make.make)} width="32" height="32" alt="" aria-hidden="true" loading="lazy" decoding="async" />
                  <span>{make.name}</span>
                </a>
              ))}
            </nav>
            <div class="make-list make-list-duplicate" aria-hidden="true">
              {popularMakes.map((make) => (
                <a class="make-item" href={manufacturerHref(make.slug)} tabindex="-1">
                  <img src={makeLogoForName(make.make)} width="32" height="32" alt="" loading="lazy" decoding="async" />
                  <span>{make.name}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>}

    {home.benefitsVisible && <section class="service-discovery smc-container" aria-labelledby="service-discovery-title">
      <div class="discovery-intro" data-reveal>
        <div class="smc-kicker">A route for every vehicle</div>
        <h2 id="service-discovery-title">Find the right option for your car.</h2>
        <figure class="discovery-photo">
          <img src="/sections/ford-fusion-valuation-640.webp" srcset="/sections/ford-fusion-valuation-640.webp 640w, /sections/ford-fusion-valuation-960.webp 960w" sizes="(max-width: 720px) calc(100vw - 36px), 40vw" width="960" height="640" alt="Used sedan with modest bumper damage, ready for vehicle assessment" loading="lazy" decoding="async" />
          <figcaption>Start with the vehicle you have today.</figcaption>
        </figure>
      </div>
      <nav class="service-paths" aria-label="Choose a car selling service" data-reveal>
        {servicePaths.map((service, index) => <a href={service.href}>
          <span class="path-icon"><i class:list={['ph', service.icon]} aria-hidden="true"></i></span>
          <div><span class="path-index">0{index + 1}</span><h3>{service.title}</h3><p>{service.description}</p></div>
          <i class="ph ph-arrow-up-right path-arrow" aria-hidden="true"></i>
        </a>)}
      </nav>
    </section>}

    {home.benefitsVisible && <section class="benefits smc-container">
      <div class="section-heading" data-reveal>
        <div class="smc-kicker">{home.benefitsKicker}</div>
        <h2>{home.benefitsHeading}</h2>
        <p>
          {home.benefitsDescription}
        </p>
      </div>

      <div class="benefit-grid">
        {benefits.map((benefit) => (
          <article class="benefit-card" data-reveal>
            <div class="benefit-top">
              <div class="benefit-icon">
                <i
                  class:list={[
                    'ph',
                  benefit.icon
                  ]}
                  aria-hidden="true"
                ></i>
              </div>
            </div>
            <h3>{benefit.title}</h3>
            <p>{benefit.description}</p>
          </article>
        ))}
      </div>
    </section>}

    {home.processVisible && <section id="how-it-works" class="process-section">
      <div class="smc-container process-grid">
        <div class="process-copy" data-reveal>
          <div class="smc-kicker">{home.processKicker}</div>
          <h2>{home.processHeading}</h2>
          <p>
            {home.processDescription}
          </p>
          <a class="text-link" href={home.processButtonLink}>
            Start with my car details <i class="ph ph-calculator" aria-hidden="true"></i>
          </a>
        </div>

        <div class="process-list">
          {homepage.steps.map((step) => (
            <article data-reveal>
              <div class="process-marker">
                <i class:list={['ph', step.icon]} aria-hidden="true"></i>
                <span class="process-number">{step.number}</span>
              </div>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>}

    {home.conditionsVisible && <section class="condition-section">
      <div class="smc-container condition-grid">
        <div class="condition-visual" data-reveal>
          <div class="condition-image-wrap">
            <picture>
              {conditionsResponsiveImage.avifSrcset && (
                <source
                  type="image/avif"
                  srcset={conditionsResponsiveImage.avifSrcset}
                  sizes="(max-width: 900px) calc(100vw - 36px), 50vw"
                />
              )}
              <img
                src={conditionsResponsiveImage.src}
                srcset={conditionsResponsiveImage.srcset || undefined}
                sizes="(max-width: 900px) calc(100vw - 36px), 50vw"
                alt={home.conditionsImageDecorative ? '' : home.conditionsImageAlt}
                aria-hidden={home.conditionsImageDecorative ? 'true' : undefined}
                width={conditionsResponsiveImage.width || 1456}
                height={conditionsResponsiveImage.height || 1092}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
        </div>

        <div class="condition-copy" data-reveal>
          <div class="smc-kicker">{home.conditionsKicker}</div>
          <h2>{home.conditionsHeading}</h2>
          <p>
            {home.conditionsDescription}
          </p>

          <div class="condition-tags">
            {conditions.map((condition) => (
              <details class="condition-detail" open={condition.isOpenByDefault}>
                <summary>
                  <i class:list={['ph', condition.icon]} aria-hidden="true"></i>
                  <span>{condition.title}</span>
                  <i class="ph ph-plus condition-toggle" aria-hidden="true"></i>
                </summary>
                <p>{condition.description}</p>
                <a class="condition-guide" href={condition.buttonLink?.startsWith('/') ? condition.buttonLink : conditionGuide(condition.title).href}>{conditionGuide(condition.title).label} <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
              </details>
            ))}
          </div>

          <a class="smc-button condition-button" href={home.conditionsButtonLink}>
            Value a car with problems
            <i class="ph ph-calculator" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>}

    {home.valueVisible && <section class="value-section smc-container">
      <div class="value-intro" data-reveal>
        <div class="smc-kicker">{home.valueKicker}</div>
        <h2>{home.valueHeading}</h2>
      </div>

      <div class="value-promises">
        {homepage.stats.map((stat) => <article data-reveal><span>{stat.value}</span><div><h3>{stat.title}</h3><p>{stat.description}</p></div></article>)}
      </div>
      <div class:list={['value-content-grid', { 'value-content-grid--text-only': !valueResponsiveImage.src }]}>
        {valueResponsiveImage.src && <div class="value-image" data-reveal>
          <picture>
            {valueResponsiveImage.avifSrcset && (
              <source
                type="image/avif"
                srcset={valueResponsiveImage.avifSrcset}
                sizes="(max-width: 1040px) calc(100vw - 36px), 52vw"
              />
            )}
            <img
              src={valueResponsiveImage.src}
              srcset={valueResponsiveImage.srcset || undefined}
              sizes="(max-width: 1040px) calc(100vw - 36px), 52vw"
              alt={home.valueImageDecorative ? '' : home.valueImageAlt}
              aria-hidden={home.valueImageDecorative ? 'true' : undefined}
              width={valueResponsiveImage.width || 1200}
              height={valueResponsiveImage.height || 900}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>}

        <div class="value-list">
          <h3 class="value-list-heading">What shapes a scrap valuation?</h3>
          <div class="valuation-factors">
            {valuationFactors.map((factor) => <article data-reveal><i class:list={['ph', factor.icon]} aria-hidden="true"></i><div><h3>{factor.title}</h3><p>{factor.description}</p></div></article>)}
          </div>
          <SectionActionButton href="/scrap-car-value/" label="Read the valuation guide" intent="valuation" />
        </div>
      </div>
    </section>}

    {home.coverageVisible && <section class="coverage-section">
      <div class="smc-container coverage-grid">
        <div class="coverage-copy" data-reveal>
          <div class="smc-kicker">{home.coverageKicker}</div>
          <h2>{home.coverageHeading}</h2>
          <p>
            {home.coverageDescription}
          </p>

        </div>
        <div class="coverage-overview" data-reveal>
          <figure class="coverage-art">
            <!-- Natural Earth 1:50m public-domain country boundaries; network lines illustrate coverage, not roads. -->
            <img src="/sections/uae-coverage-editorial.webp" srcset="/sections/uae-coverage-editorial-640.webp 640w, /sections/uae-coverage-editorial.webp 1280w" sizes="(max-width: 760px) calc(100vw - 36px), 48vw" width="1280" height="960" alt="UAE collection coverage illustration with markers around Abu Dhabi, Dubai, the northern emirates and Al Ain" loading="lazy" decoding="async" />
            <figcaption><i class="ph ph-truck" aria-hidden="true"></i>Collection access is confirmed with your request.</figcaption>
          </figure>
          <div class="coverage-destinations">
            <h3>Collection across the UAE</h3>
            <nav aria-label="Key collection locations">{collectionLocations.map(([name, href]) => <a href={href}><i class="ph ph-map-pin" aria-hidden="true"></i>{name}</a>)}</nav>
            <p>Share your exact parking location and whether the car rolls or steers. We can then discuss suitable collection access.</p>
            <div class="coverage-areas">Selected local guides: <a href="/locations/dubai/al-quoz/">Al Quoz</a> · <a href="/locations/dubai/al-qusais/">Al Qusais</a> · <a href="/locations/abu-dhabi/musaffah/">Musaffah</a></div>
            <SectionActionButton href="/locations/" label="Explore all locations" intent="contact" icon="ph-map-trifold" />
          </div>
        </div>
      </div>
    </section>}

    {home.testimonialsVisible && <section class="testimonial-section">
      <div class="smc-container testimonial-layout">
        <div class="testimonial-side" data-reveal>
          <div class="smc-kicker">{home.testimonialsKicker}</div>
          <h2 id="homepage-reviews-heading">{home.testimonialsHeading}</h2>
          <p>{home.testimonialsDescription}</p>
          <div class="mini-proof">
            {testimonialProof.map((item) => (
              <span><i class:list={['ph', item.icon]} aria-hidden="true"></i>{item.title}</span>
            ))}
          </div>
        </div>

        <div class="review-window" data-reveal role="region" aria-roledescription="carousel" aria-labelledby="homepage-reviews-heading" tabindex="0">
          <div class="review-toolbar" data-review-controls hidden>
            <span class="review-status" data-review-status role="status" aria-live="polite" aria-atomic="true"></span>
            <div class="review-arrows">
              <button type="button" data-review-prev aria-label="Previous reviews" aria-controls="homepage-review-track"><i class="ph ph-arrow-left" aria-hidden="true"></i></button>
              <button type="button" data-review-next aria-label="Next reviews" aria-controls="homepage-review-track"><i class="ph ph-arrow-right" aria-hidden="true"></i></button>
            </div>
          </div>
          <div class="review-track" id="homepage-review-track">
            {reviews.map((review) => (
              <article class="review-card">
                {Number.isFinite(review.rating) && review.rating > 0 && review.rating <= 5 && (
                  <div class="review-rating" aria-label={`${review.rating} out of 5 stars`}>
                    <span class="review-stars" style={`--rating-fill: ${review.rating / 5 * 100}%`} aria-hidden="true">★★★★★</span>
                    <span aria-hidden="true">{review.rating}/5</span>
                  </div>
                )}
                <blockquote><p>“{review.quote}”</p></blockquote>
                {review.author && <div class="review-attribution"><i class="ph ph-user-circle" aria-hidden="true"></i><span>{review.author}</span></div>}
              </article>
            ))}
          </div>
          {reviews.length === 0 && <p class="review-empty">Customer feedback will appear here when it is available.</p>}
        </div>
      </div>
    </section>}

    {home.blogVisible && latestPosts.length > 0 && (
      <section class="blog-section smc-container">
        <div class="blog-heading" data-reveal>
          <div>
            <div class="smc-kicker">{home.blogKicker}</div>
            <h2>{home.blogHeading.includes('UAE car owners') ? <>{home.blogHeading.split('UAE car owners')[0]}<span class="heading-accent">UAE car owners</span>{home.blogHeading.split('UAE car owners')[1]}</> : home.blogHeading}</h2>
          </div>
          <a class="blog-overview-link" href={home.blogButtonLink || '/blogs'}>{home.blogButtonLabel || 'View all blogs'}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>

        <div class="blog-grid">
          {latestPosts.map((post: any, index: number) => {
            const image = getPostImage(post);
            const responsiveImage = wixResponsiveImage(image, {
              widths: [320, 480, 640, 800, 1100],
              aspectRatio: 900 / 506
            });
            return (
              <article class:list={['blog-card', { 'blog-card--featured': index === 0 }]} data-reveal>
                <a href={`/post/${post.slug}`}>
                  <div class="blog-image" data-image-loading>
                    {responsiveImage.src && (
                      <picture>
                        <source type="image/avif" srcset={responsiveImage.avifSrcset} sizes={index === 0 ? '(max-width: 760px) calc(100vw - 36px), (max-width: 1200px) 52vw, 610px' : '(max-width: 760px) calc(100vw - 36px), (max-width: 1200px) 20vw, 215px'} />
                        <img
                          src={responsiveImage.src}
                          srcset={responsiveImage.srcset}
                          sizes={index === 0 ? '(max-width: 760px) calc(100vw - 36px), (max-width: 1200px) 52vw, 610px' : '(max-width: 760px) calc(100vw - 36px), (max-width: 1200px) 20vw, 215px'}
                          alt={post?.media?.altText || post.title || ''}
                          width={responsiveImage.width}
                          height={responsiveImage.height}
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                    )}
                  </div>
                  <div class="blog-copy">
                    {post.firstPublishedDate && <time class="blog-meta" datetime={new Date(post.firstPublishedDate).toISOString()}>{formatDate(post.firstPublishedDate)}</time>}
                    <h3>{post.title}</h3>
                    <span class="read-more">Read article <i class="ph ph-book-open-text" aria-hidden="true"></i></span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {home.finalVisible && <section class="final-cta">
      <div class="smc-container final-cta-inner" data-reveal>
        <div>
          <div class="smc-kicker">{home.finalKicker}</div>
          <h2>{home.finalHeading}</h2>
          <p>{home.finalDescription}</p>
        </div>
        <div class="final-actions">
          <a class="smc-button final-primary" href={home.finalPrimaryButtonLink} data-analytics-quote-cta="final_cta">
            Send my vehicle details
            <i class="ph ph-calculator" aria-hidden="true"></i>
          </a>
          <a
            class="smc-button final-whatsapp"
            href={home.finalSecondaryButtonLink || whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
            {home.finalSecondaryButtonLabel}
          </a>
        </div>
      </div>
    </section>}

    {home.faqVisible && <section class="faq-section smc-container">
      <div class="faq-heading" data-reveal>
        <div class="smc-kicker">{home.faqKicker}</div>
        <h2>{home.faqHeading}</h2>
        <p>
          {home.faqDescription}
        </p>
        <a
          class="smc-button smc-button-secondary"
          href={home.faqButtonLink || whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
          {home.faqButtonLabel}
        </a>
        <a class="text-link faq-valuation-link" href="/free-quote" data-analytics-quote-cta="homepage_faq">
          Get a free car valuation <i class="ph ph-calculator" aria-hidden="true"></i>
        </a>
      </div>

      <div class="faq-list">
        {faqs.map((faq) => (
