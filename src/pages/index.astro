  </main>
</BaseLayout>

<script>
  const initialiseHomepage = () => {
    const root = document.querySelector<HTMLElement>('.home-page');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const controller = new AbortController();
    const { signal } = controller;
    let observer: IntersectionObserver | undefined;
    if ('IntersectionObserver' in window && !reducedMotion.matches) {
      observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer?.unobserve(entry.target);
        });
      }, { threshold: 0.06 });
      root.querySelectorAll<HTMLElement>('[data-reveal]').forEach(item => {
        // The form is immediately usable; only below-the-fold content reveals.
        if (item.closest('.hero')) return;
        item.classList.add('will-reveal');
        observer?.observe(item);
      });
    }
    const makes = root.querySelector<HTMLElement>('.make-browser');
    const makePause = root.querySelector<HTMLButtonElement>('[data-make-pause]');
    if (makePause && !reducedMotion.matches) {
      makePause.hidden = false;
      makePause.addEventListener('click', () => {
        const paused = makePause.getAttribute('aria-pressed') !== 'true';
        makePause.setAttribute('aria-pressed', String(paused));
        makePause.setAttribute('aria-label', `${paused ? 'Resume' : 'Pause'} manufacturer marquee`);
        makePause.innerHTML = `${paused ? 'Resume' : 'Pause'} <i class="ph ph-${paused ? 'play' : 'pause'}" aria-hidden="true"></i>`;
        makes?.classList.toggle('is-paused', paused);
      }, { signal });
    }
    // Keyboard focus reveals the original single set of links, with no moving target.
    makes?.addEventListener('focusout', event => {
      if (!makes.contains(event.relatedTarget as Node | null)) makes.scrollLeft = 0;
    }, { signal });
    const carousel = root.querySelector<HTMLElement>('.review-window');
    const track = carousel?.querySelector<HTMLElement>('.review-track');
    const cards = Array.from(carousel?.querySelectorAll<HTMLElement>('.review-card') || []);
    const previous = carousel?.querySelector<HTMLButtonElement>('[data-review-prev]');
    const next = carousel?.querySelector<HTMLButtonElement>('[data-review-next]');
    const status = carousel?.querySelector<HTMLElement>('[data-review-status]');
    const mobileReviews = window.matchMedia('(max-width: 620px)');
    let reviewStart = 0;
    let reviewAnimation: Animation | undefined;
    const showReviews = (start: number, animate = false) => {
      const count = mobileReviews.matches ? 1 : 2;
      const destination = Math.max(0, Math.min(start, Math.max(0, cards.length - count)));
      const direction = destination >= reviewStart ? 1 : -1;
      reviewStart = destination;
      cards.forEach((card, index) => { card.hidden = index < reviewStart || index >= reviewStart + count; });
      if (previous) previous.disabled = reviewStart === 0;
      if (next) next.disabled = reviewStart + count >= cards.length;
      if (status) status.textContent = `Reviews ${reviewStart + 1}–${Math.min(cards.length, reviewStart + count)} of ${cards.length}`;
      reviewAnimation?.cancel();
      if (animate && !reducedMotion.matches) {
        reviewAnimation = track?.animate([{ opacity: .35, transform: `translateX(${direction * 8}px)` }, { opacity: 1, transform: 'none' }], { duration: 280, easing: 'ease-out' });
      }
    };
    if (cards.length) {
      carousel?.querySelector<HTMLElement>('[data-review-controls]')?.removeAttribute('hidden');
      showReviews(0);
      previous?.addEventListener('click', () => showReviews(reviewStart - (mobileReviews.matches ? 1 : 2), true), { signal });
      next?.addEventListener('click', () => showReviews(reviewStart + (mobileReviews.matches ? 1 : 2), true), { signal });
      carousel?.addEventListener('keydown', event => {
        const count = mobileReviews.matches ? 1 : 2;
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        showReviews(event.key === 'Home' ? 0 : event.key === 'End' ? cards.length : reviewStart + (event.key === 'ArrowRight' ? count : -count), true);
      }, { signal });
      mobileReviews.addEventListener('change', () => showReviews(reviewStart), { signal });
      reducedMotion.addEventListener('change', () => reviewAnimation?.cancel(), { signal });
      signal.addEventListener('abort', () => reviewAnimation?.cancel(), { once: true });
    }
    document.addEventListener('astro:before-swap', () => { controller.abort(); observer?.disconnect(); }, { once: true, signal });
  };
  initialiseHomepage();
  document.addEventListener('astro:page-load', initialiseHomepage);
</script>

