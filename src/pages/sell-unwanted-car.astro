---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import UaeCoverageMap from '../components/UaeCoverageMap.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import ServicePageMotion from '../components/ServicePageMotion.astro';
import { getVehicleData, type VehicleData } from '../lib/vehicle-data';
import { getServiceGuidePosts } from '../lib/service-guides';
import { serializeJsonLd } from '../lib/structured-data';
import { unwantedCarTitle as title, unwantedCarDescription as description, unwantedCarConditions as conditions, unwantedCarFaqs as faqs } from '../lib/unwanted-car-content';

let vehicleData: VehicleData = { makes: [], models: [], years: [] };
let dataError = '';
try { vehicleData = await getVehicleData(); } catch { dataError = 'Vehicle catalogue unavailable'; }
const helpfulPosts = await getServiceGuidePosts('sell-unwanted-car');
const crumbs = [['Home', '/'], ['Sell My Car', '/sell-my-car/'], ['Sell Unwanted Car', '/sell-unwanted-car/']];
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map(([name, path], index) => ({ '@type': 'ListItem', position: index + 1, name, item: 'https://www.scrapmycaruae.com' + path })) };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
const reasons = [
 ['ph-key', 'The spare car stays spare.', 'A second family car, a change of routine or a move can leave a usable vehicle sitting idle. It does not need to be broken to be unwanted.'],
 ['ph-clock-counter-clockwise', 'You need the space back.', 'A car occupying a driveway or parking bay can become one more thing to manage. Share where it is parked and whether you are the owner or authorised to act.'],
 ['ph-wrench', 'The upkeep no longer adds up.', 'Repeated repairs, upcoming maintenance or work you do not want to fund can be a reason to move on. Start with its present condition, without spending more just to enquire.']
];
const factors = [
 ['01', 'Vehicle identity', 'Make, model, year and specification establish which car is being assessed.'],
 ['02', 'Present condition', 'Running state, mileage, body wear, known faults and completeness give the review context.'],
 ['03', 'Vehicle & parts demand', 'Resale possibilities and demand for usable parts differ between vehicles and can change.'],
 ['04', 'Practical arrangements', 'Location, access and available paperwork help establish what happens next.']
];
const steps = [
 ['Enter the vehicle details', 'Choose the make, model and year, then add your name and Phone / WhatsApp number.'],
 ['Submit the free request', 'Use the valuation form once. You do not need to choose a condition here to submit.'],
 ['Your request is saved', 'The details are saved securely before the form continues to WhatsApp. A failed save shows an error so you can retry.'],
 ['Continue on WhatsApp', 'The existing handoff opens a prepared conversation. Add condition details and photographs when you are ready.'],
 ['Discuss the assessment', 'The team reviews the vehicle and explains the proposed next steps. A valuation is not an accepted purchase offer.'],
 ['Agree any collection', 'Confirm access, paperwork, terms and costs before arranging collection or handover.']
];
---
<BaseLayout title={title} description={description} canonical="/sell-unwanted-car/" ogImage="/sections/ford-fusion-valuation-960.webp">
 <Fragment slot="head"><script type="application/ld+json" set:html={serializeJsonLd(breadcrumb)} /><script type="application/ld+json" set:html={serializeJsonLd(faqSchema)} /></Fragment>
 <main class="unwanted-page" data-service-motion>
  <section class="unwanted-hero" aria-labelledby="unwanted-title"><div class="smc-container">
   <nav class="breadcrumb" aria-label="Breadcrumb">{crumbs.map(([name, path], index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index < crumbs.length - 1 ? <a href={path}>{name}</a> : <span aria-current="page">{name}</span>}</>)}</nav>
   <div class="hero-layout">
    <header class="hero-copy"><h1 id="unwanted-title">Sell Your Unwanted <span>Car in the UAE</span></h1><p>A spare car, a long-parked vehicle or one you simply no longer need. Start with a free valuation, then decide what makes sense for you.</p></header>
    <div class="hero-quote" id="unwanted-quote"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={dataError} variant="free-quote" /></div>
    <figure class="hero-photo"><img src="/sections/ford-fusion-valuation-960.webp" srcset="/sections/ford-fusion-valuation-640.webp 640w, /sections/ford-fusion-valuation-960.webp 960w" sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1200px) 44vw, 510px" width="960" height="640" fetchpriority="high" decoding="async" alt="Used silver family sedan with bumper scuffs and a small front-wing dent parked in a UAE forecourt" /><figcaption>Assess the car you have, in the condition it is in.</figcaption></figure>
    <ul class="hero-benefits"><li><i class="ph ph-calculator" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-steering-wheel" aria-hidden="true"></i>Running or non-running</li><li><i class="ph ph-handshake" aria-hidden="true"></i>Your decision to proceed</li></ul>
   </div>
  </div></section>

  <section class="section reasons" aria-labelledby="reasons-title"><div class="smc-container reasons-layout">
   <div class="section-heading"><p class="eyebrow">A change of plans</p><h2 id="reasons-title">Less use.<br />More reasons to move on.</h2><p>Unwanted car buyers in the UAE need to understand both the vehicle and why it is no longer useful to you. Age is only one part of that picture.</p></div>
   <div class="reason-list">{reasons.map(([icon, heading, copy], index) => <details open={index === 0}><summary><i class:list={['ph', icon]} aria-hidden="true"></i><h3>{heading}</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div>
  </div></section>

  <section class="section value-section" aria-labelledby="value-title"><div class="smc-container value-layout">
   <div class="section-heading"><p class="eyebrow">Value before a decision</p><h2 id="value-title">Unwanted to you.<br /><span>Still worth assessing.</span></h2><p>An unwanted car is not necessarily a scrap car. A running older vehicle may still suit another owner; a car with several serious faults may need a different assessment.</p><p>Describe what you know. The team considers the details before discussing a possible sale, recovery or <a href="/scrap-my-car/">scrap-car assessment</a>.</p><a class="text-link" href="/scrap-car-value/">How vehicle value is assessed <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div>
   <div class="factor-list">{factors.map(([number, heading, copy]) => <article><span>{number}</span><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div>
  </div></section>

  <section class="section condition-section" id="unwanted-condition" aria-labelledby="condition-title"><div class="smc-container">
   <div class="section-heading"><p class="eyebrow">Choose the closest description</p><h2 id="condition-title">What is your car like today?</h2><p>Use this guidance to prepare for the conversation. It does not set a price or change your valuation request.</p></div>
   <div class="condition-workspace" data-unwanted-conditions data-condition="drives">
    <div class="condition-buttons" role="group" aria-label="Current vehicle condition">{conditions.map((condition, index) => <button type="button" id={`condition-${condition.id}`} data-unwanted-condition={condition.id} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`condition-panel-${condition.id}`}><i class:list={['ph', condition.icon]} aria-hidden="true"></i><span>{condition.label}</span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></button>)}</div>
    <div class="condition-result"><div class="vehicle-drawing" aria-hidden="true"><svg viewBox="0 0 360 110" fill="none"><path class="parking-line" d="M10 96h340M32 73V15h296v58"/><path class="car-body" d="m50 64 22-9 29-31h117l38 32 39 9 16 18H40z"/><path class="car-window" d="m91 54 20-22h45v22zm76 0V32h44l26 22z"/><circle cx="100" cy="83" r="17"/><circle cx="100" cy="83" r="7"/><circle cx="253" cy="83" r="17"/><circle cx="253" cy="83" r="7"/><path class="car-signal" d="m290 31 7-13m4 25 15-4M65 27 55 17"/></svg></div>
     <div class="condition-panels" aria-live="polite" aria-atomic="true">{conditions.map((condition, index) => <article id={`condition-panel-${condition.id}`} data-unwanted-panel aria-labelledby={`condition-${condition.id}`} hidden={index > 0}><p class="condition-label">{condition.label}</p><h3>{condition.title}</h3><p>{condition.text}</p><p class="condition-note"><i class="ph ph-note-pencil" aria-hidden="true"></i>{condition.note}</p><a class="text-link" href={condition.href}>{condition.link}<i class="ph ph-arrow-right" aria-hidden="true"></i></a></article>)}</div>
    </div>
   </div>
  </div></section>

  <section class="section process" aria-labelledby="process-title"><div class="smc-container"><div class="section-heading"><p class="eyebrow">One form. A practical conversation.</p><h2 id="process-title">From unused car to a clearer plan.</h2><p>No extra form steps. Share the basics, then discuss the vehicle with the team.</p></div><ol class="process-grid">{steps.map(([heading, copy], index) => <li><span>0{index + 1}</span><div><h3>{heading}</h3><p>{copy}</p></div></li>)}</ol></div></section>

  <section class="section collection" aria-labelledby="collection-title"><div class="smc-container collection__grid"><div class="section-heading"><p class="eyebrow">Where the car is matters</p><h2 id="collection-title">Your parking space.<br />The next practical step.</h2><p>Looking to sell an unwanted vehicle in Dubai, Abu Dhabi or elsewhere in the UAE? Tell us the exact parking location and whether recovery equipment can reach it.</p><p>A long-parked car in a basement, shared parking area or private yard may need access permission or special recovery arrangements. If it belongs to someone else, confirm your authority to act; this is not a public abandoned-vehicle removal service.</p><p>Unwanted car removal in the UAE depends on access, condition and agreed terms. Confirm collection costs and paperwork before a handover.</p><div class="inline-links"><a class="text-link" href="/car-removal/">Vehicle collection guidance <i class="ph ph-arrow-right" aria-hidden="true"></i></a><a class="text-link" href="/locations/">Explore UAE locations <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div></div><UaeCoverageMap /></div></section>

  {helpfulPosts.length > 0 && <section class="section guides" aria-labelledby="guides-title"><div class="smc-container"><div class="section-heading"><h2 id="guides-title">A little reading before you decide.</h2><p>Existing guides on choosing a route and preparing the information for a vehicle discussion.</p></div><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div></div></section>}

  <section class="section faqs" aria-labelledby="faq-title"><div class="smc-container faq-layout"><div class="section-heading"><h2 id="faq-title">Your unwanted-car questions, answered.</h2><p>Start with the vehicle you have. Agree the details before deciding to sell or arrange collection.</p><a class="text-link" href="/sell-my-car/">See the wider car-selling guide <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div><div class="faq-stack">{faqs.map(([question, answer]) => <details><summary>{question}<i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>

  <section class="final-valuation" aria-labelledby="final-title"><div class="smc-container final-valuation__inner"><div><p class="eyebrow">Ready when you are</p><h2 id="final-title">Give that unused car<br />a next step.</h2><p>Request a free valuation. Review the options before making your decision.</p></div><SectionActionButton href="#unwanted-quote" label="Value my unwanted car" intent="valuation" /></div></section>
 </main>
 <ServicePageMotion />
 <script>
  import { initializeUnwantedConditions } from '../lib/unwanted-car-interactions';
  const initialize = () => document.querySelectorAll<HTMLElement>('[data-unwanted-conditions]').forEach(initializeUnwantedConditions);
  initialize(); document.addEventListener('astro:page-load', initialize);
 </script>
</BaseLayout>

<style>
.unwanted-page{--ink:#173a24;--green:var(--smc-green);--muted:#5d6b60;color:var(--ink)}.section{padding:clamp(44px,6vw,78px) 0}.smc-container{max-width:1180px}h1,h2,h3,p,figure{margin:0}h2{font-size:clamp(29px,3.2vw,43px);line-height:1.13;letter-spacing:-.04em}h3{font-size:17px;line-height:1.35;letter-spacing:-.015em}p{font-size:15px;line-height:1.75;color:var(--muted)}.section-heading>p:not(.eyebrow){margin-top:17px;max-width:610px}.section-heading h2 span{color:var(--green)}.eyebrow{margin-bottom:12px;font-size:11px;font-weight:750;letter-spacing:.11em;text-transform:uppercase;color:var(--green)}.text-link{display:inline-flex;align-items:center;gap:9px;margin-top:20px;color:#235e32;font-size:14px;font-weight:650;text-underline-offset:4px}.text-link i{transition:transform .2s}.text-link:hover i{transform:translateX(3px)}.unwanted-page :is(a,button,summary):focus-visible{outline:3px solid #50904b;outline-offset:4px}.unwanted-hero{padding:22px 0 28px;background:linear-gradient(160deg,#f7faf4,#fff 75%)}.breadcrumb{display:flex;flex-wrap:wrap;gap:9px;font-size:11px;color:#687764;margin-bottom:25px}.breadcrumb a{color:#3e6640;text-decoration:none}.hero-layout{display:grid;grid-template-columns:1.15fr 1fr;grid-template-areas:"copy photo" "form form" "benefits benefits";gap:22px 44px;align-items:center}.hero-copy{grid-area:copy}.hero-copy h1{font-size:clamp(38px,4.1vw,58px);line-height:1.08;letter-spacing:-.05em}.hero-copy h1 span{display:block;color:var(--green)}.hero-copy>p{max-width:520px;margin-top:20px;font-size:17px;line-height:1.65}.hero-quote{grid-area:form;scroll-margin-top:25px}.hero-photo{grid-area:photo;overflow:hidden;border-radius:24px;border:1px solid #dce7d8;background:#edf3e9;position:relative}.hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.hero-photo figcaption{padding:12px 16px;background:#fff;font-size:14px;line-height:1.45;color:#50624e}.hero-benefits{grid-area:benefits;display:flex;justify-content:center;gap:28px;list-style:none;padding:0;margin:0;font-size:12px;color:#426644}.hero-benefits li{display:flex;align-items:center;gap:7px}.hero-benefits i{font-size:17px;color:#4b8641}.reasons-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px}.reason-list details{border-bottom:1px solid #dce6d7}.reason-list summary{display:flex;align-items:center;gap:15px;padding:21px 0;cursor:pointer;list-style:none}.reason-list summary>i:first-child{font-size:24px;color:#518244}.reason-list summary>i:last-child{margin-left:auto;font-size:18px}.reason-list p{padding:0 0 22px 39px}.reason-list details[open] summary>i:last-child,.faq-stack details[open] summary i{transform:rotate(45deg)}summary::-webkit-details-marker{display:none}.value-section{background:#f4f7f0}.value-layout{display:grid;grid-template-columns:1fr 1fr;gap:72px}.factor-list article{display:flex;gap:20px;padding:19px 0;border-top:1px solid #d9e5d2}.factor-list article>span{font-size:12px;color:#648257;font-weight:700}.factor-list p{margin-top:7px;font-size:14px}.condition-section{background:#173d29;color:#fff}.condition-section .eyebrow{color:#bad8a6}.condition-section .section-heading>p:not(.eyebrow){color:#d2dfd4}.condition-workspace{display:grid;grid-template-columns:1fr 1fr;gap:34px;margin-top:30px;align-items:stretch}.condition-buttons{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-content:start}.condition-buttons button{display:flex;align-items:center;gap:12px;min-height:83px;padding:16px 14px;border:1px solid #57705c;border-radius:14px;background:#214a33;color:#eaf1e5;font:inherit;font-size:14px;font-weight:600;text-align:left;cursor:pointer;transition:background .18s,border-color .18s,transform .18s}.condition-buttons button>i:first-child{font-size:23px;flex:0 0 auto}.condition-buttons button>i:last-child{font-size:14px;margin-left:auto}.condition-buttons button:hover{background:#315e3e;border-color:#a0bd89}.condition-buttons button[aria-pressed=true]{background:#b9dda0;color:#163d24;border-color:#c8e7b4}.condition-result{padding:24px 28px;border:1px solid #57755b;border-radius:20px;background:#204b32}.vehicle-drawing{max-width:320px;margin:0 auto 12px}.vehicle-drawing svg{display:block;width:100%;stroke:#9fbd96;stroke-width:2;stroke-linejoin:round}.vehicle-drawing circle{fill:#204b32}.car-body{fill:#395f41}.car-window{fill:#193e2a}.parking-line{stroke-dasharray:5 7;opacity:.3}.car-signal{opacity:0;transition:opacity .2s}.condition-workspace[data-condition=no-start] .car-signal,.condition-workspace[data-condition=repairs] .car-signal{opacity:1}.condition-workspace[data-condition=parked] .parking-line{opacity:1;stroke:#c8e5b9}.condition-label{font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:#c5e4b4}.condition-panels h3{font-size:23px;line-height:1.2;margin-top:9px;color:#fff}.condition-panels article>p:not(.condition-label){color:#d6e2d5;margin-top:14px;font-size:14px;line-height:1.7}.condition-panels .condition-note{display:flex;align-items:flex-start;gap:9px;padding-top:13px;border-top:1px solid #54715a;font-size:12px!important}.condition-note i{margin-top:3px}.condition-result .text-link{color:#d1edbc;font-size:13px}.condition-panels [hidden]{display:none}.process-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 32px;list-style:none;padding:0;margin:28px 0 0}.process-grid li{display:flex;gap:14px;padding:23px 0;border-top:1px solid #dce6d7}.process-grid li>span{font-size:12px;font-weight:700;color:#5a8448}.process-grid p{margin-top:8px;font-size:14px}.collection{background:#f6f8f3}.collection__grid{display:grid;grid-template-columns:1.05fr 1fr;gap:48px;align-items:center}.inline-links{display:flex;gap:24px;flex-wrap:wrap}.collection :global(.coverage-map){width:100%;min-width:0}.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:26px}.faq-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:65px}.faq-stack details{border-bottom:1px solid #dce6d7}.faq-stack summary{display:flex;justify-content:space-between;gap:20px;padding:19px 0;cursor:pointer;list-style:none;font-size:15px;font-weight:600;line-height:1.5}.faq-stack summary i{flex:0 0 auto;margin-top:3px;transition:transform .2s}.faq-stack p{padding:0 24px 20px 0;font-size:14px}.final-valuation{background:#173f27;color:#fff;padding:38px 0}.final-valuation__inner{display:flex;align-items:center;justify-content:space-between;gap:25px}.final-valuation h2{font-size:clamp(29px,3vw,38px)}.final-valuation p:not(.eyebrow){color:#d7e4cf;margin-top:13px}.final-valuation .eyebrow{color:#bed8a7}.final-valuation :global(.section-action){flex-shrink:0;border-color:#8aa779;background:#d6eabe;color:#173f27;box-shadow:none}.final-valuation :global(.section-action i){background:#173f27;color:#d6eabe}
@media(min-width:761px){.hero-quote :global(.quote-card--free-quote form){grid-template-columns:repeat(4,minmax(0,1fr))}.hero-quote :global(.quote-card--free-quote .field-grid){grid-column:1/-1;grid-template-columns:repeat(4,minmax(0,1fr))}.hero-quote :global(.quote-card--free-quote .field-grid>.form-field){grid-row:1}.hero-quote :global(.quote-card--free-quote .model-availability){grid-row:2}.hero-quote :global(.quote-card--free-quote .phone-field){grid-column:1/3}.hero-quote :global(.quote-card--free-quote .submit){grid-column:3/5}}
@media(max-width:1024px){.hero-layout{gap:20px 28px}.hero-copy h1{font-size:44px}.reasons-layout,.value-layout,.faq-layout{gap:35px}.collection__grid{gap:28px}.condition-workspace{gap:20px}.condition-buttons button{padding:13px 10px;gap:8px;font-size:13px}.condition-result{padding:22px}.process-grid{grid-template-columns:1fr 1fr}}
@media(min-width:761px) and (max-width:900px){.hero-copy h1{font-size:34px}.hero-copy>p{font-size:15px}}
@media(max-width:760px){.unwanted-hero{padding-top:16px}.breadcrumb{font-size:10px;margin-bottom:20px}.hero-layout{grid-template-columns:1fr;grid-template-areas:"copy" "form" "photo" "benefits";gap:20px}.hero-copy h1{font-size:clamp(34px,7vw,46px)}.hero-copy>p{font-size:15px;margin-top:15px}.hero-photo{max-width:540px;width:100%;justify-self:center;border-radius:20px}.hero-photo figcaption{font-size:14px}.hero-benefits{flex-wrap:wrap;gap:10px 18px;justify-content:flex-start;font-size:11px}.reasons-layout,.value-layout,.collection__grid,.faq-layout{grid-template-columns:1fr;gap:26px}.condition-workspace{grid-template-columns:1fr}.condition-buttons button{min-height:78px;font-size:14px}.condition-result{padding:22px}.vehicle-drawing{max-width:260px}.reason-list summary{padding:17px 0}.section-heading>p:not(.eyebrow){margin-top:14px}.guide-grid{grid-template-columns:1fr;gap:20px}.final-valuation__inner{align-items:flex-start;flex-direction:column}.process-grid{gap:0 22px}.process-grid li{padding:18px 0}.process-grid h3{font-size:15px}.process-grid p{font-size:13px}.final-valuation p:not(.eyebrow){font-size:14px}}
@media(max-width:430px){.hero-copy h1{font-size:clamp(30px,8vw,35px)}.condition-buttons button{gap:8px;padding:12px 10px;font-size:13px}.condition-buttons button>i:last-child{display:none}.condition-buttons button>i:first-child{font-size:21px}.condition-panels h3{font-size:22px}.process-grid{grid-template-columns:1fr}.hero-quote :global(.quote-card--free-quote){padding:20px 16px}.inline-links{gap:0}}
@media(prefers-reduced-motion:reduce){.unwanted-page *{transition:none!important;animation:none!important}}
</style>
