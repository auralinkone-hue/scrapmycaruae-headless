---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import LocationCoverageList from '../components/LocationCoverageList.astro';
import MakeLogoRail from '../components/MakeLogoRail.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import { getLatestPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';

const title = 'Scrap Car Value UAE | Find Out What Your Car Is Worth';
const description = 'Find out what affects scrap car value in the UAE, including vehicle condition, make, model, usable parts, mechanical faults and collection requirements. Request a free valuation.';

const factors = [
  { key: 'details', icon: 'ph-car-profile', label: 'Vehicle details', title: 'Vehicle details', copy: 'Make, model, year and variant help put the car in context. They can influence parts relevance, demand and the practical route worth discussing.' },
  { key: 'condition', icon: 'ph-warning-circle', label: 'Condition', title: 'Current vehicle condition', copy: 'Accident damage, body damage, flood exposure, severe wear and long-term parked condition can change what remains usable and what next step makes sense.' },
  { key: 'mechanical', icon: 'ph-engine', label: 'Mechanical state', title: 'Mechanical state', copy: 'Engine or gearbox failure, electrical faults, overheating and whether the car starts or moves are useful details for a current-condition valuation.' },
  { key: 'parts', icon: 'ph-circles-three-plus', label: 'Reusable parts', title: 'Reusable components', copy: 'Body parts, mechanical components, wheels, interior pieces and electronics may be relevant when they remain usable. Not every component has resale value.' },
  { key: 'demand', icon: 'ph-chart-line-up', label: 'Market / salvage demand', title: 'Demand and salvage relevance', copy: 'Different vehicles and components can have different practical demand. The review is based on the vehicle itself, not a claimed fixed market price.' },
  { key: 'access', icon: 'ph-map-pin', label: 'Collection & access', title: 'Collection and access', copy: 'The emirate, underground parking, keys, rolling wheels and whether a recovery truck can reach the vehicle all help shape collection arrangements.' },
  { key: 'status', icon: 'ph-file-text', label: 'Documents / status', title: 'Documents and vehicle status', copy: 'Registration, finance, fines or restrictions may need attention before a transaction is completed. The exact requirements depend on the authority and route.' }
];
const conditions = [
  ['Running older car', 'Overall condition, remaining usability and current vehicle details.', 'Service history, known faults and where the vehicle is located.', 'An as-is sale or valuation may be worth comparing before choosing a route.'],
  ['Non-running car', 'Why it does not run, how long it has been parked, whether it rolls and collection access.', 'Known fault, warning lights, last running date and location.', 'Recovery and practical next-use options need to be reviewed in context.'],
  ['Accident-damaged car', 'Impact area, safety damage, body condition and whether the car moves.', "Photos if available, known damage and the car's current state.", 'Usable components and repair practicality can vary considerably.'],
  ['Engine-failure car', 'Whether it starts, diagnosed faults, overheating, smoke or loss of power.', 'Symptoms, repairs already attempted and location.', 'A current-condition comparison can be more useful than committing to a major repair.'],
  ['Gearbox-failure car', 'Whether it selects gears or moves, plus any known transmission history.', 'Symptoms, warning lights and recovery access.', 'Collection arrangements can matter where the vehicle cannot be driven.'],
  ['Flood-damaged car', 'Water exposure, electrical condition and visible interior or mechanical effects.', 'What happened and what still works.', 'The safe practical route depends on the condition of the individual car.'],
  ['End-of-life vehicle', 'Multiple faults, severe wear, condition and available vehicle details.', 'Known issues, documents and exact location.', 'Salvage, reuse, dismantling or recycling may be discussed as appropriate.']
];
const faqs = [
  ['How is scrap car value calculated in the UAE?', 'A practical valuation considers the vehicle identity, current condition, mechanical state, potentially usable components, demand and collection situation. It is not based on one fixed online table.'],
  ['Does a non-running car still have value?', 'It can still be valued. Share why it does not run, how long it has been parked, whether it rolls and where it is located.'],
  ['Does accident damage reduce the value of a car?', 'Damage can affect the practical route and what remains usable, but the impact depends on the vehicle and the damage itself.'],
  ['Can a car with engine failure still be valued?', 'Yes. Explain the known symptoms, diagnosis if available and whether the engine starts so the car can be considered in its current condition.'],
  ['Do reusable car parts affect the valuation?', 'They may be relevant where components remain usable, but not every part has practical resale value. The vehicle is reviewed as a whole.'],
  ['Does the vehicle location affect the valuation?', 'The location and access details can affect collection arrangements, particularly for a car in underground parking, with flat tyres or unable to move.'],
  ['Do I need to repair my car before asking for a valuation?', 'No. Start with the car in its current condition and compare the practical repair, sell-as-is and scrap options before spending more.'],
  ['Can I get an exact scrap price online?', 'An exact figure cannot reliably be determined from a generic online table because the individual vehicle condition, mechanical state and collection details matter. Start by sharing the vehicle details for a current-condition valuation.']
];
let vehicleData = { makes: [], models: [], years: [] }; let vehicleDataError = ''; let helpfulPosts: any[] = [];
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
try { helpfulPosts = await getLatestPosts({}); } catch { helpfulPosts = []; }
const popularMakes = vehicleData.makes.filter((make) => ['Toyota', 'Nissan', 'Honda', 'Mercedes-Benz', 'Mercedes'].includes(make)).slice(0, 4);
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Scrap My Car', item: 'https://www.scrapmycaruae.com/scrap-my-car/' },
  { '@type': 'ListItem', position: 3, name: 'Scrap Car Value', item: 'https://www.scrapmycaruae.com/scrap-car-value/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/scrap-car-value/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="value-page">
    <section class="value-hero" aria-labelledby="page-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">></span><a href="/scrap-my-car/">Scrap My Car</a><span aria-hidden="true">></span><span aria-current="page">Scrap car value</span></nav><div class="value-hero__grid"><div class="value-hero__copy"><h1 id="page-title">What is my scrap car <span>worth in the UAE?</span></h1><p>Your car's practical value depends on more than age alone. Share the make, model, year and current condition to start with a free valuation before deciding whether to sell, repair or scrap it.</p></div><div class="value-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-trust"><li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li><li><i class="ph ph-check" aria-hidden="true"></i>No repair required first</li><li><i class="ph ph-check" aria-hidden="true"></i>Damaged and non-running cars considered</li><li><i class="ph ph-check" aria-hidden="true"></i>UAE collection discussion</li></ul></div></div></section>

    <section class="section composition" aria-labelledby="shapes-title"><div class="smc-container"><header class="section-heading"><h2 id="shapes-title">What shapes your car's <span>value?</span></h2><p>There is no single fixed scrap-car price. A practical valuation is a clear review of the vehicle, its condition, usable components and the real collection situation.</p></header><div class="composition__layout"><div class="value-map" aria-label="Vehicle valuation factor map"><div class="value-map__core"><i class="ph ph-car-profile" aria-hidden="true"></i><strong>Your vehicle</strong></div><div class="value-map__line value-map__line--top" aria-hidden="true"></div><div class="value-map__nodes">{factors.slice(0, 4).map((factor, index) => <button class:list={['factor-node', { active: index === 0 }]} type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-factor={factor.key}><i class:list={['ph', factor.icon]} aria-hidden="true"></i><span>{factor.label}</span></button>)}</div><div class="value-map__result"><i class="ph ph-scales" aria-hidden="true"></i><span>Practical value</span></div></div><div class="factor-panel" aria-live="polite">{factors.map((factor, index) => <article data-factor-panel={factor.key} hidden={index !== 0}><i class:list={['ph', factor.icon]} aria-hidden="true"></i><p class="eyebrow">{factor.label}</p><h3>{factor.title}</h3><p>{factor.copy}</p></article>)}<div class="factor-panel__choices" aria-label="More valuation factors">{factors.slice(4).map((factor) => <button type="button" data-factor={factor.key} aria-pressed="false"><i class:list={['ph', factor.icon]} aria-hidden="true"></i>{factor.label}</button>)}</div></div></div></div></section>

    <section class="section difference" aria-labelledby="difference-title"><div class="smc-container difference__layout"><div><p class="eyebrow">A useful reality check</p><h2 id="difference-title">Why two similar cars can have <span>different values.</span></h2><p>Two cars of the same make, model and year can still be in completely different condition. One may run, another may have major accident damage, engine failure, more usable components or difficult recovery access.</p><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div><ul><li><i class="ph ph-check" aria-hidden="true"></i>One runs while one does not</li><li><i class="ph ph-check" aria-hidden="true"></i>Mechanical and body damage can differ</li><li><i class="ph ph-check" aria-hidden="true"></i>Collection access and status can need attention</li></ul></div></section>

    <section class="section condition-strip" aria-labelledby="condition-title"><div class="smc-container"><header class="section-heading"><h2 id="condition-title">What matters for different <span>vehicle conditions.</span></h2><p>Use the condition closest to your vehicle as a practical checklist before you request a valuation.</p></header><div class="condition-strip__tabs" role="tablist" aria-label="Vehicle condition types">{conditions.map((item, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-condition-tab={index}>{item[0]}</button>)}</div>{conditions.map((item, index) => <article class="condition-detail" role="tabpanel" data-condition-panel={index} hidden={index !== 0}><h3>{item[0]}</h3><div><p><b>What matters most</b>{item[1]}</p><p><b>What to tell us</b>{item[2]}</p><p><b>Practical consideration</b>{item[3]}</p></div></article>)}</div></section>

    <section class="section options" aria-labelledby="options-title"><div class="smc-container"><header class="section-heading"><h2 id="options-title">Is scrap value always the <span>best route?</span></h2><p>Not necessarily. Start with the vehicle's current condition, then compare the practical paths.</p></header><div class="options__lanes"><div class="options__start"><i class="ph ph-car-profile" aria-hidden="true"></i>Start with the vehicle's current condition</div><article><i class="ph ph-wrench" aria-hidden="true"></i><h3>Repair</h3><p>May make sense where the fault is understood, controlled and the vehicle is otherwise in good shape.</p></article><article><i class="ph ph-car" aria-hidden="true"></i><h3>Sell as-is</h3><p>May make sense where the car still has practical next-use value and you do not want to arrange repairs.</p></article><article><i class="ph ph-recycle" aria-hidden="true"></i><h3>Scrap</h3><p>May make sense for an end-of-life vehicle with major or multiple issues.</p></article></div><div class="section-cta"><SectionActionButton href="/free-quote" label="Compare my options" intent="valuation" /></div><p class="options__link"><a href="/scrap-my-car/">Learn more about the complete scrap-car process <span aria-hidden="true"></span></a></p></div></section>

    <section class="section details" aria-labelledby="details-title"><div class="smc-container details__layout"><div><h2 id="details-title">Practical details that can affect <span>the next step.</span></h2><p>Share what you know. Requirements and processes can differ by emirate and final transaction route.</p></div><div class="details__list"><article><i class="ph ph-identification-card" aria-hidden="true"></i><p><b>Registration / Mulkiya</b>Keep the vehicle details available for the discussion.</p></article><article><i class="ph ph-bank" aria-hidden="true"></i><p><b>Finance, fines or restrictions</b>These may require attention before a transaction is completed.</p></article><article><i class="ph ph-map-pin" aria-hidden="true"></i><p><b>Location and accessibility</b>Tell us the emirate, access situation and whether the car can move.</p></article><article><i class="ph ph-key" aria-hidden="true"></i><p><b>Plates and vehicle status</b>Confirm current authority guidance for the route that applies to your vehicle.</p></article></div></div></section>

    {popularMakes.length > 0 && <section class="section makes" aria-labelledby="makes-title"><div class="smc-container"><header class="section-heading"><h2 id="makes-title">Scrap-car valuations across <span>popular makes.</span></h2><p>Make and model are only part of the valuation. Condition, mechanical state and usable parts in the individual vehicle still matter.</p></header><MakeLogoRail makes={popularMakes} /></div></section>}

    <section class="section coverage" aria-labelledby="coverage-title"><div class="smc-container"><header class="section-heading"><h2 id="coverage-title">UAE collection, with the details <span>that matter.</span></h2><p>Share the exact vehicle location and access details with the valuation request. Coverage can be discussed across Dubai, Abu Dhabi, Sharjah, Ajman, Ras Al Khaimah, Fujairah, Umm Al Quwain and Al Ain.</p></header><LocationCoverageList /></div></section>

    {helpfulPosts.length > 0 && <section class="section section--soft guides" aria-labelledby="guides-title"><div class="smc-container"><header class="section-heading"><h2 id="guides-title">Useful guides before your <span>next decision.</span></h2><p>Read relevant Wix blog guides, then request a valuation when you are ready.</p></header><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div><div class="section-cta"><SectionActionButton href="/blogs" label="View all blogs" intent="blogs" /></div></div></section>}

    <section class="section faqs" aria-labelledby="faq-title"><div class="smc-container"><header class="section-heading"><h2 id="faq-title">Scrap-car value FAQs</h2><p>Clear answers before you decide whether to repair, sell or scrap a vehicle.</p></header><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><div class="section-cta"><SectionActionButton href="/faqs" label="Browse all FAQs" intent="faqs" /></div></div></section>
    <section class="final-cta"><div class="smc-container final-cta__inner"><div><h2>Find out what your car is worth before deciding what to do next.</h2><p>Share the vehicle details and current condition to start with a free valuation.</p></div><div><SectionActionButton href="/free-quote" label="Get my free scrap-car valuation" intent="valuation" /><a href="/scrap-my-car/">Learn about scrapping your car <span aria-hidden="true"></span></a></div></div></section>
  </main>
  <script is:inline>
    const setFactor = (key) => { document.querySelectorAll('[data-factor]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.factor === key))); document.querySelectorAll('[data-factor-panel]').forEach((panel) => panel.hidden = panel.dataset.factorPanel !== key); };
    document.querySelectorAll('[data-factor]').forEach((button) => button.addEventListener('click', () => setFactor(button.dataset.factor)));
    document.querySelectorAll('[data-condition-tab]').forEach((button) => button.addEventListener('click', () => { const key = button.dataset.conditionTab; document.querySelectorAll('[data-condition-tab]').forEach((tab) => tab.setAttribute('aria-selected', String(tab === button))); document.querySelectorAll('[data-condition-panel]').forEach((panel) => panel.hidden = panel.dataset.conditionPanel !== key); }));
  </script>
</BaseLayout>

<style>
  .value-page{overflow:hidden;color:#17331d}.value-hero{padding:22px 0 clamp(56px,7vw,94px);background:radial-gradient(circle at 9% 25%,rgba(75,151,81,.14),transparent 25%),linear-gradient(145deg,#fbfdfb,#edf6eb 60%,#f7fbfd)}.breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;color:#667266;font-size:13px}.breadcrumb a{color:#315d37;text-decoration:none}.value-hero__grid{display:grid;grid-template-areas:'copy form' 'trust form';grid-template-columns:minmax(0,1.08fr) minmax(400px,.78fr);gap:22px clamp(46px,7vw,96px);margin-top:32px}.value-hero__copy{grid-area:copy;align-self:end;max-width:660px}.value-hero h1{max-width:10ch;margin:0;font-size:clamp(3.2rem,4.8vw,5rem);line-height:.94;letter-spacing:-.067em}.value-hero h1 span,.section-heading h2 span,.difference h2 span,.details h2 span{color:#398b41}.value-hero__copy p{max-width:570px;margin:21px 0 0;color:#536453;font-size:18px;line-height:1.65}.value-hero__form{grid-area:form;filter:drop-shadow(0 18px 28px rgba(29,76,35,.1))}.hero-trust{grid-area:trust;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 18px;margin:0;padding:0;list-style:none}.hero-trust li{display:flex;align-items:center;gap:8px;color:#315637;font-size:14px;font-weight:750}.hero-trust i,.difference li i{display:grid;width:21px;height:21px;place-items:center;border-radius:50%;background:#2f7d37;color:#fff;font-size:13px}.section{padding:clamp(66px,8vw,108px) 0}.section--soft{background:#f5f9f4}.section-heading{max-width:770px;margin:0 auto 36px;text-align:center}.section-heading h2,.difference h2,.details h2,.final-cta h2{margin:0;font-size:clamp(2.35rem,4vw,3.75rem);line-height:1.04;letter-spacing:-.06em}.section-heading p{margin:16px auto 0;color:#5b6a5c;line-height:1.7}.eyebrow{margin:0;color:#397c3e;font-size:11px;font-weight:850;letter-spacing:.11em;text-transform:uppercase}.composition{position:relative;background:linear-gradient(180deg,#fff,#f7fbf6)}.composition::before{position:absolute;inset:0;opacity:.3;background-image:linear-gradient(rgba(55,125,62,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(55,125,62,.05) 1px,transparent 1px);background-size:38px 38px;content:'';mask-image:linear-gradient(90deg,transparent,#000 20%,#000 80%,transparent)}.composition .smc-container{position:relative}.composition__layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:clamp(30px,6vw,78px);align-items:center}.value-map{position:relative;display:grid;min-height:435px;place-items:center;border:1px solid #d6e6d3;border-radius:28px;background:radial-gradient(circle at center,rgba(167,220,153,.2),transparent 27%),#fff;box-shadow:0 26px 58px rgba(24,70,31,.09)}.value-map__core,.value-map__result{position:relative;z-index:1;display:grid;width:112px;height:112px;place-content:center;text-align:center;border-radius:50%;background:#1a4e25;color:#fff;box-shadow:0 0 0 11px #e6f3e3}.value-map__core i,.value-map__result i{font-size:28px}.value-map__core strong,.value-map__result span{margin-top:4px;font-size:12px;text-transform:uppercase;letter-spacing:.07em}.value-map__result{position:absolute;bottom:25px;width:96px;height:96px;background:#e9f4e6;color:#205d2a;box-shadow:0 0 0 7px #fff}.value-map__line{position:absolute;top:50%;right:13%;left:13%;height:1px;background:#b5d7af}.value-map__nodes{position:absolute;inset:0;display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(52px,9vw,110px);align-content:center;padding:34px}.factor-node{position:relative;z-index:2;display:flex;justify-content:center;gap:8px;align-items:center;min-height:47px;padding:9px 12px;border:1px solid #cfe2cc;border-radius:999px;background:#fff;color:#315d37;font:inherit;font-size:12px;font-weight:800;cursor:pointer;box-shadow:0 8px 18px rgba(28,80,34,.07);transition:transform .18s ease,border-color .18s ease,background .18s ease}.factor-node.active,.factor-node:hover{border-color:#4d944e;background:#ecf7e9;transform:translateY(-2px)}.factor-node i{color:#28743a;font-size:18px}.factor-pa