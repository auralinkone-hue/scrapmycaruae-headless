---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import MakeLogoRail from '../components/MakeLogoRail.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import { priorityCoverageLocations } from '../lib/locations';
import { getRelevantPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';

const title = 'Scrap Car Value UAE | Find Out What Your Car Is Worth';
const description = 'Find out what affects scrap car value in the UAE, including vehicle condition, make, model, usable parts, mechanical faults and collection requirements. Request a free valuation.';

const factors = [
  { key: 'details', icon: 'ph-car-profile', label: 'Vehicle details', shortLabel: 'Vehicle', title: 'Vehicle details', copy: 'Make, model, year and variant help put the car in context. They can influence parts relevance, demand and the practical route worth discussing.', details: ['Make, model and exact variant', 'Year and vehicle age', 'Parts relevance for that model', 'Accurate vehicle identity details'] },
  { key: 'condition', icon: 'ph-warning-circle', label: 'Condition', shortLabel: 'Condition', title: 'Current vehicle condition', copy: 'Accident damage, body damage, flood exposure, severe wear and long-term parked condition can change what remains usable and what next step makes sense.', details: ['Accident and body damage', 'Flood exposure or corrosion', 'Severe wear or missing items', 'How long the car has been parked'] },
  { key: 'mechanical', icon: 'ph-engine', label: 'Mechanical state', shortLabel: 'Mechanical', title: 'Mechanical state', copy: 'Engine or gearbox failure, electrical faults, overheating and whether the car starts or moves are useful details for a current-condition valuation.', details: ['Whether the engine starts', 'Whether the vehicle moves', 'Known engine or gearbox faults', 'Electrical or overheating symptoms'] },
  { key: 'parts', icon: 'ph-circles-three-plus', label: 'Reusable parts', shortLabel: 'Parts', title: 'Reusable components', copy: 'Body parts, mechanical components, wheels, interior pieces and electronics may be relevant when they remain usable. Not every component has resale value.', details: ['Usable body and mechanical parts', 'Wheels and tyre condition', 'Interior and electronic components', 'Relevance of parts to practical demand'] },
  { key: 'demand', icon: 'ph-chart-line-up', label: 'Market / salvage demand', shortLabel: 'Demand', title: 'Demand and salvage relevance', copy: 'Different vehicles and components can have different practical demand. The review is based on the vehicle itself, not a claimed fixed market price.', details: ['Make and model context', 'Demand for relevant components', 'Condition of the individual vehicle', 'A current review rather than a fixed table'] },
  { key: 'access', icon: 'ph-map-pin', label: 'Collection & access', shortLabel: 'Collection', title: 'Collection and access', copy: 'The emirate, underground parking, keys, rolling wheels and whether a recovery truck can reach the vehicle all help shape collection arrangements.', details: ['Emirate and exact location', 'Parking level and vehicle access', 'Keys, wheels and rolling condition', 'Recovery-truck access'] },
  { key: 'status', icon: 'ph-file-text', label: 'Documents / status', shortLabel: 'Documents', title: 'Documents and vehicle status', copy: 'Registration, finance, fines or restrictions may need attention before a transaction is completed. The exact requirements depend on the authority and route.', details: ['Registration or Mulkiya details', 'Finance status', 'Fines or restrictions', 'Plate and authority guidance'] }
];
const conditions = [
  ['Running older car', 'Overall condition, remaining usability and current vehicle details.', 'Service history, known faults and where the vehicle is located.', 'An as-is sale or valuation may be worth comparing before choosing a route.'],
  ['Non-running car', 'Why it does not run, how long it has been parked, whether it rolls and collection access.', 'Known fault, warning lights, last running date and location.', 'Recovery and practical next-use options need to be reviewed in context.'],
  ['Accident-damaged car', 'Impact area, safety damage, body condition and whether the car moves.', "Photos if available, known damage and the car's current state.", 'Usable components and repair practicality can vary considerably.'],
  ['Engine-failure car', 'Whether it starts, diagnosed faults, overheating, smoke or loss of power.', 'Symptoms, repairs already attempted and location.', 'A current-condition comparison can be more useful than committing to a major repair.'],
  ['Gearbox-failure car', 'Whether it selects gears or moves, plus any known transmission history.', 'Symptoms, warning lights and recovery access.', 'Collection arrangements can matter where the vehicle cannot be driven.'],
  ['Flood-damaged car', 'Water exposure, electrical condition and visible interior or mechanical effects.', 'What happened and what still works.', 'The safe practical route depends on the condition of the individual car.'],
  ['End-of-life vehicle', 'Multiple faults, severe wear, condition and available vehicle details.', 'Known issues, documents and exact location.', 'Salvage, reuse, dismantling or recycling may be discussed as appropriate.']
];
const faqs = [
  ['How is scrap car value calculated in the UAE?', 'A practical valuation considers the vehicle identity, current condition, mechanical state, potentially usable components, demand and collection situation. It is not based on one fixed online table.'],
  ['Does a non-running car still have value?', 'It can still be valued. Share why it does not run, how long it has been parked, whether it rolls and where it is located.'],
  ['Does accident damage reduce the value of a car?', 'Damage can affect the practical route and what remains usable, but the impact depends on the vehicle and the damage itself.'],
  ['Can a car with engine failure still be valued?', 'Yes. Explain the known symptoms, diagnosis if available and whether the engine starts so the car can be considered in its current condition.'],
  ['Do reusable car parts affect the valuation?', 'They may be relevant where components remain usable, but not every part has practical resale value. The vehicle is reviewed as a whole.'],
  ['Does the vehicle location affect the valuation?', 'The location and access details can affect collection arrangements, particularly for a car in underground parking, with flat tyres or unable to move.'],
  ['Do I need to repair my car before asking for a valuation?', 'No. Start with the car in its current condition and compare the practical repair, sell-as-is and scrap options before spending more.'],
  ['Can I get an exact scrap price online?', 'An exact figure cannot reliably be determined from a generic online table because the individual vehicle condition, mechanical state and collection details matter. Start by sharing the vehicle details for a current-condition valuation.']
];
let vehicleData = { makes: [], models: [], years: [] }; let vehicleDataError = ''; let helpfulPosts: any[] = [];
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
try {
  helpfulPosts = await getRelevantPosts({
    _id: 'scrap-car-value-guide',
    slug: 'scrap-car-value'
  }, ['scrap', 'junk car', 'damaged car', 'car value', 'valuation', 'non-running', 'repair', 'paperwork', 'selling a used car', 'engine', 'overheating']);
} catch { helpfulPosts = []; }
const requestedMakes = ['Toyota', 'Nissan', 'Honda', 'Mercedes-Benz'];
const makeName = (entry: unknown) => typeof entry === 'string' ? entry : String((entry as { make?: unknown })?.make ?? '');
const popularMakes = requestedMakes.map((requestedMake) => (
  makeName(vehicleData.makes.find((make) => makeName(make).toLowerCase() === requestedMake.toLowerCase()))
  || (requestedMake === 'Mercedes-Benz' ? makeName(vehicleData.makes.find((make) => makeName(make).toLowerCase() === 'mercedes')) : '')
  || requestedMake
));
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Scrap My Car', item: 'https://www.scrapmycaruae.com/scrap-my-car/' },
  { '@type': 'ListItem', position: 3, name: 'Scrap Car Value', item: 'https://www.scrapmycaruae.com/scrap-car-value/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/scrap-car-value/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="value-page">
    <section class="value-hero" aria-labelledby="page-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">></span><a href="/scrap-my-car/">Scrap My Car</a><span aria-hidden="true">></span><span aria-current="page">Scrap car value</span></nav><div class="value-hero__grid"><div class="value-hero__copy"><h1 id="page-title">What is my scrap car <span>worth in the UAE?</span></h1><p>Your car's practical value depends on more than age alone. Share the make, model, year and current condition to start with a free valuation before deciding whether to sell, repair or scrap it.</p></div><div class="value-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-trust"><li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li><li><i class="ph ph-check" aria-hidden="true"></i>No repair required first</li><li><i class="ph ph-check" aria-hidden="true"></i>Damaged and non-running cars considered</li><li><i class="ph ph-check" aria-hidden="true"></i>UAE collection discussion</li></ul></div></div></section>

    <section class="section composition" aria-labelledby="shapes-title"><div class="smc-container"><header class="section-heading"><h2 id="shapes-title">What shapes your car's <span>value?</span></h2><p>There is no single fixed scrap-car price. A practical valuation is a clear review of the vehicle, its condition, usable components and the real collection situation.</p></header><div class="composition__layout"><div class="factor-selector" role="tablist" aria-label="Vehicle valuation factors" aria-orientation="vertical">{factors.map((factor, index) => <button class:list={[{ active: index === 0 }]} id={`factor-tab-${factor.key}`} type="button" role="tab" aria-label={factor.label} aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`factor-panel-${factor.key}`} tabindex={index === 0 ? 0 : -1} data-factor={factor.key}><i class:list={['ph', factor.icon]} aria-hidden="true"></i><span class="factor-selector__label"><span class="factor-selector__label-long">{factor.label}</span><span class="factor-selector__label-short">{factor.shortLabel}</span></span><i class="ph ph-caret-right factor-selector__arrow" aria-hidden="true"></i></button>)}</div><div class="factor-panel">{factors.map((factor, index) => <article id={`factor-panel-${factor.key}`} role="tabpanel" aria-labelledby={`factor-tab-${factor.key}`} tabindex="0" data-factor-panel={factor.key} hidden={index !== 0}><div class="factor-panel__icon"><i class:list={['ph', factor.icon]} aria-hidden="true"></i></div><p class="eyebrow">Valuation factor</p><h3>{factor.title}</h3><p class="factor-panel__copy">{factor.copy}</p><ul class="factor-panel__details">{factor.details.map((detail) => <li><i class="ph ph-check" aria-hidden="true"></i>{detail}</li>)}</ul></article>)}</div></div></div></section>

    <section class="section difference" aria-labelledby="difference-title"><div class="smc-container difference__layout"><div><p class="eyebrow">A useful reality check</p><h2 id="difference-title">Why two similar cars can have <span>different values.</span></h2><p>Two cars of the same make, model and year can still be in completely different condition. One may run, another may have major accident damage, engine failure, more usable components or difficult recovery access.</p><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div><ul><li><i class="ph ph-check" aria-hidden="true"></i>One runs while one does not</li><li><i class="ph ph-check" aria-hidden="true"></i>Mechanical and body damage can differ</li><li><i class="ph ph-check" aria-hidden="true"></i>Collection access and status can need attention</li></ul></div></section>

    <section class="section condition-strip" aria-labelledby="condition-title"><div class="smc-container"><header class="section-heading"><h2 id="condition-title">What matters for different <span>vehicle conditions.</span></h2><p>Use the condition closest to your vehicle as a practical checklist before you request a valuation.</p></header><div class="condition-strip__tabs" role="tablist" aria-label="Vehicle condition types">{conditions.map((item, index) => <button id={`condition-tab-${index}`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`condition-panel-${index}`} tabindex={index === 0 ? 0 : -1} data-condition-tab={index}>{item[0]}</button>)}</div>{conditions.map((item, index) => <article id={`condition-panel-${index}`} class="condition-detail" role="tabpanel" aria-labelledby={`condition-tab-${index}`} tabindex="0" data-condition-panel={index} hidden={index !== 0}><h3>{item[0]}</h3><div><p><b>What matters most</b>{item[1]}</p><p><b>What to tell us</b>{item[2]}</p><p><b>Practical consideration</b>{item[3]}</p></div></article>)}</div></section>

    <section class="section options" aria-labelledby="options-title"><div class="smc-container"><header class="section-heading"><h2 id="options-title">Is scrap value always the <span>best route?</span></h2><p>Not necessarily. Start with the vehicle's current condition, then compare the practical paths.</p></header><div class="options__lanes"><div class="options__start"><i class="ph ph-car-profile" aria-hidden="true"></i>Start with the vehicle's current condition</div><article><i class="ph ph-wrench" aria-hidden="true"></i><h3>Repair</h3><p><span class="options__desktop-copy">May make sense where the fault is understood, controlled and the vehicle is otherwise in good shape.</span><span class="options__mobile-copy">For a known, manageable fault when the car is otherwise in good shape.</span></p></article><article><i class="ph ph-car" aria-hidden="true"></i><h3>Sell as-is</h3><p><span class="options__desktop-copy">May make sense where the car still has practical next-use value and you do not want to arrange repairs.</span><span class="options__mobile-copy">For a car with practical next-use value that you do not want to repair.</span></p></article><article><i class="ph ph-recycle" aria-hidden="true"></i><h3>Scrap</h3><p><span class="options__desktop-copy">May make sense for an end-of-life vehicle with major or multiple issues.</span><span class="options__mobile-copy">For an end-of-life vehicle with major or multiple issues.</span></p></article></div><div class="section-cta"><SectionActionButton href="/free-quote" label="Compare my options" intent="valuation" /></div><p class="options__link"><a href="/scrap-my-car/">Learn more about the complete scrap-car process <span aria-hidden="true">&rarr;</span></a></p></div></section>

    <section class="section details" aria-labelledby="details-title"><div class="smc-container details__layout"><div><h2 id="details-title">Practical details that can affect <span>the next step.</span></h2><p>Share what you know. Requirements and processes can differ by emirate and final transaction route.</p></div><div class="details__list"><article><i class="ph ph-identification-card" aria-hidden="true"></i><p><b>Registration / Mulkiya</b>Keep the vehicle details available for the discussion.</p></article><article><i class="ph ph-bank" aria-hidden="true"></i><p><b>Finance, fines or restrictions</b>These may require attention before a transaction is completed.</p></article><article><i class="ph ph-map-pin" aria-hidden="true"></i><p><b>Location and accessibility</b>Tell us the emirate, access situation and whether the car can move.</p></article><article><i class="ph ph-key" aria-hidden="true"></i><p><b>Plates and vehicle status</b>Confirm current authority guidance for the route that applies to your vehicle.</p></article></div></div></section>

    <section class="section makes" aria-labelledby="makes-title"><div class="smc-container"><header class="section-heading"><h2 id="makes-title">Scrap-car valuations across <span>popular makes.</span></h2><p>Make and model are only part of the valuation. Condition, mechanical state and usable parts in the individual vehicle still matter.</p></header><MakeLogoRail makes={popularMakes} /></div></section>

    <section class="section coverage" aria-labelledby="coverage-title"><div class="smc-container coverage__layout"><header><h2 id="coverage-title">UAE collection, with the details <span>that matter.</span></h2><p>Share the exact vehicle location and access details with the valuation request. Coverage can be discussed across the priority locations below without turning a valuation into a generic location list.</p></header><div class="coverage__panel"><div class="coverage__locations" aria-label="Priority UAE coverage locations">{priorityCoverageLocations.map((location) => <span><i class="ph ph-map-pin" aria-hidden="true"></i>{location}</span>)}</div><p><i class="ph ph-truck" aria-hidden="true"></i>Tell us whether the car moves, its parking level and whether a recovery vehicle can reach it.</p></div></div></section>

    {helpfulPosts.length > 0 && <section class="section section--soft guides" aria-labelledby="guides-title"><div class="smc-container"><header class="section-heading"><h2 id="guides-title">Useful guides before your <span>next decision.</span></h2><p>Read relevant Wix blog guides, then request a valuation when you are ready.</p></header><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div><div class="section-cta"><SectionActionButton href="/blogs" label="View all blogs" intent="blogs" /></div></div></section>}

    <section class="section faqs" aria-labelledby="faq-title"><div class="smc-container"><header class="section-heading"><h2 id="faq-title">Scrap-car value FAQs</h2><p>Clear answers before you decide whether to repair, sell or scrap a vehicle.</p></header><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><div class="section-cta"><SectionActionButton href="/faqs" label="Browse all FAQs" intent="faqs" /></div></div></section>
    <section class="final-cta"><div class="smc-container final-cta__inner"><div><h2>Find out what your car is worth before deciding what to do next.</h2><p>Share the vehicle details and current condition to start with a free valuation.</p></div><div><SectionActionButton href="/free-quote" label="Get my free scrap-car valuation" intent="valuation" /><a href="/scrap-my-car/">Learn about scrapping your car <span aria-hidden="true">&rarr;</span></a></div></div></section>
  </main>
  <script is:inline>
    const factorButtons = [...document.querySelectorAll('[data-factor]')];
    const factorPanels = [...document.querySelectorAll('[data-factor-panel]')];
    const factorSelector = document.querySelector('.factor-selector');
    const factorMobileQuery = window.matchMedia('(max-width: 800px)');
    const syncFactorOrientation = () => factorSelector?.setAttribute('aria-orientation', factorMobileQuery.matches ? 'horizontal' : 'vertical');
    syncFactorOrientation();
    factorMobileQuery.addEventListener('change', syncFactorOrientation);
    const setFactor = (button, moveFocus = false) => {
      const key = button.dataset.factor;
      factorButtons.forEach((button) => {
        const isActive = button.dataset.factor === key;
        button.setAttribute('aria-selected', String(isActive));
        button.tabIndex = isActive ? 0 : -1;
        button.classList.toggle('active', isActive);
      });
      factorPanels.forEach((panel) => { panel.hidden = panel.dataset.factorPanel !== key; });
      if (factorSelector && factorMobileQuery.matches) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const left = factorSelector.scrollLeft + button.getBoundingClientRect().left - factorSelector.getBoundingClientRect().left - ((factorSelector.clientWidth - button.clientWidth) / 2);
        factorSelector.scrollTo({ left, behavior: reducedMotion ? 'auto' : 'smooth' });
      }
      if (moveFocus) button.focus({ preventScroll: true });
    };
    factorButtons.forEach((button, index) => {
      button.addEventListener('click', () => setFactor(button));
      button.addEventListener('keydown', (event) => {
        const nextKeys = ['ArrowRight', 'ArrowDown'];
        const previousKeys = ['ArrowLeft', 'ArrowUp'];
        const direction = nextKeys.includes(event.key) ? 1 : previousKeys.includes(event.key) ? -1 : 0;
        if (!direction && !['Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? factorButtons.length - 1 : (index + direction + factorButtons.length) % factorButtons.length;
        setFactor(factorButtons[nextIndex], true);
      });
    });

    const conditionTabs = [...document.querySelectorAll('[data-condition-tab]')];
    const conditionPanels = [...document.querySelectorAll('[data-condition-panel]')];
    const setCondition = (button, moveFocus = false) => {
      const key = button.dataset.conditionTab;
      conditionTabs.forEach((tab) => {
        const isActive = tab === button;
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });
      conditionPanels.forEach((panel) => { panel.hidden = panel.dataset.conditionPanel !== key; });
      button.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      if (moveFocus) button.focus();
    };
    conditionTabs.forEach((button, index) => {
      button.addEventListener('click', () => setCondition(button));
      button.addEventListener('keydown', (event) => {
        const direction = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!direction && !['Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? conditionTabs.length - 1 : (index + direction + conditionTabs.length) % conditionTabs.length;
        setCondition(conditionTabs[nextIndex], true);
      });
    });
  </script>
</BaseLayout>

<style>
  .value-page{overflow:hidden;color:#17331d}
  .value-hero{padding:22px 0 clamp(56px,7vw,94px);background:radial-gradient(circle at 9% 25%,rgba(75,151,81,.14),transparent 25%),linear-gradient(145deg,#fbfdfb,#edf6eb 60%,#f7fbfd)}
  .breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;color:#667266;font-size:13px}
  .breadcrumb a{color:#315d37;text-decoration:none}
  .value-hero__grid{display:grid;grid-template-areas:'copy form' 'trust form';grid-template-columns:minmax(0,1.08fr) minmax(400px,.78fr);gap:22px clamp(46px,7vw,96px);margin-top:32px}
  .value-hero__copy{grid-area:copy;align-self:end;max-width:660px}
  .value-hero h1{max-width:10ch;margin:0;font-size:clamp(3.2rem,4.8vw,5rem);line-height:.94;letter-spacing:-.067em}
  .value-hero h1 span,.section-heading h2 span,.difference h2 span,.details h2 span,.coverage h2 span{color:#398b41}
  .value-hero__copy p{max-width:570px;margin:21px 0 0;color:#536453;font-size:18px;line-height:1.65}
  .value-hero__form{grid-area:form;filter:drop-shadow(0 18px 28px rgba(29,76,35,.1))}
  .hero-trust{grid-area:trust;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 18px;margin:0;padding:0;list-style:none}
  .hero-trust li{display:flex;align-items:center;gap:8px;color:#315637;font-size:14px;font-weight:750}
  .hero-trust i,.difference li i{display:grid;width:21px;height:21px;place-items:center;border-radius:50%;background:#2f7d37;color:#fff;font-size:13px}
  .section{padding:clamp(66px,8vw,108px) 0}
  .section--soft{background:#f5f9f4}
  .section-heading{max-width:770px;margin:0 auto 36px;text-align:center}
  .section-heading h2,.difference h2,.details h2,.coverage h2,.final-cta h2{margin:0;font-size:clamp(2.35rem,4vw,3.75rem);line-height:1.04;letter-spacing:-.06em}
  .section-heading p{margin:16px auto 0;color:#5b6a5c;line-height:1.7}
  .eyebrow{margin:0;color:#397c3e;font-size:11px;font-weight:850;letter-spacing:.11em;text-transform:uppercase}
  .composition{position:relative;background:linear-gradient(180deg,#fff,#f7fbf6)}
  .composition::before{position:absolute;inset:0;opacity:.3;background-image:linear-gradient(rgba(55,125,62,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(55,125,62,.05) 1px,transparent 1px);background-size:38px 38px;content:'';mask-image:linear-gradient(90deg,transparent,#000 20%,#000 80%,transparent)}
  .composition .smc-container{position:relative}
  .composition__layout{display:grid;grid-template-columns:minmax(270px,.72fr) minmax(0,1.28fr);gap:clamp(24px,5vw,64px);align-items:stretch;max-width:1080px;margin-inline:auto}
  .factor-selector{display:grid;align-content:start;border:1px solid #d5e4d2;border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 18px 45px rgba(24,70,31,.08)}
  .factor-selector button{display:grid;grid-template-columns:34px 1fr 20px;gap:12px;align-items:center;min-height:61px;padding:11px 17px;border:0;border-bottom:1px solid #e2ebe0;background:#fff;color:#38573d;font:inherit;font-size:14px;font-weight:800;text-align:left;cursor:pointer;transition:background .18s ease,color .18s ease}
  .factor-selector button:last-child{border-bottom:0}
  .factor-selector button>i:first-child{display:grid;width:34px;height:34px;place-items:center;border-radius:9px;background:#edf5eb;color:#2f7438;font-size:18px}
  .factor-selector__label-short{display:none}
  .factor-selector__arrow{justify-self:end;color:#729077;font-size:15px}
  .factor-selector button:hover{background:#f3f8f1}
  .factor-selector button.active{background:#194f25;color:#fff}
  .factor-selector button.active>i:first-child{background:rgba(255,255,255,.14);color:#fff}
  .factor-selector button.active .factor-selector__arrow{color:#bfe0b9}
  .factor-panel{display:grid;min-height:426px;padding:clamp(28px,5vw,52px);border:1px solid #d5e4d2;border-radius:18px;background:linear-gradient(145deg,#fff,#f2f8f0);box-shadow:0 18px 45px rgba(24,70,31,.08)}
  .factor-panel article{align-self:center}
  .factor-panel__icon{display:grid;width:58px;height:58px;place-items:center;margin-bottom:19px;border-radius:15px;background:#dff0dc;color:#226b30;font-size:28px}
  .factor-panel h3{margin:9px 0 12px;font-size:clamp(1.75rem,3vw,2.45rem);letter-spacing:-.05em}
