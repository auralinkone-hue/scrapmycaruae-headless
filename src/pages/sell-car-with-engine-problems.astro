---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import LocationCoverageList from '../components/LocationCoverageList.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import ServicePageMotion from '../components/ServicePageMotion.astro';
import { getLatestPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';

const title = 'Sell Car With Engine Problems UAE | Free Valuation';
const description = 'Sell a car with engine problems in the UAE. Request a free valuation before spending more on major engine repairs and discuss vehicle collection.';

const engineProblems = [
  ['ph-thermometer-hot', 'Overheating', 'Cooling-system or temperature issues can be included in the valuation request.'],
  ['ph-wave-sine', 'Engine knocking', 'Share any knocking, tapping or unusual engine noise you have noticed.'],
  ['ph-drop', 'Oil leaks', 'Known oil leaks or low-oil warnings provide useful condition context.'],
  ['ph-gauge', 'Loss of power', 'Poor acceleration, misfiring or reduced power can be explained after the form.'],
  ['ph-warning-circle', 'Warning lights', 'Dashboard engine warnings or fault codes can be mentioned to the team.'],
  ['ph-cloud-fog', 'Smoking engine', 'Tell us if there is smoke, an unusual smell or visible exhaust concern.'],
  ['ph-link-break', 'Timing or chain problems', 'Timing-chain, belt or related engine concerns can be reviewed as known faults.'],
  ['ph-engine', 'Engine failure', 'A serious engine fault does not stop you from requesting a valuation.'],
  ['ph-power', 'Non-running engine', 'A vehicle that will not start can still be assessed in its current condition.']
];

const symptoms = [
  ['ph-ear', 'Unusual noises', 'Knocking, ticking, grinding or a sudden change in engine sound.'],
  ['ph-drop-half-bottom', 'Fluid or smoke signs', 'Oil loss, coolant loss, smoke or a burning smell around the vehicle.'],
  ['ph-gauge', 'Performance changes', 'Misfires, rough idle, stalling, power loss or difficulty starting.'],
  ['ph-warning-octagon', 'Warning messages', 'A check-engine light, temperature warning or previous diagnosis.']
];

const factors = [
  ['ph-car-profile', 'Vehicle details', 'Make, model, year and mileage help establish current demand.'],
  ['ph-engine', 'Fault severity', 'Known symptoms, diagnosis and whether the engine starts all add context.'],
  ['ph-wrench', 'Overall condition', 'Body condition, tyres, interior and other mechanical issues can affect the review.'],
  ['ph-map-pin', 'Location & access', 'Vehicle location and recovery access help with a practical collection discussion.']
];

const faqs = [
  ['Can I sell a car with engine problems in the UAE?', 'Yes. Select the make, model and year, then explain the known engine symptoms when the conversation continues with the team.'],
  ['Do I need to repair an engine problem before requesting a valuation?', 'No. A valuation lets you compare the likely repair cost with the practical value of the vehicle as it is.'],
  ['Can you consider a car with an engine warning light or overheating issue?', 'Yes. Mention the warning light, overheating history or any diagnosis you have received. The vehicle can be reviewed with that context.'],
  ['Can I request a valuation if the engine does not start?', 'Yes. A non-starting vehicle can still be considered. Include the known issue and the vehicle location so collection can be discussed.'],
  ['What affects the valuation of a car with engine failure?', 'Vehicle details, mileage, overall condition, the known engine fault, location and recovery access can all affect the discussion.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
try { helpfulPosts = await getLatestPosts({}); } catch { helpfulPosts = []; }

const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Sell My Car', item: 'https://www.scrapmycaruae.com/sell-my-car/' },
  { '@type': 'ListItem', position: 3, name: 'Sell Car With Engine Problems', item: 'https://www.scrapmycaruae.com/sell-car-with-engine-problems/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/sell-car-with-engine-problems/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="engine-page" data-service-motion>
    <section class="engine-hero" aria-labelledby="engine-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/sell-my-car/">Sell My Car</a><span aria-hidden="true">›</span><span aria-current="page">Engine problems</span></nav><div class="engine-hero__grid"><div class="engine-hero__copy"><h1 id="engine-title">Sell your car with <span>engine problems.</span></h1><p>Get a valuation before paying for major repairs. Share the make, model and year, then explain the engine issue directly with the team.</p></div><div class="engine-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="trust-points" aria-label="Engine problem valuation benefits"><li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li><li><i class="ph ph-check" aria-hidden="true"></i>No major repair required first</li><li><i class="ph ph-check" aria-hidden="true"></i>UAE collection discussion</li></ul></div></div></section>

    <section class="section engine-problems" aria-labelledby="problems-title"><div class="smc-container"><div class="section-heading"><h2 id="problems-title">Engine problems <span class="heading-accent">we consider.</span></h2><p>You do not need a full diagnosis before starting. Tell us what you know about the engine and the vehicle can be reviewed as it is.</p></div><div class="engine-issue-grid">{engineProblems.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><h3>{heading}</h3><p>{copy}</p></article>)}</div><div class="section-cta"><SectionActionButton href="/free-quote" label="Request an engine-problem valuation" intent="valuation" /></div></div></section>

    <section class="section symptoms-section" aria-labelledby="symptoms-title"><div class="smc-container symptoms-layout"><div class="symptoms-intro"><h2 id="symptoms-title">Common engine fault <span class="heading-accent">symptoms.</span></h2><p>Use everyday signs rather than technical terms. A clear description helps the team understand whether selling as-is may make more sense than further investigation.</p><SectionActionButton href="/free-quote" label="Tell us about the issue" intent="valuation" /></div><div class="symptom-list">{symptoms.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section repair-section" aria-labelledby="repair-title"><div class="smc-container"><div class="section-heading"><h2 id="repair-title">Repair it or sell it <span class="heading-accent">as-is?</span></h2><p>Compare the likely repair spend with the vehicle’s current value before approving diagnostics, parts or a major engine rebuild.</p></div><div class="repair-decision"><article><div class="repair-route__top"><i class="ph ph-wrench" aria-hidden="true"></i><span>Repair first</span></div><h3>Best when:</h3><ul><li><i class="ph ph-check" aria-hidden="true"></i>The fault is clearly diagnosed</li><li><i class="ph ph-check" aria-hidden="true"></i>The repair cost is controlled</li><li><i class="ph ph-check" aria-hidden="true"></i>The rest of the car is in good condition</li></ul></article><div class="repair-versus" aria-hidden="true">VS</div><article class="repair-decision__sell"><div class="repair-route__top"><i class="ph ph-car-profile" aria-hidden="true"></i><span>Sell as-is</span></div><h3>Best when:</h3><ul><li><i class="ph ph-check" aria-hidden="true"></i>The fault is uncertain or worsening</li><li><i class="ph ph-check" aria-hidden="true"></i>Multiple repair jobs are involved</li><li><i class="ph ph-check" aria-hidden="true"></i>Repair cost may exceed practical value</li></ul></article></div><div class="repair-action"><p><i class="ph ph-scales" aria-hidden="true"></i>Not sure which route makes sense?</p><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div><div class="related-links"><a href="/sell-damaged-car/">Sell a damaged car <span aria-hidden="true">→</span></a><a href="/sell-non-running-car/">Sell a non-running car <span aria-hidden="true">→</span></a></div></div></section>

    <section class="section valuation" aria-labelledby="valuation-title"><div class="smc-container"><div class="section-heading"><h2 id="valuation-title">What affects an engine-problem <span class="heading-accent">valuation?</span></h2><p>Each vehicle is considered individually. These practical details provide context rather than a fixed online price.</p></div><div class="factor-list">{factors.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div><div class="section-cta"><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></div></section>

    <section class="section section--dark process" aria-labelledby="process-title"><div class="smc-container"><div class="section-heading section-heading--dark"><h2 id="process-title">A simple <span>3-step process.</span></h2></div><ol class="process-grid"><li><span>01</span><h3>Send vehicle details</h3><p>Choose the make, model and year, then provide your contact details.</p></li><li><span>02</span><h3>Explain the engine issue</h3><p>Continue on WhatsApp with symptoms, warning lights or known repair history.</p></li><li><span>03</span><h3>Discuss valuation & collection</h3><p>The team reviews the request and explains the practical next step.</p></li></ol></div></section>

    <section class="section collection" aria-labelledby="collection-title"><div class="smc-container"><div class="section-heading"><h2 id="collection-title">Engine-problem collection <span class="heading-accent">across the UAE.</span></h2><p>Tell the team where the vehicle is and whether it starts or moves. Collection feasibility can then be discussed using the known engine condition and access.</p></div><LocationCoverageList /></div></section>

    {helpfulPosts.length > 0 && <section class="section section--soft guides" aria-labelledby="guides-title"><div class="smc-container"><div class="section-heading"><h2 id="guides-title">Helpful guides before <span class="heading-accent">your next step.</span></h2><p>Read relevant existing Wix blog guides, then request a valuation when you are ready.</p></div><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div><div class="section-cta"><SectionActionButton href="/blogs" label="View all blogs" intent="blogs" /></div></div></section>}

    <section class="section engine-faq" aria-labelledby="faq-title"><div class="smc-container"><div class="section-heading"><h2 id="faq-title">Engine-problem FAQs</h2><p>Answers to common questions about selling a car with a known engine concern in the UAE.</p></div><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><div class="section-cta"><SectionActionButton href="/faqs" label="Browse all FAQs" intent="faqs" /></div></div></section>
    <section class="final-valuation"><div class="smc-container final-valuation__inner"><div><h2>Start with the vehicle as it is.</h2><p>Get a free valuation before spending more on major engine repairs. Share the vehicle details and explain the symptoms when the conversation continues.</p></div><a class="smc-button" href="/free-quote" data-analytics-quote-cta="sell_engine_problems_final">Get my free valuation <i class="ph ph-calculator" aria-hidden="true"></i></a></div></section>
  </main>
  <ServicePageMotion />
</BaseLayout>

<style>
  .engine-page{overflow:hidden;color:#17331d}.engine-hero{padding:22px 0 clamp(52px,6vw,76px);border-bottom:1px solid #dce6d9;background:linear-gradient(180deg,#fcfdfb,#f4f8f2)}.breadcrumb{display:flex;flex-wrap:wrap;gap:8px;align-items:center;color:#687268;font-size:13px}.breadcrumb a{color:#315d37;text-decoration:none}.engine-hero__grid{display:grid;grid-template-areas:'copy form' 'trust form';grid-template-columns:minmax(0,1.16fr) minmax(400px,.74fr);column-gap:clamp(44px,6vw,84px);row-gap:20px;margin-top:28px}.engine-hero__copy{grid-area:copy;max-width:650px;align-self:end}.engine-hero h1{margin:0;font-size:clamp(3rem,4.1vw,4.5rem);font-weight:700;line-height:1;letter-spacing:-.055em}.engine-hero h1 span{display:block;color:#3c8e2f}.engine-hero__copy p{margin:22px 0 0;color:#5c685d;font-size:18px;line-height:1.6}.engine-hero__form{grid-area:form;filter:drop-shadow(0 16px 28px rgba(31,70,36,.07))}.trust-points{grid-area:trust;display:grid;gap:9px;align-self:end;margin:0;padding:0;list-style:none}.trust-points li{display:flex;gap:9px;align-items:center;color:#2a472f;font-size:14px;font-weight:650}.trust-points i,.repair-decision li i{display:grid;width:22px;height:22px;place-items:center;border-radius:50%;background:#2f7d32;color:#fff;font-size:14px}.section{padding:clamp(52px,4.6vw,68px) 0}.section--soft,.repair-section{background:#f6f9f4}.section--dark{background:#173d18;color:#fff}.section-heading{max-width:760px;margin:0 auto 30px;text-align:center}.section-heading h2,.symptoms-intro h2,.final-valuation h2{margin:0;color:#17331d;font-size:clamp(2.1rem,4vw,3.3rem);line-height:1.06;letter-spacing:-.05em}.section-heading p{margin:15px auto 0;color:#5c685d;line-height:1.7}.heading-accent{color:#3c8e2f}.section-heading--dark h2{color:#fff}.section-heading--dark h2 span{color:#bce3ae}.section-cta{display:flex;justify-content:center;margin-top:26px}.engine-issue-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.engine-issue-grid article{min-height:172px;padding:22px;border:1px solid #d9e5d7;border-radius:18px;background:linear-gradient(145deg,#fff,#f2f8ef);transition:transform 160ms ease,border-color 160ms ease,box-shadow 160ms ease}.engine-issue-grid article:nth-child(3n+2){background:linear-gradient(145deg,#fff,#f7fbf5)}.engine-issue-grid article:hover{border-color:#8ebc8a;box-shadow:0 15px 28px rgba(42,102,51,.1);transform:translateY(-3px)}.engine-issue-grid i,.factor-list>article>i{display:grid;width:40px;height:40px;place-items:center;border-radius:12px;background:#e5f2e2;color:#32753a;font-size:20px}.engine-issue-grid h3{margin:16px 0 7px;font-size:18px;letter-spacing:-.025em}.engine-issue-grid p,.factor-list p{margin:0;color:#647064;font-size:14px;line-height:1.65}.symptoms-layout{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(34px,7vw,82px);align-items:center}.symptoms-intro p{margin:18px 0 24px;color:#5c685d;line-height:1.7}.symptom-list{border-top:1px solid #dce6d9}.symptom-list article,.factor-list article{display:grid;grid-template-columns:42px 1fr;gap:14px;padding:20px 0;border-bottom:1px solid #dce6d9}.symptom-list i{display:grid;width:38px;height:38px;place-items:center;border-radius:11px;background:#eef6eb;color:#32753a;font-size:19px}.symptom-list h3,.factor-list h3{margin:2px 0 6px;font-size:18px}.symptom-list p{margin:0;color:#647064;font-size:14px;line-height:1.65}.repair-section{background:radial-gradient(circle at 50% 8%,rgba(119,190,101,.12),transparent 30%),linear-gradient(180deg,#f8fbf6,#eef6eb)}.repair-decision{display:grid;grid-template-columns:minmax(0,1fr) 68px minmax(0,1fr);align-items:center;max-width:1040px;margin:0 auto}.repair-decision>article{position:relative;overflow:hidden;min-height:258px;padding:clamp(26px,3vw,34px);border:1px solid #cde0ca;border-radius:20px;background:rgba(255,255,255,.82)}.repair-decision__sell{border-color:#a7caa4!important;background:linear-gradient(145deg,rgba(234,247,230,.92),rgba(255,255,255,.94))!important}.repair-route__top{display:flex;gap:11px;align-items:center;color:#286633;font-size:13px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}.repair-route__top i{display:grid;width:42px;height:42px;place-items:center;border-radius:13px;background:#286633;color:#fff;font-size:20px}.repair-decision h3{margin:24px 0 16px;font-size:clamp(1.28rem,2vw,1.55rem);letter-spacing:-.035em}.repair-decision ul{display:grid;gap:11px;margin:0;padding:0;list-style:none}.repair-decision li{display:flex;gap:10px;align-items:flex-start;color:#29442e;font-size:14px;font-weight:700;line-height:1.45}.repair-versus{display:grid;place-items:center;width:43px;height:43px;margin:auto;border:1px solid #bad3b7;border-radius:50%;background:#f7fbf5;color:#286633;font-size:11px;font-weight:900;letter-spacing:.07em}.repair-action{display:flex;align-items:center;justify-content:space-between;gap:22px;max-width:840px;margin:20px auto 0;padding:16px 18px 16px 20px;border:1px solid #d0e1cd;border-radius:17px;background:rgba(255,255,255,.72)}.repair-action p{display:flex;gap:11px;align-items:center;margin:0;color:#29442e;font-weight:800}.repair-action p i{display:grid;width:36px;height:36px;place-items:center;border-radius:11px;background:#e6f3e3;color:#286633;font-size:19px}.related-links{display:flex;justify-content:center;flex-wrap:wrap;gap:12px 22px;margin-top:17px}.related-links a{color:#1769aa;font-size:14px;font-weight:700;text-decoration:none}.related-links a:hover{text-decoration:underline}.factor-list{max-width:920px;margin:auto}.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:0;padding:0;list-style:none}.process-grid li{padding:28px;border-top:1px solid rgba(188,227,174,.34)}.process-grid span{color:#bce3ae;font-size:11px;font-weight:800;letter-spacing:.06em}.process-grid h3{margin:17px 0 9px;font-size:23px;letter-spacing:-.035em}.process-grid p{margin:0;color:#c9d7c5;line-height:1.65}.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.faq-stack{max-width:980px;margin:auto}.faq-stack details{border-bottom:1px solid #dce6d9}.faq-stack details:first-child{border-top:1px solid #dce6d9}.faq-stack summary{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:70px;padding:16px 0;list-style:none;cursor:pointer;font-size:17px;font-weight:700}.faq-stack summary::-webkit-details-marker{display:none}.faq-stack summary i{display:grid;width:28px;height:28px;place-items:center;border:1px solid #d7e3d4;border-radius:50%;color:#286633;transition:transform 160ms ease}.faq-stack details[open] summary i{transform:rotate(45deg)}.faq-stack details p{margin:-3px 0 22px;color:#5c685d;line-height:1.7}.final-valuation{padding:64px 0;background:radial-gradient(circle at 78% 30%,rgba(117,203,82,.15),transparent 27%),#163d18;color:#fff}.final-valuation__inner{display:flex;align-items:center;justify-content:space-between;gap:34px}.final-valuation h2{color:#fff}.final-valuation p{max-width:720px;margin:13px 0 0;color:#c9d7c5}.final-valuation .smc-button{flex:0 0 auto;min-height:50px;background:#fff;color:#174020}
  @media(min-width:981px){.engine-hero__copy{align-self:end}}
  @media(max-width:980px){.engine-hero__copy{align-self:auto}}
  @media(max-width:980px){.engine-hero__grid{grid-template-areas:'copy' 'form' 'trust';grid-template-columns:1fr}.engine-hero__copy{align-self:auto}.engine-hero__form{width:min(100%,650px)}.engine-issue-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.symptoms-layout{grid-template-columns:1fr}.guide-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.repair-action{align-items:flex-start;flex-direction:column}}
  @media(max-width:700px){.engine-hero{padding-top:16px}.engine-hero__grid{gap:18px;margin-top:23px;justify-items:center}.engine-hero__copy{width:100%;max-width:390px;text-align:center}.engine-hero h1{max-width:12ch;margin-inline:auto;font-size:clamp(2.65rem,12vw,3.6rem);line-height:.96;letter-spacing:-.045em}.engine-hero__copy p{max-width:31ch;margin:14px auto 0;font-size:15px;line-height:1.5}.engine-hero__form{width:100%}.trust-points{width:min(100%,390px);justify-self:center}.section{padding:clamp(50px,13vw,58px) 0}.section-heading{margin-bottom:25px}.section-heading h2,.symptoms-intro h2,.final-valuation h2{font-size:clamp(2rem,9vw,2.6rem)}.engine-issue-grid,.guide-grid{grid-template-columns:1fr}.engine-issue-grid article{min-height:0;padding:22px}.repair-decision{grid-template-columns:1fr;gap:13px}.repair-decision>article{min-height:0;padding:25px}.repair-versus{width:38px;height:38px;font-size:10px}.repair-action{align-items:center;padding:18px}.repair-action .section-action{width:fit-content;align-self:center;justify-content:center;padding-inline:20px}.related-links{display:grid;gap:11px;text-align:center}.process-grid{grid-template-columns:1fr;gap:17px}.process-grid li{padding:24px;border:1px solid rgba(188,227,174,.34);border-radius:18px;background:rgba(255,255,255,.065)}.guide-grid{display:grid;grid-auto-columns:minmax(272px,82vw);grid-auto-flow:column;grid-template-columns:none;gap:14px;overflow-x:auto;overscroll-behavior-x:contain;padding:2px 4px 16px;scroll-behavior:smooth;scroll-snap-type:x mandatory;scrollbar-width:thin}.guide-grid>*{min-width:0;scroll-snap-align:start}.final-valuation{padding:58px 0}.final-valuation__inner{flex-direction:column;align-items:flex-start}.final-valuation .smc-button{width:100%}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}}
</style>
