---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import { getVehicleData } from '../lib/vehicle-data';
import { getRelevantPosts } from '../lib/related-posts';
import { priorityCoverageLocations } from '../lib/locations';

const title = 'Sell Car With Expired Registration UAE | Free Valuation';
const description = 'Sell a car with expired registration in the UAE. Share the vehicle condition, registration status and location to request a free valuation and discuss the next steps.';
const detailsNeeded = [
  ['ph-calendar-blank', 'How long has it been expired?', 'Share the expiry date from the Mulkiya if available, or explain approximately how long the registration has been expired.'],
  ['ph-car-profile', 'Current vehicle condition', 'Describe body wear, accident damage, missing parts and any known mechanical or electrical faults.'],
  ['ph-engine', 'Does it start and move?', 'Tell us whether it starts, drives or rolls, and how long it has been parked.'],
  ['ph-identification-card', 'Ownership / finance status', 'Have the registered-owner details ready and mention any active finance, mortgage or uncertainty about authority to sell.'],
  ['ph-file-text', 'Fines or restrictions', 'Mention known fines, blocks or restrictions. The relevant authority confirms what needs to be resolved.'],
  ['ph-map-pin', 'Vehicle location', 'Share the emirate, area, parking level and whether the vehicle can be reached for a collection discussion.']
];
const comparisons = [
  { icon: 'ph-calendar-blank', label: 'Expired registration', category: 'Registration status', copy: 'Describes the vehicle’s registration record. It does not tell us whether the engine works or the body is damaged.', href: '/sell-my-car/', link: 'Explore selling your car' },
  { icon: 'ph-engine', label: 'Non-running car', category: 'Mechanical / mobility state', copy: 'Describes a car that does not start or move. It may have valid or expired registration; both details should be shared.', href: '/sell-non-running-car/', link: 'Non-running car guidance' },
  { icon: 'ph-warning-circle', label: 'Damaged car', category: 'Physical condition', copy: 'Describes accident, body or other damage. Condition and registration status need to be considered together.', href: '/sell-damaged-car/', link: 'Damaged car guidance' }
];
const valuationSteps = [
  ['ph-car-profile', 'Start with vehicle details', 'Use the valuation form for the make, model, year and contact details.'],
  ['ph-chats-circle', 'Explain condition & status', 'Continue with the expiry date, known faults, ownership or finance questions and location.'],
  ['ph-scales', 'Discuss value & next steps', 'Review the car in its current condition. Any transaction or collection remains subject to the relevant checks.']
];
const paperwork = [
  ['ph-identification-card', 'Mulkiya & registered owner', 'Keep the available registration details and expiry date to hand. Tell us if the registered owner is someone else or documents are missing. Confirm the authority and evidence needed for the intended transaction.'],
  ['ph-bank', 'Finance / mortgage', 'Disclose active finance or a mortgage at the start. Confirm any required settlement or release with the lender and registration authority before an ownership change is completed.'],
  ['ph-file-text', 'Fines, blocks & restrictions', 'Check the vehicle record with the relevant authority. Outstanding fines or restrictions may affect the next steps; this page does not calculate penalties or promise they can be bypassed.'],
  ['ph-key', 'Plates, transfer & cancellation', 'Ask the relevant authority which process applies to the agreed route and what to do with the plates. An expired registration, a valuation or physical collection does not by itself confirm that ownership has changed or registration has been cancelled.']
];
const faqs = [
  ['Can I request a valuation if my Mulkiya has expired?', 'Yes. Share the make, model, year, current condition and registration status to start a valuation discussion. Requesting a valuation does not mean the vehicle is automatically eligible for a sale, transfer or cancellation.'],
  ['Can a car with expired registration always be sold or transferred?', 'No blanket approval is given here. The available route depends on the registered owner, vehicle record, finance, fines or restrictions and current requirements of the relevant registration authority.'],
  ['Do I have to renew the registration before requesting a valuation?', 'You can request a valuation with the current status disclosed. Whether renewal, inspection or another authority process is needed for the intended transaction must be confirmed for the individual vehicle and route.'],
  ['Does expired registration mean the car has no value?', 'No. Registration status is one part of the discussion. Make, model, year, current condition, whether it runs and practical demand also provide context for a valuation.'],
  ['What if the registration expired a long time ago?', 'Share the expiry date if available and explain how long the car has been parked. The current authority record, condition, known fines or restrictions and access need to be reviewed; no fixed outcome is promised based on the time elapsed.'],
  ['Can I ask for a valuation if there is outstanding finance or a fine?', 'You can explain these issues with the request. An active mortgage, fines or restrictions may need to be addressed before the agreed transaction can proceed. Confirm the requirements with the lender and relevant authority.'],
  ['What if the car is also damaged or non-running?', 'Share both the registration status and the vehicle condition. Explain the known damage or fault, whether it starts and rolls, and where it is parked so the review covers the whole situation.'],
  ['Can the vehicle be collected instead of being driven?', 'Collection can be discussed after the condition, location, access and vehicle status are reviewed. Do not assume that a car starting means it may be driven on public roads; confirm registration, insurance and any movement requirements with the relevant authority.'],
  ['Does collection cancel the registration or transfer ownership?', 'No. Physical collection is not confirmation of an ownership change or registration cancellation. Confirm the separate authority steps, documents and plate handling for the agreed route.'],
  ['How much will it be worth, and how long will the process take?', 'There is no fixed price, timing or approval guarantee on this page. The vehicle details and current status need to be reviewed before the valuation and practical next steps can be discussed.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];
await Promise.all([
  (async () => { try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); } })(),
  (async () => { try { helpfulPosts = await getRelevantPosts({ _id: 'expired-registration-guide', slug: 'sell-car-with-expired-registration' }, ['registration', 'mulkiya', 'paperwork', 'ownership', 'selling a car', 'sell your car', 'non-running', 'vehicle collection']); } catch { helpfulPosts = []; } })()
]);
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Sell My Car', item: 'https://www.scrapmycaruae.com/sell-my-car/' },
  { '@type': 'ListItem', position: 3, name: 'Expired Registration', item: 'https://www.scrapmycaruae.com/sell-car-with-expired-registration/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/sell-car-with-expired-registration/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <main class="expired-page">
    <section class="expired-hero" aria-labelledby="expired-title"><div class="smc-container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/sell-my-car/">Sell My Car</a><span aria-hidden="true">›</span><span aria-current="page">Expired registration</span></nav>
      <div class="expired-hero__grid">
        <div class="expired-hero__copy"><p class="eyebrow"><i class="ph ph-calendar-blank" aria-hidden="true"></i> A clearer next step for your vehicle</p><h1 id="expired-title">Sell a car with <span>expired registration</span> in the UAE</h1><p class="hero-lead">An expired registration does not automatically mean the car has no value. Share the vehicle details, current condition and registration status to request a valuation.</p></div>
        <div class="expired-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /><p class="form-note"><i class="ph ph-chats-circle" aria-hidden="true"></i>Share the registration status, condition and location when the conversation continues.</p></div>
        <ul class="hero-trust"><li><i class="ph ph-check" aria-hidden="true"></i>Free valuation request</li><li><i class="ph ph-check" aria-hidden="true"></i>Current condition considered</li><li><i class="ph ph-check" aria-hidden="true"></i>Vehicle status reviewed</li></ul>
      </div>
    </div></section>

    <section class="section changes-section" aria-labelledby="changes-title"><div class="smc-container changes-layout">
      <header><p class="eyebrow">Two questions, considered separately</p><h2 id="changes-title">What expired <span>registration changes</span></h2><p>It adds a registration-status question to the discussion. It does not describe the engine, the body condition or everything that may still be usable.</p><p>A valuation starts with the vehicle you have. Completing a transaction is a separate step, with the relevant ownership and authority checks.</p><a class="text-link" href="/sell-my-car/"><i class="ph ph-car-profile" aria-hidden="true"></i>Explore selling your car</a></header>
      <div class="status-explainer"><div class="status-explainer__heading"><span class="status-symbol"><i class="ph ph-calendar-blank" aria-hidden="true"></i></span><div><p class="eyebrow">Expired registration</p><h3>Start with the current picture.</h3></div></div><div class="review-lane"><i class="ph ph-calculator" aria-hidden="true"></i><div><h4>Request a valuation</h4><p>Vehicle details, actual condition and known status.</p></div><span>Discuss</span></div><div class="review-lane review-lane--checks"><i class="ph ph-file-text" aria-hidden="true"></i><div><h4>Confirm the transaction route</h4><p>Ownership, finance, restrictions and authority requirements.</p></div><span>Check</span></div><p class="explainer-note"><i class="ph ph-info" aria-hidden="true"></i>A valuation is not a transfer approval.</p></div>
    </div></section>

    <section class="section briefing-section" aria-labelledby="briefing-title"><div class="smc-container">
      <header class="section-heading"><p class="eyebrow">A practical starting point</p><h2 id="briefing-title">What we need <span>to know</span></h2><p>Have these details ready for the follow-up discussion. Share what you know and flag anything uncertain.</p></header>
      <div class="briefing-sheet"><div class="briefing-sheet__bar"><i class="ph ph-list-checks" aria-hidden="true"></i><span>Your vehicle briefing</span><small>Condition + status + location</small></div><ul class="briefing-list">{detailsNeeded.map(([icon, heading, copy]) => <li><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></li>)}</ul></div>
    </div></section>

    <section class="section comparison-section" aria-labelledby="comparison-title"><div class="smc-container">
      <header class="section-heading"><p class="eyebrow">Different details. The same vehicle.</p><h2 id="comparison-title">Expired registration, <span>non-running or damaged?</span></h2><p>These descriptions can overlap. Tell us which apply so the request reflects the whole situation.</p></header>
      <div class="comparison-ledger">{comparisons.map((item) => <article><div class="comparison-label"><i class:list={['ph', item.icon]} aria-hidden="true"></i><div><p class="eyebrow">{item.category}</p><h3>{item.label}</h3></div></div><p>{item.copy}</p><a class="text-link" href={item.href}><i class:list={['ph', item.icon]} aria-hidden="true"></i>{item.link}</a></article>)}</div>
    </div></section>

    <section class="section valuation-section" aria-labelledby="valuation-title"><div class="smc-container valuation-layout"><header><p class="eyebrow">Start a conversation, then review</p><h2 id="valuation-title">How <span>valuation works</span></h2><p>The first request gives the team a starting point. The conversation then adds the condition, registration status and practical details.</p><SectionActionButton href="/free-quote" label="Request my car valuation" intent="valuation" /></header><ol class="valuation-steps">{valuationSteps.map(([icon, heading, copy], index) => <li><div class="valuation-step__mark"><i class:list={['ph', icon]} aria-hidden="true"></i><span>{String(index + 1).padStart(2, '0')}</span></div><div><h3>{heading}</h3><p>{copy}</p></div></li>)}</ol><p class="valuation-caveat"><i class="ph ph-info" aria-hidden="true"></i>Any sale, transfer or cancellation still needs the checks that apply to the vehicle and chosen route.</p></div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container access-layout"><div><p class="eyebrow">Plan the movement as well as the paperwork</p><h2 id="access-title">Collection & <span>access considerations</span></h2><p>Explain where the car is parked and whether it starts, rolls or steers. Mention underground parking, entry height, locked wheels and whether keys are available.</p><p>Do not assume that a car starting means it may be driven on public roads. Confirm the registration, insurance and movement requirements with the relevant authority.</p><a class="text-link" href="/car-removal/"><i class="ph ph-truck" aria-hidden="true"></i>See car-removal and access checks</a></div><figure class="access-photo"><img src="/sections/scrap-car-pickup-dubai.webp" alt="A vehicle on a green recovery truck during a collection discussion" width="1456" height="1088" loading="lazy" decoding="async" /><figcaption><i class="ph ph-truck" aria-hidden="true"></i>Collection feasibility is reviewed before arrangements are confirmed.</figcaption></figure></div></section>

    <section class="section paperwork-section" aria-labelledby="paperwork-title"><div class="smc-container paperwork-layout"><header><p class="eyebrow">The authority record matters</p><h2 id="paperwork-title">UAE paperwork <span>& status guidance</span></h2><p>Requirements can differ by emirate, vehicle record and transaction route. Confirm the current process with the relevant registration authority and, where applicable, the lender.</p><div class="authority-links"><a class="text-link" href="https://www.rta.ae/wps/portal/rta/ae/home/rta-services/service-details?serviceId=600" target="_blank" rel="noopener noreferrer"><i class="ph ph-identification-card" aria-hidden="true"></i>RTA ownership-change guidance</a><a class="text-link" href="https://www.rta.ae/wps/portal/rta/ae/home/rta-services/service-details?serviceId=525" target="_blank" rel="noopener noreferrer"><i class="ph ph-file-text" aria-hidden="true"></i>RTA registration-cancellation guidance</a></div><div class="route-note"><i class="ph ph-recycle" aria-hidden="true"></i><p>Considering a scrap route too? <a href="/scrap-my-car/">Review the complete scrap-car process</a> before deciding.</p></div></header><div class="paperwork-accordion">{paperwork.map(([icon, heading, copy], index) => <details name="registration-paperwork" open={index === 0}><summary><span><i class:list={['ph', icon]} aria-hidden="true"></i>{heading}</span><i class="ph ph-plus accordion-toggle" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container coverage-layout"><header><p class="eyebrow">Tell us where the car is</p><h2 id="coverage-title">UAE coverage</h2><p>Valuation and collection discussion across the locations below. Practical arrangements depend on the vehicle, access and status review.</p></header><ul class="coverage-list" aria-label="UAE locations">{priorityCoverageLocations.map((location) => <li><i class="ph ph-map-pin" aria-hidden="true"></i>{location}</li>)}</ul></div></section>

    <section class="section guides-section" aria-labelledby="guides-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">Read before the next step</p><h2 id="guides-title">Guides for <span>UAE vehicle owners</span></h2><p>Explore relevant vehicle-selling, paperwork and condition topics from our existing blog.</p></header>{helpfulPosts.length > 0 ? <div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div> : <p class="guides-fallback">Visit the blog for existing vehicle-selling and ownership guides.</p>}<div class="section-cta"><SectionActionButton href="/blogs" label="View all blogs" intent="blogs" /></div></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><header class="section-heading"><h2 id="faq-title">Expired-registration <span>FAQs</span></h2><p>Clear answers about the valuation request and the checks that may follow.</p></header><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus accordion-toggle" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>

    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-layout"><div><p class="eyebrow">Start with the facts you have</p><h2 id="final-title">Registration expired?<span>Request a valuation.</span></h2><p>Share the vehicle details and current condition, then discuss the registration status and practical next steps.</p></div><div class="final-actions"><SectionActionButton href="/free-quote" label="Request my free valuation" intent="valuation" /><p>Vehicle status and transaction requirements are reviewed separately.</p></div></div></section>
  </main>
</BaseLayout>

<style>
  .expired-page{color:#173b27;background:#fff}
  .expired-page :is(h1,h2,h3,p,li,a){overflow-wrap:break-word}
  .breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;color:#65746a;font-size:12px}
  .breadcrumb a{color:#315f40;text-decoration:none}
  .expired-hero{position:relative;padding:22px 0 clamp(50px,6vw,80px);border-bottom:1px solid #dbe7dd;background:radial-gradient(ellipse at 5% 40%,rgba(88,152,98,.12),transparent 50%),linear-gradient(115deg,#f8fbf6,#edf6ed 70%,#f3f8fb)}
  .expired-hero__grid{display:grid;grid-template-areas:'copy form' 'trust form';grid-template-columns:minmax(0,1.12fr) minmax(450px,.88fr);gap:23px clamp(30px,5vw,65px);margin-top:32px}
  .expired-hero__copy{grid-area:copy;align-self:end;min-width:0}
  .eyebrow{display:flex;align-items:center;gap:7px;margin:0;color:#3c7b4b;font-size:10px;font-weight:850;letter-spacing:.11em;line-height:1.5;text-transform:uppercase}
  .eyebrow i{font-size:18px}
  h1{margin:16px 0 0;font-size:clamp(2.75rem,4.35vw,4.1rem);line-height:1.01;letter-spacing:-.055em}
  h1 span{color:#3d8b4c}
  .hero-lead{max-width:590px;margin:22px 0 0;color:#576c5e;font-size:17px;line-height:1.7}
  .expired-hero__form{grid-area:form;min-width:0}
  .form-note{display:flex;align-items:flex-start;gap:8px;max-width:410px;margin:16px auto 0;color:#5a7260;font-size:12px;line-height:1.6}
  .form-note>i{flex:0 0 auto;font-size:19px;color:#347342}
  .hero-trust{grid-area:trust;align-self:start;display:flex;flex-wrap:wrap;gap:10px 17px;margin:0;padding:0;list-style:none}
  .hero-trust li{display:flex;align-items:center;gap:7px;color:#365e40;font-size:12px;font-weight:750}
  .hero-trust i{display:grid;flex:0 0 19px;width:19px;height:19px;place-items:center;border-radius:50%;background:#347e45;color:#fff;font-size:11px}
  .section{padding:clamp(54px,6vw,82px) 0}
  h2{margin:13px 0 0;font-size:clamp(2.1rem,3.5vw,3.25rem);line-height:1.08;letter-spacing:-.05em}
  h2 span{color:#3c8a4b}
  h3{margin:0;font-size:18px;line-height:1.35;letter-spacing:-.025em}
  .section-heading{max-width:780px;margin:0 auto 31px;text-align:center}
  .section-heading .eyebrow{justify-content:center}
  .section-heading p:not(.eyebrow){margin:16px auto 0;color:#5b6e61;line-height:1.7}
  .changes-layout{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(30px,6vw,80px);align-items:center}
  .changes-layout header>p:not(.eyebrow){margin:18px 0 0;color:#5b6e61;line-height:1.75;font-size:15px}
  .text-link{display:inline-flex;align-items:center;gap:8px;color:#1769aa;font-size:13px;font-weight:750;line-height:1.6;text-decoration:none}
  .text-link>i{flex:0 0 auto;font-size:19px}
  .text-link:hover{text-decoration:underline;color:#114e7e}
  .changes-layout .text-link{margin-top:22px}
  .status-explainer{position:relative;isolation:isolate;padding:30px;border:1px solid #cddfce;border-radius:25px;background:radial-gradient(circle at 100% 0,#dfeecf,transparent 60%),#f2f7ed;box-shadow:0 20px 45px rgba(32,74,41,.08)}
  .status-explainer__heading{display:flex;gap:15px;align-items:center;margin-bottom:24px}
  .status-symbol{display:grid;flex:0 0 58px;width:58px;height:58px;place-items:center;border:1px solid #d5d9b7;border-radius:17px;background:#f8f0d8;color:#8a7437;font-size:29px;transform:rotate(-5deg)}
  .status-explainer__heading h3{margin-top:5px;font-size:20px}
  .review-lane{display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:12px;align-items:start;padding:20px 17px;border:1px solid #c9dfc9;border-radius:14px;background:#fff}
  .review-lane+.review-lane{margin-top:12px}
  .review-lane>i{display:grid;width:36px;height:36px;place-items:center;border-radius:50%;background:#e5f1de;color:#367d43;font-size:20px}
  .review-lane h4{margin:0;font-size:14px;line-height:1.4}
  .review-lane p{margin:6px 0 0;color:#627263;font-size:12px;line-height:1.6}
  .review-lane>span{padding:5px 8px;border-radius:6px;background:#edf6e8;color:#3a7142;font-size:9px;font-weight:850;letter-spacing:.04em;text-transform:uppercase}
  .review-lane--checks{border-color:#d1e1e9;background:#f8fbfd}
  .review-lane--checks>i,.review-lane--checks>span{background:#e6f1f8;color:#2d729a}
  .explainer-note{display:flex;gap:8px;align-items:center;margin:18px 0 0;color:#55715a;font-size:12px;font-weight:700;line-height:1.5}
  .explainer-note i{font-size:18px}
  .briefing-section{background:#f3f7f1;border-block:1px solid #e0e9dc}
  .briefing-sheet{overflow:hidden;border:1px solid #ccdcca;border-radius:19px;background:#fff;box-shadow:0 15px 36px rgba(33,69,38,.05)}
  .briefing-sheet__bar{display:flex;align-items:center;gap:10px;padding:17px 25px;background:#245535;color:#fff;font-size:14px;font-weight:800}
  .briefing-sheet__bar>i{font-size:21px;color:#c4e5af}
  .briefing-sheet__bar small{margin-left:auto;color:#c9dec7;font-size:11px;font-weight:600}
  .briefing-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0;padding:6px 26px;column-gap:34px;list-style:none}
  .briefing-list li{display:grid;grid-template-columns:42px minmax(0,1fr);gap:13px;padding:22px 0;border-bottom:1px solid #e0e8dc}
  .briefing-list li:nth-last-child(-n+2){border-bottom:0}
  .briefing-list li>i{display:grid;width:39px;height:39px;place-items:center;border-radius:11px;background:#eef5e9;color:#367c44;font-size:20px}
  .briefing-list li:nth-child(even)>i{background:#eaf3f8;color:#2a7197}
  .briefing-list h3{font-size:16px}
  .briefing-list p{margin:7px 0 0;color:#607160;font-size:13px;line-height:1.7}
  .comparison-ledger{border-top:1px solid #d4e2d4}
  .comparison-ledger article{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.2fr) minmax(150px,.7fr);gap:28px;align-items:center;padding:25px 0;border-bottom:1px solid #d4e2d4}
  .comparison-label{display:flex;gap:13px;align-items:center}
  .comparison-label>i{display:grid;flex:0 0 46px;width:46px;height:46px;place-items:center;border-radius:50%;background:#f5efdc;color:#8a7437;font-size:23px}
  .comparison-ledger article:nth-child(2) .comparison-label>i{background:#e7f3eb;color:#387d4e}
  .comparison-ledger article:nth-child(3) .comparison-label>i{background:#eaf2f8;color:#2a7197}
  .comparison-label .eyebrow{font-size:9px;letter-spacing:.06em}
  .comparison-label h3{margin-top:5px;font-size:18px}
  .comparison-ledger article>p{margin:0;color:#5b6e61;font-size:14px;line-height:1.7}
  .comparison-ledger .text-link{font-size:12px}
  .valuation-section{background:radial-gradient(circle at 0 100%,rgba(119,183,94,.16),transparent 45%),#1c472d;color:#fff}
  .valuation-layout{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:25px clamp(30px,7vw,90px);align-items:center}
  .valuation-section .eyebrow{color:#badca9}
  .valuation-section h2 span{color:#c1e2b1}
  .valuation-layout header>p:not(.eyebrow){margin:18px 0 24px;max-width:490px;color:#ccdec7;line-height:1.7;font-size:15px}
