---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import LocationGlyph from '../../components/LocationGlyph.astro';
import LocationsMotion from '../../components/LocationsMotion.astro';
import { getVehicleData } from '../../lib/vehicle-data';
import { alAinCoverageLocations, alAinCollectionSettings } from '../../lib/al-ain-coverage';
const accessNotes = [
  ['access', 'Gates & driveways', 'Describe villa gates, compound entrances, narrow driveways and nearby parked cars.'],
  ['keys', 'Keys & steering', 'Mention missing keys or known steering restrictions. Share what you know; no need to test the car.'],
  ['vehicle', 'Rolling condition', 'Include locked wheels, flat tyres or damage that may affect movement. A non-running car may need a different recovery approach.'],
  ['collection', 'Working space', 'Explain where recovery equipment could stand, any ground or clearance limits and who can arrange entry.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const steps = [
  ['vehicle', 'Vehicle details', 'Start with the make, model, year and your contact details.'],
  ['review', 'Known condition', 'Describe damage, faults, keys and the car’s known mobility.'],
  ['coverage', 'Location & access', 'Share the precise Al Ain location, parking position and approach.'],
  ['collection', 'The next step', 'Discuss the valuation and practical arrangements before collection is agreed.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Al Ain?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share the vehicle details, known condition, mobility and exact location. The assessment and possible collection arrangements depend on the individual car and access review.'],
  ['Which Al Ain areas can I enquire about?', 'Al Ain is included in our UAE location coverage. Provide your exact area and parking position so coverage and practical access can be reviewed. An enquiry does not confirm a collection booking or guarantee collection.'],
  ['What if the car is at a villa or inside a compound?', 'Describe the entrance, clearance, route to the vehicle and any security or permission requirements. Identify the person who can arrange entry and vehicle handover.'],
  ['Can a car at an Al Ain workshop be considered?', 'Share the precise premises location, vehicle position, gate and available recovery space. Include working-area restrictions, other vehicles nearby and who can authorise release.'],
  ['What should I share for an outer-area location?', 'Provide the exact location and the approach from the road. Describe the ground surface, entrance width, restrictions and recovery space so practical access can be reviewed.'],
  ['What if the car has no keys or cannot roll or steer?', 'Mention missing keys, locked wheels, flat tyres or known steering restrictions when you enquire. These details may affect recovery equipment and access. You do not need to start or move the vehicle to request a valuation.'],
  ['Can several commercial vehicles be assessed together?', 'Start a fleet disposal enquiry with a vehicle list, individual conditions, parking positions and the authorised site contact. Access and possible handover arrangements may need a separate review for each vehicle.'],
  ['What affects the valuation and collection arrangements?', 'Vehicle details, known condition, damage, mobility, available documents and collection access can affect the review. The team can confirm the information and handover requirements for your circumstances before arrangements are agreed.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Al Ain', item: 'https://www.scrapmycaruae.com/locations/al-ain/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Al Ain | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Al Ain. Request a free valuation and share your vehicle condition and collection location." canonical="/locations/al-ain/" ogImage="/sections/al-ain-vehicle-collection.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="al-ain-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="al-ain-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><span aria-current="page">Al Ain</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="al-ain" /> Al Ain vehicle valuation</p><h1 id="al-ain-title"><span>Sell or scrap your car</span> <span class="accent">in Al Ain</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Al Ain. Share the vehicle details, condition and collection location to start the process.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="al-ain" />Al Ain residential &amp; workshop areas</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><div class="coverage-intro" data-reveal><header><p class="eyebrow">Al Ain coverage overview</p><h2 id="coverage-title">A local starting point.<br /><span>The details of your space.</span></h2><p>From villa driveways to workshop forecourts, tell us where the car is parked and how it can be reached.</p></header><aside class="city-note"><LocationGlyph kind="al-ain" /><div>{alAinCoverageLocations.map(name=><h3>{name}</h3>)}<p>Within Abu Dhabi emirate.<br />Exact location and access reviewed individually.</p></div><SectionActionButton href="/locations/" label="View UAE coverage" intent="process" icon="ph-map-trifold" /></aside></div><div class="setting-guides" data-reveal>{alAinCollectionSettings.map((setting,index)=><details id={setting.id} open={index===0}><summary><LocationGlyph kind={setting.icon} /><span>{setting.title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><div><p>{setting.copy}</p><p class="guide-detail">{setting.detail}</p></div></details>)}</div></div></section>

    <section class="collection-section" aria-labelledby="collection-title"><div class="smc-container"><figure class="photo-scene collection-scene" data-scene data-reveal><div class="collection-stage"><img class="scene-image" src="/sections/al-ain-vehicle-collection.webp" alt="Older dusty beige sedan with a scuffed bumper beside a recovery truck and operator outside a palm-lined Al Ain villa compound" width="1440" height="960" loading="lazy" decoding="async" /><div class="collection-shade" aria-hidden="true"></div><div class="collection-copy"><p class="eyebrow">Residential · workshop · outer-area</p><h2 id="collection-title">The setting changes.<br />The car stays central.</h2><p>A driveway, forecourt or outer-area approach each brings different access details. Share the route from the entrance to the vehicle.</p></div></div><aside class="access-tray"><LocationGlyph kind="access" /><div><h3>Look at the route out.</h3><p>Gates, parking space, ground conditions and vehicle mobility help inform the collection discussion.</p></div><SectionActionButton href="/car-removal/" label="Explore car collection" intent="process" icon="ph-truck" /></aside><figcaption>Illustrative Al Ain collection preparation. The exact parking position and approach help inform an individual access review.</figcaption></figure></div></section>

    <section class="section mobility-section" aria-labelledby="mobility-title"><div class="smc-container"><header class="section-heading" data-reveal><p class="eyebrow">Access &amp; vehicle mobility</p><h2 id="mobility-title">A few details<br /><span>before the car moves.</span></h2><p>Describe what you already know. You do not need to start, move or test a non-running vehicle to request a valuation.</p></header><div class="mobility-notes">{accessNotes.map(([icon,title,copy])=><article data-reveal><LocationGlyph kind={icon} /><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Start with your<br /><span>car’s known condition.</span></h2><p>Explore the guide that fits the vehicle. For wider selling options, read the <a href="/sell-my-car/">sell my car guide</a>.</p></header><nav class="service-buttons" aria-label="Al Ain vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section workshop-section" aria-labelledby="workshop-title"><div class="smc-container"><header class="workshop-heading" data-reveal><p class="eyebrow">Workshop &amp; commercial vehicles</p><h2 id="workshop-title">From the workshop bay<br /><span>to the handover.</span></h2><p>For a vehicle at an Al Ain workshop or commercial premises, explain its position, the available space and who can authorise release.</p></header><figure class="photo-scene workshop-scene" data-scene data-reveal><div class="workshop-stage"><img class="scene-image" src="/sections/al-ain-workshop-recovery.webp" alt="Worn blue-grey non-running sedan and recovery technician beside a lowered flatbed ramp at an Al Ain workshop forecourt with palms beyond the wall" width="1440" height="960" loading="lazy" decoding="async" /></div><aside class="handover-panel"><p class="eyebrow"><LocationGlyph kind="review" /> The site brief</p><h3>One car or several.<br />Explain each position.</h3><p>Share a vehicle list, each known condition and the route through the premises. Access may need a separate review for each car.</p><SectionActionButton href="/fleet-disposal/" label="Discuss commercial vehicles" intent="contact" icon="ph-truck" /></aside><figcaption>Illustrative workshop recovery preparation. Mobility, site permission and vehicle release arrangements are reviewed before collection.</figcaption></figure><ul class="workshop-checks" data-reveal><li><LocationGlyph kind="access" /><span>Gates &amp; working bays</span></li><li><LocationGlyph kind="keys" /><span>Keys &amp; known mobility</span></li><li><LocationGlyph kind="collection" /><span>Site contact &amp; release</span></li></ul></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container process-layout"><header data-reveal><p class="eyebrow">Valuation + collection planning</p><h2 id="process-title">Your details.<br /><span>A considered next step.</span></h2><p>The valuation starts with your vehicle. Its condition and Al Ain collection location shape the next discussion.</p><SectionActionButton href="/free-quote" label="Start my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><span class="step-number">0{index+1}</span><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></div></section>

    <section class="guide-section" aria-labelledby="guide-title"><div class="smc-container" data-reveal><p class="eyebrow">Al Ain area navigation</p><h2 id="guide-title">Find your parking setting.</h2><p>Explore the access details below, then share your exact Al Ain area and vehicle position.</p><nav class="guide-navigation" aria-label="Al Ain collection setting guides">{alAinCollectionSettings.map(setting=><SectionActionButton href={`#${setting.id}`} label={setting.id==='villa-compound-access'?'Villas & compounds':setting.id==='workshop-forecourts'?'Workshop access':'Outer-area parking'} intent="process" icon={setting.id==='villa-compound-access'?'ph-buildings':setting.id==='workshop-forecourts'?'ph-warehouse':'ph-map-trifold'} />)}</nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><header class="faq-heading" data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Al Ain collection<br /><span>questions.</span></h2></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><div><p class="eyebrow">Your vehicle. Your Al Ain location.</p><h2 id="final-title">Tell us about the car.<br /><span>We’ll discuss the next step.</span></h2><p>Share the details, known condition and collection location to start your free valuation.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>
<style>
.al-ain-page{color:#193e2b;background:#fff;overflow:clip}.al-ain-page :is(h1,h2,h3,p,figure){margin:0}.al-ain-page :is(h1,h2){letter-spacing:-.05em}.al-ain-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.al-ain-page h2 span,.accent{color:#43804a}.al-ain-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.coverage-section{background:#183e2c;color:#fff}.coverage-intro{display:grid;grid-template-columns:1.25fr 1fr;gap:75px;align-items:center}.coverage-intro h2{margin:16px 0 23px}.coverage-intro h2 span,.coverage-section .eyebrow{color:#bfdba9}.coverage-intro header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#d2dfc9;max-width:550px}.city-note{display:grid;grid-template-columns:58px 1fr;gap:20px;align-items:center;border:1px solid #6b8b5f;border-radius:24px;padding:28px;background:#31563b66}.city-note>:global(.location-glyph){width:58px;height:58px;color:#bfdaa7}.city-note h3{font-size:30px;color:#fff;margin-bottom:10px}.city-note p{font-size:13px;line-height:1.8;color:#d1dfc7}.city-note :global(.section-action){grid-column:1/-1;font-size:12px;justify-self:start;border-color:#a0be89}.setting-guides{margin-top:40px;border-top:1px solid #597b4f}.setting-guides details{border-bottom:1px solid #597b4f}.setting-guides summary{display:flex;align-items:center;gap:18px;padding:25px 0;cursor:pointer;list-style:none;font-size:19px;font-weight:750;line-height:1.5}.setting-guides summary::-webkit-details-marker{display:none}.setting-guides summary>:global(.location-glyph){width:33px;height:33px;color:#c4dda9;flex-shrink:0}.setting-guides summary i{margin-left:auto;color:#c4dda9;font-size:22px;flex-shrink:0}.setting-guides details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.setting-guides details>div{padding:0 30px 25px 51px;max-width:960px}.setting-guides details p{font-size:14px;line-height:1.8;color:#d1dfc6}.setting-guides .guide-detail{font-size:12px;color:#c1dca9;margin-top:15px;font-weight:700}
.collection-section{padding:70px 0;background:radial-gradient(ellipse at 95% 80%,#dceacd99,transparent 60%)}.photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;box-shadow:0 24px 45px #24452a15;background:#eef4e7}.collection-stage,.workshop-stage{position:relative;isolation:isolate;overflow:hidden}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}.collection-stage{min-height:680px;padding:45px;background:#173827}.collection-stage .scene-image{object-position:50% 55%}.collection-shade{position:absolute;inset:0;background:linear-gradient(135deg,#0b251ce8,transparent 75%)}.collection-copy{position:relative;z-index:1;max-width:640px;color:#fff}.collection-copy .eyebrow{color:#d1e4bb}.collection-copy h2{font-size:clamp(2rem,3.6vw,3.3rem);margin:16px 0 20px}.collection-copy>p:not(.eyebrow){font-size:14px;line-height:1.85;color:#e0ead9;max-width:510px}.access-tray{position:relative;z-index:2;display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:22px;align-items:center;padding:28px;margin:-60px 32px 25px;background:#fff;border:1px solid #dce6d1;border-radius:23px;box-shadow:0 18px 30px #173b251a}.access-tray>:global(.location-glyph){width:44px;height:44px;color:#50804a}.access-tray h3{font-size:23px;margin-bottom:10px}.access-tray p{font-size:14px;line-height:1.75;color:#5c735e;max-width:610px}.access-tray :global(.section-action){font-size:12px}.photo-scene figcaption{position:relative;z-index:3;background:#fff;color:#294b32;font-size:14px;line-height:1.65;padding:18px 24px;border-top:1px solid #dfe8d7}
.mobility-section{padding-top:25px;background:#f5f8ef}.section-heading{max-width:760px}.section-heading h2{margin:16px 0 22px}.section-heading>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5d735f;max-width:650px}.mobility-notes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px;margin-top:35px}.mobility-notes article{border-top:1px solid #ccdcbc;padding-top:24px}.mobility-notes article>:global(.location-glyph){width:40px;height:40px;color:#4a7c49;margin-bottom:19px}.mobility-notes h3{font-size:20px;margin-bottom:12px}.mobility-notes p{font-size:14px;line-height:1.8;color:#5e735f}.vehicle-section header{max-width:760px}.vehicle-section h2{margin:16px 0 23px}.vehicle-section header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5d7460}.vehicle-section header a{color:#366f40;font-weight:750;text-underline-offset:4px}.service-buttons{display:flex;flex-wrap:wrap;gap:14px;margin:30px 0 0;max-width:1080px}.service-buttons :global(.section-action){min-width:222px;justify-content:space-between;box-shadow:none}
.workshop-section{padding-top:0;background:radial-gradient(ellipse at 10% 60%,#dbe9c9aa,transparent 55%)}.workshop-heading{text-align:center;max-width:800px;margin:0 auto 35px}.workshop-heading .eyebrow{justify-content:center}.workshop-heading h2{margin:16px 0 22px}.workshop-heading>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5c735e;max-width:680px;margin:auto}.workshop-stage{height:650px}.workshop-stage .scene-image{object-position:50% 55%}.handover-panel{position:relative;z-index:2;background:#fff;border:1px solid #dce5d2;border-radius:24px;padding:30px;margin:-190px 35px 27px auto;width:min(460px,calc(100% - 70px));box-shadow:0 20px 35px #22452b20}.handover-panel h3{font-size:29px;margin:15px 0 18px}.handover-panel>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#5a735f}.handover-panel :global(.section-action){font-size:12px;width:100%;justify-content:space-between;margin-top:24px}.workshop-checks{list-style:none;margin:30px 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr 1fr;gap:30px}.workshop-checks li{display:flex;align-items:center;gap:15px;font-size:14px;font-weight:700;line-height:1.6}.workshop-checks :global(.location-glyph){width:37px;height:37px;color:#4b7d4b;flex-shrink:0}
.process-section{background:#173e2b;color:#fff}.process-layout{display:grid;grid-template-columns:.9fr 1fr;gap:80px;align-items:center}.process-layout header h2{margin:16px 0 24px}.process-layout header .eyebrow,.process-layout h2 span{color:#bfdda9}.process-layout header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#cfdfc3;margin-bottom:28px;max-width:520px}.process-layout :global(.section-action){border-color:#9cbe86}.planning-steps{list-style:none;margin:0;padding:0;border-top:1px solid #587b4c}.planning-steps li{display:grid;grid-template-columns:27px 36px minmax(0,1fr);gap:18px;border-bottom:1px solid #587b4c;padding:25px 0}.step-number{font-size:12px;line-height:34px;font-weight:800;color:#bfdba7}.planning-steps :global(.location-glyph){width:34px;height:34px;color:#bfdba7}.planning-steps h3{font-size:20px;margin:2px 0 11px}.planning-steps p{font-size:14px;line-height:1.75;color:#d0dfc5}
.guide-section{padding:40px 0;background:#f0f5e8;border-block:1px solid #dce6d1}.guide-section h2{font-size:32px;margin:13px 0 18px}.guide-section p:not(.eyebrow){font-size:14px;line-height:1.8;color:#5e745f}.guide-navigation{display:flex;flex-wrap:wrap;gap:13px;margin-top:25px}.guide-navigation :global(.section-action){font-size:12px}.faq-heading{text-align:center;margin-bottom:35px}.faq-heading .eyebrow{justify-content:center}.faq-heading h2{margin-top:16px}.faq-stack{border-top:1px solid #d4e1cc;max-width:880px;margin:auto}.faq-stack details{border-bottom:1px solid #dce6d5}.faq-stack summary{display:flex;align-items:center;justify-content:space-between;gap:22px;list-style:none;cursor:pointer;padding:23px 0;font-size:16px;font-weight:750;line-height:1.6}.faq-stack summary::-webkit-details-marker{display:none}.faq-stack summary i{font-size:22px;color:#4a7d49;flex-shrink:0}.faq-stack details>p{font-size:14px;line-height:1.8;color:#5c7360;margin-bottom:23px}.final-cta{background:radial-gradient(ellipse at 0 100%,#d7e7c399,transparent 65%),#f3f7ec;padding:65px 0;border-top:1px solid #dfe8d5}.final-inner{display:flex;align-items:center;justify-content:space-between;gap:40px}.final-inner h2{margin:16px 0 23px}.final-inner p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5e745c;max-width:610px}.final-inner :global(.section-action){flex-shrink:0}
