---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import LocationsMotion from '../../components/LocationsMotion.astro';
import LocationGlyph from '../../components/LocationGlyph.astro';
import { getVehicleData } from '../../lib/vehicle-data';
import { sharjahCoverage } from '../../lib/sharjah-coverage';
const accessNotes = [
  ['sharjah', 'Yards & workshops', 'Name the premises and the space between the car, other vehicles and recovery equipment.'],
  ['access', 'Tight approaches', 'Share narrow entrances, ramps, columns and obstacles along the route out.'],
  ['keys', 'Keys & mobility', 'Describe known rolling, steering or wheel restrictions. Mention any missing keys.'],
  ['coverage', 'Gates & permission', 'Explain entry arrangements and who can authorise release of the vehicle.'],
  ['vehicle', 'Non-running cars', 'Share what you already know about the condition. No need to start or move it to enquire.'],
  ['collection', 'Multi-vehicle sites', 'Include a vehicle list, individual conditions, parking positions and the handover contact.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const steps = [
  ['Vehicle details', 'Start with the make, model, year and your contact details.'],
  ['Condition review', 'Describe known damage, faults, mobility and any existing assessment.'],
  ['Location & access', 'Share the Sharjah area, exact parking position, gate and recovery-space information.'],
  ['Your next step', 'Discuss the valuation and practical arrangements after review, before collection is agreed.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Sharjah?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share the vehicle details, known condition, mobility and exact collection location. The possible next step depends on the individual vehicle and access review.'],
  ['Which Sharjah areas can I ask about?', 'You can enquire about Al Sajaa Industrial Area, Sharjah Industrial Area and Al Nahda. For another Sharjah location, share the precise area and parking position so coverage and access can be reviewed. A location listing does not confirm a collection booking.'],
  ['What information helps for a car at a Sajaa yard?', 'Share the exact yard, gate, vehicle position and available recovery space. Include who can authorise entry and release, the site contact and any known restrictions on moving the vehicle.'],
  ['Can a car be considered for recovery from a workshop?', 'Yes, access can be discussed. Identify the premises and describe the entrance, nearby vehicles, obstructions and known mobility. Equipment access and release arrangements need review before collection can be agreed.'],
  ['What if my car is in basement parking in Al Nahda?', 'Include the parking level, entrance height, ramp details and any nearby obstacles. Explain whether the car is known to roll or steer and who can arrange building or security access.'],
  ['What if the keys are missing or the wheels are locked?', 'Mention this when you enquire. Keys, wheel movement and steering can affect the recovery approach. Share what is already known; you do not need to test or move the vehicle just to request a valuation.'],
  ['Can I discuss multiple vehicles at a Sharjah site?', 'Yes. Start a fleet disposal enquiry with a vehicle list, each known condition, parking positions and an authorised site contact. Each vehicle and its access may need a separate review.'],
  ['What affects the valuation and handover requirements?', 'Vehicle details, known condition, damage, mobility, available information and location or access requirements can affect the review. Explain which ownership and vehicle documents you have, including any missing items, so the team can confirm requirements for your circumstances.'],
  ['Do these areas represent branch offices or fixed recovery routes?', 'No. They describe locations for valuation enquiries and collection discussions. They do not identify offices, depots, fixed routes or guaranteed collection times.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Sharjah', item: 'https://www.scrapmycaruae.com/locations/sharjah/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Sharjah | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Sharjah. Request a free valuation and share your vehicle condition and collection location." canonical="/locations/sharjah/" ogImage="/sections/sharjah-vehicle-collection.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="sharjah-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="sharjah-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><span aria-current="page">Sharjah</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="sharjah" /> Sharjah vehicle valuation</p><h1 id="sharjah-title"><span>Sell or scrap</span> <span class="accent">your car in Sharjah</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Sharjah. Share the vehicle details, condition and collection location to start the process.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="sharjah" />Sharjah residential &amp; industrial areas</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><header class="section-heading" data-reveal><div><p class="eyebrow">Sharjah coverage overview</p><h2 id="coverage-title">The area is a start.<br /><span>The access tells us more.</span></h2></div><p>Choose the area nearest your car. A residential parking bay, workshop entrance and industrial yard each need different collection details.</p></header><div class="area-browser" data-reveal><div class="region-tabs" role="tablist" aria-label="Sharjah collection areas">{sharjahCoverage.map((area,index) => <button type="button" role="tab" id={`tab-${area.id}`} aria-controls={area.id} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-region-tab={area.id}><LocationGlyph kind={area.icon} /><span>{area.short}</span></button>)}</div>{sharjahCoverage.map(area => <section class="region-panel" id={area.id} role="tabpanel" aria-labelledby={`tab-${area.id}`} tabindex="0" data-region-panel><div><p class="eyebrow">{area.context}</p><h3>{area.name}</h3><p>{area.copy}</p></div><div class="area-checks"><p class="small-label">Useful details to share</p><ul>{area.checks.map(check => <li><i class="ph ph-check-circle" aria-hidden="true"></i>{check}</li>)}</ul><SectionActionButton href="/free-quote" label={`Valuation in ${area.id === 'al-sajaa' ? 'Sajaa' : area.id === 'industrial-area' ? 'Sharjah' : 'Al Nahda'}`} intent="valuation" /></div></section>)}</div><p class="coverage-note">Somewhere else in Sharjah? Share the exact location for review. These are enquiry areas, not branches or confirmed collection bookings.</p></div></section>

    <section class="environment-section" aria-labelledby="environment-title"><div class="smc-container"><figure class="photo-scene collection-scene" data-scene data-reveal><div class="photo-stage"><img class="scene-image" src="/sections/sharjah-vehicle-collection.webp" alt="Older damaged silver sedan and unbranded recovery truck in a Sharjah forecourt with an operator reviewing space around the car" width="1440" height="960" loading="lazy" decoding="async" /><div class="stage-shade" aria-hidden="true"></div><div class="photo-heading"><p class="eyebrow">Residential parking · workshops · industrial sites</p><h2 id="environment-title">Different surroundings.<br /><span>A practical approach.</span></h2></div></div><div class="collection-panel"><span class="panel-glyph"><LocationGlyph kind="collection" /></span><p>Tell us where the car sits and how it can be reached. Residential entrances, workshop approaches and industrial parking each bring different access questions.</p><SectionActionButton href="/car-removal/" label="Explore car collection" intent="process" icon="ph-truck" /></div><figcaption>Illustrative Sharjah collection preparation. Vehicle position, access and known mobility help inform the discussion.</figcaption></figure></div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container"><header class="section-heading" data-reveal><div><p class="eyebrow">Industrial access &amp; recovery considerations</p><h2 id="access-title">Look beyond<br /><span>the workshop gate.</span></h2></div><p>Describe the last part of the approach, the space around the car and what is known about moving it. These details help the team review a practical next step.</p></header><div class="access-notes">{accessNotes.map(([icon,title,copy]) => <article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header class="vehicle-heading" data-reveal><p class="eyebrow">Vehicles we can assess in Sharjah</p><h2 id="vehicles-title">Tell us the condition.<br /><span>Explore your options.</span></h2><p>Choose the relevant guide for your car’s known condition. For a wider view of selling options, read our <a href="/sell-my-car/">sell my car guide</a>.</p></header><nav class="service-buttons" aria-label="Sharjah vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon]) => <SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="industrial-section" aria-labelledby="industrial-title"><div class="smc-container"><figure class="photo-scene industrial-scene" data-scene data-reveal><div class="industrial-stage"><img class="scene-image" src="/sections/sharjah-industrial-car-recovery.webp" alt="Worn non-running sedan prepared beside a flatbed recovery ramp at an open gate in a Sajaa-style Sharjah industrial yard" width="1440" height="960" loading="lazy" decoding="async" /><div class="industrial-shade" aria-hidden="true"></div><div class="industrial-copy"><p class="eyebrow"><LocationGlyph kind="sharjah" /> Sajaa &amp; Sharjah Industrial Area</p><h2 id="industrial-title">Plan the recovery<br /><span>around the site.</span></h2><p>For a yard, workshop or multi-vehicle site, identify the entrance, parking positions and who can authorise release. Restricted movement and nearby vehicles can affect the recovery approach.</p><SectionActionButton href="/fleet-disposal/" label="Discuss vehicles at your site" intent="contact" icon="ph-truck" /></div></div><figcaption>Illustrative industrial recovery preparation. Site entry, vehicle mobility and release arrangements are reviewed before collection is agreed.</figcaption></figure><div class="site-brief" data-reveal><p class="eyebrow">A useful first site brief</p><ul><li><LocationGlyph kind="vehicle" /><span>Vehicle list &amp; known condition</span></li><li><LocationGlyph kind="coverage" /><span>Gate, parking &amp; recovery space</span></li><li><LocationGlyph kind="review" /><span>Authorised contact &amp; release</span></li></ul></div></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="section-heading" data-reveal><div><p class="eyebrow">Valuation &amp; collection planning</p><h2 id="process-title">A few clear details.<br /><span>A considered next step.</span></h2></div><p>A free valuation request starts the review. Collection feasibility and arrangements are discussed for the individual car and location.</p></header><ol class="planning-steps">{steps.map(([title,copy],index) => <li data-reveal><span>0{index+1}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>

    <section class="area-navigation-section" aria-labelledby="area-nav-title"><div class="smc-container" data-reveal><div><p class="eyebrow">Sharjah area navigation</p><h2 id="area-nav-title">Back to your local guide.</h2></div><nav class="area-navigation" aria-label="Sharjah area guides">{sharjahCoverage.map(area => <SectionActionButton href={`#${area.id}`} label={area.short} intent="process" icon={area.id === 'al-nahda' ? 'ph-buildings' : 'ph-warehouse'} />)}<SectionActionButton href="/locations/" label="All UAE locations" intent="process" icon="ph-map-trifold" /></nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Sharjah collection<br /><span>questions.</span></h2><p>Local access, condition and handover information to help prepare your request.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><div><p class="eyebrow">Your vehicle. Your Sharjah location.</p><h2 id="final-title">Start with the car.<br /><span>Tell us where it is.</span></h2><p>Share the vehicle details, known condition and collection location to request a free valuation.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>
  .sharjah-page{color:#193e2b;background:#fff;overflow:clip}
  .sharjah-page :is(h1,h2,h3,p,figure){margin:0}
  .sharjah-page :is(h1,h2){letter-spacing:-.05em}
  .sharjah-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.09}
  .sharjah-page h2 span,.accent{color:#3e8148}
  .sharjah-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}
  .section{padding:clamp(60px,7vw,100px) 0}
  .eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}
  .eyebrow :global(.location-glyph){width:26px;height:26px}
  .breadcrumb{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:12px;color:#5c7461}
  .breadcrumb a{color:#3c6846;text-decoration:none}
  .hero{padding-top:22px;background:radial-gradient(ellipse at 6% 80%,#e0ebd3aa,transparent 60%),#f5f8f1}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:26px clamp(30px,6vw,80px);padding:42px 0 46px}
  .hero-copy{grid-area:copy;align-self:end}
  .hero-copy h1{font-size:clamp(2.6rem,3.8vw,3.65rem);line-height:1.09;margin-top:22px}
  .hero-copy h1>span{display:block;white-space:nowrap}
  .hero-lead{font-size:16px;line-height:1.8;color:#58705e;max-width:570px;margin-top:22px!important}
  .hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}
  .hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}
  .hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700}
  .hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
  .section-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.62fr);gap:50px;align-items:end;margin-bottom:35px}
  .section-heading h2{margin-top:15px}.section-heading>p{color:#5d7261;font-size:15px;line-height:1.8}
  .area-browser{border-block:1px solid #ccdcca;background:#f7f9f3}.region-tabs{display:none}.tabs-ready .region-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;border-bottom:1px solid #d6e2d0;padding:11px 0}
  .region-tabs button{font:inherit;font-weight:750;font-size:15px;display:flex;align-items:center;justify-content:center;gap:12px;min-height:70px;padding:15px;border:0;border-radius:999px;background:transparent;color:#3f6447;cursor:pointer;transition:background 180ms,color 180ms}.region-tabs button :global(.location-glyph){width:31px;height:31px;flex-shrink:0}.region-tabs button[aria-selected=true]{background:#1c4d2d;color:#fff}.region-tabs button:hover:not([aria-selected=true]){background:#e4eddb}
  .region-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.72fr);gap:65px;padding:36px 30px}.region-panel[hidden]{display:none!important}.region-panel+.region-panel{border-top:1px solid #d6e2d0}.tabs-ready .region-panel{border:0}.region-panel h3{font-size:31px;letter-spacing:-.04em;margin:13px 0 17px}.region-panel>div>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#5b7160}.small-label{font-size:10px!important;letter-spacing:.075em;text-transform:uppercase;font-weight:800;color:#4e754c!important}.area-checks{align-self:center;border-left:1px solid #d5e3cb;padding-left:35px}.area-checks ul{list-style:none;padding:0;margin:17px 0 23px;display:grid;gap:12px}.area-checks li{display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.65;color:#3e6145}.area-checks li i{font-size:19px;color:#4e804a;flex-shrink:0}.area-checks :global(.section-action){font-size:12px}.coverage-note{font-size:12px;line-height:1.8;color:#64785f;margin-top:22px!important}
  .environment-section{padding:0 0 72px;background:radial-gradient(ellipse at 8% 60%,#ddebd288,transparent 58%)}
  .photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;background:#eef4e7;box-shadow:0 24px 45px #24452a15}.photo-stage,.industrial-stage{position:relative;isolation:isolate;overflow:hidden}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}
  .photo-stage{height:550px}.photo-stage .scene-image{object-position:50% 55%}.stage-shade{position:absolute;inset:0;background:linear-gradient(180deg,#071d14c9,transparent 62%)}.photo-heading{position:relative;padding:35px 40px;color:#fff}.photo-heading .eyebrow{color:#c7e3b5}.photo-heading h2{font-size:clamp(2rem,3.3vw,3.1rem);margin-top:16px}.photo-heading h2 span{color:#c3e2b1}
  .collection-panel{position:relative;z-index:2;display:grid;grid-template-columns:50px minmax(0,1fr) auto;align-items:center;gap:22px;margin:-65px 30px 26px;padding:28px;background:#fff;border:1px solid #dfe8d7;border-radius:22px;box-shadow:0 14px 30px #1e44231a}.panel-glyph{display:grid;place-items:center;width:48px;height:48px;background:#edf4e4;color:#40784a;border-radius:14px}.panel-glyph :global(.location-glyph){width:32px;height:32px}.collection-panel p{font-size:14px;line-height:1.8;color:#5c7261;max-width:580px}.collection-panel :global(.section-action){font-size:12px;flex-shrink:0}
  .photo-scene figcaption{position:relative;z-index:3;background:#fff;color:#294b32;font-size:14px;line-height:1.65;padding:18px 24px;border-top:1px solid #dfe8d7}
  .access-section{background:#183e2c;color:#fff}.access-section .eyebrow,.access-section h2 span{color:#b9daa7}.access-section .section-heading>p{color:#c4d8bb}.access-notes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 33px}.access-notes article{display:flex;align-items:flex-start;gap:16px;padding:27px 0;border-top:1px solid #a4c89155;min-width:0}.access-notes article>:global(.location-glyph){width:35px;height:35px;flex-shrink:0;color:#b8dba5}.access-notes h3{font-size:18px;margin:4px 0 11px}.access-notes p{font-size:14px;line-height:1.8;color:#c4d8ba}
  .vehicle-heading{max-width:750px}.vehicle-heading h2{margin:15px 0 23px}.vehicle-heading p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5f7361}.vehicle-heading a{color:#316b3e;font-weight:750;text-underline-offset:4px}.service-buttons{display:flex;flex-wrap:wrap;gap:13px;margin-top:32px}.service-buttons :global(.section-action){min-width:210px;justify-content:space-between}
  .industrial-section{padding:0 0 30px;background:radial-gradient(ellipse at 92% 40%,#dcebd477,transparent 60%)}.industrial-stage{min-height:680px;display:flex;align-items:flex-end;background:#112d20}.industrial-stage .scene-image{object-position:50% 42%}.industrial-shade{position:absolute;inset:0;background:linear-gradient(0deg,#071a12fa,#071a12b5 35%,#071a1208 82%)}.industrial-copy{position:relative;z-index:1;color:#fff;padding:45px 42px;max-width:730px}.industrial-copy .eyebrow,.industrial-copy h2 span{color:#bfdda9}.industrial-copy h2{font-size:clamp(2rem,3.7vw,3.45rem);margin-top:16px}.industrial-copy>p:not(.eyebrow){font-size:14px;line-height:1.85;color:#d0e0c8;margin-top:21px;max-width:620px}.industrial-copy :global(.section-action){margin-top:24px;border-color:#a1c68c}
  .site-brief{padding:32px 8px 0}.site-brief ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;list-style:none;padding:0;margin:21px 0 0}.site-brief li{display:flex;align-items:center;gap:13px;font-size:14px;font-weight:700;line-height:1.6;color:#3c6246}.site-brief :global(.location-glyph){width:36px;height:36px;flex-shrink:0;color:#3e7849}
  .planning-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px;padding:0;margin:0;list-style:none;counter-reset:none}.planning-steps li{border-top:2px solid #9bbb84;padding-top:22px;min-width:0}.planning-steps li>span{font-size:38px;line-height:1;font-weight:750;letter-spacing:-.06em;color:#8dae76;display:block;margin-bottom:23px}.planning-steps h3{font-size:19px;margin-bottom:12px}.planning-steps p{font-size:14px;line-height:1.75;color:#5e7461}
  .area-navigation-section{background:#f1f6e9;border-block:1px solid #dce7d1;padding:38px 0}.area-navigation-section h2{font-size:30px;margin-top:12px}.area-navigation{display:flex;flex-wrap:wrap;gap:13px;margin-top:25px}.area-navigation :global(.section-action){font-size:12px}
