---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import LocationGlyph from '../../components/LocationGlyph.astro';
import LocationsMotion from '../../components/LocationsMotion.astro';
import { getVehicleData } from '../../lib/vehicle-data';
import { uaqCoverageLocations, uaqCollectionSettings } from '../../lib/umm-al-quwain-coverage';
const accessNotes = [
  ['access', 'Entrance & approach', 'Describe compound gates, workshop entrances, industrial plot access and the route to the car.'],
  ['keys', 'Keys & steering', 'Mention missing keys or known steering restrictions. Share what you know; no need to test the car.'],
  ['vehicle', 'Rolling condition', 'Include locked wheels, flat tyres or damage that may affect movement. A non-running car may need a different recovery approach.'],
  ['collection', 'Working space', 'Explain where recovery equipment could stand, any ground or clearance limits and who can arrange entry.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const steps = [
  ['vehicle', 'Vehicle details', 'Start with the make, model, year and your contact details.'],
  ['review', 'Known condition', 'Describe damage, faults, keys and the car’s known mobility.'],
  ['coverage', 'Location & access', 'Share the precise Umm Al Quwain location, parking position and approach.'],
  ['collection', 'The next step', 'Discuss the valuation and practical arrangements before collection is agreed.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Umm Al Quwain?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share the vehicle details, known condition, mobility and exact location. The assessment and possible collection arrangements depend on the individual car and access review.'],
  ['Which Umm Al Quwain areas can I enquire about?', 'Umm Al Quwain is included in our UAE location coverage. Provide your exact area and parking position so coverage and practical access can be reviewed. An enquiry does not confirm a collection booking or guarantee collection.'],
  ['What if the car is inside a compound or basement?', 'Describe the entrance, clearance, route to the vehicle and any security or permission requirements. Identify the person who can arrange entry and vehicle handover.'],
  ['Can a car at an Umm Al Quwain workshop or industrial plot be considered?', 'Share the precise premises location, vehicle position, gate and available recovery space. Include working-area restrictions, other vehicles nearby and who can authorise release.'],
  ['What should I share for a car at a storage site?', 'Provide the exact site location and vehicle position. Describe the surface, gate, available recovery space and who can arrange access and authorise vehicle release.'],
  ['What if the car has no keys or cannot roll or steer?', 'Mention missing keys, locked wheels, flat tyres or known steering restrictions when you enquire. These details may affect recovery equipment and access. You do not need to start or move the vehicle to request a valuation.'],
  ['Can several commercial vehicles be assessed together?', 'Start a fleet disposal enquiry with a vehicle list, individual conditions, parking positions and the authorised site contact. Access and possible handover arrangements may need a separate review for each vehicle.'],
  ['What affects the valuation and collection arrangements?', 'Vehicle details, known condition, damage, mobility, available documents and collection access can affect the review. The team can confirm the information and handover requirements for your circumstances before arrangements are agreed.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Umm Al Quwain', item: 'https://www.scrapmycaruae.com/locations/umm-al-quwain/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Umm Al Quwain | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Umm Al Quwain. Request a free valuation and share your vehicle condition and collection location." canonical="/locations/umm-al-quwain/" ogImage="/sections/umm-al-quwain-vehicle-collection.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="uaq-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="uaq-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><span aria-current="page">Umm Al Quwain</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="umm-al-quwain" /> Umm Al Quwain vehicle valuation</p><h1 id="uaq-title"><span>Sell or scrap your car</span> <span class="accent">in Umm Al Quwain</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Umm Al Quwain. Share the vehicle details, condition and collection location to start the process.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="umm-al-quwain" />Umm Al Quwain residential &amp; industrial areas</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><header class="coverage-heading" data-reveal><div><p class="eyebrow">Umm Al Quwain coverage overview</p><h2 id="coverage-title">A place to start.<br /><span>A route to your car.</span></h2></div><p>Share the exact location and parking position. Compounds, workshop bays and industrial plots each bring different access details.</p></header><div class="coverage-address" data-reveal><span class="emirate-mark"><LocationGlyph kind="umm-al-quwain" /></span><div>{uaqCoverageLocations.map(name=><h3>{name}</h3>)}<p>Collection enquiries · location and access reviewed individually</p></div><SectionActionButton href="/locations/" label="View UAE locations" intent="process" icon="ph-map-trifold" /></div><div class="setting-guides" data-reveal>{uaqCollectionSettings.map((setting,index)=><details id={setting.id} open={index===0}><summary><span class="setting-number">0{index+1}</span><LocationGlyph kind={setting.icon} /><span>{setting.title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><div><p>{setting.copy}</p><p class="guide-detail">{setting.detail}</p></div></details>)}</div></div></section>

    <section class="collection-section" aria-labelledby="collection-title"><div class="smc-container"><figure class="photo-scene collection-scene" data-scene data-reveal><div class="collection-stage"><img class="scene-image" src="/sections/umm-al-quwain-vehicle-collection.webp" alt="Older scuffed sand-coloured sedan with a professional recovery operator and an unbranded flatbed in a quiet Umm Al Quwain compound forecourt" width="1440" height="960" loading="lazy" decoding="async" /><div class="collection-shade" aria-hidden="true"></div><aside class="photo-note"><LocationGlyph kind="access" /><span>Useful access details<br /><strong>Entrance · parking · mobility</strong></span></aside><div class="collection-copy"><p class="eyebrow">Residential · workshop · industrial</p><h2 id="collection-title">It starts with<br /><span>where the car sits.</span></h2><p>A private parking space, workshop forecourt or industrial plot can change the approach. Describe the route in and the space around the vehicle.</p><SectionActionButton href="/car-removal/" label="Explore car collection" intent="process" icon="ph-truck" /></div></div><figcaption>Illustrative Umm Al Quwain collection preparation. The parking position and available access help inform an individual vehicle review.</figcaption></figure></div></section>

    <section class="section mobility-section" aria-labelledby="mobility-title"><div class="smc-container"><header class="section-heading" data-reveal><p class="eyebrow">Access &amp; vehicle mobility</p><h2 id="mobility-title">Small details.<br /><span>A more useful first brief.</span></h2><p>For a non-running vehicle, describe what is already known. You do not need to start, move or test the car to request a valuation.</p></header><div class="mobility-notes">{accessNotes.map(([icon,title,copy])=><article data-reveal><LocationGlyph kind={icon} /><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header class="vehicle-heading" data-reveal><div><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">The car you have.<br /><span>The guide you need.</span></h2></div><p>Start with the known condition. For wider selling options, read our <a href="/sell-my-car/">sell my car guide</a>.</p></header><nav class="service-buttons" aria-label="Umm Al Quwain vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section workshop-section" aria-labelledby="workshop-title"><div class="smc-container"><header class="workshop-heading" data-reveal><p class="eyebrow">Workshop &amp; industrial collection</p><h2 id="workshop-title">Before the vehicle leaves,<br /><span>understand the site.</span></h2><p>For a workshop, industrial plot or storage premises in Umm Al Quwain, explain the vehicle position and who can arrange access and release.</p></header><figure class="photo-scene workshop-scene" data-scene data-reveal><div class="workshop-stage"><img class="scene-image" src="/sections/umm-al-quwain-workshop-recovery.webp" alt="Older faded blue non-running sedan with a dented fender and recovery operator beside a lowered flatbed at an Umm Al Quwain workshop and industrial plot" width="1440" height="960" loading="lazy" decoding="async" /><div class="site-label"><LocationGlyph kind="sharjah" /><span>Workshop · yard · storage site</span></div></div><aside class="handover-panel"><div><p class="eyebrow">The handover brief</p><h3>More than one car?<br />Give each a clear position.</h3><p>Share the vehicle list, individual conditions and where each car is parked. Recovery access may need a separate review for every vehicle.</p></div><div><ul><li><i class="ph ph-key" aria-hidden="true"></i>Available keys &amp; known mobility</li><li><i class="ph ph-door-open" aria-hidden="true"></i>Gate, working areas &amp; recovery space</li><li><i class="ph ph-user-check" aria-hidden="true"></i>Entry permission &amp; release contact</li></ul><SectionActionButton href="/fleet-disposal/" label="Discuss vehicles at your site" intent="contact" icon="ph-truck" /></div></aside><figcaption>Illustrative workshop recovery preparation. Site permission, mobility and vehicle release arrangements are reviewed before collection is agreed.</figcaption></figure></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="process-heading" data-reveal><p class="eyebrow">Valuation + collection planning</p><h2 id="process-title">From your details<br /><span>to the next discussion.</span></h2></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><div class="step-marker"><span>0{index+1}</span><LocationGlyph kind={icon} /></div><h3>{title}</h3><p>{copy}</p></li>)}</ol><div class="process-action" data-reveal><SectionActionButton href="/free-quote" label="Start my free valuation" intent="valuation" /></div></div></section>

    <section class="guide-section" aria-labelledby="guide-title"><div class="smc-container" data-reveal><p class="eyebrow">Umm Al Quwain area navigation</p><h2 id="guide-title">Choose your parking setting.</h2><p>Explore the access guides below, then share your exact area and vehicle position.</p><nav class="guide-navigation" aria-label="Umm Al Quwain collection setting guides">{uaqCollectionSettings.map(setting=><SectionActionButton href={`#${setting.id}`} label={setting.id==='compound-parking'?'Residential & compounds':setting.id==='workshop-access'?'Workshop access':'Industrial plots'} intent="process" icon={setting.id==='compound-parking'?'ph-buildings':setting.id==='workshop-access'?'ph-wrench':'ph-warehouse'} />)}</nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><header class="faq-heading" data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Umm Al Quwain<br /><span>collection questions.</span></h2></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><div><p class="eyebrow">Your car. Your Umm Al Quwain location.</p><h2 id="final-title">Tell us where it is.<br /><span>Start with a free valuation.</span></h2><p>Share the vehicle details, known condition and collection location. We’ll discuss the practical next step.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>
.uaq-page{color:#193e2b;background:#fff;overflow:clip}.uaq-page :is(h1,h2,h3,p,figure){margin:0}.uaq-page :is(h1,h2){letter-spacing:-.05em}.uaq-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.uaq-page h2 span,.accent{color:#43804a}.uaq-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.uaq-page :is(a,button,summary):focus-visible{outline:3px solid #3181ab;outline-offset:4px}.uaq-page [id]{scroll-margin-top:35px}.page-progress{display:none;position:fixed;top:0;left:0;right:0;height:3px;background:#74a952;z-index:110;transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}.motion-ready .page-progress{display:block}.motion-ready [data-reveal]{opacity:0;transform:translateY(20px);transition:opacity 650ms ease,transform 650ms ease;transition-delay:var(--reveal-delay,0ms)}.motion-ready [data-reveal].is-visible{opacity:1;transform:none}
@media(hover:hover){.uaq-page :global(.section-action:hover){transform:translateY(-3px);box-shadow:0 16px 28px #173d2925}.uaq-page :global(.section-action:hover i){transform:scale(1.05) rotate(-4deg)}.photo-scene:hover .scene-image{transform:scale(1.075) translate3d(0,var(--scene-shift,0px),0)}}
@media(prefers-reduced-motion:reduce){.uaq-page [data-reveal]{opacity:1!important;transform:none!important;transition:none!important}.page-progress{display:none!important}.uaq-page :global(.section-action),.uaq-page :global(.section-action i),.scene-image{transition:none!important;transform:none!important}.uaq-page :global(.section-action:hover),.uaq-page :global(.section-action:hover i){transform:none!important}}
.coverage-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:70px;align-items:end;margin-bottom:35px}.coverage-heading h2{margin-top:16px}.coverage-heading>p{font-size:15px;line-height:1.8;color:#5d735f}.coverage-address{display:flex;align-items:center;gap:25px;padding:26px 28px;background:#f2f5e9;border:1px solid #dce5cf;border-radius:24px}.emirate-mark{display:grid;place-items:center;width:72px;height:72px;flex-shrink:0;border-radius:21px;background:#e0ebd2;color:#4c7948}.emirate-mark :global(.location-glyph){width:48px;height:48px}.coverage-address>div{flex:1}.coverage-address h3{font-size:30px;letter-spacing:-.04em;margin-bottom:9px}.coverage-address p{font-size:12px;line-height:1.7;color:#5f755f}.coverage-address :global(.section-action){font-size:12px;flex-shrink:0}.setting-guides{margin-top:28px;border-top:1px solid #d2e0c5}.setting-guides details{border-bottom:1px solid #d2e0c5}.setting-guides summary{display:flex;align-items:center;gap:20px;padding:24px 0;cursor:pointer;list-style:none;font-size:19px;font-weight:750;line-height:1.5}.setting-guides summary::-webkit-details-marker{display:none}.setting-number{font-size:11px;color:#78925f}.setting-guides summary>:global(.location-glyph){width:32px;height:32px;color:#4d7e4b;flex-shrink:0}.setting-guides summary i{margin-left:auto;color:#4d7e4b;font-size:22px;flex-shrink:0}.setting-guides details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.setting-guides details>div{padding:0 0 24px 85px;max-width:960px}.setting-guides details p{font-size:14px;line-height:1.8;color:#5f755f}.setting-guides .guide-detail{font-size:12px;color:#487248;margin-top:15px;font-weight:700}
.collection-section{padding:0 0 15px;background:radial-gradient(ellipse at 95% 60%,#dce9cfaa,transparent 60%)}.photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;box-shadow:0 24px 45px #24452a15;background:#eef3e6}.collection-stage,.workshop-stage{position:relative;isolation:isolate;overflow:hidden}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}.collection-stage{display:flex;align-items:flex-end;min-height:700px;padding:42px;background:#153b29}.collection-stage .scene-image{object-position:50% 55%}.collection-shade{position:absolute;inset:0;background:linear-gradient(0deg,#082419f5,#082419a6 30%,transparent 85%)}.collection-copy{position:relative;z-index:1;color:#fff;max-width:650px}.collection-copy .eyebrow,.collection-copy h2 span{color:#c3dda9}.collection-copy h2{font-size:clamp(2.1rem,3.7vw,3.4rem);margin:16px 0 21px}.collection-copy>p:not(.eyebrow){font-size:14px;line-height:1.85;color:#dfebd5;max-width:580px}.collection-copy :global(.section-action){font-size:13px;margin-top:25px;border-color:#a2c78b}.photo-note{position:absolute;right:28px;top:28px;z-index:1;display:flex;gap:13px;align-items:center;padding:18px 21px;background:#fffffff5;border-radius:18px;color:#527058;box-shadow:0 15px 30px #153b2920;font-size:12px;line-height:1.75}.photo-note :global(.location-glyph){width:36px;height:36px;color:#4a7b47;flex-shrink:0}.photo-note strong{color:#234e31}.photo-scene figcaption{position:relative;z-index:3;background:#fff;color:#294b32;font-size:14px;line-height:1.65;padding:18px 24px;border-top:1px solid #dfe8d7}
