---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import LocationsMotion from '../../components/LocationsMotion.astro';
import LocationGlyph from '../../components/LocationGlyph.astro';
import { getVehicleData } from '../../lib/vehicle-data';
import { dubaiCoverageGroups, dubaiAreaGuides } from '../../lib/dubai-coverage';

const accessNotes = [
  ['access', 'Parking level & clearance', 'Basement level, ramp gradient, entrance height and nearby columns help explain the available space.'],
  ['keys', 'Keys & wheel movement', 'Tell us whether keys are available and what you already know about rolling, steering or locked wheels.'],
  ['coverage', 'Permissions & entry', 'Mention gates, security checks, building approval and who can provide access to the car.'],
  ['review', 'Condition & obstacles', 'Describe known damage, flat tyres or blocked access. Photos can help explain the parking position.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'],
  ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'],
  ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'],
  ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'],
  ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const steps = [
  ['vehicle', 'Vehicle details', 'Start with the make, model, year and your contact details.'],
  ['review', 'Known condition', 'Share damage, symptoms, mobility and any existing assessment.'],
  ['coverage', 'Dubai location & access', 'Add the area, exact parking position, entry restrictions and keys information.'],
  ['collection', 'Agree the next step', 'Discuss the valuation and practical arrangements after review, before a collection is booked.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Dubai?', 'You can request an assessment for a non-running, unwanted or damaged car. Describe the known condition, whether it can roll or steer and its current location. The valuation and possible collection arrangements depend on the individual vehicle and access review.'],
  ['Which Dubai areas can I ask about?', 'You can enquire about Al Quoz, Ras Al Khor, Jebel Ali, Al Qusais, Dubai Investments Park and the other Dubai areas listed on this page. Share the precise location; an area listing does not confirm a booking or guarantee collection.'],
  ['Can you consider a car in basement parking?', 'Yes, the access can be reviewed. Include the parking level, entrance clearance, ramp details, nearby obstacles and what you already know about vehicle mobility. Recovery equipment and the route out need to be considered before arrangements are agreed.'],
  ['What if my car has missing keys or locked wheels?', 'Mention this when you enquire. Keys, steering and wheel movement can affect how a vehicle is approached and moved. Share what you already know; you do not need to try starting or moving it to request a valuation.'],
  ['Can a vehicle be collected from a Dubai workshop or industrial yard?', 'It can be considered. Provide the exact premises, parking position, site contact and who can authorise entry and release. Mention any security restrictions or limits on space for recovery equipment.'],
  ['How is a Dubai car valuation decided?', 'The review considers the vehicle details, known condition, damage, mobility, available information and location or access requirements. A request is free and does not commit you to selling or confirm a collection appointment.'],
  ['Can I discuss several vehicles at different Dubai sites?', 'Yes. Use the fleet disposal route and share the number of vehicles, condition, each site location and handover contacts. Each vehicle and location may need a separate access review.'],
  ['What documents should I prepare?', 'Share what ownership and vehicle documents you have available and explain any missing items. The team can confirm the information and handover requirements for your circumstances before you agree the next step.'],
  ['Do the listed Dubai areas represent branches?', 'No. These are location guides for valuation enquiries and collection discussions. They do not identify offices, depots, fixed recovery routes or guaranteed collection times.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Dubai', item: 'https://www.scrapmycaruae.com/locations/dubai/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Dubai | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Dubai. Request a free valuation and share your vehicle condition and collection location." canonical="/locations/dubai/" ogImage="/sections/dubai-vehicle-collection.webp">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <main class="dubai-page" data-location-hub>
    <div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="dubai-title">
      <div class="smc-container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><span aria-current="page">Dubai</span></nav>
        <div class="hero-grid">
          <div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="dubai" /> Dubai vehicle valuation</p><h1 id="dubai-title"><span>Sell or scrap</span> <span class="accent">your car in Dubai</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Dubai. Share the vehicle details, condition and collection location to start the process.</p></div>
          <div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div>
          <ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="dubai" />Dubai residential &amp; industrial areas</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul>
        </div>
      </div>
    </section>

    <section class="section coverage-section" aria-labelledby="coverage-title">
      <div class="smc-container">
        <header class="section-heading" data-reveal><div><p class="eyebrow">Dubai coverage overview</p><h2 id="coverage-title">One city.<br /><span>Different collection settings.</span></h2></div><p>From an Al Quoz yard to a tower basement, the useful details are local. Explore the areas below, then tell us exactly where your car is parked.</p></header>
        <div class="coverage-browser" data-reveal>
          <div class="region-tabs" role="tablist" aria-label="Dubai collection environments">{dubaiCoverageGroups.map((group, index) => <button type="button" role="tab" id={`tab-${group.id}`} aria-controls={group.id} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-region-tab={group.id}><LocationGlyph kind={group.icon} /><span>{group.label}</span></button>)}</div>
          {dubaiCoverageGroups.map(group => <section class="region-panel" id={group.id} role="tabpanel" aria-labelledby={`tab-${group.id}`} tabindex="0" data-region-panel>
            <div class="coverage-intro"><span class="large-glyph"><LocationGlyph kind={group.icon} /></span><p class="eyebrow">Location &amp; access</p><h3>{group.heading}</h3><p>{group.copy}</p></div>
            <div class="coverage-areas"><p class="small-label">Areas to discuss</p><ul class="area-tags">{group.areas.slice(0, 7).map(area => <li>{area}</li>)}</ul>{group.areas.length > 7 && <details class="more-areas"><summary>More Dubai areas<i class="ph ph-plus" aria-hidden="true"></i></summary><ul class="area-tags">{group.areas.slice(7).map(area => <li>{area}</li>)}</ul></details>}<p class="coverage-note">Area names describe enquiry coverage, not branch locations. Collection is subject to review.</p></div>
          </section>)}
        </div>
        <div class="coverage-footer" data-reveal><p>Outside Dubai? Explore our wider UAE coverage.</p><SectionActionButton href="/locations/" label="View UAE locations" intent="process" icon="ph-map-trifold" /></div>
      </div>
    </section>

    <section class="collection-section" aria-labelledby="settings-title"><div class="smc-container">
      <figure class="photo-scene urban-scene" data-scene data-reveal>
        <img class="scene-image" src="/sections/dubai-vehicle-collection.webp" alt="Older damaged silver sedan on an unbranded flatbed as an operator checks its securing points in a Dubai industrial yard" width="1440" height="960" loading="lazy" decoding="async" />
        <div class="scene-shade" aria-hidden="true"></div>
        <div class="scene-content"><p class="eyebrow">The setting changes the approach</p><h2 id="settings-title">A yard. A driveway.<br /><span>A basement space.</span></h2><p>Residential parking, industrial yards and restricted sites call for different access information. For a non-running car, tell us how it is positioned and whether it is known to roll or steer.</p><p>Basement clearance, entry permissions and the space for recovery equipment all matter before collection can be agreed.</p><SectionActionButton href="/car-removal/" label="Explore vehicle collection" intent="process" icon="ph-truck" /></div>
        <figcaption>Illustrative Dubai collection scene. The parking position and available space help inform a practical recovery discussion.</figcaption>
      </figure>
      <div class="access-heading" data-reveal><p class="eyebrow">Local access considerations</p><h3>Small details that help with the plan.</h3></div>
      <div class="access-notes">{accessNotes.map(([icon, title, copy]) => <article data-reveal><span class="note-glyph"><LocationGlyph kind={icon} /></span><h3>{title}</h3><p>{copy}</p></article>)}</div>
    </div></section>

    <section class="section vehicles-section" aria-labelledby="vehicles-title"><div class="smc-container">
      <div class="vehicle-heading" data-reveal><span class="large-glyph"><LocationGlyph kind="vehicle" /></span><div><p class="eyebrow">Vehicles we can assess in Dubai</p><h2 id="vehicles-title">Start with the car<br /><span>you have today.</span></h2><p>Unwanted, damaged or no longer driving? Choose the relevant guide and share the known condition. An assessment helps establish the possible next step.</p></div></div>
      <nav class="service-buttons" aria-label="Dubai vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href, label, icon]) => <SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav>
      <p class="service-note">Still considering your options? Read our <a href="/sell-my-car/">sell my car guide</a> before requesting a valuation.</p>
    </div></section>

    <section class="section commercial-section" aria-labelledby="commercial-title"><div class="smc-container">
      <header class="section-heading" data-reveal><div><p class="eyebrow">Industrial &amp; commercial collection</p><h2 id="commercial-title">Plan around the site.<br /><span>And the vehicles on it.</span></h2></div><p>For Al Quoz and Ras Al Khor workshops, Jebel Ali sites and DIP premises, provide a precise location and release arrangements. Several cars at one site may still need individual condition reviews.</p></header>
      <figure class="photo-scene recovery-scene" data-scene data-reveal>
        <img class="scene-image" src="/sections/dubai-car-recovery-access.webp" alt="Worn grey non-running sedan aligned with a flatbed recovery ramp near a Dubai residential basement entrance with an operator checking the approach" width="1440" height="960" loading="lazy" decoding="async" />
        <div class="recovery-tint" aria-hidden="true"></div>
        <div class="planning-panel"><span class="large-glyph"><LocationGlyph kind="collection" /></span><p class="eyebrow">Before recovery is arranged</p><h3>Make the access<br /><span>part of the conversation.</span></h3><ul><li><i class="ph ph-check-circle" aria-hidden="true"></i>Exact parking position and entrance</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Known mobility, keys and wheel restrictions</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Security, permissions and handover contact</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Vehicle count and available documents</li></ul><SectionActionButton href="/fleet-disposal/" label="Discuss fleet disposal" intent="contact" icon="ph-truck" /></div>
        <figcaption>Illustrative recovery preparation at a Dubai parking entrance. Equipment access and vehicle mobility need to be reviewed for each setting.</figcaption>
      </figure>
      <div class="commercial-strip" data-reveal><LocationGlyph kind="sharjah" /><p><strong>Workshop, yard or managed site?</strong> Include who can authorise entry and release. We can discuss the vehicle and access information before arrangements are agreed.</p></div>
    </div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="center-heading" data-reveal><p class="eyebrow">How valuation &amp; collection planning works</p><h2 id="process-title">The details first.<br /><span>A practical next step.</span></h2></header><ol class="collection-process">{steps.map(([icon, title, copy], index) => <li data-reveal><div class="step-marker"><LocationGlyph kind={icon} /><span>0{index + 1}</span></div><h3>{title}</h3><p>{copy}</p></li>)}</ol><p class="process-note">A valuation request is free. Collection feasibility and arrangements are discussed after review.</p></div></section>

    <section class="section area-section" aria-labelledby="area-title"><div class="smc-container"><header class="section-heading" data-reveal><div><p class="eyebrow">Explore Dubai areas</p><h2 id="area-title">A closer look<br /><span>at your location.</span></h2></div><p>Find local access notes for the area where your vehicle is parked. Share the exact position and any restrictions when you enquire.</p></header><nav class="area-navigation" aria-label="Dubai area guides" data-reveal>{dubaiAreaGuides.map(area => <SectionActionButton href={`#${area.id}`} label={`${area.name === 'Dubai Investments Park (DIP)' ? 'DIP' : area.name} guide`} intent="process" icon={area.group === 'industrial' ? 'ph-warehouse' : 'ph-buildings'} />)}</nav><div class="area-guides" data-reveal>{dubaiAreaGuides.map(area => <details id={area.id}><summary><span class="area-icon"><LocationGlyph kind={area.icon} /></span><span>{area.name}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><div class="area-detail"><p>{area.copy}</p><SectionActionButton href="/free-quote" label={`Valuation in ${area.id === 'dubai-investments-park' ? 'DIP' : area.name}`} intent="valuation" /></div></details>)}</div></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Dubai collection<br /><span>questions.</span></h2><p>Valuation, location and access information to help you prepare.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><div><p class="eyebrow">Your car. Your Dubai location.</p><h2 id="final-title">Tell us about your car.<br /><span>And where it is parked.</span></h2><p>Share the vehicle details, known condition and collection location to request your free valuation.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main>
  <LocationsMotion />
</BaseLayout>

<style>
  .dubai-page{color:#193e2b;background:#fff;overflow:clip}
  .dubai-page :is(h1,h2,h3,p,figure){margin:0}
  .dubai-page :is(h1,h2){letter-spacing:-.05em}
  .dubai-page h2{font-size:clamp(2.2rem,3.7vw,3.45rem);line-height:1.09}
  .dubai-page h2 span,.accent{color:#3e8148}
  .dubai-page h3{font-size:22px;line-height:1.25;letter-spacing:-.025em}
  .section{padding:clamp(60px,7vw,100px) 0}
  .eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.1em;text-transform:uppercase}
  .eyebrow :global(.location-glyph){width:26px;height:26px}
  .breadcrumb{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:12px;color:#5c7461}
  .breadcrumb a{color:#3c6846;text-decoration:none}
  .hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#dcebd4aa,transparent 60%),#f4f8f0}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:26px clamp(30px,6vw,80px);padding:42px 0 46px}
  .hero-copy{grid-area:copy;align-self:end}
  .hero-copy h1{font-size:clamp(2.7rem,4vw,3.8rem);line-height:1.09;margin-top:22px}
  .hero-copy h1>span{display:block;white-space:nowrap}
  .hero-lead{font-size:16px;line-height:1.8;color:#58705e;max-width:570px;margin-top:22px!important}
  .hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}
  .hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}
  .hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700}
  .hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
  .section-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.65fr);gap:45px;align-items:end;margin-bottom:34px}
  .section-heading h2{margin-top:14px}
  .section-heading>p{color:#5b7261;font-size:15px;line-height:1.8}
  .coverage-browser{border:1px solid #d4e1ca;border-radius:28px;overflow:hidden;background:#f7f9f3;box-shadow:0 18px 40px #1c472b08}
  .region-tabs{display:none}
  .tabs-ready .region-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:11px;background:#ecf3e4;border-bottom:1px solid #dae5d3}
  .region-tabs button{font:inherit;font-size:15px;font-weight:750;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:11px;padding:17px 12px;border:0;border-radius:18px;background:transparent;color:#3d6247;min-height:76px;transition:background 180ms,color 180ms,box-shadow 180ms}
  .region-tabs button :global(.location-glyph){width:32px;height:32px;flex-shrink:0}
  .region-tabs button[aria-selected='true']{color:white;background:#194b2c;box-shadow:0 8px 18px #1b442822}
  .region-tabs button:hover:not([aria-selected='true']){background:#dce9d4}
  .region-panel{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);gap:60px;padding:38px 40px;background:#fff}
  .region-panel+.region-panel{border-top:1px solid #d4e1ca}
  .tabs-ready .region-panel{border:0}
  .region-panel[hidden]{display:none!important}
  .large-glyph{display:grid;place-items:center;width:59px;height:59px;border-radius:18px;background:#edf4e5;color:#3b7848;margin-bottom:24px;border:1px solid #dbe7d2}
  .large-glyph :global(.location-glyph){width:39px;height:39px}
  .coverage-intro h3{font-size:30px;letter-spacing:-.04em;margin:13px 0 15px}
  .coverage-intro>p:last-child{color:#5f7263;font-size:14px;line-height:1.8}
  .coverage-areas{align-self:center}
  .small-label{font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:800;color:#56774d}
  .area-tags{display:flex;flex-wrap:wrap;gap:9px;list-style:none;margin:16px 0;padding:0}
  .area-tags li{font-size:13px;line-height:1.5;border:1px solid #dce7d2;background:#f3f7ec;color:#3b5e43;border-radius:10px;padding:11px 13px}
  .coverage-note{color:#61765e;font-size:12px;line-height:1.75;margin-top:18px!important}
  .more-areas summary{display:flex;justify-content:space-between;align-items:center;gap:10px;list-style:none;cursor:pointer;font-size:13px;font-weight:750;padding:14px;border:1px solid #d7e4cd;border-radius:12px;color:#356641;background:#fff}
  summary::-webkit-details-marker{display:none}
  .more-areas summary i{font-size:20px}
  details[open]>summary>i{transform:rotate(45deg)}
  .coverage-footer{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:26px}
  .coverage-footer p{font-size:14px;color:#617363}
  .collection-section{padding:0 0 75px;background:radial-gradient(ellipse at 90% 15%,#dcebd444,transparent 55%)}
  .photo-scene{position:relative;isolation:isolate;display:grid;grid-template-rows:1fr auto;overflow:hidden;border-radius:30px;background:#173b2a;box-shadow:0 24px 45px #24452a17}
  .scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}
  .urban-scene{min-height:630px}
  .urban-scene .scene-image{object-position:68% 50%}
  .scene-shade{position:absolute;inset:0;background:linear-gradient(90deg,#081d14f5,#081d14d9 30%,#081d1429 76%)}
  .scene-content{position:relative;color:white;max-width:540px;align-self:center;padding:50px 45px 55px;z-index:1}
  .scene-content .eyebrow{color:#bedcad}
  .scene-content h2{font-size:clamp(2rem,3.3vw,3rem);margin-top:18px}
  .scene-content h2 span{color:#b8dda5}
  .scene-content>p:not(.eyebrow){font-size:14px;line-height:1.85;color:#d5e4cd;margin-top:20px}
  .scene-content :global(.section-action){margin-top:26px;border-color:#a1c58e}
  .photo-scene figcaption{position:relative;z-index:2;background:#fff;color:#294b32;font-size:14px;line-height:1.65;padding:18px 24px;border:1px solid #e0e8d9;border-top:0;border-radius:0 0 30px 30px}
  .access-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:37px 0 26px}
  .access-heading h3{font-size:23px}
  .access-notes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
  .access-notes article{padding-right:20px;border-right:1px solid #dce5d7;min-width:0}
  .access-notes article:last-child{border:0}
  .note-glyph{display:grid;place-items:center;width:49px;height:49px;background:#edf4e5;border-radius:14px;color:#3e774a;margin-bottom:17px}
  .note-glyph :global(.location-glyph){width:32px;height:32px}
  .access-notes h3{font-size:17px;line-height:1.4}
  .access-notes p{font-size:14px;line-height:1.75;color:#617364;margin-top:10px}
  .vehicles-section{background:#183e2a;color:#fff;position:relative}
  .vehicle-heading{display:flex;gap:25px;align-items:flex-start;max-width:850px}
  .vehicle-heading .large-glyph{flex-shrink:0;background:#c8e8b911;border-color:#81ad7066;color:#badca9}
  .vehicle-heading .eyebrow,.vehicle-heading h2 span{color:#b9dda9}
  .vehicle-heading h2{margin:14px 0 20px}
  .vehicle-heading p:not(.eyebrow){color:#c7d9c1;font-size:15px;line-height:1.8}
  .service-buttons{display:flex;flex-wrap:wrap;gap:13px;margin-top:34px}
  .service-buttons :global(.section-action){min-width:208px;justify-content:space-between;border-color:#86b176;box-shadow:none}
  .service-note{font-size:13px;color:#c5d8bd;line-height:1.8;margin-top:28px!important}
  .service-note a{color:#e0eed7;font-weight:750;text-underline-offset:4px}
  .commercial-section{background:linear-gradient(#f6f8f1,#fff)}
  .recovery-scene{min-height:670px;padding-top:55px;background:#cdd7c5}
  .recovery-scene .scene-image{object-position:37% 50%}
  .recovery-tint{position:absolute;inset:0;background:linear-gradient(90deg,transparent,#173b2a25 65%,#173b2a70)}
  .planning-panel{position:relative;z-index:1;align-self:center;justify-self:end;width:420px;margin:30px;padding:28px;background:#fffffff5;border:1px solid #fff;border-radius:23px;box-shadow:0 18px 40px #1029192b}
  .planning-panel .large-glyph{margin-bottom:19px;width:47px;height:47px}
