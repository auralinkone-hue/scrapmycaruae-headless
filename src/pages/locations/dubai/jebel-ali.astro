---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import SectionActionButton from '../../../components/SectionActionButton.astro';
import LocationGlyph from '../../../components/LocationGlyph.astro';
import LocationsMotion from '../../../components/LocationsMotion.astro';
import { getVehicleData } from '../../../lib/vehicle-data';
const coverage = [
  ['industrial', 'sharjah', 'Jebel Ali Industrial Area', 'For a car at an industrial unit or workshop, give the premises, exact parking position and entrance. Mention yard activity, other parked vehicles and the contact who can arrange access.'],
  ['free-zone', 'access', 'Jebel Ali Free Zone (JAFZA)', 'For a vehicle inside JAFZA, explain the site’s entry requirements and permissions. Any potential collection is subject to site approval, access arrangements and practical assessment; an enquiry does not confirm entry.'],
  ['logistics', 'collection', 'Warehouses & logistics premises', 'Identify the warehouse or facility and whether the car is in fleet parking, a loading area or an internal yard. Explain access restrictions and who can coordinate vehicle handover.']
];
const accessNotes = [
  ['access', 'Security gates & permission', 'Share the gate or entrance, any visitor or recovery-vehicle requirements and the person who can confirm permission. Site entry must be agreed before arrangements are finalised.'],
  ['vehicle', 'Position & mobility', 'Explain whether the vehicle is blocked, immobilised or parked inside a loading area. Include known flat tyres, locked wheels or restrictions on rolling and steering.'],
  ['keys', 'Keys & release contact', 'Tell us whether keys are available and who is authorised to release the vehicle. If it belongs to a business, identify the person coordinating the vehicle and site handover.'],
  ['collection', 'Loading lanes & recovery space', 'Describe the approach through the yard, nearby vehicles and space for recovery equipment. Mention active loading bays or other work areas that may limit access.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const fleetBrief = [
  ['ph-list-checks', 'Vehicle inventory', 'Make, model, year and known condition for every vehicle in the enquiry.'],
  ['ph-map-trifold', 'Exact parking positions', 'Which facility, yard or bay each vehicle occupies, with known mobility and keys.'],
  ['ph-user-check', 'Handover coordination', 'The authorised vehicle contact, site contact and entry or release requirements.']
];
const steps = [
  ['vehicle', 'Vehicle details', 'Start with the make, model, year and your contact details.'],
  ['review', 'Known condition', 'Share faults, damage and what is known about keys and mobility.'],
  ['coverage', 'Location & access', 'Identify the Jebel Ali premises, parking position and any restricted-site requirements.'],
  ['collection', 'Valuation & collection discussion', 'Review the valuation and possible arrangements. Collection depends on approval, access and practical assessment.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Jebel Ali?', 'You can request a free valuation with the vehicle details, known condition and exact Jebel Ali location. Mention keys, rolling and steering restrictions, and the route to the vehicle. Possible collection arrangements depend on the vehicle and site access review.'],
  ['Can I enquire about a car inside JAFZA?', 'Yes. Explain the facility, parking position, site contact and entry requirements. Any potential collection is subject to site approval, permissions, access arrangements and practical assessment. We do not claim automatic or guaranteed entry to JAFZA.'],
  ['What should I share for a vehicle at a warehouse?', 'Give the warehouse or premises, entrance and exact parking bay or yard position. Explain whether it is near a loading area, behind parked vehicles or within a restricted working zone. Add the authorised handover contact.'],
  ['What if the car is blocking or parked near a loading bay?', 'Describe its position and how loading activity affects the approach. The site contact can explain the space available and any restrictions. Do not move an immobilised vehicle just to start a valuation enquiry.'],
  ['Can several fleet vehicles at a logistics site be considered?', 'You can start a fleet disposal enquiry. Share a vehicle list with individual conditions, keys, known mobility and parking positions. Identify the authorised business contact and site contact; each vehicle and its access may require a separate review.'],
  ['What if keys are missing or the car cannot roll or steer?', 'Tell us about missing keys, locked wheels, flat tyres and known steering restrictions. These details can affect the recovery approach and equipment. Share what you already know without starting or testing a damaged car.'],
  ['Who should coordinate a company vehicle handover?', 'Identify who is authorised to sell or release the vehicle and who controls access to the premises. They may be different people. Share any company or site requirements so the information and handover arrangements can be confirmed.'],
  ['Does a valuation request confirm a collection booking?', 'No. A valuation request starts the review. Vehicle condition, ownership information, exact location, site permissions and available recovery space need to be discussed before collection arrangements are agreed.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Dubai', item: 'https://www.scrapmycaruae.com/locations/dubai/' },
  { '@type': 'ListItem', position: 4, name: 'Jebel Ali', item: 'https://www.scrapmycaruae.com/locations/dubai/jebel-ali/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Jebel Ali Dubai | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Jebel Ali, Dubai. Request a free valuation and discuss vehicle condition and collection access." canonical="/locations/dubai/jebel-ali/" ogImage="/sections/jebel-ali-warehouse-recovery.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="jebel-ali-page" data-location-hub>
    <div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="jebel-ali-title"><div class="smc-container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><a href="/locations/dubai/">Dubai</a><span aria-hidden="true">/</span><span aria-current="page">Jebel Ali</span></nav>
      <div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="collection" /> Jebel Ali · Dubai</p><h1 id="jebel-ali-title"><span>Sell or scrap your car</span> <span class="accent">in Jebel Ali</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Jebel Ali. Share the vehicle details, condition and exact collection location, including any site access requirements, to start the process.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="sharjah" />Industrial &amp; logistics areas</li><li><LocationGlyph kind="access" />Collection access considered</li></ul></div>
    </div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container">
      <header class="coverage-heading" data-reveal><div><p class="eyebrow">Industrial · logistics · commercial</p><h2 id="coverage-title">A location is the start.<br /><span>Site access shapes the plan.</span></h2></div><p>Jebel Ali enquiries can involve industrial premises, warehouses and managed facilities. Share the exact site and its requirements so potential collection can be considered on a practical basis.</p></header>
      <div class="coverage-index" data-reveal>{coverage.map(([id,icon,title,copy],index)=><details id={id} open={index===0}><summary><LocationGlyph kind={icon} /><span>{title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div>
      <p class="permission-note" data-reveal><i class="ph ph-shield-check" aria-hidden="true"></i>Restricted-site collection is subject to approval, access arrangements and individual assessment.</p>
    </div></section>

    <section class="recovery-section" aria-labelledby="recovery-title"><div class="smc-container"><figure class="photo-scene recovery-scene" data-scene data-reveal><div class="recovery-stage">
      <img class="scene-image" src="/sections/jebel-ali-warehouse-recovery.webp" alt="Older white sedan with bumper scuffs beside an unbranded flatbed recovery truck and operator outside warehouse loading bays in a Jebel Ali-style logistics setting" width="1440" height="960" loading="lazy" decoding="async" />
      <div class="recovery-shade" aria-hidden="true"></div><div class="recovery-copy"><p class="eyebrow">From parking position to collection discussion</p><h2 id="recovery-title">Working warehouses.<br /><span>Considered recovery.</span></h2><p>Loading lanes, vehicle movements and site controls can affect the approach to a car. A clear access brief helps explain what can be arranged.</p></div>
      <aside class="recovery-panel"><LocationGlyph kind="access" /><h3>Before arrangements are agreed</h3><p>Identify the entrance, space for recovery equipment and the contact who can authorise access and vehicle release.</p><SectionActionButton href="/car-removal/" label="Read the collection guide" intent="process" icon="ph-truck" /></aside>
    </div></figure></div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container"><header class="access-heading" data-reveal><p class="eyebrow">Warehouses, logistics yards &amp; restricted access</p><h2 id="access-title">The route to the car<br /><span>needs its own brief.</span></h2><p>Tell us what is known about the car and what the site can confirm. You do not need to start or move an immobilised vehicle to request a valuation.</p></header><div class="access-notes">{accessNotes.map(([icon,title,copy])=><article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Choose the guide<br /><span>that fits the condition.</span></h2><p>Known damage or faults help shape the review. Explore the relevant guide or read the wider <a href="/sell-my-car/">sell my car process</a>.</p></header><nav class="service-buttons" aria-label="Jebel Ali vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section fleet-section" aria-labelledby="fleet-title"><div class="smc-container"><header class="fleet-heading" data-reveal><p class="eyebrow">Commercial fleets &amp; warehouse vehicles</p><h2 id="fleet-title">Several vehicles.<br /><span>One coordinated enquiry.</span></h2><p>A fleet parking area can hold cars with different conditions, keys and mobility. Start with a vehicle list and exact locations, then clarify the people and permissions involved in handover.</p></header>
      <div class="fleet-dossier" data-reveal><figure class="photo-scene fleet-scene" data-scene><img class="scene-image" src="/sections/jebel-ali-commercial-fleet.webp" alt="Worn silver sedan and older unbranded commercial vans in spaced parking bays at a Jebel Ali-style warehouse forecourt with a site coordinator reviewing vehicle details" width="1440" height="960" loading="lazy" decoding="async" /></figure><aside class="fleet-brief"><p class="eyebrow">Prepare the site brief</p><ol>{fleetBrief.map(([icon,title,copy],index)=><li><span class="brief-number">0{index+1}</span><div><h3><i class={`ph ${icon}`} aria-hidden="true"></i>{title}</h3><p>{copy}</p></div></li>)}</ol><SectionActionButton href="/fleet-disposal/" label="Discuss commercial vehicles" intent="contact" icon="ph-truck" /></aside></div>
      <p class="fleet-note" data-reveal>Each vehicle and its access may need an individual review. An enquiry does not confirm an offer, site entry or a collection booking.</p>
    </div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="process-heading" data-reveal><div><p class="eyebrow">Valuation &amp; collection planning</p><h2 id="process-title">Clear details.<br /><span>A practical discussion.</span></h2></div><SectionActionButton href="/free-quote" label="Start my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><div class="step-marker"><span>0{index+1}</span><LocationGlyph kind={icon} /></div><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>

    <section class="nearby-section" aria-labelledby="nearby-title"><div class="smc-container" data-reveal><p class="eyebrow">More Dubai location guides</p><h2 id="nearby-title">Explore other industrial settings.</h2><nav class="nearby-links" aria-label="Published Dubai location guides"><SectionActionButton href="/locations/dubai/al-quoz/" label="Al Quoz workshops" intent="process" icon="ph-warehouse" /><SectionActionButton href="/locations/dubai/ras-al-khor/" label="Ras Al Khor automotive yards" intent="process" icon="ph-car-profile" /><SectionActionButton href="/locations/dubai/" label="All Dubai coverage" intent="process" icon="ph-map-trifold" /></nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Jebel Ali<br /><span>collection questions.</span></h2><p>Useful details for industrial units, warehouses and sites with controlled entry.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>

    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><LocationGlyph kind="collection" /><h2 id="final-title">Have an unwanted car<br /><span>in Jebel Ali?</span></h2><p>Share the vehicle details, known condition and exact location, including any site access requirements.</p><SectionActionButton href="/free-quote" label="Get My Free Valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>

.jebel-ali-page{color:#193e2b;background:#fff;overflow:clip}.jebel-ali-page :is(h1,h2,h3,p,figure){margin:0}.jebel-ali-page :is(h1,h2){letter-spacing:-.05em}.jebel-ali-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.jebel-ali-page h2 span,.accent{color:#43804a}.jebel-ali-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.jebel-ali-page :is(a,button,summary):focus-visible{outline:3px solid #3181ab;outline-offset:4px}.jebel-ali-page [id]{scroll-margin-top:35px}.page-progress{display:none;position:fixed;top:0;left:0;right:0;height:3px;background:#74a952;z-index:110;transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}.motion-ready .page-progress{display:block}.motion-ready [data-reveal]{opacity:0;transform:translateY(20px);transition:opacity 650ms ease,transform 650ms ease;transition-delay:var(--reveal-delay,0ms)}.motion-ready [data-reveal].is-visible{opacity:1;transform:none}
@media(hover:hover){.jebel-ali-page :global(.section-action:hover){transform:translateY(-3px);box-shadow:0 16px 28px #173d2925}.jebel-ali-page :global(.section-action:hover i){transform:scale(1.05) rotate(-4deg)}.photo-scene:hover .scene-image{transform:scale(1.075) translate3d(0,var(--scene-shift,0px),0)}}
@media(prefers-reduced-motion:reduce){.jebel-ali-page [data-reveal]{opacity:1!important;transform:none!important;transition:none!important}.page-progress{display:none!important}.jebel-ali-page :global(.section-action),.jebel-ali-page :global(.section-action i),.scene-image{transition:none!important;transform:none!important}.jebel-ali-page :global(.section-action:hover),.jebel-ali-page :global(.section-action:hover i){transform:none!important}}

.coverage-section{background:#edf3e7}.coverage-heading{display:grid;grid-template-columns:1.3fr .8fr;gap:60px;align-items:end;margin-bottom:32px}.coverage-heading h2{margin-top:17px}.coverage-heading>p{font-size:15px;line-height:1.85;color:#58715e}.coverage-index{border:1px solid #ccddbf;border-radius:24px;background:#fff;overflow:hidden}.coverage-index details+details{border-top:1px solid #dbe5d1}.coverage-index summary{display:flex;align-items:center;gap:18px;padding:24px 28px;list-style:none;cursor:pointer;font-size:21px;font-weight:750;line-height:1.5}.coverage-index summary::-webkit-details-marker{display:none}.coverage-index summary>:global(.location-glyph){width:35px;height:35px;color:#4f7d48;flex-shrink:0}.coverage-index summary i{margin-left:auto;font-size:22px;color:#4a7d49}.coverage-index details[open] summary{background:#f6f9f1}.coverage-index details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.coverage-index details>p{font-size:15px;line-height:1.85;color:#54705b;padding:0 32px 25px 81px;background:#f6f9f1;max-width:100%}.permission-note{display:flex;align-items:flex-start;gap:11px;font-size:13px;line-height:1.8;color:#546f58;margin-top:25px!important}.permission-note i{font-size:23px;flex-shrink:0;color:#467748}
.recovery-section{padding:65px 0 0;background:radial-gradient(ellipse at 90% 60%,#dce9cdaa,transparent 60%)}.photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;box-shadow:0 22px 45px #24452a18;background:#183d2b}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}.recovery-stage{position:relative;isolation:isolate;min-height:750px;overflow:hidden}.recovery-stage .scene-image{object-position:50% 60%}.recovery-shade{position:absolute;inset:0;background:linear-gradient(180deg,#082419e8,transparent 65%),linear-gradient(90deg,#08241966,transparent 75%)}.recovery-copy{position:relative;z-index:1;max-width:720px;padding:43px;color:white}.recovery-copy .eyebrow,.recovery-copy h2 span{color:#c3dfa9}.recovery-copy h2{margin:18px 0 22px;font-size:clamp(2.1rem,3.8vw,3.6rem)}.recovery-copy>p:not(.eyebrow){max-width:560px;font-size:14px;line-height:1.85;color:#e0ecd5}.recovery-panel{position:absolute;right:30px;bottom:30px;width:330px;z-index:1;padding:25px;background:#fff;border:1px solid #deead2;border-radius:23px;box-shadow:0 16px 30px #102e2230}.recovery-panel>:global(.location-glyph){width:36px;height:36px;color:#4d7c4a;margin-bottom:14px}.recovery-panel h3{font-size:24px;margin-bottom:15px}.recovery-panel p{font-size:14px;line-height:1.8;color:#58715d}.recovery-panel :global(.section-action){font-size:11px;width:100%;justify-content:space-between;margin-top:23px}
.access-section .smc-container{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:start}.access-heading h2{margin:18px 0 23px}.access-heading>p:not(.eyebrow){font-size:15px;line-height:1.85;color:#5a725e}.access-notes{border-top:1px solid #d5e2c9}.access-notes article{display:flex;gap:20px;padding:24px 0;border-bottom:1px solid #d5e2c9}.access-notes article>:global(.location-glyph){width:36px;height:36px;flex-shrink:0;color:#4b7b48}.access-notes h3{font-size:21px;margin:3px 0 13px}.access-notes p{font-size:14px;line-height:1.85;color:#5c735f}
