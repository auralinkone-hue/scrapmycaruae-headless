---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import SectionActionButton from '../../../components/SectionActionButton.astro';
import LocationGlyph from '../../../components/LocationGlyph.astro';
import LocationsMotion from '../../../components/LocationsMotion.astro';
import { getVehicleData } from '../../../lib/vehicle-data';
import { alQuozCoverageLocations, alQuozCollectionSettings } from '../../../lib/al-quoz-coverage';
const accessNotes = [
  ['access', 'Gate & approach', 'Describe the workshop or unit entrance, gate width, nearby parked cars and route to the vehicle.'],
  ['keys', 'Keys & steering', 'Mention missing keys or known steering restrictions. Share what you know; no need to test the car.'],
  ['vehicle', 'Rolling condition', 'Include locked wheels, flat tyres or damage that may affect movement. A non-running car may need a different recovery approach.'],
  ['collection', 'Release & working space', 'Explain who can authorise release, where recovery equipment could stand and any working-area restrictions.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const steps = [
  ['vehicle', 'Vehicle details', 'Start with the make, model, year and your contact details.'],
  ['review', 'Known condition', 'Describe damage, faults, keys and the car’s known mobility.'],
  ['coverage', 'Location & access', 'Share the precise Al Quoz location, parking position and approach.'],
  ['collection', 'The next step', 'Discuss the valuation and practical arrangements before collection is agreed.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Al Quoz?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share its details, known condition, exact Al Quoz location and mobility. The assessment and possible collection arrangements depend on the vehicle and access review.'],
  ['Can a car be considered while it is at an Al Quoz workshop?', 'Yes, you can start an enquiry. Identify the workshop, exact bay or parking position and who can authorise the car’s release. Explain gates, working areas and the route to the vehicle before collection is discussed.'],
  ['What if the vehicle is blocked by other parked cars?', 'Describe the obstruction and who can arrange access. Mention narrow lanes, other vehicles, workshop activity and any limits on recovery space. Access arrangements need to be reviewed before collection is agreed.'],
  ['What if keys are missing or the car cannot roll or steer?', 'Share missing keys, locked wheels, flat tyres or known steering restrictions when you enquire. These can affect recovery equipment and access. You do not need to start or move the car to request a valuation.'],
  ['Can trade or fleet vehicles at one Al Quoz site be assessed?', 'You can start a fleet disposal discussion. Provide a vehicle list, each known condition and parking position, available keys and the authorised site contact. Each car and its access may need a separate review.'],
  ['Does the workshop need to authorise handover?', 'Tell us who owns the vehicle and who can authorise entry and release at the premises. Share any workshop or site restrictions so the required handover arrangements can be confirmed for your circumstances.'],
  ['What information affects the valuation?', 'The make, model, year, known condition, damage, mobility, available information and collection access can affect the review. A free valuation request does not commit you to selling or confirm a collection booking.'],
  ['Which documents should I mention?', 'Explain what ownership and vehicle documents are available and whether anything is missing. The team can confirm the information and handover requirements for your circumstances before arrangements are agreed.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Dubai', item: 'https://www.scrapmycaruae.com/locations/dubai/' },
  { '@type': 'ListItem', position: 4, name: 'Al Quoz', item: 'https://www.scrapmycaruae.com/locations/dubai/al-quoz/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Al Quoz Dubai | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Al Quoz, Dubai. Request a free valuation and share the vehicle condition and exact collection location." canonical="/locations/dubai/al-quoz/" ogImage="/sections/al-quoz-workshop-recovery.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="al-quoz-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="al-quoz-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><a href="/locations/dubai/">Dubai</a><span aria-hidden="true">/</span><span aria-current="page">Al Quoz</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="sharjah" /> Al Quoz · Dubai</p><h1 id="al-quoz-title"><span>Sell or scrap your car</span> <span class="accent">in Al Quoz</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Al Quoz. Share the vehicle details, condition and exact collection location to start the process.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="sharjah" />Workshops &amp; industrial yards</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><div class="coverage-heading" data-reveal><header><p class="eyebrow">Automotive &amp; industrial coverage</p><h2 id="coverage-title">The workshop.<br /><span>The yard. The exact position.</span></h2><p>Al Quoz is part of our Dubai location coverage. Start with the premises and where the car is parked, then explain the practical route to it.</p></header><aside class="area-identity"><LocationGlyph kind="sharjah" /><p class="eyebrow">Dubai collection guide</p>{alQuozCoverageLocations.map(name=><h3>{name}</h3>)}<p>Location and access reviewed for each vehicle.</p><SectionActionButton href="/locations/dubai/" label="View Dubai coverage" intent="process" icon="ph-map-trifold" /></aside></div><div class="setting-guides" data-reveal>{alQuozCollectionSettings.map((setting,index)=><details id={setting.id} open={index===0}><summary><LocationGlyph kind={setting.icon} /><span>{setting.title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><div><p>{setting.copy}</p><p class="guide-detail">{setting.detail}</p></div></details>)}</div></div></section>

    <section class="collection-section" aria-labelledby="collection-title"><div class="smc-container"><figure class="photo-scene collection-scene" data-scene data-reveal><div class="collection-stage"><img class="scene-image" src="/sections/al-quoz-workshop-recovery.webp" alt="Older silver sedan with modest bumper damage beside an unbranded flatbed and recovery operator in an Al Quoz-style Dubai workshop industrial lane" width="1440" height="960" loading="lazy" decoding="async" /><div class="collection-shade" aria-hidden="true"></div><div class="scene-tag"><LocationGlyph kind="access" /><span>Workshop access<br /><strong>Reviewed before arrangements</strong></span></div><div class="collection-copy"><p class="eyebrow">A vehicle inside a working site</p><h2 id="collection-title">Plan the route<br /><span>from bay to gate.</span></h2><p>Other parked cars, workshop activity and an immobilised vehicle can all affect the approach. Clear access information helps explain the space available for recovery.</p><SectionActionButton href="/car-removal/" label="Read the collection guide" intent="process" icon="ph-truck" /></div></div></figure></div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container"><header class="section-heading" data-reveal><p class="eyebrow">Workshops, yards &amp; industrial units</p><h2 id="access-title">What is known.<br /><span>What the site can confirm.</span></h2><p>Share the car’s known condition and the route through the premises. You do not need to start or move an immobilised vehicle to request a valuation.</p></header><div class="access-brief">{accessNotes.map(([icon,title,copy],index)=><article data-reveal><span class="brief-number">0{index+1}</span><LocationGlyph kind={icon} /><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">The condition guide<br /><span>for the car on site.</span></h2><p>Choose the relevant guide for known damage or faults. Read the <a href="/sell-my-car/">sell my car guide</a> for the wider process.</p></header><nav class="service-buttons" aria-label="Al Quoz vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section trade-section" aria-labelledby="trade-title"><div class="smc-container"><header class="trade-heading" data-reveal><div><p class="eyebrow">Workshop · trade · fleet</p><h2 id="trade-title">One site.<br /><span>Each vehicle considered.</span></h2></div><p>For trade stock, workshop vehicles or a fleet disposal enquiry, a clear vehicle list is a useful starting point. Each car’s condition, mobility and parking position may need its own review.</p></header><div class="trade-ribbon" data-reveal><span><LocationGlyph kind="vehicle" />Vehicle list</span><span><LocationGlyph kind="coverage" />Parking positions</span><span><LocationGlyph kind="review" />Authorised contact</span></div><figure class="photo-scene trade-scene" data-scene data-reveal><div class="trade-stage"><img class="scene-image" src="/sections/al-quoz-trade-vehicle-assessment.webp" alt="Assessor checking a faded dark-blue non-running sedan with a flat tyre at an Al Quoz workshop forecourt with older commercial vans parked behind" width="1440" height="960" loading="lazy" decoding="async" /></div><aside class="trade-panel"><div><p class="eyebrow">A practical trade enquiry</p><h3>Vehicle by vehicle.<br />Position by position.</h3><p>Include make, model, year, known faults and keys for each car. Add the gate, working space and the person who can authorise release.</p></div><div><ul><li><i class="ph ph-list-checks" aria-hidden="true"></i>A vehicle list with individual conditions</li><li><i class="ph ph-key" aria-hidden="true"></i>Known mobility &amp; available keys</li><li><i class="ph ph-user-check" aria-hidden="true"></i>Site access &amp; release contact</li></ul><SectionActionButton href="/fleet-disposal/" label="Discuss trade or fleet vehicles" intent="contact" icon="ph-truck" /></div></aside></figure></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container process-layout"><header data-reveal><p class="eyebrow">Valuation + collection planning</p><h2 id="process-title">A useful brief.<br /><span>A considered next step.</span></h2><p>The review begins with your vehicle details. Condition, exact Al Quoz location and site access help shape the next discussion.</p><SectionActionButton href="/free-quote" label="Start my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><span class="step-number">0{index+1}</span><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></div></section>

    <section class="nearby-section" aria-labelledby="nearby-title"><div class="smc-container" data-reveal><p class="eyebrow">Nearby &amp; wider Dubai navigation</p><h2 id="nearby-title">More Dubai access guides.</h2><p>Explore existing workshop and industrial access notes in the Dubai parent guide, or browse coverage across the UAE.</p><nav class="nearby-links" aria-label="More Dubai collection guides"><SectionActionButton href="/locations/dubai/" label="Dubai coverage" intent="process" icon="ph-buildings" /><SectionActionButton href="/locations/dubai/ras-al-khor/" label="Ras Al Khor collection guide" intent="process" icon="ph-warehouse" /><SectionActionButton href="/locations/dubai/#al-qusais" label="Al Qusais access notes" intent="process" icon="ph-map-trifold" /><SectionActionButton href="/locations/" label="All UAE locations" intent="process" icon="ph-map-trifold" /></nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><header class="faq-heading" data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Al Quoz workshop<br /><span>&amp; collection questions.</span></h2></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><div><p class="eyebrow">Your vehicle. Its exact Al Quoz location.</p><h2 id="final-title">Tell us about the car.<br /><span>And the site it is on.</span></h2><p>Share the details, known condition and collection location to start your free valuation.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>
.al-quoz-page{color:#193e2b;background:#fff;overflow:clip}.al-quoz-page :is(h1,h2,h3,p,figure){margin:0}.al-quoz-page :is(h1,h2){letter-spacing:-.05em}.al-quoz-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.al-quoz-page h2 span,.accent{color:#43804a}.al-quoz-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.al-quoz-page :is(a,button,summary):focus-visible{outline:3px solid #3181ab;outline-offset:4px}.al-quoz-page [id]{scroll-margin-top:35px}.page-progress{display:none;position:fixed;top:0;left:0;right:0;height:3px;background:#74a952;z-index:110;transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}.motion-ready .page-progress{display:block}.motion-ready [data-reveal]{opacity:0;transform:translateY(20px);transition:opacity 650ms ease,transform 650ms ease;transition-delay:var(--reveal-delay,0ms)}.motion-ready [data-reveal].is-visible{opacity:1;transform:none}
@media(hover:hover){.al-quoz-page :global(.section-action:hover){transform:translateY(-3px);box-shadow:0 16px 28px #173d2925}.al-quoz-page :global(.section-action:hover i){transform:scale(1.05) rotate(-4deg)}.photo-scene:hover .scene-image{transform:scale(1.075) translate3d(0,var(--scene-shift,0px),0)}}
@media(prefers-reduced-motion:reduce){.al-quoz-page [data-reveal]{opacity:1!important;transform:none!important;transition:none!important}.page-progress{display:none!important}.al-quoz-page :global(.section-action),.al-quoz-page :global(.section-action i),.scene-image{transition:none!important;transform:none!important}.al-quoz-page :global(.section-action:hover),.al-quoz-page :global(.section-action:hover i){transform:none!important}}
.coverage-section{background:#183d2b;color:#fff}.coverage-heading{display:grid;grid-template-columns:1.4fr 1fr;gap:70px;align-items:center}.coverage-heading h2{margin:16px 0 23px}.coverage-heading header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#d0dfc4;max-width:650px}.coverage-section .eyebrow,.coverage-section h2 span{color:#bfdda8}.area-identity{padding:28px;border-left:1px solid #648551}.area-identity>:global(.location-glyph){width:62px;height:62px;color:#c2dfa9;margin-bottom:19px}.area-identity h3{font-size:34px;margin:12px 0 17px}.area-identity>p:not(.eyebrow){font-size:13px;line-height:1.8;color:#cfdcc4}.area-identity :global(.section-action){margin-top:24px;font-size:12px;border-color:#a3bf8a}.setting-guides{margin-top:35px;border-top:1px solid #5a7a4c}.setting-guides details{border-bottom:1px solid #5a7a4c}.setting-guides summary{display:flex;align-items:center;gap:17px;padding:24px 0;list-style:none;font-size:19px;font-weight:750;line-height:1.5;cursor:pointer}.setting-guides summary::-webkit-details-marker{display:none}.setting-guides summary>:global(.location-glyph){width:32px;height:32px;color:#c2dda8;flex-shrink:0}.setting-guides summary i{margin-left:auto;color:#bfdda8;font-size:22px;flex-shrink:0}.setting-guides details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.setting-guides details>div{padding:0 30px 24px 49px;max-width:990px}.setting-guides details p{font-size:14px;line-height:1.8;color:#d0dfc5}.setting-guides .guide-detail{font-size:12px;color:#bfdda8;margin-top:15px;font-weight:700}
.collection-section{padding:70px 0 0;background:radial-gradient(ellipse at 95% 60%,#dce9cfaa,transparent 60%)}.photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;box-shadow:0 24px 45px #24452a15;background:#edf3e6}.collection-stage,.trade-stage{position:relative;isolation:isolate;overflow:hidden}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}.collection-stage{display:flex;align-items:flex-end;min-height:700px;padding:42px;background:#153a29}.collection-stage .scene-image{object-position:50% 55%}.collection-shade{position:absolute;inset:0;background:linear-gradient(0deg,#082419f5,#082419a6 30%,transparent 85%)}.collection-copy{position:relative;z-index:1;color:#fff;max-width:680px}.collection-copy .eyebrow,.collection-copy h2 span{color:#c3dda9}.collection-copy h2{font-size:clamp(2.1rem,3.7vw,3.4rem);margin:16px 0 21px}.collection-copy>p:not(.eyebrow){font-size:14px;line-height:1.85;color:#dfebd5;max-width:600px}.collection-copy :global(.section-action){font-size:13px;margin-top:25px;border-color:#a2c78b}.scene-tag{position:absolute;right:28px;top:28px;z-index:1;display:flex;gap:13px;align-items:center;padding:18px 21px;background:#fffffff5;border-radius:18px;color:#527058;box-shadow:0 15px 30px #153b2920;font-size:12px;line-height:1.75}.scene-tag :global(.location-glyph){width:36px;height:36px;color:#4a7b47;flex-shrink:0}.scene-tag strong{color:#234e31}
