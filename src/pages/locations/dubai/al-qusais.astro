---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import SectionActionButton from '../../../components/SectionActionButton.astro';
import LocationGlyph from '../../../components/LocationGlyph.astro';
import LocationsMotion from '../../../components/LocationsMotion.astro';
import { getVehicleData } from '../../../lib/vehicle-data';
import { dubaiAreaGuides } from '../../../lib/dubai-coverage';
const area = dubaiAreaGuides.find(area => area.id === 'al-qusais')!;
const settings = [
  ['residential-parking', 'access', 'Residential buildings & parking', 'Share the building, parking level and bay or outdoor position. Explain the entrance, clearance limits and who can confirm permission for access.'],
  ['local-workshops', 'sharjah', 'Workshops & industrial premises', 'Identify the workshop, bay or forecourt position and available working space. Tell us whether keys are available and who can authorise the car’s release.'],
  ['business-parking', 'vehicle', 'Commercial parking locations', 'Give the business premises and exact parking space. Include gates, other parked vehicles and the person coordinating access and handover.']
];
const accessNotes = [
  ['access', 'Basement or outdoor parking', 'For a basement, describe the entrance, height limit, ramp and level. For outdoor parking, explain the space around the car and whether other vehicles obstruct it.'],
  ['keys', 'Keys, rolling & steering', 'Mention missing keys, locked wheels, flat tyres and known steering restrictions. Share what you know without starting or moving a damaged car.'],
  ['review', 'Security & permissions', 'Explain gates, building or workshop permission and who can authorise vehicle release. Site access needs to be confirmed before collection is agreed.'],
  ['collection', 'A practical recovery approach', 'Identify the route from the road to the vehicle and space for equipment. A non-running car in restricted parking may need a different approach from one on an open forecourt.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood damage', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const handoverNotes = [
  ['ph-map-trifold', 'Exact position', 'Building or workshop, level and bay.'],
  ['ph-key', 'Known mobility', 'Keys, rolling and steering status.'],
  ['ph-user-check', 'Release contact', 'Who can authorise access and handover.']
];
const steps = [
  ['vehicle', 'Vehicle details', 'Start with make, model, year and your contact details.'],
  ['review', 'Known condition', 'Explain damage, faults, keys and the vehicle’s known mobility.'],
  ['coverage', 'Al Qusais location & access', 'Give the exact premises, parking position and entry requirements.'],
  ['collection', 'Valuation & next step', 'Discuss the valuation and possible collection arrangements after the vehicle and access review.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Al Qusais?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share its details, known condition and exact Al Qusais location. Keys, mobility and access information help with the review before possible collection arrangements are discussed.'],
  ['Can a vehicle in basement parking be considered?', 'You can start an enquiry. Explain the entrance height, ramp, level, parking position and whether the car can roll or steer. Building permission, equipment access and the practical recovery route need review; basement collection is not guaranteed.'],
  ['What if the car is in outdoor residential parking?', 'Share the building or premises and exact parking position. Describe nearby vehicles, gates or barriers and the space around the car. Identify who can confirm access and authorise handover.'],
  ['Can I enquire while the car is at a local workshop?', 'Yes. Identify the workshop and bay or forecourt position, whether keys are available and who can release the car. Explain any workshop restrictions and how recovery equipment could reach the vehicle.'],
  ['What if keys are missing or the wheels are locked?', 'Tell us about missing keys, locked wheels, flat tyres or known steering restrictions. These may affect equipment and access. You do not need to start, test or move the vehicle to request a valuation.'],
  ['Who should arrange building or site permission?', 'Share the contact who controls access to the building, parking area or workshop, and who can authorise the vehicle’s release. They may be different people. Explain any permissions or handover requirements so these can be confirmed before arrangements are agreed.'],
  ['Can several business vehicles in Al Qusais be assessed?', 'You can start a fleet disposal enquiry with a vehicle list, individual conditions, keys and exact parking positions. Provide the authorised business and site contacts. Each vehicle and its access may require its own review.'],
  ['Does a free valuation confirm collection?', 'No. A valuation request starts the review. The vehicle details, condition, ownership information, exact location and access must be discussed before collection arrangements are agreed. No fixed collection time or guaranteed access is implied.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Dubai', item: 'https://www.scrapmycaruae.com/locations/dubai/' },
  { '@type': 'ListItem', position: 4, name: 'Al Qusais', item: 'https://www.scrapmycaruae.com/locations/dubai/al-qusais/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Al Qusais Dubai | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Al Qusais, Dubai. Request a free valuation and discuss parking, workshop and collection access." canonical="/locations/dubai/al-qusais/" ogImage="/sections/al-qusais-residential-recovery.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="al-qusais-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="al-qusais-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><a href="/locations/dubai/">Dubai</a><span aria-hidden="true">/</span><span aria-current="page">Al Qusais</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="access" /> Al Qusais · Dubai</p><h1 id="al-qusais-title"><span>Sell or scrap your car</span> <span class="accent">in Al Qusais</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Al Qusais, Dubai. Share your vehicle details, condition and exact collection location to get started.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="access" />Residential &amp; workshop locations</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container coverage-layout"><header data-reveal><p class="eyebrow">{area.name} residential &amp; commercial coverage</p><h2 id="coverage-title">Where is<br /><span>your car parked?</span></h2><p>Al Qusais includes residential parking, local workshops and commercial premises. The exact setting helps explain the route to the car.</p><p class="local-note"><LocationGlyph kind="coverage" /><span>{area.copy}</span></p></header><div class="coverage-settings" data-reveal>{settings.map(([id,icon,title,copy],index)=><details id={id} open={index===0}><summary><LocationGlyph kind={icon} /><span>{title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></div></section>

    <section class="recovery-section" aria-labelledby="recovery-title"><div class="smc-container"><div class="recovery-feature" data-reveal><figure class="photo-scene recovery-scene" data-scene><img class="scene-image" src="/sections/al-qusais-residential-recovery.webp" alt="Unbranded silver mid-2010s sedan with minor bumper damage beside a flatbed and recovery operator in an Al Qusais-style residential and commercial parking lane" width="1440" height="960" loading="lazy" decoding="async" /></figure><div class="recovery-copy"><p class="eyebrow">Vehicle recovery access</p><h2 id="recovery-title">Start with the<br /><span>parking position.</span></h2><p>A car in a basement bay needs different access information from one outside a building or workshop.</p><ul><li><i class="ph ph-buildings" aria-hidden="true"></i>Entrance &amp; parking level</li><li><i class="ph ph-car-profile" aria-hidden="true"></i>Exact bay or outdoor position</li></ul><SectionActionButton href="/car-removal/" label="Explore car collection" intent="process" icon="ph-truck" /></div></div></div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container"><header class="section-heading" data-reveal><p class="eyebrow">Parking, workshops &amp; vehicle access</p><h2 id="access-title">Useful details<br /><span>before collection is discussed.</span></h2><p>Describe what is already known about the car and what the building or workshop can confirm.</p></header><div class="access-notes">{accessNotes.map(([icon,title,copy])=><article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Find the right<br /><span>vehicle guide.</span></h2><p>Choose the relevant condition guide or explore the wider <a href="/sell-my-car/">sell my car process</a>.</p></header><nav class="service-buttons" aria-label="Al Qusais vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section handover-section" aria-labelledby="handover-title"><div class="smc-container"><header class="handover-heading" data-reveal><div><p class="eyebrow">Workshop &amp; residential vehicle collection</p><h2 id="handover-title">From the bay<br /><span>to a practical handover.</span></h2></div><p>Whether the car is with a workshop or parked at home, identify who can confirm access, keys and permission to release it.</p></header><div class="handover-feature" data-reveal><figure class="photo-scene handover-scene" data-scene><img class="scene-image" src="/sections/al-qusais-workshop-access.webp" alt="Unbranded mid-2010s charcoal SUV with modest door scratches outside a local Al Qusais-style workshop beside apartment parking, with a representative reviewing details" width="1440" height="960" loading="lazy" decoding="async" /></figure><aside class="handover-brief"><p class="eyebrow">Before arrangements are agreed</p><h3>A clear access brief</h3><ol>{handoverNotes.map(([icon,title,copy])=><li><i class={`ph ${icon}`} aria-hidden="true"></i><div><h4>{title}</h4><p>{copy}</p></div></li>)}</ol><SectionActionButton href="/free-quote" label="Start my valuation" intent="valuation" /></aside></div><p class="business-note" data-reveal>For several business vehicles, share a vehicle list and individual parking positions. Explore <a href="/fleet-disposal/">fleet disposal</a> for commercial enquiries.</p></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="process-heading" data-reveal><div><p class="eyebrow">Valuation &amp; collection planning</p><h2 id="process-title">Clear details.<br /><span>A considered next step.</span></h2></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><div class="step-marker"><span>0{index+1}</span><LocationGlyph kind={icon} /></div><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>

    <section class="nearby-section" aria-labelledby="nearby-title"><div class="smc-container" data-reveal><p class="eyebrow">More published Dubai guides</p><h2 id="nearby-title">Explore other collection settings.</h2><nav class="nearby-links" aria-label="More Dubai location guides"><SectionActionButton href="/locations/dubai/" label="All Dubai" intent="process" icon="ph-map-trifold" /><SectionActionButton href="/locations/dubai/al-quoz/" label="Al Quoz" intent="process" icon="ph-warehouse" /><SectionActionButton href="/locations/dubai/ras-al-khor/" label="Ras Al Khor" intent="process" icon="ph-car-profile" /><SectionActionButton href="/locations/dubai/dubai-investments-park/" label="DIP" intent="process" icon="ph-buildings" /></nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Al Qusais<br /><span>collection questions.</span></h2><p>Practical information for residential parking, local workshops and business premises.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><LocationGlyph kind="vehicle" /><h2 id="final-title">Have a car in Al Qusais<br /><span>you want to sell or scrap?</span></h2><p>Share the details, known condition and exact collection location to start a free valuation.</p><SectionActionButton href="/free-quote" label="Get My Free Valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>

.al-qusais-page{color:#193e2b;background:#fff;overflow:clip}.al-qusais-page :is(h1,h2,h3,p,figure){margin:0}.al-qusais-page :is(h1,h2){letter-spacing:-.05em}.al-qusais-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.al-qusais-page h2 span,.accent{color:#43804a}.al-qusais-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.al-qusais-page :is(a,button,summary):focus-visible{outline:3px solid #3181ab;outline-offset:4px}.al-qusais-page [id]{scroll-margin-top:35px}.page-progress{display:none;position:fixed;top:0;left:0;right:0;height:3px;background:#74a952;z-index:110;transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}.motion-ready .page-progress{display:block}.motion-ready [data-reveal]{opacity:0;transform:translateY(20px);transition:opacity 650ms ease,transform 650ms ease;transition-delay:var(--reveal-delay,0ms)}.motion-ready [data-reveal].is-visible{opacity:1;transform:none}
@media(hover:hover){.al-qusais-page :global(.section-action:hover){transform:translateY(-3px);box-shadow:0 16px 28px #173d2925}.al-qusais-page :global(.section-action:hover i){transform:scale(1.05) rotate(-4deg)}.photo-scene:hover .scene-image{transform:scale(1.075) translate3d(0,var(--scene-shift,0px),0)}}
@media(prefers-reduced-motion:reduce){.al-qusais-page [data-reveal]{opacity:1!important;transform:none!important;transition:none!important}.page-progress{display:none!important}.al-qusais-page :global(.section-action),.al-qusais-page :global(.section-action i),.scene-image{transition:none!important;transform:none!important}.al-qusais-page :global(.section-action:hover),.al-qusais-page :global(.section-action:hover i){transform:none!important}}

.coverage-section{background:#f7f9f3}.coverage-layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:65px;align-items:start}.coverage-layout header h2{margin:17px 0 23px}.coverage-layout header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5b735f}.coverage-layout .eyebrow{font-size:10px}.local-note{display:flex;gap:15px;padding-top:23px;margin-top:23px!important;border-top:1px solid #d4e2c9;font-size:14px!important}.local-note>:global(.location-glyph){width:35px;height:35px;flex-shrink:0;color:#4a7b48}.coverage-settings{background:#fff;border:1px solid #d3e1c7;border-radius:24px;overflow:hidden}.coverage-settings details+details{border-top:1px solid #d9e5ce}.coverage-settings summary{display:flex;align-items:center;gap:15px;list-style:none;cursor:pointer;padding:22px 24px;font-size:20px;font-weight:750;line-height:1.5}.coverage-settings summary::-webkit-details-marker{display:none}.coverage-settings summary>:global(.location-glyph){width:31px;height:31px;flex-shrink:0;color:#4f7d48}.coverage-settings summary i{margin-left:auto;font-size:22px;color:#4d7c48;flex-shrink:0}.coverage-settings details[open] summary{background:#f0f6e8}.coverage-settings details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.coverage-settings details>p{font-size:14px;line-height:1.85;color:#56705b;padding:0 24px 23px 70px;background:#f0f6e8}
.recovery-section{padding:55px 0 0;background:radial-gradient(ellipse at 2% 70%,#e1edd4aa,transparent 60%)}.recovery-feature{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);border-radius:26px;overflow:hidden;background:#173d2b;box-shadow:0 20px 38px #21442a14}.photo-scene{position:relative;isolation:isolate;overflow:hidden;background:#e2ebd8}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.025) translate3d(0,var(--scene-shift,0px),0);transition:transform 800ms cubic-bezier(.2,.7,.2,1)}.recovery-scene{min-height:460px}.recovery-scene .scene-image{object-position:50% 53%}.recovery-copy{padding:27px;align-self:center;min-width:0;color:#fff}.recovery-copy .eyebrow,.recovery-copy h2 span{color:#bfdca8}.recovery-copy h2{font-size:32px;line-height:1.1;margin:14px 0 16px}.recovery-copy>p:not(.eyebrow){font-size:14px;line-height:1.75;color:#d9e7cf}.recovery-copy ul{list-style:none;padding:0;margin:18px 0 20px;display:grid;gap:12px}.recovery-copy li{display:flex;align-items:center;gap:11px;font-size:13px;line-height:1.6;color:#e0ecd7}.recovery-copy li i{font-size:22px;color:#b5d79d;flex-shrink:0}.recovery-copy :global(.section-action){font-size:12px;width:100%;justify-content:space-between;min-height:46px;border-color:#9abf83}.recovery-copy :global(.section-action i){width:29px;height:29px;font-size:17px}
