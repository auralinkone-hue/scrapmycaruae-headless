---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import SectionActionButton from '../../../components/SectionActionButton.astro';
import LocationGlyph from '../../../components/LocationGlyph.astro';
import LocationsMotion from '../../../components/LocationsMotion.astro';
import { getVehicleData } from '../../../lib/vehicle-data';
import { dubaiLocations } from '../../../lib/locations';
const coverageName = dubaiLocations.find(name => name === 'Dubai Investments Park (DIP)');
const settings = [
  { id: 'dip-industrial', label: 'Industrial premises', icon: 'sharjah', heading: 'Inside the premises, beyond the area name.', copy: 'For a car at a DIP industrial or commercial unit, share the premises and exact parking position. Explain gates, available space and any permissions needed to reach it.', details: ['Premises and entrance', 'Vehicle position', 'Site entry requirements'] },
  { id: 'dip-workshops', label: 'Workshops & parking', icon: 'access', heading: 'A workshop bay or a business parking space.', copy: 'Tell us whether the vehicle is at a workshop, in staff parking or on a forecourt. Mention other parked cars, available keys and who can authorise its release.', details: ['Workshop or parking bay', 'Keys and known mobility', 'Authorised release contact'] },
  { id: 'dip-warehouses', label: 'Warehouses & fleets', icon: 'collection', heading: 'A clear location for every vehicle.', copy: 'For warehouse premises or fleet parking, identify each vehicle and where it stands. Explain loading-area restrictions, recovery space and the person coordinating the site handover.', details: ['Vehicle list and positions', 'Loading-area access', 'Site handover contact'] }
];
const accessNotes = [
  ['vehicle', 'An immobilised vehicle', 'Share known damage, flat tyres or locked wheels. A car that cannot roll may need a different recovery approach. There is no need to move it for an enquiry.'],
  ['keys', 'Keys & steering', 'Explain whether keys are available and whether you know of any steering restrictions. Share existing information without starting or testing a damaged car.'],
  ['access', 'Gates & permissions', 'Identify the entrance and who can confirm site entry and vehicle release. Mention clearance restrictions, other parked vehicles and controlled access.'],
  ['collection', 'Recovery working space', 'Describe the route to the car, usable space around it and any loading or work areas. Practical access needs review before collection arrangements are agreed.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood damage', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const fleetNotes = [
  ['ph-list-checks', 'One list', 'Make, model, year and known condition for each vehicle.'],
  ['ph-map-trifold', 'Each position', 'The premises, parking bay, keys and known mobility.'],
  ['ph-user-check', 'Clear handover', 'Authorised vehicle release and site access contacts.']
];
const steps = [
  ['vehicle', 'Share vehicle details', 'Start with make, model, year and your contact details.'],
  ['review', 'Describe the condition', 'Add known faults, damage, keys and vehicle mobility.'],
  ['coverage', 'Explain DIP access', 'Give the exact premises, parking position and site requirements.'],
  ['collection', 'Discuss the next step', 'Review the valuation and possible collection arrangements, subject to vehicle and access assessment.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Dubai Investments Park?', 'You can request a free valuation with the vehicle details, known condition and exact DIP location. Include keys, known mobility and the route to the vehicle. Possible collection arrangements depend on the vehicle and access review.'],
  ['Can a car at a DIP workshop be considered?', 'Yes, you can start an enquiry while the car is at a workshop. Give the workshop and bay or forecourt position, explain whether keys are available and identify who can authorise vehicle release and site entry.'],
  ['What information is useful for business parking?', 'Share the business premises and exact parking space. Explain gates, restricted access, clearance limits and whether other cars block the approach. Include a contact who can confirm access and handover requirements.'],
  ['What if keys are missing or the car cannot roll or steer?', 'Tell us about missing keys, locked wheels, flat tyres or known steering restrictions. These can affect the recovery approach and equipment. You do not need to start, test or move the car to request a valuation.'],
  ['Can several company vehicles in DIP be assessed?', 'You can start a fleet disposal enquiry. Provide a vehicle list with individual conditions, keys, known mobility and parking positions. Identify the authorised business contact and site contact; each vehicle and its access may need a separate review.'],
  ['Can a vehicle be considered at a warehouse or loading area?', 'Share the warehouse premises, exact vehicle position and the route through the yard. Explain loading activity and any limits on recovery space. Collection is subject to site permission, access arrangements and practical assessment.'],
  ['Who should arrange a company vehicle handover?', 'Identify the person authorised to sell or release the vehicle and the person who controls access to the premises. Explain any company, workshop or site requirements so the information and arrangements can be confirmed.'],
  ['Does requesting a valuation confirm collection?', 'No. The request starts the review. Vehicle details, condition, ownership information, location and access are discussed before collection arrangements are agreed. No fixed collection time or guaranteed entry is implied.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Dubai', item: 'https://www.scrapmycaruae.com/locations/dubai/' },
  { '@type': 'ListItem', position: 4, name: 'Dubai Investments Park', item: 'https://www.scrapmycaruae.com/locations/dubai/dubai-investments-park/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Dubai Investments Park | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Dubai Investments Park (DIP). Request a free valuation and discuss vehicle condition and collection access." canonical="/locations/dubai/dubai-investments-park/" ogImage="/sections/dip-sedan-recovery.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="dip-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="dip-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><a href="/locations/dubai/">Dubai</a><span aria-hidden="true">/</span><span aria-current="page">DIP</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="sharjah" />Dubai Investments Park · DIP</p><h1 id="dip-title"><span>Sell or scrap your car in</span> <span class="accent">Dubai Investments Park</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Dubai Investments Park (DIP). Share your vehicle details, condition and exact collection location to get started.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="sharjah" />Industrial &amp; commercial areas</li><li><LocationGlyph kind="access" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><header class="coverage-heading" data-reveal><div><p class="eyebrow">{coverageName}</p><h2 id="coverage-title">Different premises.<br /><span>The detail is in the access.</span></h2></div><p>From a business parking bay to an industrial unit, describe where the car is and how it can be reached. Choose the setting closest to your vehicle’s location.</p></header><div class="coverage-browser" data-reveal><div class="region-tabs" role="tablist" aria-label="DIP collection settings">{settings.map((setting,index)=><button type="button" id={`${setting.id}-tab`} role="tab" aria-controls={setting.id} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-region-tab={setting.id}><LocationGlyph kind={setting.icon} /><span>{setting.label}</span></button>)}</div>{settings.map(setting=><section class="region-panel" id={setting.id} role="tabpanel" aria-labelledby={`${setting.id}-tab`} data-region-panel><div><p class="eyebrow">{setting.label}</p><h3>{setting.heading}</h3><p>{setting.copy}</p></div><ul>{setting.details.map(detail=><li><i class="ph ph-check-circle" aria-hidden="true"></i>{detail}</li>)}</ul></section>)}</div></div></section>

    <section class="recovery-section" aria-labelledby="recovery-title"><div class="smc-container"><figure class="photo-scene recovery-scene" data-scene data-reveal><img class="scene-image" src="/sections/dip-sedan-recovery.webp" alt="Unbranded silver mid-2010s sedan with minor bumper scratches beside a professional flatbed and operator at a modern DIP-style industrial workshop estate" width="1440" height="960" loading="lazy" decoding="async" /><div class="recovery-shade" aria-hidden="true"></div><div class="recovery-copy"><p class="eyebrow">Industrial premises &amp; collection planning</p><h2 id="recovery-title">Vehicle condition.<br /><span>Practical site access.</span></h2><p>Nearby vehicles, gates and working areas can affect recovery access. Share the position and practical space around the car.</p></div><aside class="recovery-note"><LocationGlyph kind="coverage" /><div><h3>Start at the entrance.</h3><p>Identify the premises, parking position and the route to the vehicle.</p></div></aside></figure></div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container"><header class="access-heading" data-reveal><p class="eyebrow">Industrial premises &amp; vehicle access</p><h2 id="access-title">What can the site confirm?</h2><p>A useful enquiry combines known vehicle condition with practical access information.</p></header><div class="access-notes">{accessNotes.map(([icon,title,copy])=><article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div><SectionActionButton href="/car-removal/" label="Explore car collection" intent="process" icon="ph-truck" /></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Find the right<br /><span>vehicle guide.</span></h2><p>Use the guide that best fits the damage or fault, or read the wider <a href="/sell-my-car/">sell my car process</a>.</p></header><nav class="service-buttons" aria-label="DIP vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section fleet-section" aria-labelledby="fleet-title"><div class="smc-container"><header class="fleet-heading" data-reveal><div><p class="eyebrow">Commercial vehicles &amp; fleet disposal</p><h2 id="fleet-title">Commercial vehicles.<br /><span>A clearer fleet enquiry.</span></h2></div><p>For company cars, workshop vehicles or a fleet, share each vehicle’s condition, parking position and authorised handover contact.</p></header><div class="fleet-layout"><figure class="photo-scene fleet-scene" data-scene data-reveal><img class="scene-image" src="/sections/dip-commercial-vehicles.webp" alt="Unbranded white mid-2010s compact sedan and dark modern SUV parked at a DIP-style commercial workshop forecourt with a site representative reviewing vehicle details" width="1440" height="960" loading="lazy" decoding="async" /></figure><div class="fleet-planner" data-reveal><div class="planner-label"><LocationGlyph kind="review" /><h3>Prepare your fleet enquiry</h3></div><ol>{fleetNotes.map(([icon,title,copy],index)=><li><span class="brief-number">0{index+1}</span><i class={`ph ${icon}`} aria-hidden="true"></i><div><h4>{title}</h4><p>{copy}</p></div></li>)}</ol><SectionActionButton href="/fleet-disposal/" label="Discuss fleet disposal" intent="contact" icon="ph-truck" /></div></div></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container process-layout"><header data-reveal><p class="eyebrow">Valuation &amp; collection planning</p><h2 id="process-title">From the details<br /><span>to the next discussion.</span></h2><p>The valuation starts with the car. Exact DIP location, site permission and access help explain what collection arrangements may be possible.</p><SectionActionButton href="/free-quote" label="Start my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><span class="step-number">0{index+1}</span><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></div></section>

    <section class="nearby-section" aria-labelledby="nearby-title"><div class="smc-container" data-reveal><p class="eyebrow">Published Dubai location guides</p><h2 id="nearby-title">More industrial &amp; workshop settings.</h2><nav class="nearby-links" aria-label="More Dubai collection guides"><SectionActionButton href="/locations/dubai/jebel-ali/" label="Jebel Ali" intent="process" icon="ph-truck" /><SectionActionButton href="/locations/dubai/al-quoz/" label="Al Quoz" intent="process" icon="ph-warehouse" /><SectionActionButton href="/locations/dubai/ras-al-khor/" label="Ras Al Khor" intent="process" icon="ph-car-profile" /><SectionActionButton href="/locations/dubai/" label="All Dubai" intent="process" icon="ph-map-trifold" /></nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><header class="faq-heading" data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Dubai Investments Park<br /><span>vehicle collection questions.</span></h2></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><div><p class="eyebrow">Your car. Its exact DIP location.</p><h2 id="final-title">Tell us about the vehicle.<br /><span>And where it is parked.</span></h2><p>Share the details, condition and collection location to start a free valuation.</p></div><SectionActionButton href="/free-quote" label="Get My Free Valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>


.dip-page{color:#193e2b;background:#fff;overflow:clip}.dip-page :is(h1,h2,h3,p,figure){margin:0}.dip-page :is(h1,h2){letter-spacing:-.05em}.dip-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.dip-page h2 span,.accent{color:#43804a}.dip-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.dip-page :is(a,button,summary):focus-visible{outline:3px solid #3181ab;outline-offset:4px}.dip-page [id]{scroll-margin-top:35px}.page-progress{display:none;position:fixed;top:0;left:0;right:0;height:3px;background:#74a952;z-index:110;transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}.motion-ready .page-progress{display:block}.motion-ready [data-reveal]{opacity:0;transform:translateY(20px);transition:opacity 650ms ease,transform 650ms ease;transition-delay:var(--reveal-delay,0ms)}.motion-ready [data-reveal].is-visible{opacity:1;transform:none}
@media(hover:hover){.dip-page :global(.section-action:hover){transform:translateY(-3px);box-shadow:0 16px 28px #173d2925}.dip-page :global(.section-action:hover i){transform:scale(1.05) rotate(-4deg)}.photo-scene:hover .scene-image{transform:scale(1.075) translate3d(0,var(--scene-shift,0px),0)}}
@media(prefers-reduced-motion:reduce){.dip-page [data-reveal]{opacity:1!important;transform:none!important;transition:none!important}.page-progress{display:none!important}.dip-page :global(.section-action),.dip-page :global(.section-action i),.scene-image{transition:none!important;transform:none!important}.dip-page :global(.section-action:hover),.dip-page :global(.section-action:hover i){transform:none!important}}


.hero-copy h1{font-size:clamp(2rem,3.1vw,2.85rem)}.coverage-heading{display:grid;grid-template-columns:1.3fr .8fr;gap:60px;align-items:end;margin-bottom:32px}.coverage-heading h2{margin-top:17px}.coverage-heading>p{font-size:15px;line-height:1.85;color:#59715d}.coverage-browser{border:1px solid #d2e0c6;border-radius:26px;overflow:hidden;background:#f6f9f1;box-shadow:0 18px 36px #24462b0a}.region-tabs{display:none}.tabs-ready .region-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:10px;background:#eaf2df;border-bottom:1px solid #d6e3ca}.region-tabs button{display:flex;align-items:center;justify-content:center;gap:13px;min-height:78px;border:1px solid transparent;border-radius:18px;background:transparent;font:inherit;font-weight:800;font-size:15px;line-height:1.6;color:#506f4f;cursor:pointer;transition:background 200ms ease,color 200ms ease,box-shadow 200ms ease}.region-tabs button>:global(.location-glyph){width:32px;height:32px;flex-shrink:0}.region-tabs button[aria-selected='true']{background:#194a2d;color:#f4f8ed;box-shadow:0 8px 18px #1c4e2920}.region-tabs button:hover:not([aria-selected='true']){background:#dbe8cd;color:#254f31}.region-panel{display:grid;grid-template-columns:1.4fr .8fr;gap:60px;padding:35px 38px;align-items:center}.region-panel+.region-panel{border-top:1px solid #d6e3ca}.tabs-ready .region-panel{border-top:0}.region-panel[hidden]{display:none!important}.region-panel h3{font-size:28px;margin:13px 0 19px;max-width:600px}.region-panel p:not(.eyebrow){font-size:14px;line-height:1.85;color:#58705c;max-width:650px}.region-panel ul{list-style:none;padding:0;margin:0;display:grid;gap:17px}.region-panel li{display:flex;gap:12px;align-items:flex-start;font-size:14px;font-weight:650;line-height:1.7;color:#406645}.region-panel li i{font-size:24px;color:#5b884f;flex-shrink:0}
.recovery-section{padding:0 0 15px;background:radial-gradient(ellipse at 100% 60%,#dce9cebb,transparent 65%)}.photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;background:#183d2b;box-shadow:0 22px 45px #24452a18}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}.recovery-scene{min-height:780px}.recovery-scene .scene-image{object-position:55% 55%}.recovery-shade{position:absolute;inset:0;background:linear-gradient(180deg,#082419ed,transparent 55%)}.recovery-copy{position:relative;z-index:1;color:#fff;max-width:650px;padding:38px 40px;margin-left:auto}.recovery-copy .eyebrow,.recovery-copy h2 span{color:#c1dda9}.recovery-copy h2{font-size:clamp(2.1rem,3.5vw,3.2rem);margin:16px 0 21px}.recovery-copy>p:not(.eyebrow){font-size:14px;line-height:1.85;color:#e0ecd7;max-width:550px}.recovery-note{position:absolute;z-index:1;left:30px;bottom:30px;display:flex;gap:17px;background:#fff;color:#21492e;border-radius:22px;padding:24px;width:385px;box-shadow:0 16px 30px #102e2222}.recovery-note>:global(.location-glyph){width:37px;height:37px;color:#4d7d49;flex-shrink:0}.recovery-note h3{font-size:23px;margin:3px 0 13px}.recovery-note p{font-size:14px;line-height:1.8;color:#58715d}
