---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import SectionActionButton from '../../../components/SectionActionButton.astro';
import LocationGlyph from '../../../components/LocationGlyph.astro';
import LocationsMotion from '../../../components/LocationsMotion.astro';
import { getVehicleData } from '../../../lib/vehicle-data';
import { abuDhabiCoverageGroups } from '../../../lib/abu-dhabi-coverage';
const area = abuDhabiCoverageGroups.find(area => area.id === 'mohammed-bin-zayed-city')!;
const settings = [
  ['villa-compounds', 'access', 'Residential villas & compounds', 'Share the villa or compound location and the vehicle’s position on the driveway or inside the gate. Explain the entrance and who can confirm permission to enter.'],
  ['community-parking', 'coverage', 'Apartments & community parking', 'Identify the building and exact parking bay, including whether it is outdoor or covered. Mention barriers, security arrangements and other vehicles around the car.'],
  ['outdoor-parking', 'vehicle', 'Driveways & outdoor vehicle parking', 'Describe the surface, kerb, approach and space beside the vehicle. For roadside parking, explain the exact position and any restrictions the site contact can confirm.']
];
const accessNotes = [
  ['coverage', 'The exact parking position', 'Driveway, marked bay or roadside space: explain where the car stands and the route from it to the road. Mention kerbs, slopes and nearby parked vehicles.'],
  ['keys', 'Keys & known mobility', 'Tell us about missing keys, flat tyres, locked wheels and known rolling or steering restrictions. You do not need to test or move a damaged car to enquire.'],
  ['access', 'Compound gates & permission', 'Explain gate width, barriers and security requirements. Share who can authorise entry and release, including any building or compound contact.'],
  ['collection', 'Room for recovery equipment', 'Describe the space around the car and the approach from the street. A vehicle inside a narrow driveway may need a different access review from one in an open bay.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood damage', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const handoverNotes = [
  ['ph-map-trifold', 'Building & parking bay', 'Exact location, outdoor or covered position.'],
  ['ph-key', 'Vehicle movement', 'Keys, tyres and known rolling or steering limits.'],
  ['ph-user-check', 'Access & release contact', 'Building permission and authorised handover.']
];
const steps = [
  ['vehicle', 'Share the car details', 'Start with make, model, year and contact details.'],
  ['review', 'Explain the known condition', 'Include damage, faults, keys and mobility.'],
  ['coverage', 'Describe the parking', 'Give the MBZ City location, bay or driveway and entry requirements.'],
  ['collection', 'Review the next step', 'Discuss the valuation and possible arrangements after the vehicle and access review.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Mohammed Bin Zayed City?', 'You can request a free valuation for an unwanted, damaged or non-running car in Mohammed Bin Zayed City, Abu Dhabi. Share its details, known condition and exact parking location. Possible collection arrangements depend on the individual vehicle and access review.'],
  ['What information helps for a car on a villa driveway?', 'Provide the exact villa or compound location and where the car is parked. Explain the driveway surface, slope, gate width, nearby vehicles and access from the street. Identify who can authorise entry and handover.'],
  ['Can a car in apartment or community parking be considered?', 'You can start an enquiry. Identify the building and parking bay, whether the space is outdoor or covered and any barriers or security requirements. Describe the route to the vehicle and what is known about rolling and steering.'],
  ['What if my car is parked beside the road?', 'Share the exact position and nearby access points, and explain any kerb, surrounding vehicles or restrictions you know about. The practical recovery approach and any permissions need review before arrangements are agreed.'],
  ['Who should arrange compound or building access?', 'Share the contact who controls entry and the person who can authorise the vehicle’s release; they may be different people. Explain security, gate or building permission requirements so these can be confirmed before arrangements are agreed.'],
  ['Can I enquire if keys are missing or a tyre is flat?', 'Yes. Mention missing keys, flat tyres, locked wheels and known steering or rolling restrictions. These details may affect equipment and working space. Share what is already known without starting, testing or moving a damaged car.'],
  ['Is MBZ City another name for Mohammed Bin Zayed City?', 'MBZ City is a commonly used short name for Mohammed Bin Zayed City in Abu Dhabi. Please share the full location and exact parking position so the enquiry does not rely on the community name alone.'],
  ['Does a free valuation reserve a collection time?', 'No. A free valuation request starts the review. Vehicle details, condition, ownership information, exact location and practical access need discussion before collection arrangements are agreed. No fixed collection time or guaranteed collection is implied.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Abu Dhabi', item: 'https://www.scrapmycaruae.com/locations/abu-dhabi/' },
  { '@type': 'ListItem', position: 4, name: 'Mohammed Bin Zayed City', item: 'https://www.scrapmycaruae.com/locations/abu-dhabi/mohammed-bin-zayed-city/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Mohammed Bin Zayed City | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Mohammed Bin Zayed City, Abu Dhabi. Request a free valuation and discuss residential parking and collection access." canonical="/locations/abu-dhabi/mohammed-bin-zayed-city/" ogImage="/sections/mbz-city-villa-recovery.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="mbz-city-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="mbz-city-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><a href="/locations/abu-dhabi/">Abu Dhabi</a><span aria-hidden="true">/</span><span aria-current="page">MBZ City</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="access" /> MBZ City · Abu Dhabi</p><h1 id="mbz-city-title"><span>Sell or scrap your car</span> <span class="accent">in Mohammed Bin Zayed City</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Mohammed Bin Zayed City, Abu Dhabi. Share your vehicle details, condition and exact collection location to get started.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="access" />Residential &amp; villa parking</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><header class="yard-heading" data-reveal><div><p class="eyebrow">Mohammed Bin Zayed City coverage</p><h2 id="coverage-title">At home.<br /><span>In your community.</span></h2></div><p>{area.copy}</p></header><div class="coverage-settings" data-reveal>{settings.map(([id,icon,title,copy],index)=><details id={id} open={index===0}><summary><LocationGlyph kind={icon} /><span>{title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></div></section>

    <section class="recovery-section" aria-labelledby="recovery-title"><div class="smc-container"><div class="recovery-feature" data-reveal><figure class="photo-scene recovery-scene" data-scene><img class="scene-image" src="/sections/mbz-city-villa-recovery.webp" alt="Metallic-blue mid-2010s hatchback with minor bumper damage and a wheel dolly near a villa gate in an Abu Dhabi residential street, with a recovery professional" width="1440" height="960" loading="lazy" decoding="async" /></figure><div class="recovery-copy"><p class="eyebrow">Residential vehicle recovery</p><h2 id="recovery-title">A driveway is more<br /><span>than a parking spot.</span></h2><p>Gates, kerbs and the space beside a parked car can shape access. Tell us where it stands and what is already known about moving it.</p><ul><li><i class="ph ph-buildings" aria-hidden="true"></i>Driveway, gate &amp; approach</li><li><i class="ph ph-car-profile" aria-hidden="true"></i>Vehicle mobility &amp; clear space</li></ul><SectionActionButton href="/car-removal/" label="Explore car collection" intent="process" icon="ph-truck" /></div></div></div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container"><header class="section-heading" data-reveal><p class="eyebrow">Residential parking &amp; vehicle access</p><h2 id="access-title">From the parking space<br /><span>to the street.</span></h2><p>Useful access details help explain the setting without asking you to move or test the car.</p></header><div class="access-notes">{accessNotes.map(([icon,title,copy])=><article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Find the right<br /><span>vehicle guide.</span></h2><p>Choose the relevant condition guide or explore the wider <a href="/sell-my-car/">sell my car process</a>.</p></header><nav class="service-buttons" aria-label="MBZ City vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section handover-section" aria-labelledby="handover-title"><div class="smc-container"><header class="handover-heading" data-reveal><div><p class="eyebrow">Villa &amp; apartment vehicle collection</p><h2 id="handover-title">Family car.<br /><span>Practical parking details.</span></h2></div><p>A family vehicle in a community bay needs a clear parking description, just as a car behind a villa gate needs access information. Share the details that are already available.</p></header><div class="handover-feature" data-reveal><figure class="photo-scene handover-scene" data-scene><img class="scene-image" src="/sections/mbz-city-community-mpv.webp" alt="Pearl-white mid-2010s family MPV with modest wear viewed from the rear in an Abu Dhabi community outdoor parking bay beside apartment buildings and landscaping" width="1440" height="960" loading="lazy" decoding="async" /></figure><aside class="handover-brief"><p class="eyebrow">Before arrangements are agreed</p><h3>A simple parking brief</h3><ol>{handoverNotes.map(([icon,title,copy])=><li><i class={`ph ${icon}`} aria-hidden="true"></i><div><h4>{title}</h4><p>{copy}</p></div></li>)}</ol><SectionActionButton href="/free-quote" label="Start my valuation" intent="valuation" /></aside></div><p class="business-note" data-reveal>A vehicle’s condition and parking setting are reviewed together. Read the <a href="/car-removal/">car collection guide</a> for access information, or explore <a href="/fleet-disposal/">fleet disposal</a> for business-owned vehicles.</p></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="process-heading" data-reveal><div><p class="eyebrow">Valuation &amp; collection planning</p><h2 id="process-title">Clear details.<br /><span>A considered next step.</span></h2></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><div class="step-marker"><span>0{index+1}</span><LocationGlyph kind={icon} /></div><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>

    <section class="nearby-section" aria-labelledby="nearby-title"><div class="smc-container" data-reveal><p class="eyebrow">Abu Dhabi &amp; UAE location guides</p><h2 id="nearby-title">Explore Abu Dhabi access guides.</h2><nav class="nearby-links" aria-label="Abu Dhabi location guides"><SectionActionButton href="/locations/abu-dhabi/" label="All Abu Dhabi" intent="process" icon="ph-map-trifold" /><SectionActionButton href="/locations/abu-dhabi/musaffah/" label="Musaffah" intent="process" icon="ph-warehouse" /><SectionActionButton href="/locations/abu-dhabi/#khalifa-city" label="Khalifa City" intent="process" icon="ph-buildings" /><SectionActionButton href="/locations/" label="All UAE locations" intent="process" icon="ph-map-trifold" /></nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">MBZ City<br /><span>collection questions.</span></h2><p>Local information for villa driveways, apartment bays and community parking.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><LocationGlyph kind="vehicle" /><h2 id="final-title">A car in MBZ City?<br /><span>Start with where it is.</span></h2><p>Share the details, known condition and exact collection location to start a free valuation.</p><SectionActionButton href="/free-quote" label="Get My Free Valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>

.mbz-city-page{color:#193e2b;background:#fff;overflow:clip}.mbz-city-page :is(h1,h2,h3,p,figure){margin:0}.mbz-city-page :is(h1,h2){letter-spacing:-.05em}.mbz-city-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.mbz-city-page h2 span,.accent{color:#43804a}.mbz-city-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.mbz-city-page :is(a,button,summary):focus-visible{outline:3px solid #3181ab;outline-offset:4px}.mbz-city-page [id]{scroll-margin-top:35px}.page-progress{display:none;position:fixed;top:0;left:0;right:0;height:3px;background:#74a952;z-index:110;transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}.motion-ready .page-progress{display:block}.motion-ready [data-reveal]{opacity:0;transform:translateY(20px);transition:opacity 650ms ease,transform 650ms ease;transition-delay:var(--reveal-delay,0ms)}.motion-ready [data-reveal].is-visible{opacity:1;transform:none}
@media(hover:hover){.mbz-city-page :global(.section-action:hover){transform:translateY(-3px);box-shadow:0 16px 28px #173d2925}.mbz-city-page :global(.section-action:hover i){transform:scale(1.05) rotate(-4deg)}.photo-scene:hover .scene-image{transform:scale(1.075) translate3d(0,var(--scene-shift,0px),0)}}
@media(prefers-reduced-motion:reduce){.mbz-city-page [data-reveal]{opacity:1!important;transform:none!important;transition:none!important}.page-progress{display:none!important}.mbz-city-page :global(.section-action),.mbz-city-page :global(.section-action i),.scene-image{transition:none!important;transform:none!important}.mbz-city-page :global(.section-action:hover),.mbz-city-page :global(.section-action:hover i){transform:none!important}}

.coverage-section{background:#f7f9f3}.coverage-layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:65px;align-items:start}.coverage-layout header h2{margin:17px 0 23px}.coverage-layout header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5b735f}.coverage-layout .eyebrow{font-size:10px}.local-note{display:flex;gap:15px;padding-top:23px;margin-top:23px!important;border-top:1px solid #d4e2c9;font-size:14px!important}.local-note>:global(.location-glyph){width:35px;height:35px;flex-shrink:0;color:#4a7b48}.coverage-settings{background:#fff;border:1px solid #d3e1c7;border-radius:24px;overflow:hidden}.coverage-settings details+details{border-top:1px solid #d9e5ce}.coverage-settings summary{display:flex;align-items:center;gap:15px;list-style:none;cursor:pointer;padding:22px 24px;font-size:20px;font-weight:750;line-height:1.5}.coverage-settings summary::-webkit-details-marker{display:none}.coverage-settings summary>:global(.location-glyph){width:31px;height:31px;flex-shrink:0;color:#4f7d48}.coverage-settings summary i{margin-left:auto;font-size:22px;color:#4d7c48;flex-shrink:0}.coverage-settings details[open] summary{background:#f0f6e8}.coverage-settings details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.coverage-settings details>p{font-size:14px;line-height:1.85;color:#56705b;padding:0 24px 23px 70px;background:#f0f6e8}
.recovery-section{padding:55px 0 0;background:radial-gradient(ellipse at 2% 70%,#e1edd4aa,transparent 60%)}.recovery-feature{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);border-radius:26px;overflow:hidden;background:#173d2b;box-shadow:0 20px 38px #21442a14}.photo-scene{position:relative;isolation:isolate;overflow:hidden;background:#e2ebd8}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.025) translate3d(0,var(--scene-shift,0px),0);transition:transform 800ms cubic-bezier(.2,.7,.2,1)}.recovery-scene{min-height:460px}.recovery-scene .scene-image{object-position:50% 53%}.recovery-copy{padding:27px;align-self:center;min-width:0;color:#fff}.recovery-copy .eyebrow,.recovery-copy h2 span{color:#bfdca8}.recovery-copy h2{font-size:32px;line-height:1.1;margin:14px 0 16px}.recovery-copy>p:not(.eyebrow){font-size:14px;line-height:1.75;color:#d9e7cf}.recovery-copy ul{list-style:none;padding:0;margin:18px 0 20px;display:grid;gap:12px}.recovery-copy li{display:flex;align-items:center;gap:11px;font-size:13px;line-height:1.6;color:#e0ecd7}.recovery-copy li i{font-size:22px;color:#b5d79d;flex-shrink:0}.recovery-copy :global(.section-action){font-size:12px;width:100%;justify-content:space-between;min-height:46px;border-color:#9abf83}.recovery-copy :global(.section-action i){width:29px;height:29px;font-size:17px}
