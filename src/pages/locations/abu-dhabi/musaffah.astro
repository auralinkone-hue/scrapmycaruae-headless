---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import SectionActionButton from '../../../components/SectionActionButton.astro';
import LocationGlyph from '../../../components/LocationGlyph.astro';
import LocationsMotion from '../../../components/LocationsMotion.astro';
import { getVehicleData } from '../../../lib/vehicle-data';
import { abuDhabiCoverageGroups } from '../../../lib/abu-dhabi-coverage';
const area = abuDhabiCoverageGroups.find(area => area.id === 'musaffah')!;
const settings = [
  ['repair-facilities', 'sharjah', 'Workshops & repair facilities', 'Identify the repair facility and the vehicle’s exact bay or forecourt position. Share any existing condition assessment and the contact who can discuss release.'],
  ['industrial-yards', 'access', 'Industrial premises & vehicle yards', 'Describe the gate, approach road and vehicle position within the premises. Include any limits on equipment entry and the available space around the vehicle.'],
  ['business-fleets', 'collection', 'Commercial fleets & business parking', 'Provide a vehicle list, parking positions and individual conditions. Identify the authorised business representative and the person coordinating site access.']
];
const accessNotes = [
  ['vehicle', 'Known faults & immobilised vehicles', 'Explain existing mechanical faults, damage or an available workshop assessment. Describe what is already known without starting or moving a damaged vehicle.'],
  ['keys', 'Keys, rolling & steering', 'Mention missing keys, flat tyres, locked wheels and known movement restrictions. These details can affect working space and the recovery approach.'],
  ['access', 'Entrance & industrial access road', 'Describe the road approach, entrance, bay and any parked vehicles or equipment in the way. Note restrictions that the site contact can confirm.'],
  ['review', 'Permission & recovery space', 'Explain gates, entry permission and the space available for equipment. Identify who controls access and who can authorise vehicle release.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood damage', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const handoverNotes = [
  ['ph-car-profile', 'An individual vehicle record', 'Vehicle type, condition, keys and known mobility.'],
  ['ph-map-trifold', 'A practical access description', 'Premises, gate, parking position and equipment space.'],
  ['ph-user-check', 'A clear release contact', 'Business authority, site access and available documents.']
];
const steps = [
  ['vehicle', 'Tell us about the vehicle', 'Share make, model, year and contact details.'],
  ['review', 'Describe the known condition', 'Include faults, damage, keys and any workshop assessment.'],
  ['coverage', 'Explain the Musaffah location', 'Identify the premises, parking position and access requirements.'],
  ['collection', 'Discuss the next step', 'Review the valuation and practical arrangements before collection is agreed.']
];
const faqs = [
  ['Can I sell or scrap a non-running vehicle in Musaffah?', 'You can start a free valuation enquiry for an unwanted, damaged or non-running vehicle. Share the make, model, year, known condition and exact Musaffah location. Any possible collection arrangements follow the individual vehicle and access review.'],
  ['What information helps for a Musaffah workshop location?', 'Identify the workshop or repair facility, exact premises and vehicle position. Include the entrance, approach road and the contact who can confirm access. An industrial area name alone does not explain how equipment could reach the vehicle.'],
  ['Can I enquire about a business-owned pickup or fleet vehicle?', 'Provide the vehicle details, known condition and parking position, together with an authorised business contact. Mention fitted equipment and available ownership or vehicle documents. The suitability and requirements for an individual commercial vehicle need review.'],
  ['What if the vehicle is immobilised inside industrial premises?', 'Explain whether it is in a bay, yard or parking area, and describe the route to it. Share any known restrictions on rolling or steering, missing keys and space for equipment. Do not move or test a damaged vehicle just to enquire.'],
  ['Who should coordinate workshop release and gate access?', 'Share who can authorise the vehicle’s release and who controls site entry; these may be different people. Explain workshop, security or business permissions and any handover requirements so they can be confirmed before arrangements are agreed.'],
  ['Can several vehicles at one Musaffah business be reviewed?', 'Start a fleet disposal enquiry with a vehicle list, individual conditions, keys and exact parking positions. Provide the authorised business and site contacts. Each vehicle and its access may require a separate review, even where the vehicles share one site.'],
  ['Do mechanical faults change the valuation discussion?', 'Known faults, damage, vehicle details, mobility and available information can affect the review. Share any existing workshop assessment without treating an unconfirmed symptom as a diagnosis. The team can discuss what further information is needed.'],
  ['Is a valuation request a confirmed collection booking?', 'No. A request begins the review. Vehicle condition, ownership information, exact Musaffah premises, access and release requirements need discussion before collection arrangements are agreed. There is no fixed collection time or collection guarantee.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Abu Dhabi', item: 'https://www.scrapmycaruae.com/locations/abu-dhabi/' },
  { '@type': 'ListItem', position: 4, name: 'Musaffah', item: 'https://www.scrapmycaruae.com/locations/abu-dhabi/musaffah/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Musaffah Abu Dhabi | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Musaffah, Abu Dhabi. Request a free valuation and discuss vehicle condition, fleet parking and collection access." canonical="/locations/abu-dhabi/musaffah/" ogImage="/sections/musaffah-pickup-recovery.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="musaffah-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="musaffah-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><a href="/locations/abu-dhabi/">Abu Dhabi</a><span aria-hidden="true">/</span><span aria-current="page">Musaffah</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="access" /> Musaffah · Abu Dhabi</p><h1 id="musaffah-title"><span>Sell or scrap your car</span> <span class="accent">in Musaffah, Abu Dhabi</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Musaffah. Share your vehicle details, condition and exact collection location to get started.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running vehicles</li><li><LocationGlyph kind="access" />Workshops &amp; commercial fleets</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><header class="yard-heading" data-reveal><div><p class="eyebrow">Musaffah industrial &amp; automotive coverage</p><h2 id="coverage-title">Workshop, yard<br /><span>or business parking?</span></h2></div><p>{area.copy}</p></header><div class="coverage-settings" data-reveal>{settings.map(([id,icon,title,copy],index)=><details id={id} open={index===0}><summary><LocationGlyph kind={icon} /><span>{title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></div></section>

    <section class="recovery-section" aria-labelledby="recovery-title"><div class="smc-container"><div class="recovery-feature" data-reveal><figure class="photo-scene recovery-scene" data-scene><img class="scene-image" src="/sections/musaffah-pickup-recovery.webp" alt="Dark-grey mid-2010s double-cab pickup with modest fender damage viewed from the rear beside an unbranded flatbed in a Musaffah-style industrial service area" width="1440" height="960" loading="lazy" decoding="async" /></figure><div class="recovery-copy"><p class="eyebrow">Musaffah vehicle recovery</p><h2 id="recovery-title">Start with access.<br /><span>Plan around the vehicle.</span></h2><p>A pickup in an open yard and a car inside a repair facility can need different recovery arrangements. Share the exact position and known mobility.</p><ul><li><i class="ph ph-buildings" aria-hidden="true"></i>Industrial approach &amp; gate</li><li><i class="ph ph-car-profile" aria-hidden="true"></i>Vehicle mobility &amp; working space</li></ul><SectionActionButton href="/car-removal/" label="Explore car collection" intent="process" icon="ph-truck" /></div></div></div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container"><header class="section-heading" data-reveal><p class="eyebrow">Industrial parking &amp; recovery access</p><h2 id="access-title">The vehicle condition.<br /><span>The site conditions.</span></h2><p>Consider both the vehicle and the route to it. Details from the owner, workshop and site contact help explain the practical constraints.</p></header><div class="access-notes">{accessNotes.map(([icon,title,copy])=><article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Find the right<br /><span>vehicle guide.</span></h2><p>Choose the relevant condition guide or explore the wider <a href="/sell-my-car/">sell my car process</a>.</p></header><nav class="service-buttons" aria-label="Musaffah vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section handover-section" aria-labelledby="handover-title"><div class="smc-container"><header class="handover-heading" data-reveal><div><p class="eyebrow">Commercial fleets &amp; workshop handover</p><h2 id="handover-title">For the business.<br /><span>For each vehicle.</span></h2></div><p>For a single workshop vehicle or several business-owned cars, keep the vehicle information separate from site permissions. Both are useful when discussing valuation and possible collection.</p></header><div class="handover-feature" data-reveal><figure class="photo-scene handover-scene" data-scene><img class="scene-image" src="/sections/musaffah-workshop-assessment.webp" alt="Burgundy mid-2010s crossover with modest door scuffs awaiting assessment beside a workshop representative in a Musaffah-style commercial forecourt" width="1440" height="960" loading="lazy" decoding="async" /></figure><aside class="handover-brief"><p class="eyebrow">Business &amp; workshop enquiries</p><h3>Three parts to the handover</h3><ol>{handoverNotes.map(([icon,title,copy])=><li><i class={`ph ${icon}`} aria-hidden="true"></i><div><h4>{title}</h4><p>{copy}</p></div></li>)}</ol><SectionActionButton href="/free-quote" label="Start my valuation" intent="valuation" /></aside></div><p class="business-note" data-reveal>For several business vehicles, include a list with individual conditions and parking positions. Explore <a href="/fleet-disposal/">fleet disposal</a> for commercial enquiries.</p></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="process-heading" data-reveal><div><p class="eyebrow">Valuation &amp; collection planning</p><h2 id="process-title">Clear details.<br /><span>A considered next step.</span></h2></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><div class="step-marker"><span>0{index+1}</span><LocationGlyph kind={icon} /></div><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>

    <section class="nearby-section" aria-labelledby="nearby-title"><div class="smc-container" data-reveal><p class="eyebrow">Abu Dhabi &amp; UAE location guides</p><h2 id="nearby-title">Explore Abu Dhabi access guides.</h2><nav class="nearby-links" aria-label="Abu Dhabi location guides"><SectionActionButton href="/locations/abu-dhabi/" label="All Abu Dhabi" intent="process" icon="ph-map-trifold" /><SectionActionButton href="/locations/abu-dhabi/mohammed-bin-zayed-city/" label="MBZ City" intent="process" icon="ph-warehouse" /><SectionActionButton href="/locations/abu-dhabi/khalifa-city/" label="Khalifa City" intent="process" icon="ph-buildings" /><SectionActionButton href="/locations/" label="All UAE locations" intent="process" icon="ph-map-trifold" /></nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Musaffah vehicle<br /><span>collection questions.</span></h2><p>Information for Musaffah workshops, industrial premises and business vehicle enquiries.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><LocationGlyph kind="vehicle" /><h2 id="final-title">A vehicle in Musaffah?<br /><span>Tell us where it stands.</span></h2><p>Share the details, known condition and exact collection location to start a free valuation.</p><SectionActionButton href="/free-quote" label="Get My Free Valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>

.musaffah-page{color:#193e2b;background:#fff;overflow:clip}.musaffah-page :is(h1,h2,h3,p,figure){margin:0}.musaffah-page :is(h1,h2){letter-spacing:-.05em}.musaffah-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.musaffah-page h2 span,.accent{color:#43804a}.musaffah-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.musaffah-page :is(a,button,summary):focus-visible{outline:3px solid #3181ab;outline-offset:4px}.musaffah-page [id]{scroll-margin-top:35px}.page-progress{display:none;position:fixed;top:0;left:0;right:0;height:3px;background:#74a952;z-index:110;transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}.motion-ready .page-progress{display:block}.motion-ready [data-reveal]{opacity:0;transform:translateY(20px);transition:opacity 650ms ease,transform 650ms ease;transition-delay:var(--reveal-delay,0ms)}.motion-ready [data-reveal].is-visible{opacity:1;transform:none}
@media(hover:hover){.musaffah-page :global(.section-action:hover){transform:translateY(-3px);box-shadow:0 16px 28px #173d2925}.musaffah-page :global(.section-action:hover i){transform:scale(1.05) rotate(-4deg)}.photo-scene:hover .scene-image{transform:scale(1.075) translate3d(0,var(--scene-shift,0px),0)}}
@media(prefers-reduced-motion:reduce){.musaffah-page [data-reveal]{opacity:1!important;transform:none!important;transition:none!important}.page-progress{display:none!important}.musaffah-page :global(.section-action),.musaffah-page :global(.section-action i),.scene-image{transition:none!important;transform:none!important}.musaffah-page :global(.section-action:hover),.musaffah-page :global(.section-action:hover i){transform:none!important}}

.coverage-section{background:#f7f9f3}.coverage-layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:65px;align-items:start}.coverage-layout header h2{margin:17px 0 23px}.coverage-layout header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5b735f}.coverage-layout .eyebrow{font-size:10px}.local-note{display:flex;gap:15px;padding-top:23px;margin-top:23px!important;border-top:1px solid #d4e2c9;font-size:14px!important}.local-note>:global(.location-glyph){width:35px;height:35px;flex-shrink:0;color:#4a7b48}.coverage-settings{background:#fff;border:1px solid #d3e1c7;border-radius:24px;overflow:hidden}.coverage-settings details+details{border-top:1px solid #d9e5ce}.coverage-settings summary{display:flex;align-items:center;gap:15px;list-style:none;cursor:pointer;padding:22px 24px;font-size:20px;font-weight:750;line-height:1.5}.coverage-settings summary::-webkit-details-marker{display:none}.coverage-settings summary>:global(.location-glyph){width:31px;height:31px;flex-shrink:0;color:#4f7d48}.coverage-settings summary i{margin-left:auto;font-size:22px;color:#4d7c48;flex-shrink:0}.coverage-settings details[open] summary{background:#f0f6e8}.coverage-settings details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.coverage-settings details>p{font-size:14px;line-height:1.85;color:#56705b;padding:0 24px 23px 70px;background:#f0f6e8}
.recovery-section{padding:55px 0 0;background:radial-gradient(ellipse at 2% 70%,#e1edd4aa,transparent 60%)}.recovery-feature{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);border-radius:26px;overflow:hidden;background:#173d2b;box-shadow:0 20px 38px #21442a14}.photo-scene{position:relative;isolation:isolate;overflow:hidden;background:#e2ebd8}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.025) translate3d(0,var(--scene-shift,0px),0);transition:transform 800ms cubic-bezier(.2,.7,.2,1)}.recovery-scene{min-height:460px}.recovery-scene .scene-image{object-position:50% 53%}.recovery-copy{padding:27px;align-self:center;min-width:0;color:#fff}.recovery-copy .eyebrow,.recovery-copy h2 span{color:#bfdca8}.recovery-copy h2{font-size:32px;line-height:1.1;margin:14px 0 16px}.recovery-copy>p:not(.eyebrow){font-size:14px;line-height:1.75;color:#d9e7cf}.recovery-copy ul{list-style:none;padding:0;margin:18px 0 20px;display:grid;gap:12px}.recovery-copy li{display:flex;align-items:center;gap:11px;font-size:13px;line-height:1.6;color:#e0ecd7}.recovery-copy li i{font-size:22px;color:#b5d79d;flex-shrink:0}.recovery-copy :global(.section-action){font-size:12px;width:100%;justify-content:space-between;min-height:46px;border-color:#9abf83}.recovery-copy :global(.section-action i){width:29px;height:29px;font-size:17px}
