---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import LocationsMotion from '../../components/LocationsMotion.astro';
import LocationGlyph from '../../components/LocationGlyph.astro';
import { getVehicleData } from '../../lib/vehicle-data';
import { abuDhabiCoverageGroups } from '../../lib/abu-dhabi-coverage';

const accessNotes = [
  ['access', 'Basement parking', 'Parking level, entrance clearance, ramp and columns between the car and the exit.'],
  ['keys', 'Compounds & gates', 'Entrance width, security checks and who can arrange access to the vehicle.'],
  ['sharjah', 'Industrial yards', 'Exact premises, loading space, nearby obstructions and release permission.'],
  ['vehicle', 'Non-running vehicles', 'Known wheel movement, steering, keys and any damage affecting mobility.'],
  ['coverage', 'Restricted access', 'Site or building approval, entry requirements and an available contact.'],
  ['collection', 'Several vehicles', 'Vehicle count, individual condition, each parking position and handover contacts.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const fleetBrief = [
  ['vehicle', 'Vehicle list', 'Make, model, year, known condition and mobility for each vehicle.'],
  ['coverage', 'Site access', 'Gate, parking positions, restrictions and space for recovery equipment.'],
  ['review', 'Release & handover', 'Authorised contact, available documents and who can release each vehicle.']
];
const steps = [
  ['vehicle', 'Share the vehicle details', 'Start with the make, model, year and your contact details.'],
  ['review', 'Explain the known condition', 'Include damage, symptoms, mobility and any information you already have.'],
  ['coverage', 'Describe the location & access', 'Tell us the Abu Dhabi area, parking position, entry restrictions and keys information.'],
  ['collection', 'Discuss your next step', 'Review the valuation and practical arrangements before agreeing a collection.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Abu Dhabi?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share the vehicle details, known condition, mobility and exact location. The assessment and possible collection arrangements depend on the individual vehicle and access review.'],
  ['Which Abu Dhabi areas can I enquire about?', 'You can ask about Musaffah, Mohammed Bin Zayed City, Khalifa City, Shakhbout City, Reem Island, Al Raha Beach and the other areas listed in this guide. Share the precise parking position so practical access can be considered. An area listing does not confirm a collection booking.'],
  ['Can a car be considered for collection from a basement?', 'Yes, the access can be discussed. Include the parking level, entrance clearance, ramp details and nearby obstacles. Explain what you already know about the car rolling or steering so a suitable approach can be reviewed.'],
  ['What should I share for a car inside a compound?', 'Provide the compound or building location, gate details, available space around the vehicle and any security or permission requirements. Explain who can give access and authorise the vehicle handover.'],
  ['Can you assess several vehicles at a Musaffah yard?', 'You can start a fleet disposal enquiry. Share a vehicle list, each known condition and parking position, site entry requirements and the authorised contact. Multiple vehicles may need separate reviews before collection arrangements can be discussed.'],
  ['What if the car has no keys or cannot roll?', 'Mention missing keys, locked wheels or restricted steering when you enquire. Describe what is already known; you do not need to start or move the car to request a valuation. These details can affect recovery equipment and access planning.'],
  ['What affects the valuation?', 'Vehicle details, known condition, damage, mobility, available information and location or access requirements can affect the review. A free valuation request does not commit you to selling and does not confirm a collection appointment.'],
  ['What documents will I need?', 'Tell the team which vehicle and ownership documents are available and whether anything is missing. They can explain the information and handover requirements for your circumstances before arrangements are agreed.'],
  ['Are these Abu Dhabi locations branch offices?', 'No. Area names indicate locations for valuation enquiries and collection discussions. They do not identify offices, depots, fixed routes or guaranteed collection times.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Abu Dhabi', item: 'https://www.scrapmycaruae.com/locations/abu-dhabi/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Abu Dhabi | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Abu Dhabi. Request a free valuation and share your vehicle condition and collection location." canonical="/locations/abu-dhabi/" ogImage="/sections/abu-dhabi-vehicle-collection.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="abu-page" data-location-hub>
    <div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="abu-title"><div class="smc-container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><span aria-current="page">Abu Dhabi</span></nav>
      <div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="abu-dhabi" /> Abu Dhabi vehicle valuation</p><h1 id="abu-title"><span>Sell or scrap your</span> <span class="accent">car in Abu Dhabi</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Abu Dhabi. Share the vehicle details, condition and collection location to start the process.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="abu-dhabi" />Abu Dhabi residential &amp; industrial areas</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div>
    </div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container coverage-layout">
      <header class="coverage-heading" data-reveal><p class="eyebrow">Abu Dhabi coverage overview</p><h2 id="coverage-title">Where the car is.<br /><span>What access needs.</span></h2><p>From Musaffah workshops to Khalifa City compounds and city parking, start with the area. Then share the entrance, parking position and known vehicle mobility.</p><div class="coverage-seal"><LocationGlyph kind="coverage" /><span>Local details.<br /><strong>Individual access review.</strong></span></div><SectionActionButton href="/locations/" label="Explore UAE coverage" intent="process" icon="ph-map-trifold" /></header>
      <div class="coverage-guides" data-reveal>{abuDhabiCoverageGroups.map((group, index) => <details id={group.id} open={index === 0}><summary><span class="guide-icon"><LocationGlyph kind={group.icon} /></span><span><small>{group.type}</small><strong>{group.name}</strong></span><i class="ph ph-plus" aria-hidden="true"></i></summary><div class="guide-content"><p>{group.copy}</p><ul class="area-tags">{group.areas.map(area => <li>{area}</li>)}</ul><SectionActionButton href="/free-quote" label={group.id === 'mohammed-bin-zayed-city' ? 'Value my car in MBZ City' : group.id === 'city-waterfront' ? 'Value my car in Abu Dhabi' : `Valuation in ${group.shortName}`} intent="valuation" /></div></details>)}<p class="coverage-note">Area names describe collection enquiries, not branches. Feasibility and arrangements are reviewed for each vehicle.</p></div>
    </div></section>

    <section class="environment-section" aria-labelledby="environment-title"><div class="smc-container photo-wrap">
      <figure class="photo-scene environment-scene" data-scene data-reveal><img class="scene-image" src="/sections/abu-dhabi-vehicle-collection.webp" alt="Older dusty silver sedan and recovery truck outside a palm-lined Abu Dhabi residential compound with an operator reviewing access" width="1440" height="960" loading="lazy" decoding="async" /><div class="environment-shade" aria-hidden="true"></div><div class="environment-copy"><div><p class="eyebrow">Residential. Commercial. Industrial.</p><h2 id="environment-title">The location changes.<br /><span>The details still matter.</span></h2></div><div><p>A basement, compound driveway or industrial yard can each need a different approach. Share clearance, permissions, vehicle mobility and the space around the car before collection is arranged.</p><SectionActionButton href="/car-removal/" label="Read the collection guide" intent="process" icon="ph-truck" /></div></div><figcaption>Illustrative Abu Dhabi collection preparation. Vehicle position and entrance access help inform the collection discussion.</figcaption></figure>
    </div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container"><header class="section-heading" data-reveal><div><p class="eyebrow">Local access considerations</p><h2 id="access-title">A useful picture<br /><span>of the parking situation.</span></h2></div><p>Tell us what you already know. Photos and clear access notes can help explain the route from the car to the collection vehicle.</p></header><div class="access-notes">{accessNotes.map(([icon, title, copy]) => <article data-reveal><span class="note-glyph"><LocationGlyph kind={icon} /></span><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><div class="vehicle-heading" data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Find a route for<br /><span>your car’s condition.</span></h2><p>Explore the relevant guide, then share the known condition and Abu Dhabi location. For broader selling options, visit our <a href="/sell-my-car/">sell my car guide</a>.</p></div><nav class="service-buttons" aria-label="Abu Dhabi vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href, label, icon]) => <SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section industrial-section" aria-labelledby="industrial-title"><div class="smc-container">
      <header class="industrial-heading" data-reveal><div><p class="eyebrow"><LocationGlyph kind="sharjah" /> Musaffah &amp; commercial sites</p><h2 id="industrial-title">Several vehicles.<br /><span>One well-prepared site brief.</span></h2></div><p>For a Musaffah workshop, industrial yard or fleet parking area, start with a vehicle list and the practical site information. Each vehicle’s condition and release arrangements may need separate review.</p></header>
      <div class="industrial-feature" data-reveal><figure class="photo-scene industrial-scene" data-scene><img class="scene-image" src="/sections/abu-dhabi-musaffah-fleet.webp" alt="Recovery coordinator reviewing an older fleet sedan and worn commercial van beside a flatbed truck in a Musaffah-style industrial yard" width="1440" height="960" loading="lazy" decoding="async" /><aside class="site-panel"><span class="note-glyph"><LocationGlyph kind="review" /></span><p class="eyebrow">For a clearer first discussion</p><h3>Start with the site.<br /><span>Then each vehicle.</span></h3><p>Share the gate, parking layout and available recovery space. Add known mobility and who can approve handover.</p><SectionActionButton href="/fleet-disposal/" label="Discuss fleet disposal" intent="contact" icon="ph-truck" /></aside><figcaption>Illustrative industrial collection planning. A vehicle list, clear access and an authorised site contact support a useful enquiry.</figcaption></figure></div>
      <div class="fleet-brief">{fleetBrief.map(([icon, title, copy], index) => <article data-reveal><span class="brief-number">0{index + 1}</span><LocationGlyph kind={icon} /><h3>{title}</h3><p>{copy}</p></article>)}</div>
    </div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container process-layout"><header data-reveal><p class="eyebrow">Valuation &amp; collection planning</p><h2 id="process-title">From the first details<br /><span>to the next step.</span></h2><p>The free valuation starts with your vehicle. Collection is discussed after the condition and location have been reviewed.</p><SectionActionButton href="/free-quote" label="Start my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon, title, copy], index) => <li data-reveal><span class="step-number">0{index + 1}</span><div><LocationGlyph kind={icon} /><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></div></section>

    <section class="area-section" aria-labelledby="area-title"><div class="smc-container area-inner" data-reveal><div><p class="eyebrow">Abu Dhabi area navigation</p><h2 id="area-title">Return to your<br /><span>local access guide.</span></h2></div><nav class="area-navigation" aria-label="Abu Dhabi area guides">{abuDhabiCoverageGroups.map(group => <SectionActionButton href={`#${group.id}`} label={group.shortName} intent="process" icon={group.id === 'musaffah' ? 'ph-warehouse' : 'ph-buildings'} />)}</nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><header class="faq-heading" data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Abu Dhabi<br /><span>collection questions.</span></h2></header><div class="faq-stack" data-reveal>{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><LocationGlyph kind="abu-dhabi" /><p class="eyebrow">Your vehicle. Your Abu Dhabi location.</p><h2 id="final-title">Let’s start<br /><span>with your car.</span></h2><p>Share the details, known condition and parking location to request a free valuation and discuss a practical next step.</p><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>
  .abu-page{color:#193e2b;background:#fff;overflow:clip}
  .abu-page :is(h1,h2,h3,p,figure){margin:0}
  .abu-page :is(h1,h2){letter-spacing:-.05em}
  .abu-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.09}
  .abu-page h2 span,.accent{color:#3e8148}
  .abu-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}
  .section{padding:clamp(60px,7vw,100px) 0}
  .eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}
  .eyebrow :global(.location-glyph){width:26px;height:26px}
  .breadcrumb{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:12px;color:#5c7461}
  .breadcrumb a{color:#3c6846;text-decoration:none}
  .hero{padding-top:22px;background:radial-gradient(ellipse at 6% 80%,#e0ebd3aa,transparent 60%),#f5f8f1}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:26px clamp(30px,6vw,80px);padding:42px 0 46px}
  .hero-copy{grid-area:copy;align-self:end}
  .hero-copy h1{font-size:clamp(2.6rem,3.8vw,3.65rem);line-height:1.09;margin-top:22px}
  .hero-copy h1>span{display:block;white-space:nowrap}
  .hero-lead{font-size:16px;line-height:1.8;color:#58705e;max-width:570px;margin-top:22px!important}
  .hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}
  .hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}
  .hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700}
  .hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
  .coverage-layout{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);gap:65px;align-items:start}
  .coverage-heading h2{margin:15px 0 23px}
  .coverage-heading>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5c7261;max-width:410px}
  .coverage-seal{display:flex;align-items:center;gap:15px;padding:24px 0;margin:8px 0 15px;color:#4b724e;font-size:13px;line-height:1.7}
  .coverage-seal :global(.location-glyph){width:48px;height:48px;flex-shrink:0}
  .coverage-seal strong{color:#264d32}
  .coverage-guides{border-top:1px solid #cedfc4}
  .coverage-guides>details{border-bottom:1px solid #dbe5d3;scroll-margin-top:35px}
  .coverage-guides summary{display:flex;align-items:center;gap:15px;padding:22px 0;list-style:none;cursor:pointer}
  summary::-webkit-details-marker{display:none}
  .guide-icon{display:grid;place-items:center;width:51px;height:51px;flex-shrink:0;background:#eff5e7;border-radius:15px;color:#427b4c}
  .guide-icon :global(.location-glyph){width:33px;height:33px}
  .coverage-guides summary small{display:block;font-size:10px;letter-spacing:.05em;text-transform:uppercase;line-height:1.5;color:#5b7857;font-weight:750;margin-bottom:6px}
  .coverage-guides summary strong{display:block;font-size:20px;line-height:1.35;letter-spacing:-.025em}
  .coverage-guides summary>i{margin-left:auto;flex-shrink:0;font-size:23px;color:#477e4b}
  details[open]>summary>i{transform:rotate(45deg)}
  .guide-content{padding:0 0 26px 66px}
  .guide-content>p{color:#5c7261;font-size:14px;line-height:1.8}
  .area-tags{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:18px 0 22px}
  .area-tags li{padding:9px 11px;border-radius:9px;border:1px solid #d9e5ce;background:#f5f8ef;font-size:12px;line-height:1.5;color:#3c6144}
  .guide-content :global(.section-action){font-size:12px}
  .coverage-note{font-size:12px;line-height:1.8;color:#60775e;margin-top:22px!important}
  .environment-section{padding:0 0 15px;background:radial-gradient(ellipse at 94% 45%,#dce9ce66,transparent 60%)}
  .photo-wrap{position:relative}
  .photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;background:#173b2a;box-shadow:0 24px 45px #24452a17}
  .scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}
  .environment-scene{display:grid;grid-template-rows:1fr auto;min-height:660px;padding-top:320px}
  .environment-scene .scene-image{object-position:50% 40%}
  .environment-shade{position:absolute;inset:0;background:linear-gradient(0deg,#071c14fa 3%,#071c14ed 22%,#071c1455 66%,#071c1410)}
  .environment-copy{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);gap:45px;align-items:end;align-self:end;padding:34px 40px 40px;color:white}
  .environment-copy .eyebrow{color:#c8e2b7}
  .environment-copy h2{font-size:clamp(2rem,3.2vw,3rem);margin-top:15px}
  .environment-copy h2 span{color:#c1dda9}
  .environment-copy>div>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#d5e3ce}
  .environment-copy :global(.section-action){margin-top:23px;border-color:#a2c88b}
  .photo-scene figcaption{position:relative;z-index:2;background:#fff;color:#294b32;font-size:14px;line-height:1.65;padding:18px 24px;border:1px solid #dfe8d7;border-top:0}
  .section-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.65fr);gap:45px;align-items:end;margin-bottom:35px}
  .section-heading h2{margin-top:15px}
  .section-heading>p{color:#5e7462;font-size:15px;line-height:1.8}
  .access-notes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 35px}
  .access-notes article{display:flex;align-items:flex-start;gap:16px;border-top:1px solid #dce5d4;padding:27px 0;min-width:0}
  .note-glyph{display:grid;place-items:center;width:44px;height:44px;background:#edf4e5;border-radius:13px;color:#3e774a;flex-shrink:0}
  .note-glyph :global(.location-glyph){width:29px;height:29px}
  .access-notes h3{font-size:17px;margin:3px 0 10px}
  .access-notes p{font-size:14px;color:#617364;line-height:1.75}
  .vehicle-section{background:#f0f5e8;border-top:1px solid #e1e9d8;border-bottom:1px solid #e1e9d8}
  .vehicle-section>.smc-container{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);align-items:center;gap:65px}
  .vehicle-heading h2{margin:15px 0 23px}
  .vehicle-heading>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#5d7460}
  .vehicle-heading a{color:#2c683b;font-weight:750;text-underline-offset:4px}
  .service-buttons{display:grid;grid-template-columns:1fr 1fr;gap:13px}
  .service-buttons :global(.section-action){width:100%;justify-content:space-between;font-size:12px;min-width:0}
  .industrial-section{background:#163c2b;color:#fff}
  .industrial-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.65fr);align-items:end;gap:50px;margin-bottom:38px}
  .industrial-heading h2{margin-top:15px}
  .industrial-heading .eyebrow,.industrial-heading h2 span{color:#b9dba4}
  .industrial-heading>p{color:#c3d8ba;line-height:1.8;font-size:15px}
  .industrial-feature{position:relative}
  .industrial-scene{min-height:650px;display:grid;align-items:end;grid-template-rows:1fr auto;box-shadow:none}
  .industrial-scene .scene-image{object-position:50% 50%}
  .industrial-scene figcaption{grid-row:2}
  .site-panel{position:relative;align-self:end;justify-self:start;margin:180px 0 28px 30px;z-index:3;width:375px;padding:29px;background:#fff;color:#234c33;border-radius:24px;border:1px solid #e0e8d8;box-shadow:0 18px 40px #0a24183b}
  .site-panel .note-glyph{margin-bottom:20px}
  .site-panel .eyebrow{font-size:10px}
  .site-panel h3{font-size:29px;letter-spacing:-.04em;margin:13px 0 19px}
  .site-panel h3 span{color:#447b4b}
  .site-panel>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#5e7260}
  .site-panel :global(.section-action){width:100%;justify-content:space-between;margin-top:23px;font-size:12px}
  .fleet-brief{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px;margin-top:42px}
  .fleet-brief article{position:relative;border-top:1px solid #70916a77;padding:25px 0 0 45px}
  .brief-number{position:absolute;left:0;top:26px;font-size:12px;color:#b5d3a3;font-weight:800}
  .fleet-brief :global(.location-glyph){width:31px;height:31px;color:#bad9a9;margin-bottom:13px}
  .fleet-brief h3{font-size:19px;margin-bottom:11px}
  .fleet-brief p{font-size:14px;color:#c5d8bf;line-height:1.75}
  .process-layout{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);gap:75px;align-items:start}
  .process-layout header h2{margin:15px 0 23px}
  .process-layout header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5f7362;margin-bottom:27px}
  .planning-steps{display:grid;grid-template-columns:1fr 1fr;gap:32px;list-style:none;padding:0;margin:0}
  .planning-steps li{border-top:1px solid #cddfc4;padding-top:20px;display:flex;gap:15px}
