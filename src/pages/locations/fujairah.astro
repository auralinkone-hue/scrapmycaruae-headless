---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import LocationGlyph from '../../components/LocationGlyph.astro';
import LocationsMotion from '../../components/LocationsMotion.astro';
import { getVehicleData } from '../../lib/vehicle-data';
import { fujairahCoverageLocations, fujairahCollectionSettings } from '../../lib/fujairah-coverage';
const accessNotes = [
  ['access', 'The route in', 'Describe compound gates, workshop entrances, slopes and space around the vehicle.'],
  ['keys', 'Keys & steering', 'Mention missing keys or known steering restrictions. Share what you know; no need to test the car.'],
  ['vehicle', 'Rolling condition', 'Include locked wheels, flat tyres or damage that may affect movement. A non-running car may need a different recovery approach.'],
  ['collection', 'Working space', 'Explain where recovery equipment could stand, any ground or clearance limits and who can arrange entry.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const steps = [
  ['vehicle', 'Vehicle details', 'Start with the make, model, year and your contact details.'],
  ['review', 'Known condition', 'Describe damage, faults, keys and the car’s known mobility.'],
  ['coverage', 'Location & access', 'Share the precise Fujairah location, parking position and approach.'],
  ['collection', 'The next step', 'Discuss the valuation and practical arrangements before collection is agreed.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Fujairah?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share the vehicle details, known condition, mobility and exact location. The assessment and possible collection arrangements depend on the individual car and access review.'],
  ['Which Fujairah areas can I enquire about?', 'Fujairah is included in our UAE location coverage. Provide your exact area and parking position so coverage and practical access can be reviewed. An enquiry does not confirm a collection booking or guarantee collection.'],
  ['What if the car is inside a compound or basement?', 'Describe the entrance, clearance, route to the vehicle and any security or permission requirements. Identify the person who can arrange entry and vehicle handover.'],
  ['Can a car at a Fujairah workshop or industrial plot be considered?', 'Share the precise premises location, vehicle position, gate and available recovery space. Include working-area restrictions, other vehicles nearby and who can authorise release.'],
  ['What should I share for an outer-area location?', 'Provide the exact location and the approach from the road. Describe the ground surface, entrance width, restrictions and recovery space so practical access can be reviewed.'],
  ['What if the car has no keys or cannot roll or steer?', 'Mention missing keys, locked wheels, flat tyres or known steering restrictions when you enquire. These details may affect recovery equipment and access. You do not need to start or move the vehicle to request a valuation.'],
  ['Can several commercial vehicles be assessed together?', 'Start a fleet disposal enquiry with a vehicle list, individual conditions, parking positions and the authorised site contact. Access and possible handover arrangements may need a separate review for each vehicle.'],
  ['What affects the valuation and collection arrangements?', 'Vehicle details, known condition, damage, mobility, available documents and collection access can affect the review. The team can confirm the information and handover requirements for your circumstances before arrangements are agreed.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Fujairah', item: 'https://www.scrapmycaruae.com/locations/fujairah/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Fujairah | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Fujairah. Request a free valuation and share your vehicle condition and collection location." canonical="/locations/fujairah/" ogImage="/sections/fujairah-vehicle-collection.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="fujairah-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="fujairah-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><span aria-current="page">Fujairah</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="fujairah" /> Fujairah vehicle valuation</p><h1 id="fujairah-title"><span>Sell or scrap your car</span> <span class="accent">in Fujairah</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Fujairah. Share the vehicle details, condition and collection location to start the process.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="fujairah" />Fujairah residential &amp; industrial areas</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><header class="coverage-heading" data-reveal><div><p class="eyebrow">Fujairah coverage overview</p><h2 id="coverage-title">Tell us the location.<br /><span>Show us the approach.</span></h2></div><p>A car behind a compound gate and a car on an industrial plot need different access details. Start with the setting, then share the exact position.</p></header><div class="coverage-browser" data-reveal><aside class="coverage-identity"><LocationGlyph kind="fujairah" /><p class="eyebrow">UAE · East coast</p>{fujairahCoverageLocations.map(name=><h3>{name}</h3>)}<p>Location enquiries and practical access are reviewed for the individual vehicle.</p><SectionActionButton href="/locations/" label="Explore UAE locations" intent="process" icon="ph-map-trifold" /></aside><div class="setting-guides">{fujairahCollectionSettings.map((setting,index)=><details id={setting.id} open={index===0}><summary><LocationGlyph kind={setting.icon} /><span>{setting.title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><div><p>{setting.copy}</p><p class="guide-detail">{setting.detail}</p></div></details>)}</div></div></div></section>

    <section class="collection-section" aria-labelledby="collection-title"><div class="smc-container"><figure class="photo-scene collection-scene" data-scene data-reveal><div class="collection-stage"><img class="scene-image" src="/sections/fujairah-vehicle-collection.webp" alt="Older scuffed grey sedan and recovery operator beside an unbranded flatbed at a Fujairah residential compound with rocky hills and coastal palms beyond" width="1440" height="960" loading="lazy" decoding="async" /><div class="collection-shade" aria-hidden="true"></div><div class="collection-panel"><p class="eyebrow">Residential · workshop · industrial · outer-area</p><h2 id="collection-title">Every setting<br /><span>has its own approach.</span></h2><p>Describe the route from the road to the car. Entrances, parking space and surface conditions help explain how recovery equipment could reach it.</p><SectionActionButton href="/car-removal/" label="Read the collection guide" intent="process" icon="ph-truck" /></div><div class="scene-note"><LocationGlyph kind="fujairah" /><span>Fujairah collection planning<br /><strong>Built around your parking situation</strong></span></div></div></figure></div></section>

    <section class="section mobility-section" aria-labelledby="mobility-title"><div class="smc-container"><header class="mobility-heading" data-reveal><div><p class="eyebrow">Access &amp; vehicle mobility</p><h2 id="mobility-title">The route in.<br /><span>The room to recover.</span></h2></div><p>For a non-running car, share what is already known. You do not need to start, move or test the vehicle to request a valuation.</p></header><div class="mobility-notes">{accessNotes.map(([icon,title,copy])=><article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Your car’s condition.<br /><span>A useful place to start.</span></h2><p>Choose the relevant guide for known damage or faults. Explore the <a href="/sell-my-car/">sell my car guide</a> for wider selling options.</p></header><nav class="service-buttons" aria-label="Fujairah vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section commercial-section" aria-labelledby="commercial-title"><div class="smc-container"><header class="commercial-heading" data-reveal><div><p class="eyebrow">Industrial &amp; commercial collection</p><h2 id="commercial-title">A practical site review.<br /><span>A clearer handover.</span></h2></div><p>At a Fujairah workshop, industrial plot or commercial premises, describe the vehicle position and route through the site. Several vehicles may need individual condition and access reviews.</p></header><figure class="photo-scene commercial-scene" data-scene data-reveal><div class="commercial-stage"><img class="scene-image" src="/sections/fujairah-industrial-recovery.webp" alt="Worn dark-green non-running sedan and operator preparing recovery beside a lowered flatbed in a Fujairah industrial workshop yard with rocky hills beyond" width="1440" height="960" loading="lazy" decoding="async" /><div class="site-label"><LocationGlyph kind="sharjah" /><span>Workshop · plot · commercial premises</span></div></div><div class="site-brief"><div><LocationGlyph kind="vehicle" /><h3>Each vehicle</h3><p>List the cars, known conditions, keys and rolling or steering restrictions.</p></div><div><LocationGlyph kind="access" /><h3>Each position</h3><p>Describe gates, nearby vehicles, working areas and recovery space.</p></div><div><LocationGlyph kind="review" /><h3>The handover</h3><p>Identify the contact who can arrange entry and authorise vehicle release.</p></div></div></figure><div class="commercial-footer" data-reveal><p>For several vehicles at one location, start with a clear vehicle list and an authorised site contact.</p><SectionActionButton href="/fleet-disposal/" label="Discuss commercial vehicles" intent="contact" icon="ph-truck" /></div></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="process-heading" data-reveal><p class="eyebrow">Valuation + collection planning</p><h2 id="process-title">Four parts<br /><span>to a useful first brief.</span></h2></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><span class="step-number">0{index+1}</span><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol><div class="process-action" data-reveal><SectionActionButton href="/free-quote" label="Start my free valuation" intent="valuation" /></div></div></section>

    <section class="guide-section" aria-labelledby="guide-title"><div class="smc-container" data-reveal><p class="eyebrow">Fujairah area navigation</p><h2 id="guide-title">Find the access details you need.</h2><p>Use the parking-setting guides, then share your exact Fujairah area and vehicle position.</p><nav class="guide-navigation" aria-label="Fujairah collection setting guides">{fujairahCollectionSettings.map(setting=><SectionActionButton href={`#${setting.id}`} label={setting.id==='residential-compounds'?'Residential & compounds':setting.id==='workshops-industrial-plots'?'Workshops & industrial plots':'Outer-area approaches'} intent="process" icon={setting.id==='residential-compounds'?'ph-buildings':setting.id==='workshops-industrial-plots'?'ph-warehouse':'ph-map-trifold'} />)}</nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Fujairah collection<br /><span>questions.</span></h2><p>Practical information for your car, its location and the route to it.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><LocationGlyph kind="fujairah" /><p class="eyebrow">Your vehicle. Your Fujairah location.</p><h2 id="final-title">Tell us where your car is.<br /><span>Start with a free valuation.</span></h2><p>Share the vehicle details, known condition and collection location. We’ll discuss the practical next step.</p><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>
.fujairah-page{color:#193e2b;background:#fff;overflow:clip}.fujairah-page :is(h1,h2,h3,p,figure){margin:0}.fujairah-page :is(h1,h2){letter-spacing:-.05em}.fujairah-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.fujairah-page h2 span,.accent{color:#43804a}.fujairah-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.fujairah-page :is(a,button,summary):focus-visible{outline:3px solid #3181ab;outline-offset:4px}.fujairah-page [id]{scroll-margin-top:35px}.page-progress{display:none;position:fixed;top:0;left:0;right:0;height:3px;background:#74a952;z-index:110;transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}.motion-ready .page-progress{display:block}.motion-ready [data-reveal]{opacity:0;transform:translateY(20px);transition:opacity 650ms ease,transform 650ms ease;transition-delay:var(--reveal-delay,0ms)}.motion-ready [data-reveal].is-visible{opacity:1;transform:none}
@media(hover:hover){.fujairah-page :global(.section-action:hover){transform:translateY(-3px);box-shadow:0 16px 28px #173d2925}.fujairah-page :global(.section-action:hover i){transform:scale(1.05) rotate(-4deg)}.photo-scene:hover .scene-image{transform:scale(1.075) translate3d(0,var(--scene-shift,0px),0)}}
@media(prefers-reduced-motion:reduce){.fujairah-page [data-reveal]{opacity:1!important;transform:none!important;transition:none!important}.page-progress{display:none!important}.fujairah-page :global(.section-action),.fujairah-page :global(.section-action i),.scene-image{transition:none!important;transform:none!important}.fujairah-page :global(.section-action:hover),.fujairah-page :global(.section-action:hover i){transform:none!important}}
.coverage-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:70px;align-items:end;margin-bottom:35px}.coverage-heading h2{margin-top:16px}.coverage-heading>p{font-size:15px;line-height:1.8;color:#5d735f}.coverage-browser{display:grid;grid-template-columns:.65fr 1fr;gap:55px;padding:32px;border:1px solid #dce7d0;border-radius:28px;background:#f5f8ef}.coverage-identity{border-left:3px solid #a6c386;padding:0 0 0 25px}.coverage-identity>:global(.location-glyph){width:65px;height:65px;color:#52804d;margin-bottom:18px}.coverage-identity h3{font-size:35px;margin:13px 0 19px;letter-spacing:-.04em}.coverage-identity>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#5b745f;max-width:340px}.coverage-identity :global(.section-action){font-size:12px;margin-top:25px}.setting-guides{border-top:1px solid #d2e0c5}.setting-guides details{border-bottom:1px solid #d2e0c5}.setting-guides summary{display:flex;align-items:center;gap:15px;padding:22px 0;cursor:pointer;list-style:none;font-size:18px;font-weight:750;line-height:1.5}.setting-guides summary::-webkit-details-marker{display:none}.setting-guides summary>:global(.location-glyph){width:31px;height:31px;color:#4d7e4b;flex-shrink:0}.setting-guides summary i{margin-left:auto;color:#4d7e4b;font-size:22px;flex-shrink:0}.setting-guides details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.setting-guides details>div{padding:0 0 23px 46px}.setting-guides details p{font-size:14px;line-height:1.8;color:#5f755f}.setting-guides .guide-detail{font-size:12px;color:#487248;margin-top:15px;font-weight:700}
.collection-section{padding:0 0 75px;background:radial-gradient(ellipse at 95% 60%,#dce9cfaa,transparent 60%)}.photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;box-shadow:0 24px 45px #24452a15;background:#eef4e7}.collection-stage,.commercial-stage{position:relative;isolation:isolate;overflow:hidden}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}.collection-stage{display:flex;justify-content:flex-end;align-items:flex-start;min-height:750px;padding:36px;background:#193c2c}.collection-stage .scene-image{object-position:50% 55%}.collection-shade{position:absolute;inset:0;background:linear-gradient(0deg,#0b281cca,transparent 40%)}.collection-panel{position:relative;z-index:1;width:450px;max-width:100%;padding:30px;border-radius:24px;background:#fffffff5;box-shadow:0 20px 35px #1231202b;color:#21462e}.collection-panel .eyebrow{font-size:9px;letter-spacing:.045em}.collection-panel h2{font-size:35px;margin:17px 0 20px}.collection-panel>p:not(.eyebrow){font-size:14px;line-height:1.85;color:#58715b}.collection-panel :global(.section-action){font-size:12px;width:100%;justify-content:space-between;margin-top:24px}.scene-note{position:absolute;z-index:1;left:36px;bottom:32px;display:flex;gap:14px;align-items:center;color:#deebd5;font-size:12px;line-height:1.75}.scene-note :global(.location-glyph){width:40px;height:40px;color:#c8e0b1}.scene-note strong{color:#fff}
