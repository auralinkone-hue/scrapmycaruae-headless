---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import LocationsMotion from '../../components/LocationsMotion.astro';
import LocationGlyph from '../../components/LocationGlyph.astro';
import { getVehicleData } from '../../lib/vehicle-data';
import { ajmanCoverageLocations, ajmanCollectionSettings } from '../../lib/ajman-coverage';
const mobilityNotes = [
  ['access', 'Space around the car', 'Describe tight parking, nearby vehicles, narrow lanes and the route to the entrance.'],
  ['keys', 'Keys & steering', 'Mention missing keys or any known steering restriction. Share what is already known.'],
  ['vehicle', 'Rolling condition', 'Tell us about locked wheels, flat tyres or damage affecting movement. No need to test the car to enquire.'],
  ['coverage', 'Recovery access', 'Include gates, ramps, yard entrances, clearance limits and permission to enter.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const steps = [
  ['vehicle', 'Start with the vehicle', 'Provide the make, model, year and your contact details.'],
  ['review', 'Explain its known condition', 'Share damage, faults, mobility and any information already available.'],
  ['coverage', 'Describe the Ajman location', 'Add the exact parking position, entrance, access restrictions and keys information.'],
  ['collection', 'Discuss the next step', 'Review the valuation and practical arrangements before collection is agreed.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Ajman?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share the vehicle details, known condition, mobility and exact Ajman location. The assessment and possible collection arrangements depend on the individual vehicle and access review.'],
  ['Which Ajman areas can I enquire about?', 'Ajman is included in our UAE location coverage. Share your exact area and parking position so coverage and practical access can be reviewed for your car. A location enquiry does not confirm a collection booking or guarantee collection.'],
  ['Can you consider a car in tight residential parking?', 'Yes, access can be discussed. Describe nearby vehicles, the route to the road, entrance width and any building or security restrictions. For basement parking, include the level, ramp and entrance clearance.'],
  ['What if my car has no keys or cannot roll?', 'Mention missing keys, locked wheels, flat tyres or restricted steering when you enquire. These details can affect recovery access and equipment. Share what is already known; you do not need to start or move the car to request a valuation.'],
  ['What should I share for a car at an Ajman workshop?', 'Identify the premises, exact vehicle position, gate and available recovery space. Explain who can authorise entry and release and include any site restrictions or handover contact arrangements.'],
  ['Can several vehicles at an industrial site be assessed?', 'Yes, you can start a fleet disposal discussion. Share a vehicle list, each known condition and parking position, site entry requirements and the authorised contact. Each car and its access may need a separate review.'],
  ['What affects the valuation?', 'Vehicle details, known condition, damage, mobility, available information and collection access requirements can affect the review. A free valuation request does not commit you to selling or confirm a collection appointment.'],
  ['What documents should I prepare?', 'Explain which vehicle and ownership documents are available and whether any are missing. The team can confirm the information and handover requirements for your circumstances before arrangements are agreed.'],
  ['Does Ajman coverage mean there is a branch in each area?', 'No. This page describes location enquiries and collection considerations. It does not identify branch offices, depots, fixed recovery routes or guaranteed collection times.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Ajman', item: 'https://www.scrapmycaruae.com/locations/ajman/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Ajman | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Ajman. Request a free valuation and share your vehicle condition and collection location." canonical="/locations/ajman/" ogImage="/sections/ajman-vehicle-collection.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="ajman-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="ajman-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><span aria-current="page">Ajman</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="ajman" /> Ajman vehicle valuation</p><h1 id="ajman-title"><span>Sell or scrap</span> <span class="accent">your car in Ajman</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Ajman. Share the vehicle details, condition and collection location to start the process.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="ajman" />Ajman residential &amp; industrial areas</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><div class="coverage-banner" data-reveal><span class="city-glyph"><LocationGlyph kind="ajman" /></span><div><p class="eyebrow">Ajman coverage overview</p><h2 id="coverage-title">One location.<br /><span>Your parking situation.</span></h2></div><p>Share the exact Ajman location and how the car can be reached. The setting helps explain the collection approach, from a residential street to a workshop or yard.</p></div><div class="coverage-guide" data-reveal><div class="coverage-intro"><p class="eyebrow">Collection enquiries</p>{ajmanCoverageLocations.map(name => <h3>{name}</h3>)}<p>Choose the setting that best describes where your car is parked. Coverage and collection access are reviewed for the individual vehicle.</p><SectionActionButton href="/locations/" label="View UAE locations" intent="process" icon="ph-map-trifold" /></div><div class="setting-guides">{ajmanCollectionSettings.map((setting,index) => <details id={setting.id} open={index === 0}><summary><LocationGlyph kind={setting.icon} /><span>{setting.title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><div><p>{setting.copy}</p><p class="guide-detail">{setting.detail}</p></div></details>)}</div></div></div></section>

    <section class="collection-section" aria-labelledby="collection-title"><div class="smc-container"><figure class="photo-scene collection-scene" data-scene data-reveal><div class="collection-stage"><img class="scene-image" src="/sections/ajman-vehicle-collection.webp" alt="Older scuffed beige sedan beside an unbranded recovery truck on an Ajman residential street with a professional operator checking the parking position" width="1440" height="960" loading="lazy" decoding="async" /><div class="collection-shade" aria-hidden="true"></div><div class="collection-copy"><p class="eyebrow">Street · forecourt · yard</p><h2 id="collection-title">From where it is parked<br /><span>to a practical next step.</span></h2><p>Residential streets, workshop approaches and industrial environments each call for different access details. Tell us the route to the car and what is known about its mobility.</p><SectionActionButton href="/car-removal/" label="Explore car collection" intent="process" icon="ph-truck" /></div><aside class="photo-note"><LocationGlyph kind="access" /><span>Collection access<br /><strong>considered individually</strong></span></aside></div><figcaption>Illustrative Ajman collection preparation. The parking position and available access help inform the review.</figcaption></figure></div></section>

    <section class="section mobility-section" aria-labelledby="mobility-title"><div class="smc-container"><header class="section-heading" data-reveal><div><p class="eyebrow">Access &amp; vehicle mobility</p><h2 id="mobility-title">The car may be still.<br /><span>The details move things forward.</span></h2></div><p>For a non-running car, describe what you already know. Clear access notes help explain how recovery equipment could reach the vehicle.</p></header><div class="mobility-notes">{mobilityNotes.map(([icon,title,copy]) => <article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">A car with a problem<br /><span>can still start a conversation.</span></h2><p>Explore the guide that fits your car’s known condition. For broader selling options, read our <a href="/sell-my-car/">sell my car guide</a>.</p></header><nav class="service-buttons" aria-label="Ajman vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon]) => <SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section workshop-section" aria-labelledby="workshop-title"><div class="smc-container"><header class="section-heading" data-reveal><div><p class="eyebrow">Ajman industrial &amp; workshop collection</p><h2 id="workshop-title">The premises matter.<br /><span>So does the handover.</span></h2></div><p>For a workshop, yard or commercial parking site, tell us who can arrange entry and release. Several vehicles may need individual condition and access reviews.</p></header><figure class="photo-scene workshop-scene" data-scene data-reveal><div class="workshop-stage"><img class="scene-image" src="/sections/ajman-workshop-recovery.webp" alt="Worn green-grey sedan with minor body damage near a flatbed ramp and open workshop entrance in an Ajman industrial setting with a recovery operator" width="1440" height="960" loading="lazy" decoding="async" /></div><div class="handover-panel"><div><span class="panel-glyph"><LocationGlyph kind="review" /></span><p class="eyebrow">Before collection is agreed</p><h3>A clear first brief.</h3><p>Include the vehicle list, exact positions and the contact who can authorise handover.</p></div><div><ul><li><i class="ph ph-check-circle" aria-hidden="true"></i>Gate and working space</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Known mobility and available keys</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Release contact and available documents</li></ul><SectionActionButton href="/fleet-disposal/" label="Discuss vehicles at your site" intent="contact" icon="ph-truck" /></div></div><figcaption>Illustrative workshop recovery preparation. Site access and vehicle release arrangements are reviewed before collection.</figcaption></figure></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container process-layout"><header data-reveal><p class="eyebrow">Valuation + collection planning</p><h2 id="process-title">A review built<br /><span>around your car.</span></h2><p>The free valuation starts with your details. The vehicle’s condition and location help shape the next discussion.</p><SectionActionButton href="/free-quote" label="Start my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index) => <li data-reveal><span class="step-number">0{index+1}</span><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></div></section>

    <section class="guide-navigation-section" aria-labelledby="guide-title"><div class="smc-container" data-reveal><p class="eyebrow">Ajman area navigation</p><h2 id="guide-title">Find the right access guide.</h2><p>Start with the parking setting, then share your exact Ajman location.</p><nav class="guide-navigation" aria-label="Ajman collection setting guides">{ajmanCollectionSettings.map(setting => <SectionActionButton href={`#${setting.id}`} label={setting.id === 'residential-parking' ? 'Residential parking' : setting.id === 'workshop-access' ? 'Workshop access' : 'Industrial yards'} intent="process" icon={setting.id === 'residential-parking' ? 'ph-buildings' : 'ph-warehouse'} />)}</nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><header class="faq-heading" data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Ajman collection<br /><span>questions.</span></h2></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><div><p class="eyebrow">Your vehicle. Your Ajman location.</p><h2 id="final-title">Tell us about your car.<br /><span>We’ll discuss the next step.</span></h2><p>Share the details, known condition and collection location to request your free valuation.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>
  .ajman-page{color:#193e2b;background:#fff;overflow:clip}
  .ajman-page :is(h1,h2,h3,p,figure){margin:0}
  .ajman-page :is(h1,h2){letter-spacing:-.05em}
  .ajman-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.09}
  .ajman-page h2 span,.accent{color:#3e8148}
  .ajman-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}
  .section{padding:clamp(60px,7vw,100px) 0}
  .eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}
  .eyebrow :global(.location-glyph){width:26px;height:26px}
  .breadcrumb{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:12px;color:#5c7461}
  .breadcrumb a{color:#3c6846;text-decoration:none}
  .hero{padding-top:22px;background:radial-gradient(ellipse at 6% 80%,#e0ebd3aa,transparent 60%),#f5f8f1}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:26px clamp(30px,6vw,80px);padding:42px 0 46px}
  .hero-copy{grid-area:copy;align-self:end}
  .hero-copy h1{font-size:clamp(2.6rem,3.8vw,3.65rem);line-height:1.09;margin-top:22px}
  .hero-copy h1>span{display:block;white-space:nowrap}
  .hero-lead{font-size:16px;line-height:1.8;color:#58705e;max-width:570px;margin-top:22px!important}
  .hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}
  .hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}
  .hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700}
  .hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
  .section-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.62fr);gap:50px;align-items:end;margin-bottom:35px}.section-heading h2{margin-top:15px}.section-heading>p{font-size:15px;line-height:1.8;color:#5c7260}
  .coverage-banner{display:grid;grid-template-columns:90px minmax(0,1fr) minmax(0,.8fr);gap:30px;align-items:center;padding-bottom:35px;border-bottom:1px solid #d6e2cf}.city-glyph{display:grid;place-items:center;width:90px;height:90px;border:1px solid #d6e4c9;background:#eff5e7;border-radius:25px;color:#3f794a}.city-glyph :global(.location-glyph){width:57px;height:57px}.coverage-banner h2{font-size:clamp(2rem,3.2vw,3rem);margin-top:14px}.coverage-banner>p{font-size:15px;line-height:1.8;color:#5b7260}.coverage-guide{display:grid;grid-template-columns:minmax(0,.45fr) minmax(0,1fr);gap:65px;padding-top:35px}.coverage-intro h3{font-size:42px;letter-spacing:-.05em;margin:12px 0 18px}.coverage-intro>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#5c7261}.coverage-intro :global(.section-action){margin-top:23px;font-size:12px}.setting-guides{border-top:1px solid #d3e1ca}.setting-guides details{border-bottom:1px solid #dce6d5}.setting-guides summary{display:flex;align-items:center;gap:14px;list-style:none;cursor:pointer;padding:22px 0;font-size:18px;font-weight:750;line-height:1.5}.setting-guides summary::-webkit-details-marker{display:none}.setting-guides summary>:global(.location-glyph){width:32px;height:32px;color:#4a7e4c;flex-shrink:0}.setting-guides summary i{margin-left:auto;font-size:22px;color:#4d7c48;flex-shrink:0}.setting-guides details[open] summary i{transform:rotate(45deg)}.setting-guides details>div{padding:0 0 24px 46px}.setting-guides details p{font-size:14px;line-height:1.8;color:#5f7361}.setting-guides .guide-detail{font-size:12px;color:#3e6945;margin-top:16px;font-weight:700}
  .collection-section{padding:0 0 15px;background:radial-gradient(ellipse at 8% 55%,#dcead188,transparent 60%)}.photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;background:#eaf1e3;box-shadow:0 24px 45px #24452a15}.collection-stage,.workshop-stage{position:relative;isolation:isolate;overflow:hidden}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}.collection-stage{display:flex;align-items:flex-end;min-height:680px;background:#102e21}.collection-stage .scene-image{object-position:50% 48%}.collection-shade{position:absolute;inset:0;background:linear-gradient(0deg,#071c14fa,#071c14a8 35%,#071c1408 80%)}.collection-copy{position:relative;z-index:1;padding:45px 42px;max-width:780px;color:#fff}.collection-copy .eyebrow,.collection-copy h2 span{color:#bfdcab}.collection-copy h2{font-size:clamp(2rem,3.4vw,3.25rem);margin-top:16px}.collection-copy>p:not(.eyebrow){font-size:14px;line-height:1.85;color:#d0e1c9;margin-top:20px;max-width:650px}.collection-copy :global(.section-action){margin-top:25px;border-color:#9ec58b}.photo-note{position:absolute;top:28px;right:28px;z-index:1;display:flex;align-items:center;gap:12px;background:#fffffff2;color:#3b6245;border-radius:16px;padding:17px 20px;box-shadow:0 12px 26px #0b231622;font-size:12px;line-height:1.6}.photo-note :global(.location-glyph){width:34px;height:34px;color:#4c7e4c;flex-shrink:0}.photo-note strong{color:#234c32}.photo-scene figcaption{position:relative;z-index:2;background:#fff;color:#294b32;font-size:14px;line-height:1.65;padding:18px 24px;border-top:1px solid #dfe8d7}
  .mobility-notes{display:grid;grid-template-columns:1fr 1fr;gap:0 50px}.mobility-notes article{display:flex;align-items:flex-start;gap:20px;padding:27px 0;border-top:1px solid #d8e4cf}.mobility-notes article>:global(.location-glyph){width:42px;height:42px;flex-shrink:0;color:#42794b}.mobility-notes h3{font-size:21px;margin:4px 0 12px}.mobility-notes p{font-size:14px;line-height:1.8;color:#617463}
  .vehicle-section{background:#183d2b;color:#fff}.vehicle-section header{text-align:center;max-width:820px;margin:auto}.vehicle-section .eyebrow{justify-content:center;color:#bfdba9}.vehicle-section h2{margin:16px 0 23px}.vehicle-section h2 span{color:#b9dca7}.vehicle-section header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#c5d8bd;max-width:700px;margin:auto}.vehicle-section header a{color:#e1efd8;font-weight:750;text-underline-offset:4px}.service-buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin:32px auto 0;max-width:1020px}.service-buttons :global(.section-action){min-width:210px;justify-content:space-between;border-color:#8cb87a;box-shadow:none}
  .workshop-section{background:linear-gradient(#f6f8f0,#fff)}.workshop-stage{height:520px}.workshop-stage .scene-image{object-position:50% 55%}.handover-panel{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:45px;margin:-80px 38px 26px;padding:30px;background:#fff;border:1px solid #dee7d6;border-radius:24px;box-shadow:0 15px 30px #24482a18}.panel-glyph{display:grid;place-items:center;width:45px;height:45px;background:#ecf3e3;color:#42794b;border-radius:14px;margin-bottom:19px}.panel-glyph :global(.location-glyph){width:30px;height:30px}.handover-panel .eyebrow{font-size:10px}.handover-panel h3{font-size:29px;letter-spacing:-.04em;margin:12px 0 16px}.handover-panel p:not(.eyebrow){font-size:14px;line-height:1.8;color:#5d7361}.handover-panel>div:last-child{align-self:center}.handover-panel ul{list-style:none;padding:0;margin:0 0 25px;display:grid;gap:14px}.handover-panel li{display:flex;align-items:flex-start;gap:10px;font-size:13px;line-height:1.65;color:#42674b}.handover-panel li i{font-size:20px;color:#4b7e49;flex-shrink:0}.handover-panel :global(.section-action){width:100%;justify-content:space-between;font-size:12px}
  .process-section{padding-top:15px}.process-layout{display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1fr);gap:80px;align-items:start}.process-layout header h2{margin:15px 0 23px}.process-layout header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5e7360;margin-bottom:27px}.planning-steps{list-style:none;margin:0;padding:0;border-top:1px solid #cbdcc2}.planning-steps li{display:grid;grid-template-columns:27px 38px minmax(0,1fr);gap:18px;border-bottom:1px solid #dbe5d3;padding:25px 0}.step-number{font-size:12px;line-height:34px;font-weight:800;color:#6a8e58}.planning-steps :global(.location-glyph){width:34px;height:34px;color:#467c4b}.planning-steps h3{font-size:20px;margin:2px 0 11px}.planning-steps p{font-size:14px;line-height:1.75;color:#5e7462}
  .guide-navigation-section{background:#f1f6e9;border-block:1px solid #dce7d1;padding:40px 0}.guide-navigation-section h2{font-size:31px;margin:12px 0 17px}.guide-navigation-section p:not(.eyebrow){font-size:14px;line-height:1.8;color:#5d7460}.guide-navigation{display:flex;flex-wrap:wrap;gap:13px;margin-top:25px}.guide-navigation :global(.section-action){font-size:13px}
