---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import SectionActionButton from '../../../components/SectionActionButton.astro';
import LocationGlyph from '../../../components/LocationGlyph.astro';
import LocationsMotion from '../../../components/LocationsMotion.astro';
import { getVehicleData } from '../../../lib/vehicle-data';
import { sharjahCoverage } from '../../../lib/sharjah-coverage';
const area = sharjahCoverage.find(area => area.id === 'industrial-area')!;
const settings = [
  ['service-garages', 'sharjah', 'Automotive workshops & service garages', 'Give the workshop name, exact premises and bay or forecourt position. Include the contact who knows the vehicle and can confirm release requirements.'],
  ['industrial-premises', 'access', 'Industrial units & commercial premises', 'Describe the unit entrance, gate, approach and available working space. Mention delivery activity or equipment that could restrict access.'],
  ['workshop-parking', 'vehicle', 'Vehicle parking & workshop forecourts', 'Explain where the car is parked relative to the road, service bays and other vehicles. Share whether it can roll or steer and whether keys are available.']
];
const accessNotes = [
  ['vehicle', 'Immobilised or flat tyres', 'Describe known faults, flat tyres and locked wheels. Share existing information without starting or moving the vehicle to test it.'],
  ['keys', 'Keys, rolling & steering', 'Mention missing keys and any known rolling or steering restrictions. These details help explain the equipment and working space that may be needed.'],
  ['access', 'The approach to the bay', 'Include narrow entrances, parked cars, ramps, stock and other obstructions. Explain the route from the street to the vehicle.'],
  ['review', 'Gates, permission & space', 'Identify who can authorise entry and vehicle release. Share site restrictions and the available space for recovery equipment before arrangements are agreed.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood damage', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const handoverNotes = [
  ['ph-wrench', 'Workshop information', 'Known faults, keys and the exact bay.'],
  ['ph-truck', 'Commercial vehicle details', 'Vehicle type, condition and any fitted equipment.'],
  ['ph-user-check', 'Release & handover contact', 'Who confirms permission and vehicle release.']
];
const steps = [
  ['vehicle', 'Vehicle details', 'Share make, model, year and your contact details.'],
  ['review', 'Workshop or owner update', 'Explain known faults, damage, keys and mobility.'],
  ['coverage', 'Premises & access', 'Identify the workshop, parking position and route from the street.'],
  ['collection', 'Valuation & arrangements', 'Review the valuation and possible next step before collection is agreed.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Sharjah Industrial Area?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share its details, known condition and exact workshop or parking location in Sharjah Industrial Area. The vehicle and access review comes before any collection arrangements are agreed.'],
  ['What location information should I provide for a workshop?', 'Give the specific workshop or premises, unit or bay if known, entrance and exact vehicle position. Describe the route from the street and identify the person who can confirm access and vehicle release. The broad Industrial Area name alone may not be enough.'],
  ['Can I enquire while my car is at a service garage?', 'Yes. Share any existing workshop assessment, keys and known mobility. Explain who owns the vehicle, who can authorise release and any garage handover requirements. Access and release arrangements need confirmation before collection is agreed.'],
  ['What if the car has flat tyres or cannot steer?', 'Mention flat tyres, locked wheels and known rolling or steering restrictions when you enquire. These can affect equipment access and working space. Do not start or move a damaged vehicle just to provide this information.'],
  ['Can a car in a narrow workshop entrance be considered?', 'You can start an enquiry. Describe entrance width, nearby parked vehicles, stock and obstacles, together with the car’s position and mobility. A practical recovery route must be reviewed; restricted access does not guarantee collection.'],
  ['Can I request a valuation for a pickup or delivery van?', 'Share the make, model, year, vehicle type, known condition and exact location. Mention fitted equipment or modifications that may be relevant. Whether a particular commercial vehicle can be assessed and collected depends on the individual review.'],
  ['How do I enquire about several business vehicles?', 'Provide a vehicle list with each condition, keys, parking position and any known mobility restrictions. Include an authorised business contact and site contact. The fleet disposal guide explains the information that can help start the discussion.'],
  ['Does a free valuation confirm a collection booking?', 'No. It starts a review of the vehicle and circumstances. Vehicle details, condition, ownership information, exact premises, access and release requirements need discussion before collection arrangements are agreed. No fixed collection time or collection guarantee is implied.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Sharjah', item: 'https://www.scrapmycaruae.com/locations/sharjah/' },
  { '@type': 'ListItem', position: 4, name: 'Sharjah Industrial Area', item: 'https://www.scrapmycaruae.com/locations/sharjah/industrial-area/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Sharjah Industrial Area | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Sharjah Industrial Area. Request a free valuation and discuss vehicle condition and collection access." canonical="/locations/sharjah/industrial-area/" ogImage="/sections/sharjah-industrial-suv-recovery.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="industrial-area-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="industrial-area-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><a href="/locations/sharjah/">Sharjah</a><span aria-hidden="true">/</span><span aria-current="page">Industrial Area</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="access" /> Sharjah Industrial Area</p><h1 id="industrial-area-title"><span>Sell or scrap your car</span> <span class="accent">in Sharjah Industrial Area</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Sharjah Industrial Area. Share your vehicle details, condition and exact collection location to get started.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="access" />Workshops &amp; industrial areas</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><header class="yard-heading" data-reveal><div><p class="eyebrow">Sharjah Industrial Area coverage</p><h2 id="coverage-title">From service bay<br /><span>to the street outside.</span></h2></div><p>{area.copy}</p></header><div class="coverage-settings" data-reveal>{settings.map(([id,icon,title,copy],index)=><details id={id} open={index===0}><summary><LocationGlyph kind={icon} /><span>{title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{copy}</p></details>)}</div></div></section>

    <section class="recovery-section" aria-labelledby="recovery-title"><div class="smc-container"><div class="recovery-feature" data-reveal><figure class="photo-scene recovery-scene" data-scene><img class="scene-image" src="/sections/sharjah-industrial-suv-recovery.webp" alt="Bronze mid-2010s family SUV with modest bumper scratches beside an unbranded flatbed outside Sharjah Industrial Area-style service garages" width="1440" height="960" loading="lazy" decoding="async" /></figure><div class="recovery-copy"><p class="eyebrow">Workshop recovery planning</p><h2 id="recovery-title">The space outside<br /><span>matters too.</span></h2><p>A car may be parked behind other vehicles or beside an active service bay. Describe the approach from the street and the space around it.</p><ul><li><i class="ph ph-buildings" aria-hidden="true"></i>Street approach &amp; entrance</li><li><i class="ph ph-car-profile" aria-hidden="true"></i>Parking position &amp; recovery space</li></ul><SectionActionButton href="/car-removal/" label="Explore car collection" intent="process" icon="ph-truck" /></div></div></div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container"><header class="section-heading" data-reveal><p class="eyebrow">Workshop parking &amp; recovery access</p><h2 id="access-title">A clearer picture<br /><span>of the recovery route.</span></h2><p>Useful information from the owner and workshop helps distinguish the car’s condition from the practical access constraints.</p></header><div class="access-notes">{accessNotes.map(([icon,title,copy])=><article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Find the right<br /><span>vehicle guide.</span></h2><p>Choose the relevant condition guide or explore the wider <a href="/sell-my-car/">sell my car process</a>.</p></header><nav class="service-buttons" aria-label="Industrial Area vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon])=><SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section handover-section" aria-labelledby="handover-title"><div class="smc-container"><header class="handover-heading" data-reveal><div><p class="eyebrow">Workshop handover &amp; commercial vehicles</p><h2 id="handover-title">At the garage.<br /><span>Ready for the next discussion.</span></h2></div><p>For a car, pickup or delivery van at a workshop, combine the available vehicle information with a clear release contact and parking position.</p></header><div class="handover-feature" data-reveal><figure class="photo-scene handover-scene" data-scene><img class="scene-image" src="/sections/sharjah-industrial-commercial-van.webp" alt="Blue mid-2010s delivery van with modest commercial wear parked outside an industrial service garage, with workshop bays and no recovery truck" width="1440" height="960" loading="lazy" decoding="async" /></figure><aside class="handover-brief"><p class="eyebrow">A useful handover brief</p><h3>Vehicle, bay &amp; contact</h3><ol>{handoverNotes.map(([icon,title,copy])=><li><i class={`ph ${icon}`} aria-hidden="true"></i><div><h4>{title}</h4><p>{copy}</p></div></li>)}</ol><SectionActionButton href="/free-quote" label="Start my valuation" intent="valuation" /></aside></div><p class="business-note" data-reveal>For several business vehicles, include a list with individual conditions and parking positions. Explore <a href="/fleet-disposal/">fleet disposal</a> for commercial enquiries.</p></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="process-heading" data-reveal><div><p class="eyebrow">Valuation &amp; collection planning</p><h2 id="process-title">Clear details.<br /><span>A considered next step.</span></h2></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index)=><li data-reveal><div class="step-marker"><span>0{index+1}</span><LocationGlyph kind={icon} /></div><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>

    <section class="nearby-section" aria-labelledby="nearby-title"><div class="smc-container" data-reveal><p class="eyebrow">Sharjah &amp; UAE location guides</p><h2 id="nearby-title">Find your Sharjah setting.</h2><nav class="nearby-links" aria-label="Sharjah location guides"><SectionActionButton href="/locations/sharjah/" label="All Sharjah" intent="process" icon="ph-map-trifold" /><SectionActionButton href="/locations/sharjah/sajaa/" label="Sajaa / Al Sajaa" intent="process" icon="ph-warehouse" /><SectionActionButton href="/locations/sharjah/#al-nahda" label="Al Nahda" intent="process" icon="ph-buildings" /><SectionActionButton href="/locations/" label="All UAE locations" intent="process" icon="ph-map-trifold" /></nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">Workshop collection<br /><span>questions, answered.</span></h2><p>Practical information for service garages, industrial parking and commercial vehicle enquiries.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index)=><details open={index===0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><LocationGlyph kind="vehicle" /><h2 id="final-title">A car at a workshop?<br /><span>Start with its details.</span></h2><p>Share the details, known condition and exact collection location to start a free valuation.</p><SectionActionButton href="/free-quote" label="Get My Free Valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>

.industrial-area-page{color:#193e2b;background:#fff;overflow:clip}.industrial-area-page :is(h1,h2,h3,p,figure){margin:0}.industrial-area-page :is(h1,h2){letter-spacing:-.05em}.industrial-area-page h2{font-size:clamp(2.2rem,3.7vw,3.4rem);line-height:1.1}.industrial-area-page h2 span,.accent{color:#43804a}.industrial-area-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
.hero{padding-top:22px;background:radial-gradient(ellipse at 10% 90%,#d9e9c899,transparent 55%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
.industrial-area-page :is(a,button,summary):focus-visible{outline:3px solid #3181ab;outline-offset:4px}.industrial-area-page [id]{scroll-margin-top:35px}.page-progress{display:none;position:fixed;top:0;left:0;right:0;height:3px;background:#74a952;z-index:110;transform:scaleX(var(--scroll-progress,0));transform-origin:left;pointer-events:none}.motion-ready .page-progress{display:block}.motion-ready [data-reveal]{opacity:0;transform:translateY(20px);transition:opacity 650ms ease,transform 650ms ease;transition-delay:var(--reveal-delay,0ms)}.motion-ready [data-reveal].is-visible{opacity:1;transform:none}
@media(hover:hover){.industrial-area-page :global(.section-action:hover){transform:translateY(-3px);box-shadow:0 16px 28px #173d2925}.industrial-area-page :global(.section-action:hover i){transform:scale(1.05) rotate(-4deg)}.photo-scene:hover .scene-image{transform:scale(1.075) translate3d(0,var(--scene-shift,0px),0)}}
@media(prefers-reduced-motion:reduce){.industrial-area-page [data-reveal]{opacity:1!important;transform:none!important;transition:none!important}.page-progress{display:none!important}.industrial-area-page :global(.section-action),.industrial-area-page :global(.section-action i),.scene-image{transition:none!important;transform:none!important}.industrial-area-page :global(.section-action:hover),.industrial-area-page :global(.section-action:hover i){transform:none!important}}

.coverage-section{background:#f7f9f3}.coverage-layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:65px;align-items:start}.coverage-layout header h2{margin:17px 0 23px}.coverage-layout header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5b735f}.coverage-layout .eyebrow{font-size:10px}.local-note{display:flex;gap:15px;padding-top:23px;margin-top:23px!important;border-top:1px solid #d4e2c9;font-size:14px!important}.local-note>:global(.location-glyph){width:35px;height:35px;flex-shrink:0;color:#4a7b48}.coverage-settings{background:#fff;border:1px solid #d3e1c7;border-radius:24px;overflow:hidden}.coverage-settings details+details{border-top:1px solid #d9e5ce}.coverage-settings summary{display:flex;align-items:center;gap:15px;list-style:none;cursor:pointer;padding:22px 24px;font-size:20px;font-weight:750;line-height:1.5}.coverage-settings summary::-webkit-details-marker{display:none}.coverage-settings summary>:global(.location-glyph){width:31px;height:31px;flex-shrink:0;color:#4f7d48}.coverage-settings summary i{margin-left:auto;font-size:22px;color:#4d7c48;flex-shrink:0}.coverage-settings details[open] summary{background:#f0f6e8}.coverage-settings details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.coverage-settings details>p{font-size:14px;line-height:1.85;color:#56705b;padding:0 24px 23px 70px;background:#f0f6e8}
.recovery-section{padding:55px 0 0;background:radial-gradient(ellipse at 2% 70%,#e1edd4aa,transparent 60%)}.recovery-feature{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);border-radius:26px;overflow:hidden;background:#173d2b;box-shadow:0 20px 38px #21442a14}.photo-scene{position:relative;isolation:isolate;overflow:hidden;background:#e2ebd8}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.025) translate3d(0,var(--scene-shift,0px),0);transition:transform 800ms cubic-bezier(.2,.7,.2,1)}.recovery-scene{min-height:460px}.recovery-scene .scene-image{object-position:50% 53%}.recovery-copy{padding:27px;align-self:center;min-width:0;color:#fff}.recovery-copy .eyebrow,.recovery-copy h2 span{color:#bfdca8}.recovery-copy h2{font-size:32px;line-height:1.1;margin:14px 0 16px}.recovery-copy>p:not(.eyebrow){font-size:14px;line-height:1.75;color:#d9e7cf}.recovery-copy ul{list-style:none;padding:0;margin:18px 0 20px;display:grid;gap:12px}.recovery-copy li{display:flex;align-items:center;gap:11px;font-size:13px;line-height:1.6;color:#e0ecd7}.recovery-copy li i{font-size:22px;color:#b5d79d;flex-shrink:0}.recovery-copy :global(.section-action){font-size:12px;width:100%;justify-content:space-between;min-height:46px;border-color:#9abf83}.recovery-copy :global(.section-action i){width:29px;height:29px;font-size:17px}
