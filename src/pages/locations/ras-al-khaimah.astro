---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SectionActionButton from '../../components/SectionActionButton.astro';
import LocationGlyph from '../../components/LocationGlyph.astro';
import LocationsMotion from '../../components/LocationsMotion.astro';
import { getVehicleData } from '../../lib/vehicle-data';
import { rakCoverageLocations, rakCollectionSettings } from '../../lib/ras-al-khaimah-coverage';
const accessNotes = [
  ['access', 'The approach', 'Describe compound gates, workshop entrances, industrial plot access and the space around the vehicle.'],
  ['keys', 'Keys & steering', 'Mention missing keys or known steering restrictions. Share what you know; no need to test the car.'],
  ['vehicle', 'Rolling condition', 'Include locked wheels, flat tyres or damage that may affect movement. A non-running car may need a different recovery approach.'],
  ['collection', 'Working space', 'Explain where recovery equipment could stand, any ground or clearance limits and who can arrange entry.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'ph-car-profile'], ['/sell-non-running-car/', 'Non-running cars', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'ph-wrench'], ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'ph-drop'], ['/scrap-my-car/', 'Scrap my car', 'ph-recycle'], ['/fleet-disposal/', 'Fleet disposal', 'ph-truck']
];
const steps = [
  ['vehicle', 'Vehicle details', 'Start with the make, model, year and your contact details.'],
  ['review', 'Known condition', 'Describe damage, faults, keys and the car’s known mobility.'],
  ['coverage', 'Location & access', 'Share the precise RAK location, parking position and approach.'],
  ['collection', 'The next step', 'Discuss the valuation and practical arrangements before collection is agreed.']
];
const faqs = [
  ['Can I sell or scrap a non-running car in Ras Al Khaimah?', 'You can request a free valuation for an unwanted, damaged or non-running car. Share the vehicle details, known condition, mobility and exact location. The assessment and possible collection arrangements depend on the individual car and access review.'],
  ['Which Ras Al Khaimah areas can I enquire about?', 'Ras Al Khaimah is included in our UAE location coverage. Provide your exact area and parking position so coverage and practical access can be reviewed. An enquiry does not confirm a collection booking or guarantee collection.'],
  ['What if the car is inside a compound or behind a gate?', 'Describe the entrance, clearance, route to the vehicle and any security or permission requirements. Identify the person who can arrange entry and vehicle handover.'],
  ['Can you consider a car on an industrial plot or at a workshop?', 'Share the precise premises location, vehicle position, gate and available recovery space. Include working-area restrictions, other vehicles nearby and who can authorise release.'],
  ['What should I share for an outer-area location?', 'Provide the exact location and the approach from the road. Describe the ground surface, entrance width, restrictions and recovery space so practical access can be reviewed.'],
  ['What if the car has no keys or cannot roll or steer?', 'Mention missing keys, locked wheels, flat tyres or known steering restrictions when you enquire. These details may affect recovery equipment and access. You do not need to start or move the vehicle to request a valuation.'],
  ['Can several commercial vehicles be assessed together?', 'Start a fleet disposal enquiry with a vehicle list, individual conditions, parking positions and the authorised site contact. Access and possible handover arrangements may need a separate review for each vehicle.'],
  ['What affects the valuation and collection arrangements?', 'Vehicle details, known condition, damage, mobility, available documents and collection access can affect the review. The team can confirm the information and handover requirements for your circumstances before arrangements are agreed.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' },
  { '@type': 'ListItem', position: 3, name: 'Ras Al Khaimah', item: 'https://www.scrapmycaruae.com/locations/ras-al-khaimah/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Sell or Scrap My Car Ras Al Khaimah | Free Valuation" description="Sell or scrap an unwanted, damaged or non-running car in Ras Al Khaimah. Request a free valuation and share your vehicle condition and collection location." canonical="/locations/ras-al-khaimah/" ogImage="/sections/ras-al-khaimah-vehicle-collection.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="rak-page" data-location-hub><div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="hero" aria-labelledby="rak-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">UAE Locations</a><span aria-hidden="true">/</span><span aria-current="page">Ras Al Khaimah</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><LocationGlyph kind="ras-al-khaimah" /> Ras Al Khaimah vehicle valuation</p><h1 id="rak-title"><span>Sell or scrap your car</span> <span class="accent">in Ras Al Khaimah</span></h1><p class="hero-lead">Request a free valuation for an unwanted, damaged or non-running car in Ras Al Khaimah. Share the vehicle details, condition and collection location to start the process.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><LocationGlyph kind="vehicle" />Damaged &amp; non-running cars</li><li><LocationGlyph kind="ras-al-khaimah" />Ras Al Khaimah residential &amp; industrial areas</li><li><LocationGlyph kind="collection" />Collection access considered</li></ul></div></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><header class="coverage-heading" data-reveal><div class="region-mark"><LocationGlyph kind="ras-al-khaimah" /><span>UAE / RAK</span></div><div><p class="eyebrow">Ras Al Khaimah coverage overview</p><h2 id="coverage-title">From the entrance<br /><span>to the car.</span></h2></div><p>Tell us the exact location and how the vehicle can be reached. Residential parking, industrial premises and outer-area sites each need useful access details.</p></header><div class="coverage-strip" data-reveal><div>{rakCoverageLocations.map(name => <strong>{name}</strong>)}<span>Location enquiries · individual access review</span></div><SectionActionButton href="/locations/" label="Explore UAE coverage" intent="process" icon="ph-map-trifold" /></div><div class="setting-guides" data-reveal>{rakCollectionSettings.map((setting,index) => <details id={setting.id} open={index === 0}><summary><span class="setting-number">0{index+1}</span><LocationGlyph kind={setting.icon} /><span>{setting.title}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><div><p>{setting.copy}</p><p class="guide-detail">{setting.detail}</p></div></details>)}</div></div></section>

    <section class="collection-section" aria-labelledby="collection-title"><div class="smc-container"><figure class="photo-scene collection-scene" data-scene data-reveal><div class="collection-stage"><img class="scene-image" src="/sections/ras-al-khaimah-vehicle-collection.webp" alt="Dusty older silver sedan and recovery operator beside an unbranded flatbed on a Ras Al Khaimah compound approach with distant rocky foothills" width="1440" height="960" loading="lazy" decoding="async" /><div class="photo-shade" aria-hidden="true"></div><div class="collection-copy"><p class="eyebrow">Residential · industrial · outer-area</p><h2 id="collection-title">Different settings.<br />One practical review.</h2><p>A compound entrance, a workshop forecourt or an open plot can change the approach. The parking position matters as much as the location.</p></div><aside class="access-panel"><LocationGlyph kind="access" /><h3>Start with the approach.</h3><p>Describe the entrance, surface and space around the car. Include anything that could limit recovery access.</p><SectionActionButton href="/car-removal/" label="Read the collection guide" intent="process" icon="ph-truck" /></aside></div><figcaption>Illustrative Ras Al Khaimah collection preparation. Exact location and access are reviewed for the individual vehicle.</figcaption></figure></div></section>

    <section class="section mobility-section" aria-labelledby="mobility-title"><div class="smc-container"><header class="section-heading" data-reveal><p class="eyebrow">Access &amp; vehicle mobility</p><h2 id="mobility-title">What can move?<br /><span>What needs planning?</span></h2><p>Share what is already known about your car. You do not need to start, move or test it to make an enquiry.</p></header><div class="mobility-notes">{accessNotes.map(([icon,title,copy]) => <article data-reveal><LocationGlyph kind={icon} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section vehicle-section" aria-labelledby="vehicles-title"><div class="smc-container"><header data-reveal><p class="eyebrow">Vehicles we can assess</p><h2 id="vehicles-title">Choose the guide<br /><span>that fits your car.</span></h2><p>Start with its known condition, whether you want to sell as-is or explore scrapping. Read the <a href="/sell-my-car/">sell my car guide</a> for the wider process.</p></header><nav class="service-buttons" aria-label="Ras Al Khaimah vehicle assessment guides" data-reveal>{vehicleRoutes.map(([href,label,icon]) => <SectionActionButton href={href} label={label} intent="valuation" icon={icon} />)}</nav></div></section>

    <section class="section commercial-section" aria-labelledby="commercial-title"><div class="smc-container"><header class="commercial-heading" data-reveal><div><p class="eyebrow">Industrial &amp; commercial collection</p><h2 id="commercial-title">A working site.<br /><span>A considered handover.</span></h2></div><div><p>For a RAK workshop, industrial plot or commercial yard, include the route through the premises and who can authorise release. Several cars may need separate condition and access reviews.</p><SectionActionButton href="/fleet-disposal/" label="Discuss commercial vehicles" intent="contact" icon="ph-truck" /></div></header><figure class="photo-scene commercial-scene" data-scene data-reveal><div class="commercial-stage"><img class="scene-image" src="/sections/ras-al-khaimah-commercial-recovery.webp" alt="Older worn maroon sedan being prepared for flatbed recovery in an open Ras Al Khaimah industrial plot beside a workshop with rocky hills beyond" width="1440" height="960" loading="lazy" decoding="async" /><div class="site-label"><LocationGlyph kind="review" /><span>Before collection is agreed<br /><strong>Review each vehicle and its access</strong></span></div></div><figcaption>Illustrative industrial recovery preparation. Site permission, mobility and vehicle release details help inform the arrangements.</figcaption></figure><div class="site-brief" data-reveal><h3>A useful site brief</h3><ul><li><i class="ph ph-list-checks" aria-hidden="true"></i><span>Vehicle list &amp; individual condition</span></li><li><i class="ph ph-key" aria-hidden="true"></i><span>Keys, mobility &amp; parking positions</span></li><li><i class="ph ph-user-check" aria-hidden="true"></i><span>Entry permission &amp; release contact</span></li></ul></div></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="process-heading" data-reveal><div><p class="eyebrow">Valuation + collection planning</p><h2 id="process-title">From details<br /><span>to a next step.</span></h2></div><SectionActionButton href="/free-quote" label="Start my free valuation" intent="valuation" /></header><ol class="planning-steps">{steps.map(([icon,title,copy],index) => <li data-reveal><div class="step-marker"><span>0{index+1}</span><LocationGlyph kind={icon} /></div><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>

    <section class="guide-section" aria-labelledby="guide-title"><div class="smc-container" data-reveal><p class="eyebrow">Ras Al Khaimah area navigation</p><h2 id="guide-title">Your parking setting.</h2><p>Use these access guides, then share your exact area. Collection arrangements are reviewed individually.</p><nav class="guide-navigation" aria-label="Ras Al Khaimah collection setting guides">{rakCollectionSettings.map(setting => <SectionActionButton href={`#${setting.id}`} label={setting.id === 'compound-parking' ? 'Residential & compounds' : setting.id === 'commercial-premises' ? 'Workshops & industrial plots' : 'Outer-area access'} intent="process" icon={setting.id === 'compound-parking' ? 'ph-buildings' : setting.id === 'commercial-premises' ? 'ph-warehouse' : 'ph-mountains'} />)}</nav></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">RAK collection<br /><span>questions.</span></h2><p>Useful details for your vehicle and the place it is parked.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question,answer],index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><LocationGlyph kind="ras-al-khaimah" /><p class="eyebrow">Your car. Your Ras Al Khaimah location.</p><h2 id="final-title">Tell us where it is.<br /><span>Start with a free valuation.</span></h2><p>Share the vehicle details, known condition and collection location. We’ll discuss the practical next step.</p><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main><LocationsMotion />
</BaseLayout>

<style>
  .rak-page{color:#193e2b;background:#fff;overflow:clip}.rak-page :is(h1,h2,h3,p,figure){margin:0}.rak-page :is(h1,h2){letter-spacing:-.05em}.rak-page h2{font-size:clamp(2.2rem,3.8vw,3.45rem);line-height:1.1}.rak-page h2 span,.accent{color:#437d49}.rak-page h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}.section{padding:clamp(60px,7vw,100px) 0}.eyebrow{display:flex;align-items:center;gap:9px;color:#42764a;font-weight:800;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.eyebrow :global(.location-glyph){width:27px;height:27px}.breadcrumb{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#5c7461}.breadcrumb a{color:#3c6846;text-decoration:none}
  .hero{padding-top:22px;background:radial-gradient(ellipse at 0 100%,#dbe8cc99,transparent 58%),#f5f8f1}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);grid-template-areas:'copy form' 'points form';gap:25px 65px;padding:45px 0}.hero-copy{grid-area:copy;align-self:end}.hero-copy h1{font-size:clamp(2rem,3.5vw,3.3rem);line-height:1.1;margin-top:22px}.hero-copy h1>span{display:block;white-space:nowrap}.hero-lead{font-size:16px;line-height:1.8;color:#58705e;margin-top:22px!important;max-width:570px}.hero-form{grid-area:form;min-width:0;filter:drop-shadow(0 18px 26px #284a2a12)}.hero-points{grid-area:points;align-self:start;display:grid;gap:12px;list-style:none;padding:0;margin:0}.hero-points li{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:700;line-height:1.5}.hero-points :global(.location-glyph){width:32px;height:32px;padding:4px;border-radius:9px;background:#e5efdc;color:#397347;flex-shrink:0}
  .coverage-heading{display:grid;grid-template-columns:95px minmax(0,1fr) minmax(0,.75fr);gap:30px;align-items:center}.region-mark{display:flex;flex-direction:column;align-items:center;gap:9px;padding:14px 8px;border:1px solid #d4e2c7;border-radius:24px;background:#f0f5e8}.region-mark :global(.location-glyph){width:60px;height:60px;color:#4b7e4b}.region-mark span{font-size:9px;letter-spacing:.1em;font-weight:800;color:#547348}.coverage-heading h2{margin-top:15px}.coverage-heading>p{font-size:15px;line-height:1.8;color:#5c7260}.coverage-strip{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-top:36px;padding:25px 28px;background:#eff5e8;border:1px solid #dce7d0;border-radius:20px}.coverage-strip>div{display:flex;flex-direction:column;gap:8px}.coverage-strip strong{font-size:24px;letter-spacing:-.03em}.coverage-strip span{font-size:12px;color:#5d745e}.coverage-strip :global(.section-action){font-size:12px}.setting-guides{margin-top:25px;border-top:1px solid #d9e4d0}.setting-guides details{border-bottom:1px solid #d9e4d0;scroll-margin-top:30px}.setting-guides summary{display:flex;align-items:center;gap:20px;list-style:none;cursor:pointer;padding:25px 0;font-size:20px;font-weight:750;line-height:1.5}.setting-guides summary::-webkit-details-marker{display:none}.setting-number{font-size:11px;color:#74935e;font-weight:800}.setting-guides summary>:global(.location-glyph){width:33px;height:33px;color:#4a7e4c;flex-shrink:0}.setting-guides summary i{margin-left:auto;font-size:22px;color:#4d7c48;flex-shrink:0}.setting-guides details[open] summary i,.faq-stack details[open] summary i{transform:rotate(45deg)}.setting-guides details>div{padding:0 30px 25px 85px;max-width:960px}.setting-guides details p{font-size:14px;line-height:1.8;color:#5f7361}.setting-guides .guide-detail{font-size:12px;color:#3e6945;margin-top:15px;font-weight:700}
  .collection-section{background:radial-gradient(ellipse at 95% 50%,#dce8cc99,transparent 60%);padding:0 0 15px}.photo-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:30px;box-shadow:0 24px 45px #24452a15;background:#edf3e7}.collection-stage,.commercial-stage{position:relative;isolation:isolate;overflow:hidden}.scene-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.035) translate3d(0,var(--scene-shift,0px),0);transition:transform 900ms cubic-bezier(.2,.7,.2,1)}.collection-stage{display:grid;grid-template-columns:1fr .7fr;gap:45px;align-items:end;padding:48px;min-height:690px;background:#163426}.collection-stage .scene-image{object-position:50% 48%}.photo-shade{position:absolute;inset:0;background:linear-gradient(0deg,#092117f2,transparent 85%)}.collection-copy{position:relative;z-index:1;color:#fff;max-width:560px}.collection-copy .eyebrow{color:#c7dfb4;font-size:10px}.collection-copy h2{font-size:clamp(2rem,3.4vw,3.2rem);margin:16px 0 21px}.collection-copy>p:not(.eyebrow){font-size:14px;line-height:1.85;color:#d3e1cb;max-width:490px}.access-panel{position:relative;z-index:1;background:#fff;border-radius:24px;padding:28px;color:#21462e;box-shadow:0 20px 35px #0c23182b}.access-panel>:global(.location-glyph){width:39px;height:39px;color:#4c7e4a;margin-bottom:18px}.access-panel h3{font-size:24px;margin-bottom:15px}.access-panel p{font-size:14px;line-height:1.8;color:#58715d}.access-panel :global(.section-action){width:100%;justify-content:space-between;margin-top:23px;font-size:11px}.photo-scene figcaption{position:relative;z-index:2;background:#fff;color:#294b32;font-size:14px;line-height:1.65;padding:18px 24px;border-top:1px solid #dfe8d7}
  .mobility-section .smc-container{display:grid;grid-template-columns:.75fr 1fr;gap:75px}.section-heading h2{margin:17px 0 22px}.section-heading>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5d7360}.mobility-notes article{display:flex;align-items:flex-start;gap:20px;padding:25px 0;border-top:1px solid #d8e4cf}.mobility-notes article:first-child{padding-top:0;border-top:0}.mobility-notes article>:global(.location-glyph){width:37px;height:37px;flex-shrink:0;color:#42794b}.mobility-notes h3{font-size:20px;margin:3px 0 10px}.mobility-notes p{font-size:14px;line-height:1.8;color:#617463}
  .vehicle-section{padding-top:0}.vehicle-section header{max-width:750px}.vehicle-section h2{margin:16px 0 23px}.vehicle-section header>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#5d7460;max-width:700px}.vehicle-section header a{color:#366f40;font-weight:750;text-underline-offset:4px}.service-buttons{display:flex;flex-wrap:wrap;gap:14px;margin:30px 0 0;max-width:1080px}.service-buttons :global(.section-action){min-width:222px;justify-content:space-between;box-shadow:none}
  .commercial-section{background:radial-gradient(ellipse at 85% 20%,#4d713f55,transparent 65%),#163b29;color:#fff}.commercial-heading{display:grid;grid-template-columns:1fr .85fr;gap:80px;align-items:end;margin-bottom:35px}.commercial-heading h2{margin-top:16px}.commercial-heading .eyebrow,.commercial-heading h2 span{color:#c0dca9}.commercial-heading>div>p:not(.eyebrow){font-size:15px;line-height:1.85;color:#d0dfc8}.commercial-heading :global(.section-action){margin-top:25px;border-color:#9dbd85}.commercial-stage{height:520px}.commercial-stage .scene-image{object-position:50% 55%}.site-label{position:absolute;top:25px;left:25px;display:flex;align-items:center;gap:12px;padding:16px 19px;background:#fffffff5;border-radius:16px;color:#4e7153;font-size:12px;line-height:1.65;box-shadow:0 10px 25px #162c2118}.site-label :global(.location-glyph){width:36px;height:36px;color:#4b7b47}.site-label strong{color:#214a30}.site-brief{display:grid;grid-template-columns:180px 1fr;gap:40px;padding-top:30px}.site-brief h3{font-size:22px;color:#e9f3df}.site-brief ul{display:grid;grid-template-columns:1fr 1fr 1fr;gap:25px;list-style:none;margin:0;padding:0}.site-brief li{display:flex;gap:13px;font-size:13px;line-height:1.75;color:#d2e2c6}.site-brief i{font-size:28px;color:#b7d89c;flex-shrink:0}
