---
export const prerender = false;

import { media } from '@wix/sdk';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { wixClient } from '../../../lib/wix';
import { wixResponsiveImage } from '../../../lib/wix-image';

const slug = Astro.params.slug ?? '';
let category: any = null;
let posts: any[] = [];
let loadError = '';

try {
  const result = await wixClient.categories.getCategoryBySlug(slug);
  category = result.category;

  if (!category?._id || !category?.label || !category?.slug) {
    Astro.response.status = 404;
  } else {
    const postResult = await wixClient.posts
      .queryPosts()
      .hasSome('categoryIds', [category._id])
      .descending('firstPublishedDate')
      .limit(100)
      .find();

    posts = postResult.items ?? [];
  }
} catch (error) {
  Astro.response.status = 404;
  loadError = error instanceof Error ? error.message : String(error);
}

const canonical = category?.slug
  ? `/blogs/category/${encodeURIComponent(category.slug)}`
  : `/blogs/category/${encodeURIComponent(slug)}`;

const title = category?.label
  ? `${category.label} | Scrap My Car UAE Blog`
  : 'Category not found | Scrap My Car UAE';

const description = category?.description || '';

const getImage = (post: any) => {
  const image = post?.media?.wixMedia?.image;
  if (!image) return null;

  if (typeof image === 'string') {
    try {
      return media.getImageUrl(image);
    } catch {
      return null;
    }
  }

  return image?.url ? image : null;
};

const formatDate = (value: string | Date | undefined) => {
  if (!value) return '';
  return new Intl.DateTimeFormat('en-AE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(new Date(value));
};
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={!category}>
  {category ? (
    <main class="category-shell smc-container">
      <a class="back-link" href="/blogs"><i class="ph ph-arrow-left" aria-hidden="true"></i>All articles</a>

      <header class="category-hero">
        <div class="smc-kicker">Blog category</div>
        <h1>{category.label}</h1>
        {description && <p>{description}</p>}
        <span class="post-count">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
      </header>

      {posts.length ? (
        <section class="grid" aria-label={`${category.label} articles`}>
          {posts.map((post: any, index) => {
            const responsiveImage = wixResponsiveImage(getImage(post), {
              widths: [320, 480, 640, 800],
              aspectRatio: 900 / 506
            });

            return (
              <article class="card">
                <a class="card-link" href={`/post/${post.slug}`}>
                  <div class="image-wrap" data-image-loading>
                    {responsiveImage.src && (
                      <picture>
                        <source type="image/avif" srcset={responsiveImage.avifSrcset} sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1100px) calc(50vw - 42px), 360px" />
                        <img
                          src={responsiveImage.src}
                          srcset={responsiveImage.srcset}
                          sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1100px) calc(50vw - 42px), 360px"
                          alt={post?.media?.altText || post.title || ''}
                          width={responsiveImage.width}
                          height={responsiveImage.height}
                          loading={index === 0 ? 'eager' : 'lazy'}
                          fetchpriority={index === 0 ? 'high' : 'auto'}
                          decoding="async"
                        />
                      </picture>
                    )}
                  </div>
                  <div class="card-body">
                    <div class="card-meta">{formatDate(post.firstPublishedDate)} {post.minutesToRead && `• ${post.minutesToRead} min read`}</div>
                    <h2>{post.title}</h2>
                    {post.excerpt && <p>{post.excerpt}</p>}
                  </div>
                </a>
              </article>
            );
          })}
        </section>
      ) : (
        <p class="empty">There are no published articles in this category yet.</p>
      )}
    </main>
  ) : (
    <main class="not-found smc-container">
      <h1>Category not found</h1>
      <p>The requested blog category is unavailable.</p>
      <a href="/blogs">Return to all articles</a>
      {import.meta.env.DEV && loadError && <pre>{loadError}</pre>}
    </main>
  )}
</BaseLayout>

<style>
  .category-shell { padding: 58px 0 84px; }
  .back-link { display: inline-flex; align-items: center; gap: 7px; color: #245826; font-size: 14px; font-weight: 800; text-decoration: none; }
  .back-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .back-link:focus-visible, .card-link:focus-visible { outline: 3px solid rgba(47, 111, 45, .28); outline-offset: 4px; border-radius: 10px; }
  .category-hero { margin: 22px 0 42px; padding: clamp(26px, 5vw, 54px); border: 1px solid #dbe8d7; border-radius: 24px; background: linear-gradient(135deg, #f4f9f1, #fff); }
  .category-hero h1 { margin: 9px 0 13px; font-size: clamp(40px, 6vw, 68px); line-height: 1; letter-spacing: -.055em; }
  .category-hero p { max-width: 700px; margin: 0; color: var(--smc-muted); font-size: 18px; line-height: 1.65; }
  .post-count { display: inline-flex; margin-top: 21px; padding: 6px 10px; border-radius: 999px; background: #e4f0df; color: #245826; font-size: 13px; font-weight: 800; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 24px; }
  .card { overflow: hidden; border: 1px solid var(--smc-line); border-radius: 18px; background: #fff; transition: transform 180ms ease, box-shadow 180ms ease; }
  .card:hover { transform: translateY(-3px); box-shadow: var(--smc-shadow); }
  .card-link { display: block; height: 100%; color: inherit; text-decoration: none; }
  .image-wrap { aspect-ratio: 16 / 10; overflow: hidden; background: #eef0ec; }
  .image-wrap img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 240ms ease; }
  .card:hover .image-wrap img { transform: scale(1.025); }
  .card-body { padding: 19px; }
  .card-meta { color: #657565; font-size: 13px; font-weight: 750; }
  .card h2 { margin: 9px 0; font-size: 23px; line-height: 1.2; letter-spacing: -.025em; }
  .card p { margin: 0; color: var(--smc-muted); line-height: 1.55; }
  .empty { padding: 28px; border: 1px solid var(--smc-line); border-radius: 14px; color: var(--smc-muted); }
  .not-found { padding: 96px 0; text-align: center; }
  .not-found a { color: #245826; font-weight: 800; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .category-shell { padding-top: 36px; } .category-hero { margin-bottom: 28px; border-radius: 18px; } .grid { grid-template-columns: 1fr; } }
</style>
