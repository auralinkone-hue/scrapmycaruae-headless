---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import LocationCoverageList from '../components/LocationCoverageList.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import ServicePageMotion from '../components/ServicePageMotion.astro';
import { getRelevantPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';

const areas = [
  ['ph-lightning', 'Electrical systems', 'Water exposure may affect electrical operation, including wiring/control modules.'],
  ['ph-engine', 'Engine/transmission', 'Exposure may affect mechanical components. Any existing workshop findings are useful.'],
  ['ph-armchair', 'Interior', 'Carpets, seats and hidden trim areas may retain moisture or show water marks.'],
  ['ph-drop', 'Corrosion', 'Moisture may contribute to corrosion, including in areas that are not readily visible.'],
  ['ph-gauge', 'Sensors', 'Warning messages or unusual readings may need professional assessment.']
];
const signs = [
  ['01', 'Dampness or musty odours', 'Mention wet carpets, damp upholstery or a persistent smell.'],
  ['02', 'Mud, silt or water lines', 'Describe marks in the cabin, boot or around the lower body.'],
  ['03', 'Warning lights or irregular operation', 'Share dashboard messages and changes you have already noticed.'],
  ['04', 'Starting or driving changes', 'Explain any known difficulty starting, loss of drive or unusual noises.']
];
const factors = [
  ['Vehicle details', 'Make, model, year and mileage give the review its starting point.'],
  ['Known water exposure', 'Approximate depth, duration and areas reached are helpful if known. Do not guess.'],
  ['Current condition', 'Visible damage, reported symptoms and any previous repairs are considered together.'],
  ['Existing assessment', 'Share workshop reports or repair estimates already available; none is needed to begin.'],
  ['Documents and access', 'Ownership, registration status, location and recovery access help clarify the practical route.']
];
const faqs = [
  ['Can I sell a flood-damaged car in the UAE?', 'You can request a valuation in its current condition. Share the vehicle details, known water exposure, symptoms and any existing assessment so the team can review the possible next steps.'],
  ['Do I need to repair or clean the car first?', 'Repairs are not required before requesting a valuation. Describe the condition accurately and share photographs where available. Cleaning or drying alone does not establish whether hidden damage is present.'],
  ['Can you value a non-running flood-damaged car?', 'Yes. Explain its current known condition, whether it can roll and steer, whether keys are available and where it is parked. Collection feasibility needs a separate access review.'],
  ['Does a running car mean the flood damage is minor?', 'No. A running vehicle may still have hidden or developing issues. Starting or driving status alone does not establish the extent of water damage or confirm roadworthiness.'],
  ['What information should I share about water exposure?', 'Share what you know about when the exposure happened, the approximate water level, how long the vehicle was exposed and any symptoms or workshop findings. It is fine to say when something is unknown.'],
  ['Is a flood-damaged car always treated as scrap?', 'No. The vehicle details and current condition help determine whether an as-is sale or a potential scrap route is appropriate. There is no fixed outcome or guaranteed price based on flood exposure alone.'],
  ['Can collection be discussed outside Dubai?', 'Yes. Share your UAE location and exact parking position. Collection is subject to the vehicle condition, access, recovery requirements and arrangements agreed with the team.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
try { helpfulPosts = await getRelevantPosts({}, ['flood', 'water damage', 'damaged car', 'non-running', 'valuation']); } catch { helpfulPosts = []; }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Sell My Car', item: 'https://www.scrapmycaruae.com/sell-my-car/' },
  { '@type': 'ListItem', position: 3, name: 'Sell Flood-Damaged Car', item: 'https://www.scrapmycaruae.com/sell-flood-damaged-car/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title="Sell Flood-Damaged Car UAE | Free Valuation" description="Request a free valuation for a flood-damaged car in the UAE. Share the known water exposure, current condition and location to discuss selling as-is and collection." canonical="/sell-flood-damaged-car/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="flood-page" data-service-motion>
    <section class="flood-hero" aria-labelledby="flood-title">
      <div class="smc-container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/sell-my-car/">Sell My Car</a><span aria-hidden="true">›</span><span aria-current="page">Flood-damaged cars</span></nav>
        <div class="hero-grid">
          <div class="hero-copy"><p class="eyebrow"><i class="ph ph-drop" aria-hidden="true"></i> A clearer route after water damage</p><h1 id="flood-title"><span class="hero-title-line">Sell a <span>flood-damaged</span></span> <span class="hero-title-line">car in the UAE</span></h1><p class="hero-lead">Water damage can affect a vehicle far beyond what is visible. Share the vehicle details, current condition and known symptoms to request a free valuation.</p></div>
          <div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div>
          <ul class="hero-points"><li><i class="ph ph-check-circle" aria-hidden="true"></i>Request a valuation as-is</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Running and non-running cars</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Discuss collection and access</li></ul>
        </div>
        <div class="hero-footnote"><i class="ph ph-info" aria-hidden="true"></i><p>Start with what you know. A symptom or water mark is useful context, not a diagnosis.</p></div>
      </div>
    </section>

    <section class="section affected-section" aria-labelledby="affected-title"><div class="smc-container affected-grid">
      <div class="affected-copy"><p class="eyebrow">Beyond the visible water line</p><h2 id="affected-title">What flood damage <span>can affect</span></h2><p class="lead">Water can reach more than the bodywork. The areas below may be affected; the extent varies and needs assessment.</p><div class="area-list">{areas.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div><SectionActionButton href="/sell-damaged-car/" label="Explore damaged cars" intent="valuation" icon="ph-car-profile" /></div>
      <figure class="photo-visual inspection-photo"><span class="photo-visual__graphic" aria-hidden="true"></span><img src="/sections/flood-damaged-car-inspection.webp" alt="Technician inspecting the damp interior of an older sedan with mud and water marks in a UAE-style workshop" width="1200" height="900" loading="lazy" decoding="async" /><figcaption><i class="ph ph-magnifying-glass" aria-hidden="true"></i>Share visible water marks and any inspection findings you already have.</figcaption></figure>
    </div></section>

    <section class="section signs-section" aria-labelledby="signs-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">Useful details to describe</p><h2 id="signs-title">Common signs of <span>water damage</span></h2><p>Report what you have already noticed. These signs can have other causes and do not confirm flood damage by themselves.</p></header><div class="signs-grid">{signs.map(([number, heading, copy]) => <article><span>{number}</span><h3>{heading}</h3><p>{copy}</p></article>)}</div><p class="quiet-note"><i class="ph ph-chat-circle-text" aria-hidden="true"></i>Unknown details are okay. You do not need to investigate or test the car to request a valuation.</p></div></section>

    <section class="section options-section" aria-labelledby="options-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">Consider the whole vehicle</p><h2 id="options-title">Repair, sell as-is <span>or scrap?</span></h2><p>Water exposure alone does not decide the outcome. Compare the available information before choosing a route.</p></header><div class="options-grid"><article><i class="ph ph-wrench" aria-hidden="true"></i><p class="route-label">01 / Repair</p><h3>Understand the scope first</h3><p>A professional assessment and clear repair estimate may help you decide whether keeping the vehicle makes sense.</p></article><article class="option-featured"><i class="ph ph-car-profile" aria-hidden="true"></i><p class="route-label">02 / Sell as-is</p><h3>Value its current condition</h3><p>Share the damage and known symptoms to explore selling without arranging repairs first.</p><SectionActionButton href="/free-quote" label="Request my free valuation" intent="valuation" /></article><article><i class="ph ph-recycle" aria-hidden="true"></i><p class="route-label">03 / Potential scrap route</p><h3>When damage is extensive</h3><p>An end-of-life route may be discussed where the overall condition makes repair or resale less practical.</p><SectionActionButton href="/scrap-my-car/" label="Explore the scrap route" intent="valuation" icon="ph-recycle" /></article></div></div></section>

    <section class="section value-section" aria-labelledby="value-title"><div class="smc-container value-grid"><header><p class="eyebrow">A review, not a fixed formula</p><h2 id="value-title">What affects <span>value?</span></h2><p class="lead">No single water mark or warning light produces a set price. These details help build a clearer picture.</p><SectionActionButton href="/free-quote" label="Value my car as it is" intent="valuation" /></header><ol class="value-ledger">{factors.map(([heading, copy], index) => <li><span>0{index + 1}</span><div><h3>{heading}</h3><p>{copy}</p></div></li>)}</ol></div></section>

    <section class="section mobility-section" aria-labelledby="mobility-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">Describe its known mobility</p><h2 id="mobility-title">Running or <span>non-running?</span></h2><p>Both can be submitted for a valuation. A running engine does not establish roadworthiness or rule out hidden water damage.</p></header><div class="mobility-pair"><article><i class="ph ph-engine" aria-hidden="true"></i><div><h3>If it is running</h3><p>Share its current known behaviour, warnings and any existing assessment. Do not start or drive it just to check for this request.</p></div></article><article><i class="ph ph-truck" aria-hidden="true"></i><div><h3>If it is not running</h3><p>Explain whether it is known to roll and steer, and mention locked wheels, missing keys or access restrictions.</p><SectionActionButton href="/sell-non-running-car/" label="Non-running car guidance" intent="valuation" icon="ph-engine" /></div></article></div>
      <div class="collection-grid"><figure class="photo-visual collection-photo"><span class="photo-visual__graphic" aria-hidden="true"></span><img src="/sections/flood-damaged-car-collection.webp" alt="Recovery operator preparing a mud-marked older flood-damaged sedan for flatbed collection in a UAE industrial yard" width="1200" height="900" loading="lazy" decoding="async" /><figcaption><i class="ph ph-truck" aria-hidden="true"></i>Share the car’s mobility and parking access before arranging collection.</figcaption></figure><div class="access-copy"><p class="eyebrow">Plan the practical details</p><h2>Collection starts <span>with access.</span></h2><p class="lead">Share the exact parking position so the team can discuss whether and how collection can be arranged.</p><ul class="access-list"><li><i class="ph ph-map-pin" aria-hidden="true"></i><span><b>Location</b>Emirate, area and where the car is parked.</span></li><li><i class="ph ph-buildings" aria-hidden="true"></i><span><b>Space and clearance</b>Basement height, narrow entrances and loading space.</span></li><li><i class="ph ph-key" aria-hidden="true"></i><span><b>Keys and mobility</b>Available keys, known steering or wheel restrictions.</span></li></ul><SectionActionButton href="/car-removal/" label="Read about car removal" intent="valuation" icon="ph-truck" /></div></div>
    </div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">How valuation works</p><h2 id="process-title">From known details to <span>a next step</span></h2></header><ol class="process-list"><li><span>01</span><div><h3>Share your vehicle</h3><p>Choose the make, model and year, then provide your contact details.</p></div></li><li><span>02</span><div><h3>Explain the exposure</h3><p>Describe the current condition, known symptoms and any available reports.</p></div></li><li><span>03</span><div><h3>Review the valuation</h3><p>The team considers the details and may ask for photographs or clarification.</p></div></li><li><span>04</span><div><h3>Discuss arrangements</h3><p>If a sale is appropriate, agree the practical details and collection access.</p></div></li></ol></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">UAE coverage</p><h2 id="coverage-title">Tell us where <span>your car is.</span></h2><p>Request a valuation across the UAE. Collection arrangements depend on condition, exact location and access.</p></header><LocationCoverageList /></div></section>

    <section class="section guides-section" aria-labelledby="guides-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">Relevant guides</p><h2 id="guides-title">More context for <span>your next move</span></h2></header><nav class="related-links" aria-label="Related vehicle guides"><SectionActionButton href="/sell-damaged-car/" label="Damaged cars" intent="valuation" icon="ph-car-profile" /><SectionActionButton href="/sell-car-with-engine-problems/" label="Engine problems" intent="valuation" icon="ph-engine" /><SectionActionButton href="/sell-car-with-gearbox-problems/" label="Gearbox problems" intent="valuation" icon="ph-gear-six" /></nav>{helpfulPosts.length > 0 && <div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div>}<div class="guides-action"><SectionActionButton href="/blogs" label="Browse all guides" intent="blogs" icon="ph-newspaper-clipping" /></div></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">Your questions</p><h2 id="faq-title">Flood-damaged car <span>FAQs</span></h2></header><div class="faq-stack">{faqs.map(([question, answer]) => <details><summary>{question}<i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>

    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-grid"><div><p class="eyebrow">Start with the car as it is</p><h2 id="final-title">Water damage.<br /><span>A clearer next step.</span></h2><p>Share the vehicle details and what you know about its condition. Request a free valuation before deciding what comes next.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main>
  <ServicePageMotion />
</BaseLayout>

<style>
  .flood-page{color:#173a25;overflow:hidden;background:#fff}.flood-page :is(h1,h2,h3,p,figure){margin:0}.flood-page :is(h1,h2){letter-spacing:-.055em}.flood-page h2{font-size:clamp(2rem,3.8vw,3.45rem);line-height:1.06}.flood-page h2 span,.flood-page h1 span{color:#378344}.flood-page h3{font-size:19px;line-height:1.25;letter-spacing:-.025em}.eyebrow{display:flex;align-items:center;gap:8px;color:#367c45;font-size:11px;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.eyebrow i{font-size:20px}.breadcrumb{display:flex;flex-wrap:wrap;gap:8px;color:#657568;font-size:12px}.breadcrumb a{color:#3d6349;text-decoration:none}.flood-hero{position:relative;padding:22px 0 0;background:radial-gradient(ellipse at 5% 15%,#dcefdc80,transparent 55%),linear-gradient(135deg,#f5faf4,#edf5f1)}.flood-hero::before{position:absolute;inset:0;background:repeating-radial-gradient(ellipse at 0% 100%,transparent 0 66px,#a9caae26 67px 68px,transparent 69px 130px);content:'';pointer-events:none}.hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);gap:clamp(32px,6vw,84px);align-items:center;padding:42px 0 40px}.hero-copy h1{margin-top:18px;font-size:clamp(3.1rem,5.3vw,5.2rem);line-height:.99;max-width:11ch}.hero-lead{margin-top:23px!important;max-width:560px;color:#536c5b;font-size:18px;line-height:1.7}.hero-points{display:grid;gap:11px;list-style:none;padding:0;margin:25px 0 0}.hero-points li{display:flex;align-items:center;gap:9px;font-size:14px;font-weight:750}.hero-points i{font-size:20px;color:#378344}.hero-form{min-width:0;filter:drop-shadow(0 18px 26px #25442a12)}.hero-footnote{position:relative;display:flex;gap:12px;align-items:center;border-top:1px solid #bcd3c1;padding:18px 0;color:#536c5b;font-size:13px;line-height:1.55}.hero-footnote>i{font-size:22px;color:#378344}.section{padding:clamp(60px,7vw,100px) 0}.section-heading{max-width:760px;margin:0 auto 36px;text-align:center}.section-heading .eyebrow{justify-content:center}.section-heading h2{margin-top:12px}.section-heading>p:last-child:not(.eyebrow){max-width:660px;margin:16px auto 0;line-height:1.7;color:#607064}.lead{margin-top:18px!important;color:#607064;line-height:1.7}.affected-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);align-items:center;gap:clamp(32px,6vw,82px)}.affected-copy h2,.access-copy h2,.value-grid h2{margin-top:12px}.area-list{margin:22px 0}.area-list article{display:grid;grid-template-columns:36px 1fr;gap:12px;padding:14px 0;border-top:1px solid #dce7dc}.area-list article>i{color:#378344;font-size:24px;padding-top:2px}.area-list h3{font-size:17px}.area-list p,.value-ledger p{margin-top:5px;color:#607064;font-size:14px;line-height:1.6}.text-link{display:inline-flex;gap:12px;align-items:center;color:#2b7040;text-decoration:none;font-size:14px;font-weight:800;line-height:1.5}.text-link:hover{text-decoration:underline}.photo-visual{position:relative;isolation:isolate;min-width:0;padding:10px;border:1px solid #d0e0ce;border-radius:28px;background:#fff;box-shadow:0 24px 55px #234c2f14}.photo-visual::before{content:'';position:absolute;z-index:-2;inset:-30px 35px 35px -25px;border:1px solid #c9dec8;border-radius:40% 60% 50% 30%;background:#eef7eb}.photo-visual::after{content:'';position:absolute;z-index:-1;bottom:-26px;right:-20px;width:125px;height:125px;background-image:radial-gradient(#8ab88e77 1.5px,transparent 1.5px);background-size:12px 12px}.photo-visual__graphic{position:absolute;z-index:-1;top:-55px;right:-35px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,#b6d9ac88,transparent 70%)}.photo-visual img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:19px}.photo-visual figcaption{display:flex;align-items:flex-start;gap:9px;padding:14px 8px 5px;color:#526c57;font-size:12px;line-height:1.6}.photo-visual figcaption i{flex-shrink:0;color:#378344;font-size:21px}.signs-section{background:#f3f7f2}.signs-grid{display:grid;grid-template-columns: