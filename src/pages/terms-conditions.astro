  description="Terms and conditions for using Scrap My Car UAE and the ScrapMyCarUAE.com website."
  canonical="https://www.scrapmycaruae.com/terms-conditions"
>
  <main>
    <section class="inner-hero">
      <div class="smc-container inner-hero-grid">
        <div>
          <div class="smc-kicker">Legal</div>
          <h1>Terms & Conditions</h1>
          <p>
            These terms govern use of ScrapMyCarUAE.com and the services provided by Scrap My Car UAE.
