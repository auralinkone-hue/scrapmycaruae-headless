---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import { getVehicleData } from '../lib/vehicle-data';
import { getRelevantPosts } from '../lib/related-posts';
import { priorityCoverageLocations } from '../lib/locations';

const title = 'Car Removal UAE | Vehicle Collection for Unwanted & Non-Running Cars';
const description = 'Arrange car removal in the UAE for unwanted, damaged and non-running vehicles. Share the vehicle condition, location and access details to discuss collection.';

const collectionChecks = [
  ['ph-engine', 'Does it start?', 'Tell us if the engine starts, or share the known no-start issue.'],
  ['ph-tire', 'Does it roll?', 'Mention flat tyres, locked wheels or anything stopping the car from moving.'],
  ['ph-key', 'Are the keys available?', 'Let us know whether you have the keys and can unlock the vehicle.'],
  ['ph-buildings', 'Underground or tight parking?', 'Share the parking level, height restrictions and any narrow turns.'],
  ['ph-truck', 'Can a recovery vehicle reach it?', 'Describe the entrance, nearby space and anything blocking access.']
];
const collectionFactors = [
  ['ph-warning-circle', 'Vehicle condition', 'Damage changes the collection discussion.', 'Describe accident damage, missing parts, visible leaks or long-term parked condition. Recent photos can help explain the situation without needing a full diagnosis.'],
  ['ph-tire', 'Mobility', 'Starting and moving are different questions.', 'Tell us whether the car starts, rolls, steers and selects gears. Mention locked wheels or flat tyres so the practical handling needs can be reviewed.'],
  ['ph-buildings', 'Parking / access', 'The route to the vehicle matters.', 'Include the parking level, entrance height, tight turns, barriers and space around the car. Underground or restricted access needs discussion before any collection is arranged.'],
  ['ph-map-pin', 'Location / emirate', 'A clear location gives the request context.', 'Share the emirate, area and exact vehicle location. Tell us whether the car is at a home, workshop, building car park or another site, and whether access needs coordination.'],
  ['ph-file-text', 'Keys / documents', 'Have the available vehicle details ready.', 'Confirm whether keys and registration details are available. Mention any known ownership, finance or vehicle-status questions so the next steps can be clarified for the intended route.']
];
const steps = [
  ['ph-car-profile', 'Vehicle details', 'Start with the make, model and year, then explain its current condition.'],
  ['ph-path', 'Access review', 'Share the location, parking access, keys and whether the car can move.'],
  ['ph-truck', 'Collection arrangement', 'Discuss feasibility and agree the practical arrangements before collection.'],
  ['ph-signpost', 'Next route', 'Confirm the agreed sale, salvage or scrap route and any remaining steps.']
];
const vehicleConditions = ['Accident damage', 'Engine failure', 'Gearbox failure', 'Long-term parked cars', 'End-of-life vehicles'];
const preparation = [
  ['ph-map-pin', 'Exact location', 'Emirate, area and a clear location pin for the parked vehicle.'],
  ['ph-key', 'Available keys', 'Whether keys are available and the car can be unlocked.'],
  ['ph-car-profile', 'Vehicle condition', 'Known damage, faults, missing parts and whether it starts or rolls.'],
  ['ph-identification-card', 'Registration details', 'The available vehicle identity and registration information.'],
  ['ph-buildings', 'Parking & access', 'Parking level, entry restrictions and who can provide site access.']
];
const faqs = [
  ['Can a non-running car be collected?', 'Collection can be discussed for a non-running vehicle. Explain whether it starts, rolls or steers, and share the exact location and access details so feasibility can be reviewed.'],
  ['Can you collect an accident-damaged or end-of-life vehicle?', 'These vehicles can be considered for collection discussion. Share the current damage, missing parts and mobility, plus photos if available, before arrangements are agreed.'],
  ['What if the car is in underground parking?', 'Tell us the parking level, entrance height, narrow turns and space around the car. Restricted access needs a practical review before collection can be confirmed.'],
  ['Can collection be discussed if I do not have the keys?', 'Mention missing keys at the start. Whether the vehicle can be accessed and moved needs to be reviewed with its location and current condition; collection is not automatically confirmed.'],
  ['Which UAE locations can I ask about?', 'You can ask about Dubai, Abu Dhabi, Sharjah, Ajman, Ras Al Khaimah, Fujairah, Umm Al Quwain and Al Ain. The exact location and access are reviewed with the request.'],
  ['Is this an emergency towing or roadside recovery service?', 'This page is for planned removal and collection of unwanted, damaged and non-running vehicles as part of discussing their next route. It does not offer emergency roadside assistance or guaranteed response times.'],
  ['What documents should I have ready?', 'Have available registration and vehicle identity details ready, and mention any known ownership, finance or status questions. Requirements can differ by emirate and the agreed transaction route.'],
  ['How much does car removal cost, and when can it happen?', 'There is no fixed collection price or guaranteed timing on this page. Vehicle condition, location and access need to be reviewed before any costs and collection arrangements are confirmed.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];
await Promise.all([
  (async () => { try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); } })(),
  (async () => { try { helpfulPosts = await getRelevantPosts({ _id: 'car-removal-guide', slug: 'car-removal' }, ['car removal', 'collection', 'recovery', 'non-running', 'damaged car', 'scrap', 'parked', 'paperwork']); } catch { helpfulPosts = []; } })()
]);

const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Scrap My Car', item: 'https://www.scrapmycaruae.com/scrap-my-car/' },
  { '@type': 'ListItem', position: 3, name: 'Car Removal', item: 'https://www.scrapmycaruae.com/car-removal/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/car-removal/" ogImage="/sections/scrap-car-pickup-dubai.webp">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <main class="removal-page">
    <section class="removal-hero" aria-labelledby="removal-title">
      <div class="smc-container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/scrap-my-car/">Scrap My Car</a><span aria-hidden="true">›</span><span aria-current="page">Car removal</span></nav>
        <div class="removal-hero__grid">
          <div class="removal-hero__copy">
            <p class="eyebrow"><i class="ph ph-truck" aria-hidden="true"></i> Vehicle collection, considered properly</p>
            <h1 id="removal-title">Car removal <span>across the UAE</span></h1>
            <p class="hero-lead">Need to move an unwanted, damaged or non-running vehicle? Share the vehicle details, condition and location to discuss the practical collection route.</p>
          </div>
          <div class="removal-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div>
          <ul class="hero-trust" aria-label="Collection request benefits">
            <li><i class="ph ph-check" aria-hidden="true"></i>Current-condition review</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>Access checked before arrangements</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>UAE collection discussion</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section collection-checks" aria-labelledby="checks-title">
      <div class="smc-container">
        <header class="section-heading"><p class="eyebrow">Start with what you know</p><h2 id="checks-title">Can your vehicle <span>be collected?</span></h2><p>A car that will not start may still be considered. These practical details help establish how it can be reached and moved.</p></header>
        <div class="collection-checks__layout">
          <figure class="collection-photo">
            <img src="/sections/scrap-car-pickup-dubai.webp" alt="A damaged car on a green recovery truck during a collection discussion in Dubai" width="1456" height="1088" loading="lazy" decoding="async" />
            <figcaption><i class="ph ph-truck" aria-hidden="true"></i><span>Collection starts with the vehicle and its surroundings.</span></figcaption>
          </figure>
          <ul class="check-list">{collectionChecks.map(([icon, heading, copy]) => <li><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></li>)}</ul>
        </div>
        <p class="collection-note"><i class="ph ph-info" aria-hidden="true"></i><span>Planned removal for a vehicle you no longer want to keep. Collection feasibility is reviewed before arrangements are confirmed.</span></p>
      </div>
    </section>

    <section class="section access-section" aria-labelledby="factors-title">
      <div class="smc-container access-layout">
        <header class="section-heading section-heading--left"><p class="eyebrow">The details behind the move</p><h2 id="factors-title">What affects <span>vehicle collection?</span></h2><p>It is not only about where the car is. Condition, mobility and access all shape a practical collection plan.</p><a class="info-link" href="/scrap-car-value/">See what affects your car’s value <span aria-hidden="true">→</span></a></header>
        <div class="access-accordion">{collectionFactors.map(([icon, heading, lead, copy], index) => <details name="collection-factors" open={index === 0}><summary><span class="accordion-label"><i class:list={['ph', icon]} aria-hidden="true"></i>{heading}</span><i class="ph ph-plus accordion-toggle" aria-hidden="true"></i></summary><div class="accordion-content"><h3>{lead}</h3><p>{copy}</p></div></details>)}</div>
      </div>
    </section>

    <section class="section process-section" aria-labelledby="process-title">
      <div class="smc-container">
        <header class="section-heading"><p class="eyebrow">A clear path forward</p><h2 id="process-title">How car removal works</h2><p>From the first vehicle details to an agreed next step.</p></header>
        <ol class="process-list">{steps.map(([icon, heading, copy], index) => <li><div class="process-marker"><i class:list={['ph', icon]} aria-hidden="true"></i><span>{String(index + 1).padStart(2, '0')}</span></div><h3>{heading}</h3><p>{copy}</p></li>)}</ol>
      </div>
    </section>

    <section class="section condition-section" aria-labelledby="condition-title">
      <div class="smc-container condition-layout">
        <div class="condition-copy"><p class="eyebrow">Start with the car as it is</p><h2 id="condition-title">Non-running <span>and damaged cars</span></h2><p>You do not need a running vehicle to start the conversation. Explain the known issue and where the car is parked so collection can be considered in context.</p><ul class="condition-list">{vehicleConditions.map((condition) => <li><i class="ph ph-check" aria-hidden="true"></i>{condition}</li>)}</ul><p class="condition-context">The individual vehicle, its mobility and the available access determine what can be arranged.</p><div class="related-links"><a class="info-link" href="/sell-non-running-car/">Non-running car options <span aria-hidden="true">→</span></a><a class="info-link" href="/sell-damaged-car/">Damaged car options <span aria-hidden="true">→</span></a></div></div>
        <figure class="condition-photo"><img src="/sections/dubai-salvage-yard-inspection.webp" alt="Damaged vehicle on a recovery truck being reviewed at a salvage yard" width="1456" height="1088" loading="lazy" decoding="async" /><figcaption>Condition and collection are part of the same practical discussion.</figcaption></figure>
      </div>
    </section>

    <section class="section coverage-section" aria-labelledby="coverage-title">
      <div class="smc-container coverage-layout">
        <header><p class="eyebrow">Location is part of the plan</p><h2 id="coverage-title">Collection discussion <span>across the UAE</span></h2><p>Share the exact parked location. Availability and access are reviewed for your vehicle.</p></header>
        <div class="coverage-panel"><ul aria-label="UAE collection locations">{priorityCoverageLocations.map((location) => <li><i class="ph ph-map-pin" aria-hidden="true"></i>{location}</li>)}</ul><p><i class="ph ph-path" aria-hidden="true"></i>Include the area, parking level and entrance details with your request.</p></div>
      </div>
    </section>

    <section class="section preparation-section" aria-labelledby="preparation-title">
      <div class="smc-container preparation-layout">
        <header><p class="eyebrow">Before you get in touch</p><h2 id="preparation-title">A little preparation.<span>A clearer collection plan.</span></h2><p>Have these details ready for the conversation after your initial vehicle request. Share what you know; flag anything you are unsure about.</p><SectionActionButton href="/free-quote" label="Discuss my vehicle collection" intent="valuation" /></header>
        <ul class="preparation-list">{preparation.map(([icon, heading, copy]) => <li><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></li>)}</ul>
      </div>
    </section>

    <section class="section guides-section" aria-labelledby="guides-title">
      <div class="smc-container"><header class="section-heading"><p class="eyebrow">Before your next step</p><h2 id="guides-title">Useful guides for <span>vehicle owners</span></h2><p>Explore collection, non-running vehicle and scrap-car topics before deciding what to do next.</p></header>
        {helpfulPosts.length > 0 ? <div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div> : <p class="guides-fallback">Visit our blog for vehicle selling and scrap-car guides.</p>}
        <div class="section-cta"><SectionActionButton href="/blogs" label="View all blogs" intent="blogs" /></div>
      </div>
    </section>

    <section class="section faq-section" aria-labelledby="faq-title">
      <div class="smc-container"><header class="section-heading"><h2 id="faq-title">Car removal <span>FAQs</span></h2><p>Practical answers before you request a collection discussion.</p></header><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus accordion-toggle" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div>
    </section>

    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-cta__layout"><div><p class="eyebrow">Your vehicle. A practical next step.</p><h2 id="final-title">Request vehicle collection</h2><p>Start with the vehicle details, then discuss its condition, location and access with the team.</p></div><div class="final-cta__actions"><SectionActionButton href="/free-quote" label="Request vehicle collection" intent="valuation" /><a href="/scrap-my-car/">Explore the scrap-car process <span aria-hidden="true">→</span></a></div></div></section>
  </main>
</BaseLayout>

<style>
  .removal-page{color:#17331d;background:#fff}
  .removal-page :is(h1,h2,h3,p,li){overflow-wrap:break-word}
  .breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;color:#637365;font-size:13px}
  .breadcrumb a{color:#315d37;text-decoration:none}
  .removal-hero{padding:22px 0 clamp(54px,6.5vw,92px);background:radial-gradient(ellipse at 12% 36%,rgba(91,162,74,.13),transparent 45%),linear-gradient(145deg,#fcfdfb,#edf6eb 65%,#f5fafb);border-bottom:1px solid #dce8d8}
  .removal-hero__grid{display:grid;grid-template-areas:'copy form' 'trust form';grid-template-columns:minmax(0,1.08fr) minmax(450px,.8fr);gap:24px clamp(34px,6vw,84px);margin-top:32px}
  .removal-hero__copy{grid-area:copy;align-self:end;max-width:650px}
  .eyebrow{display:flex;align-items:center;gap:7px;margin:0;color:#3c7b40;font-size:11px;font-weight:850;letter-spacing:.1em;text-transform:uppercase;line-height:1.5}
  .eyebrow i{font-size:18px}
  h1{margin:17px 0 0;font-size:clamp(3.1rem,5.4vw,5rem);line-height:.98;letter-spacing:-.065em}
  h1 span{display:block;color:#398b41}
  .hero-lead{max-width:560px;margin:22px 0 0;color:#526453;font-size:18px;line-height:1.65}
  .removal-hero__form{grid-area:form;min-width:0}
  .hero-trust{grid-area:trust;align-self:start;display:grid;gap:11px;margin:0;padding:0;list-style:none}
  .hero-trust li{display:flex;align-items:center;gap:9px;color:#315637;font-size:14px;font-weight:750}
  .hero-trust i,.condition-list i{display:grid;flex:0 0 21px;width:21px;height:21px;place-items:center;border-radius:50%;background:#2f7d37;color:#fff;font-size:12px}
  .section{padding:clamp(62px,7vw,98px) 0}
  h2{margin:13px 0 0;font-size:clamp(2.2rem,3.8vw,3.6rem);line-height:1.06;letter-spacing:-.055em}
  h2 span{color:#398b41}
  .section-heading{max-width:760px;margin:0 auto 35px;text-align:center}
  .section-heading .eyebrow{justify-content:center}
  .section-heading p:not(.eyebrow){margin:17px auto 0;color:#5c6b5d;line-height:1.7}
  .section-heading--left{margin:0;text-align:left}
  .section-heading--left .eyebrow{justify-content:flex-start}
  .collection-checks__layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(28px,5vw,64px);align-items:center}
  figure{margin:0;min-width:0}
  .collection-photo{position:relative;align-self:stretch;min-height:470px;border-radius:22px;overflow:hidden;background:#e9f0e6}
  .collection-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:48% center}
  .collection-photo figcaption{position:absolute;right:0;bottom:0;left:0;display:flex;gap:11px;align-items:center;padding:35px 24px 22px;background:linear-gradient(transparent,rgba(15,42,23,.92));color:#fff;font-size:13px;font-weight:750;line-height:1.5}
  .collection-photo figcaption i{flex:0 0 auto;font-size:24px}
  .check-list,.preparation-list{margin:0;padding:0;list-style:none}
  .check-list li,.preparation-list li{display:grid;grid-template-columns:40px minmax(0,1fr);gap:13px;padding:19px 0;border-bottom:1px solid #dce6d9}
  .check-list li:first-child{padding-top:0}
  .check-list li:last-child{border-bottom:0;padding-bottom:0}
  .check-list li>i,.preparation-list li>i{display:grid;width:38px;height:38px;place-items:center;border-radius:11px;background:#edf5e9;color:#31763c;font-size:20px}
  h3{margin:0;font-size:18px;line-height:1.3;letter-spacing:-.025em}
  .check-list p,.preparation-list p{margin:6px 0 0;color:#607062;font-size:14px;line-height:1.6}
  .collection-note{display:flex;gap:10px;align-items:flex-start;max-width:850px;margin:25px auto 0;color:#5a6c5b;font-size:13px;line-height:1.6;text-align:left}
  .collection-note i{flex:0 0 auto;color:#347a3b;font-size:19px}
  .access-section{background:#f4f8f1;border-block:1px solid #e4ece0}
  .access-layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(32px,7vw,100px);align-items:start}
  .info-link{display:inline-flex;align-items:center;gap:8px;color:#1769aa;font-size:14px;font-weight:750;text-decoration:none;line-height:1.5}
  .info-link:hover{color:#0c4b7d;text-decoration:underline}
  .section-heading--left .info-link{margin-top:23px}
  .access-accordion{border-top:1px solid #ceddca}
  .access-accordion details{border-bottom:1px solid #ceddca}
  summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:64px;padding:15px 0;list-style:none;cursor:pointer;font-weight:750;line-height:1.45}
  summary::-webkit-details-marker{display:none}
  .accordion-label{display:flex;align-items:center;gap:12px;font-size:16px}
  .accordion-label>i{display:grid;flex:0 0 34px;width:34px;height:34px;place-items:center;border-radius:9px;background:#e1eddb;color:#2d7337;font-size:19px}
  .accordion-toggle{display:grid;flex:0 0 27px;width:27px;height:27px;place-items:center;border:1px solid #cbdcc6;border-radius:50%;color:#347a3b;transition:transform .18s ease}
  details[open]>summary .accordion-toggle{transform:rotate(45deg)}
  .accordion-content{padding:0 16px 22px 46px}
  .accordion-content h3{font-size:15px;color:#2c5832}
  .accordion-content p{margin:9px 0 0;color:#5b6b5d;font-size:14px;line-height:1.7}
  a:focus-visible,summary:focus-visible{outline:3px solid #6c9fc1;outline-offset:4px;border-radius:5px}
  .process-section{background:#173f22;color:#fff}
  .process-section .eyebrow{color:#bce3ae}
  .process-section .section-heading p:not(.eyebrow){color:#c8dcc6}
  .process-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px;margin:42px 0 0;padding:0;list-style:none}
  .process-list li{position:relative;min-width:0}
  .process-marker{position:relative;display:flex;align-items:center;gap:12px;margin-bottom:22px}
  .process-marker>i{display:grid;width:51px;height:51px;place-items:center;border:1px solid #5b8057;border-radius:14px;background:#254e2d;color:#c0e6b1;font-size:24px}
  .process-marker span{font-size:12px;letter-spacing:.08em;font-weight:800;color:#a6c49e}
  .process-list li:not(:last-child) .process-marker::after{height:1px;flex:1;background:#56754e;content:''}
  .process-list h3{font-size:20px}
  .process-list p{max-width:29ch;margin:11px 0 0;color:#c7d9c3;font-size:14px;line-height:1.7}
  .condition-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(30px,6vw,80px);align-items:center}
  .condition-copy>p:not(.eyebrow){margin:19px 0 0;color:#5c6b5d;line-height:1.7}
  .condition-list{display:grid;gap:11px;margin:23px 0 0;padding:0;list-style:none}
  .condition-list li{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:750}
  .condition-copy .condition-context{font-size:14px}
  .related-links{display:grid;gap:10px;margin-top:23px}
  .condition-photo{overflow:hidden;border-radius:22px;background:#edf3e8}
  .condition-photo img{display:block;width:100%;height:auto;aspect-ratio:1.12;object-fit:cover}
  .condition-photo figcaption{padding:17px 21px;color:#3d6242;font-size:12px;line-height:1.5}
  .coverage-section{padding-block:clamp(40px,5vw,65px);background:#f5f9fb;border-block:1px solid #dce7ec}
  .coverage-layout{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(30px,6vw,80px);align-items:center}
  .coverage-layout h2{font-size:clamp(1.95rem,3.2vw,2.8rem)}
  .coverage-layout header>p:not(.eyebrow){margin:16px 0 0;color:#5c6b65;line-height:1.65}
  .coverage-panel ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 18px;margin:0;padding:0;list-style:none}
  .coverage-panel li{display:flex;align-items:center;gap:9px;color:#31573b;font-size:14px;font-weight:750}
  .coverage-panel li i{color:#3a8245;font-size:18px}
  .coverage-panel>p{display:flex;gap:10px;margin:22px 0 0;padding-top:17px;border-top:1px solid #d4e1e6;color:#597064;font-size:13px;line-height:1.6}
  .coverage-panel>p i{color:#347a3b;font-size:20px}
  .preparation-layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(32px,7vw,95px)}
  .preparation-layout h2 span{display:block}
  .preparation-layout header>p:not(.eyebrow){margin:18px 0 24px;color:#5c6b5d;line-height:1.7}
  .preparation-list{border-top:1px solid #dce6d9}
  .preparation-list li{padding-block:17px}
  .guides-section{background:#f4f8f1}
  .guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .guides-fallback{text-align:center;color:#5c6b5d}
  .section-cta{display:flex;justify-content:center;margin-top:27px}
