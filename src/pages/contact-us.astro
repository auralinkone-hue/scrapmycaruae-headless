---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionActionButton from '../components/SectionActionButton.astro';

const whatsappUrl = 'https://api.whatsapp.com/send?phone=%2B971557458322';
---

<BaseLayout title="Contact Us | Scrap My Car UAE" description="Contact Scrap My Car UAE for help with vehicle valuations, selling a scrap car, collection and the vehicle handover process." canonical="/contact-us">
  <main class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="smc-container contact-hero-grid">
        <div class="contact-hero-copy">
          <p class="contact-eyebrow"><span></span>Contact Scrap My Car UAE</p>
          <h1 id="contact-title">Let’s talk about <span class="heading-accent">your car.</span></h1>
          <p class="contact-intro">A question about your vehicle? Talk to our team about valuation, collection or the next step.</p>
          <div class="contact-actions">
            <a class="smc-button smc-button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><span>Chat on WhatsApp</span><span class="contact-button-icon"><img src="/whatsapp.svg" width="19" height="19" alt="" aria-hidden="true" /></span></a>
            <a class="smc-button smc-button-secondary" href="tel:+971557458322"><span>Call the team</span><span class="contact-button-icon"><i class="ph ph-phone-call" aria-hidden="true"></i></span></a>
          </div>
          <p class="contact-hero-note"><i class="ph ph-car-profile" aria-hidden="true"></i>Running, damaged or no longer needed. Start with your car.</p>
        </div>
        <div class="contact-visual">
          <svg class="contact-orbit" viewBox="0 0 600 440" fill="none" aria-hidden="true"><path d="M42 320V90Q42 32 100 32H450Q558 32 558 140V350Q558 408 500 408H170" stroke="currentColor"/><path class="contact-trace" d="M42 320V90Q42 32 100 32H230" stroke="currentColor" stroke-width="2"/><circle cx="42" cy="320" r="5" fill="currentColor"/><circle cx="170" cy="408" r="5" fill="currentColor"/></svg>
          <figure class="contact-photo">
            <img src="/sections/ford-fusion-valuation-960.webp" srcset="/sections/ford-fusion-valuation-640.webp 640w, /sections/ford-fusion-valuation-960.webp 960w, /sections/ford-fusion-valuation.webp 1440w" sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1100px) 48vw, 540px" width="960" height="640" fetchpriority="high" alt="Used silver sedan with modest bumper wear, suitable for an individual vehicle assessment" />
            <figcaption><span class="contact-caption-mark"></span>Your vehicle. An individual conversation.</figcaption>
          </figure>
          <div class="contact-visual-note"><span class="contact-note-icon"><i class="ph ph-chats-circle" aria-hidden="true"></i></span><span><strong>Make · Model · Year</strong><small>A helpful place to start.</small></span></div>
        </div>
      </div>
    </section>

    <section class="contact-details-section" aria-labelledby="contact-details-title">
      <div class="smc-container contact-details-layout" data-contact-reveal>
        <header class="contact-section-heading"><p class="contact-eyebrow">Get in touch</p><h2 id="contact-details-title">A direct line.<br />A real conversation.</h2><p>Choose the way you prefer to contact us. Have your vehicle details ready so we can understand your request.</p><a class="contact-text-link" href="/cars/">Find guidance for your make <i class="ph ph-car-profile" aria-hidden="true"></i></a></header>
        <div class="contact-methods">
          <a class="contact-method" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><span class="contact-method-icon"><img src="/whatsapp.svg" width="20" height="20" alt="" aria-hidden="true" /></span><span class="contact-method-copy"><small>WhatsApp · Start here</small><strong>+971 55 745 8322</strong></span><i class="ph ph-arrow-up-right contact-row-arrow" aria-hidden="true"></i></a>
          <a class="contact-method" href="tel:+971557458322"><span class="contact-method-icon"><i class="ph ph-phone-call" aria-hidden="true"></i></span><span class="contact-method-copy"><small>Speak to the team</small><strong>055 745 83 22</strong></span><i class="ph ph-arrow-up-right contact-row-arrow" aria-hidden="true"></i></a>
          <a class="contact-method" href="mailto:info@scrapmycaruae.com"><span class="contact-method-icon"><i class="ph ph-envelope-simple" aria-hidden="true"></i></span><span class="contact-method-copy"><small>Email</small><strong>info@scrapmycaruae.com</strong></span><i class="ph ph-arrow-up-right contact-row-arrow" aria-hidden="true"></i></a>
          <div class="contact-method contact-method--static"><span class="contact-method-icon"><i class="ph ph-map-pin" aria-hidden="true"></i></span><span class="contact-method-copy"><small>Location</small><strong>Al Sajaa Industrial Area,<br />Sajaa, Sharjah</strong></span></div>
        </div>
      </div>
    </section>

    <section class="contact-support-section" aria-labelledby="contact-support-title">
      <div class="smc-container">
        <div class="contact-support-layout" data-contact-reveal>
          <div class="contact-support-intro"><p class="contact-eyebrow">Vehicle support</p><h2 id="contact-support-title">A little detail.<br />A clearer next step.</h2><p>These are useful details to share when you get in touch. Open a topic before your conversation.</p>
            <svg class="contact-car-drawing" viewBox="0 0 420 135" fill="none" aria-hidden="true"><path d="M20 106H400" stroke="currentColor" opacity=".25"/><path d="M42 87V72Q44 61 67 58L106 52 144 25Q154 18 172 18H245Q258 18 270 29L301 55 350 63Q370 67 374 80V94H344M96 94H288M42 94H48M112 52H285M179 24 170 51M239 24 259 51M178 65H192M259 65H273" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="73" cy="91" r="23" stroke="currentColor" stroke-width="2"/><circle cx="73" cy="91" r="11" stroke="currentColor" opacity=".5"/><circle cx="316" cy="91" r="23" stroke="currentColor" stroke-width="2"/><circle cx="316" cy="91" r="11" stroke="currentColor" opacity=".5"/><path d="M342 42H384M363 30H392" stroke="currentColor" opacity=".4" stroke-linecap="round"/></svg>
          </div>
          <div class="contact-topics">
            <details open><summary><span class="contact-topic-number">01</span><h3>Valuation & vehicle condition</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><div class="contact-topic-body"><p>Share the make, model and year, followed by any known faults or damage. Existing photos or workshop findings can help explain your vehicle’s condition.</p><a href="/scrap-car-value/">What affects scrap-car value <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div></details>
            <details><summary><span class="contact-topic-number">02</span><h3>Collection & parking access</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><div class="contact-topic-body"><p>Tell us where the vehicle is parked, whether it can roll or steer, and about any gates, basement height limits or site permissions. Confirm collection coverage with the team.</p><a href="/car-removal/">Read collection guidance <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div></details>
            <details><summary><span class="contact-topic-number">03</span><h3>Paperwork & vehicle handover</h3><i class="ph ph-plus" aria-hidden="true"></i></summary><div class="contact-topic-body"><p>Raise any registration, ownership or finance-related questions before handover. The team can discuss what needs to be clarified for your circumstances.</p><a href="/faqs/">Browse common questions <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div></details>
          </div>
        </div>
        <div class="contact-online" data-contact-reveal><div><span class="contact-online-icon"><i class="ph ph-calculator" aria-hidden="true"></i></span><span><h3>Ready to share your vehicle details?</h3><p>Use the free valuation form to start your enquiry.</p></span></div><SectionActionButton href="/free-quote" label="Start with my car details" intent="valuation" /></div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const initialiseContactMotion = () => {
    const page = document.querySelector<HTMLElement>('.contact-page');
    if (!page || page.dataset.contactReady) return;
    page.dataset.contactReady = 'true';
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    if (motion.matches || !('IntersectionObserver' in window)) return;
    const targets = page.querySelectorAll<HTMLElement>('[data-contact-reveal]');
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.remove('contact-reveal-pending');
        observer.unobserve(entry.target);
      });
    }, { threshold: .06 });
    targets.forEach(target => {
      if (target.getBoundingClientRect().top < innerHeight) return;
      target.classList.add('contact-reveal-pending');
      observer.observe(target);
    });
    const showAll = () => { if (motion.matches) { observer.disconnect(); targets.forEach(target => target.classList.remove('contact-reveal-pending')); } };
    motion.addEventListener('change', showAll);
    document.addEventListener('astro:before-swap', () => { observer.disconnect(); motion.removeEventListener('change', showAll); }, { once: true });
  };
  initialiseContactMotion();
  document.addEventListener('astro:page-load', initialiseContactMotion);
</script>

<style>
  .contact-page { color: #19251d; }
  .contact-page :is(h1,h2,h3,p,figure) { margin: 0; }
  .contact-eyebrow { display: flex; align-items: center; gap: 8px; color: #4c6c50; font-size: 11px; line-height: 1.5; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .contact-eyebrow>span { width: 6px; height: 6px; border-radius: 50%; background: #3b7941; }
  .contact-hero { padding: 68px 0 66px; background: #f6f8f3; border-bottom: 1px solid #e3e9de; }
  .contact-hero-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 62px; align-items: center; }
  .contact-hero-copy { animation: contact-entrance 450ms ease both; }
  .contact-hero h1 { margin: 17px 0 20px; font-size: clamp(40px,4.3vw,62px); line-height: 1.06; letter-spacing: -.055em; font-weight: 600; }
  .heading-accent { display: block; color: var(--smc-green); }
  .contact-intro { max-width: 430px; color: #5c685e; font-size: 16px; line-height: 1.75; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .contact-actions .smc-button { min-height: 50px; padding: 0 8px 0 18px; gap: 12px; font-size: 13px; white-space: nowrap; }
  .contact-button-icon { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; flex: 0 0 32px; background: rgba(255,255,255,.15); }
  .smc-button-secondary .contact-button-icon { background: #e8efe4; color: #30643a; }
  .contact-button-icon i { font-size: 17px; }
  .contact-button-icon img { display: block; filter: brightness(0) invert(1); }
  .contact-page .contact-hero-note { display: flex; align-items: flex-start; gap: 8px; max-width: 400px; margin-top: 20px; color: #6e7b6b; font-size: 12px; line-height: 1.6; }
  .contact-hero-note i { font-size: 18px; margin-top: 1px; flex-shrink: 0; }
  .contact-visual { position: relative; min-width: 0; padding: 25px 0 24px 18px; animation: contact-entrance 550ms ease both; }
  .contact-orbit { position: absolute; width: calc(100% + 20px); height: calc(100% + 6px); inset: -3px auto auto -10px; color: #a8bea0; pointer-events: none; }
  .contact-trace { stroke-dasharray: 410; stroke-dashoffset: 410; animation: contact-trace 1.1s ease forwards; }
  .contact-photo { position: relative; z-index: 1; border: 1px solid #dce3d6; border-radius: 8px 36px 8px 8px; overflow: hidden; background: #fff; box-shadow: 0 14px 35px #243c2110; }
  .contact-photo>img { display: block; width: 100%; height: auto; aspect-ratio: 3/2; object-fit: contain; transition: transform 500ms ease; }
  .contact-photo figcaption { position: relative; display: flex; align-items: center; gap: 8px; min-height: 47px; padding: 12px 15px; background: #fff; color: #51654d; font-size: 14px; line-height: 1.5; }
  .contact-caption-mark { flex: 0 0 5px; width: 5px; height: 5px; background: #427c3a; border-radius: 50%; }
  .contact-visual-note { position: absolute; z-index: 2; left: -7px; top: 5px; display: flex; align-items: center; gap: 10px; padding: 12px 17px 12px 12px; background: #fff; border: 1px solid #dfe7da; border-radius: 12px; box-shadow: 0 8px 22px #233b2110; }
  .contact-note-icon { width: 35px; height: 35px; display: grid; place-items: center; border-radius: 10px; background: #eef4ea; color: #387a3b; font-size: 21px; }
  .contact-visual-note strong,.contact-visual-note small { display: block; }
  .contact-visual-note strong { font-size: 12px; font-weight: 700; }
  .contact-visual-note small { color: #71816b; font-size: 11px; margin-top: 3px; }
  .contact-details-section { padding: 56px 0; }
  .contact-details-layout { display: grid; grid-template-columns: .9fr 1.1fr; gap: 95px; align-items: start; }
  .contact-section-heading h2,.contact-support-intro h2 { margin-top: 12px; font-size: clamp(29px,3vw,39px); font-weight: 550; line-height: 1.13; letter-spacing: -.04em; }
  .contact-section-heading>p:not(.contact-eyebrow) { margin-top: 16px; max-width: 345px; color: #677266; font-size: 14px; line-height: 1.8; }
  .contact-text-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 20px; min-height: 44px; color: #2c6335; font-size: 12px; line-height: 1.5; font-weight: 650; text-decoration: none; }
  .contact-text-link i { font-size: 16px; flex-shrink: 0; }
  .contact-methods { border-top: 1px solid #dfe6db; }
  .contact-method { display: flex; align-items: center; gap: 15px; min-width: 0; min-height: 85px; padding: 17px 10px; border-bottom: 1px solid #e4e9e1; text-decoration: none; color: inherit; transition: background-color 180ms ease,padding 180ms ease; }
  .contact-method-icon { display: grid; place-items: center; width: 38px; height: 38px; flex: 0 0 38px; background: #f1f6ed; border-radius: 11px; color: #3d7140; font-size: 20px; }
  .contact-method-copy { min-width: 0; flex: 1; }
  .contact-method-copy small { display: block; margin-bottom: 4px; color: #74816d; font-size: 10px; font-weight: 650; text-transform: uppercase; letter-spacing: .075em; }
  .contact-method-copy strong { display: block; color: #27372a; font-size: 16px; line-height: 1.5; font-weight: 600; overflow-wrap: anywhere; }
  .contact-row-arrow { flex-shrink: 0; font-size: 17px; color: #7b9275; transition: transform 180ms ease; }
  .contact-support-section { padding: 51px 0 28px; background: #173e2a; color: #f5f8f3; }
  .contact-support-layout { display: grid; grid-template-columns: .9fr 1.1fr; gap: 95px; }
  .contact-support-intro .contact-eyebrow { color: #b3cda3; }
  .contact-support-intro>p:not(.contact-eyebrow) { margin-top: 17px; max-width: 350px; font-size: 13px; line-height: 1.8; color: #bdcdbd; }
  .contact-car-drawing { display: block; width: min(100%,350px); height: auto; margin-top: 27px; color: #abc99d; }
  .contact-topics { border-top: 1px solid #ffffff28; }
  .contact-topics details { border-bottom: 1px solid #ffffff28; }
  .contact-topics summary { display: flex; gap: 13px; align-items: center; min-height: 73px; padding: 15px 0; cursor: pointer; list-style: none; }
  .contact-topics summary::-webkit-details-marker { display: none; }
  .contact-topic-number { flex: 0 0 23px; color: #9bb68e; font-size: 10px; letter-spacing: .05em; }
  .contact-topics h3 { flex: 1; font-size: 15px; line-height: 1.5; font-weight: 600; }
  .contact-topics summary>i { font-size: 19px; color: #b9d2aa; transition: transform 180ms ease; }
  .contact-topics details[open] summary>i { transform: rotate(45deg); }
  .contact-topic-body { padding: 0 28px 23px 36px; }
  .contact-topic-body p { color: #c2d0be; font-size: 13px; line-height: 1.8; }
  .contact-topic-body a { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; margin-top: 7px; color: #e4f2dd; font-size: 12px; font-weight: 600; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .contact-online { display: flex; gap: 20px; justify-content: space-between; align-items: center; margin-top: 36px; padding: 24px 0 0; border-top: 1px solid #ffffff28; }
  .contact-online>div { display: flex; align-items: center; gap: 13px; }
  .contact-online-icon { display: grid; place-items: center; width: 42px; height: 42px; flex: 0 0 42px; border: 1px solid #72966a80; border-radius: 12px; color: #c3dfb4; font-size: 23px; }
  .contact-online h3 { font-size: 15px; font-weight: 600; line-height: 1.5; }
  .contact-online p { color: #aebfac; font-size: 12px; line-height: 1.6; margin-top: 3px; }
  .contact-online :global(.section-action) { box-shadow: none; border-color: #81a578; background: #e5f0dd; color: #214d2b; flex-shrink: 0; }
  .contact-online :global(.section-action i) { background: #c6deb4; }
  [data-contact-reveal] { transition: opacity 500ms ease,transform 500ms cubic-bezier(.2,.7,.2,1); }
  .contact-reveal-pending { opacity: 0; transform: translateY(15px); }
  .contact-page :is(a,summary):focus-visible { outline: 2px solid #589545; outline-offset: 4px; border-radius: 5px; }
  .contact-support-section :is(a,summary):focus-visible { outline-color: #c1dfad; }
  @media (hover:hover) and (pointer:fine) {
    a.contact-method:hover { background: #f6f9f3; padding-inline: 15px; }
    a.contact-method:hover .contact-row-arrow { transform: translate(2px,-2px); }
    .contact-text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
    .contact-photo:hover>img { transform: scale(1.015); }
  }
  @keyframes contact-entrance { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes contact-trace { to { stroke-dashoffset: 0; } }
  @media (max-width: 1100px) {
    .contact-hero-grid { gap: 30px; }
    .contact-details-layout,.contact-support-layout { gap: 50px; }
    .contact-hero h1 { font-size: 44px; }
    .contact-actions { gap: 9px; }
    .contact-actions .smc-button { font-size: 12px; gap: 8px; padding-left: 15px; }
  }
  @media (max-width: 760px) {
    .contact-hero { padding: 34px 0 27px; }
    .contact-hero-grid { grid-template-columns: 1fr; gap: 25px; }
    .contact-hero h1 { font-size: clamp(34px,8.6vw,45px); margin: 12px 0 15px; }
    .contact-intro { max-width: 400px; font-size: 14px; line-height: 1.7; }
    .contact-actions { margin-top: 21px; display: grid; grid-template-columns: 1.1fr 1fr; }
    .contact-actions .smc-button { justify-content: space-between; min-height: 48px; font-size: 11px; gap: 5px; padding-left: 12px; }
    .contact-button-icon { width: 28px; height: 28px; flex-basis: 28px; }
    .contact-button-icon img { width: 17px; height: 17px; }
    .contact-page .contact-hero-note { margin-top: 14px; max-width: 350px; font-size: 11px; }
    .contact-visual { padding: 21px 0 7px 7px; }
    .contact-visual-note { left: 0; top: 0; padding: 9px 12px 9px 9px; gap: 8px; }
    .contact-note-icon { width: 30px; height: 30px; font-size: 18px; }
    .contact-photo { border-radius: 6px 26px 6px 6px; }
    .contact-photo figcaption { padding: 11px 12px; min-height: 45px; font-size: 14px; }
    .contact-orbit { width: 100%; inset: -4px auto auto -3px; }
    .contact-details-section { padding: 34px 0; }
    .contact-details-layout,.contact-support-layout { grid-template-columns: 1fr; gap: 24px; }
    .contact-section-heading h2,.contact-support-intro h2 { font-size: 31px; margin-top: 9px; }
    .contact-section-heading>p:not(.contact-eyebrow) { margin-top: 12px; font-size: 13px; }
    .contact-text-link { margin-top: 9px; }
    .contact-method { min-height: 78px; padding-inline: 2px; gap: 12px; }
    .contact-method-copy strong { font-size: 15px; }
    .contact-support-section { padding: 34px 0 25px; }
    .contact-support-intro>p:not(.contact-eyebrow) { margin-top: 12px; }
    .contact-car-drawing { width: 250px; margin-top: 17px; }
    .contact-topics summary { min-height: 69px; gap: 10px; }
    .contact-topics h3 { font-size: 14px; }
    .contact-topic-body { padding-left: 33px; padding-right: 8px; }
    .contact-online { flex-direction: column; align-items: flex-start; margin-top: 26px; gap: 17px; }
    .contact-online :global(.section-action) { font-size: 12px; min-height: 48px; }
  }
  @media (max-width: 700px) { .contact-page>.contact-hero>.smc-container,.contact-details-section>.smc-container,.contact-support-section>.smc-container { width: calc(100% - 36px); } }
  @media (prefers-reduced-motion: reduce) {
    .contact-hero-copy,.contact-visual,.contact-trace { animation: none; }
    .contact-trace { stroke-dashoffset: 0; }
    .contact-page :is(a,img,i),[data-contact-reveal] { transition: none; }
    .contact-reveal-pending { opacity: 1; transform: none; }
    .contact-photo:hover>img { transform: none; }
  }
</style>
