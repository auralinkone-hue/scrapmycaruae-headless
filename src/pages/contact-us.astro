---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/inner-pages.css';

const whatsappUrl = 'https://api.whatsapp.com/send?phone=%2B971557458322';
---

<BaseLayout title="Contact Us | Scrap My Car UAE" description="Contact Scrap My Car UAE for help with vehicle valuations, selling a scrap car, collection and the vehicle handover process." canonical="/contact-us">
  <main class="contact-page">
    <section class="contact-hero">
      <div class="smc-container contact-hero-grid">
        <div class="contact-hero-copy"><div class="smc-kicker">Contact Scrap My Car UAE</div><h1>Need help <span class="heading-accent">selling your car?</span></h1><p>Speak with our team about your vehicle, valuation, collection or handover.</p></div>
        <aside class="contact-action-card" aria-label="Quick contact options"><span class="contact-action-card__eyebrow"><i class="ph ph-chats-circle" aria-hidden="true"></i> Need a quick answer?</span><p>Choose the way that works best for you and our team will help with your vehicle request.</p><div class="contact-action-card__actions"><a class="smc-button smc-button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />WhatsApp Us</a><a class="smc-button smc-button-secondary" href="tel:+971557458322"><i class="ph ph-phone-call" aria-hidden="true"></i>Call 055 745 83 22</a></div></aside>
      </div>
    </section>

    <section class="contact-details-section"><div class="smc-container"><div class="contact-section-heading"><div class="smc-kicker">Contact details</div><h2>Talk to the team directly.</h2></div><div class="contact-methods">
      <a class="contact-method" href="tel:+971557458322"><span class="contact-method__icon"><i class="ph ph-phone-call" aria-hidden="true"></i></span><span><small>Phone</small><strong>055 745 83 22</strong></span></a>
      <a class="contact-method" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><span class="contact-method__icon"><img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" /></span><span><small>WhatsApp</small><strong>+971 55 745 8322</strong></span></a>
      <a class="contact-method" href="mailto:info@scrapmycaruae.com"><span class="contact-method__icon"><i class="ph ph-envelope-simple" aria-hidden="true"></i></span><span><small>Email</small><strong>info@scrapmycaruae.com</strong></span></a>
      <div class="contact-method contact-method--static"><span class="contact-method__icon"><i class="ph ph-map-pin" aria-hidden="true"></i></span><span><small>Location</small><strong>Al Sajaa Industrial Area, Sajaa, Sharjah</strong></span></div>
    </div></div></section>

    <section class="contact-support-section"><div class="smc-container"><div class="contact-support-intro"><div class="smc-kicker">Vehicle support</div><h2>Get help with your vehicle valuation</h2><p>Whether your car is running, non-running or damaged, we can help you understand the next step.</p></div><div class="contact-support-grid">
      <article class="contact-support-card"><i class="ph ph-truck" aria-hidden="true"></i><h3>Free vehicle collection</h3><p>If you accept the offer, our team can arrange collection from supported locations across the UAE. Contact us to confirm coverage for your area.</p></article>
      <article class="contact-support-card"><i class="ph ph-file-text" aria-hidden="true"></i><h3>Paperwork questions</h3><p>Contact the team before handover if registration, ownership or finance-related circumstances need to be clarified.</p></article>
      <article class="contact-support-card contact-support-card--quote"><i class="ph ph-calculator" aria-hidden="true"></i><h3>Prefer to start online?</h3><p>Send your Make, Model and Year directly to our team using the free valuation form.</p><a class="smc-button smc-button-primary" href="/free-quote">Get Your Vehicle Price <i class="ph ph-arrow-right" aria-hidden="true"></i></a></article>
    </div></div></section>

    <section class="contact-final-cta"><div class="smc-container contact-final-cta__inner"><div><div class="smc-kicker">Quick contact</div><h2>Ready to <span class="heading-accent">talk about your car?</span></h2><p>WhatsApp is the quickest way to contact the team directly.</p></div><div class="contact-final-cta__actions"><a class="smc-button smc-button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />WhatsApp Us</a><a class="smc-button smc-button-secondary" href="tel:+971557458322"><i class="ph ph-phone-call" aria-hidden="true"></i>Call Now</a></div></div></section>
  </main>
</BaseLayout>

<style>
  .contact-page { overflow: hidden; color: #172219; }
  .contact-page .heading-accent { color: #3c8e2f; }
  .contact-hero { padding: clamp(58px, 7vw, 92px) 0 clamp(52px, 6vw, 78px); background: radial-gradient(circle at 84% 15%, rgba(93,185,56,.12), transparent 30%), linear-gradient(180deg,#fbfdf9 0%,#f4f8f2 100%); border-bottom: 1px solid #dce6d9; }
  .contact-hero-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(350px,.68fr); gap: clamp(42px,7vw,86px); align-items: center; }
  .contact-hero-copy h1 { max-width: 720px; margin: 12px 0 18px; font-size: clamp(3rem,5vw,4.6rem); line-height: 1; letter-spacing: -.05em; }
  .contact-hero-copy p { max-width: 620px; margin: 0; color: #5e695f; font-size: 18px; line-height: 1.65; }
  .contact-action-card { padding: 28px; border: 1px solid #dce6d9; border-radius: 20px; background: #fff; box-shadow: 0 20px 46px rgba(23,63,39,.09); }
  .contact-action-card__eyebrow { display: flex; align-items: center; gap: 8px; color: #173f27; font-size: 17px; font-weight: 850; letter-spacing: -.02em; }.contact-action-card__eyebrow .ph { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 50%; background: #eef6ea; color: #3c8e2f; }.contact-action-card p { margin: 12px 0 20px; color: #5e695f; font-size: 14px; line-height: 1.6; }.contact-action-card__actions,.contact-final-cta__actions { display: flex; gap: 10px; flex-wrap: wrap; }.contact-action-card .smc-button { min-height: 50px; }
  .contact-details-section,.contact-support-section { padding: clamp(54px,7vw,88px) 0; }.contact-section-heading,.contact-support-intro { max-width: 680px; margin-bottom: 28px; }.contact-section-heading h2,.contact-support-intro h2 { margin: 8px 0 0; font-size: clamp(30px,3.5vw,46px); letter-spacing: -.045em; line-height: 1.08; }.contact-support-intro p { margin: 12px 0 0; color: #5e695f; line-height: 1.7; }
  .contact-methods { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; }.contact-method { min-width: 0; display: flex; gap: 14px; align-items: center; padding: 20px; border: 1px solid #dce6d9; border-radius: 16px; background: #fff; color: inherit; text-decoration: none; transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease; }a.contact-method:hover { transform: translateY(-2px); border-color: #aeca9f; box-shadow: 0 10px 22px rgba(23,63,39,.08); }a.contact-method:focus-visible { outline: 3px solid rgba(93,185,56,.22); outline-offset: 3px; }.contact-method__icon { display: grid; flex: 0 0 auto; width: 38px; height: 38px; place-items: center; border-radius: 11px; background: #eef6ea; color: #3c8e2f; }.contact-method__icon .ph { font-size: 19px; }.contact-method__icon .wa-icon { width: 18px; height: 18px; }.contact-method small,.contact-method strong { display: block; }.contact-method small { margin: 1px 0 4px; color: #5e695f; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }.contact-method strong { overflow-wrap: anywhere; color: #173f27; font-size: 16px; line-height: 1.4; }
  .contact-support-section { background: #f6f9f4; }.contact-support-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }.contact-support-card { display: flex; flex-direction: column; align-items: flex-start; min-height: 268px; padding: 25px; border: 1px solid #dce6d9; border-radius: 18px; background: #fff; }.contact-support-card > .ph { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 13px; background: #eef6ea; color: #3c8e2f; font-size: 22px; }.contact-support-card h3 { margin: 18px 0 9px; color: #173f27; font-size: 20px; letter-spacing: -.025em; }.contact-support-card p { margin: 0; color: #5e695f; font-size: 14px; line-height: 1.7; }.contact-support-card--quote .smc-button { margin-top: auto; min-height: 48px; }
  .contact-final-cta { padding: clamp(48px,6vw,68px) 0; background: #173f27; color: #fff; }.contact-final-cta__inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; }.contact-final-cta h2 { margin: 8px 0 10px; max-width: 720px; font-size: clamp(30px,4vw,48px); line-height: 1.05; letter-spacing: -.045em; }.contact-final-cta p { margin: 0; color: #c7d5c5; }.contact-final-cta .smc-kicker { color: #b6e2aa; }.contact-final-cta .heading-accent { color: #a9df96; }.contact-final-cta .smc-button-primary { background: #fff; color: #173f27; }.contact-final-cta .smc-button-secondary { border-color: rgba(255,255,255,.32); background: transparent; color: #fff; }
  @media (max-width: 980px) { .contact-hero-grid { grid-template-columns: 1fr; gap: 30px; }.contact-action-card { max-width: 600px; }.contact-final-cta__inner { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 700px) { .contact-hero { padding: 38px 0 42px; }.contact-hero-copy h1 { font-size: clamp(2.4rem,10vw,3.1rem); }.contact-hero-copy p { font-size: 16px; line-height: 1.55; }.contact-action-card { padding: 20px; border-radius: 18px; }.contact-action-card__actions,.contact-action-card__actions .smc-button,.contact-final-cta__actions,.contact-final-cta__actions .smc-button { width: 100%; }.contact-action-card .smc-button,.contact-final-cta .smc-button { min-height: 48px; }.contact-details-section,.contact-support-section { padding: 48px 0; }.contact-methods,.contact-support-grid { grid-template-columns: 1fr; }.contact-method { padding: 16px; }.contact-support-card { min-height: auto; padding: 22px; }.contact-support-card--quote .smc-button { margin-top: 20px; width: 100%; }.contact-final-cta { padding: 46px 0; } }
  @media (prefers-reduced-motion: reduce) { .contact-method { transition: none; }a.contact-method:hover { transform: none; } }
</style>
