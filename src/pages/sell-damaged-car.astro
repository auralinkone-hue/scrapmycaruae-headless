---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import { getLatestPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';

const title = 'Sell Damaged Car UAE | Free Valuation & Vehicle Collection';
const description = 'Sell a damaged, accident-damaged or non-running car in the UAE. Request a free valuation and discuss collection with Scrap My Car UAE.';

const damageTypes = [
  ['ph-car-profile', 'Accident & body damage', 'Describe dents, panel damage, broken lights or other visible accident damage when you request a valuation.'],
  ['ph-engine', 'Mechanical damage', 'Engine, gearbox, electrical and cooling problems are useful details for the review.'],
  ['ph-power', 'Non-running vehicles', 'A damaged car does not need to start before you can send its make, model and year.'],
  ['ph-drop', 'Water or flood damage', 'Disclose any water exposure clearly so the vehicle can be considered on its actual condition.']
];

const valuationFactors = [
  ['ph-car-profile', 'Vehicle make, model & year', 'These details establish the vehicle and its likely demand.'],
  ['ph-warning-octagon', 'Damage severity', 'Visible body, accident and safety damage changes the review context.'],
  ['ph-wrench', 'Mechanical condition', 'Known engine, gearbox, electrical or running issues matter.'],
  ['ph-map-pin', 'Location & collection access', 'The vehicle location and practical collection access help plan the next step.']
];

const locations = ['Dubai', 'Abu Dhabi', 'Sharjah', 'Ajman', 'Ras Al Khaimah', 'Fujairah', 'Umm Al Quwain', 'Al Ain'];
const faqs = [
  ['Can I sell a damaged car in the UAE?', 'Yes. Send the make, model, year and a clear description of the damage for a free valuation. The team can then discuss the practical next step with you.'],
  ['Do I need to repair my damaged car before selling?', 'Not necessarily. Repair costs, the vehicle’s condition and current demand all matter. Request a valuation based on the car as it is before deciding whether repairs make sense.'],
  ['Can I get a valuation for an accident-damaged car?', 'Yes. Explain the accident or body damage accurately. The more clearly the condition is described, the better the team can assess the request.'],
  ['Can you consider a damaged car that will not start?', 'Yes. A non-running vehicle can still be submitted for valuation. Include the vehicle details and any known mechanical issue.'],
  ['Is vehicle collection available for damaged cars?', 'Collection is available across supported UAE locations, subject to the vehicle condition, location and practical access. The team confirms what is possible after reviewing the request.'],
  ['What paperwork might be needed?', 'Requirements depend on the vehicle and the final process. Keep the Mulkiya, Emirates ID and relevant authority or lender paperwork available, then confirm the current requirements before handover.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];

try {
  vehicleData = await getVehicleData();
} catch (error) {
  vehicleDataError = error instanceof Error ? error.message : String(error);
}

try {
  helpfulPosts = await getLatestPosts({});
} catch {
  helpfulPosts = [];
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
    { '@type': 'ListItem', position: 2, name: 'Sell Damaged Car', item: 'https://www.scrapmycaruae.com/sell-damaged-car/' }
  ]
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({
    '@type': 'Question',
    name,
    acceptedAnswer: { '@type': 'Answer', text }
  }))
};
---

<BaseLayout title={title} description={description} canonical="/sell-damaged-car/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <main class="damaged-page">
    <section class="damaged-hero" aria-labelledby="damaged-car-title">
      <div class="smc-container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">Sell Damaged Car</span></nav>
        <div class="damaged-hero__grid">
          <div class="damaged-hero__copy">
            <h1 id="damaged-car-title">Sell your damaged car.<span>Skip the repair hassle.</span></h1>
            <p>Start with the car as it is. Share its make, model and year for a free valuation, then discuss the damage and collection directly with the team.</p>
          </div>
          <div class="damaged-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div>
          <ul class="trust-points" aria-label="Damaged car valuation benefits"><li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li><li><i class="ph ph-check" aria-hidden="true"></i>Accident & mechanical damage considered</li><li><i class="ph ph-check" aria-hidden="true"></i>UAE-wide collection discussion</li></ul>
        </div>
      </div>
    </section>

    <section class="section damage-types" aria-labelledby="damage-types-title">
      <div class="smc-container">
        <div class="section-heading section-heading--centered"><h2 id="damage-types-title">Types of damage <span class="heading-accent">we consider.</span></h2><p>A clear description helps the team review the car on its current condition rather than on assumptions.</p></div>
        <div class="damage-types__layout">
          {damageTypes.map(([icon, heading, copy], index) => <article class:list={['damage-type', `damage-type--${index + 1}`]}><i class:list={['ph', icon]} aria-hidden="true"></i><h3>{heading}</h3><p>{copy}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section repair-decision" aria-labelledby="repair-title">
      <div class="smc-container repair-decision__grid">
        <div class="repair-decision__panel"><i class="ph ph-scales" aria-hidden="true"></i><p class="section-label">Repair decision</p><h2 id="repair-title">Should you repair it <span class="heading-accent">before selling?</span></h2><p>There is no one answer. If repair cost is high or the vehicle has several issues, requesting a valuation first can give you a more useful comparison.</p><a class="text-link" href="/free-quote">Request a free valuation <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
        <div class="repair-decision__steps"><div><span>01</span><h3>Understand the full condition</h3><p>Consider accident damage, hidden mechanical issues and how long the repair may take.</p></div><div><span>02</span><h3>Compare repair cost with value</h3><p>A quote can help you decide whether more spending on repairs is worthwhile.</p></div><div><span>03</span><h3>Choose the practical route</h3><p>Keep the car, repair it, or discuss selling it as it is with the team.</p></div></div>
      </div>
    </section>

    <section class="section valuation-section" aria-labelledby="factors-title"><div class="smc-container"><div class="section-heading section-heading--centered"><h2 id="factors-title">What affects a damaged <span class="heading-accent">car valuation?</span></h2><p>Every vehicle is reviewed individually. These details help give useful context; they are not a published pricing formula.</p></div><div class="valuation-list">{valuationFactors.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section section--dark process" aria-labelledby="process-title"><div class="smc-container"><div class="section-heading section-heading--centered section-heading--dark"><h2 id="process-title">A clear process for a damaged vehicle.</h2></div><ol class="process-grid"><li><span>01</span><h3>Send the vehicle details</h3><p>Choose the make, model and year, then add your contact details.</p></li><li><span>02</span><h3>Describe the damage</h3><p>Continue on WhatsApp with useful information about accident, body or mechanical damage.</p></li><li><span>03</span><h3>Discuss collection</h3><p>If you choose to proceed, the team can confirm the practical collection next step.</p></li></ol></div></section>

    <section class="section collection" aria-labelledby="collection-title"><div class="smc-container collection__grid"><div><h2 id="collection-title">Damaged vehicle collection <span class="heading-accent">across the UAE.</span></h2><p>Tell us where the vehicle is and whether it can move. Collection availability depends on the location, condition and practical access, so the team confirms what is possible after the review.</p><a class="text-link" href="/sell-my-car/">Explore the main selling process <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div><ul>{locations.map((location) => <li><i class="ph ph-map-pin" aria-hidden="true"></i>{location}</li>)}</ul></div></section>

    {helpfulPosts.length > 0 && <section class="section section--soft guides" aria-labelledby="guides-title"><div class="smc-container"><div class="section-heading section-heading--centered"><h2 id="guides-title">Helpful guides for <span class="heading-accent">damaged-car owners.</span></h2><p>Read relevant existing guides from the Scrap My Car UAE blog before deciding your next step.</p></div><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div><div class="guides__action"><SectionActionButton href="/blogs" label="View all blogs" /></div></div></section>}

    <section class="section damaged-faq" aria-labelledby="faq-title"><div class="smc-container"><div class="section-heading section-heading--centered"><h2 id="faq-title">Damaged-car FAQs</h2><p>Answers to common questions about valuing and selling a damaged vehicle in the UAE.</p></div><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><p class="faq-more">Need more help? <a href="/faqs">Browse all FAQs</a>.</p></div></section>

    <section class="final-valuation"><div class="smc-container final-valuation__inner"><div><p class="section-label">Free valuation</p><h2>Tell us about the damaged car.</h2><p>Start with the make, model and year. You can explain the damage when the conversation continues on WhatsApp.</p></div><a class="smc-button" href="/free-quote" data-analytics-quote-cta="sell_damaged_car_final">Get My Free Valuation <i class="ph ph-arrow-right" aria-hidden="true"></i></a></div></section>
  </main>
</BaseLayout>

<style>
  .damaged-page { overflow:hidden; color:#17331d; }.damaged-hero { padding:22px 0 clamp(56px,7vw,88px); border-bottom:1px solid #dce6d9; background:radial-gradient(circle at 85% 10%,rgba(198,137,43,.13),transparent 30%),radial-gradient(circle at 12% 92%,rgba(47,125,50,.1),transparent 28%),linear-gradient(180deg,#fcfdfb 0%,#f4f8f2 100%); }.breadcrumb { display:flex; align-items:center; gap:8px; color:#687268; font-size:13px; }.breadcrumb a { color:#315d37; text-decoration:none; }.breadcrumb a:hover { text-decoration:underline; }.damaged-hero__grid { display:grid; grid-template-areas:'copy form' 'trust form'; grid-template-columns:minmax(0,1fr) minmax(400px,.78fr); column-gap:clamp(44px,6vw,84px); row-gap:22px; align-items:start; margin-top:32px; }.damaged-hero__copy { grid-area:copy; max-width:670px; }.damaged-hero h1 { margin:0; font-size:clamp(3.8rem,5.6vw,5.8rem); line-height:.94; letter-spacing:-.055em; }.damaged-hero h1 span { display:block; color:#3c8e2f; }.damaged-hero__copy > p { max-width:620px; margin:28px 0 0; color:#5c685d; font-size:18px; line-height:1.6; }.damaged-hero__form { grid-area:form; filter:drop-shadow(0 16px 28px rgba(31,70,36,.07)); }.trust-points { grid-area:trust; display:grid; gap:10px; align-self:end; margin:0; padding:0; list-style:none; }.trust-points li { display:flex; align-items:center; gap:9px; color:#2a472f; font-size:14px; font-weight:650; }.trust-points i { display:grid; width:22px; height:22px; place-items:center; border-radius:50%; background:#e4f1df; color:#2f7d32; font-size:14px; }.section { padding:clamp(58px,5vw,74px) 0; }.section--soft { background:#f6f9f4; }.section--dark { background:#173d18; color:#fff; }.section-heading { max-width:760px; margin:0 auto 34px; text-align:center; }.section-heading h2,.repair-decision h2,.collection h2,.final-valuation h2 { margin:0; color:#17331d; font-size:clamp(2.1rem,4vw,3.3rem); line-height:1.06; letter-spacing:-.05em; }.section-heading > p,.collection p { max-width:680px; margin:17px auto 0; color:#5c685d; line-height:1.7; }.heading-accent { color:#3c8e2f; }.damage-types { background:#fff; }.damage-types__layout { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:14px; }.damage-type { min-height:184px; padding:25px; border:1px solid #dce6d9; border-radius:18px; background:#fff; }.damage-type--1 { grid-column:span 6; background:linear-gradient(135deg,#f7fbf5,#fff); }.damage-type--2,.damage-type--3 { grid-column:span 3; }.damage-type--4 { grid-column:span 6; }.damage-type i,.valuation-list i { display:grid; width:40px; height:40px; place-items:center; border-radius:12px; background:#e8f3e5; color:#32753a; font-size:20px; }.damage-type--2 i { background:#fbf1df; color:#a06d25; }.damage-type--3 i { background:#e2f0ed; color:#39776f; }.damage-type--4 i { background:#edf0f1; color:#52646b; }.damage-type h3 { margin:18px 0 7px; font-size:20px; letter-spacing:-.03em; }.damage-type p,.valuation-list p { margin:0; color:#647064; font-size:14px; line-height:1.65; }.repair-decision { background:#f6f9f4; }.repair-decision__grid { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:clamp(38px,7vw,88px); align-items:center; }.repair-decision__panel { padding:clamp(28px,4vw,46px); border-radius:22px; background:#fff; box-shadow:0 15px 35px rgba(20,53,29,.06); }.repair-decision__panel > i { display:grid; width:46px; height:46px; place-items:center; border-radius:14px; background:#e8f3e5; color:#32753a; font-size:23px; }.section-label { margin:22px 0 10px; color:#337238; font-size:11px; font-weight:800; letter-spacing:.095em; text-transform:uppercase; }.repair-decision__panel > p:not(.section-label) { margin:18px 0 23px; color:#5c685d; line-height:1.7; }.text-link { display:inline-flex; align-items:center; gap:7px; color:#2f7d32; font-size:14px; font-weight:750; text-decoration:none; }.text-link:hover { color:#184d2b; }.text-link .ph { transition:transform 160ms ease; }.text-link:hover .ph { transform:translateX(3px); }.repair-decision__steps { display:grid; gap:0; }.repair-decision__steps > div { display:grid; grid-template-columns:46px 1fr; column-gap:18px; padding:22px 0; border-top:1px solid #d6e2d4; }.repair-decision__steps > div:last-child { border-bottom:1px solid #d6e2d4; }.repair-decision__steps span,.process-grid span { color:#3c8e2f; font-size:12px; font-weight:850; letter-spacing:.11em; }.repair-decision__steps h3 { grid-column:2; margin:0; font-size:18px; letter-spacing:-.025em; }.repair-decision__steps p { grid-column:2; margin:7px 0 0; color:#5c685d; font-size:14px; line-height:1.65; }.valuation-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); max-width:980px; margin:auto; border-top:1px solid #dce6d9; }.valuation-list article { display:grid; grid-template-columns:42px 1fr; gap:14px; padding:25px 12px; border-bottom:1px solid #dce6d9; }.valuation-list article:nth-child(odd) { padding-left:0; border-right:1px solid #dce6d9; padding-right:28px; }.valuation-list article:nth-child(even) { padding-left:28px; }.valuation-list h3 { margin:0; font-size:18px; letter-spacing:-.025em; }.valuation-list p { margin-top:7px; }.section-heading--dark h2 { color:#fff; }.process-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin:0; padding:0; list-style:none; }.process-grid li { padding:25px 0 0; border-top:1px solid rgba(255,255,255,.22); }.process-grid h3 { margin:17px 0 9px; font-size:24px; letter-spacing:-.035em; }.process-grid p { margin:0; color:#c9d7c5; line-height:1.65; }.collection__grid { display:grid; grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr); gap:clamp(40px,8vw,100px); align-items:center; }.collection p { margin:20px 0 24px; }.collection ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin:0; padding:0; list-style:none; }.collection li { display:flex; align-items:center; gap:10px; min-height:60px; padding:15px; border:1px solid #dce6d9; border-radius:14px; background:#fff; color:#29442e; font-weight:650; }.collection li i { color:#3c8e2f; font-size:19px; }.guide-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }.guides__action { display:flex; justify-content:center; margin-top:28px; }.damaged-faq .section-heading { margin-bottom:28px; }.faq-stack { max-width:980px; margin:auto; }.faq-stack details { border-bottom:1px solid #dce6d9; }.faq-stack details:first-child { border-top:1px solid #dce6d9; }.faq-stack summary { display:flex; align-items:center; justify-content:space-between; gap:18px; min-height:76px; padding:18px 0; list-style:none; cursor:pointer; font-size:17px; font-weight:700; letter-spacing:-.02em; }.faq-stack summary::-webkit-details-marker { display:none; }.faq-stack summary i { display:grid; flex:0 0 auto; width:28px; height:28px; place-items:center; border:1px solid #d7e3d4; border-radius:50%; color:#286633; transition:transform 160ms ease; }.faq-stack details[open] summary i { transform:rotate(45deg); }.faq-stack details p { max-width:760px; margin:-3px 0 24px; color:#5c685d; line-height:1.7; }.faq-more { margin:22px 0 0; text-align:center; color:#5c685d; }.faq-more a { color:#2f7d32; font-weight:750; }.final-valuation { padding:70px 0; background:radial-gradient(circle at 78% 30%,rgba(117,203,82,.15),transparent 27%),#163d18; color:#fff; }.final-valuation__inner { display:flex; align-items:center; justify-content:space-between; gap:34px; }.final-valuation .section-label { color:#a9df96; }.final-valuation h2 { color:#fff; }.final-valuation p:not(.section-label) { max-width:750px; margin:13px 0 0; color:#c9d7c5; }.final-valuation .smc-button { flex:0 0 auto; min-height:50px; background:#fff; color:#174020; }
  @media (max-width:980px) { .damaged-hero__grid { grid-template-areas:'copy' 'form' 'trust'; grid-template-columns:1fr; }.damaged-hero__form { width:min(100%,650px); }.damage-type,.damage-type--1,.damage-type--2,.damage-type--3,.damage-type--4 { grid-column:span 6; }.repair-decision__grid,.collection__grid { grid-template-columns:1fr; }.valuation-list { grid-template-columns:1fr; }.valuation-list article:nth-child(odd),.valuation-list article:nth-child(even) { padding-inline:0; border-right:0; }.guide-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:700px) { .damaged-hero { padding-top:16px; }.damaged-hero__grid { gap:16px; margin-top:23px; }.damaged-hero__copy { text-align:center; }.damaged-hero h1 { font-size:clamp(2.65rem,12vw,3.6rem); line-height:.96; }.damaged-hero__copy > p { margin:14px auto 0; font-size:15px; line-height:1.5; }.trust-points { gap:9px; }.trust-points li { font-size:13px; }.section { padding:clamp(52px,14vw,60px) 0; }.section-heading { margin-bottom:26px; }.section-heading h2,.repair-decision h2,.collection h2,.final-valuation h2 { font-size:clamp(2rem,9vw,2.6rem); }.damage-types__layout,.guide-grid { grid-template-columns:1fr; }.damage-type,.damage-type--1,.damage-type--2,.damage-type--3,.damage-type--4 { grid-column:auto; min-height:0; }.repair-decision__panel { padding:27px 23px; }.repair-decision__steps > div { grid-template-columns:38px 1fr; column-gap:10px; }.process-grid { grid-template-columns:1fr; gap:17px; }.process-grid h3 { font-size:21px; }.collection ul { grid-template-columns:1fr 1fr; }.collection li { min-height:52px; padding:12px; font-size:13px; }.guides__action { margin-top:22px; }.faq-stack summary { min-height:68px; font-size:15px; }.final-valuation { padding:58px 0; }.final-valuation__inner { align-items:flex-start; flex-direction:column; }.final-valuation .smc-button { width:100%; } }
  @media (prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto !important; transition-duration:.01ms !important; animation-duration:.01ms !important; animation-iteration-count:1 !important; } }
</style>
