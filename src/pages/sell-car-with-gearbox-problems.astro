---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import LocationCoverageList from '../components/LocationCoverageList.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import ServicePageMotion from '../components/ServicePageMotion.astro';
import { getServiceGuidePosts } from '../lib/service-guides';
import { getVehicleData } from '../lib/vehicle-data';

const title = 'Sell Car With Gearbox Problems UAE | Free Valuation';
const description = 'Sell a car with gearbox or transmission problems in the UAE. Share the symptoms, vehicle condition and location to request a free valuation.';

const symptoms = [
  ['ph-trend-down', 'Slipping gears', 'A change in revs, drive or gear hold is useful to describe in your own words.'],
  ['ph-hourglass-medium', 'Delayed engagement', 'Explain if Drive, Reverse or a selected gear takes time to engage.'],
  ['ph-arrows-left-right', 'Jerking or harsh shifts', 'Share when the movement happens and whether it is occasional or repeated.'],
  ['ph-speaker-high', 'Unusual gearbox noise', 'Whining, grinding or clunking sounds can be included as reported symptoms.'],
  ['ph-warning', 'Warning lights', 'Mention any transmission warning, dashboard message or known fault code.'],
  ['ph-lock-key', 'Stuck gears', 'Tell the team if the vehicle remains in one gear or will not select a gear.'],
  ['ph-gear-six', 'Transmission failure', 'A vehicle with little or no drive can still be submitted for a valuation.']
];

const valueFactors = [
  ['ph-car-profile', 'Vehicle identity', 'Make, model, year and mileage provide the starting context.'],
  ['ph-gear-six', 'Reported symptoms', 'What happens, when it happens and any existing diagnosis help clarify condition.'],
  ['ph-engine', 'Running and mobility', 'Whether the engine starts and the vehicle can move, roll or steer matters.'],
  ['ph-wrench', 'Overall condition', 'Body, interior, tyres and other mechanical faults are reviewed together.'],
  ['ph-file-text', 'Documents and status', 'Registration, ownership, finance or restrictions may affect the practical route.'],
  ['ph-map-pin', 'Location and access', 'Parking position and recovery access are relevant if collection is appropriate.']
];

const faqs = [
  ['Can I sell a car with gearbox problems in the UAE?', 'Yes. Request a valuation using the vehicle details, then explain the symptoms and any diagnosis you already have. The vehicle can be considered in its current condition.'],
  ['Do I need to repair the gearbox before requesting a valuation?', 'No. You can start with the vehicle as it is and compare a repair route with selling as-is before authorising further work.'],
  ['What gearbox symptoms should I mention?', 'Describe any slipping, delayed engagement, jerking, unusual noise, warning lights, stuck gears or loss of drive. These are reported symptoms, not a confirmed diagnosis.'],
  ['Can a non-running car with transmission failure be valued?', 'Yes. Explain whether the engine starts, whether the vehicle rolls or steers, where it is parked and whether a recovery vehicle can reach it.'],
  ['Do automatic and manual gearbox problems affect the process differently?', 'The useful details can differ, but either type can be submitted. Share the gearbox type, symptoms, mobility and any repair history you know.'],
  ['Is collection available across the UAE?', 'Collection can be discussed across supported UAE locations. Feasibility depends on the vehicle condition, mobility, parking position and access.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
try { helpfulPosts = await getServiceGuidePosts('sell-car-with-gearbox-problems'); } catch { helpfulPosts = []; }

const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Sell My Car', item: 'https://www.scrapmycaruae.com/sell-my-car/' },
  { '@type': 'ListItem', position: 3, name: 'Sell Car With Gearbox Problems', item: 'https://www.scrapmycaruae.com/sell-car-with-gearbox-problems/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/sell-car-with-gearbox-problems/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="gearbox-page" data-service-motion>
    <section class="gearbox-hero" aria-labelledby="gearbox-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/sell-my-car/">Sell My Car</a><span aria-hidden="true">›</span><span aria-current="page">Gearbox problems</span></nav><div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><i class="ph ph-gear-six" aria-hidden="true"></i> Gearbox and transmission valuation</p><h1 id="gearbox-title">Sell a car with <span>gearbox problems</span> in the UAE</h1><p class="hero-lead">Gearbox faults can make a car expensive or difficult to keep on the road. Share the vehicle details and symptoms to request a free valuation.</p><ul class="hero-points"><li><i class="ph ph-check-circle" aria-hidden="true"></i>No repair required first</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Automatic and manual cars considered</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Collection access can be discussed</li></ul></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div></div></div></section>

    <section class="section symptoms-section" aria-labelledby="symptoms-title"><div class="smc-container symptoms-layout"><figure class="photo-visual photo-visual--gearbox"><span class="photo-visual__graphic" aria-hidden="true"></span><img src="/sections/gearbox-inspection-workshop.webp" alt="Mechanic inspecting the internal components of an automotive gearbox in a professional workshop" width="1200" height="900" loading="lazy" decoding="async" /><figcaption><i class="ph ph-magnifying-glass" aria-hidden="true"></i>Describe the symptoms and share any diagnosis already available.</figcaption></figure><div><p class="eyebrow">Common gearbox symptoms</p><h2 id="symptoms-title">What have you <span>noticed?</span></h2><p class="section-lead">A symptom does not confirm a particular fault. Share what the car does, when it happens and any information a workshop has already provided.</p><div class="symptom-list">{symptoms.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div></div></div></section>

    <section class="section decision-section" aria-labelledby="decision-title"><div class="smc-container"><div class="section-heading"><p class="eyebrow">Choose with the full picture</p><h2 id="decision-title">Repair, sell as-is or <span>consider scrap?</span></h2><p>A valuation gives you another reference point before you commit to diagnosis, parts or gearbox work.</p></div><div class="decision-track"><article><span class="route-icon"><i class="ph ph-wrench" aria-hidden="true"></i></span><div><p class="route-label">Repair</p><h3>When the fault and cost are clear</h3><p>May suit a vehicle in otherwise good condition where the likely work is understood and proportionate.</p></div></article><span class="track-link" aria-hidden="true"><i class="ph ph-caret-right"></i></span><article class="route-primary"><span class="route-icon"><i class="ph ph-car-profile" aria-hidden="true"></i></span><div><p class="route-label">Sell as-is</p><h3>When you want to avoid further work</h3><p>Request a valuation using the car’s current gearbox condition and decide after the review.</p></div></article><span class="track-link" aria-hidden="true"><i class="ph ph-caret-right"></i></span><article><span class="route-icon"><i class="ph ph-recycle" aria-hidden="true"></i></span><div><p class="route-label">Potential scrap route</p><h3>When major faults overlap</h3><p>May be discussed for an end-of-life car with transmission failure and other serious issues.</p></div></article></div><div class="decision-action"><span><i class="ph ph-scales" aria-hidden="true"></i>Compare the car’s condition before deciding.</span><SectionActionButton href="/free-quote" label="Request my free valuation" intent="valuation" /></div></div></section>

    <section class="section value-section" aria-labelledby="value-title"><div class="smc-container value-layout"><header><p class="eyebrow">Current-condition review</p><h2 id="value-title">What affects the <span>vehicle’s value?</span></h2><p>No single gearbox symptom produces a fixed price. The review combines the vehicle details, overall condition and practical collection information.</p><SectionActionButton href="/free-quote" label="Value my car as it is" intent="valuation" /></header><div class="factor-ledger">{valueFactors.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section gearbox-types" aria-labelledby="types-title"><div class="smc-container"><div class="section-heading"><p class="eyebrow">Useful details to share</p><h2 id="types-title">Automatic and manual <span>gearbox issues</span></h2><p>The symptoms can present differently. Describe what you experience rather than treating it as a confirmed technical diagnosis.</p></div><div class="type-comparison"><article><header><i class="ph ph-circles-three-plus" aria-hidden="true"></i><div><span>Automatic</span><h3>Transmission behaviour</h3></div></header><ul><li>Delay when selecting Drive or Reverse</li><li>Slipping, harsh or irregular shifts</li><li>Warning messages or loss of drive</li></ul></article><div class="type-divider"><span>OR</span></div><article><header><i class="ph ph-gear-six" aria-hidden="true"></i><div><span>Manual</span><h3>Gear and clutch behaviour</h3></div></header><ul><li>Difficulty selecting or staying in gear</li><li>Grinding, noise or unusual resistance</li><li>Loss of drive or suspected clutch issues</li></ul></article></div><p class="diagnosis-note"><i class="ph ph-info" aria-hidden="true"></i>Clutch, electronics and other components can produce similar symptoms. A workshop diagnosis is helpful when available, but it is not required to request a valuation.</p></div></section>

    <section class="section mobility-section" aria-labelledby="mobility-title"><div class="smc-container mobility-layout"><div><p class="eyebrow">Non-running and limited mobility</p><h2 id="mobility-title">Tell us what the car can <span>still do.</span></h2><p>Gearbox trouble can leave a vehicle moving normally, moving only a short distance or unable to drive. The practical details help shape any collection discussion.</p><ul class="mobility-checks"><li><i class="ph ph-power" aria-hidden="true"></i><span><b>Does the engine start?</b>Starting and driving are separate details.</span></li><li><i class="ph ph-tire" aria-hidden="true"></i><span><b>Can it roll and steer?</b>Include wheel or parking-brake concerns.</span></li><li><i class="ph ph-key" aria-hidden="true"></i><span><b>Are the keys available?</b>Share any access or security issue.</span></li><li><i class="ph ph-buildings" aria-hidden="true"></i><span><b>Where is it parked?</b>Basements, tight spaces and height limits matter.</span></li></ul><a class="text-link" href="/sell-non-running-car/">Read the non-running car guide <i class="ph ph-engine" aria-hidden="true"></i></a></div><figure class="photo-visual photo-visual--collection"><span class="photo-visual__graphic" aria-hidden="true"></span><img src="/sections/gearbox-car-collection.webp" alt="Recovery operator preparing a non-running saloon car for collection in covered parking" width="1200" height="900" loading="lazy" decoding="async" /><figcaption><i class="ph ph-truck" aria-hidden="true"></i>Parking position, clearance and mobility help shape the collection plan.</figcaption></figure></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><div class="section-heading"><p class="eyebrow">How valuation works</p><h2 id="process-title">From gearbox symptoms to a <span>practical next step</span></h2></div><ol class="process-band"><li><i class="ph ph-car-profile" aria-hidden="true"></i><div><h3>Vehicle details</h3><p>Choose the make, model and year.</p></div></li><li><i class="ph ph-chat-circle-text" aria-hidden="true"></i><div><h3>Explain symptoms</h3><p>Share what happens and any known history.</p></div></li><li><i class="ph ph-calculator" aria-hidden="true"></i><div><h3>Valuation review</h3><p>Condition and practical details are considered.</p></div></li><li><i class="ph ph-signpost" aria-hidden="true"></i><div><h3>Choose the route</h3><p>Discuss sale and collection if appropriate.</p></div></li></ol></div></section>

    <section class="section coverage-section" aria-labelledby="coverage-title"><div class="smc-container"><div class="section-heading"><p class="eyebrow">UAE vehicle collection</p><h2 id="coverage-title">Share the location and <span>parking access.</span></h2><p>Supported locations cover the UAE. Collection remains subject to the vehicle’s mobility, access, status and the agreed next route.</p></div><LocationCoverageList /></div></section>

    {helpfulPosts.length > 0 && <section class="section guides-section" aria-labelledby="guides-title"><div class="smc-container"><div class="section-heading"><p class="eyebrow">Relevant guides</p><h2 id="guides-title">Useful reading before <span>you decide.</span></h2><p>Explore existing Wix guides about vehicle condition, valuation and practical next steps.</p></div><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div><div class="section-action"><SectionActionButton href="/blogs" label="Browse all guides" intent="blogs" /></div></div></section>}

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><div class="section-heading"><p class="eyebrow">Questions answered</p><h2 id="faq-title">Gearbox-problem FAQs</h2></div><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><div class="section-action"><SectionActionButton href="/faqs" label="Browse all FAQs" intent="faqs" /></div></div></section>

    <section class="final-cta"><div class="smc-container final-layout"><div><p class="eyebrow">Start with the car as it is</p><h2>Request a gearbox-problem valuation.</h2><p>Share the vehicle details now, then describe the symptoms and mobility directly with the team.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main>
  <ServicePageMotion />
</BaseLayout>

<style>
  .gearbox-page{overflow:hidden;color:#17351d}.gearbox-hero{padding:22px 0 clamp(56px,7vw,88px);border-bottom:1px solid #dce6d9;background:radial-gradient(circle at 7% 20%,rgba(111,173,99,.13),transparent 28%),linear-gradient(135deg,#fbfdf9,#f1f7ef)}.breadcrumb{display:flex;flex-wrap:wrap;gap:8px;align-items:center;color:#647064;font-size:13px}.breadcrumb a{color:#286236;text-decoration:none}.hero-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(400px,.78fr);gap:clamp(42px,7vw,90px);align-items:center;margin-top:34px}.eyebrow{display:flex;gap:8px;align-items:center;margin:0 0 14px;color:#2b7737;font-size:11px;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.eyebrow i{font-size:17px}.hero-copy h1,.section h2,.final-cta h2{margin:0;color:#15371d;font-size:clamp(2.55rem,4.3vw,4.6rem);line-height:1.01;letter-spacing:-.055em}.hero-copy h1 span,.section h2 span{color:#3a8e43}.hero-lead{max-width:690px;margin:23px 0 0;color:#536455;font-size:18px;line-height:1.68}.hero-points{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:27px 0 0;padding:0;list-style:none}.hero-points li{display:flex;gap:8px;align-items:flex-start;color:#31553a;font-size:12px;font-weight:750;line-height:1.45}.hero-points i{color:#338d43;font-size:20px}.hero-form{filter:drop-shadow(0 18px 34px rgba(35,76,40,.08))}.section{padding:clamp(58px,6.4vw,88px) 0}.section-heading{max-width:790px;margin:0 auto 34px;text-align:center}.section-heading .eyebrow{justify-content:center}.section-heading h2,.value-layout h2,.mobility-layout h2{font-size:clamp(2.15rem,3.7vw,3.45rem)}.section-heading>p:last-child,.section-lead,.value-layout header>p:not(.eyebrow),.mobility-layout>div>p:not(.eyebrow){margin:17px auto 0;color:#5b695c;line-height:1.72}.symptoms-layout{display:grid;grid-template-columns:minmax(330px,.84fr) minmax(0,1.16fr);gap:clamp(42px,7vw,94px);align-items:center}.transmission-visual{position:relative;isolation:isolate;min-height:520px;overflow:hidden;border:1px solid #cfe0cb;border-radius:32px;background:linear-gradient(145deg,#153d24,#245b35);box-shadow:0 24px 54px rgba(23,61,36,.17)}.visual-grid{position:absolute;inset:0;opacity:.22;background-image:linear-gradient(rgba(193,232,183,.22) 1px,transparent 1px),linear-gradient(90deg,rgba(193,232,183,.22) 1px,transparent 1px);background-size:38px 38px}.gear-orbit{position:absolute;display:grid;place-items:center;border:1px solid rgba(205,238,194,.3);border-radius:50%}.gear-orbit--outer{top:88px;left:50%;width:260px;height:260px;transform:translateX(-50%)}.gear-orbit--outer span{position:absolute;width:15px;height:15px;border-radius:4px;background:#9bd58b}.gear-orbit--outer span:nth-child(1){top:-7px}.gear-orbit--outer span:nth-child(2){right:20px;top:35px}.gear-orbit--outer span:nth-child(3){right:-7px;top:122px}.gear-orbit--outer span:nth-child(4){bottom:-7px}.gear-orbit--outer span:nth-child(5){bottom:35px;left:20px}.gear-orbit--outer span:nth-child(6){left:-7px;top:122px}.gear-orbit--inner{top:148px;left:50%;width:140px;height:140px;transform:translateX(-50%);background:rgba(220,244,212,.08);box-shadow:0 0 0 22px rgba(220,244,212,.035)}.gear-orbit--inner i{color:#d9f1d1;font-size:74px}.signal{position:absolute;display:flex;gap:8px;align-items:center;padding:10px 13px;border:1px solid rgba(221,244,213,.22);border-radius:12px;background:rgba(255,255,255,.09);color:#e6f5e1;font-size:11px;font-weight:800;backdrop-filter:blur(7px)}.signal i{color:#aee19f;font-size:18px}.signal--top{top:55px;right:28px}.signal--bottom{left:28px;bottom:104px}.transmission-visual>p{position:absolute;right:26px;bottom:27px;margin:0;color:#cce2c7;font-size:13px;line-height:1.55;text-align:right}.symptom-list{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #d7e3d4}.symptom-list article{display:grid;grid-template-columns:38px 1fr;gap:13px;padding:18px 16px 18px 0;border-bottom:1px solid #d7e3d4}.symptom-list article:nth-child(odd){margin-right:16px;border-right:1px solid #d7e