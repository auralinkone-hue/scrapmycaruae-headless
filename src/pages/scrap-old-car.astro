---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import { getVehicleData } from '../lib/vehicle-data';
import { getRelevantPosts } from '../lib/related-posts';
import { priorityCoverageLocations } from '../lib/locations';

const title = 'Scrap Old Car UAE | Free Valuation for Older Vehicles';
const description = 'Scrap an old or end-of-life car in the UAE. Compare repair, sell-as-is and scrap options for older, damaged or non-running vehicles and request a free valuation.';
const signs = [
  { icon: 'ph-wrench', title: 'Repeated repair bills', copy: 'One repair leads to another, or the car keeps returning to the workshop. Look at the recurring problems, the likely next work and how useful the car remains before committing to more spending.' },
  { icon: 'ph-engine', title: 'Engine or gearbox problems', copy: 'Major mechanical faults can change the decision, especially when other issues are present. Share symptoms and any diagnosis you already have; a fault alone does not automatically make the car scrap.', href: '/sell-car-with-engine-problems/', link: 'Explore engine-problem options' },
  { icon: 'ph-clock-counter-clockwise', title: 'Long-term non-running', copy: 'A car that has been parked for a long time needs a review of its current state. Explain the last time it ran, known faults, tyre condition and whether it can roll.', href: '/sell-non-running-car/', link: 'Options for a non-running car' },
  { icon: 'ph-warning-circle', title: 'Severe accident or body damage', copy: 'Significant damage, corrosion or missing parts may affect repair practicality and remaining usability. Describe the damage honestly and share photos if available.' },
  { icon: 'ph-lightning', title: 'Multiple electrical or mechanical faults', copy: 'A combination of warning lights, electrical issues and mechanical wear can be more difficult to resolve than an isolated problem. List the known faults so the whole vehicle can be considered.' },
  { icon: 'ph-car-profile', title: 'Declining practical usability', copy: 'If the car can no longer meet your everyday needs reliably, compare its remaining usefulness with the time and work needed. High mileage is context, not a fixed scrapping threshold.' }
];
const routes = [
  { icon: 'ph-wrench', label: 'Repair', fit: 'A clear, manageable fault in an otherwise usable car.', weigh: 'The diagnosis, likely further work and how long you intend to keep it.' },
  { icon: 'ph-car-profile', label: 'Sell as-is', fit: 'Remaining next-use value, without arranging repairs yourself.', weigh: 'A valuation of the car in its current condition and a clear description of its faults.' },
  { icon: 'ph-recycle', label: 'Scrap', fit: 'Severe wear, major damage or multiple issues that make further use impractical.', weigh: 'Potential reuse or salvage, vehicle status and the practical collection route.' }
];
const factors = [
  ['ph-car-profile', 'Make, model & year', 'Vehicle identity gives age, parts relevance and demand some context. Include the mileage if known.'],
  ['ph-warning-circle', 'Current condition', 'Explain body damage, wear, missing parts and known mechanical or electrical issues.'],
  ['ph-engine', 'Whether it runs', 'Tell us whether it starts, moves and rolls, and how long it has been parked.'],
  ['ph-gear', 'Reusable components', 'Some serviceable parts may still be relevant. Not every component has practical resale value.'],
  ['ph-file-text', 'Documents & status', 'Available registration details and any known finance or restrictions help clarify the next step.'],
  ['ph-truck', 'Collection access', 'Share the exact location, parking level, keys and whether a recovery vehicle can reach the car.']
];
const steps = [
  ['ph-car-profile', 'Details', 'Share the make, model and year, then explain the condition and known faults.'],
  ['ph-calculator', 'Valuation', 'Discuss the vehicle as it is, including usability, parts relevance and access.'],
  ['ph-signpost', 'Choose a route', 'Compare repair, an as-is sale and a possible scrap route before deciding.'],
  ['ph-truck', 'Collection if appropriate', 'If collection is part of the agreed route, review the location and arrangements.']
];
const paperwork = [
  ['ph-identification-card', 'Mulkiya', 'Have the available registration and vehicle identity details ready. Flag missing or expired documents at the start.'],
  ['ph-bank', 'Finance', 'Check the current finance or mortgage status with the lender and registration authority before agreeing the transaction steps.'],
  ['ph-file-text', 'Fines / restrictions', 'Check for outstanding fines or restrictions and confirm what must be resolved for your chosen route.'],
  ['ph-key', 'Plates / registration', 'Confirm the relevant authority’s requirements for plate handling, transfer or cancellation. Collection alone should not be treated as confirmation that registration has been cancelled.']
];
const faqs = [
  ['How old does a car have to be before it should be scrapped?', 'There is no age threshold used on this page. Condition, faults, remaining usability, repair practicality and the vehicle’s next-use options matter more than age alone.'],
  ['Does high mileage mean my car is only worth scrap?', 'No. Mileage provides useful context, but it does not determine the route by itself. A high-mileage car may still be usable or suitable for an as-is sale, depending on its actual condition.'],
  ['Should I repair an old car before asking for a valuation?', 'You can request a valuation in the car’s current condition. Share any known diagnosis or estimate, then compare further repair work with the practical as-is and scrap options before spending more.'],
  ['Can an old car with engine or gearbox failure still be valued?', 'Yes. Explain the known fault, whether it starts or moves, and any other issues. The review considers the individual vehicle rather than assuming a major fault automatically means scrap.'],
  ['Can I request a valuation for a long-term parked or non-running car?', 'Yes. Share the vehicle details, how long it has been parked, known faults and exact location. Whether it rolls, has keys and can be reached matters if collection is discussed.'],
  ['What can affect the value of an older car?', 'Make, model, year, current condition, whether it runs, potentially reusable components, demand, documents and collection access all provide context. There are no fixed prices or age-based price bands on this page.'],
  ['What paperwork should I check in the UAE?', 'Have the Mulkiya or available registration details ready, check finance and any fines or restrictions, and confirm plate and registration requirements with the relevant authority. Requirements depend on the emirate and agreed route.'],
  ['Can my old car be collected?', 'Collection can be discussed if it is appropriate for the chosen route. Share the emirate, exact location, access restrictions, keys and whether the car moves; arrangements are confirmed after those details are reviewed.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];
await Promise.all([
  (async () => { try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); } })(),
  (async () => { try { helpfulPosts = await getRelevantPosts({ _id: 'scrap-old-car-guide', slug: 'scrap-old-car' }, ['old car', 'older car', 'end-of-life', 'high mileage', 'repair', 'non-running', 'scrap', 'engine']); } catch { helpfulPosts = []; } })()
]);
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Scrap My Car', item: 'https://www.scrapmycaruae.com/scrap-my-car/' },
  { '@type': 'ListItem', position: 3, name: 'Scrap Old Car', item: 'https://www.scrapmycaruae.com/scrap-old-car/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/scrap-old-car/" ogImage="/sections/older-worn-car-uae.webp">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <main class="old-car-page">
    <section class="old-hero" aria-labelledby="old-car-title"><div class="smc-container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/scrap-my-car/">Scrap My Car</a><span aria-hidden="true">›</span><span aria-current="page">Scrap old car</span></nav>
      <div class="old-hero__grid">
        <div class="old-hero__copy"><p class="eyebrow"><i class="ph ph-signpost" aria-hidden="true"></i> Before the next repair</p><h1 id="old-car-title">Scrap your old car <span>in the UAE</span></h1><p class="hero-lead">If an older car is becoming difficult or expensive to keep on the road, start with its current condition before deciding whether to repair, sell or scrap it.</p></div>
        <div class="old-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div>
        <ul class="hero-trust"><li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li><li><i class="ph ph-check" aria-hidden="true"></i>No repair required first</li><li><i class="ph ph-check" aria-hidden="true"></i>Compare your practical options</li></ul>
      </div>
    </div></section>

    <section class="section life-section" aria-labelledby="life-title"><div class="smc-container life-layout">
      <figure class="old-car-photo"><img src="/sections/older-worn-car-uae.webp" alt="Older silver sedan with faded paint, worn headlights and everyday body wear outside a workshop" width="1536" height="1024" loading="lazy" decoding="async" /><figcaption><i class="ph ph-car-profile" aria-hidden="true"></i>Look at the whole vehicle, not just its age.</figcaption></figure>
      <div class="life-copy"><p class="eyebrow">Age is only part of the story</p><h2 id="life-title">When does an old car become an <span>end-of-life car?</span></h2><p class="life-lead">An older vehicle is not automatically an end-of-life vehicle. What matters is whether it remains practical to use, what work it needs and whether further repairs make sense for your circumstances.</p><div class="life-context"><article><i class="ph ph-calendar-blank" aria-hidden="true"></i><div><h3>Age gives context</h3><p>A model year does not tell you how the car has been maintained or what still works.</p></div></article><article><i class="ph ph-gauge" aria-hidden="true"></i><div><h3>Mileage needs a closer look</h3><p>Use and service history matter alongside the current condition and known faults.</p></div></article><article><i class="ph ph-scales" aria-hidden="true"></i><div><h3>Practicality guides the decision</h3><p>Consider the work ahead, remaining usability and alternatives before choosing a route.</p></div></article></div></div>
    </div></section>

    <section class="section signs-section" aria-labelledby="signs-title"><div class="smc-container">
      <header class="section-heading"><p class="eyebrow">A useful point to pause</p><h2 id="signs-title">Signs it may be time <span>to move on</span></h2><p>These are reasons to review the options, not automatic reasons to scrap the car.</p></header>
      <div class="signs-layout"><div class="signs-accordion">{signs.map((sign, index) => <details name="old-car-signs" open={index === 0}><summary><span><i class:list={['ph', sign.icon]} aria-hidden="true"></i>{sign.title}</span><i class="ph ph-plus accordion-toggle" aria-hidden="true"></i></summary><div class="sign-content"><p>{sign.copy}</p>{sign.href && <a class="info-link" href={sign.href}><i class:list={['ph', sign.icon]} aria-hidden="true"></i>{sign.link}</a>}</div></details>)}</div><aside class="decision-note"><i class="ph ph-scales" aria-hidden="true"></i><p class="eyebrow">Before committing to more work</p><h3>Look beyond the next repair bill.</h3><p>What is known about the fault? What else needs attention? Will the car still meet your needs?</p><p>A current-condition valuation gives you another option to weigh up.</p><SectionActionButton href="/free-quote" label="Value my old car" intent="valuation" /></aside></div>
    </div></section>

    <section class="section comparison-section" aria-labelledby="comparison-title"><div class="smc-container">
      <header class="section-heading"><p class="eyebrow">Three routes. One considered decision.</p><h2 id="comparison-title">Repair, sell as-is <span>or scrap?</span></h2><p>Choose around the car you have today and the work still ahead of it.</p></header>
      <div class="comparison-wrap"><table class="decision-table"><caption class="sr-only">Compare repair, sell-as-is and scrap routes for an older vehicle</caption><thead><tr><th scope="col">Route</th><th scope="col">When to consider it</th><th scope="col">What to weigh up</th></tr></thead><tbody>{routes.map((route) => <tr><th scope="row"><span><i class:list={['ph', route.icon]} aria-hidden="true"></i>{route.label}</span></th><td><span class="mobile-label" aria-hidden="true">When to consider it</span>{route.fit}</td><td><span class="mobile-label" aria-hidden="true">What to weigh up</span>{route.weigh}</td></tr>)}</tbody></table></div>
      <p class="comparison-note">A scrap route is one option, not an assumption based on age or mileage.</p><div class="section-cta"><SectionActionButton href="/free-quote" label="Compare my old-car options" intent="valuation" /></div>
    </div></section>

    <section class="section matters-section" aria-labelledby="matters-title"><div class="smc-container">
      <div class="editorial-heading"><div><p class="eyebrow">The car still has a story to tell</p><h2 id="matters-title">What still matters <span>in an old car?</span></h2></div><div><p>Share an honest picture of the vehicle. Age is only one detail in a review of its condition, usability and practical next route.</p><a class="info-link" href="/scrap-car-value/"><i class="ph ph-calculator" aria-hidden="true"></i>Understand scrap-car value</a></div></div>
      <ol class="matters-list">{factors.map(([icon, heading, copy]) => <li><i class:list={['ph', icon, 'matter-icon']} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></li>)}</ol>
    </div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">From uncertainty to a next step</p><h2 id="process-title">How the <span>process works</span></h2><p>Start with the details. Choose the route after the discussion.</p></header><ol class="process-list">{steps.map(([icon, heading, copy], index) => <li><div class="step-marker"><i class:list={['ph', icon]} aria-hidden="true"></i><span>Step {index + 1}</span></div><div><h3>{heading}</h3><p>{copy}</p></div>{index < steps.length - 1 && <span class="step-connector" aria-hidden="true"><i class="ph ph-arrow-right"></i></span>}</li>)}</ol></div></section>

    <section class="section status-section" aria-labelledby="status-title"><div class="smc-container status-layout"><header><p class="eyebrow">Check the status before the handover</p><h2 id="status-title">UAE paperwork <span>& vehicle status</span></h2><p>Requirements depend on the emirate, registration authority and agreed route. Confirm the current requirements before taking any transfer or cancellation steps.</p><div class="status-visual" aria-hidden="true"><div class="status-orbit"><span class="status-orbit__centre"><i class="ph ph-car-profile"></i><b>Vehicle status</b></span><span class="status-orbit__node status-orbit__node--top"><i class="ph ph-identification-card"></i></span><span class="status-orbit__node status-orbit__node--right"><i class="ph ph-bank"></i></span><span class="status-orbit__node status-orbit__node--bottom"><i class="ph ph-file-text"></i></span><span class="status-orbit__node status-orbit__node--left"><i class="ph ph-key"></i></span><i class="ph ph-arrow-clockwise status-orbit__direction"></i></div></div><div class="official-links"><a class="info-link" href="https://www.rta.ae/wps/portal/rta/ae/home/rta-services/service-details?serviceId=525" target="_blank" rel="noopener noreferrer"><i class="ph ph-identification-card" aria-hidden="true"></i>RTA registration cancellation guidance</a><a class="info-link" href="https://u.ae/en/information-and-services/transportation/registering-vehicles" target="_blank" rel="noopener noreferrer"><i class="ph ph-book-open-text" aria-hidden="true"></i>UAE government vehicle registration guide</a></div></header><ul class="status-list">{paperwork.map(([icon, heading, copy]) => <li><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></li>)}</ul></div></section>

    <section class="section collection-section" aria-labelledby="collection-title"><div class="smc-container collection-layout"><div><p class="eyebrow">If collection is the next step</p><h2 id="collection-title">An old car, <span>wherever it is parked</span></h2><p>Share the location, keys, whether it rolls and any parking restrictions. Feasibility and arrangements are reviewed with the request.</p><a class="info-link" href="/car-removal/"><i class="ph ph-truck" aria-hidden="true"></i>Car removal and collection checks</a></div><div class="collection-locations"><i class="ph ph-truck collection-icon" aria-hidden="true"></i><p>UAE collection discussion</p><ul aria-label="UAE collection locations">{priorityCoverageLocations.map((location) => <li><i class="ph ph-map-pin" aria-hidden="true"></i>{location}</li>)}</ul></div></div></section>

    <section class="section guides-section" aria-labelledby="guides-title"><div class="smc-container"><header class="section-heading"><p class="eyebrow">Read before deciding</p><h2 id="guides-title">Guides for your <span>next decision</span></h2><p>Explore existing advice on repairs, vehicle value and the scrap-car route.</p></header>{helpfulPosts.length > 0 ? <div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div> : <p class="guides-fallback">Find vehicle selling and scrap-car guides on our blog.</p>}<div class="section-cta"><SectionActionButton href="/blogs" label="View all blogs" intent="blogs" /></div></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container"><header class="section-heading"><h2 id="faq-title">Old-car valuation <span>FAQs</span></h2><p>Answers before you commit to another repair or decide to move on.</p></header><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus accordion-toggle" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>

    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-layout"><div><p class="eyebrow">Start with what it is worth today</p><h2 id="final-title">Before the next repair,<span>know your options.</span></h2><p>Share your older car’s details and current condition to start with a free valuation.</p></div><div class="final-actions"><SectionActionButton href="/free-quote" label="Get my old-car valuation" intent="valuation" /><a href="/scrap-my-car/"><i class="ph ph-recycle" aria-hidden="true"></i>Explore the complete scrap-car process</a></div></div></section>
  </main>
</BaseLayout>

<style>
  .old-car-page{color:#17331d;background:#fff}
  .old-car-page :is(h1,h2,h3,p,li,td,th){overflow-wrap:break-word}
  .old-hero{padding:22px 0 clamp(55px,6vw,86px);border-bottom:1px solid #dce7d8;background:radial-gradient(ellipse at 10% 35%,rgba(99,159,78,.13),transparent 45%),linear-gradient(130deg,#fafcf8,#edf5e8 70%,#f7faf9)}
  .breadcrumb{display:flex;gap:8px;flex-wrap:wrap;align-items:center;color:#647163;font-size:13px}
  .breadcrumb a{color:#315d37;text-decoration:none}
  .old-hero__grid{display:grid;grid-template-areas:'copy form' 'trust form';grid-template-columns:minmax(0,1.05fr) minmax(450px,.82fr);gap:24px clamp(32px,5vw,75px);margin-top:33px}
  .old-hero__copy{grid-area:copy;align-self:end}
  .eyebrow{display:flex;align-items:center;gap:7px;margin:0;color:#38763d;font-size:11px;font-weight:850;letter-spacing:.1em;text-transform:uppercase;line-height:1.5}
  .eyebrow i{font-size:18px}
  h1{margin:17px 0 0;font-size:clamp(3.1rem,5vw,4.8rem);line-height:.98;letter-spacing:-.06em}
  h1 span{display:block;color:#398b41}
  .hero-lead{max-width:580px;margin:22px 0 0;color:#566454;font-size:18px;line-height:1.65}
  .old-hero__form{grid-area:form;min-width:0}
  .hero-trust{grid-area:trust;align-self:start;display:grid;gap:11px;margin:0;padding:0;list-style:none}
  .hero-trust li{display:flex;gap:9px;align-items:center;color:#335936;font-size:14px;font-weight:750}
  .hero-trust i{display:grid;flex:0 0 21px;width:21px;height:21px;place-items:center;border-radius:50%;background:#2f7d37;color:#fff;font-size:12px}
  .section{padding:clamp(54px,5.7vw,78px) 0}
  h2{margin:13px 0 0;font-size:clamp(2.2rem,3.7vw,3.5rem);line-height:1.07;letter-spacing:-.05em}
  h2 span{color:#398b41}
  h3{margin:0;font-size:18px;line-height:1.35;letter-spacing:-.025em}
  .editorial-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);gap:clamp(30px,6vw,85px);align-items:end;margin-bottom:32px}
  .editorial-heading>p,.editorial-heading>div>p:not(.eyebrow){margin:0;color:#5d6b5b;line-height:1.75}
  .editorial-heading .info-link{margin-top:17px}
  .life-section{background:radial-gradient(ellipse at 14% 50%,#edf5e5,transparent 42%),#fff}
  .life-layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:clamp(28px,4.2vw,60px);align-items:center}
  .old-car-photo{position:relative;margin:0;padding:12px;border:1px solid #d5e5cc;border-radius:28px;background:linear-gradient(145deg,#e8f2df,#f8fbf5);box-shadow:0 18px 42px rgba(34,76,29,.1)}
  .old-car-photo img{display:block;width:100%;height:auto;aspect-ratio:auto;object-fit:contain;border-radius:19px}
  .old-car-photo figcaption{display:flex;gap:9px;align-items:center;padding:15px 8px 5px;color:#345d37;font-size:12px;font-weight:750;line-height:1.5}
  .old-car-photo figcaption i{font-size:23px}
  .life-copy h2{font-size:clamp(2rem,3.05vw,2.85rem)}
  .life-lead{margin:18px 0 0;color:#5c6c56;font-size:15px;line-height:1.7}
  .life-context{display:grid;gap:16px;margin-top:23px}
  .life-context article{display:grid;grid-template-columns:39px minmax(0,1fr);gap:12px;align-items:start}
  .life-context article>i{display:grid;width:38px;height:38px;place-items:center;border-radius:50%;background:#e3f0d8;border:1px solid #c8deb9;color:#3b7c3f;font-size:19px;box-shadow:0 0 0 4px #f5f9f1}
  .life-context article:nth-child(2)>i{background:#e5f1f8;border-color:#c7dfea;color:#2b709c}
  .life-context h3{font-size:15px}
  .life-context p{margin:5px 0 0;color:#61705e;font-size:13px;line-height:1.6}
  .section-heading{max-width:760px;margin:0 auto 34px;text-align:center}
  .section-heading .eyebrow{justify-content:center}
  .section-heading p:not(.eyebrow){margin:16px auto 0;color:#5d6b5b;line-height:1.7}
  .signs-section{background:#f6f8f2;border-block:1px solid #e2e9dc}
  .signs-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:clamp(30px,5vw,66px);align-items:start}
  .signs-accordion{border-top:1px solid #cddbc7}
  .signs-accordion details{border-bottom:1px solid #cddbc7}
  summary{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:65px;padding:15px 0;list-style:none;cursor:pointer;font-weight:750;line-height:1.4}
  summary::-webkit-details-marker{display:none}
  .signs-accordion summary>span{display:flex;gap:12px;align-items:center;font-size:16px}
  .signs-accordion summary>span>i{display:grid;flex:0 0 34px;width:34px;height:34px;place-items:center;border-radius:10px;background:#e3eddc;color:#32743a;font-size:19px}
  .accordion-toggle{display:grid;flex:0 0 27px;width:27px;height:27px;place-items:center;border:1px solid #ccddc4;border-radius:50%;color:#377a3e;transition:transform .18s ease}
  details[open]>summary .accordion-toggle{transform:rotate(45deg)}
  .sign-content{padding:0 8px 23px 46px}
  .sign-content p{margin:0;color:#5d6b5b;font-size:14px;line-height:1.75}
  .sign-content .info-link{margin-top:13px}
  .info-link{display:inline-flex;gap:7px;align-items:center;color:#1769aa;font-size:14px;font-weight:750;line-height:1.5;text-decoration:none}
  .info-link:hover{text-decoration:underline;color:#0f4e7b}
  .info-link>i{flex:0 0 auto;font-size:18px}
  summary:focus-visible,a:focus-visible{outline:3px solid #6c9fc1;outline-offset:4px;border-radius:4px}
  .decision-note{position:relative;isolation:isolate;overflow:hidden;padding:clamp(25px,3vw,38px);border-radius:19px;background:radial-gradient(circle at 100% 0,rgba(161,207,113,.18),transparent 55%),#1d4727;color:#fff}
