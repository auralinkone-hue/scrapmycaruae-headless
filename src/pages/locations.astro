---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import ServicePageMotion from '../components/ServicePageMotion.astro';
import { getVehicleData } from '../lib/vehicle-data';
import { dubaiLocations, abuDhabiLocations } from '../lib/locations';

const coverage = [
  { id: 'dubai', name: 'Dubai' }, { id: 'abu-dhabi', name: 'Abu Dhabi' },
  { id: 'sharjah', name: 'Sharjah' }, { id: 'ajman', name: 'Ajman' },
  { id: 'al-ain', name: 'Al Ain' }, { id: 'ras-al-khaimah', name: 'Ras Al Khaimah' },
  { id: 'fujairah', name: 'Fujairah' }, { id: 'umm-al-quwain', name: 'Umm Al Quwain' }
];
const priorityGroups = [
  { id: 'dubai', name: 'Dubai', icon: 'ph-buildings', note: 'From residential parking to workshops and industrial locations, share the exact area and entrance details.', areas: ['Al Quoz', 'Al Qusais', 'Dubai Marina', 'Business Bay', 'Mirdif', 'Dubai Investments Park (DIP)'], more: dubaiLocations },
  { id: 'sharjah', name: 'Sharjah', icon: 'ph-warehouse', note: 'Al Sajaa Industrial Area and other Sharjah locations can be discussed. Tell us the exact yard, building or parking position.', areas: ['Al Sajaa Industrial Area', 'Other Sharjah locations'], more: [] },
  { id: 'abu-dhabi', name: 'Abu Dhabi', icon: 'ph-bank', note: 'City parking, residential communities and industrial locations need different access information.', areas: ['Musaffah', 'Khalifa City', 'Reem Island', 'Al Raha Beach', 'Mohammed Bin Zayed City', 'Shakhbout City'], more: abuDhabiLocations }
];
const widerCoverage = [
  ['ajman', 'Ajman', 'Tell us the area, whether the vehicle is at a residence, workshop or yard, and any entry restrictions.'],
  ['al-ain', 'Al Ain', 'Share the exact location and known mobility. Al Ain is included as a service area within Abu Dhabi emirate.'],
  ['ras-al-khaimah', 'Ras Al Khaimah', 'Include the parking position, site contact arrangements and the space around the vehicle.'],
  ['fujairah', 'Fujairah', 'Describe the access from the road to the car, including slopes, gates or restricted entrances.'],
  ['umm-al-quwain', 'Umm Al Quwain', 'Share the precise area and whether collection would involve private parking, a workshop or a storage site.']
];
const accessChecks = [
  ['ph-buildings', 'Underground parking', 'Parking level, entrance height and ramp clearance.'],
  ['ph-arrows-in', 'Tight access', 'Narrow lanes, gates, columns and space to manoeuvre.'],
  ['ph-warehouse', 'Industrial yards', 'Site access, entry permission and an available contact.'],
  ['ph-key', 'Keys and mobility', 'Missing keys, locked wheels, steering and whether it is known to roll.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'Body damage or known repair needs.', 'ph-car-profile'],
  ['/sell-non-running-car/', 'Non-running cars', 'A car that will not start or drive.', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'Explain symptoms or an existing diagnosis.', 'ph-wrench'],
  ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'Share any loss of drive or shifting issues.', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'Describe known water exposure and condition.', 'ph-drop'],
  ['/scrap-my-car/', 'Scrap cars', 'Explore a potential end-of-life route.', 'ph-recycle'],
  ['/fleet-disposal/', 'Fleet vehicles', 'Multiple vehicles, locations or site contacts.', 'ph-truck']
];
const steps = [
  ['ph-car-profile', 'Vehicle details', 'Start with the make, model and year, then provide your contact details.'],
  ['ph-map-pin', 'Location & access', 'Share the emirate, area, parking position and any entry restrictions.'],
  ['ph-magnifying-glass', 'Condition review', 'Explain known faults, mobility and any information already available.'],
  ['ph-path', 'Collection route', 'Discuss feasibility and agree the practical arrangements before collection.']
];
const faqs = [
  ['Which UAE locations can I ask about?', 'You can request a valuation from Dubai, Abu Dhabi, Sharjah, Ajman, Al Ain, Ras Al Khaimah, Fujairah and Umm Al Quwain. Share the exact location so coverage and practical collection access can be reviewed for your vehicle.'],
  ['Does coverage mean collection is guaranteed?', 'No. Collection depends on the vehicle condition, its mobility, access, location and the arrangements agreed with the team. A place appearing in this guide does not confirm a collection booking.'],
  ['Can a car be collected from underground parking?', 'It can be discussed. Share the parking level, entrance height, ramp details, nearby obstacles and whether the car is known to roll and steer. These details help the team review a practical approach.'],
  ['What if my car does not run or the keys are missing?', 'Explain the known condition, whether the wheels or steering are restricted, and whether any keys are available. Do not move or test the vehicle just to complete a request; describe what you already know.'],
  ['Can you consider cars in industrial yards or workshops?', 'Yes. Include the exact yard or workshop location, access restrictions, who can authorise entry and any site contact arrangements. Collection remains subject to review.'],
  ['Can I arrange several vehicles in different locations?', 'Start a fleet disposal discussion and share the number of vehicles, their condition and each location. Access and collection arrangements may need to be reviewed separately for each site.'],
  ['Do the map and area names represent branches?', 'No. They indicate general areas where you can request a valuation and discuss collection. They do not identify branch offices, depots or fixed recovery routes.'],
  ['What information should I prepare before discussing collection?', 'Have the vehicle details, known condition, exact location, parking access, keys information and available ownership documents ready. The team can explain what further information is needed for your circumstances.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
// Generalised UAE country outline, coordinates from johan/world.geo.json (ARE).
// Geographic overview only; no branch pins, boundaries between emirates or recovery routes.
const outlineCoordinates = [[51.579519,24.245497],[51.757441,24.294073],[51.794389,24.019826],[52.577081,24.177439],[53.404007,24.151317],[54.008001,24.121758],[54.693024,24.797892],[55.439025,25.439145],[56.070821,26.055464],[56.261042,25.714606],[56.396847,24.924732],[55.886233,24.920831],[55.804119,24.269604],[55.981214,24.130543],[55.528632,23.933604],[55.525841,23.524869],[55.234489,23.110993],[55.208341,22.70833],[55.006803,22.496948],[52.000733,23.001154],[51.617708,24.014219]];
const outlinePath = outlineCoordinates.map(([lon, lat], index) => `${index ? 'L' : 'M'}${((lon - 51.4) * 108 + 45).toFixed(1)},${((26.2 - lat) * 112 + 26).toFixed(1)}`).join(' ') + ' Z';
---

<BaseLayout title="Car Collection Locations UAE | Scrap My Car UAE" description="Find vehicle collection coverage across Dubai, Abu Dhabi, Sharjah, Ajman and other UAE locations. Request a free valuation for an unwanted, damaged or non-running car." canonical="/locations/" ogImage="/sections/uae-vehicle-collection.webp">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="locations-page" data-service-motion>
    <section class="locations-hero" aria-labelledby="locations-title"><div class="smc-container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">UAE Locations</span></nav>
      <div class="hero-grid"><div class="hero-copy"><p class="eyebrow"><i class="ph ph-map-trifold" aria-hidden="true"></i> Location. Condition. Access.</p><h1 id="locations-title"><span class="title-line">Car collection</span> <span class="title-line accent">across the UAE</span></h1><p class="hero-lead">Sell or scrap an unwanted, damaged or non-running car from locations across the UAE. Share your vehicle details and location to start a free valuation.</p></div><div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-points"><li><i class="ph ph-car-profile" aria-hidden="true"></i>Damaged &amp; non-running cars</li><li><i class="ph ph-map-trifold" aria-hidden="true"></i>Multiple UAE locations</li><li><i class="ph ph-truck" aria-hidden="true"></i>Collection access considered</li></ul></div>
      <div class="hero-bottom"><span>UAE COLLECTION COVERAGE</span><a href="#coverage"><i class="ph ph-arrow-down" aria-hidden="true"></i> Explore the areas</a></div>
    </div></section>

    <section class="section coverage-overview" id="coverage" aria-labelledby="coverage-title"><div class="smc-container"><header class="section-heading"><div><p class="eyebrow">One starting point. Many locations.</p><h2 id="coverage-title">Find your area.<br /><span>Plan the next step.</span></h2></div><p>Select a location to explore coverage details below. The exact parking position and vehicle condition help determine what can be arranged.</p></header>
      <div class="coverage-atlas"><figure class="atlas-map"><div class="atlas-top"><span><i class="ph ph-compass" aria-hidden="true"></i> UAE / COVERAGE GUIDE</span><span>GEOGRAPHIC OVERVIEW</span></div><svg viewBox="0 0 660 500" role="img" aria-labelledby="uae-map-title uae-map-description"><title id="uae-map-title">United Arab Emirates coverage overview</title><desc id="uae-map-description">Generalised outline of the United Arab Emirates. The adjacent location list provides accessible links to coverage information; the map does not mark branch offices.</desc><defs><pattern id="atlas-grid" width="38" height="38" patternUnits="userSpaceOnUse"><path d="M 38 0 L 0 0 0 38" fill="none" stroke="#416f50" stroke-opacity=".12" /></pattern><linearGradient id="atlas-land" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#204f34" /><stop offset="1" stop-color="#518f56" /></linearGradient></defs><rect width="660" height="500" fill="url(#atlas-grid)" /><path d={outlinePath} class="map-halo" /><path d={outlinePath} fill="url(#atlas-land)" stroke="#a2d48f" stroke-width="2" stroke-linejoin="round" /><text x="300" y="285" class="map-country">UAE</text><text x="300" y="314" class="map-subtitle">UNITED ARAB EMIRATES</text><path d="M590 88V43m-9 12 9-13 9 13" stroke="#b5d9a6" stroke-width="2" fill="none" /><text x="590" y="31" class="map-north">N</text></svg><figcaption>General coverage overview. Collection access is reviewed for each vehicle.</figcaption></figure><div class="atlas-directory"><p class="eyebrow">Explore coverage details</p><nav aria-label="UAE coverage areas">{coverage.map((area, index) => <a href={`#${area.id}`}><span class="area-number">0{index + 1}</span><span>{area.name}</span><i class="ph ph-arrow-down-right" aria-hidden="true"></i></a>)}</nav><p class="directory-note"><i class="ph ph-info" aria-hidden="true"></i>Area names indicate coverage enquiries, not branches or a confirmed collection booking.</p></div></div>
    </div></section>

    <section class="section access-section" aria-labelledby="access-title"><div class="smc-container editorial-grid"><div class="editorial-copy"><p class="eyebrow">The last few metres matter</p><h2 id="access-title">Collection depends on <span>more than the emirate.</span></h2><p class="lead">A car in an open yard and a car behind a low basement entrance need different information. Tell us how the vehicle can be reached.</p><div class="access-ledger">{accessChecks.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div><p class="inline-context">For a <a href="/sell-non-running-car/">non-running car</a>, describe what you already know about its movement. You do not need to start or move it to make an enquiry.</p><SectionActionButton href="/car-removal/" label="Explore car removal" intent="valuation" icon="ph-truck" /></div><figure class="photo-frame access-photo"><span class="photo-glow" aria-hidden="true"></span><img src="/sections/uae-car-recovery-access.webp" alt="Recovery technician assessing space around an older sedan beside concrete columns in underground UAE parking" width="1200" height="900" loading="lazy" decoding="async" /><figcaption><i class="ph ph-ruler" aria-hidden="true"></i><span>Entrance height, parking space and vehicle mobility all help shape the access review.</span></figcaption></figure></div></section>

    <section class="section priority-section" aria-labelledby="priority-title"><div class="smc-container"><header class="section-heading"><div><p class="eyebrow">Priority service areas</p><h2 id="priority-title">Local details.<br /><span>A practical plan.</span></h2></div><p>Start with the area, then share the exact parked location. These are coverage guides; access and arrangements are considered individually.</p></header><div class="priority-groups">{priorityGroups.map((group) => <section class="priority-group" id={group.id} aria-labelledby={`heading-${group.id}`}><header><span class="region-icon"><i class:list={['ph', group.icon]} aria-hidden="true"></i></span><h3 id={`heading-${group.id}`}>{group.name}</h3><p>{group.note}</p></header><ul class="location-rows">{group.areas.map(area => <li><i class="ph ph-map-pin" aria-hidden="true"></i><span>{area}</span></li>)}</ul>{group.more.filter(area => !group.areas.includes(area)).length > 0 && <details class="more-areas"><summary>More {group.name} areas<i class="ph ph-plus" aria-hidden="true"></i></summary><ul class="location-rows">{group.more.filter(area => !group.areas.includes(area)).map(area => <li><i class="ph ph-map-pin" aria-hidden="true"></i><span>{area}</span></li>)}</ul></details>}<SectionActionButton href="/free-quote" label={`Value my car in ${group.name}`} intent="valuation" /></section>)}</div>
      <div class="wider-heading"><p class="eyebrow">Across the wider UAE</p><p>Share your area even if a particular neighbourhood is not listed.</p></div><div class="wider-rows">{widerCoverage.map(([id, name, copy]) => <article id={id}><h3><i class="ph ph-map-pin" aria-hidden="true"></i>{name}</h3><p>{copy}</p><a href="/free-quote" aria-label={`Request a valuation in ${name}`}><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></article>)}</div>
    </div></section>

    <section class="section vehicle-section" aria-labelledby="vehicle-title"><div class="smc-container vehicle-layout"><header><p class="eyebrow">Condition is part of coverage</p><h2 id="vehicle-title">More than cars<br /><span>that can drive.</span></h2><p class="lead">An unwanted or damaged car can be considered as it is. Explain the condition and where it is parked so the team can discuss a suitable route.</p><p class="inline-context">Considering scrap? Read <a href="/scrap-car-value/">what shapes scrap car value</a> before choosing your next step.</p><SectionActionButton href="/free-quote" label="Request my free valuation" intent="valuation" /></header><nav class="vehicle-routes" aria-label="Vehicle collection services">{vehicleRoutes.map(([href, title, copy, icon]) => <a href={href}><i class:list={['ph', icon]} aria-hidden="true"></i><span><b>{title}</b><small>{copy}</small></span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</nav></div></section>

    <section class="section process-section" aria-labelledby="process-title"><div class="smc-container"><header class="center-heading"><p class="eyebrow">How collection works across the UAE</p><h2 id="process-title">Four details that<br /><span>shape the route.</span></h2></header><ol class="collection-process">{steps.map(([icon, heading, copy], index) => <li><div class="step-top"><span>0{index + 1}</span><i class:list={['ph', icon]} aria-hidden="true"></i></div><h3>{heading}</h3><p>{copy}</p></li>)}</ol><p class="process-note">Collection is discussed after review. No fixed collection time or recovery method is assumed.</p></div></section>

    <section class="section logistics-section" aria-labelledby="logistics-title"><div class="smc-container editorial-grid logistics-grid"><figure class="photo-frame collection-photo"><span class="photo-glow" aria-hidden="true"></span><img src="/sections/uae-vehicle-collection.webp" alt="Recovery operator checking a mildly damaged silver sedan secured on a flatbed truck in a spacious UAE industrial yard" width="1200" height="900" loading="lazy" decoding="async" /><figcaption><i class="ph ph-truck" aria-hidden="true"></i><span>Collection arrangements follow the vehicle review and the access information you share.</span></figcaption></figure><div class="editorial-copy"><p class="eyebrow">From parked position to practical collection</p><h2 id="logistics-title">A clear handover<br /><span>starts before arrival.</span></h2><p class="lead">Share the useful details early so the team can review the location and discuss what is needed.</p><ol class="handover-list"><li><b>Pinpoint the vehicle</b><span>Exact location, parking level, nearby entrance and a suitable contact.</span></li><li><b>Explain restrictions</b><span>Gates, site permissions, opening arrangements and any blocked access.</span></li><li><b>Confirm known mobility</b><span>Whether it can roll and steer, any locked wheels and available keys.</span></li><li><b>Discuss documents</b><span>Have available ownership and vehicle information ready for the review.</span></li></ol><SectionActionButton href="/car-removal/" label="Read the collection guide" intent="process" icon="ph-truck" /></div></div></section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header><p class="eyebrow">Before you enquire</p><h2 id="faq-title">UAE location<br /><span>FAQs</span></h2><p class="lead">Coverage, parking and practical collection questions.</p></header><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>

    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner"><div><p class="eyebrow"><i class="ph ph-map-pin" aria-hidden="true"></i> Your vehicle. Your location.</p><h2 id="final-title">Tell us where<br /><span>your car is located</span></h2><p>Start with your vehicle details. Share the area, condition and access to discuss a free valuation and a practical next step.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main><ServicePageMotion />
</BaseLayout>

<style>
