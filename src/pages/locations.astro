---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import LocationsMotion from '../components/LocationsMotion.astro';
import LocationGlyph from '../components/LocationGlyph.astro';
import { getVehicleData } from '../lib/vehicle-data';
import { dubaiLocations, abuDhabiLocations } from '../lib/locations';

const coverage = [
  { id: 'dubai', name: 'Dubai' }, { id: 'abu-dhabi', name: 'Abu Dhabi' },
  { id: 'sharjah', name: 'Sharjah' }, { id: 'ajman', name: 'Ajman' },
  { id: 'al-ain', name: 'Al Ain' }, { id: 'ras-al-khaimah', name: 'Ras Al Khaimah' },
  { id: 'fujairah', name: 'Fujairah' }, { id: 'umm-al-quwain', name: 'Umm Al Quwain' }
];
const priorityGroups = [
  { id: 'dubai', name: 'Dubai', icon: 'ph-buildings', note: 'From residential parking to workshops and industrial locations, share the exact area and entrance details.', areas: ['Al Quoz', 'Al Qusais', 'Dubai Marina', 'Business Bay', 'Mirdif', 'Dubai Investments Park (DIP)'], more: dubaiLocations },
  { id: 'sharjah', name: 'Sharjah', icon: 'ph-warehouse', note: 'Al Sajaa Industrial Area and other Sharjah locations can be discussed. Tell us the exact yard, building or parking position.', areas: ['Al Sajaa Industrial Area', 'Sharjah Industrial Area', 'Al Nahda'], more: [] },
  { id: 'abu-dhabi', name: 'Abu Dhabi', icon: 'ph-bank', note: 'City parking, residential communities and industrial locations need different access information.', areas: ['Musaffah', 'Khalifa City', 'Reem Island', 'Al Raha Beach', 'Mohammed Bin Zayed City', 'Shakhbout City'], more: abuDhabiLocations }
];
const widerCoverage = [
  ['ajman', 'Ajman', 'Tell us the area, whether the vehicle is at a residence, workshop or yard, and any entry restrictions.'],
  ['al-ain', 'Al Ain', 'Share the exact location and known mobility. Al Ain is included as a service area within Abu Dhabi emirate.'],
  ['ras-al-khaimah', 'Ras Al Khaimah', 'Include the parking position, site contact arrangements and the space around the vehicle.'],
  ['fujairah', 'Fujairah', 'Describe the access from the road to the car, including slopes, gates or restricted entrances.'],
  ['umm-al-quwain', 'Umm Al Quwain', 'Share the precise area and whether collection would involve private parking, a workshop or a storage site.']
];
const accessChecks = [
  ['ph-buildings', 'Underground parking', 'Parking level, entrance height and ramp clearance.'],
  ['ph-arrows-in', 'Tight access', 'Narrow lanes, gates, columns and space to manoeuvre.'],
  ['ph-warehouse', 'Industrial yards', 'Site access, entry permission and an available contact.'],
  ['ph-key', 'Keys and mobility', 'Missing keys, locked wheels, steering and whether it is known to roll.']
];
const vehicleRoutes = [
  ['/sell-damaged-car/', 'Damaged cars', 'Body damage or known repair needs.', 'ph-car-profile'],
  ['/sell-non-running-car/', 'Non-running cars', 'A car that will not start or drive.', 'ph-engine'],
  ['/sell-car-with-engine-problems/', 'Engine problems', 'Explain symptoms or an existing diagnosis.', 'ph-wrench'],
  ['/sell-car-with-gearbox-problems/', 'Gearbox problems', 'Share any loss of drive or shifting issues.', 'ph-gear-six'],
  ['/sell-flood-damaged-car/', 'Flood-damaged cars', 'Describe known water exposure and condition.', 'ph-drop'],
  ['/scrap-my-car/', 'Scrap cars', 'Explore a potential end-of-life route.', 'ph-recycle'],
  ['/fleet-disposal/', 'Fleet vehicles', 'Multiple vehicles, locations or site contacts.', 'ph-truck']
];
const steps = [
  ['ph-car-profile', 'Vehicle details', 'Start with the make, model and year, then provide your contact details.'],
  ['ph-map-pin', 'Location & access', 'Share the emirate, area, parking position and any entry restrictions.'],
  ['ph-magnifying-glass', 'Condition review', 'Explain known faults, mobility and any information already available.'],
  ['ph-path', 'Collection route', 'Discuss feasibility and agree the practical arrangements before collection.']
];
const faqs = [
  ['Which UAE locations can I ask about?', 'You can request a valuation from Dubai, Abu Dhabi, Sharjah, Ajman, Al Ain, Ras Al Khaimah, Fujairah and Umm Al Quwain. Share the exact location so coverage and practical collection access can be reviewed for your vehicle.'],
  ['Does coverage mean collection is guaranteed?', 'No. Collection depends on the vehicle condition, its mobility, access, location and the arrangements agreed with the team. A place appearing in this guide does not confirm a collection booking.'],
  ['Can a car be collected from underground parking?', 'It can be discussed. Share the parking level, entrance height, ramp details, nearby obstacles and whether the car is known to roll and steer. These details help the team review a practical approach.'],
  ['What if my car does not run or the keys are missing?', 'Explain the known condition, whether the wheels or steering are restricted, and whether any keys are available. Do not move or test the vehicle just to complete a request; describe what you already know.'],
  ['Can you consider cars in industrial yards or workshops?', 'Yes. Include the exact yard or workshop location, access restrictions, who can authorise entry and any site contact arrangements. Collection remains subject to review.'],
  ['Can I arrange several vehicles in different locations?', 'Start a fleet disposal discussion and share the number of vehicles, their condition and each location. Access and collection arrangements may need to be reviewed separately for each site.'],
  ['Do the map and area names represent branches?', 'No. They indicate general areas where you can request a valuation and discuss collection. They do not identify branch offices, depots or fixed recovery routes.'],
  ['What information should I prepare before discussing collection?', 'Have the vehicle details, known condition, exact location, parking access, keys information and available ownership documents ready. The team can explain what further information is needed for your circumstances.']
];
let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'UAE Locations', item: 'https://www.scrapmycaruae.com/locations/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title="Car Collection Locations UAE | Scrap My Car UAE" description="Find vehicle collection coverage across Dubai, Abu Dhabi, Sharjah, Ajman and other UAE locations. Request a free valuation for an unwanted, damaged or non-running car." canonical="/locations/" ogImage="/sections/uae-vehicle-collection.webp">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <main class="locations-page" data-location-hub>
    <div class="page-progress" data-scroll-progress aria-hidden="true"></div>
    <section class="locations-hero" aria-labelledby="locations-title">
      <div class="smc-container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">UAE Locations</span></nav>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><LocationGlyph kind="coverage" /> Built around your location</p>
            <h1 id="locations-title"><span class="title-line">Car collection</span> <span class="title-line accent">across the UAE</span></h1>
            <p class="hero-lead">Sell or scrap an unwanted, damaged or non-running car from locations across the UAE. Share your vehicle details and location to start a free valuation.</p>
          </div>
          <div class="hero-form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div>
          <ul class="hero-points">
            <li><span><LocationGlyph kind="vehicle" /></span>Damaged &amp; non-running cars</li>
            <li><span><LocationGlyph kind="coverage" /></span>Multiple UAE locations</li>
            <li><span><LocationGlyph kind="collection" /></span>Collection access considered</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section coverage-overview" id="coverage" aria-labelledby="coverage-title">
      <div class="smc-container">
        <header class="section-heading" data-reveal>
          <div><p class="eyebrow">A local starting point</p><h2 id="coverage-title">Your area.<br /><span>Your next step.</span></h2></div>
          <p>Choose your location, explore the coverage details and start a free valuation. We’ll review the vehicle and its access with you.</p>
        </header>
        <figure class="uae-artwork" data-reveal data-scene>
          <img src="/sections/uae-collection-landscape.webp" alt="Satellite-inspired editorial artwork of UAE desert terrain, emerald Gulf waters and the eastern mountain landscape" width="1200" height="900" loading="lazy" decoding="async" />
          <div class="uae-artwork__shade" aria-hidden="true"></div>
          <div class="uae-artwork__copy"><span class="artwork-mark"><LocationGlyph kind="coverage" /></span><p>United Arab Emirates</p><h3>From the city<br />to the wider UAE.</h3><span>Tell us where the car is.<br />We’ll discuss the practical route.</span></div>
          <figcaption>Illustrative regional artwork. Area names below indicate collection enquiries, not branches or fixed routes.</figcaption>
        </figure>
        <nav class="coverage-actions" aria-label="UAE coverage areas" data-reveal>
          {coverage.map(area => <SectionActionButton href={['dubai', 'abu-dhabi', 'sharjah', 'ajman', 'ras-al-khaimah', 'al-ain', 'fujairah'].includes(area.id) ? `/locations/${area.id}/` : `#${area.id}`}  label={area.name} intent="process" icon="ph-map-pin" />)}
        </nav>
      </div>
    </section>

    <section class="access-section" aria-labelledby="access-title">
      <div class="smc-container">
        <figure class="photo-scene access-feature" data-scene data-reveal>
          <img class="scene-image" src="/sections/uae-car-recovery-access.webp" alt="Recovery technician assessing space around an older sedan beside concrete columns in underground UAE parking" width="1200" height="900" loading="lazy" decoding="async" />
          <div class="scene-shade" aria-hidden="true"></div>
          <div class="scene-content">
            <p class="eyebrow">The last few metres matter</p>
            <h2 id="access-title">Collection depends on <span>more than the emirate.</span></h2>
            <p>A car in an open yard and a car behind a low basement entrance need different information. Tell us how the vehicle can be reached.</p>
            <SectionActionButton href="/car-removal/" label="Explore car removal" intent="valuation" icon="ph-truck" />
          </div>
          <figcaption><i class="ph ph-ruler" aria-hidden="true"></i><span>Entrance height, parking space and vehicle mobility help shape the access review.</span></figcaption>
        </figure>
        <div class="access-notes" data-reveal>
          {accessChecks.map(([icon, heading, copy], index) => <article><span class="note-glyph"><LocationGlyph kind={['access', 'coverage', 'sharjah', 'keys'][index]} /></span><h3>{heading}</h3><p>{copy}</p></article>)}
        </div>
        <p class="section-footnote">For a <a href="/sell-non-running-car/">non-running car</a>, describe what you already know. You do not need to start or move it to make an enquiry.</p>
      </div>
    </section>

    <section class="section priority-section" aria-labelledby="priority-title">
      <div class="smc-container">
        <header class="section-heading" data-reveal><div><p class="eyebrow">Priority service areas</p><h2 id="priority-title">Choose an area.<br /><span>See the useful details.</span></h2></div><p>Residential parking, industrial yards and workshops each need a different access review. Start with the location nearest your car.</p></header>
        <div class="region-browser" data-reveal>
          <div class="region-tabs">
            <div class="region-local-tabs" role="tablist" aria-label="Priority collection details">
              {priorityGroups.filter(group => group.id !== 'sharjah').map((group, index) => <button type="button" id={`tab-${group.id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={group.id} tabindex={index === 0 ? 0 : -1} data-region-tab={group.id}><LocationGlyph kind={group.id} /><span>{group.name}</span><span class="tab-status" aria-hidden="true"></span></button>)}
            </div>
            <a class="region-link" href="/locations/sharjah/"><LocationGlyph kind="sharjah" /><span>Sharjah</span></a>
          </div>
          {priorityGroups.filter(group => group.id !== 'sharjah').map(group => <section class="region-panel" id={group.id} role="tabpanel" aria-labelledby={`tab-${group.id}`} tabindex="0" data-region-panel>
            <div class="region-intro"><span class="region-glyph"><LocationGlyph kind={group.id} /></span><p class="eyebrow">Collection coverage</p><h3>{group.name}</h3><p>{group.note}</p><SectionActionButton href={['dubai', 'abu-dhabi', 'sharjah'].includes(group.id) ? `/locations/${group.id}/` : '/free-quote'} label={['dubai', 'abu-dhabi', 'sharjah'].includes(group.id) ? `Explore ${group.name} collection` : `Value my car in ${group.name}`} intent="valuation" icon={group.id === 'dubai' ? 'ph-buildings' : 'ph-calculator'} /></div>
            <div class="region-areas"><p class="area-label">Areas you can ask about</p><ul class="area-tags">{group.areas.map(area => <li><i class="ph ph-check-circle" aria-hidden="true"></i>{area}</li>)}</ul>{group.more.filter(area => !group.areas.includes(area)).length > 0 && <details class="more-areas"><summary>View more {group.name} areas<i class="ph ph-plus" aria-hidden="true"></i></summary><ul class="area-tags">{group.more.filter(area => !group.areas.includes(area)).map(area => <li>{area}</li>)}</ul></details>}<p class="area-help"><i class="ph ph-info" aria-hidden="true"></i>Not listed? Share the exact area and we’ll review the access.</p></div>
          </section>)}
        </div>
        <div class="wider-heading" data-reveal><div><p class="eyebrow">More UAE locations</p><h3>Beyond the main cities.</h3></div><p>Explore the practical details for your area.</p></div>
        <div class="wider-coverage" data-reveal>
          {widerCoverage.map(([id, name, copy]) => id === 'ajman' ? <div class="wider-location"><a class="wider-summary" href="/locations/ajman/"><span class="wider-glyph"><LocationGlyph kind="ajman" /></span><span>Ajman</span><span class="details-label">Collection guide</span><i class="ph ph-truck" aria-hidden="true"></i></a></div> : id === 'ras-al-khaimah' ? <div class="wider-location"><a class="wider-summary" href="/locations/ras-al-khaimah/"><span class="wider-glyph"><LocationGlyph kind="ras-al-khaimah" /></span><span>Ras Al Khaimah</span><span class="details-label">Collection guide</span><i class="ph ph-truck" aria-hidden="true"></i></a></div> : id === 'al-ain' ? <div class="wider-location"><a class="wider-summary" href="/locations/al-ain/"><span class="wider-glyph"><LocationGlyph kind="al-ain" /></span><span>Al Ain</span><span class="details-label">Collection guide</span><i class="ph ph-truck" aria-hidden="true"></i></a></div> : id === 'fujairah' ? <div class="wider-location"><a class="wider-summary" href="/locations/fujairah/"><span class="wider-glyph"><LocationGlyph kind="fujairah" /></span><span>Fujairah</span><span class="details-label">Collection guide</span><i class="ph ph-truck" aria-hidden="true"></i></a></div> : <details id={id} class="wider-location"><summary><span class="wider-glyph"><LocationGlyph kind={id} /></span><span>{name}</span><span class="details-label">Collection details</span><i class="ph ph-plus" aria-hidden="true"></i></summary><div class="wider-content"><p>{copy}</p><SectionActionButton href="/free-quote" label={`Valuation in ${name}`} intent="valuation" /></div></details>)}
        </div>
      </div>
    </section>

    <section class="section vehicle-section" aria-labelledby="vehicle-title">
      <div class="smc-container">
        <header class="vehicle-heading" data-reveal><span class="vehicle-heading__icon"><LocationGlyph kind="vehicle" /></span><div><p class="eyebrow">A route for the car you have</p><h2 id="vehicle-title">More than cars <span>that can drive.</span></h2><p>Explore the relevant guide, then tell us the condition and where the car is parked.</p></div></header>
        <nav class="service-buttons" aria-label="Vehicle collection services" data-reveal>{vehicleRoutes.map(([href, title, copy, icon]) => <SectionActionButton href={href} label={title} intent="valuation" icon={icon} />)}</nav>
        <p class="vehicle-footnote">Considering scrap? Explore <a href="/scrap-car-value/">what shapes scrap car value</a> before choosing the next step.</p>
      </div>
    </section>

    <section class="section process-section" aria-labelledby="process-title">
      <div class="smc-container">
        <header class="center-heading" data-reveal><p class="eyebrow">How collection works across the UAE</p><h2 id="process-title">A clear process.<br /><span>A practical collection plan.</span></h2></header>
        <ol class="collection-process">{steps.map(([icon, heading, copy], index) => <li data-reveal><div class="step-marker"><LocationGlyph kind={['vehicle', 'coverage', 'review', 'collection'][index]} /><span>0{index + 1}</span></div><h3>{heading}</h3><p>{copy}</p></li>)}</ol>
        <p class="section-footnote">Collection is discussed after review. Timing and recovery arrangements are agreed for the individual vehicle.</p>
      </div>
    </section>

    <section class="logistics-section" aria-labelledby="logistics-title">
      <div class="smc-container">
        <figure class="photo-scene handover-feature" data-scene data-reveal>
          <img class="scene-image" src="/sections/uae-vehicle-collection.webp" alt="Recovery operator checking a mildly damaged silver sedan secured on a flatbed truck in a spacious UAE industrial yard" width="1200" height="900" loading="lazy" decoding="async" />
          <div class="handover-tint" aria-hidden="true"></div>
          <div class="handover-panel"><span class="handover-glyph"><LocationGlyph kind="collection" /></span><p class="eyebrow">Before collection</p><h2 id="logistics-title">Clear access.<br /><span>A clearer handover.</span></h2><p>Share the details early so the team can review the practical arrangements.</p><ul><li><i class="ph ph-check-circle" aria-hidden="true"></i>Exact parking location</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Gates and site permissions</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Known mobility and keys</li><li><i class="ph ph-check-circle" aria-hidden="true"></i>Available vehicle documents</li></ul><SectionActionButton href="/car-removal/" label="Read the collection guide" intent="process" icon="ph-truck" /></div>
          <figcaption><i class="ph ph-truck" aria-hidden="true"></i><span>Collection arrangements follow the vehicle review and the access information you share.</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="section faq-section" aria-labelledby="faq-title"><div class="smc-container faq-layout"><header data-reveal><p class="eyebrow">Before you enquire</p><h2 id="faq-title">UAE location<br /><span>FAQs</span></h2><p class="lead">Coverage, parking and practical collection questions.</p></header><div class="faq-stack" data-reveal>{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="smc-container final-inner" data-reveal><div><p class="eyebrow">Your vehicle. Your location.</p><h2 id="final-title">Tell us where<br /><span>your car is located</span></h2><p>Start with your vehicle details. Share the area, condition and access to discuss a free valuation and a practical next step.</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></section>
  </main>
  <LocationsMotion />
</BaseLayout>

<style>
