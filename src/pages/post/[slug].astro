---
export const prerender = false;

import { media } from '@wix/sdk';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { wixClient } from '../../lib/wix';
import { renderRicosDocument } from '../../lib/rich-content';

const slug = Astro.params.slug ?? '';
let post: any = null;
let loadError = '';

try {
  const result = await wixClient.posts.getPostBySlug(slug, {
    fieldsets: ['URL', 'SEO', 'RICH_CONTENT', 'CONTENT_TEXT']
  });
  post = result.post;
} catch (error) {
  Astro.response.status = 404;
  loadError = error instanceof Error ? error.message : String(error);
}

const tags = post?.seoData?.tags ?? [];
const seoTitle =
  tags.find((tag: any) => tag.type === 'title' && !tag.disabled)?.children ||
  post?.title ||
  'Scrap My Car UAE';

const seoDescription =
  tags.find(
    (tag: any) =>
      tag.type === 'meta' &&
      tag.props?.name === 'description' &&
      !tag.disabled
  )?.props?.content ||
  post?.excerpt ||
  '';

const canonical = post?.slug
  ? `https://www.scrapmycaruae.com/post/${post.slug}`
  : 'https://www.scrapmycaruae.com/blogs';

const rawCoverImage =
  post?.media?.wixMedia?.image ||
  post?.heroImage ||
  null;

const normalizedCover =
  typeof rawCoverImage === 'string'
    ? (() => {
        try {
          return media.getImageUrl(rawCoverImage);
        } catch {
          return null;
        }
      })()
    : rawCoverImage?.url
      ? rawCoverImage
      : null;

const coverImage = normalizedCover?.url || '';

const coverAlt =
  post?.media?.altText ||
  post?.title ||
  '';

const articleHtml = post?.richContent
  ? renderRicosDocument(post.richContent)
  : post?.contentText
    ? `<p>${post.contentText}</p>`
    : '';

const publishedDate = post?.firstPublishedDate
  ? new Date(post.firstPublishedDate)
  : null;

const updatedDate = post?.lastPublishedDate
  ? new Date(post.lastPublishedDate)
  : publishedDate;

const formatDate = (date: Date | null) =>
  date
    ? new Intl.DateTimeFormat('en-AE', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      }).format(date)
    : '';

const shareUrl = canonical;
const shareText = post?.title ?? 'Scrap My Car UAE';
const encodedShareUrl = encodeURIComponent(shareUrl);
const encodedShareText = encodeURIComponent(shareText);
const shareLinks = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedShareUrl}`,
  x: `https://twitter.com/intent/tweet?url=${encodedShareUrl}&text=${encodedShareText}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedShareUrl}`
};

const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description: seoDescription,
      datePublished: post.firstPublishedDate,
      dateModified: post.lastPublishedDate || post.firstPublishedDate,
      mainEntityOfPage: canonical,
      image: coverImage ? [coverImage] : undefined,
      publisher: {
        '@type': 'Organization',
        name: 'Scrap My Car UAE',
        url: 'https://www.scrapmycaruae.com'
      }
    }
  : null;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
  ogImage={coverImage}
  ogType="article"
>
  {jsonLd && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </Fragment>
  )}

  {post ? (
    <main class="article-shell">
      <div class="smc-kicker">Scrap My Car UAE Blog</div>
      <h1>{post.title}</h1>

      <div class="meta">
        {publishedDate && <span>{formatDate(publishedDate)}</span>}
        {post.minutesToRead && <span>• {post.minutesToRead} min read</span>}
        {updatedDate &&
          publishedDate &&
          updatedDate.getTime() !== publishedDate.getTime() && (
            <span>• Updated {formatDate(updatedDate)}</span>
          )}
      </div>

      {coverImage && (
        <div class="cover-wrap" data-image-loading>
          <img
            class="cover"
            src={coverImage}
            alt={coverAlt}
            width={normalizedCover?.width}
            height={normalizedCover?.height}
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}

      <article class="article-content" set:html={articleHtml} />

      <section class="article-share" aria-label="Share this article" data-share-url={shareUrl} data-share-title={shareText}>
        <span class="article-share__label">Share this article</span>
        <div class="article-share__actions">
          <a class="article-share__button" href={shareLinks.facebook} target="_blank" rel="noreferrer" aria-label="Share on Facebook">
            <i class="ph ph-facebook-logo" aria-hidden="true"></i><span>Facebook</span>
          </a>
          <a class="article-share__button" href={shareLinks.x} target="_blank" rel="noreferrer" aria-label="Share on X">
            <i class="ph ph-x-logo" aria-hidden="true"></i><span>X</span>
          </a>
          <a class="article-share__button" href={shareLinks.linkedin} target="_blank" rel="noreferrer" aria-label="Share on LinkedIn">
            <i class="ph ph-linkedin-logo" aria-hidden="true"></i><span>LinkedIn</span>
          </a>
          <button class="article-share__button" type="button" data-copy-share aria-label="Copy article link">
            <i class="ph ph-link-simple" aria-hidden="true"></i><span data-copy-label>Copy link</span>
          </button>
        </div>
      </section>
    </main>
  ) : (
    <main class="not-found">
      <h1>Article not found</h1>
      <p>The article may have been moved or is no longer available.</p>
      <p><a href="/blogs">Return to the blogs</a></p>
      {import.meta.env.DEV && loadError && <pre>{loadError}</pre>}
    </main>
  )}
</BaseLayout>

<style>
      .article-shell {
        width: min(900px, calc(100% - 36px));
        margin: 0 auto;
        padding: 54px 0 90px;
      }

      .eyebrow {
        color: #497d39;
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      h1 {
        max-width: 850px;
        margin: 10px 0 18px;
        font-size: clamp(36px, 6vw, 62px);
        line-height: 1.06;
        letter-spacing: -0.045em;
      }

      .meta {
        color: #6a6a6a;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 34px;
        font-size: 15px;
      }

      .cover-wrap {
        aspect-ratio: 16 / 9;
        margin: 0 0 42px;
        border-radius: 18px;
      }

      .cover {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 18px;
        transition: opacity 300ms ease, filter 300ms ease;
      }

      .article-content {
        max-width: 760px;
        margin: 0 auto;
        font-size: 18px;
      }

      .article-content :global(p) {
        margin: 0 0 1.35em;
      }

      .article-content :global(h2),
      .article-content :global(h3),
      .article-content :global(h4) {
        line-height: 1.2;
        letter-spacing: -0.025em;
        margin: 2em 0 0.7em;
      }

      .article-content :global(h2) { font-size: 34px; }
      .article-content :global(h3) { font-size: 27px; }

      .article-content :global(a) {
        color: #356d29;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      .article-content :global(ul),
      .article-content :global(ol) {
        padding-left: 1.4em;
        margin: 0 0 1.5em;
      }

      .article-content :global(li) {
        margin: 0.45em 0;
      }

      .article-content :global(figure) {
        margin: 2.1em 0;
      }

      .article-content :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin-inline: auto;
        border-radius: 12px;
      }

      .article-content :global(blockquote) {
        margin: 2em 0;
        padding: 0.3em 0 0.3em 1.2em;
        border-left: 4px solid #4c7e3a;
        color: #444;
      }

      .article-content :global(hr) {
        border: 0;
        border-top: 1px solid #ddd;
        margin: 2.5em 0;
      }

      .article-share {
        max-width: 760px;
        margin: 46px auto 0;
        padding-top: 24px;
        border-top: 1px solid #dce4da;
      }

      .article-share__label {
        display: block;
        margin-bottom: 12px;
        color: #334033;
        font-size: 14px;
        font-weight: 800;
      }

      .article-share__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }

      .article-share__button {
        display: inline-flex;
        align-items: center;
        min-height: 42px;
        gap: 8px;
        padding: 9px 13px;
        border: 1px solid #d4dfd2;
        border-radius: 10px;
        background: #fff;
        color: #243026;
        font: inherit;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
        transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease, transform 160ms ease;
      }

      .article-share__button :global(i) {
        font-size: 18px;
      }

      .article-share__button:hover {
        border-color: #5b8d4e;
        background: #f4f8f2;
        color: #245c1a;
        transform: translateY(-1px);
      }

      .article-share__button:active {
        transform: translateY(0);
      }

      .article-share__button:focus-visible {
        outline: 3px solid rgb(93 157 76 / 30%);
        outline-offset: 2px;
      }

      .article-content :global(.table-scroll) {
        overflow-x: auto;
        margin: 2em 0;
      }

      .article-content :global(table) {
        border-collapse: collapse;
        width: 100%;
        min-width: 560px;
      }

      .article-content :global(td) {
        border: 1px solid #d8d8d8;
        padding: 12px 14px;
        vertical-align: top;
      }

      .not-found {
        width: min(720px, calc(100% - 36px));
        margin: 100px auto;
        text-align: center;
      }

      .not-found a {
        color: #356d29;
        font-weight: 700;
      }

      @media (max-width: 640px) {
        .article-shell {
          padding-top: 34px;
        }

        h1 {
          font-size: 38px;
        }

        .article-content {
          font-size: 17px;
        }

        .article-content :global(h2) {
          font-size: 29px;
        }

        .article-share {
          margin-top: 36px;
        }

        .article-share__button {
          min-height: 40px;
        }
      }
    </style>

    <script>
      document.querySelectorAll<HTMLElement>('[data-copy-share]').forEach((button) => {
        button.addEventListener('click', async () => {
          const share = button.closest<HTMLElement>('[data-share-url]');
          const url = share?.dataset.shareUrl;
          const label = button.querySelector<HTMLElement>('[data-copy-label]');
          if (!url || !label) return;

          try {
            await navigator.clipboard.writeText(url);
            label.textContent = 'Copied';
            window.setTimeout(() => { label.textContent = 'Copy link'; }, 1600);
          } catch {
            window.prompt('Copy this link:', url);
          }
        });
      });
    </script>
