---
export const prerender = false;

import { media } from '@wix/sdk';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { wixClient } from '../../lib/wix';
import { wixResponsiveImage } from '../../lib/wix-image';
import { renderRicosDocumentWithTableOfContents } from '../../lib/rich-content';
import { getBlogAuthor } from '../../lib/blog-author';
import { canonicalUrl } from '../../lib/seo';
import {
  getArticleBreadcrumbItems,
  getBreadcrumbJsonLd,
  getPostCategoryBreadcrumb
} from '../../lib/blog-breadcrumb';
import BlogBreadcrumb from '../../components/BlogBreadcrumb.astro';
import BlogArticleCard from '../../components/BlogArticleCard.astro';
import ArticleTableOfContents from '../../components/ArticleTableOfContents.astro';
import SharePostMenu from '../../components/SharePostMenu.astro';
import { getRelatedPosts } from '../../lib/related-posts';

const slug = Astro.params.slug ?? '';
let post: any = null;
let loadError = '';

try {
  const result = await wixClient.posts.getPostBySlug(slug, {
    fieldsets: ['URL', 'SEO', 'RICH_CONTENT', 'CONTENT_TEXT']
  });
  post = result.post;
} catch (error) {
  Astro.response.status = 404;
  loadError = error instanceof Error ? error.message : String(error);
}

const [author, categoryBreadcrumb, relatedPosts] = post
  ? await Promise.all([
      getBlogAuthor(post),
      getPostCategoryBreadcrumb(post),
      getRelatedPosts(post)
    ])
  : [null, null, []];

const tags = post?.seoData?.tags ?? [];
const seoTitle =
  tags.find((tag: any) => tag.type === 'title' && !tag.disabled)?.children ||
  post?.title ||
  'Scrap My Car UAE';

const seoDescription =
  tags.find(
    (tag: any) =>
      tag.type === 'meta' &&
      tag.props?.name === 'description' &&
      !tag.disabled
  )?.props?.content ||
  post?.excerpt ||
  '';

const canonical = `/post/${post?.slug || slug}`;
const absoluteCanonical = canonicalUrl(canonical);
const breadcrumbItems = post
  ? getArticleBreadcrumbItems(post.title, canonical, categoryBreadcrumb)
  : [];
const breadcrumbJsonLd = post
  ? getBreadcrumbJsonLd(breadcrumbItems)
  : null;

const rawCoverImage =
  post?.media?.wixMedia?.image ||
  post?.heroImage ||
  null;

const normalizedCover =
  typeof rawCoverImage === 'string'
    ? (() => {
        try {
          return media.getImageUrl(rawCoverImage);
        } catch {
          return null;
        }
      })()
    : rawCoverImage?.url
      ? rawCoverImage
      : null;

const coverImage = normalizedCover?.url || '';
const responsiveCover = wixResponsiveImage(normalizedCover, {
  widths: [480, 768, 1024, 1440, 1800],
  aspectRatio: normalizedCover?.width && normalizedCover?.height
    ? normalizedCover.width / normalizedCover.height
    : 16 / 9
});

const coverAlt =
  post?.media?.altText ||
  post?.title ||
  '';

const renderedArticle = post?.richContent
  ? renderRicosDocumentWithTableOfContents(post.richContent)
  : { html: post?.contentText ? `<p>${post.contentText}</p>` : '', items: [], headingCount: 0 };
const articleHtml = renderedArticle.html;
const tocItems = renderedArticle.items;

const publishedDate = post?.firstPublishedDate
  ? new Date(post.firstPublishedDate)
  : null;

const updatedDate = post?.lastPublishedDate
  ? new Date(post.lastPublishedDate)
  : publishedDate;

const formatDate = (date: Date | null) =>
  date
    ? new Intl.DateTimeFormat('en-AE', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      }).format(date)
    : '';

const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description: seoDescription,
      datePublished: post.firstPublishedDate,
      dateModified: post.lastPublishedDate || post.firstPublishedDate,
      mainEntityOfPage: absoluteCanonical,
      image: coverImage ? [coverImage] : undefined,
      publisher: {
        '@type': 'Organization',
        name: 'Scrap My Car UAE',
        url: canonicalUrl('/')
      }
    }
  : null;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
  ogImage={coverImage}
  ogType="article"
  noindex={!post}
>
  {jsonLd && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
      {breadcrumbJsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')}
        />
      )}
    </Fragment>
  )}

  {post ? (
    <main class="article-shell">
      <div class="smc-kicker">Scrap My Car UAE Blog</div>
      <BlogBreadcrumb items={breadcrumbItems} />
      <h1>{post.title}</h1>

      <div class="article-meta-row">
        <div>
          {author && (
            <div class="author">
              {author.photoUrl ? (
                <img src={author.photoUrl} alt="" width="36" height="36" />
              ) : (
                <span class="author-placeholder"><i class="ph ph-user" aria-hidden="true"></i></span>
              )}
              <span>{author.name}</span>
            </div>
          )}
          <div class="meta">
            {publishedDate && <span>{formatDate(publishedDate)}</span>}
            {post.minutesToRead && <span>{post.minutesToRead} min read</span>}
            {updatedDate &&
              publishedDate &&
              updatedDate.getTime() !== publishedDate.getTime() && (
                <span>Updated {formatDate(updatedDate)}</span>
              )}
          </div>
        </div>
      </div>

      {renderedArticle.headingCount >= 4 && <ArticleTableOfContents items={tocItems} />}

      {responsiveCover.src && (
        <div class="cover-wrap" data-image-loading>
          <picture>
            <source type="image/avif" srcset={responsiveCover.avifSrcset} sizes="(max-width: 936px) calc(100vw - 36px), 900px" />
            <img
              class="cover"
              src={responsiveCover.src}
              srcset={responsiveCover.srcset}
              sizes="(max-width: 936px) calc(100vw - 36px), 900px"
              alt={coverAlt}
              width={responsiveCover.width}
              height={responsiveCover.height}
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
      )}

      <article class="article-content" set:html={articleHtml} />

      <section class="article-quote-cta" aria-labelledby="article-quote-title">
        <div>
          <p class="article-quote-cta__eyebrow">Selling a car in the UAE?</p>
          <h2 id="article-quote-title">Get a fair quote for your car today.</h2>
          <p>Tell us about your vehicle and get a straightforward offer from Scrap My Car UAE.</p>
        </div>
        <a href="/free-quote">Get free quote <span aria-hidden="true">→</span></a>
      </section>

      {relatedPosts.length > 0 && (
        <section class="related-articles" aria-labelledby="related-articles-title">
          <div class="related-articles__heading">
            <p>Keep reading</p>
            <h2 id="related-articles-title">Related articles</h2>
          </div>
          <div class="related-articles__grid">
            {relatedPosts.map((relatedPost) => <BlogArticleCard post={relatedPost} />)}
          </div>
        </section>
      )}

      <div class="article-share">
        <SharePostMenu url={absoluteCanonical} title={post.title} />
      </div>

    </main>
  ) : (
    <main class="not-found">
      <h1>Article not found</h1>
      <p>The article may have been moved or is no longer available.</p>
      <p><a href="/blogs">Return to the blogs</a></p>
      {import.meta.env.DEV && loadError && <pre>{loadError}</pre>}
    </main>
  )}
</BaseLayout>

<style>
      .article-shell {
        width: min(860px, calc(100% - 48px));
        margin: 0 auto;
        padding: 44px 0 80px;
      }

      .eyebrow {
        color: #497d39;
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      h1 {
        max-width: 820px;
        margin: 9px 0 16px;
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        line-height: 1.08;
        letter-spacing: -0.04em;
      }

      .meta {
        color: #6a6a6a;
        display: flex;
        flex-wrap: wrap;
        gap: 6px 0;
        font-size: 14px;
      }
      .meta span { display: inline-flex; align-items: center; white-space: nowrap; }
      .meta span + span::before { content: '•'; margin-inline: 9px; color: #9aa09a; }

      .article-meta-row {
        margin-bottom: 28px;
      }

      .author {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        min-height: 36px;
        margin-bottom: 7px;
        color: #4e554e;
        font-size: 13px;
        font-weight: 700;
      }

      .author img,
      .author-placeholder {
        width: 36px;
        height: 36px;
        flex: 0 0 auto;
        border-radius: 50%;
      }

      .author img { object-fit: cover; }
      .author-placeholder {
        display: grid;
        place-items: center;
        background: #dfe2de;
        color: #fff;
        font-size: 20px;
      }

      .cover-wrap {
        aspect-ratio: 16 / 9;
        margin: 0 0 38px;
        border-radius: var(--smc-radius);
      }

      .cover {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 18px;
        transition: opacity 300ms ease, filter 300ms ease;
      }

      .article-content {
        max-width: 760px;
        margin: 0 auto;
        font-size: 18px;
      }

      .article-content :global(p) {
        margin: 0 0 1.35em;
      }

      .article-content :global(h2),
      .article-content :global(h3),
      .article-content :global(h4) {
        line-height: 1.2;
        letter-spacing: -0.025em;
        margin: 2em 0 0.7em;
      }

      .article-content :global(h2) { font-size: 34px; }
      .article-content :global(h3) { font-size: 27px; }

      .article-content :global(h2[id]),
      .article-content :global(h3[id]) {
        scroll-margin-top: 130px;
      }

      :global(html) { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) {
        :global(html) { scroll-behavior: auto; }
      }

      .article-content :global(a) {
        color: #356d29;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      .article-content :global(ul),
      .article-content :global(ol) {
        padding-left: 1.4em;
        margin: 0 0 1.5em;
      }

      .article-content :global(li) {
        margin: 0.45em 0;
      }

      .article-content :global(figure) {
        margin: 2.1em 0;
      }

      .article-content :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin-inline: auto;
        border-radius: 12px;
      }

      .article-content :global(blockquote) {
        margin: 2em 0;
        padding: 0.3em 0 0.3em 1.2em;
        border-left: 4px solid #4c7e3a;
        color: #444;
      }

      .article-content :global(hr) {
        border: 0;
        border-top: 1px solid #ddd;
        margin: 2.5em 0;
      }

      .article-content :global(.table-scroll) {
        overflow-x: auto;
        margin: 2em 0;
      }

      .article-content :global(table) {
        border-collapse: collapse;
        width: 100%;
        min-width: 560px;
      }

      .article-content :global(td) {
        border: 1px solid #d8d8d8;
        padding: 12px 14px;
        vertical-align: top;
      }

      .article-quote-cta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
        max-width: 760px;
        margin: 58px auto;
        padding: 28px 30px;
        border: 1px solid #cde0ca;
        border-radius: 18px;
        background: linear-gradient(120deg, #f2f9ed, #fff);
      }

      .article-quote-cta__eyebrow,
      .related-articles__heading p {
        margin: 0 0 6px;
        color: #27683a;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .article-quote-cta h2 {
        margin: 0;
        color: #17331d;
        font-size: clamp(1.35rem, 3vw, 1.75rem);
        line-height: 1.18;
      }

      .article-quote-cta p:not(.article-quote-cta__eyebrow) {
        max-width: 540px;
        margin: 8px 0 0;
        color: #415046;
      }

      .article-quote-cta a {
        flex: 0 0 auto;
        padding: 12px 17px;
        border-radius: 10px;
        background: #1c5a2b;
        color: #fff;
        font-weight: 800;
        text-decoration: none;
      }

      .article-quote-cta a:hover { background: #123e1e; }
      .article-quote-cta a:focus-visible,
      .article-share :global(button:focus-visible) {
        outline: 3px solid #1b6e35;
        outline-offset: 3px;
      }

      .related-articles {
        margin: 0 auto 46px;
        padding-top: 46px;
        border-top: 1px solid #dce6dc;
      }

      .related-articles__heading { margin-bottom: 22px; }
      .related-articles__heading h2 {
        margin: 0;
        color: #152018;
        font-size: clamp(1.75rem, 4vw, 2.35rem);
        letter-spacing: -0.035em;
      }

      .related-articles__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .article-share {
        display: flex;
        justify-content: flex-end;
        padding-top: 22px;
        border-top: 1px solid #dce6dc;
      }

      .not-found {
        width: min(720px, calc(100% - 36px));
        margin: 100px auto;
        text-align: center;
      }

      .not-found a {
        color: #356d29;
        font-weight: 700;
      }

      @media (max-width: 640px) {
        .article-shell {
          padding-top: 34px;
        }

        h1 {
          font-size: 38px;
        }

        .article-content {
          font-size: 17px;
        }

        .article-content :global(h2) {
          font-size: 29px;
        }

        .article-quote-cta {
          align-items: flex-start;
          flex-direction: column;
          margin: 42px auto;
          padding: 24px;
        }

        .related-articles { padding-top: 38px; }
        .related-articles__grid { grid-template-columns: 1fr; gap: 16px; }

      }

      /* Editorial refinements shared by the article header and reading flow. */
      .cover { border-radius: var(--smc-radius); }
      .article-content { line-height: 1.72; }
      .article-content :global(h2),
      .article-content :global(h3),
      .article-content :global(h4) {
        line-height: 1.17;
        margin-top: 2.35em;
        margin-bottom: .65em;
      }
      @media (max-width: 640px) {
        .article-shell { width: min(100% - 40px, 860px); }
        .meta { font-size: 13px; }
        .article-content { font-size: 17px; line-height: 1.72; }
      }
    </style>
