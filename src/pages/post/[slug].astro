---
export const prerender = false;

import { media } from '@wix/sdk';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { wixClient } from '../../lib/wix';
import { wixResponsiveImage } from '../../lib/wix-image';
import { renderRicosDocumentWithTableOfContents } from '../../lib/rich-content';
import { getBlogAuthor } from '../../lib/blog-author';
import { canonicalUrl } from '../../lib/seo';
import { getWixPostSeo } from '../../lib/wix-seo';
import {
  getArticleBreadcrumbItems,
  getBreadcrumbJsonLd,
  getPostCategoryBreadcrumb
} from '../../lib/blog-breadcrumb';
import BlogBreadcrumb from '../../components/BlogBreadcrumb.astro';
import ArticleTableOfContents from '../../components/ArticleTableOfContents.astro';
import SharePostMenu from '../../components/SharePostMenu.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import LatestBlogsSidebar from '../../components/LatestBlogsSidebar.astro';
import { getLatestPosts, getRelatedPosts } from '../../lib/related-posts';
import { loadPostPageEnrichment } from '../../lib/post-enrichment';
import { asPositiveNumber, asSafeText, asValidDate, asWixMedia, isRenderableRelatedPost } from '../../lib/wix-post-values';
import { getVehicleData } from '../../lib/vehicle-data';

const slug = Astro.params.slug ?? '';
let post: any = null;
let loadError = '';

try {
  const result = await wixClient.posts.getPostBySlug(slug, {
    fieldsets: ['URL', 'SEO', 'RICH_CONTENT', 'CONTENT_TEXT']
  });
  if (!result?.post) {
    Astro.response.status = 404;
    loadError = 'The requested article is unavailable.';
  } else {
    post = result.post;
  }
} catch (error) {
  Astro.response.status = 404;
  loadError = error instanceof Error ? error.message : String(error);
}

const { author, categoryBreadcrumb, relatedPosts } = post
  ? await loadPostPageEnrichment({
      loadAuthor: () => getBlogAuthor(post),
      loadCategoryBreadcrumb: () => getPostCategoryBreadcrumb(post),
      loadRelatedPosts: () => getRelatedPosts(post)
    })
  : { author: null, categoryBreadcrumb: null, relatedPosts: [] };

const emptyVehicleData = { makes: [], models: [], years: [] };
const [vehicleDataResult, latestPostsResult] = post
  ? await Promise.allSettled([getVehicleData(), getLatestPosts(post)])
  : [{ status: 'rejected' }, { status: 'rejected' }] as const;
const vehicleData = vehicleDataResult.status === 'fulfilled' ? vehicleDataResult.value : emptyVehicleData;
const canRenderSidebarForm = vehicleData.makes.length > 0 && vehicleData.models.length > 0 && vehicleData.years.length > 0;
const latestPosts = latestPostsResult.status === 'fulfilled'
  ? latestPostsResult.value.filter(isRenderableRelatedPost)
  : [];

const wixSeo = post ? getWixPostSeo(post) : null;
const postTitle = asSafeText(post?.title, 'Scrap My Car UAE');
const postExcerpt = asSafeText(post?.excerpt);
const seoTitle = wixSeo?.title || 'Scrap My Car UAE';
const seoDescription = wixSeo?.description || '';
const canonical = wixSeo?.canonical || canonicalUrl(`/post/${slug}`);
const absoluteCanonical = canonical;
const breadcrumbItems = post
  ? getArticleBreadcrumbItems(postTitle, canonical, categoryBreadcrumb)
  : [];
const breadcrumbJsonLd = post
  ? getBreadcrumbJsonLd(breadcrumbItems)
  : null;

const rawCoverImage =
  post?.media?.wixMedia?.image ||
  post?.heroImage ||
  null;
const rawCoverMedia = asWixMedia(rawCoverImage);

const normalizedCover =
  typeof rawCoverImage === 'string'
    ? (() => {
        try {
          return media.getImageUrl(rawCoverImage);
        } catch {
          return null;
        }
      })()
    : rawCoverMedia?.url
      ? rawCoverMedia
      : null;

const coverImage = typeof normalizedCover?.url === 'string' ? normalizedCover.url : '';
const responsiveCover = wixResponsiveImage(normalizedCover, {
  widths: [480, 768, 1024, 1440, 1800],
  aspectRatio: asPositiveNumber(normalizedCover?.width) && asPositiveNumber(normalizedCover?.height)
    ? asPositiveNumber(normalizedCover?.width) / asPositiveNumber(normalizedCover?.height)
    : 16 / 9
});

const coverAlt = asSafeText(post?.media?.altText, postTitle);

const renderedArticle = post?.richContent
  ? renderRicosDocumentWithTableOfContents(post.richContent)
  : { html: post?.contentText ? `<p>${post.contentText}</p>` : '', items: [], headingCount: 0 };
const articleHtml = renderedArticle.html;
const tocItems = renderedArticle.items;

const publishedDate = asValidDate(post?.firstPublishedDate);

const updatedDate = asValidDate(post?.lastPublishedDate) || publishedDate;
const renderableRelatedPosts = relatedPosts.filter(isRenderableRelatedPost);
const minutesToRead = asPositiveNumber(post?.minutesToRead);

const formatDate = (date: Date | null) =>
  date
    ? new Intl.DateTimeFormat('en-AE', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      }).format(date)
    : '';

const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: postTitle,
      description: seoDescription,
      datePublished: post.firstPublishedDate,
      dateModified: post.lastPublishedDate || post.firstPublishedDate,
      mainEntityOfPage: absoluteCanonical,
      image: coverImage ? [coverImage] : undefined,
      publisher: {
        '@type': 'Organization',
        name: 'Scrap My Car UAE',
        url: canonicalUrl('/')
      }
    }
  : null;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
  ogImage={coverImage}
  ogType="article"
  noindex={!post || Boolean(wixSeo?.noindex)}
>
  {jsonLd && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
      {breadcrumbJsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')}
        />
      )}
    </Fragment>
  )}

  {post ? (
    <main class="article-shell">
      <BlogBreadcrumb items={breadcrumbItems} />
      <section class="article-opening">
        <div class="article-opening__copy">
          <h1>{postTitle}</h1>
          {postExcerpt && <p class="article-opening__excerpt">{postExcerpt}</p>}
          <div class="article-opening__details">
            {updatedDate && <p class="article-opening__updated">Last updated: {formatDate(updatedDate)}</p>}
            {minutesToRead > 0 && <p class="article-opening__read-time">{minutesToRead} min read</p>}
          </div>
          {author && (
            <div class="author-card">
              {author.photoUrl ? (
                <img src={author.photoUrl} alt="" width="44" height="44" />
              ) : (
                <span class="author-placeholder"><i class="ph ph-user" aria-hidden="true"></i></span>
              )}
              <span><small>Written by</small><strong>{author.name}</strong></span>
            </div>
          )}
        </div>
        {responsiveCover.src && (
          <div class="cover-wrap" data-image-loading>
            <picture>
              {responsiveCover.avifSrcset && <source type="image/avif" srcset={responsiveCover.avifSrcset} sizes="(max-width: 900px) calc(100vw - 40px), 48vw" />}
              <img
                class="cover"
                src={responsiveCover.src}
                srcset={responsiveCover.srcset || undefined}
                sizes="(max-width: 900px) calc(100vw - 40px), 48vw"
                alt={coverAlt}
                width={responsiveCover.width}
                height={responsiveCover.height}
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
        )}
      </section>

      <div class="article-layout">
        <div class="article-reading">
          {renderedArticle.headingCount >= 4 && <ArticleTableOfContents items={tocItems} />}
          <article class="article-content" set:html={articleHtml} />

          <section class="article-quote-cta" aria-labelledby="article-quote-title">
            <div>
              <p class="article-quote-cta__eyebrow">Selling a car in the UAE?</p>
              <h2 id="article-quote-title">Get a fair quote for your car today.</h2>
              <p>Tell us about your vehicle and get a straightforward offer from Scrap My Car UAE.</p>
            </div>
            <a href="/free-quote" data-analytics-quote-cta="blog_article">Get free quote <span aria-hidden="true">→</span></a>
          </section>
          <div class="article-share">
            <SharePostMenu url={absoluteCanonical} title={postTitle} />
          </div>
        </div>

        <aside class="article-sidebar" aria-label="Article tools and latest blogs">
          <section class="blog-sidebar-form" aria-label="Get your car price">
            {canRenderSidebarForm ? (
              <QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} variant="blog-sidebar" />
            ) : (
              <div class="blog-sidebar-form__fallback">
                <h2>Get your car price</h2>
                <p>Start your free valuation in a few simple steps.</p>
                <a href="/free-quote" data-analytics-quote-cta="blog_sidebar_fallback">Get My Free Valuation <span aria-hidden="true">→</span></a>
              </div>
            )}
          </section>
          <LatestBlogsSidebar posts={latestPosts} />
        </aside>

        {renderableRelatedPosts.length > 0 && (
          <section class="related-articles" aria-labelledby="related-articles-title">
            <div class="related-articles__heading">
              <p>More to explore</p>
              <h2 id="related-articles-title">Related reading</h2>
            </div>
            <ul class="related-articles__links">
              {renderableRelatedPosts.map((relatedPost) => <li><a href={`/post/${asSafeText(relatedPost.slug)}`}>{asSafeText(relatedPost.title)}</a></li>)}
            </ul>
          </section>
        )}
      </div>

    </main>
  ) : (
    <main class="not-found">
      <h1>Article not found</h1>
      <p>The article may have been moved or is no longer available.</p>
      <p><a href="/blogs">Return to the blogs</a></p>
      {import.meta.env.DEV && loadError && <pre>{loadError}</pre>}
    </main>
  )}
</BaseLayout>

<style>
      .article-shell {
        width: min(860px, calc(100% - 48px));
        margin: 0 auto;
        padding: 44px 0 80px;
      }

      .eyebrow {
        color: #497d39;
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      h1 {
        max-width: 820px;
        margin: 9px 0 16px;
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        line-height: 1.08;
        letter-spacing: -0.04em;
      }

      .meta {
        color: #6a6a6a;
        display: flex;
        flex-wrap: wrap;
        gap: 6px 0;
        font-size: 14px;
      }
      .meta span { display: inline-flex; align-items: center; white-space: nowrap; }
      .meta span + span::before { content: '•'; margin-inline: 9px; color: #9aa09a; }

      .article-meta-row {
        margin-bottom: 28px;
      }

      .author {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        min-height: 36px;
        margin-bottom: 7px;
        color: #4e554e;
        font-size: 13px;
        font-weight: 700;
      }

      .author img,
      .author-placeholder {
        width: 36px;
        height: 36px;
        flex: 0 0 auto;
        border-radius: 50%;
      }

      .author img { object-fit: cover; }
      .author-placeholder {
        display: grid;
        place-items: center;
        background: #dfe2de;
        color: #fff;
        font-size: 20px;
      }

      .cover-wrap {
        aspect-ratio: 16 / 9;
        margin: 0 0 38px;
        border-radius: var(--smc-radius);
      }

      .cover {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 18px;
        transition: opacity 300ms ease, filter 300ms ease;
      }

      .article-content {
        max-width: 760px;
        margin: 0 auto;
        font-size: 18px;
      }

      .article-content :global(p) {
        margin: 0 0 1.35em;
      }

      .article-content :global(h2),
      .article-content :global(h3),
      .article-content :global(h4) {
        line-height: 1.2;
        letter-spacing: -0.025em;
        margin: 2em 0 0.7em;
      }

      .article-content :global(h2) { font-size: 34px; }
      .article-content :global(h3) { font-size: 27px; }

      .article-content :global(h2[id]),
      .article-content :global(h3[id]) {
        scroll-margin-top: 130px;
      }

      :global(html) { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) {
        :global(html) { scroll-behavior: auto; }
      }

      .article-content :global(a) {
        color: #356d29;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      .article-content :global(ul),
      .article-content :global(ol) {
        padding-left: 1.4em;
        margin: 0 0 1.5em;
      }

      .article-content :global(li) {
        margin: 0.45em 0;
      }

      .article-content :global(figure) {
        margin: 2.1em 0;
      }

      .article-content :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin-inline: auto;
        border-radius: 12px;
      }

      .article-content :global(blockquote) {
        margin: 2em 0;
        padding: 0.3em 0 0.3em 1.2em;
        border-left: 4px solid #4c7e3a;
        color: #444;
      }

      .article-content :global(hr) {
        border: 0;
        border-top: 1px solid #ddd;
        margin: 2.5em 0;
      }

      .article-content :global(.table-scroll) {
        overflow-x: auto;
        margin: 2em 0;
      }

      .article-content :global(table) {
        border-collapse: collapse;
        width: 100%;
        min-width: 560px;
      }

      .article-content :global(td) {
        border: 1px solid #d8d8d8;
        padding: 12px 14px;
        vertical-align: top;
      }

      .article-quote-cta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
        max-width: 760px;
        margin: 58px auto;
        padding: 28px 30px;
        border: 1px solid #cde0ca;
        border-radius: 18px;
        background: linear-gradient(120deg, #f2f9ed, #fff);
      }

      .article-quote-cta__eyebrow,
      .related-articles__heading p {
        margin: 0 0 6px;
        color: #27683a;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .article-quote-cta h2 {
        margin: 0;
        color: #17331d;
        font-size: clamp(1.35rem, 3vw, 1.75rem);
        line-height: 1.18;
      }

      .article-quote-cta p:not(.article-quote-cta__eyebrow) {
        max-width: 540px;
        margin: 8px 0 0;
        color: #415046;
      }

      .article-quote-cta a {
        flex: 0 0 auto;
        padding: 12px 17px;
        border-radius: 10px;
        background: #1c5a2b;
        color: #fff;
        font-weight: 800;
        text-decoration: none;
      }

      .article-quote-cta a:hover { background: #123e1e; }
      .article-quote-cta a:focus-visible,
      .article-share :global(button:focus-visible) {
        outline: 3px solid #1b6e35;
        outline-offset: 3px;
      }

      .related-articles {
        margin: 0 auto 46px;
        padding-top: 46px;
        border-top: 1px solid #dce6dc;
      }

      .related-articles__heading { margin-bottom: 22px; }
      .related-articles__heading h2 {
        margin: 0;
        color: #152018;
        font-size: clamp(1.75rem, 4vw, 2.35rem);
        letter-spacing: -0.035em;
      }

      .related-articles__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .article-share {
        display: flex;
        justify-content: flex-end;
        padding-top: 22px;
        border-top: 1px solid #dce6dc;
      }

      .not-found {
        width: min(720px, calc(100% - 36px));
        margin: 100px auto;
        text-align: center;
      }

      .not-found a {
        color: #356d29;
        font-weight: 700;
      }

      @media (max-width: 640px) {
        .article-shell {
          padding-top: 34px;
        }

        h1 {
          font-size: 38px;
        }

        .article-content {
          font-size: 17px;
        }

        .article-content :global(h2) {
          font-size: 29px;
        }

        .article-quote-cta {
          align-items: flex-start;
          flex-direction: column;
          margin: 42px auto;
          padding: 24px;
        }

        .related-articles { padding-top: 38px; }
        .related-articles__grid { grid-template-columns: 1fr; gap: 16px; }

      }

      /* Editorial refinements shared by the article header and reading flow. */
      .cover { border-radius: var(--smc-radius); }
      .article-content { line-height: 1.72; }
      .article-content :global(h2),
      .article-content :global(h3),
      .article-content :global(h4) {
        line-height: 1.17;
        margin-top: 2.35em;
        margin-bottom: .65em;
      }
      @media (max-width: 640px) {
        .article-shell { width: min(100% - 40px, 860px); }
        .meta { font-size: 13px; }
        .article-content { font-size: 17px; line-height: 1.72; }
      }

      /* Article editorial layout. All Wix loading and safety logic stays above this presentation layer. */
      .article-shell {
        width: min(1240px, calc(100% - 48px));
        padding: 38px 0 84px;
      }

      .article-opening {
        display: grid;
        grid-template-columns: minmax(0, 1.06fr) minmax(0, .94fr);
        gap: clamp(28px, 5vw, 64px);
        align-items: center;
        margin-bottom: clamp(48px, 7vw, 78px);
      }

      .article-opening__copy h1 {
        max-width: none;
        margin: 10px 0 18px;
        color: #172219;
        font-size: clamp(2.5rem, 5vw, 4rem);
        line-height: 1.04;
      }

      .article-opening__excerpt {
        max-width: 38rem;
        margin: 0 0 20px;
        color: #4c584e;
        font-size: clamp(1rem, 1.5vw, 1.15rem);
        line-height: 1.62;
      }

      .article-opening__details { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-bottom: 18px; }
      .article-opening__details p { margin: 0; font-size: .9rem; font-weight: 750; }
      .article-opening__updated { color: #5DB938; }
      .article-opening__read-time { color: #697369; }

      .author-card {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        min-height: 64px;
        padding: 10px 15px 10px 10px;
        border-radius: 16px;
        background: #f3f5f1;
        color: #1c281e;
      }
      .author-card img, .author-card .author-placeholder { width: 44px; height: 44px; border-radius: 50%; }
      .author-card img { object-fit: cover; }
      .author-card .author-placeholder { display: grid; place-items: center; background: #d7ddd4; color: #fff; font-size: 22px; }
      .author-card span { display: grid; gap: 2px; }
      .author-card small { color: #6a756c; font-size: .72rem; font-weight: 700; }
      .author-card strong { font-size: .9rem; }

      .cover-wrap { margin: 0; aspect-ratio: 4 / 3; border-radius: 24px; overflow: hidden; background: #edf2ea; }
      .cover { border-radius: 24px; }

      .article-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        grid-template-areas: 'content sidebar' 'related sidebar';
        gap: 40px;
        align-items: start;
      }
      .article-reading { grid-area: content; min-width: 0; }
      .article-sidebar { grid-area: sidebar; display: grid; gap: 24px; align-self: start; min-width: 0; }
      .blog-sidebar-form { min-width: 0; }

      .article-reading :global(.article-toc) { max-width: none; margin: 0 0 36px; }
      .article-content { max-width: 760px; margin: 0; font-size: clamp(1.0625rem, 1.3vw, 1.125rem); line-height: 1.76; }
      .article-content :global(h2) { font-size: clamp(1.9rem, 3.2vw, 2.35rem); }
      .article-content :global(h3) { font-size: clamp(1.45rem, 2.5vw, 1.75rem); }
      .article-content :global(h2), .article-content :global(h3), .article-content :global(h4) { margin-top: 2.5em; margin-bottom: .72em; }
      .article-content :global(li::marker) {
        color: #5DB938;
      }

      .blog-sidebar-form__fallback { padding: 22px; border-radius: 20px; background: #184D2B; box-shadow: 0 10px 24px rgba(15, 52, 29, .18); }
      .blog-sidebar-form__fallback h2 { margin: 0 0 6px; color: #fff; font-size: 1.55rem; }
      .blog-sidebar-form__fallback p { margin: 0 0 18px; color: #d8eadb; line-height: 1.5; }
      .blog-sidebar-form__fallback a { display: inline-flex; min-height: 48px; align-items: center; padding: 0 16px; border-radius: 12px; background: #d9efc9; color: #143b22; font-weight: 800; text-decoration: none; }

      .article-quote-cta { max-width: 760px; margin: 56px 0; }
      .related-articles { grid-area: related; max-width: 760px; margin: 0 0 36px; padding-top: 34px; }
      .related-articles__links { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
      .related-articles__links a { color: #1b5d2c; font-weight: 750; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      .related-articles__links a:hover { color: #153f1c; }
      .article-share { max-width: 760px; }

      @media (max-width: 980px) {
        .article-layout { grid-template-columns: minmax(0, 1fr) 320px; gap: 30px; }
      }

      @media (max-width: 760px) {
        .article-shell { width: min(100% - 36px, 640px); padding-top: 24px; }
        .article-opening { grid-template-columns: 1fr; gap: 24px; margin-bottom: 30px; }
        .article-opening__copy { order: 1; }
        .article-opening__copy h1 { margin: 0 0 16px; font-size: clamp(2rem, 9.5vw, 2.65rem); line-height: 1.04; }
        .article-opening__excerpt { margin-bottom: 15px; font-size: 1rem; line-height: 1.52; }
        .article-opening__details { gap: 5px 14px; margin-bottom: 13px; }
        .article-opening__details p { font-size: .8rem; }
        .author-card { min-height: 54px; gap: 9px; padding: 7px 11px 7px 7px; border-radius: 13px; }
        .author-card img, .author-card .author-placeholder { width: 40px; height: 40px; }
        .author-card .author-placeholder { font-size: 19px; }
        .author-card small { font-size: .68rem; }
        .author-card strong { font-size: .84rem; }
        .cover-wrap { order: 2; aspect-ratio: 16 / 10; }
        .article-layout { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'content' 'sidebar' 'related'; gap: 30px; }
        .article-sidebar { gap: 24px; }
        .article-content { font-size: 17px; }
        .article-quote-cta { margin: 42px 0; }
        .related-articles { margin-bottom: 30px; }
      }

      @media (max-width: 420px) {
        .article-shell { width: min(100% - 36px, 640px); }
        .cover-wrap, .cover { border-radius: 20px; }
      }
    </style>
