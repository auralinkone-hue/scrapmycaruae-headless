---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import LocationCoverageList from '../components/LocationCoverageList.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import UaeCoverageMap from '../components/UaeCoverageMap.astro';
import { getLatestPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';

const title = 'Scrap My Car UAE | Free Valuation & Vehicle Collection';
const description = 'Scrap your car in the UAE with a free vehicle valuation. We consider damaged, non-running and end-of-life vehicles with collection available across the UAE.';

const conditionDetails = {
  accident: { title: 'Accident damage', text: 'A vehicle with significant impact, body or safety damage may be more practical to assess as-is before approving further repairs.', link: '/sell-accident-damaged-car/', label: 'Explore accident-damaged cars' },
  engine: { title: 'Engine failure', text: 'If the engine needs major work or will not start, share the symptoms and the current condition for a practical valuation discussion.', link: '/sell-car-with-engine-problems/', label: 'Explore engine-problem cars' },
  gearbox: { title: 'Gearbox failure', text: 'Transmission faults, severe drivability issues or a vehicle that cannot move are useful context when considering the next route.', link: '/sell-non-running-car/', label: 'Explore non-running cars' },
  flood: { title: 'Flood damage', text: 'Water damage can affect electrical systems, interiors and mechanical components. Explain what is known before arranging any next step.', link: '/sell-damaged-car/', label: 'Explore damaged cars' },
  nonrunning: { title: 'Non-running vehicle', text: 'A car that is parked, broken down or unable to start can still be assessed in its current condition.', link: '/sell-non-running-car/', label: 'Explore non-running cars' }
};

const selectorOptions = [
  { key: 'repair', label: 'Repair', icon: 'ph-wrench', title: 'Repair can make sense when the fault is known and controlled.', copy: 'A repair route may be worth considering where the fault is clearly diagnosed, the cost is proportionate and the rest of the car remains in good condition.', checks: ['The issue has a clear diagnosis', 'The repair cost is manageable', 'The vehicle is otherwise in good condition'], cta: 'Talk to the team', href: '/contact-us' },
  { key: 'sell', label: 'Sell', icon: 'ph-car-profile', title: 'Sell as-is when the car still has practical next-use value.', copy: "A valuation can help you compare the car's current condition with the time and cost of further work before deciding.", checks: ['The vehicle remains usable or repairable', 'You want a clear current-condition valuation', 'You would rather avoid arranging repairs'], cta: 'Get my free valuation', href: '/free-quote' },
  { key: 'scrap', label: 'Scrap', icon: 'ph-recycle', title: 'Scrap may be a sensible route for an end-of-life vehicle.', copy: 'For severely damaged, non-running or low-practical-value vehicles, share the details first so the most suitable next step can be discussed.', checks: ['Major faults or multiple problems', 'The vehicle is not practical to repair', 'Parts, salvage or recycling may be relevant'], cta: 'Request a scrap-car valuation', href: '/free-quote' }
];

const valueFactors = [
  ['Make, model & year', 'Vehicle identity and age help establish demand and parts relevance.'],
  ['Condition & mechanical state', 'Damage, faults and whether the vehicle starts or moves provide key context.'],
  ['Reusable parts & salvage demand', 'What remains serviceable can affect the practical discussion.'],
  ['Vehicle size & weight', 'These can matter where salvage handling or recovery is relevant.'],
  ['Collection access', 'Location, parking access and whether the vehicle can move should be shared.'],
  ['Documents & status', 'Registration, finance, fines or restrictions may need attention before the route is confirmed.']
];

const faqs = [
  ['Can I scrap a damaged or non-running car in the UAE?', 'You can request a free valuation for a damaged, non-running or end-of-life vehicle. Share the make, model, year, condition and location so the next step can be discussed.'],
  ['Do I need to repair my car before asking about scrapping it?', 'No. You can start with the vehicle in its current condition. A valuation helps you compare a repair route, selling as-is and a possible scrap route before spending more.'],
  ['What paperwork should I check before scrapping a car?', 'Keep the vehicle registration details available and check for finance, fines, restrictions and the current registration status. The precise requirements can depend on the emirate and the final transaction route.'],
  ['Can a vehicle be collected if it does not start?', 'Collection feasibility can be discussed for a non-running vehicle. Share its location, access details and whether it can be moved.'],
  ['Will I need to deal with number plates or registration cancellation?', 'These matters depend on the vehicle’s registration authority and the chosen route. In Dubai, RTA provides official services for registration cancellation and related vehicle documents; confirm the current requirements directly with the relevant authority.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
try { helpfulPosts = await getLatestPosts({}); } catch { helpfulPosts = []; }

const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Scrap My Car', item: 'https://www.scrapmycaruae.com/scrap-my-car/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/scrap-my-car/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="scrap-page">
    <section class="scrap-hero" aria-labelledby="scrap-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">></span><span aria-current="page">Scrap My Car</span></nav><div class="scrap-hero__grid"><div class="scrap-hero__copy"><p class="hero-kicker"><i class="ph ph-recycle" aria-hidden="true"></i> UAE vehicle next-step guidance</p><h1 id="scrap-title">Scrap your car <span>in the UAE.</span></h1><p class="hero-lead">Know your best next move. Start with a free valuation for a damaged, non-running or end-of-life vehicle before committing to repairs.</p></div><div class="scrap-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="hero-trust"><li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li><li><i class="ph ph-check" aria-hidden="true"></i>Current-condition discussion</li><li><i class="ph ph-check" aria-hidden="true"></i>UAE collection guidance</li></ul></div></div></section>

    <section class="section vehicle-assessment" style="--section-index:'02'" aria-labelledby="assessment-title">
      <div class="smc-container">
        <div class="section-heading vehicle-assessment__heading">
          <p class="section-label">Vehicle condition guide</p>
          <h2 id="assessment-title">What condition is your <span>vehicle in?</span></h2>
          <p>Use the guide below to describe what you know. A technical diagnosis is not needed before asking about your practical next step.</p>
        </div>
        <div class="vehicle-assessment__layout">
          <div class="vehicle-assessment__details">
            <details open><summary><span><i class="ph ph-car-profile" aria-hidden="true"></i>Accident damage</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Body, panel, safety or impact damage can help shape whether an as-is sale or scrap route is worth discussing.</p></details>
            <details><summary><span><i class="ph ph-engine" aria-hidden="true"></i>Engine failure</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Overheating, warning lights, loss of power or an engine that will not start are useful details to share.</p></details>
            <details><summary><span><i class="ph ph-gear" aria-hidden="true"></i>Gearbox failure</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Transmission faults or a vehicle that cannot move can affect the practical route and collection discussion.</p></details>
            <details><summary><span><i class="ph ph-drop" aria-hidden="true"></i>Flood damage</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>Water damage may affect electrical systems, interiors and mechanical parts, so share what is known about the vehicle.</p></details>
            <details><summary><span><i class="ph ph-warning-circle" aria-hidden="true"></i>Non-running vehicle</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>A vehicle that is parked, broken down or unable to start can still be assessed in its current condition.</p></details>
            <div class="vehicle-assessment__action"><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div>
          </div>
          <figure class="vehicle-assessment__visual">
            <div class="vehicle-assessment__halo" aria-hidden="true"></div>
            <img src="/sections/vehicle-damage-assessment.webp" alt="Vehicle condition guide showing accident damage, engine failure, gearbox failure, flood damage and non-running conditions" width="1664" height="936" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="scrap-pickup" style="--section-index:'03'" aria-labelledby="pickup-title"><div class="smc-container scrap-pickup__layout"><div class="scrap-pickup__copy"><p class="section-label">From unwanted car to a clear next step</p><h2 id="pickup-title">Ready to move on from a <span>damaged car?</span></h2><p>Start with the vehicle exactly as it is. Share its condition, location and available details, then discuss whether a scrap route is the practical next move.</p><ul class="scrap-pickup__checks"><li><i class="ph ph-check" aria-hidden="true"></i>Damaged, non-running and end-of-life cars considered</li><li><i class="ph ph-check" aria-hidden="true"></i>Collection access and location reviewed with your request</li><li><i class="ph ph-check" aria-hidden="true"></i>Clear guidance before you spend more on repairs</li></ul><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div><figure class="scrap-pickup__visual"><div class="scrap-pickup__halo" aria-hidden="true"></div><img src="/sections/scrap-car-pickup-dubai.webp" alt="Damaged car being collected on a green recovery truck in Dubai" width="1456" height="1088" loading="eager" decoding="async" /><figcaption><i class="ph ph-truck" aria-hidden="true"></i> Collection can be discussed around the vehicle's condition and access.</figcaption></figure></div></section>

    <section class="section route-selector" style="--section-index:'01'" aria-labelledby="route-title"><div class="smc-container"><div class="section-heading section-heading--left"><p class="section-label">Make the right call first</p><h2 id="route-title">Repair, sell or <span>scrap?</span></h2><p>There is no one-size-fits-all route. Compare the practical signals before you decide what to do with the vehicle.</p></div><div class="route-selector__panel"><div class="route-selector__tabs" role="tablist" aria-label="Choose a vehicle route">{selectorOptions.map((option, index) => <button class:list={['route-tab', { active: index === 2 }]} type="button" role="tab" aria-selected={index === 2 ? 'true' : 'false'} aria-controls={`route-${option.key}`} id={`tab-${option.key}`} data-route-tab={option.key}><i class:list={['ph', option.icon]} aria-hidden="true"></i>{option.label}</button>)}</div>{selectorOptions.map((option, index) => <section class:list={['route-selector__content', { active: index === 2 }]} role="tabpanel" tabindex="0" id={`route-${option.key}`} aria-labelledby={`tab-${option.key}`} hidden={index !== 2} data-route-panel={option.key}><div class="route-selector__mark"><i class:list={['ph', option.icon]} aria-hidden="true"></i></div><div><h3>{option.title}</h3><p>{option.copy}</p></div><ul>{option.checks.map((check) => <li><i class="ph ph-check" aria-hidden="true"></i>{check}</li>)}</ul><SectionActionButton href={option.href} label={option.cta} intent="valuation" /></section>)}</div></div></section>

    <section class="section condition-explorer" aria-labelledby="condition-title"><div class="smc-container condition-explorer__layout"><div class="condition-explorer__intro"><p class="section-label">Start with what you can see</p><h2 id="condition-title">Explore the vehicle's <span>condition.</span></h2><p>Select a condition point to see how it can shape a practical repair, sell or scrap conversation. You do not need a technical diagnosis to begin.</p><a class="info-link" href="/sell-my-car/">Prefer to sell a running car? <span aria-hidden="true"></span></a></div><div class="condition-explorer__graphic"><div class="car-stage"><svg viewBox="0 0 680 330" role="img" aria-label="Generic vehicle illustration with selectable condition hotspots"><path class="car-shadow" d="M142 279c73-33 313-39 425-1-72 27-350 30-425 1z"/><path class="car-body" d="M110 224l27-69c8-22 29-35 53-35h222c22 0 43 13 54 33l38 70v38H110z"/><path class="car-glass" d="M196 131h190c18 0 31 10 40 28l18 43H169l17-43c3-11 7-21 10-28z"/><path class="car-line" d="M110 224h394M169 202h275"/><path class="car-bumper" d="M99 247h417c11 0 19 8 19 19v10H80v-11c0-10 8-18 19-18z"/><circle class="car-wheel" cx="181" cy="275" r="42"/><circle class="car-wheel" cx="449" cy="275" r="42"/><circle class="wheel-core" cx="181" cy="275" r="17"/><circle class="wheel-core" cx="449" cy="275" r="17"/></svg><button class="hotspot hotspot--accident" type="button" data-condition="accident" aria-pressed="false"><span>1</span><b>Accident damage</b></button><button class="hotspot hotspot--engine" type="button" data-condition="engine" aria-pressed="false"><span>2</span><b>Engine failure</b></button><button class="hotspot hotspot--gearbox" type="button" data-condition="gearbox" aria-pressed="false"><span>3</span><b>Gearbox failure</b></button><button class="hotspot hotspot--flood" type="button" data-condition="flood" aria-pressed="false"><span>4</span><b>Flood damage</b></button><button class="hotspot hotspot--nonrunning active" type="button" data-condition="nonrunning" aria-pressed="true"><span>5</span><b>Non-running</b></button></div><div class="condition-answer" aria-live="polite">{Object.entries(conditionDetails).map(([key, detail]) => <div class:list={{ active: key === 'nonrunning' }} hidden={key !== 'nonrunning'} data-condition-panel={key}><p class="condition-answer__label">Selected condition</p><h3>{detail.title}</h3><p>{detail.text}</p><a href={detail.link}>{detail.label} <span aria-hidden="true"></span></a></div>)}</div></div></div></section>

    <section class="lifecycle" style="--section-index:'04'" aria-labelledby="lifecycle-title"><div class="smc-container"><div class="lifecycle__heading"><p class="section-label">After the decision</p><h2 id="lifecycle-title">A clear route from vehicle details <span>to next use.</span></h2></div><ol class="lifecycle__journey"><li><span class="journey-icon"><i class="ph ph-car-profile" aria-hidden="true"></i></span><div><b>Vehicle details</b><small>Condition, documents and location</small></div></li><li><span class="journey-icon"><i class="ph ph-calculator" aria-hidden="true"></i></span><div><b>Valuation</b><small>Discuss the car as it is</small></div></li><li><span class="journey-icon"><i class="ph ph-signpost" aria-hidden="true"></i></span><div><b>Decide route</b><small>Repair, sell or scrap</small></div></li><li><span class="journey-icon"><i class="ph ph-truck" aria-hidden="true"></i></span><div><b>Collection</b><small>Access and location reviewed</small></div></li><li><span class="journey-icon"><i class="ph ph-recycle" aria-hidden="true"></i></span><div><b>Next use</b><small>Reuse, salvage, dismantling or recycling as appropriate</small></div></li></ol></div></section>

    <section class="scrap-aftercare" style="--section-index:'05'" aria-labelledby="aftercare-title"><div class="smc-container scrap-aftercare__layout"><div class="scrap-aftercare__copy"><p class="section-label">After a scrap route is agreed</p><h2 id="aftercare-title">What happens after you scrap your car with <span>Scrap My Car UAE?</span></h2><p>Once the vehicle details and a practical route have been discussed, collection timing, access and the current condition can be reviewed with you. The next step is kept clear before anything is arranged.</p><ul class="scrap-aftercare__checks"><li><i class="ph ph-check" aria-hidden="true"></i><span><b>Collection is discussed around the vehicle</b>Location, keys, access and whether the car can move are reviewed first.</span></li><li><i class="ph ph-check" aria-hidden="true"></i><span><b>Condition is checked in context</b>Damage, usable parts and the vehicle's practical next route are considered.</span></li><li><i class="ph ph-check" aria-hidden="true"></i><span><b>Paperwork comes with clear guidance</b>Registration and authority requirements depend on the emirate and final route.</span></li></ul><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div><figure class="scrap-aftercare__visual"><div class="scrap-aftercare__halo" aria-hidden="true"></div><img src="/sections/dubai-salvage-yard-inspection.webp" alt="Damaged vehicle on a recovery truck at a Dubai salvage and recycling yard" width="1456" height="1088" loading="lazy" decoding="async" /><figcaption><i class="ph ph-recycle" aria-hidden="true"></i> Reuse, salvage, dismantling or recycling can be discussed as appropriate.</figcaption></figure></div></section>

    <section class="section value-section" style="--section-index:'06'" aria-labelledby="value-title"><div class="smc-container value-section__layout"><div class="value-section__copy"><p class="section-label">A practical review, not an instant price</p><h2 id="value-title">What can affect a <span>scrap-car valuation?</span></h2><p>There are no fixed online price bands. The useful starting point is an honest picture of the vehicle, its condition, documents and collection requirements.</p><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div><div class="value-rules">{valueFactors.map(([title, text], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section>

    <section class="section paperwork" style="--section-index:'07'" aria-labelledby="paperwork-title"><div class="smc-container paperwork__layout"><div><p class="section-label">Check before the next step</p><h2 id="paperwork-title">UAE paperwork & <span>vehicle status.</span></h2><p>Keep the vehicle information to hand and verify the requirements that apply to your emirate and final route. The team can discuss practical details, but official authorities confirm the transaction requirements.</p></div><div class="paperwork__guide"><article><i class="ph ph-identification-card" aria-hidden="true"></i><div><h3>Mulkiya & registration status</h3><p>Have the registration details available. If a registration change or cancellation is needed, use the relevant authority's current service guidance.</p></div></article><article><i class="ph ph-bank" aria-hidden="true"></i><div><h3>Finance, fines & restrictions</h3><p>Check whether outstanding finance, traffic fines or other restrictions need resolving before a transaction can proceed.</p></div></article><article><i class="ph ph-file-text" aria-hidden="true"></i><div><h3>Possession Certificate & plates</h3><p>Where applicable, confirm the right document and plate handling for the registration authority and chosen route.</p></div></article><div class="paperwork__official"><i class="ph ph-info" aria-hidden="true"></i><p>For Dubai-registered vehicles, review the official <a href="https://www.rta.ae/wps/portal/rta/ae/home/rta-services/service-details?serviceId=525" target="_blank" rel="noopener noreferrer">RTA registration cancellation service</a>, <a href="https://rta.ae/wps/portal/rta/ae/home/rta-services/service-details?serviceId=528" target="_blank" rel="noopener noreferrer">Possession Certificate service</a> and <a href="https://rta.ae/wps/portal/rta/ae/home/rta-services/service-details?serviceId=521" target="_blank" rel="noopener noreferrer">fines guidance</a> before acting.</p></div></div></div></section>

    <section class="section collection-section" style="--section-index:'08'" aria-labelledby="collection-title"><div class="smc-container"><div class="section-heading"><p class="section-label">Where the vehicle is matters</p><h2 id="collection-title">UAE collection, clearly <span>mapped.</span></h2><p>Share the exact location, access and whether the car starts or moves. This allows collection feasibility to be discussed with the vehicle's actual condition in mind.</p></div><div class="collection-section__grid"><UaeCoverageMap /><div class="collection-section__side"><h3>Collection starts with the details.</h3><p>Tell us where the car is parked, whether keys and documents are available, and whether recovery access is straightforward.</p><ul><li><i class="ph ph-check" aria-hidden="true"></i>Dubai and Abu Dhabi coverage</li><li><i class="ph ph-check" aria-hidden="true"></i>Other emirates reviewed with the request</li><li><i class="ph ph-check" aria-hidden="true"></i>Non-running vehicle access can be discussed</li></ul><SectionActionButton href="/free-quote" label="Request a collection discussion" intent="valuation" /></div></div><LocationCoverageList /></div></section>

    {helpfulPosts.length > 0 && <section class="section section--soft guides" aria-labelledby="guides-title"><div class="smc-container"><div class="section-heading"><h2 id="guides-title">Guides for your <span>next move.</span></h2><p>Read relevant existing Wix guides before requesting a valuation.</p></div><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div><div class="section-cta"><SectionActionButton href="/blogs" label="View all blogs" intent="blogs" /></div></div></section>}

    <section class="section scrap-faq" aria-labelledby="faq-title"><div class="smc-container"><div class="section-heading"><h2 id="faq-title">Scrap-car FAQs</h2><p>Direct answers for people deciding what to do with a damaged, non-running or end-of-life vehicle.</p></div><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><div class="section-cta"><SectionActionButton href="/faqs" label="Browse all FAQs" intent="faqs" /></div></div></section>
    <section class="final-scrap-cta"><div class="smc-container final-scrap-cta__inner"><div><p class="section-label">Start with the vehicle as it is</p><h2>Get a valuation before you decide.</h2><p>Share the vehicle details, condition and location. We will help you discuss the practical next move.</p></div><a class="smc-button" href="/free-quote" data-analytics-quote-cta="scrap_my_car_final">Get my free valuation <i class="ph ph-calculator" aria-hidden="true"></i></a></div></section>
  </main>
  <script>
    const initialiseScrapInteractions = () => {
      document.querySelectorAll<HTMLElement>('.scrap-page').forEach((page) => {
        if (page.dataset.interactionsReady) return;
        page.dataset.interactionsReady = 'true';
        const activateRoute = (key: string) => {
          page.querySelectorAll<HTMLElement>('[data-route-tab]').forEach((tab) => { const active = tab.dataset.routeTab === key; tab.classList.toggle('active', active); tab.setAttribute('aria-selected', String(active)); });
          page.querySelectorAll<HTMLElement>('[data-route-panel]').forEach((panel) => { const active = panel.dataset.routePanel === key; panel.classList.toggle('active', active); panel.hidden = !active; });
        };
        page.querySelectorAll<HTMLButtonElement>('[data-route-tab]').forEach((tab) => { tab.addEventListener('click', () => activateRoute(tab.dataset.routeTab || 'scrap')); tab.addEventListener('keydown', (event) => { if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return; event.preventDefault(); const tabs = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-route-tab]')); const next = (tabs.indexOf(tab) + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length; tabs[next].focus(); activateRoute(tabs[next].dataset.routeTab || 'scrap'); }); });
        const activateCondition = (key: string) => { page.querySelectorAll<HTMLButtonElement>('[data-condition]').forEach((button) => { const active = button.dataset.condition === key; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); }); page.querySelectorAll<HTMLElement>('[data-condition-panel]').forEach((panel) => { const active = panel.dataset.conditionPanel === key; panel.classList.toggle('active', active); panel.hidden = !active; }); };
        page.querySelectorAll<HTMLButtonElement>('[data-condition]').forEach((button) => button.addEventListener('click', () => activateCondition(button.dataset.condition || 'nonrunning')));
      });
    };
    initialiseScrapInteractions();
    document.addEventListener('astro:page-load', initialiseScrapInteractions);
  </script>
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const animatedSections = Array.from(document.querySelectorAll('.scrap-page > section:not(.scrap-hero)'));
  if (!reducedMotion && 'IntersectionObserver' in window) {
    animatedSections.forEach((section) => section.classList.add('scrap-reveal'));
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          currentObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -44px' });
    animatedSections.forEach((section) => observer.observe(section));
  }
</script>

<style>
