  .vehicle-assessment__details details{padding:0 17px;transition:background-color 180ms ease,transform 180ms ease}
  .vehicle-assessment__details details[open]{background:linear-gradient(90deg,rgba(231,244,229,.78),rgba(255,255,255,.15))}
  .vehicle-assessment__details details:first-child{border-radius:18px 18px 0 0}
  .vehicle-assessment__details details:nth-last-child(2){border-radius:0 0 18px 18px}
  .vehicle-assessment__action{padding-left:17px}
  .vehicle-assessment__visual{overflow:visible}
