---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import LocationCoverageList from '../components/LocationCoverageList.astro';
import MakeLogoRail from '../components/MakeLogoRail.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import { getLatestPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';

const title = 'Sell Accident Damaged Car UAE | Free Valuation';
const description = 'Sell an accident-damaged car in the UAE with a free valuation. Share the vehicle details before spending more on repairs or arranging collection.';

const damageExamples = [
  ['ph-arrows-left-right', 'Front or rear impact', 'Describe the affected area and any obvious collision damage.'],
  ['ph-car-profile', 'Panel & body damage', 'Dents, damaged doors, wings or body panels can be reviewed as they are.'],
  ['ph-lightbulb', 'Damaged lights or bumper', 'Include broken lamps, bumper damage and other visible parts.'],
  ['ph-wheelchair', 'Suspension or wheel damage', 'Let the team know if steering, wheels or suspension are affected.'],
  ['ph-power', 'Non-running after an accident', 'The vehicle does not need to start before you request a valuation.'],
  ['ph-wrench', 'Further mechanical damage', 'Share any known issue that followed the accident or repair attempt.']
];

const factors = [
  ['ph-warning-octagon', 'Extent of accident damage', 'The affected panels, safety systems and visible condition all provide useful context.'],
  ['ph-car-profile', 'Make, model & year', 'Vehicle details help establish the car and current demand.'],
  ['ph-wrench', 'Running & mechanical condition', 'Known engine, wheel, suspension or electrical issues matter to the review.'],
  ['ph-map-pin', 'Location & collection access', 'Location and whether the vehicle can move help plan a practical collection discussion.']
];

const faqs = [
  ['Can I sell an accident-damaged car in the UAE?', 'Yes. Send the make, model and year with a clear description of the accident damage. The team can review the vehicle as it is and discuss a free valuation.'],
  ['Should I repair accident damage before selling?', 'Not necessarily. Compare the likely repair cost with a valuation for the vehicle in its current condition before committing to further work.'],
  ['Can you value a car that is not running after an accident?', 'Yes. A vehicle does not need to start before you send its details. Explain what happened and any known mechanical or wheel damage.'],
  ['What accident damage should I mention?', 'Mention impact location, damaged panels, lights, bumper, wheels, suspension and any warning signs you know about. Clear information helps the team assess the request.'],
  ['Is collection available for accident-damaged vehicles?', 'Collection can be discussed across supported UAE locations. The team confirms what is practical after reviewing the condition, location and vehicle access.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
try { helpfulPosts = await getLatestPosts({}); } catch { helpfulPosts = []; }
const preferredMakes = ['TOYOTA', 'NISSAN', 'MERCEDES-BENZ', 'BMW', 'HONDA', 'LEXUS', 'MITSUBISHI', 'HYUNDAI'];
const makeLookup = new Map(vehicleData.makes.map((item) => [item.make.toUpperCase(), item.make]));
const selectedMakes = preferredMakes.map((make) => makeLookup.get(make)).filter(Boolean) as string[];

const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Sell Accident-Damaged Car', item: 'https://www.scrapmycaruae.com/sell-accident-damaged-car/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/sell-accident-damaged-car/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="accident-page">
    <section class="accident-hero" aria-labelledby="accident-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/sell-my-car/">Sell My Car</a><span aria-hidden="true">›</span><span aria-current="page">Accident-damaged car</span></nav><div class="accident-hero__grid"><div class="accident-hero__copy"><h1 id="accident-title">Sell <span class="accident-word">accident-damaged</span> cars.<span class="valuation-message">Get a valuation.</span></h1><p>Share the car's make, model and year, then explain the damage before spending more on repairs.</p></div><div class="accident-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="trust-points" aria-label="Accident-damaged valuation benefits"><li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li><li><i class="ph ph-check" aria-hidden="true"></i>Accident damage considered as-is</li><li><i class="ph ph-check" aria-hidden="true"></i>UAE collection discussion</li></ul></div></div></section>

    <section class="section damage-section" aria-labelledby="damage-title"><div class="smc-container"><div class="section-heading"><h2 id="damage-title">Accident damage <span class="heading-accent">we consider.</span></h2><p>Accurate details are more useful than a repaired-looking story. Tell the team what is visible and what changed after the accident.</p></div><div class="damage-grid">{damageExamples.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><h3>{heading}</h3><p>{copy}</p></article>)}</div><div class="section-cta"><SectionActionButton href="/free-quote" label="Request a damaged car valuation" intent="valuation" /></div></div></section>

    <section class="section popular-makes" aria-labelledby="makes-title"><div class="smc-container"><div class="section-heading"><h2 id="makes-title">Popular makes we <span class="heading-accent">consider.</span></h2><p>Start with the vehicle’s make, model and year, even when accident damage has changed the car’s condition.</p></div><MakeLogoRail makes={selectedMakes} /></div></section>

    <section class="section repair-section" aria-labelledby="repair-title"><div class="smc-container repair-grid"><div class="repair-panel"><i class="ph ph-scales" aria-hidden="true"></i><h2 id="repair-title">Repair it or sell it <span class="heading-accent">as-is?</span></h2><p>Before paying for more parts or labour, use a valuation to compare the likely repair spend with the practical value of the vehicle today.</p><div class="repair-panel__actions"><SectionActionButton href="/free-quote" label="Compare before repairing" intent="valuation" /><SectionActionButton href="/sell-damaged-car/" label="Sell a damaged car" intent="process" /></div></div><div class="check-list"><div><i class="ph ph-check" aria-hidden="true"></i><div><h3>Include the complete damage</h3><p>Think beyond the visible panel: lights, wheels, suspension and running condition may all matter.</p></div></div><div><i class="ph ph-check" aria-hidden="true"></i><div><h3>Price the repair realistically</h3><p>Factor in parts, labour, diagnostic work and the time needed to make the car roadworthy.</p></div></div><div><i class="ph ph-check" aria-hidden="true"></i><div><h3>Decide with useful context</h3><p>A valuation helps you choose whether to repair, retain or sell the accident-damaged car as it is.</p></div></div></div></div></section>

    <section class="section" aria-labelledby="factors-title"><div class="smc-container"><div class="section-heading"><h2 id="factors-title">What affects an accident-damaged <span class="heading-accent">car valuation?</span></h2><p>There is no fixed online price. These details help the team understand the individual vehicle and its condition.</p></div><div class="factor-list">{factors.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div><div class="section-cta"><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></div></section>

    <section class="section section--dark" aria-labelledby="process-title"><div class="smc-container"><div class="section-heading section-heading--dark"><h2 id="process-title">A simple path after an accident.</h2></div><ol class="process-grid"><li><i class="ph ph-car-profile process-grid__icon" aria-hidden="true"></i><h3>Send the vehicle details</h3><p>Choose the make, model and year, then send your contact details.</p></li><li><i class="ph ph-chat-text process-grid__icon" aria-hidden="true"></i><h3>Explain the accident damage</h3><p>Continue on WhatsApp with the impact area and any known damage.</p></li><li><i class="ph ph-handshake process-grid__icon" aria-hidden="true"></i><h3>Discuss valuation & collection</h3><p>The team can confirm the practical next step after reviewing the request.</p></li></ol></div></section>

    <section class="section collection" aria-labelledby="collection-title"><div class="smc-container"><div class="section-heading"><h2 id="collection-title">Accident-damaged vehicle collection <span class="heading-accent">across the UAE.</span></h2><p>Tell the team where the vehicle is and whether it can move. The reusable UAE coverage guide shows the locations considered for collection discussion.</p></div><LocationCoverageList /></div></section>

    {helpfulPosts.length > 0 && <section class="section section--soft guides" aria-labelledby="guides-title"><div class="smc-container"><div class="section-heading"><h2 id="guides-title">Useful guidance before <span class="heading-accent">your next decision.</span></h2><p>Explore relevant existing Wix blog guides, then request a valuation when you are ready.</p></div><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div><div class="section-cta"><SectionActionButton href="/blogs" label="View all blogs" intent="blogs" /></div></div></section>}

    <section class="section accident-faq" aria-labelledby="faq-title"><div class="smc-container"><div class="section-heading"><h2 id="faq-title">Accident-damaged car FAQs</h2><p>Quick answers about selling an accident-damaged vehicle in the UAE.</p></div><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><div class="section-cta"><SectionActionButton href="/faqs" label="Browse all FAQs" intent="faqs" /></div></div></section>
    <section class="final-valuation"><div class="smc-container final-valuation__inner"><div><h2>Get clarity before paying for another repair.</h2><p>Start with the vehicle details, then tell the team what happened to the car.</p></div><a class="smc-button" href="/free-quote" data-analytics-quote-cta="sell_accident_damaged_car_final">Get my free valuation <i class="ph ph-calculator" aria-hidden="true"></i></a></div></section>
  </main>
</BaseLayout>

<style>
  .accident-page{--accident-accent:#bd8420;--accident-soft:#fbf2df;overflow:hidden;color:#17331d}.accident-hero{padding:22px 0 clamp(52px,6vw,76px);border-bottom:1px solid #dce6d9;background:linear-gradient(180deg,#fcfdfb,#f8f5ed)}.breadcrumb{display:flex;flex-wrap:wrap;gap:8px;align-items:center;color:#687268;font-size:13px}.breadcrumb a{color:#315d37;text-decoration:none}.accident-hero__grid{display:grid;grid-template-areas:'copy form' 'trust form';grid-template-columns:minmax(0,1.16fr) minmax(400px,.74fr);column-gap:clamp(40px,5vw,68px);row-gap:20px;margin-top:28px}.accident-hero__copy{grid-area:copy;max-width:760px}.accident-hero h1{margin:0;font-size:clamp(3rem,3.8vw,4.25rem);line-height:1;letter-spacing:-.055em}.accident-hero h1 span{display:block;color:var(--accident-accent)}.accident-hero__copy p{margin:24px 0 0;color:#5c685d;font-size:18px;line-height:1.6}.accident-hero__form{grid-area:form;filter:drop-shadow(0 16px 28px rgba(31,70,36,.07))}.trust-points{grid-area:trust;display:grid;gap:9px;margin:0;padding:0;list-style:none}.trust-points li{display:flex;gap:9px;align-items:center;color:#2a472f;font-size:14px;font-weight:650}.trust-points i,.check-list>div>i{display:grid;width:22px;height:22px;place-items:center;border-radius:50%;background:#2f7d32;color:#fff;font-size:14px}.section{padding:clamp(52px,4.6vw,68px) 0}.section--soft{background:#f6f9f4}.section--dark{background:#173d18;color:#fff}.section-heading{max-width:760px;margin:0 auto 30px;text-align:center}.section-heading h2,.repair-panel h2,.final-valuation h2{margin:0;color:#17331d;font-size:clamp(2.1rem,4vw,3.3rem);line-height:1.06;letter-spacing:-.05em}.section-heading p{margin:15px auto 0;color:#5c685d;line-height:1.7}.heading-accent{color:var(--accident-accent)}.section-heading--dark h2{color:#fff}.damage-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.damage-grid article{min-height:192px;padding:23px;border:1px solid #dce6d9;border-radius:17px;background:#fff;transition:transform 160ms ease,border-color 160ms ease,box-shadow 160ms ease}.damage-grid article:hover{border-color:#ddbd7e;box-shadow:0 13px 24px rgba(113,75,12,.08);transform:translateY(-2px)}.damage-grid i,.factor-list i,.repair-panel>i{display:grid;width:40px;height:40px;place-items:center;border-radius:12px;background:var(--accident-soft);color:var(--accident-accent);font-size:20px}.damage-grid h3,.factor-list h3{margin:16px 0 7px;font-size:18px;letter-spacing:-.025em}.damage-grid p,.factor-list p{margin:0;color:#647064;font-size:14px;line-height:1.65}.section-cta{display:flex;justify-content:center;margin-top:26px}.popular-makes{background:#f8faf7}.repair-section{background:#f6f9f4}.repair-grid{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:clamp(32px,6vw,70px);align-items:center}.repair-panel{padding:clamp(26px,3.2vw,38px);border-radius:22px;background:#fff;box-shadow:0 15px 35px rgba(20,53,29,.06)}.repair-panel h2{margin-top:18px}.repair-panel p{margin:16px 0 22px;color:#5c685d;line-height:1.7}.repair-panel__actions{display:flex;flex-wrap:wrap;gap:10px}.check-list>div{display:grid;grid-template-columns:32px 1fr;gap:13px;padding:18px 0;border-top:1px solid #d6e2d4}.check-list>div:last-child{border-bottom:1px solid #d6e2d4}.check-list>div>i{width:28px;height:28px}.check-list h3{margin:2px 0 0;font-size:18px}.check-list p{margin:7px 0 0;color:#5c685d;font-size:14px;line-height:1.65}.factor-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));max-width:980px;margin:auto;border-top:1px solid #dce6d9}.factor-list article{display:grid;grid-template-columns:42px 1fr;gap:14px;padding:22px 28px;border-bottom:1px solid #dce6d9}.factor-list article:nth-child(odd){padding-left:0;border-right:1px solid #dce6d9}.factor-list article:nth-child(even){padding-right:0}.process-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:0;padding:0;list-style:none}.process-grid li{position:relative;min-height:210px;padding:25px 54px 24px 24px;border:1px solid rgba(208,232,201,.23);border-radius:18px;background:rgba(255,255,255,.055);transition:transform 160ms ease,background-color 160ms ease,border-color 160ms ease}.process-grid li:hover{border-color:rgba(240,194,100,.65);background:rgba(255,255,255,.09);transform:translateY(-3px)}.process-grid span{display:grid;width:32px;height:32px;place-items:center;border-radius:10px;background:rgba(240,194,100,.18);color:#f3c66a;font-size:11px;font-weight:800;letter-spacing:.06em}.process-grid h3{margin:17px 0 9px;font-size:22px;letter-spacing:-.035em}.process-grid p{margin:0;color:#c9d7c5;line-height:1.65}.process-grid__arrow{position:absolute;right:20px;bottom:22px;display:grid;width:32px;height:32px;place-items:center;border-radius:50%;background:#f1c462;color:#173d18;font-size:17px;transition:transform 160ms ease,background-color 160ms ease}.process-grid li:hover .process-grid__arrow{background:#fff;transform:translateX(4px)}.collection{background:#fff}.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.faq-stack{max-width:980px;margin:auto}.faq-stack details{border-bottom:1px solid #dce6d9}.faq-stack details:first-child{border-top:1px solid #dce6d9}.faq-stack summary{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:70px;padding:16px 0;list-style:none;cursor:pointer;font-size:17px;font-weight:700}.faq-stack summary::-webkit-details-marker{display:none}.faq-stack summary i{display:grid;width:28px;height:28px;place-items:center;border:1px solid #d7e3d4;border-radius:50%;color:#286633}.faq-stack details[open] summary i{transform:rotate(45deg)}.faq-stack details p{margin:-3px 0 22px;color:#5c685d;line-height:1.7}.final-valuation{padding:64px 0;background:#163d18;color:#fff}.final-valuation__inner{display:flex;align-items:center;justify-content:space-between;gap:34px}.final-valuation h2{color:#fff}.final-valuation p{margin:13px 0 0;color:#c9d7c5}.final-valuation .smc-button{flex:0 0 auto;min-height:50px;background:#fff;color:#174020}
  @media(max-width:980px){.accident-hero__grid{grid-template-areas:'copy' 'form' 'trust';grid-template-columns:1fr}.accident-hero__form{width:min(100%,650px)}.damage-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.repair-grid{grid-template-columns:1fr}.guide-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.factor-list{grid-template-columns:1fr}.factor-list article:nth-child(odd),.factor-list article:nth-child(even){padding-inline:0;border-right:0}}
  @media(max-width:700px){.accident-hero{padding-top:16px}.accident-hero__grid{gap:16px;margin-top:23px}.accident-hero__copy{text-align:center}.accident-hero h1{font-size:clamp(2.65rem,12vw,3.6rem);line-height:.96}.accident-hero__copy p{margin:14px auto 0;font-size:15px;line-height:1.5}.section{padding:clamp(50px,13vw,58px) 0}.section-heading{margin-bottom:25px}.section-heading h2,.repair-panel h2,.final-valuation h2{font-size:clamp(2rem,9vw,2.6rem)}.damage-grid,.guide-grid,.process-grid{grid-template-columns:1fr}.damage-grid article{min-height:0;padding:22px}.process-grid{gap:17px}.process-grid h3{font-size:21px}.final-valuation{padding:58px 0}.final-valuation__inner{flex-direction:column;align-items:flex-start}.final-valuation .smc-button{width:100%}}
  /* Accident is highlighted only in the hero; the service page otherwise uses the shared green system. */
  .accident-page{--accident-accent:#286633;--accident-soft:#edf6ed}
  .accident-hero{background:linear-gradient(180deg,#fcfdfb,#f8faf7)}
  .accident-hero__copy{max-width:620px}
  .accident-hero h1{font-size:clamp(2.55rem,2.8vw,3.25rem);line-height:1.04}
  .accident-hero h1 .accident-word{display:inline;color:#bd8420}
  .accident-hero h1 .valuation-message{display:block;color:#286633;white-space:nowrap}
  .damage-grid article:hover{border-color:#9abf9b;box-shadow:0 13px 24px rgba(42,102,51,.08)}
  .process-grid li{padding:25px 24px}
  .process-grid li:hover{border-color:rgba(156,205,151,.72)}
  .process-grid__icon{display:grid;width:46px;height:46px;place-items:center;border-radius:14px;background:rgba(138,196,134,.18);color:#bce3ae;font-size:24px;transition:transform 160ms ease,background-color 160ms ease}
  .process-grid li:hover .process-grid__icon{background:rgba(188,227,174,.28);transform:scale(1.06)}
  /* Shared sell-service hero rhythm: matches the homepage type and keeps the form close to the copy. */
  .accident-hero{padding-bottom:clamp(52px,6vw,76px)}
  .accident-hero__grid{column-gap:clamp(44px,6vw,84px);row-gap:20px;margin-top:28px}
  .accident-hero__copy{max-width:650px}
  .accident-hero h1{font-size:clamp(3rem,4.1vw,4.5rem);font-weight:700;line-height:1;letter-spacing:-.055em}
  .accident-hero__copy p{margin-top:22px}
  @media(max-width:700px){.accident-hero__grid{gap:16px;margin-top:23px}.accident-hero h1{font-size:clamp(2.65rem,12vw,3.6rem);line-height:.96;letter-spacing:-.045em}.accident-hero h1 .valuation-message{white-space:normal}.accident-hero__copy p{margin-top:14px}}
</style>
