---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogArticleCard from '../components/BlogArticleCard.astro';
import LocationCoverageList from '../components/LocationCoverageList.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionActionButton from '../components/SectionActionButton.astro';
import ServicePageMotion from '../components/ServicePageMotion.astro';
import { getLatestPosts } from '../lib/related-posts';
import { getVehicleData } from '../lib/vehicle-data';

const title = 'Sell Non Running Car UAE | Free Valuation & Collection';
const description = 'Sell a non-running or broken-down car in the UAE. Request a free valuation without repairing the vehicle first and discuss collection with Scrap My Car UAE.';

const vehicleTypes = [
  ['ph-engine', 'Engine failure', 'Share any known engine failure, warning lights or diagnosis so the car can be reviewed as it is.'],
  ['ph-gear-six', 'Gearbox failure', 'Transmission faults, lost drive or shifting issues are useful details for a practical valuation.'],
  ['ph-lightning', 'Electrical faults', 'Electrical problems, immobiliser faults and dashboard warnings can be included in the request.'],
  ['ph-battery-warning', 'Battery or start issues', 'A flat battery, starter issue or no-start condition does not prevent you from requesting a valuation.'],
  ['ph-thermometer-hot', 'Overheating', 'Explain any cooling-system or overheating issue before arranging more repair work.'],
  ['ph-warning-octagon', 'After an accident', 'A car that no longer runs after an accident can be considered with its visible damage.'],
  ['ph-clock-counter-clockwise', 'Long-term parked cars', 'A vehicle parked for a long time can still be assessed using its make, model, year and known condition.'],
  ['ph-gas-pump', 'Fuel-system faults', 'Fuel delivery or ignition issues can be included when the vehicle is reviewed as it is.']
];

const causes = [
  ['ph-engine', 'Mechanical failure', 'Engine, timing, fuel or cooling issues can stop a vehicle from running.'],
  ['ph-gear-six', 'Transmission problem', 'A gearbox or driveline issue can leave a car unable to move safely.'],
  ['ph-lightning', 'Electrical issue', 'Starting, charging and control-module faults can keep a vehicle off the road.'],
  ['ph-warning-octagon', 'Accident damage', 'Impact damage can affect mechanical, electrical or safety systems beyond visible panels.']
];

const factors = [
  ['ph-car-profile', 'Make, model & year', 'The vehicle details establish the car and current demand.'],
  ['ph-wrench', 'Known fault', 'A clear description of why the car does not run gives the review useful context.'],
  ['ph-gauge', 'Overall condition', 'Mileage, body condition and any additional mechanical or accident damage can matter.'],
  ['ph-map-pin', 'Location & access', 'The location and whether recovery access is practical help plan a collection discussion.']
];

const faqs = [
  ['Can I sell a car that does not start in the UAE?', 'Yes. Select the make, model and year, then explain the known no-start or non-running issue. The team can review the request as the vehicle is.'],
  ['Do I need to repair a non-running car before requesting a valuation?', 'No. A valuation can help you compare the likely repair spend with the practical value of the vehicle in its current condition.'],
  ['Can you consider a car with engine or gearbox failure?', 'Yes. Mention the known engine, gearbox or electrical fault when you continue the conversation after submitting the form.'],
  ['Can a long-term parked car be valued?', 'Yes. Include the vehicle details and explain how long it has been parked, whether it starts, and any known condition issues.'],
  ['Is collection available for a non-running vehicle?', 'Collection can be discussed across supported UAE locations. The team confirms what is practical after reviewing the vehicle condition, location and access.']
];

let vehicleData = { makes: [], models: [], years: [] };
let vehicleDataError = '';
let helpfulPosts: any[] = [];
try { vehicleData = await getVehicleData(); } catch (error) { vehicleDataError = error instanceof Error ? error.message : String(error); }
try { helpfulPosts = await getLatestPosts({}); } catch { helpfulPosts = []; }

const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scrapmycaruae.com/' },
  { '@type': 'ListItem', position: 2, name: 'Sell My Car', item: 'https://www.scrapmycaruae.com/sell-my-car/' },
  { '@type': 'ListItem', position: 3, name: 'Sell Non-Running Car', item: 'https://www.scrapmycaruae.com/sell-non-running-car/' }
] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---

<BaseLayout title={title} description={description} canonical="/sell-non-running-car/">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} /></Fragment>
  <main class="non-running-page" data-service-motion>
    <section class="non-running-hero" aria-labelledby="non-running-title"><div class="smc-container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/sell-my-car/">Sell My Car</a><span aria-hidden="true">›</span><span aria-current="page">Non-running car</span></nav><div class="non-running-hero__grid"><div class="non-running-hero__copy"><h1 id="non-running-title">Sell your non-running car.<span>Get a valuation.</span></h1><p>You do not need to repair it first. Share the make, model and year, then explain the issue directly with the team.</p></div><div class="non-running-hero__form"><QuoteForm makes={vehicleData.makes} models={vehicleData.models} years={vehicleData.years} dataError={vehicleDataError} variant="free-quote" /></div><ul class="trust-points" aria-label="Non-running car valuation benefits"><li><i class="ph ph-check" aria-hidden="true"></i>Free valuation</li><li><i class="ph ph-check" aria-hidden="true"></i>No repair required first</li><li><i class="ph ph-check" aria-hidden="true"></i>UAE collection discussion</li></ul></div></div></section>

    <section class="section vehicles" aria-labelledby="vehicles-title"><div class="smc-container"><div class="section-heading"><h2 id="vehicles-title">Non-running vehicles <span class="heading-accent">we consider.</span></h2><p>Tell us what the vehicle does—or does not do. Clear condition details are more useful than a repair estimate.</p></div><div class="vehicle-grid">{vehicleTypes.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><h3>{heading}</h3><p>{copy}</p></article>)}</div><div class="section-cta"><SectionActionButton href="/free-quote" label="Request a non-running car valuation" intent="valuation" /></div></div></section>

    <section class="section cause-section" aria-labelledby="causes-title"><div class="smc-container cause-layout"><div class="cause-intro"><h2 id="causes-title">Why a car may <span class="heading-accent">no longer run.</span></h2><p>There can be more than one issue. You do not need a full diagnosis before requesting a valuation—just share what you know about the vehicle.</p><SectionActionButton href="/free-quote" label="Tell us what happened" intent="valuation" /></div><div class="cause-list">{causes.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div></div></section>

    <section class="section repair-section" aria-labelledby="repair-title"><div class="smc-container"><div class="section-heading"><h2 id="repair-title">Repair it or sell it <span class="heading-accent">as-is?</span></h2><p>Compare the likely repair spend with the vehicle's current value before committing to diagnostics, parts or recovery.</p></div><div class="repair-decision__comparison"><article class="repair-route repair-route--repair"><div class="repair-route__top"><i class="ph ph-wrench" aria-hidden="true"></i><span>Repair first</span></div><h3>Best when:</h3><ul><li><i class="ph ph-check" aria-hidden="true"></i>The fault is known</li><li><i class="ph ph-check" aria-hidden="true"></i>Repair cost is controlled</li><li><i class="ph ph-check" aria-hidden="true"></i>The rest of the vehicle is in good condition</li></ul></article><div class="repair-decision__versus" aria-hidden="true"><span>VS</span></div><article class="repair-route repair-route--sell"><div class="repair-route__top"><i class="ph ph-car-profile" aria-hidden="true"></i><span>Sell as-is</span></div><h3>Best when:</h3><ul><li><i class="ph ph-check" aria-hidden="true"></i>The fault is uncertain</li><li><i class="ph ph-check" aria-hidden="true"></i>Multiple issues are involved</li><li><i class="ph ph-check" aria-hidden="true"></i>Repair cost may exceed practical value</li></ul></article></div><div class="repair-decision__action"><div><i class="ph ph-scales" aria-hidden="true"></i><p>Not sure which route makes sense?</p></div><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div><div class="repair-decision__related" aria-label="Related services"><a href="/sell-damaged-car/">Sell a damaged car <span aria-hidden="true">→</span></a><a href="/sell-accident-damaged-car/">Accident-damaged cars <span aria-hidden="true">→</span></a></div></div></section>

    <section class="section service-statistics" aria-labelledby="statistics-title"><div class="smc-container"><div class="section-heading"><h2 id="statistics-title">A clearer way to <span class="heading-accent">move forward.</span></h2><p>Simple facts that keep the process focused on the vehicle you have today.</p></div><div class="stat-grid"><article><i class="ph ph-wrench" aria-hidden="true"></i><strong>As-is</strong><h3>No repair required first</h3><p>Start the valuation with the vehicle’s current condition.</p></article><article><i class="ph ph-list-numbers" aria-hidden="true"></i><strong>3 steps</strong><h3>One clear process</h3><p>Send details, explain the issue and discuss the next step.</p></article><article><i class="ph ph-map-pin" aria-hidden="true"></i><strong>UAE</strong><h3>Collection discussion</h3><p>Location and access are reviewed with the vehicle request.</p></article><article><i class="ph ph-calculator" aria-hidden="true"></i><strong>Free</strong><h3>Valuation request</h3><p>Share the make, model and year to get the conversation started.</p></article></div></div></section>

    <section class="section" aria-labelledby="factors-title"><div class="smc-container"><div class="section-heading"><h2 id="factors-title">What affects a non-running <span class="heading-accent">car valuation?</span></h2><p>Each vehicle is reviewed individually. These details provide context; they are not a fixed online price formula.</p></div><div class="factor-list">{factors.map(([icon, heading, copy]) => <article><i class:list={['ph', icon]} aria-hidden="true"></i><div><h3>{heading}</h3><p>{copy}</p></div></article>)}</div><div class="section-cta"><SectionActionButton href="/free-quote" label="Get my free valuation" intent="valuation" /></div></div></section>

    <section class="section section--dark process" aria-labelledby="process-title"><div class="smc-container"><div class="section-heading section-heading--dark"><h2 id="process-title">A clear 3-step process.</h2></div><ol class="process-grid"><li><span>01</span><h3>Send the vehicle details</h3><p>Choose the make, model and year, then share your contact details.</p></li><li><span>02</span><h3>Explain why it will not run</h3><p>Continue on WhatsApp with the known issue, symptoms or repair history.</p></li><li><span>03</span><h3>Discuss valuation & collection</h3><p>The team can confirm the practical next step after reviewing the request.</p></li></ol></div></section>

    <section class="section collection" aria-labelledby="collection-title"><div class="smc-container"><div class="section-heading"><h2 id="collection-title">Non-running vehicle collection <span class="heading-accent">across the UAE.</span></h2><p>Tell the team where the vehicle is and whether it can move. The coverage guide shows the locations considered for collection discussion.</p></div><LocationCoverageList /></div></section>

    {helpfulPosts.length > 0 && <section class="section section--soft guides" aria-labelledby="guides-title"><div class="smc-container"><div class="section-heading"><h2 id="guides-title">Helpful guides before <span class="heading-accent">your next step.</span></h2><p>Read relevant existing Wix blog guides, then request a valuation when you are ready.</p></div><div class="guide-grid">{helpfulPosts.slice(0, 3).map((post) => <BlogArticleCard post={post} />)}</div><div class="section-cta"><SectionActionButton href="/blogs" label="View all blogs" intent="blogs" /></div></div></section>}

    <section class="section non-running-faq" aria-labelledby="faq-title"><div class="smc-container"><div class="section-heading"><h2 id="faq-title">Non-running-car FAQs</h2><p>Answers to common questions about valuing and selling a broken-down vehicle in the UAE.</p></div><div class="faq-stack">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>{question}</span><i class="ph ph-plus" aria-hidden="true"></i></summary><p>{answer}</p></details>)}</div><div class="section-cta"><SectionActionButton href="/faqs" label="Browse all FAQs" intent="faqs" /></div></div></section>
    <section class="final-valuation"><div class="smc-container final-valuation__inner"><div><h2>Start with the car as it is.</h2><p>You do not need to repair it first. Send the vehicle details and explain the known issue when the conversation continues on WhatsApp.</p></div><a class="smc-button" href="/free-quote" data-analytics-quote-cta="sell_non_running_car_final">Get my free valuation <i class="ph ph-calculator" aria-hidden="true"></i></a></div></section>
  </main>
  <ServicePageMotion />
</BaseLayout>

<style>
  .non-running-page{overflow:hidden;color:#17331d}.non-running-hero{padding:22px 0 clamp(52px,6vw,76px);border-bottom:1px solid #dce6d9;background:linear-gradient(180deg,#fcfdfb,#f4f8f2)}.breadcrumb{display:flex;flex-wrap:wrap;gap:8px;align-items:center;color:#687268;font-size:13px}.breadcrumb a{color:#315d37;text-decoration:none}.non-running-hero__grid{display:grid;grid-template-areas:'copy form' 'trust form';grid-template-columns:minmax(0,1.16fr) minmax(400px,.74fr);column-gap:clamp(44px,6vw,84px);row-gap:20px;margin-top:28px}.non-running-hero__copy{grid-area:copy;max-width:650px}.non-running-hero h1{margin:0;font-size:clamp(3rem,4.1vw,4.5rem);font-weight:700;line-height:1;letter-spacing:-.055em}.non-running-hero h1 span{display:block;color:#3c8e2f}.non-running-hero__copy p{margin:22px 0 0;color:#5c685d;font-size:18px;line-height:1.6}.non-running-hero__form{grid-area:form;filter:drop-shadow(0 16px 28px rgba(31,70,36,.07))}.trust-points{grid-area:trust;display:grid;gap:9px;align-self:end;margin:0;padding:0;list-style:none}.trust-points li{display:flex;gap:9px;align-items:center;color:#2a472f;font-size:14px;font-weight:650}.trust-points i,.check-list>div>i{display:grid;width:22px;height:22px;place-items:center;border-radius:50%;background:#2f7d32;color:#fff;font-size:14px}.section{padding:clamp(52px,4.6vw,68px) 0}.section--soft,.repair-section{background:#f6f9f4}.section--dark{background:#173d18;color:#fff}.section-heading{max-width:760px;margin:0 auto 30px;text-align:center}.section-heading h2,.cause-intro h2,.repair-panel h2,.final-valuation h2{margin:0;color:#17331d;font-size:clamp(2.1rem,4vw,3.3rem);line-height:1.06;letter-spacing:-.05em}.section-heading p{margin:15px auto 0;color:#5c685d;line-height:1.7}.heading-accent{color:#3c8e2f}.section-heading--dark h2{color:#fff}.section-cta{display:flex;justify-content:center;margin-top:26px}.vehicle-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.vehicle-grid article{min-height:194px;padding:23px;border:1px solid #dce6d9;border-radius:17px;background:#fff;transition:transform 160ms ease,border-color 160ms ease,box-shadow 160ms ease}.vehicle-grid article:hover{border-color:#9abf9b;box-shadow:0 13px 24px rgba(42,102,51,.08);transform:translateY(-2px)}.vehicle-grid i,.factor-list i,.repair-panel>i{display:grid;width:40px;height:40px;place-items:center;border-radius:12px;background:#e8f3e5;color:#32753a;font-size:20px}.vehicle-grid h3,.factor-list h3{margin:16px 0 7px;font-size:18px;letter-spacing:-.025em}.vehicle-grid p,.factor-list p{margin:0;color:#647064;font-size:14px;line-height:1.65}.cause-section{background:#fff}.cause-layout{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(34px,7vw,82px);align-items:center}.cause-intro p{margin:18px 0 24px;color:#5c685d;line-height:1.7}.cause-list{border-top:1px solid #dce6d9}.cause-list article,.factor-list article{display:grid;grid-template-columns:42px 1fr;gap:14px;padding:20px 0;border-bottom:1px solid #dce6d9}.cause-list i{display:grid;width:38px;height:38px;place-items:center;border-radius:11px;background:#eef6eb;color:#32753a;font-size:19px}.cause-list h3{margin:2px 0 6px;font-size:18px}.cause-list p{margin:0;color:#647064;font-size:14px;line-height:1.65}.repair-grid{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:clamp(32px,6vw,70px);align-items:center}.repair-panel{padding:clamp(26px,3.2vw,38px);border-radius:22px;background:#fff;box-shadow:0 15px 35px rgba(20,53,29,.06)}.repair-panel h2{margin-top:18px}.repair-panel p{margin:16px 0 22px;color:#5c685d;line-height:1.7}.repair-panel__actions{display:flex;flex-wrap:wrap;gap:10px}.check-list>div{display:grid;grid-template-columns:32px 1fr;gap:13px;padding:18px 0;border-top:1px solid #d6e2d4}.check-list>div:last-child{border-bottom:1px solid #d6e2d4}.check-list>div>i{width:28px;height:28px}.check-list h3{margin:2px 0 0;font-size:18px}.check-list p{margin:7px 0 0;color:#5c685d;font-size:14px;line-height:1.65}.factor-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));max-width:980px;margin:auto;border-top:1px solid #dce6d9}.factor-list article{padding:22px 28px}.factor-list article:nth-child(odd){padding-left:0;border-right:1px solid #dce6d9}.factor-list article:nth-child(even){padding-right:0}.process-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:0;padding:0;list-style:none}.process-grid li{padding:22px 0 0;border-top:1px solid rgba(255,255,255,.22)}.process-grid span{display:grid;width:32px;height:32px;place-items:center;border-radius:10px;background:rgba(169,223,150,.16);color:#bce3ae;font-size:11px;font-weight:800;letter-spacing:.06em}.process-grid h3{margin:17px 0 9px;font-size:23px;letter-spacing:-.035em}.process-grid p{margin:0;color:#c9d7c5;line-height:1.65}.collection{background:#fff}.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.faq-stack{max-width:980px;margin:auto}.faq-stack details{border-bottom:1px solid #dce6d9}.faq-stack details:first-child{border-top:1px solid #dce6d9}.faq-stack summary{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:70px;padding:16px 0;list-style:none;cursor:pointer;font-size:17px;font-weight:700}.faq-stack summary::-webkit-details-marker{display:none}.faq-stack summary i{display:grid;width:28px;height:28px;place-items:center;border:1px solid #d7e3d4;border-radius:50%;color:#286633;transition:transform 160ms ease}.faq-stack details[open] summary i{transform:rotate(45deg)}.faq-stack details p{margin:-3px 0 22px;color:#5c685d;line-height:1.7}.final-valuation{padding:64px 0;background:radial-gradient(circle at 78% 30%,rgba(117,203,82,.15),transparent 27%),#163d18;color:#fff}.final-valuation__inner{display:flex;align-items:center;justify-content:space-between;gap:34px}.final-valuation h2{color:#fff}.final-valuation p{max-width:720px;margin:13px 0 0;color:#c9d7c5}.final-valuation .smc-button{flex:0 0 auto;min-height:50px;background:#fff;color:#174020}
  @media(min-width:981px){.non-running-hero__copy{align-self:end}}
  @media(max-width:980px){.non-running-hero__grid{grid-template-areas:'copy' 'form' 'trust';grid-template-columns:1fr}.non-running-hero__copy{align-self:auto}.non-running-hero__form{width:min(100%,650px)}.vehicle-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cause-layout,.repair-grid{grid-template-columns:1fr}.factor-list{grid-template-columns:1fr}.factor-list article:nth-child(odd),.factor-list article:nth-child(even){padding-inline:0;border-right:0}.guide-grid{grid-template-columns:repeat(2,minmax(0,1fr)}}
  @media(max-width:700px){.non-running-hero{padding-top:16px}.non-running-hero__grid{gap:16px;margin-top:23px}.non-running-hero__copy{text-align:center}.non-running-hero h1{font-size:clamp(2.65rem,12vw,3.6rem);line-height:.96;letter-spacing:-.045em}.non-running-hero__copy p{margin:14px auto 0;font-size:15px;line-height:1.5}.trust-points{gap:9px}.trust-points li{font-size:13px}.section{padding:clamp(50px,13vw,58px) 0}.section-heading{margin-bottom:25px}.section-heading h2,.cause-intro h2,.repair-panel h2,.final-valuation h2{font-size:clamp(2rem,9vw,2.6rem)}.vehicle-grid,.guide-grid,.process-grid{grid-template-columns:1fr}.vehicle-grid article{min-height:0;padding:22px}.process-grid{gap:17px}.process-grid h3{font-size:21px}.repair-panel{padding:27px 23px}.final-valuation{padding:58px 0}.final-valuation__inner{flex-direction:column;align-items:flex-start}.final-valuation .smc-button{width:100%}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}}
  /* Keep the shared service-hero copy aligned against the desktop form while mobile follows normal form-first flow. */
  @media(min-width:981px){.non-running-hero__copy{align-self:end}}
  @media(max-width:980px){.non-running-hero__copy{align-self:auto}}
  /* Non-running page refinement: balanced colour, a less boxy repair decision, and a compact phone hero. */
  .vehicle-grid article{min-height:198px;border-color:#d9e5d7;border-radius:18px;background:linear-gradient(145deg,#fff 0%,#f3f9f1 100%)}
  .vehicle-grid article:nth-child(2n){background:linear-gradient(145deg,#fff 0%,#eef7ec 100%)}
  .vehicle-grid article:nth-child(3n){background:linear-gradient(145deg,#fff 0%,#f7fbf5 100%)}
  .vehicle-grid article:hover{border-color:#8ebc8a;box-shadow:0 15px 28px rgba(42,102,51,.1);transform:translateY(-3px)}
  .vehicle-grid i{background:linear-gradient(145deg,#dff0dc,#f6fbf4)}
  .repair-section{background:radial-gradient(circle at 50% 8%,rgba(119,190,101,.12),transparent 30%),linear-gradient(180deg,#f8fbf6,#eef6eb)}
  .repair-decision__comparison{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 68px minmax(0,1fr);align-items:center;max-width:1040px;margin:0 auto}
  .repair-route{position:relative;overflow:hidden;min-height:258px;padding:clamp(26px,3vw,34px);border:1px solid #cde0ca;border-radius:20px;background:rgba(255,255,255,.82);transition:transform 180ms ease,box-shadow 180ms ease,border-color 180ms ease}
  .repair-route::after{position:absolute;right:-54px;bottom:-80px;width:190px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(90,166,82,.2),rgba(90,166,82,0) 68%);content:'';pointer-events:none}
  .repair-route--sell{border-color:#a7caa4;background:linear-gradient(145deg,rgba(234,247,230,.92),rgba(255,255,255,.94))}
  .repair-route:hover{border-color:#5c9b58;box-shadow:0 18px 32px rgba(32,90,39,.1);transform:translateY(-3px)}
  .repair-route__top{display:flex;gap:11px;align-items:center;color:#286633;font-size:13px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}
