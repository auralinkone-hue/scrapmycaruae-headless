---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { canonicalUrl, robotsContent, siteUrl } from '../lib/seo';
import { defaultSocialImage, defaultSocialImageAlt, serviceSchemaForPath, serializeJsonLd } from '../lib/structured-data';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  prevUrl?: string;
  nextUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description = '',
  canonical,
  ogImage = '',
  ogType = 'website',
  prevUrl = '',
  nextUrl = '',
  noindex = false
} = Astro.props;

const resolvedCanonical = canonicalUrl(canonical || Astro.url.pathname);
// Prerendering uses a synthetic localhost URL; runtime requests keep host protection.
const robotsUrl = Astro.isPrerendered ? new URL(Astro.url.pathname, siteUrl) : Astro.url;
const resolvedRobots = noindex ? 'noindex,nofollow' : robotsContent(robotsUrl);
const resolvedPrevUrl = prevUrl ? canonicalUrl(prevUrl) : '';
const resolvedNextUrl = nextUrl ? canonicalUrl(nextUrl) : '';
const resolvedOgImage = new URL(ogImage || defaultSocialImage, `${siteUrl}/`).toString();
const resolvedOgImageAlt = ogImage ? title : defaultSocialImageAlt;
const serviceSchema = serviceSchemaForPath(Astro.url.pathname);
const gtmId = import.meta.env.PUBLIC_GTM_ID?.trim() || '';
const analyticsEnabled = import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true' && Boolean(gtmId);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={resolvedCanonical} />
    {resolvedPrevUrl && <link rel="prev" href={resolvedPrevUrl} />}
    {resolvedNextUrl && <link rel="next" href={resolvedNextUrl} />}
    <meta name="robots" content={resolvedRobots} />
    <meta name="googlebot" content={resolvedRobots} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Scrap My Car UAE" />
    <meta property="og:locale" content="en_AE" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={resolvedCanonical} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta property="og:image:alt" content={resolvedOgImageAlt} />

    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    {serviceSchema && <script type="application/ld+json" set:html={serializeJsonLd(serviceSchema)} />}

    {analyticsEnabled && <meta name="smc-analytics-config" content={gtmId} />}
    <script>
      import { initializeAnalytics } from '../scripts/analytics';

      const analyticsConfig = document.querySelector<HTMLMetaElement>('meta[name="smc-analytics-config"]');
      const configuredGtmId = analyticsConfig?.content.trim() || '';

      if (configuredGtmId) {
        const preferenceKey = 'smc_cookie_preferences_v1';
        const readAnalyticsPreference = () => {
          try {
            const stored = window.localStorage.getItem(preferenceKey);
            if (stored) return JSON.parse(stored)?.analytics === true;
          } catch {}

          const cookie = document.cookie
            .split('; ')
            .find((entry) => entry.startsWith(`${preferenceKey}=`));
          return cookie?.split('=')[1] === 'analytics-yes';
        };

        let analyticsLoaded = false;
        window.dataLayer = window.dataLayer || [];
        window.smcAnalyticsConsentGranted = readAnalyticsPreference();

        const setConsentMode = (mode, granted) => {
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer?.push(arguments); }
          gtag('consent', mode, {
            analytics_storage: granted ? 'granted' : 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied'
          });
        };

        setConsentMode('default', false);

        const loadAnalytics = async () => {
          if (analyticsLoaded || !window.smcAnalyticsConsentGranted) return;
          analyticsLoaded = true;
          setConsentMode('update', true);
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

          const firstScript = document.getElementsByTagName('script')[0];
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(configuredGtmId)}`;
          firstScript?.parentNode?.insertBefore(script, firstScript);
          initializeAnalytics();
        };

        window.addEventListener('smc:analytics-consent', (event) => {
          const granted = event instanceof CustomEvent && event.detail?.granted === true;
          window.smcAnalyticsConsentGranted = granted;
          setConsentMode('update', granted);
          if (granted) loadAnalytics();
        });

        if (window.smcAnalyticsConsentGranted) loadAnalytics();
      }
    </script>

    <slot name="head" />
  </head>

  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />

    <script>
      const markLoadedImages = () => {
        document.querySelectorAll('[data-image-loading]').forEach((container) => {
          const image = container.querySelector('img');
          if (!(image instanceof HTMLImageElement)) return;

          const complete = () => container.classList.add('is-loaded');

          if (image.complete) {
            complete();
          } else {
            image.addEventListener('load', complete, { once: true });
            image.addEventListener('error', complete, { once: true });
          }
        });
      };

      markLoadedImages();
      document.addEventListener('astro:page-load', markLoadedImages);
    </script>
  </body>
</html>
