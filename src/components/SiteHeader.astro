---
const pathname = Astro.url.pathname;
const whatsappUrl = 'https://api.whatsapp.com/send?phone=%2B971557458322';
const links = [
  { href: '/', label: 'Home', icon: 'ph-house' },
  { href: '/sell-my-car/', label: 'Sell My Car', icon: 'ph-car-profile' },
  { href: '/contact-us', label: 'Contact Us', icon: 'ph-chat-circle-text' },
  { href: '/faqs', label: 'FAQs', icon: 'ph-question' },
  { href: '/blogs', label: 'Blogs', icon: 'ph-newspaper-clipping' }
];

const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(href + '/');
---

<header class="smc-header">
  <div class="smc-nav-wrap">
    <div class="smc-container nav-inner">
      <a class="brand" href="/" aria-label="Scrap My Car UAE home">
        <img
          src="https://static.wixstatic.com/media/ff8df3_ee2506a8a7ed4752b5b7832449c71105~mv2.png"
          alt="Scrap My Car UAE"
          width="155"
          height="60"
        />
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href) }]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="desktop-actions">
        <a class="smc-button smc-button-primary" href="/free-quote" data-analytics-quote-cta="header_desktop">
          <span>Value My Car</span>
          <i class="ph ph-calculator" aria-hidden="true"></i>
        </a>
        <a class="header-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-analytics-whatsapp="header_desktop">
          <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
          <span>WhatsApp</span>
        </a>
      </div>

      <a class="mobile-call" href="tel:+971557458322" aria-label="Call Scrap My Car UAE on 055 745 83 22">
        <i class="ph ph-phone-call" aria-hidden="true"></i>
        <span>055 745 83 22</span>
      </a>

      <details class="mobile-menu">
        <summary aria-label="Open navigation">
          <i class="ph ph-list menu-open-icon" aria-hidden="true"></i>
          <i class="ph ph-x menu-close-icon" aria-hidden="true"></i>
        </summary>
        <div class="mobile-panel">
          <p class="mobile-menu-kicker">Navigation</p>
          <a href="/" class:list={['mobile-link', { active: isActive('/') }]}>
            <i class="ph ph-house" aria-hidden="true"></i>
            Home
            <i class="ph ph-caret-right mobile-link-arrow" aria-hidden="true"></i>
          </a>
          <a href="/sell-my-car/" class:list={['mobile-link', { active: isActive('/sell-my-car/') }]}>
            <i class="ph ph-car-profile" aria-hidden="true"></i>
            Sell My Car
            <i class="ph ph-caret-right mobile-link-arrow" aria-hidden="true"></i>
          </a>
          <a href="/contact-us" class:list={['mobile-link', { active: isActive('/contact-us') }]}>
            <i class="ph ph-chat-circle-text" aria-hidden="true"></i>
            Contact Us
            <i class="ph ph-caret-right mobile-link-arrow" aria-hidden="true"></i>
          </a>
          <a href="/faqs" class:list={['mobile-link', { active: isActive('/faqs') }]}>
            <i class="ph ph-question" aria-hidden="true"></i>
            FAQs
            <i class="ph ph-caret-right mobile-link-arrow" aria-hidden="true"></i>
          </a>
          <a href="/blogs" class:list={['mobile-link', { active: isActive('/blogs') }]}>
            <i class="ph ph-newspaper-clipping" aria-hidden="true"></i>
            Blogs
            <i class="ph ph-caret-right mobile-link-arrow" aria-hidden="true"></i>
          </a>
          <a class="smc-button smc-button-primary mobile-quote" href="/free-quote" data-analytics-quote-cta="header_mobile">
            <i class="ph ph-calculator" aria-hidden="true"></i>
            Value My Car
          </a>
          <a class="mobile-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
            Chat on WhatsApp
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .smc-header {
    position: relative;
    z-index: 40;
    background: #fff;
  }

  .smc-nav-wrap {
    border-bottom: 1px solid rgba(20,40,20,.08);
    background: rgba(255,255,255,.96);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }

  .brand img {
    display: block;
    width: 146px;
    height: auto;
    max-height: 58px;
    object-fit: contain;
  }

  .desktop-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    position: relative;
    color: #333a33;
    text-decoration: none;
    font-size: 14px;
    font-weight: 650;
    letter-spacing: -.012em;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 18px;
    bottom: -10px;
    height: 2px;
    border-radius: 2px;
    background: var(--smc-green);
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--smc-green-dark);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-link:focus-visible,
  .mobile-link:focus-visible,
  .mobile-menu summary:focus-visible {
    outline: 3px solid rgba(47, 111, 45, .16);
    outline-offset: 3px;
    border-radius: 10px;
  }

  .desktop-actions {
    display: flex;
    align-items: center;
    margin-left: 20px;
    padding-left: 6px;
    gap: 10px;
  }

  .desktop-actions .smc-button {
    min-height: 47px;
    padding: 0 7px 0 18px;
    gap: 12px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .012em;
    white-space: nowrap;
  }

  .desktop-actions .smc-button .ph {
    width: 31px;
    height: 31px;
    font-size: 16px;
  }

  .header-whatsapp {
    min-height: 47px;
    padding: 0 16px;
    border: 1px solid #c8d8c5;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #fff;
    color: #235d2d;
    box-shadow: 0 5px 14px rgba(24,67,31,.05);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .012em;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .header-whatsapp:hover {
    border-color: #66a860;
    box-shadow: 0 9px 18px rgba(24,67,31,.10);
    transform: translateY(-1px);
  }

  .header-whatsapp .wa-icon {
    width: 18px;
    height: 18px;
  }

  .mobile-menu {
    display: none;
    margin-left: auto;
    position: relative;
  }

  .mobile-call {
    display: none;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 10px;
    margin-left: auto;
    border-radius: 12px;
    background: var(--smc-green-soft);
    color: var(--smc-green-dark);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .mobile-call .ph {
    font-size: 18px;
  }

  .mobile-menu summary {
    width: 44px;
    height: 44px;
    border: 1px solid var(--smc-line);
    border-radius: 12px;
    display: grid;
    place-content: center;
    gap: 4px;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary .ph {
    color: #202420;
    font-size: 22px;
  }

  .menu-close-icon {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: 54px;
    width: min(310px, calc(100vw - 30px));
    padding: 12px;
    border: 1px solid var(--smc-line);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--smc-shadow);
    display: grid;
    gap: 4px;
  }

  .mobile-link {
    color: #202420;
    padding: 13px 14px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 650;
  }

  .mobile-link > .ph:first-child {
    font-size: 20px;
  }

  .mobile-link-arrow {
    margin-left: auto;
    font-size: 17px;
    opacity: .5;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--smc-green-dark);
    background: var(--smc-green-soft);
  }

  .mobile-quote {
    margin-top: 8px;
  }

  .mobile-whatsapp {
    padding: 11px;
    color: var(--smc-green-dark);
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
  }

  @media (max-width: 1100px) {
    .desktop-nav,
    .desktop-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .mobile-link {
      display: flex;
      align-items: center;
      gap: 11px;
    }
  }

  @media (max-width: 640px) {
    .nav-inner {
      min-height: 66px;
    }

    .brand img {
      width: 128px;
    }

    .nav-inner { gap: 12px; }

    .mobile-call {
      display: inline-flex;
    }

    .mobile-menu summary {
      width: 44px;
      height: 44px;
    }

    .mobile-menu {
      position: static;
      margin-left: 0;
    }

    .mobile-panel {
      position: fixed;
      inset: 0;
      z-index: 50;
      width: auto;
      min-height: 100dvh;
      padding: 104px 24px max(28px, env(safe-area-inset-bottom));
      border: 0;
      border-radius: 0;
      background: #123816;
      box-shadow: none;
      align-content: start;
      gap: 7px;
      overflow-y: auto;
    }

    .mobile-menu-kicker {
      margin: 0 0 12px;
      color: #a9caa7;
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .mobile-link {
      min-height: 58px;
      padding: 14px 4px;
      border-bottom: 1px solid rgba(255,255,255,.14);
      border-radius: 0;
      color: #fff;
      font-size: 18px;
      font-weight: 650;
    }

    .mobile-link > .ph:first-child { color: #9bd394; }
    .mobile-link-arrow { color: #fff; opacity: .65; }

    .mobile-link:hover,
    .mobile-link.active {
      color: #fff;
      background: transparent;
    }

    .mobile-quote {
      min-height: 54px;
      margin-top: 24px;
      justify-content: center;
      background: #fff;
      color: #17491b;
      border: 1px solid #fff;
    }

    .mobile-whatsapp {
      min-height: 48px;
      color: #fff;
      font-size: 15px;
      border: 1px solid rgba(255,255,255,.22);
      border-radius: 12px;
    }

    .mobile-whatsapp .wa-icon {
      width: 19px;
      height: 19px;
    }

    .mobile-menu[open] summary {
      position: fixed;
      top: max(11px, env(safe-area-inset-top));
      right: 16px;
      z-index: 51;
      border-color: rgba(255,255,255,.24);
      background: rgba(255,255,255,.1);
    }

    .mobile-menu[open] summary .ph { color: #fff; }
    .mobile-menu[open] .menu-open-icon { display: none; }
    .mobile-menu[open] .menu-close-icon { display: block; }
  }

  @media (max-width: 360px) {
    .nav-inner { gap: 8px; }
    .brand img { width: 108px; }
    .mobile-call { width: 44px; padding: 0; justify-content: center; }
    .mobile-call span { display: none; }
    .mobile-menu { width: 44px; flex: 0 0 44px; }
    .mobile-menu summary { width: 44px; box-sizing: border-box; }
  }
</style>
