---
const pathname = Astro.url.pathname;
const whatsappUrl = 'https://api.whatsapp.com/send?phone=%2B971557458322';
// Future service routes remain prepared here, but only live routes are exposed in the menu.
const sellMyCarServices = [
  { href: '/sell-my-car/', label: 'Sell My Car', icon: 'ph-car-profile' },
  { href: '/sell-damaged-car/', label: 'Sell Damaged Car', icon: 'ph-car' },
  { href: '/sell-accident-damaged-car/', label: 'Sell Accident-Damaged Car', icon: 'ph-warning-octagon' },
  { href: '/sell-non-running-car/', label: 'Sell Non-Running Car', icon: 'ph-engine' },
  { href: '/sell-car-with-engine-problems/', label: 'Engine Problems', icon: 'ph-wrench' },
  { href: '/sell-car-with-gearbox-problems/', label: 'Gearbox Problems', icon: 'ph-gear-six' },
  { href: '/sell-flood-damaged-car/', label: 'Flood-Damaged Car', icon: 'ph-drop' },
  { href: '/sell-car-with-expired-registration/', label: 'Expired Registration', icon: 'ph-identification-card' },
  { href: null, label: 'Old / Unwanted Cars' },
  { href: null, label: 'Car Removal' },
  { href: null, label: 'Fleet Disposal' }
] as const;
const scrapMyCarServices = [
  { href: '/scrap-my-car/', label: 'Scrap My Car', icon: 'ph-recycle' },
  { href: '/scrap-car-value/', label: 'Scrap Car Value', icon: 'ph-calculator' },
  { href: '/car-removal/', label: 'Car Removal', icon: 'ph-truck' },
  { href: '/scrap-old-car/', label: 'Scrap Old Car', icon: 'ph-car-profile' },
  { href: '/fleet-disposal/', label: 'Fleet Disposal', icon: 'ph-buildings' }
] as const;
const locationPages = [
  { href: '/locations/', label: 'All UAE Locations', icon: 'ph-map-trifold' },
  { href: '/locations/dubai/', label: 'Dubai', icon: 'ph-buildings' },
  { href: '/locations/abu-dhabi/', label: 'Abu Dhabi', icon: 'ph-map-pin' },
  { href: '/locations/sharjah/', label: 'Sharjah', icon: 'ph-warehouse' },
  { href: '/locations/ajman/', label: 'Ajman', icon: 'ph-map-pin' },
  { href: '/locations/ras-al-khaimah/', label: 'Ras Al Khaimah', icon: 'ph-mountains' },
  { href: '/locations/fujairah/', label: 'Fujairah', icon: 'ph-waves' },
  { href: '/locations/al-ain/', label: 'Al Ain', icon: 'ph-tree-palm' }
] as const;
const isLocationNavigationActive = pathname === '/locations' || pathname.startsWith('/locations/');
const links = [
  { href: '/', label: 'Home', icon: 'ph-house' },
  { href: '/sell-my-car/', label: 'Sell My Car', icon: 'ph-car-profile', children: sellMyCarServices },
  { href: '/scrap-my-car/', label: 'Scrap My Car', icon: 'ph-recycle', children: scrapMyCarServices },
  { href: '/locations/', label: 'Locations', icon: 'ph-map-trifold', children: locationPages },
  { href: '/contact-us', label: 'Contact Us', icon: 'ph-chat-circle-text' },
  { href: '/faqs', label: 'FAQs', icon: 'ph-question' },
  { href: '/blogs', label: 'Blogs', icon: 'ph-newspaper-clipping' }
];

const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(href + '/');
const visibleSellMyCarServices = sellMyCarServices.filter(
  (service): service is { href: string; label: string; icon: string } => Boolean(service.href)
);
const mobileServiceGroups = [
  { id: 'sell', href: '/sell-my-car/', label: 'Sell My Car', description: 'Find the right route for your vehicle.', items: visibleSellMyCarServices },
  { id: 'scrap', href: '/scrap-my-car/', label: 'Scrap My Car', description: 'Value, collection and disposal options.', items: scrapMyCarServices },
  { id: 'locations', href: '/locations/', label: 'Locations', description: 'Explore UAE collection coverage and local access guides.', overviewLabel: 'View all UAE locations', items: locationPages }
];
const isScrapMyCarServiceActive = scrapMyCarServices.some((service) => isActive(service.href));
---

<header class="smc-header">
  <div class="smc-nav-wrap">
    <div class="smc-container nav-inner">
      <a class="brand" href="/" aria-label="Scrap My Car UAE home">
        <img
          src="https://static.wixstatic.com/media/ff8df3_ee2506a8a7ed4752b5b7832449c71105~mv2.png"
          alt="Scrap My Car UAE"
          width="155"
          height="60"
        />
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        {links.map((link) => link.children ? (
          <div class:list={['nav-group', { 'nav-group--split': link.href === '/scrap-my-car/' || link.href === '/locations/' }]}>
          {link.href === '/scrap-my-car/' && <a href={link.href} class:list={['nav-link', { active: isScrapMyCarServiceActive }]}>{link.label}</a>}
          {link.href === '/locations/' && <a href={link.href} class:list={['nav-link', { active: isLocationNavigationActive }]} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>}
          <details name="desktop-services" class:list={['nav-dropdown', { active: link.href === '/locations/' ? isLocationNavigationActive : link.children.some((service) => service.href && isActive(service.href)) }]}>
            <summary class="nav-link nav-dropdown__trigger" aria-label={link.href === '/scrap-my-car/' ? 'Show Scrap My Car services' : link.href === '/locations/' ? 'Show Locations' : undefined}>
              {link.href !== '/scrap-my-car/' && link.href !== '/locations/' && link.label}
              <i class="ph ph-caret-down" aria-hidden="true"></i>
            </summary>
            <div class="nav-dropdown__panel">
              {link.children.filter((service) => service.href).map((service) => (
                <a href={service.href} class:list={{ active: isActive(service.href) }} aria-current={isActive(service.href) ? 'page' : undefined}>
                  <span class="service-link-icon"><i class:list={['ph', service.icon]} aria-hidden="true"></i></span>
                  <span>{service.label}</span>
                  <i class="ph ph-arrow-up-right service-link-arrow" aria-hidden="true"></i>
                </a>
              ))}
            </div>
          </details>
          </div>
        ) : (
          <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>{link.label}</a>
        ))}
      </nav>

      <div class="desktop-actions">
        <a class="smc-button smc-button-primary" href="/free-quote" data-analytics-quote-cta="header_desktop">
          <span>Value My Car</span>
          <i class="ph ph-calculator" aria-hidden="true"></i>
        </a>
        <a class="header-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-analytics-whatsapp="header_desktop">
          <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
          <span>WhatsApp</span>
        </a>
      </div>

      <a class="mobile-call" href="tel:+971557458322" aria-label="Call Scrap My Car UAE on 055 745 83 22">
        <i class="ph ph-phone-call" aria-hidden="true"></i>
        <span>055 745 83 22</span>
      </a>

      <div class="mobile-menu">
        <button class="mobile-toggle" type="button" aria-label="Open navigation" aria-controls="mobile-drawer" aria-expanded="false"><i class="ph ph-list" aria-hidden="true"></i></button>
        <div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Site navigation" hidden>
          <div class="mobile-drawer__header"><span>Scrap My Car UAE</span><button class="mobile-close" type="button" data-mobile-close aria-label="Close navigation"><i class="ph ph-x" aria-hidden="true"></i></button></div>
          <div class="mobile-stage">
            <nav class="mobile-view mobile-view--main is-active" data-mobile-view="main" aria-label="Main mobile navigation">
              {links.map((link) => link.children ? (
                <button type="button" class:list={['mobile-row', 'mobile-row--category', { active: link.href === '/locations/' ? isLocationNavigationActive : mobileServiceGroups.find((group) => group.href === link.href)?.items.some((item) => isActive(item.href)) }]} data-mobile-forward={mobileServiceGroups.find((group) => group.href === link.href)?.id} aria-controls={'mobile-view-' + mobileServiceGroups.find((group) => group.href === link.href)?.id} aria-expanded="false">
                  <span class="mobile-row__icon"><i class:list={['ph', link.icon]} aria-hidden="true"></i></span><span>{link.label}</span><i class="ph ph-arrow-right mobile-row__arrow" aria-hidden="true"></i>
                </button>
              ) : (
                <a class:list={['mobile-row', { active: isActive(link.href) }]} href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}><span class="mobile-row__icon"><i class:list={['ph', link.icon]} aria-hidden="true"></i></span><span>{link.label}</span><i class="ph ph-caret-right mobile-row__arrow" aria-hidden="true"></i></a>
              ))}
            </nav>
            {mobileServiceGroups.map((group) => (
              <section class="mobile-view" data-mobile-view={group.id} id={'mobile-view-' + group.id} aria-labelledby={'mobile-heading-' + group.id} aria-hidden="true" inert>
                <div class="mobile-subheading"><button type="button" class="mobile-back" data-mobile-back aria-label="Back to main navigation"><i class="ph ph-arrow-left" aria-hidden="true"></i>Back</button><h2 id={'mobile-heading-' + group.id}>{group.label}</h2></div>
                <p class="mobile-view__description">{group.description}</p>
                <nav aria-label={group.label + (group.id === 'locations' ? ' navigation' : ' services')}>
                  {group.items.map((item, index) => <a class:list={['mobile-row', { 'mobile-row--overview': index === 0, active: isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}><span class="mobile-row__icon"><i class:list={['ph', item.icon]} aria-hidden="true"></i></span><span>{index === 0 ? ('overviewLabel' in group ? group.overviewLabel : 'View all ' + group.label) : item.label}</span><i class="ph ph-caret-right mobile-row__arrow" aria-hidden="true"></i></a>)}
                </nav>
              </section>
            ))}
          </div>
          <div class="mobile-menu-actions">
            <a class="mobile-quote" href="/free-quote" data-analytics-quote-cta="header_mobile"><span class="mobile-action-icon"><i class="ph ph-calculator" aria-hidden="true"></i></span>Value My Car</a>
            <a class="mobile-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-analytics-whatsapp="header_mobile"><img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />Chat on WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const initialiseDesktopNavigation = () => {
    const header = document.querySelector<HTMLElement>('.smc-header');
    if (!header || header.dataset.desktopReady) return;
    header.dataset.desktopReady = 'true';
    header.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = header.querySelector<HTMLDetailsElement>('.nav-dropdown[open]');
      if (!open) return;
      event.preventDefault();
      open.open = false;
      open.querySelector<HTMLElement>('summary')?.focus();
    });
  };
  initialiseDesktopNavigation();
  document.addEventListener('astro:page-load', initialiseDesktopNavigation);

  const initialiseMobileNavigation = () => {
    const opener = document.querySelector<HTMLButtonElement>('.mobile-toggle');
    const drawer = document.querySelector<HTMLElement>('.mobile-drawer');
    if (!opener || !drawer || drawer.dataset.ready) return;
    drawer.dataset.ready = 'true';
    // Mount at body level so header backdrop-filter cannot constrain the fixed drawer.
    document.body.append(drawer);
    const closeButton = drawer.querySelector<HTMLButtonElement>('[data-mobile-close]')!;
    const views = Array.from(drawer.querySelectorAll<HTMLElement>('[data-mobile-view]'));
    const forwards = Array.from(drawer.querySelectorAll<HTMLButtonElement>('[data-mobile-forward]'));
    const mobileQuery = window.matchMedia('(max-width: 1100px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isOpen = false;
    let savedScrollY = 0;
    let closeTimer: ReturnType<typeof setTimeout>;
    let bodyStyles = { position: '', top: '', width: '', overflow: '' };
    const background = new Map<HTMLElement, boolean>();

    const showPanel = (name: string, moveFocus = true) => {
      views.forEach((view) => {
        const active = view.dataset.mobileView === name;
        view.classList.toggle('is-active', active);
        view.classList.toggle('is-behind', name !== 'main' && view.dataset.mobileView === 'main');
        view.inert = !active;
        view.setAttribute('aria-hidden', String(!active));
        if (active) view.scrollTop = 0;
      });
      forwards.forEach((button) => button.setAttribute('aria-expanded', String(button.dataset.mobileForward === name)));
      if (moveFocus) {
        const target = name === 'main'
          ? forwards.find((button) => button.dataset.mobileForward === drawer.dataset.panel)
          : drawer.querySelector<HTMLButtonElement>('#mobile-view-' + name + ' [data-mobile-back]');
        target?.focus({ preventScroll: true });
      }
      drawer.dataset.panel = name;
    };

    const closeMenu = (returnFocus = true, immediate = false) => {
      if (!isOpen) return;
      isOpen = false;
      opener.setAttribute('aria-expanded', 'false');
      drawer.classList.remove('is-open');
      drawer.inert = true;
      background.forEach((wasInert, element) => { element.inert = wasInert; });
      background.clear();
      Object.assign(document.body.style, bodyStyles);
      const scrollBehaviour = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(0, savedScrollY);
      document.documentElement.style.scrollBehavior = scrollBehaviour;
      if (returnFocus) opener.focus({ preventScroll: true });
      const finish = () => { drawer.hidden = true; showPanel('main', false); };
      clearTimeout(closeTimer);
      if (immediate || reducedMotion.matches) finish();
      else closeTimer = setTimeout(finish, 260);
    };

    const openMenu = () => {
      if (isOpen || !mobileQuery.matches) return;
      clearTimeout(closeTimer);
      isOpen = true;
      savedScrollY = window.scrollY;
      bodyStyles = { position: document.body.style.position, top: document.body.style.top, width: document.body.style.width, overflow: document.body.style.overflow };
      showPanel('main', false);
      drawer.hidden = false;
      drawer.inert = false;
      Array.from(document.body.children).forEach((element) => {
        if (!(element instanceof HTMLElement) || element === drawer || ['SCRIPT', 'STYLE'].includes(element.tagName)) return;
        background.set(element, element.inert);
        element.inert = true;
      });
      Object.assign(document.body.style, { position: 'fixed', top: '-' + savedScrollY + 'px', width: '100%', overflow: 'hidden' });
      opener.setAttribute('aria-expanded', 'true');
      drawer.getBoundingClientRect();
      drawer.classList.add('is-open');
      closeButton.focus({ preventScroll: true });
    };

    opener.addEventListener('click', openMenu);
    closeButton.addEventListener('click', () => closeMenu());
    forwards.forEach((button) => button.addEventListener('click', () => showPanel(button.dataset.mobileForward!)));
    drawer.querySelectorAll<HTMLButtonElement>('[data-mobile-back]').forEach((button) => button.addEventListener('click', () => showPanel('main')));
    drawer.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => link.addEventListener('click', () => closeMenu(false)));
    document.addEventListener('keydown', (event) => {
      if (!isOpen) return;
      if (event.key === 'Escape') { event.preventDefault(); closeMenu(); return; }
      if (event.key !== 'Tab') return;
      const focusable = Array.from(drawer.querySelectorAll<HTMLElement>('a[href],button:not([disabled])')).filter((element) => !element.closest('[inert]') && element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    });
    mobileQuery.addEventListener('change', () => { if (!mobileQuery.matches) closeMenu(false, true); });
    document.addEventListener('astro:before-swap', () => { closeMenu(false, true); drawer.remove(); }, { once: true });
  };
  initialiseMobileNavigation();
  document.addEventListener('astro:page-load', initialiseMobileNavigation);
</script>

<style>
  .smc-header {
    position: relative;
    z-index: 40;
    background: #fff;
  }

  .smc-nav-wrap {
    border-bottom: 1px solid rgba(20,40,20,.08);
    background: rgba(255,255,255,.96);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }

  .brand img {
    display: block;
    width: 146px;
    height: auto;
    max-height: 58px;
    object-fit: contain;
  }

  .desktop-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-link {
    position: relative;
    color: #333a33;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 650;
    letter-spacing: -.012em;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 18px;
    bottom: -10px;
    height: 2px;
    border-radius: 2px;
    background: var(--smc-green);
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--smc-green-dark);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-group { position: relative; }
  .nav-group--split { display: flex; align-items: center; gap: 3px; }
  .nav-group--split > .nav-dropdown { position: static; }
  .nav-group--split .nav-dropdown__trigger { width: 20px; min-height: 44px; justify-content: center; }
  .nav-group--split .nav-dropdown__trigger::after { display: none; }

  .nav-dropdown__trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
  }

  .nav-dropdown__trigger::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown__trigger .ph {
    font-size: 13px;
    transition: transform 160ms ease;
  }

  .nav-dropdown[open] .nav-dropdown__trigger .ph {
    transform: rotate(180deg);
  }

  .nav-dropdown__panel {
    position: absolute;
    top: calc(100% + 17px);
    left: 50%;
    z-index: 5;
    width: 272px;
    padding: 9px;
    border: 1px solid rgba(202, 220, 199, .9);
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(255,255,255,.98), rgba(246,250,245,.98));
    box-shadow: 0 22px 44px rgba(13, 52, 23, .14), 0 2px 6px rgba(13, 52, 23, .05);
    backdrop-filter: blur(14px);
    transform: translateX(-50%);
    transform-origin: top center;
    animation: service-menu-in 190ms cubic-bezier(.2,.8,.2,1) both;
  }

  .nav-dropdown__panel a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 13px;
    color: #273b2b;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .service-link-icon {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #e9f3e6;
    color: var(--smc-green-dark);
    font-size: 16px;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .service-link-arrow {
    margin-left: auto;
    color: #66926b;
    font-size: 14px;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 160ms ease, transform 160ms ease, color 160ms ease;
  }

  .nav-dropdown__panel a:hover,
  .nav-dropdown__panel a.active {
    border-color: #dbead8;
    background: #edf6ea;
    color: var(--smc-green-dark);
  }

  .nav-dropdown__panel a:hover { transform: translateX(2px); }
  .nav-dropdown__panel a:hover .service-link-icon,
  .nav-dropdown__panel a.active .service-link-icon { background: var(--smc-green); color: #fff; }
  .nav-dropdown__panel a:hover .service-link-arrow,
  .nav-dropdown__panel a.active .service-link-arrow { opacity: 1; transform: translate(0, 0); color: var(--smc-green-dark); }

  @keyframes service-menu-in {
    from { opacity: 0; transform: translate(-50%, -7px) scale(.97); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  .nav-link:focus-visible {
    outline: 3px solid rgba(47, 111, 45, .16);
    outline-offset: 3px;
    border-radius: 10px;
  }

  .desktop-actions {
    display: flex;
    align-items: center;
    margin-left: 12px;
    padding-left: 0;
    gap: 10px;
  }

  .desktop-actions .smc-button {
    min-height: 47px;
    padding: 0 7px 0 18px;
    gap: 12px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .012em;
    white-space: nowrap;
  }

  .desktop-actions .smc-button .ph {
    width: 31px;
    height: 31px;
    font-size: 16px;
  }

  .header-whatsapp {
    min-height: 47px;
    padding: 0 16px;
    border: 1px solid #c8d8c5;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #fff;
    color: #235d2d;
    box-shadow: 0 5px 14px rgba(24,67,31,.05);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .012em;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .header-whatsapp:hover {
    border-color: #66a860;
    box-shadow: 0 9px 18px rgba(24,67,31,.10);
    transform: translateY(-1px);
  }

  .header-whatsapp .wa-icon {
    width: 18px;
    height: 18px;
  }

  .mobile-menu { display: none; margin-left: auto; }
  .mobile-call {
    display: none; align-items: center; gap: 6px; min-height: 44px; padding: 0 10px; margin-left: auto;
    border-radius: 12px; background: var(--smc-green-soft); color: var(--smc-green-dark);
    font-size: 11px; font-weight: 700; line-height: 1; text-decoration: none; white-space: nowrap;
  }
  .mobile-call .ph { font-size: 18px; }
  .mobile-toggle {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    border: 1px solid var(--smc-line); border-radius: 12px; background: #fff; color: #202420; cursor: pointer;
  }
  .mobile-toggle .ph { font-size: 22px; }
  .mobile-toggle:focus-visible { outline: 3px solid #6c9fc1; outline-offset: 3px; }
  .mobile-drawer[hidden] { display: none !important; }
  .mobile-drawer {
    position: fixed; inset: 0; z-index: 1000; display: grid; grid-template-rows: auto minmax(0,1fr) auto;
    width: 100%; height: 100dvh; padding-top: env(safe-area-inset-top); overflow: hidden; isolation: isolate;
    background: radial-gradient(ellipse at 100% 0,rgba(113,169,102,.14),transparent 55%),linear-gradient(155deg,#173e25,#102e1b);
    color: #fff; opacity: 0; transform: translateY(9px); pointer-events: none;
    transition: opacity 260ms ease,transform 260ms cubic-bezier(.2,.7,.2,1);
  }
