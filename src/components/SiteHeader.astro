---
import { locationOverview, locationGroups, isLocationPageActive, isLocationGroupActive } from '../lib/location-navigation';
import { carManufacturers, manufacturerHref } from '../lib/car-manufacturers';
import { makeLogoForName } from '../lib/make-logos';
const pathname = Astro.url.pathname;
const whatsappUrl = 'https://api.whatsapp.com/send?phone=%2B971557458322';
// Future service routes remain prepared here, but only live routes are exposed in the menu.
const sellMyCarServices = [
  { href: '/sell-my-car/', label: 'Sell My Car', icon: 'ph-car-profile' },
  { href: '/sell-damaged-car/', label: 'Sell Damaged Car', icon: 'ph-car' },
  { href: '/sell-accident-damaged-car/', label: 'Sell Accident-Damaged Car', icon: 'ph-warning-octagon' },
  { href: '/sell-non-running-car/', label: 'Sell Non-Running Car', icon: 'ph-engine' },
  { href: '/sell-car-with-engine-problems/', label: 'Engine Problems', icon: 'ph-wrench' },
  { href: '/sell-car-with-gearbox-problems/', label: 'Gearbox Problems', icon: 'ph-gear-six' },
  { href: '/sell-flood-damaged-car/', label: 'Flood-Damaged Car', icon: 'ph-drop' },
  { href: '/sell-car-with-expired-registration/', label: 'Expired Registration', icon: 'ph-identification-card' },
  { href: null, label: 'Old / Unwanted Cars' },
  { href: null, label: 'Car Removal' },
  { href: null, label: 'Fleet Disposal' }
] as const;
const scrapMyCarServices = [
  { href: '/scrap-my-car/', label: 'Scrap My Car', icon: 'ph-recycle' },
  { href: '/scrap-car-value/', label: 'Scrap Car Value', icon: 'ph-calculator' },
  { href: '/car-removal/', label: 'Car Removal', icon: 'ph-truck' },
  { href: '/scrap-old-car/', label: 'Scrap Old Car', icon: 'ph-car-profile' },
  { href: '/fleet-disposal/', label: 'Fleet Disposal', icon: 'ph-buildings' },
  { href: '/cars/', label: 'Cars by Make', icon: 'ph-car-profile' }
] as const;
const locationPages = [locationOverview, ...locationGroups.flatMap(group => group.items.map(item => ({ ...item, icon: group.icon })))];
const isLocationNavigationActive = pathname === '/locations' || pathname.startsWith('/locations/');
const links = [
  { href: '/', label: 'Home', icon: 'ph-house' },
  { href: '/sell-my-car/', label: 'Sell My Car', icon: 'ph-car-profile', children: sellMyCarServices },
  { href: '/scrap-my-car/', label: 'Scrap My Car', icon: 'ph-recycle', children: scrapMyCarServices },
  { href: '/locations/', label: 'Locations', icon: 'ph-map-trifold', children: locationPages },
  { href: '/contact-us/', label: 'Contact Us', icon: 'ph-chat-circle-text' },
  { href: '/faqs/', label: 'FAQs', icon: 'ph-question' },
  { href: '/blogs', label: 'Blogs', icon: 'ph-newspaper-clipping' }
];

const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(href + '/');
// Keep Dubai highlighted for published child guides; the UAE overview stays exact.
const isNavigationItemActive = (href: string) => href.startsWith('/locations/') && href !== '/locations/'
  ? pathname === href.slice(0, -1) || pathname.startsWith(href)
  : isActive(href);
const visibleSellMyCarServices = sellMyCarServices.filter(
  (service): service is { href: string; label: string; icon: string } => Boolean(service.href)
);
const mobileServiceGroups = [
  { id: 'sell', href: '/sell-my-car/', label: 'Sell My Car', description: 'Find the right route for your vehicle.', items: visibleSellMyCarServices },
  { id: 'scrap', href: '/scrap-my-car/', label: 'Scrap My Car', description: 'Value, collection and disposal options.', items: scrapMyCarServices },
  { id: 'locations', href: '/locations/', label: 'Locations', description: 'Explore UAE collection coverage and local access guides.', overviewLabel: 'View all UAE locations', items: locationPages }
];
const isScrapMyCarServiceActive = scrapMyCarServices.some((service) => isActive(service.href)) || pathname.startsWith('/cars/');
---

<header class="smc-header">
  <div class="smc-nav-wrap">
    <div class="smc-container nav-inner">
      <a class="brand" href="/" aria-label="Scrap My Car UAE home">
        <img
          src="https://static.wixstatic.com/media/ff8df3_ee2506a8a7ed4752b5b7832449c71105~mv2.png"
          alt="Scrap My Car UAE"
          width="155"
          height="60"
        />
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        {links.map((link) => link.children ? (
          <div class:list={['nav-group', { 'nav-group--locations': link.href === '/locations/', 'nav-group--scrap': link.href === '/scrap-my-car/', 'nav-group--split': true }]}>
          {link.href === '/sell-my-car/' && <a href={link.href} class:list={['nav-link', { active: link.children.some(service => service.href && isActive(service.href)) }]}>{link.label}</a>}
          {link.href === '/scrap-my-car/' && <a href={link.href} class:list={['nav-link', { active: isScrapMyCarServiceActive }]}>{link.label}</a>}
          {link.href === '/locations/' && <a href={link.href} class:list={['nav-link', { active: isLocationNavigationActive }]} aria-current={isLocationPageActive(pathname, link.href) ? 'page' : undefined}>{link.label}</a>}
          <details data-desktop-dropdown class:list={['nav-dropdown', { active: link.href === '/locations/' ? isLocationNavigationActive : link.children.some((service) => service.href && (isActive(service.href) || (service.href === '/cars/' && pathname.startsWith('/cars/')))) }]}>
            <summary class="nav-link nav-dropdown__trigger" aria-expanded="false" aria-label={link.href === '/scrap-my-car/' ? 'Show Scrap My Car services' : link.href === '/locations/' ? 'Show Locations' : 'Show Sell My Car services'}>

              <i class="ph ph-caret-down" aria-hidden="true"></i>
            </summary>
            {link.href === '/locations/' ? (
              <div class="nav-dropdown__panel locations-mega" role="region" aria-label="UAE location guides" tabindex="0">
                <div class="locations-mega__intro">
                  <a href={locationOverview.href} class:list={{ active: isLocationPageActive(pathname, locationOverview.href) }} aria-current={isLocationPageActive(pathname, locationOverview.href) ? 'page' : undefined}>
                    <span class="service-link-icon"><i class:list={['ph', locationOverview.icon]} aria-hidden="true"></i></span><span>{locationOverview.label}</span>
                  </a>
                  <span class="locations-mega__note">Choose your area</span>
                </div>
                <div class="locations-mega__columns">
                  {locationGroups.map(group => <section class:list={['locations-mega__group', { 'is-current-group': isLocationGroupActive(pathname, group) }]} aria-labelledby={'desktop-location-' + group.id}>
                    <h2 id={'desktop-location-' + group.id}><i class:list={['ph', group.icon]} aria-hidden="true"></i>{group.label}</h2>
                    {group.items.map(item => <a href={item.href} class:list={{ active: isLocationPageActive(pathname, item.href) }} aria-current={isLocationPageActive(pathname, item.href) ? 'page' : undefined}>{item.label}</a>)}
                  </section>)}
                </div>
              </div>
            ) : link.href === '/scrap-my-car/' ? <div class="nav-dropdown__panel scrap-mega" role="region" aria-label="Scrap services and manufacturers">
              <section><h2>Scrap services</h2>{scrapMyCarServices.map(service=><a href={service.href} class:list={{active:isActive(service.href)}} aria-current={isActive(service.href)?'page':undefined}><span class="service-link-icon"><i class:list={['ph',service.icon]} aria-hidden="true"></i></span>{service.label}</a>)}</section>
              <section class="scrap-makes"><h2>Explore by manufacturer</h2><div>{carManufacturers.map(make=><a href={manufacturerHref(make.slug)} aria-current={pathname===manufacturerHref(make.slug)?'page':undefined}><span class="manufacturer-logo"><img src={makeLogoForName(make.make)} alt="" width="32" height="32" /></span><span>{make.name}</span><i class="ph ph-caret-right" aria-hidden="true"></i></a>)}</div></section>
            </div> : <div class="nav-dropdown__panel">
              {link.children.filter((service) => service.href).map((service) => (
                <a href={service.href} class:list={{ active: isNavigationItemActive(service.href) }} aria-current={isActive(service.href) ? 'page' : undefined}>
                  <span class="service-link-icon"><i class:list={['ph', service.icon]} aria-hidden="true"></i></span>
                  <span>{service.label}</span>
                  <i class="ph ph-arrow-up-right service-link-arrow" aria-hidden="true"></i>
                </a>
              ))}
            </div>}
          </details>
          </div>
        ) : (
          <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>{link.label}</a>
        ))}
      </nav>

      <div class="desktop-actions">
        <a class="header-phone" href="tel:+971557458322" aria-label="Call Scrap My Car UAE on 055 745 83 22">
          <i class="ph ph-phone-call" aria-hidden="true"></i>
          <span class="header-phone-copy"><span>Speak to our team</span><strong>055 745 83 22</strong></span>
        </a>
        <a class="smc-button smc-button-primary" href="/free-quote" data-analytics-quote-cta="header_desktop">
          <span>Free Valuation</span>
          <i class="ph ph-calculator" aria-hidden="true"></i>
        </a>
        <a class="header-whatsapp" href={whatsappUrl} aria-label="Chat on WhatsApp" target="_blank" rel="noopener noreferrer" data-analytics-whatsapp="header_desktop">
          <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
          <span>WhatsApp</span>
        </a>
      </div>

      <a class="mobile-call" href="tel:+971557458322" aria-label="Call Scrap My Car UAE on 055 745 83 22">
        <i class="ph ph-phone-call" aria-hidden="true"></i>
        <span>055 745 83 22</span>
      </a>

      <div class="mobile-menu">
        <button class="mobile-toggle" type="button" aria-label="Open navigation" aria-controls="mobile-drawer" aria-expanded="false"><i class="ph ph-list" aria-hidden="true"></i></button>
        <div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Site navigation" hidden>
          <div class="mobile-drawer__header">
            <a class="mobile-drawer__brand" href="/" aria-label="Scrap My Car UAE home">
              <img src="https://static.wixstatic.com/media/ff8df3_ee2506a8a7ed4752b5b7832449c71105~mv2.png" alt="Scrap My Car UAE" width="155" height="60" />
            </a>
            <div class="mobile-drawer__header-actions">
              <span class="mobile-drawer__label">Menu</span>
              <button class="mobile-close" type="button" data-mobile-close aria-label="Close navigation"><i class="ph ph-x" aria-hidden="true"></i></button>
            </div>
          </div>
          <div class="mobile-stage">
            <nav class="mobile-view mobile-view--main is-active" data-mobile-view="main" aria-label="Main mobile navigation">
              <p class="mobile-view__eyebrow">Explore our services</p>
              {links.map((link) => link.children ? (
                <button type="button" class:list={['mobile-row', 'mobile-row--category', { active: link.href === '/locations/' ? isLocationNavigationActive : link.href === '/scrap-my-car/' ? isScrapMyCarServiceActive : mobileServiceGroups.find((group) => group.href === link.href)?.items.some((item) => isActive(item.href)) }]} data-mobile-forward={mobileServiceGroups.find((group) => group.href === link.href)?.id} aria-controls={'mobile-view-' + mobileServiceGroups.find((group) => group.href === link.href)?.id} aria-expanded="false">
                  <span class="mobile-row__icon"><i class:list={['ph', link.icon]} aria-hidden="true"></i></span><span>{link.label}</span><i class="ph ph-arrow-right mobile-row__arrow" aria-hidden="true"></i>
                </button>
              ) : (
                <a class:list={['mobile-row', { active: isActive(link.href) }]} href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}><span class="mobile-row__icon"><i class:list={['ph', link.icon]} aria-hidden="true"></i></span><span>{link.label}</span><i class="ph ph-caret-right mobile-row__arrow" aria-hidden="true"></i></a>
              ))}
            </nav>
            {mobileServiceGroups.map((group) => (
              <section class="mobile-view" data-mobile-view={group.id} id={'mobile-view-' + group.id} aria-labelledby={'mobile-heading-' + group.id} aria-hidden="true" inert>
                <div class="mobile-subheading"><button type="button" class="mobile-back" data-mobile-back aria-label="Back to main navigation"><i class="ph ph-arrow-left" aria-hidden="true"></i>Back</button><h2 id={'mobile-heading-' + group.id}>{group.label}</h2></div>
                <p class="mobile-view__description">{group.description}</p>
                <nav aria-label={group.label + (group.id === 'locations' ? ' navigation' : ' services')}>
                  {group.id === 'scrap' && <button type="button" class:list={['mobile-row', { active: pathname === '/cars' || pathname.startsWith('/cars/') }]} data-mobile-forward="manufacturers" aria-controls="mobile-view-manufacturers" aria-expanded="false"><span class="mobile-row__icon"><i class="ph ph-car-profile" aria-hidden="true"></i></span><span>Choose a manufacturer</span><i class="ph ph-arrow-right mobile-row__arrow" aria-hidden="true"></i></button>}
                  {group.id === 'locations' ? <>
                    <a class:list={['mobile-row', 'mobile-row--overview', { active: isLocationPageActive(pathname, locationOverview.href) }]} href={locationOverview.href} aria-current={isLocationPageActive(pathname, locationOverview.href) ? 'page' : undefined}><span class="mobile-row__icon"><i class:list={['ph', locationOverview.icon]} aria-hidden="true"></i></span><span>View All UAE Locations</span><i class="ph ph-caret-right mobile-row__arrow" aria-hidden="true"></i></a>
                    {locationGroups.map(location => <button type="button" class:list={['mobile-row', { active: isLocationGroupActive(pathname, location) }]} data-mobile-forward={'location-' + location.id} aria-controls={'mobile-view-location-' + location.id} aria-expanded="false"><span class="mobile-row__icon"><i class:list={['ph', location.icon]} aria-hidden="true"></i></span><span>{location.label}</span><i class="ph ph-arrow-right mobile-row__arrow" aria-hidden="true"></i></button>)}
                  </> : group.items.map((item, index) => <a class:list={['mobile-row', { 'mobile-row--overview': index === 0, active: isNavigationItemActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}><span class="mobile-row__icon"><i class:list={['ph', item.icon]} aria-hidden="true"></i></span><span>{index === 0 ? ('overviewLabel' in group ? group.overviewLabel : 'View all ' + group.label) : item.label}</span><i class="ph ph-caret-right mobile-row__arrow" aria-hidden="true"></i></a>)}
                </nav>
              </section>
            ))}
            <section class="mobile-view" data-mobile-view="manufacturers" id="mobile-view-manufacturers" aria-labelledby="mobile-heading-manufacturers" aria-hidden="true" inert>
              <div class="mobile-subheading"><button type="button" class="mobile-back" data-mobile-back="scrap" aria-label="Back to Scrap My Car"><i class="ph ph-arrow-left" aria-hidden="true"></i>Back</button><h2 id="mobile-heading-manufacturers">Manufacturers</h2></div>
              <p class="mobile-view__description">Find guidance for your make.</p><nav aria-label="Manufacturer pages"><a class="mobile-row mobile-row--overview" href="/cars/"><span class="mobile-row__icon"><i class="ph ph-car-profile" aria-hidden="true"></i></span><span>All car makes</span></a>{carManufacturers.map(make=><a class:list={['mobile-row', 'mobile-manufacturer', {active:pathname===manufacturerHref(make.slug)}]} href={manufacturerHref(make.slug)} aria-current={pathname===manufacturerHref(make.slug)?'page':undefined}><span class="manufacturer-logo"><img src={makeLogoForName(make.make)} alt="" width="32" height="32" /></span><span>{make.name}</span><i class="ph ph-caret-right mobile-row__arrow" aria-hidden="true"></i></a>)}</nav>
            </section>
            {locationGroups.map(group => <section class="mobile-view mobile-view--location" data-mobile-view={'location-' + group.id} id={'mobile-view-location-' + group.id} aria-labelledby={'mobile-heading-location-' + group.id} aria-hidden="true" inert>
              <div class="mobile-subheading"><button type="button" class="mobile-back" data-mobile-back="locations" aria-label="Back to Locations"><i class="ph ph-arrow-left" aria-hidden="true"></i>Back</button><h2 id={'mobile-heading-location-' + group.id}>{group.label}</h2></div>
              <p class="mobile-view__description">Choose a location guide.</p>
              <nav aria-label={group.label + ' location pages'}>
                {group.items.map(item => <a class:list={['mobile-row', { active: isLocationPageActive(pathname, item.href) }]} href={item.href} aria-current={isLocationPageActive(pathname, item.href) ? 'page' : undefined}><span class="mobile-row__icon"><i class:list={['ph', group.icon]} aria-hidden="true"></i></span><span>{item.label}</span><i class="ph ph-caret-right mobile-row__arrow" aria-hidden="true"></i></a>)}
              </nav>
            </section>)}
          </div>
          <div class="mobile-menu-actions">
            <a class="mobile-quote" href="/free-quote" data-analytics-quote-cta="header_mobile"><span class="mobile-action-icon"><i class="ph ph-calculator" aria-hidden="true"></i></span>Value My Car</a>
            <a class="mobile-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-analytics-whatsapp="header_mobile"><img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const initialiseDesktopNavigation = () => {
    const header = document.querySelector<HTMLElement>('.smc-header');
    if (!header || header.dataset.desktopReady) return;
    header.dataset.desktopReady = 'true';
    header.querySelector('.desktop-nav')?.setAttribute('data-enhanced', '');
    const controller = new AbortController();
    const { signal } = controller;
    const hover = matchMedia('(min-width: 1101px) and (hover: hover) and (pointer: fine)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const menus = Array.from(header.querySelectorAll<HTMLDetailsElement>('.nav-dropdown'));
    const timers = new Map<HTMLDetailsElement, ReturnType<typeof setTimeout>>();
    const cancel = (menu: HTMLDetailsElement) => { clearTimeout(timers.get(menu)); timers.delete(menu); };
    const close = (menu: HTMLDetailsElement, immediate = false) => {
      cancel(menu);
      menu.classList.remove('is-expanded');
      menu.querySelector('summary')?.setAttribute('aria-expanded', 'false');
      const panel = menu.querySelector<HTMLElement>('.nav-dropdown__panel')!;
      panel.inert = true;
      panel.setAttribute('aria-hidden', 'true');
      if (immediate || reducedMotion.matches) menu.open = false;
      else timers.set(menu, setTimeout(() => { menu.open = false; timers.delete(menu); }, 220));
    };
    const open = (menu: HTMLDetailsElement) => {
      menus.filter(other => other !== menu).forEach(other => close(other, true));
      cancel(menu);
      menu.open = true;
      const panel = menu.querySelector<HTMLElement>('.nav-dropdown__panel')!;
      panel.inert = false;
      panel.removeAttribute('aria-hidden');
      panel.getBoundingClientRect();
      menu.classList.add('is-expanded');
      menu.querySelector('summary')?.setAttribute('aria-expanded', 'true');
    };
    menus.forEach(menu => {
      const group = menu.closest<HTMLElement>('.nav-group')!;
      const trigger = menu.querySelector<HTMLElement>('summary')!;
      trigger.addEventListener('click', event => {
        event.preventDefault();
        if (menu.classList.contains('is-expanded')) close(menu); else open(menu);
      }, { signal });
      trigger.addEventListener('keydown', event => {
        if (event.key !== 'ArrowDown') return;
        event.preventDefault(); open(menu);
        menu.querySelector<HTMLElement>('.nav-dropdown__panel a')?.focus();
      }, { signal });
      group.addEventListener('pointerenter', event => { if (hover.matches && event.pointerType !== 'touch') open(menu); }, { signal });
      group.addEventListener('pointerleave', event => {
        if (!hover.matches || event.pointerType === 'touch' || group.contains(document.activeElement)) return;
        cancel(menu);
        timers.set(menu, setTimeout(() => close(menu), 140));
      }, { signal });
      group.addEventListener('focusin', () => { if (menu.classList.contains('is-expanded')) cancel(menu); }, { signal });
      group.addEventListener('focusout', event => {
        if (event.relatedTarget instanceof Node && group.contains(event.relatedTarget)) return;
        if (!(hover.matches && group.matches(':hover'))) close(menu);
      }, { signal });
    });
    document.addEventListener('pointerdown', event => {
      menus.forEach(menu => { if (!(event.target instanceof Node) || !menu.closest('.nav-group')?.contains(event.target)) close(menu); });
    }, { signal });
    header.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      const menu = menus.find(menu => menu.classList.contains('is-expanded'));
      if (!menu) return;
      event.preventDefault(); close(menu);
      menu.querySelector<HTMLElement>('summary')?.focus();
    }, { signal });
    hover.addEventListener('change', () => menus.forEach(menu => close(menu, true)), { signal });
    document.addEventListener('astro:before-swap', () => {
      menus.forEach(menu => close(menu, true));
      controller.abort(); delete header.dataset.desktopReady;
    }, { once: true, signal });
  };
  initialiseDesktopNavigation();
  document.addEventListener('astro:page-load', initialiseDesktopNavigation);

  const initialiseMobileNavigation = () => {
    const opener = document.querySelector<HTMLButtonElement>('.mobile-toggle');
    const drawer = document.querySelector<HTMLElement>('.mobile-drawer');
    if (!opener || !drawer || drawer.dataset.ready) return;
    drawer.dataset.ready = 'true';
    const mobileController = new AbortController();
    const mobileSignal = mobileController.signal;
    // Mount at body level so header backdrop-filter cannot constrain the fixed drawer.
    document.body.append(drawer);
    const closeButton = drawer.querySelector<HTMLButtonElement>('[data-mobile-close]')!;
    const views = Array.from(drawer.querySelectorAll<HTMLElement>('[data-mobile-view]'));
    const forwards = Array.from(drawer.querySelectorAll<HTMLButtonElement>('[data-mobile-forward]'));
    const mobileQuery = window.matchMedia('(max-width: 1100px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isOpen = false;
    let savedScrollY = 0;
    let closeTimer: ReturnType<typeof setTimeout>;
    let bodyStyles = { position: '', top: '', width: '', overflow: '' };
    const background = new Map<HTMLElement, boolean>();

    const showPanel = (name: string, moveFocus = true, returning = false) => {
      views.forEach((view) => {
        const active = view.dataset.mobileView === name;
        view.classList.toggle('is-active', active);
        view.classList.toggle('is-behind', name !== 'main' && (view.dataset.mobileView === 'main' || (name.startsWith('location-') && view.dataset.mobileView === 'locations') || (name === 'manufacturers' && view.dataset.mobileView === 'scrap')));
        view.inert = !active;
        view.setAttribute('aria-hidden', String(!active));
        if (active) view.scrollTop = 0;
      });
      forwards.forEach((button) => button.setAttribute('aria-expanded', String(button.dataset.mobileForward === name || (button.dataset.mobileForward === 'locations' && name.startsWith('location-')) || (button.dataset.mobileForward === 'scrap' && name === 'manufacturers'))));
      if (moveFocus) {
        const target = returning || name === 'main'
          ? forwards.find((button) => button.dataset.mobileForward === drawer.dataset.panel)
          : drawer.querySelector<HTMLButtonElement>('#mobile-view-' + name + ' [data-mobile-back]');
        target?.focus({ preventScroll: true });
      }
      drawer.dataset.panel = name;
    };

    const closeMenu = (returnFocus = true, immediate = false) => {
      if (!isOpen) return;
      isOpen = false;
      opener.setAttribute('aria-expanded', 'false');
      drawer.classList.remove('is-open');
      drawer.inert = true;
      background.forEach((wasInert, element) => { element.inert = wasInert; });
      background.clear();
      Object.assign(document.body.style, bodyStyles);
      const scrollBehaviour = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(0, savedScrollY);
      document.documentElement.style.scrollBehavior = scrollBehaviour;
      if (returnFocus) opener.focus({ preventScroll: true });
      const finish = () => { drawer.hidden = true; showPanel('main', false); };
      clearTimeout(closeTimer);
      if (immediate || reducedMotion.matches) finish();
      else closeTimer = setTimeout(finish, 260);
    };

    const openMenu = () => {
      if (isOpen || !mobileQuery.matches) return;
      clearTimeout(closeTimer);
      isOpen = true;
      savedScrollY = window.scrollY;
      bodyStyles = { position: document.body.style.position, top: document.body.style.top, width: document.body.style.width, overflow: document.body.style.overflow };
      showPanel('main', false);
      drawer.hidden = false;
      drawer.inert = false;
      Array.from(document.body.children).forEach((element) => {
