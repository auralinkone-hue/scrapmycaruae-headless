---
const pathname = Astro.url.pathname;
const whatsappUrl = 'https://api.whatsapp.com/send?phone=%2B971557458322';
// Future service routes remain prepared here, but only live routes are exposed in the menu.
const sellMyCarServices = [
  { href: '/sell-my-car/', label: 'Sell My Car', icon: 'ph-car-profile' },
  { href: '/sell-damaged-car/', label: 'Sell Damaged Car', icon: 'ph-car' },
  { href: '/sell-accident-damaged-car/', label: 'Sell Accident-Damaged Car', icon: 'ph-warning-octagon' },
  { href: '/sell-non-running-car/', label: 'Sell Non-Running Car', icon: 'ph-engine' },
  { href: '/sell-car-with-engine-problems/', label: 'Engine Problems', icon: 'ph-wrench' },
  { href: null, label: 'Gearbox Problems' },
  { href: null, label: 'Old / Unwanted Cars' },
  { href: null, label: 'Car Removal' },
  { href: null, label: 'Fleet Disposal' }
] as const;
const links = [
  { href: '/', label: 'Home', icon: 'ph-house' },
  { href: '/sell-my-car/', label: 'Sell My Car', icon: 'ph-car-profile', children: sellMyCarServices },
  { href: '/contact-us', label: 'Contact Us', icon: 'ph-chat-circle-text' },
  { href: '/faqs', label: 'FAQs', icon: 'ph-question' },
  { href: '/blogs', label: 'Blogs', icon: 'ph-newspaper-clipping' }
];

const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(href + '/');
const visibleSellMyCarServices = sellMyCarServices.filter(
  (service): service is { href: string; label: string; icon: string } => Boolean(service.href)
);
const isSellMyCarServiceActive = visibleSellMyCarServices.some((service) => isActive(service.href));
---

<header class="smc-header">
  <div class="smc-nav-wrap">
    <div class="smc-container nav-inner">
      <a class="brand" href="/" aria-label="Scrap My Car UAE home">
        <img
          src="https://static.wixstatic.com/media/ff8df3_ee2506a8a7ed4752b5b7832449c71105~mv2.png"
          alt="Scrap My Car UAE"
          width="155"
          height="60"
        />
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        {links.map((link) => link.children ? (
          <details class:list={['nav-dropdown', { active: isSellMyCarServiceActive }]}>
            <summary class="nav-link nav-dropdown__trigger">
              {link.label}
              <i class="ph ph-caret-down" aria-hidden="true"></i>
            </summary>
            <div class="nav-dropdown__panel">
              {visibleSellMyCarServices.map((service) => (
                <a href={service.href} class:list={{ active: isActive(service.href) }}>
                  <span class="service-link-icon"><i class:list={['ph', service.icon]} aria-hidden="true"></i></span>
                  <span>{service.label}</span>
                  <i class="ph ph-arrow-up-right service-link-arrow" aria-hidden="true"></i>
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>{link.label}</a>
        ))}
      </nav>

      <div class="desktop-actions">
        <a class="smc-button smc-button-primary" href="/free-quote" data-analytics-quote-cta="header_desktop">
          <span>Value My Car</span>
          <i class="ph ph-calculator" aria-hidden="true"></i>
        </a>
        <a class="header-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-analytics-whatsapp="header_desktop">
          <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
          <span>WhatsApp</span>
        </a>
      </div>

      <a class="mobile-call" href="tel:+971557458322" aria-label="Call Scrap My Car UAE on 055 745 83 22">
        <i class="ph ph-phone-call" aria-hidden="true"></i>
        <span>055 745 83 22</span>
      </a>

      <details class="mobile-menu">
        <summary aria-label="Open navigation">
          <i class="ph ph-list menu-open-icon" aria-hidden="true"></i>
          <i class="ph ph-x menu-close-icon" aria-hidden="true"></i>
        </summary>
        <div class="mobile-panel">
          <p class="mobile-menu-kicker">Navigation</p>
          <a href="/" class:list={['mobile-link', { active: isActive('/') }]}>
            <i class="ph ph-house" aria-hidden="true"></i>
            Home
            <i class="ph ph-caret-right mobile-link-arrow" aria-hidden="true"></i>
          </a>
          <details class:list={['mobile-services', { active: isSellMyCarServiceActive }]}>
            <summary class="mobile-link">
              <i class="ph ph-car-profile" aria-hidden="true"></i>
              Sell My Car
              <i class="ph ph-caret-down mobile-link-arrow" aria-hidden="true"></i>
            </summary>
            <div class="mobile-services__links">
              {visibleSellMyCarServices.map((service) => (
                <a href={service.href} class:list={{ active: isActive(service.href) }}>
                  <span class="service-link-icon"><i class:list={['ph', service.icon]} aria-hidden="true"></i></span>
                  <span>{service.label}</span>
                  <i class="ph ph-arrow-up-right service-link-arrow" aria-hidden="true"></i>
                </a>
              ))}
            </div>
          </details>
          <a href="/contact-us" class:list={['mobile-link', { active: isActive('/contact-us') }]}>
            <i class="ph ph-chat-circle-text" aria-hidden="true"></i>
            Contact Us
            <i class="ph ph-caret-right mobile-link-arrow" aria-hidden="true"></i>
          </a>
          <a href="/faqs" class:list={['mobile-link', { active: isActive('/faqs') }]}>
            <i class="ph ph-question" aria-hidden="true"></i>
            FAQs
            <i class="ph ph-caret-right mobile-link-arrow" aria-hidden="true"></i>
          </a>
          <a href="/blogs" class:list={['mobile-link', { active: isActive('/blogs') }]}>
            <i class="ph ph-newspaper-clipping" aria-hidden="true"></i>
            Blogs
            <i class="ph ph-caret-right mobile-link-arrow" aria-hidden="true"></i>
          </a>
          <div class="mobile-menu-actions">
            <a class="smc-button smc-button-primary mobile-quote" href="/free-quote" data-analytics-quote-cta="header_mobile">
              <i class="ph ph-calculator" aria-hidden="true"></i>
              Value My Car
            </a>
            <a class="mobile-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
              Chat on WhatsApp
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const mobileQuery = window.matchMedia('(max-width: 640px)');

  if (mobileMenu) {
    let savedScrollY = 0;
    let locked = false;
    let savedBodyStyles = {
      position: '',
      top: '',
      width: '',
      overflow: ''
    };

    const lockPage = () => {
      if (locked || !mobileQuery.matches) return;

      savedScrollY = window.scrollY;
      savedBodyStyles = {
        position: document.body.style.position,
        top: document.body.style.top,
        width: document.body.style.width,
        overflow: document.body.style.overflow
      };
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
      locked = true;
    };

    const unlockPage = () => {
      if (!locked) return;

      document.body.style.position = savedBodyStyles.position;
      document.body.style.top = savedBodyStyles.top;
      document.body.style.width = savedBodyStyles.width;
      document.body.style.overflow = savedBodyStyles.overflow;
      window.scrollTo(0, savedScrollY);
      locked = false;
    };

    mobileMenu.addEventListener('toggle', () => {
      if (mobileMenu.open) lockPage();
      else unlockPage();
    });

    mobileMenu.querySelectorAll<HTMLAnchorElement>('.mobile-panel a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.open = false;
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileMenu.open) {
        mobileMenu.open = false;
        mobileMenu.querySelector<HTMLElement>('summary')?.focus();
      }
    });

    mobileQuery.addEventListener('change', () => {
      if (!mobileQuery.matches && mobileMenu.open) mobileMenu.open = false;
      if (!mobileQuery.matches) unlockPage();
    });
  }
</script>

<style>
  .smc-header {
    position: relative;
    z-index: 40;
    background: #fff;
  }

  .smc-nav-wrap {
    border-bottom: 1px solid rgba(20,40,20,.08);
    background: rgba(255,255,255,.96);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }

  .brand img {
    display: block;
    width: 146px;
    height: auto;
    max-height: 58px;
    object-fit: contain;
  }

  .desktop-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    position: relative;
    color: #333a33;
    text-decoration: none;
    font-size: 14px;
    font-weight: 650;
    letter-spacing: -.012em;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 18px;
    bottom: -10px;
    height: 2px;
    border-radius: 2px;
    background: var(--smc-green);
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--smc-green-dark);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown__trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
  }

  .nav-dropdown__trigger::-webkit-details-marker,
  .mobile-services summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown__trigger .ph {
    font-size: 13px;
    transition: transform 160ms ease;
  }

  .nav-dropdown[open] .nav-dropdown__trigger .ph {
    transform: rotate(180deg);
  }

  .nav-dropdown__panel {
    position: absolute;
    top: calc(100% + 17px);
    left: 50%;
    z-index: 5;
    width: 272px;
    padding: 9px;
    border: 1px solid rgba(202, 220, 199, .9);
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(255,255,255,.98), rgba(246,250,245,.98));
    box-shadow: 0 22px 44px rgba(13, 52, 23, .14), 0 2px 6px rgba(13, 52, 23, .05);
    backdrop-filter: blur(14px);
    transform: translateX(-50%);
    transform-origin: top center;
    animation: service-menu-in 190ms cubic-bezier(.2,.8,.2,1) both;
  }

  .nav-dropdown__panel a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 13px;
    color: #273b2b;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .service-link-icon {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #e9f3e6;
    color: var(--smc-green-dark);
    font-size: 16px;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .service-link-arrow {
    margin-left: auto;
    color: #66926b;
    font-size: 14px;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 160ms ease, transform 160ms ease, color 160ms ease;
  }

  .nav-dropdown__panel a:hover,
  .nav-dropdown__panel a.active {
    border-color: #dbead8;
    background: #edf6ea;
    color: var(--smc-green-dark);
  }

  .nav-dropdown__panel a:hover { transform: translateX(2px); }
  .nav-dropdown__panel a:hover .service-link-icon,
  .nav-dropdown__panel a.active .service-link-icon { background: var(--smc-green); color: #fff; }
  .nav-dropdown__panel a:hover .service-link-arrow,
  .nav-dropdown__panel a.active .service-link-arrow { opacity: 1; transform: translate(0, 0); color: var(--smc-green-dark); }

  @keyframes service-menu-in {
    from { opacity: 0; transform: translate(-50%, -7px) scale(.97); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  .nav-link:focus-visible,
  .mobile-link:focus-visible,
  .mobile-menu > summary:focus-visible {
    outline: 3px solid rgba(47, 111, 45, .16);
    outline-offset: 3px;
    border-radius: 10px;
  }

  .desktop-actions {
    display: flex;
    align-items: center;
    margin-left: 20px;
    padding-left: 6px;
    gap: 10px;
  }

  .desktop-actions .smc-button {
    min-height: 47px;
    padding: 0 7px 0 18px;
    gap: 12px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .012em;
    white-space: nowrap;
  }

  .desktop-actions .smc-button .ph {
    width: 31px;
    height: 31px;
    font-size: 16px;
  }

  .header-whatsapp {
    min-height: 47px;
    padding: 0 16px;
    border: 1px solid #c8d8c5;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #fff;
    color: #235d2d;
    box-shadow: 0 5px 14px rgba(24,67,31,.05);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .012em;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .header-whatsapp:hover {
    border-color: #66a860;
    box-shadow: 0 9px 18px rgba(24,67,31,.10);
    transform: translateY(-1px);
  }

  .header-whatsapp .wa-icon {
    width: 18px;
    height: 18px;
  }

  .mobile-menu {
    display: none;
    margin-left: auto;
    position: relative;
  }

  .mobile-call {
    display: none;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 10px;
    margin-left: auto;
    border-radius: 12px;
    background: var(--smc-green-soft);
    color: var(--smc-green-dark);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .mobile-call .ph {
    font-size: 18px;
  }

  .mobile-menu > summary {
    width: 44px;
    height: 44px;
    border: 1px solid var(--smc-line);
    border-radius: 12px;
    display: grid;
    place-content: center;
    gap: 4px;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu > summary .ph {
    color: #202420;
    font-size: 22px;
  }

  .menu-close-icon {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: 54px;
    width: min(310px, calc(100vw - 30px));
    padding: 13px;
    border: 1px solid var(--smc-line);
    border-radius: 20px;
    background: linear-gradient(145deg, #fff, #f6faf5);
    box-shadow: 0 22px 48px rgba(13,52,23,.14);
    display: grid;
    gap: 4px;
  }

  .mobile-link {
    color: #202420;
    padding: 13px 14px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 650;
  }

  .mobile-services {
    margin: 0;
    width: 100%;
  }

  .mobile-services > summary.mobile-link {
    width: 100%;
    height: auto;
    min-height: 58px;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    list-style: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .mobile-services__links {
    display: grid;
    gap: 4px;
    margin: 6px 0 9px 17px;
    padding: 7px;
    border: 1px solid #dce9d9;
    border-radius: 14px;
    background: rgba(237,246,234,.55);
    transform-origin: top;
  }

  .mobile-services[open] .mobile-services__links {
    animation: mobile-service-links-in 180ms ease-out both;
  }

  .mobile-services__links a {
    min-height: 42px;
    padding: 7px 9px;
    display: flex;
    align-items: center;
    gap: 9px;
    border-radius: 10px;
    color: #4f5b51;
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
  }

  .mobile-services__links .service-link-icon {
    width: 27px;
    height: 27px;
    flex-basis: 27px;
    border-radius: 8px;
    font-size: 14px;
  }

  .mobile-services__links .service-link-arrow {
    opacity: .7;
    transform: none;
  }

  .mobile-services__links a:hover,
  .mobile-services__links a.active {
    background: var(--smc-green-soft);
    color: var(--smc-green-dark);
  }

  .mobile-services[open] .mobile-link-arrow {
    transform: rotate(180deg);
  }

  @keyframes mobile-service-links-in {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mobile-link > .ph:first-child {
    font-size: 20px;
  }

  .mobile-link-arrow {
    margin-left: auto;
    font-size: 17px;
    opacity: .5;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--smc-green-dark);
    background: var(--smc-green-soft);
  }

  .mobile-quote {
    margin-top: 8px;
  }

  .mobile-menu-actions {
    display: grid;
  }

  .mobile-whatsapp {
    padding: 11px;
    color: var(--smc-green-dark);
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
  }

  @media (max-width: 1100px) {
    .desktop-nav,
    .desktop-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .mobile-link {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .nav-dropdown { display: none; }
  }

  @media (max-width: 640px) {
    .nav-inner {
      min-height: 66px;
    }

    .brand img {
      width: 128px;
    }

    .nav-inner { gap: 12px; }

    .mobile-call {
      display: inline-flex;
    }

    .mobile-menu > summary {
      width: 44px;
      height: 44px;
    }

    .mobile-menu {
      position: static;
      margin-left: 0;
    }

    .mobile-panel {
      position: fixed;
      top: 66px;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 39;
      width: auto;
      min-height: calc(100dvh - 66px);
      padding: 24px 24px max(24px, env(safe-area-inset-bottom));
      border: 0;
      border-top: 1px solid rgba(255,255,255,.12);
      border-radius: 0;
      background:
        radial-gradient(circle at 92% 4%, rgba(133,202,116,.14), transparent 28%),
        #123816;
      box-shadow: none;
      align-content: start;
      gap: 0;
      overflow-y: auto;
      animation: mobile-menu-in 200ms cubic-bezier(.2,.8,.2,1) both;
    }

    .mobile-menu-kicker {
      margin: 0 0 14px;
      color: #a9caa7;
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .mobile-link {
      min-height: 58px;
      padding: 14px 2px;
      border: 0;
      border-bottom: 1px solid rgba(255,255,255,.14);
      border-radius: 0;
      background: transparent;
      color: #fff;
      font-size: 18px;
      font-weight: 650;
    }

    .mobile-link > .ph:first-child { color: #9bd394; }
    .mobile-link-arrow { color: #fff; opacity: .65; }

    .mobile-link:hover,
    .mobile-link.active {
      color: #fff;
      background: transparent;
    }

    .mobile-services__links {
      margin: 0;
      padding: 8px 0 10px 32px;
      border: 0;
      border-bottom: 1px solid rgba(255,255,255,.14);
      border-radius: 0;
      background: transparent;
    }

    .mobile-services__links a {
      min-height: 44px;
      padding: 8px 0;
      color: #d5e7d3;
      font-size: 15px;
    }

    .mobile-services__links a:hover,
    .mobile-services__links a.active {
      background: transparent;
      color: #fff;
    }

    .mobile-services__links .service-link-icon {
      background: rgba(155,211,148,.12);
      color: #a9df9f;
    }

    .mobile-services__links a.active .service-link-icon,
    .mobile-services__links a:hover .service-link-icon {
      background: rgba(155,211,148,.22);
      color: #b9efb2;
    }

    .mobile-quote {
      margin-top: 0;
    }

    .mobile-menu-actions {
      gap: 13px;
      margin-top: 26px;
      width: 100%;
    }

    .mobile-menu-actions .mobile-quote,
    .mobile-menu-actions .mobile-whatsapp {
      width: 100%;
      min-height: 52px;
      box-sizing: border-box;
      justify-content: center;
      border-radius: 12px;
    }

    .mobile-menu-actions .mobile-quote {
      background: #fff;
      color: #17491b;
      border: 1px solid #fff;
    }

    .mobile-menu-actions .mobile-whatsapp {
      color: #fff;
      font-size: 15px;
      border: 1px solid rgba(255,255,255,.22);
      background: transparent;
    }

    .mobile-whatsapp .wa-icon {
      width: 19px;
      height: 19px;
    }

    .mobile-menu[open] > summary {
      position: relative;
      z-index: 41;
      border-color: #c8ddc5;
      background: #edf6ea;
    }

    .mobile-menu[open] > summary .ph { color: #17491b; }
    .mobile-menu[open] .menu-open-icon { display: none; }
    .mobile-menu[open] .menu-close-icon { display: block; }

    @keyframes mobile-menu-in {
      from { opacity: 0; transform: translateY(-10px) scale(.975); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
  }

  @media (max-width: 360px) {
    .nav-inner { gap: 8px; }
