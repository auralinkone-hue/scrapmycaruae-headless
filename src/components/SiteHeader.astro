---
const pathname = Astro.url.pathname;
const whatsappUrl = 'https://api.whatsapp.com/send?phone=%2B971557458322';
const links = [
  { href: '/', label: 'Home', icon: 'ph-house' },
  { href: '/free-quote', label: 'Free Quote', icon: 'ph-car-profile' },
  { href: '/contact-us', label: 'Contact Us', icon: 'ph-chat-circle-text' },
  { href: '/faqs', label: 'FAQs', icon: 'ph-question' },
  { href: '/blogs', label: 'Blogs', icon: 'ph-newspaper-clipping' }
];

const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(href + '/');
---

<header class="smc-header">
  <div class="smc-topbar">
    <div class="smc-container topbar-inner">
      <span class="topbar-message"><i class="ph ph-map-pin" aria-hidden="true"></i> Sell your car anywhere in the UAE</span>
      <a href="tel:+971557458322"><i class="ph ph-phone-call" aria-hidden="true"></i> Call now · 055 745 83 22</a>
    </div>
  </div>

  <div class="smc-nav-wrap">
    <div class="smc-container nav-inner">
      <a class="brand" href="/" aria-label="Scrap My Car UAE home">
        <img
          src="https://static.wixstatic.com/media/ff8df3_ee2506a8a7ed4752b5b7832449c71105~mv2.png"
          alt="Scrap My Car UAE"
          width="155"
          height="60"
        />
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href) }]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="desktop-actions">
        <a class="smc-button smc-button-primary" href="/free-quote">
          <i class="ph ph-car-profile" aria-hidden="true"></i>
          Get Free Quote
        </a>
      </div>

      <a class="mobile-call" href="tel:+971557458322" aria-label="Call Scrap My Car UAE on 055 745 83 22">
        <i class="ph ph-phone-call" aria-hidden="true"></i>
        <span>055 745 83 22</span>
      </a>

      <details class="mobile-menu">
        <summary aria-label="Open navigation">
          <i class="ph ph-list menu-open-icon" aria-hidden="true"></i>
          <i class="ph ph-x menu-close-icon" aria-hidden="true"></i>
        </summary>
        <div class="mobile-panel">
          <p class="mobile-menu-kicker">Navigation</p>
          {links.map((link) => (
            <a
              href={link.href}
              class:list={['mobile-link', { active: isActive(link.href) }]}
            >
              <i class={`ph ${link.icon}`} aria-hidden="true"></i>
              {link.label}
              <i class="ph ph-arrow-up-right mobile-link-arrow" aria-hidden="true"></i>
            </a>
          ))}
          <a class="smc-button smc-button-primary mobile-quote" href="/free-quote">
            <i class="ph ph-car-profile" aria-hidden="true"></i>
            Get Free Quote
          </a>
          <a class="mobile-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />
            WhatsApp Us
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .smc-header {
    position: relative;
    z-index: 40;
    background: #fff;
  }

  .smc-topbar {
    background: #1f4d20;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .02em;
  }

  .topbar-inner {
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .topbar-inner a,
  .topbar-message {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .topbar-inner a {
    color: #fff;
    text-decoration: none;
  }

  .topbar-inner .ph {
    font-size: 14px;
  }

  .smc-nav-wrap {
    border-bottom: 1px solid var(--smc-line);
    background: rgba(255,255,255,.96);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    min-height: 74px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }

  .brand img {
    display: block;
    width: 146px;
    height: auto;
    max-height: 58px;
    object-fit: contain;
  }

  .desktop-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav-link {
    position: relative;
    color: #3f433e;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -10px;
    height: 2px;
    border-radius: 2px;
    background: var(--smc-green);
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--smc-green-dark);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link:focus-visible,
  .mobile-link:focus-visible,
  .mobile-menu summary:focus-visible {
    outline: 3px solid rgba(47, 111, 45, .16);
    outline-offset: 3px;
    border-radius: 10px;
  }

  .desktop-actions {
    display: flex;
    align-items: center;
    margin-left: 4px;
  }

  .mobile-menu {
    display: none;
    margin-left: auto;
    position: relative;
  }

  .mobile-call {
    display: none;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 10px;
    margin-left: auto;
    border-radius: 12px;
    background: var(--smc-green-soft);
    color: var(--smc-green-dark);
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .mobile-call .ph {
    font-size: 18px;
  }

  .mobile-menu summary {
    width: 44px;
    height: 44px;
    border: 1px solid var(--smc-line);
    border-radius: 12px;
    display: grid;
    place-content: center;
    gap: 4px;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary .ph {
    color: #202420;
    font-size: 22px;
  }

  .menu-close-icon {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: 54px;
    width: min(310px, calc(100vw - 30px));
    padding: 12px;
    border: 1px solid var(--smc-line);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--smc-shadow);
    display: grid;
    gap: 4px;
  }

  .mobile-link {
    color: #202420;
    padding: 13px 14px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 750;
  }

  .mobile-link > .ph:first-child {
    font-size: 20px;
  }

  .mobile-link-arrow {
    margin-left: auto;
    font-size: 17px;
    opacity: .5;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--smc-green-dark);
    background: var(--smc-green-soft);
  }

  .mobile-quote {
    margin-top: 8px;
  }

  .mobile-whatsapp {
    padding: 11px;
    color: var(--smc-green-dark);
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
  }

  @media (max-width: 1100px) {
    .desktop-nav,
    .desktop-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .mobile-link {
      display: flex;
      align-items: center;
      gap: 11px;
    }
  }

  @media (max-width: 640px) {
    .smc-topbar {
      display: none;
    }

    .nav-inner {
      min-height: 66px;
    }

    .brand img {
      width: 128px;
    }

    .nav-inner { gap: 12px; }

    .mobile-call {
      display: inline-flex;
    }

    .mobile-menu summary {
      width: 44px;
      height: 44px;
    }

    .mobile-menu {
      position: static;
      margin-left: 0;
    }

    .mobile-panel {
      position: fixed;
      inset: 0;
      z-index: 50;
      width: auto;
      min-height: 100dvh;
      padding: 104px 24px max(28px, env(safe-area-inset-bottom));
      border: 0;
      border-radius: 0;
      background: #123816;
      box-shadow: none;
      align-content: start;
      gap: 7px;
      overflow-y: auto;
    }

    .mobile-menu-kicker {
      margin: 0 0 12px;
      color: #a9caa7;
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .mobile-link {
      min-height: 58px;
      padding: 14px 4px;
      border-bottom: 1px solid rgba(255,255,255,.14);
      border-radius: 0;
      color: #fff;
      font-size: 18px;
      font-weight: 750;
    }

    .mobile-link > .ph:first-child { color: #9bd394; }
    .mobile-link-arrow { color: #fff; opacity: .65; }

    .mobile-link:hover,
    .mobile-link.active {
      color: #fff;
      background: transparent;
    }

    .mobile-quote {
      min-height: 54px;
      margin-top: 24px;
      justify-content: center;
      background: #fff;
      color: #17491b;
      border: 1px solid #fff;
    }

    .mobile-whatsapp {
      min-height: 48px;
      color: #fff;
      font-size: 15px;
      border: 1px solid rgba(255,255,255,.22);
      border-radius: 12px;
    }

    .mobile-whatsapp .wa-icon {
      width: 19px;
      height: 19px;
    }

    .mobile-menu[open] summary {
      position: fixed;
      top: max(11px, env(safe-area-inset-top));
      right: 16px;
      z-index: 51;
      border-color: rgba(255,255,255,.24);
      background: rgba(255,255,255,.1);
    }

    .mobile-menu[open] summary .ph { color: #fff; }
    .mobile-menu[open] .menu-open-icon { display: none; }
    .mobile-menu[open] .menu-close-icon { display: block; }
