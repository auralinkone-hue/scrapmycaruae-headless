---
import type { VehicleMake, VehicleModel, VehicleYear } from '../lib/vehicle-data';
import { countryDialOptions, countryFlag } from '../lib/country-codes';
import { phoneDialCode } from '../lib/phone';
const phoneId = `quote-phone-${crypto.randomUUID()}`;

interface Props {
  makes: VehicleMake[];
  models: VehicleModel[];
  years: VehicleYear[];
  dataError?: string;
  variant?: 'default' | 'blog-sidebar' | 'free-quote';
}

const { makes = [], models = [], years = [], dataError = '', variant = 'default' } = Astro.props;
const featuredMakes = makes.filter((item) => item.featuredMake);
const regularMakes = makes.filter((item) => !item.featuredMake);
const isBlogSidebar = variant === 'blog-sidebar';
const isFreeQuote = variant === 'free-quote';
---

<div class:list={['quote-card', { 'quote-card--blog-sidebar': isBlogSidebar, 'quote-card--free-quote': isFreeQuote }]} data-quote-form data-vehicle-models={JSON.stringify(models)}>
  <div class="quote-head">
    {!isBlogSidebar && <span class="quote-kicker"><i class="ph ph-car-profile" aria-hidden="true"></i>Free vehicle valuation</span>}
    <h2>{isBlogSidebar ? 'Get your car price' : 'Tell us about your car'}</h2>
    <p>{isBlogSidebar ? 'Free valuation in a few simple steps.' : 'Enter a few details and we’ll prepare your free valuation.'}</p>
  </div>

  <form novalidate>
    <div class="field-grid">
      <label class="form-field" data-field="make">
        <span class="field-label">Make</span>
        <span class="field-control with-icon">
          <i class="ph ph-steering-wheel" aria-hidden="true"></i>
          <select name="make" data-make required aria-label="Vehicle make" disabled={Boolean(dataError || makes.length === 0)}>
            <option value="">Select make</option>
            {featuredMakes.length > 0 && <optgroup label="Popular makes">{featuredMakes.map((item) => <option value={item.make}>{item.make}</option>)}</optgroup>}
            {regularMakes.length > 0 && <optgroup label="All makes">{regularMakes.map((item) => <option value={item.make}>{item.make}</option>)}</optgroup>}
          </select>
        </span>
        <span class="field-error" data-error-for="make" role="alert" hidden></span>
      </label>

      <label class="form-field" data-field="model">
        <span class="field-label">Model</span>
        <span class="field-control with-icon">
          <i class="ph ph-car-profile" aria-hidden="true"></i>
          <select name="model" data-model required aria-label="Vehicle model" disabled><option value="">Select make first</option></select>
        </span>
        <span class="field-error" data-error-for="model" role="alert" hidden></span>
      </label>

      <div class="model-availability" data-model-count role="status" aria-live="polite" hidden>
        <i class="ph ph-list-checks" aria-hidden="true"></i><span></span>
      </div>

      <label class="form-field" data-field="year">
        <span class="field-label">Year</span>
        <span class="field-control with-icon">
          <i class="ph ph-calendar-blank" aria-hidden="true"></i>
          <select name="year" required aria-label="Vehicle year" disabled={Boolean(dataError || years.length === 0)}>
            <option value="">Select year</option>
            {years.map((item) => <option value={item.year}>{item.year}</option>)}
          </select>
        </span>
        <span class="field-error" data-error-for="year" role="alert" hidden></span>
      </label>

      <label class="form-field" data-field="name">
        <span class="field-label">Your name</span>
        <span class="field-control with-icon"><i class="ph ph-user" aria-hidden="true"></i><input name="name" autocomplete="name" placeholder="Enter your name" required /></span>
        <span class="field-error" data-error-for="name" role="alert" hidden></span>
      </label>
    </div>

    <div class="form-field phone-field" data-field="whatsapp">
      <label class="field-label" for={phoneId}>Phone / WhatsApp</label>
      <div class="field-control phone-control">
        <span class="phone-country">
          <button type="button" class="phone-country-face" data-country-trigger tabindex="-1" aria-hidden="true" aria-haspopup="dialog" aria-controls={`${phoneId}-country-menu`} aria-expanded="false" aria-label="Change phone country: United Arab Emirates (+971)">
            <img data-phone-flag src="/flags/ae.svg" width="24" height="24" alt="" decoding="async" />
            <span data-phone-dial>+971</span>
            <svg class="phone-country-arrow" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <select name="phoneCountry" data-phone-country aria-label="Phone country and calling code" autocomplete="country">
            {countryDialOptions.map(country => <option value={country.iso} selected={country.iso === 'AE'}>{countryFlag(country.iso)} {country.name} ({phoneDialCode(country.iso)})</option>)}
          </select>
        </span>
        <div class="phone-country-menu" id={`${phoneId}-country-menu`} data-country-menu popover="manual" role="dialog" aria-labelledby={`${phoneId}-country-heading`} hidden>
          <div class="country-menu-heading"><span id={`${phoneId}-country-heading`}>Choose your country</span><button type="button" data-country-close aria-label="Close country list"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg></button></div>
          <div class="country-search-wrap"><svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6" /><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg><input class="country-search" data-country-search type="search" role="combobox" aria-label="Search countries or calling codes" aria-autocomplete="list" aria-controls={`${phoneId}-country-list`} aria-expanded="false" autocomplete="off" spellcheck="false" placeholder="Search country or code" /></div>
          <div class="phone-country-list" id={`${phoneId}-country-list`} data-country-list role="listbox" aria-label="Phone country"></div>
          <p class="country-empty" data-country-empty role="status" hidden>No countries found. Try a name or calling code.</p>
          <span class="phone-status" data-country-results role="status" aria-live="polite"></span>
        </div>
        <input id={phoneId} name="whatsapp" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="e.g. 50 123 4567" maxlength="64" aria-describedby={`${phoneId}-error`} required />
      </div>
      <span class="field-error" id={`${phoneId}-error`} data-error-for="whatsapp" role="alert" hidden></span>
      <span class="phone-status" data-phone-status role="status" aria-live="polite"></span>
    </div>

    <label class="hp-field" aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
    {dataError && <div class="data-error" role="alert">Vehicle options could not be loaded from Wix CMS. Please try again shortly.</div>}
    <button type="submit" class="submit" data-submit data-submit-state="idle">
      <span class="submit-idle">Get My Free Valuation <i class="ph ph-calculator" aria-hidden="true"></i></span>
      <span class="submit-feedback submit-saving" aria-hidden="true"><span class="submit-spinner"></span><span>Saving your request...</span><span class="submit-progress"></span></span>
      <span class="submit-feedback submit-saved" aria-hidden="true"><svg data-submit-check viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Request saved successfully!</span></span>
    </button>
    <span class="quote-submit-status" data-submit-status role="status" aria-live="polite" aria-atomic="true"></span>
    <div class="submit-message" data-submit-message role="alert" hidden></div>
    {isBlogSidebar && <p class="sidebar-trust">Free valuation <span>•</span> No obligation <span>•</span> UAE-wide collection</p>}
  </form>
</div>

<script>
  import { initialiseQuotePhone } from '../lib/quote-phone-input';
  function initialiseQuoteForms() {
    document.querySelectorAll('[data-quote-form]').forEach((root) => {
      if (root.dataset.quoteReady) return;
      const form = root.querySelector('form');
      const makeSelect = root.querySelector('[data-make]');
      const modelSelect = root.querySelector('[data-model]');
      const modelCount = root.querySelector('[data-model-count]');
      if (!(form instanceof HTMLFormElement) || !(makeSelect instanceof HTMLSelectElement) || !(modelSelect instanceof HTMLSelectElement)) return;

      root.dataset.quoteReady = 'true';
      const vehicleModels = JSON.parse(root.dataset.vehicleModels || '[]');
      const phone = initialiseQuotePhone(root);

      const populateModels = (make) => {
        modelSelect.replaceChildren();
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = make ? 'Select model' : 'Select make first';
        modelSelect.appendChild(placeholder);
        const matching = make ? vehicleModels.filter((item) => item.make === make) : [];
        matching.forEach((item) => {
          const option = document.createElement('option');
          option.value = item.model;
          option.textContent = item.model;
          modelSelect.appendChild(option);
        });
        modelSelect.disabled = matching.length === 0;
        if (modelCount instanceof HTMLElement) {
          modelCount.hidden = !make;
          const label = modelCount.querySelector('span');
          if (label) label.textContent = matching.length ? `${matching.length} ${matching.length === 1 ? 'model' : 'models'} available for ${make}` : `No models are currently listed for ${make}`;
        }
      };

      const fields = Array.from(form.querySelectorAll('select[name]:not([name="phoneCountry"]), input[name]:not([name="website"])'));
      const validationMessages = {
        make: 'Please select a make.',
        model: 'Please select a model.',
        year: 'Please select a year.',
        name: 'Please enter your name.',
        whatsapp: 'Please enter your phone number.'
      };

      const clearError = (field) => {
        const wrapper = field.closest('[data-field]');
        const message = root.querySelector(`[data-error-for="${field.name}"]`);
        wrapper?.classList.remove('is-invalid');
        field.removeAttribute('aria-invalid');
        if (message instanceof HTMLElement) {
          message.hidden = true;
          message.textContent = '';
        }
      };

      const showError = (field, messageText) => {
        const wrapper = field.closest('[data-field]');
        const message = root.querySelector(`[data-error-for="${field.name}"]`);
        wrapper?.classList.add('is-invalid');
        field.setAttribute('aria-invalid', 'true');
        if (message instanceof HTMLElement) {
          message.hidden = false;
          message.textContent = messageText;
        }
      };

      const validateField = (field) => {
        const value = field.value.trim();
        let messageText = '';
        if (!value) {
          messageText = validationMessages[field.name] || 'Please complete this field.';
        } else if (field.name === 'name' && !/^[\p{L}][\p{L}\s.'-]*$/u.test(value)) {
          messageText = 'Please enter a valid name.';
        } else if (field.name === 'whatsapp') {
          messageText = phone.error();
        }
        if (messageText) {
          showError(field, messageText);
          return false;
        }
        clearError(field);
        return true;
      };

      makeSelect.addEventListener('change', () => {
        populateModels(makeSelect.value);
        validateField(makeSelect);
        clearError(modelSelect);
      });

      fields.forEach((field) => {
        field.addEventListener('blur', () => {
          field.dataset.touched = 'true';
          validateField(field);
        });
        field.addEventListener('input', () => {
          if (field.dataset.touched === 'true' || field.closest('[data-field]')?.classList.contains('is-invalid')) validateField(field);
        });
        field.addEventListener('change', () => {
          if (field.dataset.touched === 'true' || field.closest('[data-field]')?.classList.contains('is-invalid')) validateField(field);
        });
      });

      const previousModel = modelSelect.value;
      populateModels(makeSelect.value);
      if (Array.from(modelSelect.options).some(option => option.value === previousModel)) modelSelect.value = previousModel;

      // Reuse the ID for retries of unchanged details; keep it out of CMS field mapping.
      let submissionId = '';
      let submissionDetails = '';
      let isSubmitting = false;
      const submitButton = root.querySelector('[data-submit]');
      const submitMessage = root.querySelector('[data-submit-message]');
      const submitStatus = root.querySelector('[data-submit-status]');
      const setSubmitState = (state) => {
        const label = state === 'saving' ? 'Saving your request...' : state === 'saved' ? 'Request saved successfully!' : 'Get My Free Valuation';
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.dataset.submitState = state;
          submitButton.disabled = state !== 'idle';
          submitButton.setAttribute('aria-busy', String(state === 'saving'));
          submitButton.setAttribute('aria-label', label);
        }
        if (submitStatus instanceof HTMLElement) submitStatus.textContent = state === 'idle' ? '' : label;
      };
      const showSavedConfirmation = async () => {
        setSubmitState('saved');
        // Paint the confirmed state and finish its short entrance animation.
        // Feedback is bounded even if an animation or background tab stops advancing.
        let completionTimer;
        try {
          await Promise.race([
            (async () => {
              await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
              const check = submitButton?.querySelector('[data-submit-check]');
              await Promise.all((check?.getAnimations?.() || []).map(animation => animation.finished.catch(() => {})));
            })(),
            new Promise(resolve => { completionTimer = setTimeout(resolve, 300); })
          ]);
        } catch { /* Optional animation must never block a confirmed WhatsApp handoff. */ }
        finally { clearTimeout(completionTimer); }
      };
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (isSubmitting) return;
        let firstInvalid = null;
        fields.forEach((field) => {
          field.dataset.touched = 'true';
          if (!validateField(field) && !firstInvalid) firstInvalid = field;
        });
        if (firstInvalid instanceof HTMLElement) {
          firstInvalid.focus();
          return;
        }

        const data = Object.fromEntries(new FormData(form).entries());
        data.whatsapp = phone.number().e164;
        const details = JSON.stringify(data);
        if (!submissionId || details !== submissionDetails) {
          submissionId = crypto.randomUUID();
          submissionDetails = details;
        }
        data.submissionId = submissionId;
        isSubmitting = true;
        setSubmitState('saving');
        if (submitMessage instanceof HTMLElement) {
          submitMessage.hidden = true;
          submitMessage.textContent = '';
          submitMessage.classList.remove('error');
        }
        try {
          const response = await fetch('/api/quote', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data), signal: AbortSignal.timeout(30000) });
          const result = await response.json();
          if (!response.ok || !result.ok || !result.whatsappUrl) throw new Error(result.message || 'Submission failed.');
          window.smcAnalytics?.track('generate_lead', { form_name: 'valuation_form', cta_location: 'quote_form', destination_type: 'whatsapp' });
          await showSavedConfirmation();
          window.smcAnalytics?.track('whatsapp_handoff', { form_name: 'valuation_form', cta_location: 'quote_form', destination_type: 'whatsapp' });
          window.location.assign(result.whatsappUrl);
        } catch (error) {
          isSubmitting = false;
          setSubmitState('idle');
          if (submitMessage instanceof HTMLElement) {
            submitMessage.hidden = false;
            submitMessage.classList.add('error');
            submitMessage.textContent = error instanceof Error && ['TimeoutError', 'AbortError'].includes(error.name)
              ? 'We could not confirm your request in time. Please try again.'
              : error instanceof Error ? error.message : 'We could not submit your request right now.';
          }
        }
      });
    });
  }
  initialiseQuoteForms();
  document.addEventListener('astro:page-load', initialiseQuoteForms);
</script>

<style>
  .quote-card { width: 100%; padding: 26px; border: 1px solid #dce6d9; border-radius: 19px; background: #fff; box-shadow: 0 12px 30px rgba(27,55,24,.075); }
  .quote-head { text-align: left; } .quote-kicker { display: inline-flex; align-items: center; gap: 6px; color: var(--smc-green); font-size: 10px; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; } .quote-kicker .ph { font-size: 15px; }
  .quote-head h2 { margin: 6px 0 5px; color: var(--smc-ink); font-size: 25px; font-weight: 700; line-height: 1.12; letter-spacing: -.035em; } .quote-head p { margin: 0; color: var(--smc-muted); font-size: 13px; line-height: 1.4; }
  form { display: grid; gap: 12px; margin-top: 16px; text-align: left; } .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 11px 12px; } .form-field { display: grid; gap: 5px; min-width: 0; text-align: left; } .field-label { color: #303930; font-size: 12px; font-weight: 650; line-height: 1.15; }
  .field-control { position: relative; display: block; min-width: 0; } input, select { width: 100%; min-width: 0; height: 50px; padding: 0 14px; border: 1px solid #d5ded2; border-radius: 12px; outline: none; background: #fff; color: #171a17; font: inherit; font-size: 15px; font-weight: 500; transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease; } select { padding-right: 37px; cursor: pointer; } select:disabled { background: #f3f5f2; color: #8b948a; cursor: not-allowed; }
  .with-icon .ph { position: absolute; z-index: 1; top: 50%; left: 14px; color: #5a8d53; font-size: 18px; pointer-events: none; transform: translateY(-50%); } .with-icon input, .with-icon select { padding-left: 43px; } .with-icon select { padding-right: 37px; } input:focus, select:focus { border-color: #609a59; box-shadow: 0 0 0 3px rgba(62,122,55,.1); } input:focus-visible, select:focus-visible, .submit:focus-visible { outline: 3px solid rgba(47,111,45,.16); outline-offset: 2px; }
  .model-availability { grid-column: 1 / -1; display: inline-flex; align-items: center; gap: 5px; width: fit-content; margin: -3px 0 -1px; color: #477a42; font-size: 11px; font-weight: 760; line-height: 1.2; } .model-availability .ph { font-size: 14px; } .model-availability[hidden] { display: none; } .field-error { display: flex; align-items: center; gap: 5px; color: #b42318; font-size: 11px; font-weight: 680; line-height: 1.25; } .field-error::before { content: ""; width: 5px; height: 5px; flex: 0 0 auto; border-radius: 50%; background: currentColor; } .field-error[hidden] { display: none; } .form-field.is-invalid input, .form-field.is-invalid select { border-color: #dd554c; background: #fff9f8; box-shadow: 0 0 0 3px rgba(221,85,76,.09); } .form-field.is-invalid .with-icon .ph { color: #c5423b; }
  .phone-control { display:flex; align-items:stretch; }
  .phone-country { position:relative; flex:0 0 110px; min-width:0; }
  .phone-country-face { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; gap:7px; padding:0 10px; border:1px solid #d5ded2; border-right:0; border-radius:11px 0 0 11px; background:#f5f8f3; color:#24372a; font:inherit; font-size:13px; font-weight:650; pointer-events:none; transition:background 160ms ease,box-shadow 160ms ease; }
  .phone-country-face[data-enhanced] { pointer-events:auto; cursor:pointer; }
  .phone-country-face[data-enhanced]:hover,.phone-country-face[aria-expanded="true"] { background:#eaf3e5; }
  [data-phone-flag] { display:block; flex:0 0 24px; width:24px; height:24px; border-radius:50%; box-shadow:0 0 0 1px rgba(22,60,32,.08); }
  .phone-country-arrow { flex:0 0 14px; color:#50714e; transition:transform 160ms ease; }
  .phone-country-face[aria-expanded="true"] .phone-country-arrow { transform:rotate(180deg); }
  .phone-country select { position:relative; z-index:1; opacity:0; padding:0; cursor:pointer; }
  .phone-country-menu { position:fixed; inset:auto; z-index:100; display:flex; flex-direction:column; box-sizing:border-box; margin:0; padding:12px; border:1px solid #dce6d8; border-radius:16px; background:#fff; color:#203326; box-shadow:0 16px 48px rgba(18,50,28,.16),0 2px 8px rgba(18,50,28,.06); overflow:hidden; font-family:inherit; }
  .phone-country-menu[hidden],.phone-country select[hidden],.country-empty[hidden] { display:none; }
  .phone-country-menu:popover-open { animation:country-picker-in 160ms ease-out; }
  .country-menu-heading { display:flex; flex:0 0 auto; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; padding-left:3px; font-size:12px; font-weight:700; }
  .country-menu-heading button { display:grid; place-items:center; width:28px; height:28px; padding:0; border:0; border-radius:7px; background:#f2f6f0; color:#4b674a; cursor:pointer; }
  .country-search-wrap { position:relative; flex:0 0 auto; margin-bottom:9px; }
  .country-search-wrap>svg { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#658260; pointer-events:none; }
  .phone-control .country-search { width:100%; height:42px; padding:0 12px 0 38px; border:1px solid #dce5d7; border-radius:9px; background:#f8faf6; color:#24372a; font-size:14px; font-weight:450; }
  .phone-country-list { flex:1 1 auto; min-height:0; overflow-y:auto; overscroll-behavior:contain; scrollbar-width:thin; scrollbar-color:#4e8b47 #edf3e9; scrollbar-gutter:stable; -webkit-overflow-scrolling:touch; }
  .phone-country-list::-webkit-scrollbar { width:5px; }
  .phone-country-list::-webkit-scrollbar-track { background:#edf3e9; border-radius:8px; }
  .phone-country-list::-webkit-scrollbar-thumb { background:#4e8b47; border-radius:8px; }
  .phone-country-list::-webkit-scrollbar-thumb:hover { background:#2f6d35; }
  .phone-country-list :global(.country-group-label) { margin:9px 8px 5px; color:#73826d; font-size:10px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; }
  .phone-country-list :global(.country-option) { display:grid; grid-template-columns:24px minmax(0,1fr) auto 14px; align-items:center; gap:10px; width:100%; min-height:44px; margin:2px 0; padding:9px 8px; border:0; border-radius:9px; background:transparent; color:#273b2c; font:inherit; font-size:13px; line-height:1.35; text-align:left; cursor:pointer; transition:background 130ms ease,color 130ms ease; }
  .phone-country-list :global(.country-option img) { display:block; width:24px; height:24px; border-radius:50%; }
  .phone-country-list :global(.country-option-name) { overflow-wrap:anywhere; }
  .phone-country-list :global(.country-option-dial) { color:#788575; font-size:12px; font-variant-numeric:tabular-nums; }
  .phone-country-list :global(.country-option-check) { visibility:hidden; color:#2e7139; font-weight:800; text-align:center; }
  .phone-country-list :global(.country-option:hover),.phone-country-list :global(.country-option.is-highlighted) { background:#f0f6ec; }
  .phone-country-list :global(.country-option[aria-selected="true"]) { background:#e7f1df; color:#204c29; font-weight:650; }
  .phone-country-list :global(.country-option[aria-selected="true"] .country-option-dial) { color:#3f6c3c; }
  .phone-country-list :global(.country-option[aria-selected="true"] .country-option-check) { visibility:visible; }
  .country-empty { margin:10px 6px; color:#687763; font-size:13px; line-height:1.6; }
  .phone-country-face:focus-visible,.country-menu-heading button:focus-visible,.phone-country-list :global(.country-option:focus-visible) { outline:2px solid #609a59; outline-offset:-2px; }
  @keyframes country-picker-in { from { opacity:0; transform:translateY(-4px); } to { opacity:1; transform:none; } }
  @media (max-width:620px) { .phone-control .country-search { height:44px; font-size:16px; } .phone-country-list :global(.country-option) { min-height:46px; font-size:14px; } }
  @media (prefers-reduced-motion:reduce) { .phone-country-face,.phone-country-arrow,.phone-country-list :global(.country-option) { transition:none; } .phone-country-menu:popover-open { animation:none; } }
  .quote-card .phone-control>input { flex:1 1 0; width:0; border-radius:0 12px 12px 0; padding-inline:12px; }
  .phone-country:focus-within .phone-country-face { border-color:#609a59; box-shadow:0 0 0 3px rgba(62,122,55,.14); }
