---

<div class="quote-card" data-quote-form>
  <div class="quote-head">
    <span class="quote-kicker"><i class="ph ph-car-profile" aria-hidden="true"></i>Free vehicle valuation</span>
    <h2>Tell us about your car</h2>
    <p>Choose your vehicle details. It only takes a moment.</p>
  </div>
 
  <form novalidate>
    <div class="panel active" data-step-panel="1">
      <label class="form-field">
        <span class="field-label"><i class="ph ph-car" aria-hidden="true"></i>Make</span>
        <span class="field-control">
          <select name="make" data-make required aria-label="Vehicle make" disabled={Boolean(dataError || makes.length === 0)}>
            <option value="">Select make</option>

            {featuredMakes.length > 0 && (
              <optgroup label="Popular makes">
                {featuredMakes.map((item) => (
                  <option value={item.make}>{item.make}</option>
                ))}
              </optgroup>
            )}

            {regularMakes.length > 0 && (
              <optgroup label="All makes">
                {regularMakes.map((item) => (
                  <option value={item.make}>{item.make}</option>
                ))}
              </optgroup>
            )}
          </select>
        </span>
      </label>

      <label class="form-field">
        <span class="field-label"><i class="ph ph-car-profile" aria-hidden="true"></i>Model</span>
        <span class="field-control">
          <select name="model" data-model required aria-label="Vehicle model" disabled>
            <option value="">Select make first</option>
          </select>
        </span>
      </label>

      <label class="form-field">
        <span class="field-label"><i class="ph ph-calendar-blank" aria-hidden="true"></i>Year</span>
        <span class="field-control">
          <select name="year" required aria-label="Vehicle year" disabled={Boolean(dataError || years.length === 0)}>
            <option value="">Select year</option>
            {years.map((item) => (
              <option value={item.year}>{item.year}</option>
            ))}
          </select>
        </span>
      </label>

      {dataError && (
        <div class="data-error" role="alert">
          Vehicle options could not be loaded from Wix CMS. Check the three collection IDs and public read permissions.
        </div>
      )}

      <button type="button" class="continue" data-next>
        Get My Free Valuation
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </button>
    </div>

    <div class="panel" data-step-panel="2">
      <button type="button" class="back" data-back><i class="ph ph-arrow-left" aria-hidden="true"></i>Back</button>

      <div class="vehicle-summary" data-vehicle-summary></div>

      <label class="form-field">
        <span class="field-label"><i class="ph ph-user" aria-hidden="true"></i>Your name</span>
        <span class="field-control">
          <input
            name="name"
            autocomplete="name"
            placeholder="Enter your name"
            required
          />
        </span>
      </label>

      <label class="form-field">
        <span class="field-label"><i class="ph ph-device-mobile" aria-hidden="true"></i>Mobile / WhatsApp number</span>
        <div class="phone-wrap">
          <select name="countryCode" class="country-code" aria-label="Country calling code" required>
            {countryCodes.map(([flag, country, code]) => (
              <option value={code} selected={code === '+971'}>
                {code === '+971' ? `${flag} ${code}` : `${flag} ${code} · ${country}`}
              </option>
            ))}
          </select>
          <span class="phone-input-control">
            <i class="ph ph-device-mobile" aria-hidden="true"></i>
            <input
              name="whatsapp"
              inputmode="tel"
              autocomplete="tel"
              placeholder="Your Mobile No (you will receive an SMS)"
              required
            />
          </span>
        </div>
      </label>

      <label class="hp-field" aria-hidden="true">
        <span>Website</span>
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>

      <button type="submit" class="submit" data-submit>
        Get My Free Valuation
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </button>

      <div class="submit-message" data-submit-message hidden></div>

      <p class="fine-print">
        No obligation. Your details will only be used to contact you about your vehicle valuation.
      </p>
    </div>
  </form>
</div>

<script define:vars={{ vehicleModels: models }}>
  (() => {
    const roots = document.querySelectorAll('[data-quote-form]');

    roots.forEach((root) => {
      const panels = root.querySelectorAll('[data-step-panel]');
       const form = root.querySelector('form');
      const makeSelect = root.querySelector('[data-make]');
      const modelSelect = root.querySelector('[data-model]');
      const summary = root.querySelector('[data-vehicle-summary]');

      if (!(form instanceof HTMLFormElement)) return;
      if (!(makeSelect instanceof HTMLSelectElement)) return;
      if (!(modelSelect instanceof HTMLSelectElement)) return;

      const setStep = (step) => {
        panels.forEach((panel) => {
          panel.classList.toggle(
            'active',
            panel.getAttribute('data-step-panel') === String(step)
          );
        });
 
      };

      const populateModels = (make) => {
        modelSelect.replaceChildren();

        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = make ? 'Select model' : 'Select make first';
        modelSelect.appendChild(placeholder);

        if (!make) {
          modelSelect.disabled = true;
          return;
        }

        const matching = vehicleModels.filter((item) => item.make === make);

        matching.forEach((item) => {
          const option = document.createElement('option');
          option.value = item.model;
          option.textContent = item.model;
          modelSelect.appendChild(option);
        });

        modelSelect.disabled = matching.length === 0;

      };

      makeSelect.addEventListener('change', () => {
        populateModels(makeSelect.value);
      });

      root.querySelector('[data-next]')?.addEventListener('click', () => {
        const firstPanel = root.querySelector('[data-step-panel="1"]');
        const required = firstPanel?.querySelectorAll(
          'input[required], select[required]'
        ) || [];

        const invalid = Array.from(required).find(
          (field) =>
            field instanceof HTMLInputElement || field instanceof HTMLSelectElement
              ? !field.checkValidity()
              : false
        );

        if (
          invalid instanceof HTMLInputElement ||
          invalid instanceof HTMLSelectElement
        ) {
          invalid.reportValidity();
          return;
        }

        const data = new FormData(form);

        if (summary) {
          summary.textContent =
            `${data.get('make')} ${data.get('model')} · ${data.get('year')}`;
        }

        setStep(2);
      });

      root.querySelector('[data-back]')?.addEventListener('click', () => {
        setStep(1);
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const required = form.querySelectorAll(
          'input[required], select[required]'
        );

        const invalid = Array.from(required).find(
          (field) =>
            field instanceof HTMLInputElement || field instanceof HTMLSelectElement
              ? !field.checkValidity()
              : false
        );

        if (
          invalid instanceof HTMLInputElement ||
          invalid instanceof HTMLSelectElement
        ) {
          invalid.reportValidity();
          return;
        }

        const submitButton = root.querySelector('[data-submit]');
        const submitMessage = root.querySelector('[data-submit-message]');
        const data = Object.fromEntries(new FormData(form).entries());

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.innerHTML = 'Submitting… <i class="ph ph-circle-notch" aria-hidden="true"></i>';
        }

        if (submitMessage instanceof HTMLElement) {
          submitMessage.hidden = true;
          submitMessage.textContent = '';
          submitMessage.classList.remove('error');
        }

        try {
          const response = await fetch('/api/quote', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(result.message || 'Submission failed.');
          }

          window.location.href = result.redirect || '/thank-you';
        } catch (error) {
          if (submitMessage instanceof HTMLElement) {
            submitMessage.hidden = false;
            submitMessage.classList.add('error');
            submitMessage.textContent =
              error instanceof Error
                ? error.message
                : 'We could not submit your request right now.';
          }

          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;
            submitButton.innerHTML = 'Get My Free Valuation <i class="ph ph-arrow-right" aria-hidden="true"></i>';
          }
        }
      });
    });
  })();
</script>

<style>
  .quote-card {
    width: 100%;
    padding: 28px;
    border: 1px solid #dfe8dc;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 18px 46px rgba(27, 55, 24, .10);
  }

  .quote-head {
    text-align: left;
  }

  .quote-head .quote-kicker {
    color: var(--smc-green);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .10em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .quote-kicker .ph {
    font-size: 16px;
  }

  .quote-head h2 {
    margin: 7px 0 7px;
    color: var(--smc-ink);
    font-size: 30px;
    line-height: 1.08;
    letter-spacing: -.04em;
  }

  .quote-head p {
    margin: 0;
    color: var(--smc-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .panel {
    display: none;
    gap: 16px;
    margin-top: 24px;
  }

  .panel.active {
    display: grid;
  }

  .form-field {
    display: grid;
    gap: 8px;
  }

  .field-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #3d463c;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
  }

  .field-label .ph {
    color: var(--smc-green);
    font-size: 18px;
    line-height: 1;
  }

  .field-control,
  .phone-input-control {
    position: relative;
    display: block;
    min-width: 0;
  }

  input,
  select {
    width: 100%;
    min-width: 0;
    height: 56px;
    padding: 0 16px;
    border: 1px solid #d7ded4;
    border-radius: 13px;
    outline: none;
    background: #f9fbf8;
    color: #171a17;
    font: inherit;
    font-size: 16px;
    font-weight: 620;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  select {
    padding-right: 42px;
    cursor: pointer;
  }

  select:disabled,
  input:disabled {
    background: #f1f4ef;
    color: #979d95;
    cursor: not-allowed;
  }

  input:focus,
  select:focus,
  .phone-wrap:focus-within {
    border-color: #73a96b;
    box-shadow: 0 0 0 3px rgba(63, 122, 54, .10);
    background: #fff;
  }

  input:focus-visible,
  select:focus-visible,
  .continue:focus-visible,
  .submit:focus-visible,
  .back:focus-visible {
    outline: 3px solid rgba(47, 111, 45, .15);
    outline-offset: 2px;
  }

  .vehicle-summary {
    padding: 12px 14px;
    border: 1px solid #dce8d8;
    border-radius: 12px;
    background: #f1f7ee;
    color: var(--smc-green-dark);
    font-size: 13px;
    font-weight: 800;
  }

  .phone-wrap {
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    height: 56px;
    align-items: stretch;
    border: 1px solid #d7ded4;
    border-radius: 13px;
    overflow: hidden;
    background: #f9fbf8;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .country-code {
    height: 100%;
    min-width: 0;
    padding: 0 28px 0 10px;
    border: 0;
    border-right: 1px solid #e2e7df;
    border-radius: 0;
    background: #f4f7f2;
    box-shadow: none !important;
    font-size: 12px;
    font-weight: 750;
    cursor: pointer;
  }

  .phone-input-control {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .phone-wrap input {
    height: 100%;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none !important;
    padding: 0 13px;
    font-size: 14px;
    font-weight: 560;
  }

