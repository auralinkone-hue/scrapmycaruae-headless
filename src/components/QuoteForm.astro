---
import type { VehicleMake, VehicleModel, VehicleYear } from '../lib/vehicle-data';

interface Props {
  makes: VehicleMake[];
  models: VehicleModel[];
  years: VehicleYear[];
  dataError?: string;
}

const { makes = [], models = [], years = [], dataError = '' } = Astro.props;
const featuredMakes = makes.filter((item) => item.featuredMake);
const regularMakes = makes.filter((item) => !item.featuredMake);
---

<div class="quote-card" data-quote-form>
  <div class="quote-head">
    <span class="quote-kicker"><i class="ph ph-car-profile" aria-hidden="true"></i>Free vehicle valuation</span>
    <h2>Tell us about your car</h2>
    <p>Enter a few details and we’ll prepare your free valuation.</p>
  </div>

  <form novalidate>
    <div class="field-grid">
      <label class="form-field">
        <span class="field-label">Make</span>
        <span class="field-control with-icon">
          <i class="ph ph-steering-wheel" aria-hidden="true"></i>
          <select name="make" data-make required aria-label="Vehicle make" disabled={Boolean(dataError || makes.length === 0)}>
            <option value="">Select make</option>
            {featuredMakes.length > 0 && <optgroup label="Popular makes">{featuredMakes.map((item) => <option value={item.make}>{item.make}</option>)}</optgroup>}
            {regularMakes.length > 0 && <optgroup label="All makes">{regularMakes.map((item) => <option value={item.make}>{item.make}</option>)}</optgroup>}
          </select>
        </span>
      </label>

      <label class="form-field">
        <span class="field-label">Model</span>
        <span class="field-control with-icon">
          <i class="ph ph-car-profile" aria-hidden="true"></i>
          <select name="model" data-model required aria-label="Vehicle model" disabled><option value="">Select make first</option></select>
        </span>
      </label>

      <div class="model-availability" data-model-count role="status" aria-live="polite" hidden>
        <i class="ph ph-list-checks" aria-hidden="true"></i><span></span>
      </div>

      <label class="form-field">
        <span class="field-label">Year</span>
        <span class="field-control with-icon">
          <i class="ph ph-calendar-blank" aria-hidden="true"></i>
          <select name="year" required aria-label="Vehicle year" disabled={Boolean(dataError || years.length === 0)}>
            <option value="">Select year</option>
            {years.map((item) => <option value={item.year}>{item.year}</option>)}
          </select>
        </span>
      </label>

      <label class="form-field">
        <span class="field-label">Your name</span>
        <span class="field-control with-icon"><i class="ph ph-user" aria-hidden="true"></i><input name="name" autocomplete="name" placeholder="Enter your name" required /></span>
      </label>
    </div>

    <label class="form-field phone-field">
      <span class="field-label">Phone number</span>
      <span class="field-control with-icon"><i class="ph ph-phone" aria-hidden="true"></i><input name="whatsapp" inputmode="tel" autocomplete="tel" placeholder="Your Mobile No" required /></span>
    </label>

    <label class="hp-field" aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
    {dataError && <div class="data-error" role="alert">Vehicle options could not be loaded from Wix CMS. Please try again shortly.</div>}
    <button type="submit" class="submit" data-submit>Get My Free Valuation <i class="ph ph-arrow-right" aria-hidden="true"></i></button>
    <div class="submit-message" data-submit-message hidden></div>
    <p class="fine-print">No obligation. Your details are saved securely before we open WhatsApp.</p>
  </form>
</div>

<script define:vars={{ vehicleModels: models }}>
  (() => {
    document.querySelectorAll('[data-quote-form]').forEach((root) => {
      const form = root.querySelector('form');
      const makeSelect = root.querySelector('[data-make]');
      const modelSelect = root.querySelector('[data-model]');
      const modelCount = root.querySelector('[data-model-count]');
      if (!(form instanceof HTMLFormElement) || !(makeSelect instanceof HTMLSelectElement) || !(modelSelect instanceof HTMLSelectElement)) return;

      const populateModels = (make) => {
        modelSelect.replaceChildren();
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = make ? 'Select model' : 'Select make first';
        modelSelect.appendChild(placeholder);
        const matching = make ? vehicleModels.filter((item) => item.make === make) : [];
        matching.forEach((item) => {
          const option = document.createElement('option');
          option.value = item.model;
          option.textContent = item.model;
          modelSelect.appendChild(option);
        });
        modelSelect.disabled = matching.length === 0;
        if (modelCount instanceof HTMLElement) {
          modelCount.hidden = !make;
          const label = modelCount.querySelector('span');
          if (label) label.textContent = matching.length ? `${matching.length} ${matching.length === 1 ? 'model' : 'models'} available for ${make}` : `No models are currently listed for ${make}`;
        }
      };

      makeSelect.addEventListener('change', () => populateModels(makeSelect.value));
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const submitButton = root.querySelector('[data-submit]');
        const submitMessage = root.querySelector('[data-submit-message]');
        const data = Object.fromEntries(new FormData(form).entries());
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.innerHTML = 'Saving your request… <i class="ph ph-circle-notch" aria-hidden="true"></i>';
        }
        if (submitMessage instanceof HTMLElement) {
          submitMessage.hidden = true;
          submitMessage.textContent = '';
          submitMessage.classList.remove('error');
        }
        try {
          const response = await fetch('/api/quote', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
          const result = await response.json();
          if (!response.ok || !result.ok || !result.whatsappUrl) throw new Error(result.message || 'Submission failed.');
          window.location.assign(result.whatsappUrl);
        } catch (error) {
          if (submitMessage instanceof HTMLElement) {
            submitMessage.hidden = false;
            submitMessage.classList.add('error');
            submitMessage.textContent = error instanceof Error ? error.message : 'We could not submit your request right now.';
          }
          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;
            submitButton.innerHTML = 'Get My Free Valuation <i class="ph ph-arrow-right" aria-hidden="true"></i>';
          }
        }
      });
    });
  })();
</script>

<style>
  .quote-card { width: 100%; padding: 26px; border: 1px solid #dce6d9; border-radius: 19px; background: #fff; box-shadow: 0 12px 30px rgba(27,55,24,.075); }
  .quote-head { text-align: left; } .quote-kicker { display: inline-flex; align-items: center; gap: 6px; color: var(--smc-green); font-size: 10px; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; } .quote-kicker .ph { font-size: 15px; }
  .quote-head h2 { margin: 6px 0 5px; color: var(--smc-ink); font-size: 25px; line-height: 1.12; letter-spacing: -.04em; } .quote-head p { margin: 0; color: var(--smc-muted); font-size: 13px; line-height: 1.4; }
  form { display: grid; gap: 12px; margin-top: 16px; } .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 11px 12px; } .form-field { display: grid; gap: 5px; min-width: 0; } .field-label { color: #303930; font-size: 12px; font-weight: 780; line-height: 1.15; }
  .field-control { position: relative; display: block; min-width: 0; } input, select { width: 100%; min-width: 0; height: 50px; padding: 0 14px; border: 1px solid #d5ded2; border-radius: 12px; outline: none; background: #fff; color: #171a17; font: inherit; font-size: 15px; font-weight: 620; transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease; } select { padding-right: 37px; cursor: pointer; } select:disabled { background: #f3f5f2; color: #8b948a; cursor: not-allowed; }
  .with-icon .ph { position: absolute; z-index: 1; top: 50%; left: 14px; color: #5a8d53; font-size: 18px; pointer-events: none; transform: translateY(-50%); } .with-icon input, .with-icon select { padding-left: 43px; } .with-icon select { padding-right: 37px; } input:focus, select:focus { border-color: #609a59; box-shadow: 0 0 0 3px rgba(62,122,55,.1); } input:focus-visible, select:focus-visible, .submit:focus-visible { outline: 3px solid rgba(47,111,45,.16); outline-offset: 2px; }
  .model-availability { grid-column: 1 / -1; display: inline-flex; align-items: center; gap: 5px; width: fit-content; margin: -3px 0 -1px; color: #477a42; font-size: 11px; font-weight: 760; line-height: 1.2; } .model-availability .ph { font-size: 14px; } .model-availability[hidden] { display: none; }
  .submit { min-height: 52px; margin-top: 2px; padding: 0 18px; border: 0; border-radius: 12px; background: var(--smc-green-dark); color: #fff; font: inherit; font-size: 15px; font-weight: 850; display: inline-flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; box-shadow: 0 8px 18px rgba(32,77,32,.14); transition: transform 160ms ease, background 160ms ease, opacity 160ms ease; } .submit:hover { transform: translateY(-1px); background: #173d18; } .submit:active { transform: translateY(0) scale(.99); } .submit:disabled { opacity: .68; cursor: wait; } .submit:disabled .ph-circle-notch { animation: smc-spin .8s linear infinite; } @keyframes smc-spin { to { transform: rotate(360deg); } }
  .fine-print { margin: -2px 0 0; color: #7b8279; font-size: 10px; line-height: 1.4; } .hp-field { position: absolute !important; width: 1px !important; height: 1px !important; overflow: hidden !important; clip: rect(0 0 0 0) !important; white-space: nowrap !important; } .submit-message, .data-error { padding: 10px 11px; border-radius: 10px; font-size: 12px; line-height: 1.4; } .submit-message { background: #eef6eb; color: var(--smc-green-dark); } .submit-message.error, .data-error { background: #fff0f0; color: #842727; }
  @media (max-width: 620px) { .quote-card { padding: 19px; border-radius: 18px; } .quote-head h2 { font-size: 23px; } form { gap: 11px; margin-top: 14px; } .field-grid { grid-template-columns: 1fr; gap: 10px; } .model-availability { margin: -2px 0; } input, select { height: 52px; font-size: 16px; } .submit { min-height: 53px; } }
  @media (max-width: 370px) { .quote-card { padding-inline: 18px; } }
</style>
