---
import type { VehicleMake, VehicleModel, VehicleYear } from '../lib/vehicle-data';

interface Props {
  makes: VehicleMake[];
  models: VehicleModel[];
  years: VehicleYear[];
  dataError?: string;
}

const {
  makes = [],
  models = [],
  years = [],
  dataError = ''
} = Astro.props;

const featuredMakes = makes.filter((item) => item.featuredMake);
const regularMakes = makes.filter((item) => !item.featuredMake);
---

<div class="quote-card" data-quote-form>
  <div class="quote-head">
    <span>Free vehicle valuation</span>
    <h2>Get your vehicle price</h2>
    <p>Choose your vehicle details. It only takes a moment.</p>
  </div>

  <div class="steps" aria-hidden="true">
    <span class="step active" data-step-dot="1">1</span>
    <span class="step-line"></span>
    <span class="step" data-step-dot="2">2</span>
  </div>

  <form novalidate>
    <div class="panel active" data-step-panel="1">
      <label>
        <span>Make</span>
        <select name="make" data-make required disabled={Boolean(dataError || makes.length === 0)}>
          <option value="">Select make</option>

          {featuredMakes.length > 0 && (
            <optgroup label="Popular makes">
              {featuredMakes.map((item) => (
                <option value={item.make}>{item.make}</option>
              ))}
            </optgroup>
          )}

          {regularMakes.length > 0 && (
            <optgroup label="All makes">
              {regularMakes.map((item) => (
                <option value={item.make}>{item.make}</option>
              ))}
            </optgroup>
          )}
        </select>
      </label>

      <label>
        <span>Model</span>
        <select name="model" data-model required disabled>
          <option value="">Select make first</option>
        </select>
        <small class="field-help" data-model-help>
          Choose a make to see its available models.
        </small>
      </label>

      <label>
        <span>Year</span>
        <select name="year" required disabled={Boolean(dataError || years.length === 0)}>
          <option value="">Select year</option>
          {years.map((item) => (
            <option value={item.year}>{item.year}</option>
          ))}
        </select>
      </label>

      {dataError && (
        <div class="data-error" role="alert">
          Vehicle options could not be loaded from Wix CMS. Check the three collection IDs and public read permissions.
        </div>
      )}

      <button type="button" class="continue" data-next>
        Continue
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="panel" data-step-panel="2">
      <button type="button" class="back" data-back>← Back</button>

      <div class="vehicle-summary" data-vehicle-summary></div>

      <label>
        <span>Your name</span>
        <input
          name="name"
          autocomplete="name"
          placeholder="Enter your name"
          required
        />
      </label>

      <label>
        <span>WhatsApp number</span>
        <div class="phone-wrap">
          <span>+971</span>
          <input
            name="whatsapp"
            inputmode="tel"
            autocomplete="tel"
            placeholder="50 123 4567"
            required
          />
        </div>
      </label>

      <label class="hp-field" aria-hidden="true">
        <span>Website</span>
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>

      <button type="submit" class="submit" data-submit>
        Get Your Vehicle Price
      </button>

      <div class="submit-message" data-submit-message hidden></div>

      <p class="fine-print">
        No obligation. Your details will only be used to contact you about your vehicle valuation.
      </p>
    </div>
  </form>
</div>

<script define:vars={{ vehicleModels: models }}>
  (() => {
    const roots = document.querySelectorAll('[data-quote-form]');

    roots.forEach((root) => {
      const panels = root.querySelectorAll('[data-step-panel]');
      const dots = root.querySelectorAll('[data-step-dot]');
      const form = root.querySelector('form');
      const makeSelect = root.querySelector('[data-make]');
      const modelSelect = root.querySelector('[data-model]');
      const modelHelp = root.querySelector('[data-model-help]');
      const summary = root.querySelector('[data-vehicle-summary]');

      if (!(form instanceof HTMLFormElement)) return;
      if (!(makeSelect instanceof HTMLSelectElement)) return;
      if (!(modelSelect instanceof HTMLSelectElement)) return;

      const setStep = (step) => {
        panels.forEach((panel) => {
          panel.classList.toggle(
            'active',
            panel.getAttribute('data-step-panel') === String(step)
          );
        });

        dots.forEach((dot) => {
          dot.classList.toggle(
            'active',
            Number(dot.getAttribute('data-step-dot')) <= step
          );
        });
      };

      const populateModels = (make) => {
        modelSelect.replaceChildren();

        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = make ? 'Select model' : 'Select make first';
        modelSelect.appendChild(placeholder);

        if (!make) {
          modelSelect.disabled = true;
          if (modelHelp) modelHelp.textContent = 'Choose a make to see its available models.';
          return;
        }

        const matching = vehicleModels.filter((item) => item.make === make);

        matching.forEach((item) => {
          const option = document.createElement('option');
          option.value = item.model;
          option.textContent = item.model;
          modelSelect.appendChild(option);
        });

        modelSelect.disabled = matching.length === 0;

        if (modelHelp) {
          modelHelp.textContent = matching.length
            ? `${matching.length} models available for ${make}.`
            : `No models found for ${make}.`;
        }
      };

      makeSelect.addEventListener('change', () => {
        populateModels(makeSelect.value);
      });

      root.querySelector('[data-next]')?.addEventListener('click', () => {
        const firstPanel = root.querySelector('[data-step-panel="1"]');
        const required = firstPanel?.querySelectorAll(
          'input[required], select[required]'
        ) || [];

        const invalid = Array.from(required).find(
          (field) =>
            field instanceof HTMLInputElement || field instanceof HTMLSelectElement
              ? !field.checkValidity()
              : false
        );

        if (
          invalid instanceof HTMLInputElement ||
          invalid instanceof HTMLSelectElement
        ) {
          invalid.reportValidity();
          return;
        }

        const data = new FormData(form);

        if (summary) {
          summary.textContent =
            `${data.get('make')} ${data.get('model')} · ${data.get('year')}`;
        }

        setStep(2);
        root.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      root.querySelector('[data-back]')?.addEventListener('click', () => {
        setStep(1);
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const required = form.querySelectorAll(
          'input[required], select[required]'
        );

        const invalid = Array.from(required).find(
          (field) =>
            field instanceof HTMLInputElement || field instanceof HTMLSelectElement
              ? !field.checkValidity()
              : false
        );

        if (
          invalid instanceof HTMLInputElement ||
          invalid instanceof HTMLSelectElement
        ) {
          invalid.reportValidity();
          return;
        }

        const submitButton = root.querySelector('[data-submit]');
        const submitMessage = root.querySelector('[data-submit-message]');
        const data = Object.fromEntries(new FormData(form).entries());

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.textContent = 'Submitting…';
        }

        if (submitMessage instanceof HTMLElement) {
          submitMessage.hidden = true;
          submitMessage.textContent = '';
          submitMessage.classList.remove('error');
        }

        try {
          const response = await fetch('/api/quote', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(result.message || 'Submission failed.');
          }

          window.location.href = result.redirect || '/thank-you';
        } catch (error) {
          if (submitMessage instanceof HTMLElement) {
            submitMessage.hidden = false;
            submitMessage.classList.add('error');
            submitMessage.textContent =
              error instanceof Error
                ? error.message
                : 'We could not submit your request right now.';
          }

          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;
            submitButton.textContent = 'Get Your Vehicle Price';
          }
        }
      });
    });
  })();
</script>

<style>
  .quote-card {
    width: 100%;
    padding: 30px;
    border: 1px solid rgba(24, 71, 28, .12);
    border-radius: 26px;
    background: rgba(255,255,255,.97);
    box-shadow: 0 30px 80px rgba(19, 45, 18, .14);
  }

  .quote-head span {
    color: var(--smc-green);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .quote-head h2 {
    margin: 7px 0 8px;
    font-size: 31px;
    line-height: 1.08;
    letter-spacing: -.04em;
  }

  .quote-head p {
    margin: 0;
    color: var(--smc-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .steps {
    margin: 24px 0 20px;
    display: grid;
    grid-template-columns: 28px 1fr 28px;
    align-items: center;
    gap: 8px;
  }

  .step {
    width: 28px;
    height: 28px;
    border: 1px solid #d7ddd3;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #899087;
    background: #fff;
    font-size: 12px;
    font-weight: 850;
  }

  .step.active {
    border-color: var(--smc-green-dark);
    background: var(--smc-green-dark);
    color: #fff;
  }

  .step-line {
    height: 1px;
    background: #dfe4dc;
  }

  .panel {
    display: none;
    gap: 15px;
  }

  .panel.active {
    display: grid;
  }

  label {
    display: grid;
    gap: 7px;
  }

  label > span {
    color: #363a35;
    font-size: 12px;
    font-weight: 800;
  }

  input,
  select {
    width: 100%;
    min-height: 52px;
    padding: 0 14px;
    border: 1px solid #d9ded6;
    border-radius: 12px;
    outline: none;
    background: #fff;
    color: #151715;
    font: inherit;
    font-size: 15px;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  select:disabled,
  input:disabled {
    background: #f3f5f1;
    color: #959b93;
    cursor: not-allowed;
  }

  input:focus,
  select:focus {
    border-color: #77a76e;
    box-shadow: 0 0 0 4px rgba(63, 122, 54, .10);
  }

  .field-help {
    color: #7a8078;
    font-size: 11px;
    line-height: 1.4;
  }

  .vehicle-summary {
    padding: 11px 13px;
    border-radius: 10px;
    background: var(--smc-green-soft);
    color: var(--smc-green-dark);
    font-size: 13px;
    font-weight: 850;
  }

  .phone-wrap {
    display: grid;
    grid-template-columns: 62px 1fr;
    align-items: center;
    border: 1px solid #d9ded6;
    border-radius: 12px;
    overflow: hidden;
  }

  .phone-wrap:focus-within {
    border-color: #77a76e;
    box-shadow: 0 0 0 4px rgba(63, 122, 54, .10);
  }

  .phone-wrap > span {
    min-height: 52px;
    display: grid;
    place-items: center;
    border-right: 1px solid #e4e7e1;
    background: #f6f8f4;
    color: #4f554e;
    font-size: 14px;
    font-weight: 800;
  }

  .phone-wrap input {
    border: 0;
    border-radius: 0;
    box-shadow: none !important;
  }

  .continue,
  .submit {
    min-height: 54px;
    margin-top: 3px;
    padding: 0 18px;
    border: 0;
    border-radius: 12px;
    background: var(--smc-green-dark);
    color: #fff;
    font: inherit;
    font-weight: 850;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease, opacity 160ms ease;
  }

  .continue:hover,
  .submit:hover {
    transform: translateY(-1px);
    background: #173d18;
  }

  .continue {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .back {
    width: fit-content;
    padding: 0;
    border: 0;
    background: none;
    color: var(--smc-green-dark);
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
  }

  .fine-print {
    margin: 0;
    color: #7a8078;
    font-size: 11px;
    line-height: 1.5;
  }

  .hp-field {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    white-space: nowrap !important;
  }

  .submit:disabled {
    opacity: .72;
    cursor: wait;
  }

  .submit-message {
    padding: 11px 12px;
    border-radius: 10px;
    background: var(--smc-green-soft);
    color: var(--smc-green-dark);
    font-size: 12px;
    line-height: 1.45;
  }

  .submit-message.error {
    background: #fff0f0;
    color: #842727;
  }

  .data-error {
    margin-top: 2px;
    padding: 12px 13px;
    border-radius: 10px;
    background: #fff0f0;
    color: #842727;
    font-size: 12px;
    line-height: 1.45;
  }

  @media (max-width: 620px) {
    .quote-card {
      padding: 22px;
      border-radius: 20px;
    }

    .quote-head h2 {
      font-size: 27px;
    }
  }
</style>