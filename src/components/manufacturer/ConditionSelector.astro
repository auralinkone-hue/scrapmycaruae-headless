---
import SectionActionButton from '../SectionActionButton.astro';
interface Condition { id:string; label:string; icon:string; category:string; title:string; copy:string; checks:string[]; href:string; linkLabel:string; }
interface Props { conditions: Condition[]; makeLabel: string; }
const {conditions,makeLabel}=Astro.props;
const first=conditions[0];
---
<section class="condition-workspace" aria-labelledby="condition-title" data-condition-explorer>
  <script type="application/json" data-condition-config set:html={JSON.stringify(conditions).replace(/</g,'\\u003c')} />
  <header><p class="overline">02 / Known condition</p><h2 id="condition-title">What's the condition<br />of your {makeLabel}?</h2><p>Select the closest description. Find out which details help the review.</p></header>
  <div class="condition-layout"><div class="condition-tabs" role="tablist" aria-label={makeLabel+' vehicle condition'}>{conditions.map((item,index)=><button type="button" role="tab" id={'condition-tab-'+index} aria-controls="condition-guidance" aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-condition-choice={index}><i class:list={['ph',item.icon]} aria-hidden="true"></i><span>{item.label}</span><span class="choice-dot" aria-hidden="true"></span></button>)}</div><div class="condition-panel" id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0"><span class="condition-category" data-condition-category>{first.category}</span><h3 data-condition-heading>{first.title}</h3><p data-condition-copy>{first.copy}</p><div class="share-heading"><i class="ph ph-note-pencil" aria-hidden="true"></i> Useful details to share</div><ul data-condition-checks>{first.checks.map(check=><li>{check}</li>)}</ul><a class="condition-guide" href={first.href} data-condition-guide><span>{first.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div></div>
  <footer><p>A starting point for the discussion.<br /><strong>Your vehicle is assessed individually.</strong></p><SectionActionButton href="#toyota-quote" label="Request my valuation" intent="valuation" /></footer><p class="condition-status" data-condition-status role="status" aria-live="polite"></p>
  <noscript><p>Explore the <a href="/scrap-my-car/">scrap-car guide</a> for information about different vehicle conditions.</p></noscript>
</section>
<style>
.condition-workspace{background:#1b2822;color:#f8faf6;border-radius:26px;padding:42px 46px 28px;margin-bottom:72px;position:relative}.overline{color:#b0c5a4;font-size:11px;text-transform:uppercase;letter-spacing:.11em;margin:0 0 16px;font-weight:700}.condition-workspace h2{font-size:clamp(30px,3.8vw,48px);line-height:1.08;letter-spacing:-.05em;margin:0;font-weight:600}.condition-workspace header>p:last-child{color:#bbc7bc;font-size:14px;line-height:1.7;margin:18px 0 0}.condition-layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.5fr);gap:42px;margin-top:30px}.condition-tabs{display:grid;gap:5px;align-content:start}.condition-tabs button{display:flex;align-items:center;gap:12px;min-height:54px;padding:10px 14px;border:1px solid transparent;border-radius:10px;background:transparent;color:#cbd6ca;font:inherit;font-size:14px;text-align:left;cursor:pointer;transition:background .17s,color .17s}.condition-tabs button>i{font-size:24px;color:#a6bca0}.condition-tabs button>span:first-of-type{flex:1}.choice-dot{height:7px;width:7px;border:1px solid #71806f;border-radius:50%}.condition-tabs button[aria-selected=true]{background:#dfeacb;color:#203528;border-color:#dfeacb;font-weight:750}.condition-tabs button[aria-selected=true]>i{color:#355a30}.condition-tabs button[aria-selected=true] .choice-dot{background:#365c30;border-color:#365c30}.condition-tabs button:hover{background:#344538}.condition-tabs button[aria-selected=true]:hover{background:#d2e2bc}.condition-panel{background:#f5f6ef;color:#24372b;padding:30px 34px;border-radius:16px;min-height:355px}.condition-category{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#526b4b;font-weight:800}.condition-panel h3{font-size:27px;line-height:1.15;letter-spacing:-.035em;margin:16px 0}.condition-panel>p{font-size:14px;line-height:1.8;color:#536255;margin:0}.share-heading{display:flex;gap:8px;align-items:center;font-size:12px;font-weight:750;margin:21px 0 11px}.share-heading i{font-size:19px}.condition-panel ul{padding-left:18px;margin:0 0 20px;display:grid;gap:7px;font-size:12px;line-height:1.7;color:#566651}.condition-guide{display:inline-flex;align-items:center;gap:12px;min-height:44px;border-bottom:1px solid #829579;color:#2f522c;font-size:12px;text-decoration:none;font-weight:750}.condition-guide i{font-size:19px}.condition-workspace footer{display:flex;align-items:center;justify-content:space-between;gap:25px;border-top:1px solid #405044;margin-top:28px;padding-top:23px}.condition-workspace footer>p{color:#b9c7b6;font-size:12px;line-height:1.65;margin:0}.condition-workspace footer strong{font-weight:500;color:#e2eadb}.condition-workspace :global(.section-action){border-color:#bbd6a3;background:#d5e9ba;color:#253c25;box-shadow:none;min-height:48px}.condition-workspace :global(.section-action i){background:#23442b;color:#e7f2de}.condition-workspace :global(.section-action:hover){background:#ecf7df;color:#1f3f26}.condition-status{min-height:16px;font-size:10px;color:#bbcfb2;margin:10px 0 0}.condition-workspace :is(button,[tabindex],a):focus-visible{outline:3px solid #8bb5e2;outline-offset:3px}.panel-changed{animation:condition-switch .22s ease}@keyframes condition-switch{from{opacity:.5}to{opacity:1}}
@media(max-width:850px){.condition-workspace{padding:32px}.condition-layout{gap:24px;grid-template-columns:1fr 1.4fr}.condition-panel{padding:26px}.condition-panel h3{font-size:24px}.condition-tabs button{font-size:12px;padding:10px;gap:8px}}
@media(max-width:620px){.condition-workspace{padding:26px 19px 18px;border-radius:20px;margin-bottom:44px}.condition-workspace h2{font-size:31px}.overline{font-size:10px;margin-bottom:14px}.condition-workspace header>p:last-child{font-size:13px;margin-top:15px}.condition-layout{display:block;margin-top:23px}.condition-tabs{grid-template-columns:1fr 1fr;gap:7px;margin-bottom:17px}.condition-tabs button{background:#293a2e;border:1px solid #415143;min-height:58px;font-size:11px;line-height:1.4;padding:9px;gap:7px}.condition-tabs button>i{font-size:20px}.choice-dot{display:none}.condition-panel{padding:24px 21px;min-height:410px;border-radius:12px}.condition-panel h3{font-size:24px;line-height:1.16;min-height:56px;margin:15px 0}.condition-panel>p{font-size:13px;line-height:1.75;min-height:115px}.condition-panel ul{min-height:78px;font-size:12px;gap:5px;margin-bottom:13px}.condition-guide{font-size:11px}.condition-workspace footer{align-items:flex-start;flex-direction:column;gap:17px;margin-top:21px;padding-top:20px}.condition-workspace footer>p{font-size:11px}.condition-workspace :global(.section-action){font-size:12px}.condition-status{font-size:10px}}
@media(prefers-reduced-motion:reduce){.condition-tabs button{transition:none}.panel-changed{animation:none}}
</style>
