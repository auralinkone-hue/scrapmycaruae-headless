---
import ConditionGraphic from './ConditionGraphic.astro';
import SectionActionButton from '../SectionActionButton.astro';
import {modelLabel,resolveModelGuidance} from '../../lib/manufacturer-models';
import {nissanPreferredModels,nissanModelGuidance as profiles,nissanConditions as conditions} from '../../lib/nissan-content';
interface Props {models:string[]}
const {models}=Astro.props;
const choices=nissanPreferredModels.filter(model=>models.includes(model));
const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,profiles);
const condition=conditions[0];
---
<section class="condition-studio" data-condition-explorer aria-labelledby="condition-title" id="nissan-condition">
 <header><p class="eyebrow">01 / The condition conversation</p><h2 id="condition-title">What's the condition<br />of your Nissan?</h2><p>Choose the closest description. Start with what you know, without testing the vehicle.</p></header>
 <script type="application/json" data-condition-config set:html={JSON.stringify(conditions).replace(/</g,'\u003c')} />
 <div class="condition-tabs" role="tablist" aria-label="Nissan condition guidance">{conditions.map((item,i)=><button type="button" role="tab" id={'condition-tab-'+i} data-condition-choice={i} aria-selected={i===0?'true':'false'} aria-controls="condition-guidance" tabindex={i===0?0:-1}><i class:list={['ph',item.icon]} aria-hidden="true"></i><span>{item.label}</span></button>)}</div>
 <ConditionGraphic /><div class="condition-result" id="condition-guidance" role="tabpanel" aria-labelledby="condition-tab-0" tabindex="0"><div><p class="eyebrow" data-condition-category>{condition.category}</p><h3 data-condition-heading>{condition.title}</h3><p data-condition-copy>{condition.copy}</p><a data-condition-guide href={condition.href}><span>{condition.linkLabel}</span><i class="ph ph-book-open" aria-hidden="true"></i></a></div><div class="information-note"><span>Useful to share</span><ul data-condition-checks>{condition.checks.map(check=><li>{check}</li>)}</ul><SectionActionButton href="#nissan-quote" label="Request a Nissan valuation" intent="valuation" /></div></div>
 <p class="selection-status" data-condition-status role="status" aria-live="polite"></p>
</section>
<section class="nissan-models" id="nissan-models" data-model-explorer aria-labelledby="model-title">
 <header><p class="eyebrow">02 / Your model, your starting point</p><h2 id="model-title">Find your Nissan.<br /><span>Focus the assessment.</span></h2><p>Choose a model for practical guidance. Your selection also updates the valuation form.</p></header>
 {models.length? <><script type="application/json" data-model-config set:html={JSON.stringify({make:'NISSAN',models,profiles,initial}).replace(/</g,'\u003c')} />
 <div class="model-directory"><div class="model-choices"><div class="model-tabs" role="tablist" aria-label="Nissan model guidance">{choices.map((model,i)=><button role="tab" type="button" id={'model-tab-'+i} aria-selected={model===initial?'true':'false'} tabindex={model===initial?0:-1} aria-controls="model-guidance" data-model-choice={model}><span>{modelLabel(model)}</span><i class="ph ph-car-profile" aria-hidden="true"></i></button>)}</div><label for="manufacturer-all-models">All {models.length} catalogue models<select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{modelLabel(model)}</option>)}</select></label></div>
 <div id="model-guidance" class="model-result" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="model-heading"><p data-model-category>{guidance.category}</p><span data-model-name>{modelLabel(initial)}</span></div><h3 data-model-heading>{guidance.title}</h3><p data-model-copy>{guidance.copy}</p><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><SectionActionButton href="#nissan-quote" label={'Value my '+modelLabel(initial)} intent="valuation" /></div></div><p class="selection-status" data-model-status role="status" aria-live="polite"></p></>:<p>Model options are temporarily unavailable. <a href="/contact-us/">Contact us about your Nissan</a>.</p>}
</section>
<section class="recovery-studio" aria-labelledby="readiness-title" data-readiness>
 <header><p class="eyebrow">03 / Recovery readiness</p><h2 id="readiness-title">Before the vehicle<br /><span>leaves its space.</span></h2><p>Three quick prompts to prepare for the discussion. Advisory only; answers stay on this page and do not decide price or acceptance.</p></header>
 <div class="readiness-controls">{[['rolling','ph-tire','Can it roll and steer?'],['keys','ph-key','Are the keys available?'],['access','ph-garage','Is there recovery access?']].map(([id,icon,label])=><label for={'readiness-'+id}><i class:list={['ph',icon]} aria-hidden="true"></i><span>{label}</span><select id={'readiness-'+id} data-readiness-answer={id}><option value="unknown">Not sure</option><option value="yes">Yes, as far as known</option><option value="no">No / restricted</option></select></label>)}</div>
 <div class="readiness-result" role="status" aria-live="polite" aria-atomic="true"><h3>Information for your recovery discussion</h3><ul data-readiness-guidance><li>If mobility is unknown, say so. Do not start or move a damaged vehicle to find out.</li><li>Confirm key availability with the authorised handover contact when possible.</li><li>Share existing location photographs or access details when discussing the vehicle.</li></ul><a href="/car-removal/">Explore vehicle recovery considerations <i class="ph ph-truck" aria-hidden="true"></i></a></div>
</section>
<script>
 import {recoveryGuidance,type ReadinessAnswer} from '../../lib/nissan-readiness';
 const readiness=document.querySelector('[data-readiness]');
 if(readiness){const controls=Array.from(readiness.querySelectorAll<HTMLSelectElement>('[data-readiness-answer]'));controls.forEach(control=>control.addEventListener('change',()=>{const answers=controls.map(item=>item.value as ReadinessAnswer);const list=readiness.querySelector('[data-readiness-guidance]');list?.replaceChildren(...recoveryGuidance(answers[0],answers[1],answers[2]).map(text=>{const li=document.createElement('li');li.textContent=text;return li;}));}));}
</script>
<style>
section{scroll-margin-top:30px}h2,h3,p{margin:0}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:10px;font-weight:750;color:#50704f;margin-bottom:16px}h2{font-size:clamp(32px,3.6vw,48px);letter-spacing:-.055em;line-height:1.08;font-weight:650}h2 span{color:#70816e}header>p:last-child{font-size:14px;line-height:1.8;color:#68716a;max-width:480px;margin-top:20px}a{color:#305b3a;text-underline-offset:4px}button,select{font:inherit}.condition-studio{padding:65px 0 45px}.condition-studio header{position:relative;padding-right:43%}.condition-studio header>p:last-child{position:absolute;right:0;bottom:0;width:34%}.condition-tabs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));margin-top:30px;gap:8px}.condition-tabs button{display:flex;flex-direction:column;align-items:flex-start;gap:13px;padding:16px 13px;min-height:94px;border:1px solid #d7ddd4;border-radius:12px;background:transparent;color:#536153;font-size:12px;font-weight:650;text-align:left;cursor:pointer;transition:background .2s,color .2s,border-color .2s}.condition-tabs i{font-size:25px}.condition-tabs button[aria-selected=true]{background:#e0e9d8;border-color:#5a7650;color:#204329}.condition-tabs button:hover{border-color:#73876a}.condition-result{display:grid;grid-template-columns:1.5fr 1fr;gap:45px;padding:30px 0 0;min-height:300px}.condition-result h3{font-size:26px;font-weight:600;letter-spacing:-.035em;line-height:1.2;max-width:550px}.condition-result p:not(.eyebrow){font-size:14px;line-height:1.85;color:#616d61;margin-top:16px}.condition-result a:not(:global(.section-action)){display:inline-flex;align-items:center;gap:12px;min-height:48px;font-size:12px;font-weight:650;margin-top:12px}.information-note{border-left:1px solid #ccd6c7;padding-left:30px}.information-note>span{font-size:11px;font-weight:750;text-transform:uppercase;letter-spacing:.08em;color:#5c6e56}.information-note ul{padding-left:16px;margin:18px 0 25px;display:grid;gap:11px;font-size:13px;line-height:1.7;color:#52614d}.information-note :global(.section-action){font-size:12px;box-shadow:none}.selection-status{font-size:11px;line-height:1.7;color:#657361;min-height:20px;margin-top:15px}.nissan-models{padding:40px 0 60px;border-top:1px solid #d6dcd1}.nissan-models header{display:grid;grid-template-columns:1fr 1fr;gap:0 60px;align-items:end}.nissan-models .eyebrow{grid-column:1/-1}.nissan-models header>p:last-child{margin:0;max-width:360px;justify-self:end}.model-directory{display:grid;grid-template-columns:.7fr 1.5fr;gap:38px;margin-top:30px;background:#fff;border:1px solid #e0e3da;border-radius:18px;padding:26px}.model-tabs{display:grid;gap:2px}.model-tabs button{display:flex;justify-content:space-between;align-items:center;min-height:47px;border:0;border-bottom:1px solid #e1e6db;background:transparent;font-size:14px;text-align:left;padding:10px 13px;cursor:pointer;color:#5a6758;border-radius:7px}.model-tabs i{font-size:21px}.model-tabs button[aria-selected=true]{background:#26352d;color:#fff;border-color:transparent}.model-choices label{display:grid;gap:8px;margin-top:23px;font-size:11px;color:#5c6f56}.model-choices select{min-height:46px;max-width:100%;width:100%;padding:10px;border:1px solid #cdd8c6;border-radius:8px;background:#f5f7f0;color:#31472d;font-size:14px}.model-result{min-width:0;padding:8px 9px 8px 0}.model-heading{display:flex;justify-content:space-between;align-items:start;gap:20px;border-bottom:1px solid #e0e6d9;padding-bottom:20px;margin-bottom:24px}.model-heading p{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#6e8067;padding-top:10px}.model-heading>span{font-size:44px;letter-spacing:-.055em;line-height:1.1;color:#324c34;font-weight:650;overflow-wrap:anywhere;text-align:right}.model-result h3{font-size:26px;font-weight:600;letter-spacing:-.035em;line-height:1.2}.model-result>p{font-size:14px;line-height:1.8;color:#697464;margin-top:16px}.model-result ul{list-style:none;padding:0;margin:22px 0;display:grid;gap:9px;font-size:12px;color:#52694c;line-height:1.7}.model-result :global(li){display:flex;gap:9px}.model-result :global(li i){flex-shrink:0;font-size:17px}.model-result :global(.section-action){font-size:12px;box-shadow:none}.recovery-studio{border-top:1px solid #d6dcd1;padding:40px 0 60px;display:grid;grid-template-columns:1fr 1.2fr;gap:32px 60px}.recovery-studio header{grid-row:1/3}.readiness-controls{display:grid;gap:13px}.readiness-controls label{display:grid;grid-template-columns:25px 1fr 190px;gap:12px;align-items:center;font-size:13px;font-weight:600;line-height:1.5}.readiness-controls label i{font-size:23px;color:#67815c}.readiness-controls select{width:100%;min-width:0;min-height:46px;padding:9px;background:#fff;border:1px solid #cbd5c5;border-radius:8px;font-size:12px;color:#344d2d}.readiness-result{padding:22px 25px;background:#e7ecdf;border-radius:13px}.readiness-result h3{font-size:14px;font-weight:650}.readiness-result ul{padding-left:17px;font-size:12px;line-height:1.8;color:#58684e;display:grid;gap:9px;margin:15px 0 8px}.readiness-result a{display:inline-flex;align-items:center;gap:12px;min-height:44px;font-size:11px;font-weight:700}.panel-changed{animation:panel-in .22s ease}@keyframes panel-in{from{opacity:.65;transform:translateY(3px)}to{opacity:1;transform:none}}:is(button,select,a,[tabindex]):focus-visible{outline:3px solid #5589bb;outline-offset:4px}
@media(max-width:1024px){.condition-tabs{grid-template-columns:repeat(3,1fr)}.condition-tabs button{flex-direction:row;align-items:center;min-height:58px;gap:12px}.condition-result{gap:25px}.model-directory{gap:25px}.readiness-controls label{grid-template-columns:25px 1fr}.readiness-controls select{grid-column:2}.recovery-studio{gap:30px}}
@media(max-width:760px){.condition-studio{padding:38px 0 32px}h2{font-size:33px}.eyebrow{font-size:9px;margin-bottom:14px}.condition-studio header{padding:0}.condition-studio header>p:last-child{position:static;width:auto;font-size:13px;margin-top:16px}.condition-tabs{grid-template-columns:1fr 1fr;margin-top:22px;gap:7px}.condition-tabs button{padding:12px 11px;min-height:54px;font-size:11px;gap:9px}.condition-tabs i{font-size:22px}.condition-result{display:block;padding-top:25px;min-height:535px}.condition-result h3{font-size:24px}.condition-result p:not(.eyebrow){font-size:13px;line-height:1.8;margin-top:14px}.information-note{border-left:0;border-top:1px solid #d3ddcc;padding:19px 0 0;margin-top:18px}.information-note ul{font-size:12px;margin:13px 0 20px;gap:7px}.condition-result a:not(:global(.section-action)){font-size:11px;margin-top:8px}.selection-status{font-size:10px}.nissan-models{padding:32px 0 36px}.nissan-models header{display:block}.nissan-models header>p:last-child{font-size:13px;margin-top:16px}.model-directory{display:block;padding:17px;margin-top:24px}.model-tabs{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.model-tabs button{min-height:47px;font-size:12px;border:1px solid #dbe2d5;padding:10px;gap:6px}.model-tabs i{font-size:18px}.model-choices label{margin-top:17px}.model-result{padding:25px 0 0;min-height:440px}.model-heading{padding-bottom:15px;margin-bottom:21px}.model-heading>span{font-size:38px}.model-result h3{font-size:24px}.model-result>p{font-size:13px}.model-result ul{font-size:11px;gap:8px;margin:18px 0 22px}.recovery-studio{display:block;padding:32px 0 36px}.recovery-studio header>p:last-child{font-size:13px;margin-top:16px}.readiness-controls{margin-top:25px;gap:14px}.readiness-controls label{grid-template-columns:24px 1fr;gap:7px 10px;font-size:13px}.readiness-controls select{grid-column:2;font-size:14px;min-height:46px}.readiness-result{margin-top:23px;padding:20px}.readiness-result ul{font-size:12px}.readiness-result a{font-size:11px}}
@media(prefers-reduced-motion:reduce){.panel-changed{animation:none}.condition-tabs button{transition:none}}
</style>
