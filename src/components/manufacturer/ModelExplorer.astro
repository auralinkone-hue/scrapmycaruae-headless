---
import SectionActionButton from '../SectionActionButton.astro';
import { modelLabel, resolveModelGuidance, type ModelGuidance } from '../../lib/manufacturer-models';
interface Props { make: string; models: string[]; profiles: Record<string,ModelGuidance>; preferred: string[]; heading?: string[]; description?: string; }
const {make,models,profiles,preferred,heading=[`Every ${modelLabel(Astro.props.make)} has`,'its own starting point.'],description='An SUV, a family car or a working pickup. Choose your model for the details that help an individual scrap assessment.'}=Astro.props;
const choices=preferred.filter(model=>models.includes(model));
const initial=choices[0]??models[0]??'';
const guidance=resolveModelGuidance(initial,profiles);
---
<section class="model-explorer" id={make.toLowerCase()+'-models'} aria-labelledby="model-title" data-model-explorer>
  <header class="explorer-heading"><div><p class="overline">01 / Find your model</p><h2 id="model-title">{heading.map((line,index)=><>{index>0&&<br />}{line}</>)}</h2></div><p>{description}</p></header>
  {models.length ? <>
    <script type="application/json" data-model-config set:html={JSON.stringify({make,models,profiles,initial}).replace(/</g,'\\u003c')} />
    <div class="model-controls"><div role="tablist" aria-label={modelLabel(make)+' model guidance'} class="model-tabs">{choices.map((model,index)=><button type="button" role="tab" id={'model-tab-'+index} aria-controls="model-guidance" aria-selected={model===initial?'true':'false'} tabindex={model===initial?0:-1} data-model-choice={model}><i class:list={['ph', ['LAND CRUISER','PRADO'].includes(model)?'ph-jeep':model==='HILUX'?'ph-truck-pickup':'ph-car-profile']} aria-hidden="true"></i>{modelLabel(model)}</button>)}</div><label class="model-more" for="manufacturer-all-models"><span>All {models.length} {modelLabel(make)} models</span><select id="manufacturer-all-models" data-all-models>{models.map(model=><option value={model} selected={model===initial}>{modelLabel(model)}</option>)}</select></label></div>
    <div class="model-detail" id="model-guidance" role="tabpanel" aria-labelledby={choices.length?'model-tab-0':'manufacturer-all-models'} tabindex="0"><div class="model-identity"><span class="model-name" data-model-name>{modelLabel(initial)}</span><span class="model-category" data-model-category>{guidance.category}</span><span class="model-symbol" aria-hidden="true"><i class="ph ph-car-profile"></i></span></div><div class="model-copy"><h3 data-model-heading>{guidance.title}</h3><p data-model-copy>{guidance.copy}</p><ul data-model-checks>{guidance.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i><span>{check}</span></li>)}</ul><SectionActionButton href="#toyota-quote" label={'Value my '+modelLabel(initial)} intent="valuation" /></div></div>
    <p class="selection-status" data-model-status role="status" aria-live="polite"></p>
    <noscript><p>Use the valuation form to choose your vehicle model. Interactive model guidance requires JavaScript.</p></noscript>
  </> : <p class="model-unavailable">Model options are temporarily unavailable. Please try again shortly or <a href="/contact-us/">contact us about your vehicle</a>.</p>}
</section>
<style>
.model-explorer{padding:74px 0 66px}.explorer-heading{display:flex;align-items:end;justify-content:space-between;gap:50px;margin-bottom:30px}.overline{font-size:11px;letter-spacing:.11em;text-transform:uppercase;font-weight:750;color:#4c6950;margin:0 0 18px}.explorer-heading h2{font-size:clamp(30px,3.8vw,50px);letter-spacing:-.055em;line-height:1.07;margin:0;font-weight:650}.explorer-heading>p{max-width:345px;font-size:14px;color:#647066;line-height:1.8;margin:0 0 3px}.model-controls{display:flex;gap:24px;align-items:end;justify-content:space-between;padding:0 0 24px}.model-tabs{display:flex;gap:7px;flex-wrap:wrap}.model-tabs button{display:flex;align-items:center;gap:7px;border:1px solid #dce2d8;border-radius:9px;min-height:46px;padding:8px 12px;background:#fff;color:#304037;font:inherit;font-size:12px;font-weight:700;cursor:pointer;transition:background .16s,border-color .16s}.model-tabs button i{font-size:19px}.model-tabs button[aria-selected=true]{background:#1e452d;border-color:#1e452d;color:#fff}.model-tabs button:hover{border-color:#50724c}.model-more{display:grid;gap:5px;font-size:10px;color:#657365;flex-shrink:0}.model-more select{min-height:46px;max-width:210px;padding:8px 30px 8px 11px;border:1px solid #dce2d8;border-radius:9px;background:#fff;color:#273b2b;font:inherit;font-size:12px}.model-detail{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.5fr);border-top:1px solid #cdd8c8;border-bottom:1px solid #cdd8c8;min-height:318px;background:#f1f4ed;border-radius:0 0 20px 20px}.model-identity{padding:30px;display:flex;flex-direction:column;position:relative;overflow:hidden;border-right:1px solid #d9e1d3}.model-name{font-size:clamp(30px,4vw,55px);line-height:1.03;font-weight:650;letter-spacing:-.06em;overflow-wrap:anywhere}.model-category{font-size:12px;color:#60705d;margin-top:14px}.model-symbol{font-size:95px;line-height:1;margin-top:auto;padding-top:25px;align-self:flex-end;color:#c2d1b7}.model-copy{padding:30px 35px}.model-copy h3{font-size:24px;letter-spacing:-.03em;line-height:1.2;margin:0 0 12px}.model-copy>p{font-size:14px;line-height:1.8;color:#58635a;max-width:650px;margin:0}.model-copy ul{list-style:none;margin:16px 0 22px;padding:0;display:grid;gap:9px}.model-copy li{display:flex;gap:8px;font-size:12px;line-height:1.6;color:#3b513b}.model-copy li i{font-size:16px;flex-shrink:0;color:#53824d}.selection-status{min-height:19px;font-size:11px;margin:10px 0 0;color:#4b6d47}.model-copy :global(.section-action){min-height:46px;font-size:12px;box-shadow:none}.model-explorer :is(button,select,[tabindex]):focus-visible{outline:3px solid #548bc2;outline-offset:3px}.panel-changed{animation:model-switch .22s ease}@keyframes model-switch{from{opacity:.5}to{opacity:1}}
@media(max-width:1050px){.model-controls{display:block}.model-more{margin-top:15px;max-width:260px}.model-more select{max-width:none}.model-copy{padding:26px}.model-identity{padding:26px}.model-detail{grid-template-columns:.8fr 1.3fr}}
@media(max-width:620px){.model-explorer{padding:44px 0}.explorer-heading{display:block;margin-bottom:22px}.explorer-heading h2{font-size:33px}.explorer-heading>p{font-size:13px;margin:17px 0 0;max-width:none}.overline{font-size:10px;margin-bottom:13px}.model-controls{padding-bottom:18px}.model-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.model-tabs button{justify-content:center;padding:8px 5px;gap:5px;font-size:11px;line-height:1.4;min-height:48px}.model-tabs button i{font-size:17px}.model-more{max-width:none;margin-top:14px;grid-template-columns:1fr 1.2fr;align-items:center;font-size:11px}.model-more select{width:100%;min-width:0;font-size:16px}.model-detail{display:block;min-height:490px;border-radius:0 0 16px 16px}.model-identity{display:flex;flex-direction:row;align-items:center;flex-wrap:wrap;gap:8px 14px;padding:21px;border-right:0;border-bottom:1px solid #d9e1d3}.model-name{font-size:32px}.model-category{font-size:11px;margin:0}.model-symbol{display:none}.model-copy{padding:23px 21px}.model-copy h3{font-size:22px}.model-copy>p{font-size:13px;line-height:1.8}.model-copy ul{margin:15px 0 20px;min-height:86px}.model-copy li{font-size:12px}.selection-status{font-size:10px}}
@media(prefers-reduced-motion:reduce){.model-tabs button{transition:none}.panel-changed{animation:none}}
</style>
