---
import SectionActionButton from '../SectionActionButton.astro';
interface Props {makeLabel:string;quoteId:string;}
const {makeLabel,quoteId}=Astro.props;
const steps=[
 {label:'Vehicle details',icon:'ph-car-profile',heading:`Identify your ${makeLabel}`,copy:'Choose the exact make, model and year, then add your contact details in the valuation form.',checks:['Exact model and year','Your name and contact number','Specification, if already known'],action:'Enter my vehicle details',href:'#'+quoteId,intent:'valuation' as const},
 {label:'Condition & access',icon:'ph-list-checks',heading:'Show the car as it stands',copy:'Share existing photos or workshop findings. Describe known damage, missing parts and where the vehicle is parked.',checks:['Known faults or visible damage','Keys, tyre condition and movement restrictions','Parking location, gates and clearance'],action:'Explore condition guidance',href:'#condition-title',intent:'valuation' as const},
 {label:'Review & handover',icon:'ph-key',heading:'Prepare for the next conversation',copy:'Discuss the vehicle assessment and recovery requirements. Confirm the necessary documents and authorised handover contact before agreeing arrangements.',checks:['Available ownership and registration documents','Who can authorise release','Collection access and permission requirements'],action:'Read collection guidance',href:'/car-removal/',intent:'valuation' as const}
];
---
<section class="enquiry-journey" data-enquiry-journey aria-labelledby="enquiry-title">
 <header><div><p class="journey-kicker">Plan your enquiry</p><h2 id="enquiry-title">Your {makeLabel} valuation.<br /><span>Know what to prepare.</span></h2></div><p>Explore each stage for the details you’ll need.</p></header>
 <div class="journey-tabs" hidden role="tablist" aria-label={`${makeLabel} enquiry preparation`}>{steps.map((step,i)=><button type="button" role="tab" id={`journey-tab-${i}`} aria-selected={i===0?'true':'false'} aria-controls={`journey-panel-${i}`} tabindex={i===0?0:-1} data-journey-step={i}><span class="step-icon"><i class:list={['ph',step.icon]} aria-hidden="true"></i></span><span class="step-label"><small>0{i+1}</small>{step.label}</span><i class="ph ph-caret-right" aria-hidden="true"></i></button>)}</div>
 {steps.map((step,i)=><div class="journey-panel" id={`journey-panel-${i}`} role="tabpanel" aria-labelledby={`journey-tab-${i}`} tabindex="0"><div class="journey-art" aria-hidden="true"><span>0{i+1}</span><i class:list={['ph',step.icon]}></i><div class="art-line"></div><i class="ph ph-check-circle"></i></div><div class="journey-copy"><h3>{step.heading}</h3><p>{step.copy}</p><SectionActionButton href={step.href} label={step.action} intent={step.intent} icon={i===0?'ph-car-profile':i===1?'ph-list-checks':'ph-truck'} /></div><div class="journey-checks"><span>Have these details ready</span><ul>{step.checks.map(check=><li><i class="ph ph-check" aria-hidden="true"></i>{check}</li>)}</ul></div></div>)}
 <noscript><p>Enable JavaScript to explore the other preparation stages. You can also <a href="/car-removal/">read collection guidance</a>.</p></noscript>
</section>
<script>
 function initialiseJourneys(){document.querySelectorAll<HTMLElement>('[data-enquiry-journey]').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-journey-step]'));const panels=Array.from(root.querySelectorAll<HTMLElement>('[role=tabpanel]'));tabs[0]?.parentElement?.removeAttribute('hidden');const select=(index:number,focus=false)=>{tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;});panels.forEach((panel,i)=>panel.hidden=i!==index);if(focus)tabs[index].focus({preventScroll:true});};tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>select(index));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight'||event.key==='ArrowDown')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft'||event.key==='ArrowUp')next=(index+tabs.length-1)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();select(next,true);});});select(0);});}
 initialiseJourneys();document.addEventListener('astro:page-load',initialiseJourneys);
</script>
<style>
.enquiry-journey{margin:38px 0 44px;border:1px solid #cedfca;border-radius:22px;background:#fff;padding:30px;color:#24392a}.enquiry-journey header{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:26px}.journey-kicker{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#2f6f2d;font-weight:750;margin:0 0 12px}.enquiry-journey h2{font-size:clamp(28px,3vw,39px);line-height:1.12;letter-spacing:-.045em;margin:0;font-weight:650}.enquiry-journey h2 span{color:var(--smc-green,#2f6f2d)}.enquiry-journey header>p{font-size:13px;line-height:1.7;color:#5d7160;max-width:240px;margin:0}.journey-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.journey-tabs button{display:flex;align-items:center;gap:12px;text-align:left;min-height:80px;padding:13px 16px;background:#f1f6ef;border:1px solid #d8e5d4;border-radius:12px;color:#335337;font:inherit;cursor:pointer;transition:background .18s,color .18s,transform .18s}.journey-tabs button[aria-selected=true]{background:var(--smc-green,#2f6f2d);color:#fff;border-color:var(--smc-green,#2f6f2d)}.step-icon{display:grid;place-items:center;width:42px;height:42px;border:1px solid currentColor;border-radius:12px;flex-shrink:0}.step-icon i{font-size:25px}.step-label{flex:1;font-size:14px;font-weight:700;line-height:1.4}.step-label small{display:block;font-size:10px;letter-spacing:.1em;font-weight:500;margin-bottom:3px}.journey-panel{display:grid;grid-template-columns:120px minmax(0,1.3fr) minmax(0,1fr);align-items:center;gap:28px;min-height:235px;padding:28px 0 0}.journey-panel[hidden],.journey-tabs[hidden]{display:none}.journey-art{height:160px;position:relative;border-radius:18px;background:#eaf4e6;color:#2f6f2d;display:grid;place-content:center}.journey-art>span{position:absolute;left:12px;top:10px;font-size:11px;letter-spacing:.08em}.journey-art>i:first-of-type{font-size:58px}.journey-art>i:last-child{font-size:23px;position:absolute;right:10px;bottom:10px;background:#eaf4e6}.art-line{height:2px;width:62px;background:#a9cba2;margin-top:17px}.journey-copy h3{font-size:23px;line-height:1.25;letter-spacing:-.025em;font-weight:650;margin:0 0 12px}.journey-copy p{font-size:13px;line-height:1.8;color:#536b56;margin:0}.journey-copy :global(.section-action){font-size:12px;min-height:44px;margin-top:18px;box-shadow:none}.journey-checks{padding:20px;background:#f3f7f0;border-radius:13px;align-self:stretch;display:flex;flex-direction:column;justify-content:center}.journey-checks>span{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#38663a;font-weight:750}.journey-checks ul{padding:0;list-style:none;display:grid;gap:12px;margin:16px 0 0}.journey-checks li{display:flex;gap:9px;font-size:12px;line-height:1.7;color:#405c43}.journey-checks i{font-size:18px;flex-shrink:0;color:#2f6f2d}.enquiry-journey :is(button,[tabindex],a):focus-visible{outline:3px solid #548bc2;outline-offset:4px}
@media(hover:hover){.journey-tabs button:hover{transform:translateY(-2px);border-color:#2f6f2d}}
@media(max-width:900px){.journey-panel{grid-template-columns:80px minmax(0,1fr);gap:20px}.journey-art{height:130px}.journey-art>i:first-of-type{font-size:43px}.journey-checks{grid-column:1/-1}.journey-checks ul{grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.journey-tabs button{padding:12px;gap:8px}.step-label{font-size:12px}.step-icon{width:32px;height:36px}.step-icon i{font-size:22px}}
@media(max-width:620px){.enquiry-journey{padding:22px 17px;margin:28px 0;border-radius:17px}.enquiry-journey header{display:block;margin-bottom:22px}.enquiry-journey h2{font-size:28px}.enquiry-journey header>p{margin-top:14px;font-size:12px;max-width:none}.journey-tabs{gap:6px}.journey-tabs button{display:flex;flex-direction:column;align-items:start;min-height:126px;padding:11px 8px;gap:8px}.journey-tabs button>i{display:none}.step-label{font-size:11px}.step-icon{width:32px;height:32px;border-radius:9px}.step-label small{font-size:9px}.journey-panel{grid-template-columns:1fr;gap:16px;min-height:450px;padding-top:22px}.journey-art{display:none}.journey-copy h3{font-size:22px}.journey-copy p{font-size:12px}.journey-checks{grid-column:auto;padding:17px}.journey-checks ul{grid-template-columns:1fr;gap:9px}.journey-copy :global(.section-action){font-size:11px;max-width:100%}.journey-checks li{font-size:12px}}
@media(prefers-reduced-motion:reduce){.journey-tabs button{transition:none;transform:none!important}}
</style>
