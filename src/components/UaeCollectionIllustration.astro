---
interface Props { label?: string; }
const { label = 'UAE vehicle collection illustration' } = Astro.props;
---

<div class="collection-illustration" role="img" aria-label={label}>
  <svg viewBox="0 0 520 330" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="collection-pin" x1="230" y1="55" x2="326" y2="231" gradientUnits="userSpaceOnUse"><stop stop-color="#498C48"/><stop offset="1" stop-color="#215C2C"/></linearGradient>
    </defs>
    <path d="M70 188C103 139 143 110 191 106C246 101 273 128 317 109C360 90 404 89 454 128" stroke="#CBE4C6" stroke-width="2" stroke-dasharray="4 10"/>
    <path d="M59 225C126 185 169 256 244 225C314 196 354 247 456 202" stroke="#D9ECD5" stroke-width="2" stroke-dasharray="4 10"/>
    <path d="M150 167C172 136 217 121 260 134C303 147 322 180 359 183C391 185 422 164 438 139" stroke="#B7DAB0" stroke-width="3" stroke-linecap="round"/>
    <path d="M226 112C226 76 254 48 290 48C326 48 354 76 354 112C354 156 290 213 290 213C290 213 226 156 226 112Z" fill="url(#collection-pin)"/>
    <circle cx="290" cy="111" r="25" fill="#F7FCF5"/><path d="M279 112L287 120L303 103" stroke="#2F7D32" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="111" cy="165" r="6" fill="#77AD6D"/><circle cx="421" cy="139" r="6" fill="#77AD6D"/><circle cx="186" cy="239" r="6" fill="#77AD6D"/><circle cx="386" cy="222" r="6" fill="#77AD6D"/>
    <path d="M210 255H370" stroke="#2E7435" stroke-width="3" stroke-linecap="round"/>
    <path d="M239 244H312C321 244 328 251 328 260V268H228V255C228 249 233 244 239 244Z" fill="#2F7D32"/>
    <path d="M329 251H353L369 268H329V251Z" fill="#3E8742"/>
    <circle cx="253" cy="274" r="12" fill="#17331D"/><circle cx="344" cy="274" r="12" fill="#17331D"/>
  </svg>
</div>

<style>
  .collection-illustration { position:relative; overflow:hidden; }
  .collection-illustration::after { position:absolute; inset:9% 6%; border:1px solid rgba(74,139,73,.15); border-radius:50%; content:''; pointer-events:none; }
  svg { display:block; width:100%; height:auto; }
</style>
