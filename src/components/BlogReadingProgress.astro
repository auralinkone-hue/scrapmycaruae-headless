<div class="blog-reading-progress" data-blog-reading-progress aria-hidden="true">
  <div class="blog-reading-progress__fill"></div>
</div>

<script>
  function initialiseBlogReadingProgress() {
    const bar = document.querySelector<HTMLElement>('[data-blog-reading-progress]');
    const reading = document.querySelector<HTMLElement>('.article-content');
    if (!bar || !reading || bar.dataset.initialised === 'true') return;
    bar.dataset.initialised = 'true';
    let pendingFrame = 0;
    const update = () => {
      pendingFrame = 0;
      // Reach 100% near the end of the written article, not after the sidebar/footer.
      const articleEnd = reading.getBoundingClientRect().bottom + window.scrollY;
      const finishAt = Math.max(1, articleEnd - window.innerHeight * 0.65);
      const amount = Math.min(1, Math.max(0, window.scrollY / finishAt));
      bar.style.setProperty('--blog-read-progress', String(amount));
    };
    const requestUpdate = () => {
      if (!pendingFrame) pendingFrame = window.requestAnimationFrame(update);
    };
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    update();
  }
  initialiseBlogReadingProgress();
  document.addEventListener('astro:page-load', initialiseBlogReadingProgress);
</script>

<style>
  .blog-reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 1100;
    background: rgba(69, 120, 75, 0.12);
    pointer-events: none;
    overflow: hidden;
  }
  .blog-reading-progress__fill {
    width: 100%;
    height: 100%;
    transform: scaleX(var(--blog-read-progress, 0));
    transform-origin: left center;
    background: linear-gradient(90deg, #337c42, #80ba51);
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-reading-progress__fill { will-change: auto; }
  }
</style>
