---
const year = new Date().getFullYear();
const whatsappUrl = 'https://api.whatsapp.com/send?phone=%2B971557458322';
import { footerDubaiLocations, footerUaeLocations } from '../lib/locations';
---

<footer class="smc-footer">
  <div class="smc-footer-main">
    <div class="smc-container footer-grid">
      <div class="footer-brand">
        <img
          src="https://static.wixstatic.com/media/ff8df3_7abbb70e8dbf4941a2f88fb3caee9de1~mv2.png"
          alt="Scrap My Car UAE"
          width="166"
          height="64"
        />
        <p>
          Sell your scrap car hassle-free with Scrap My Car UAE. Car buyers
          serving Dubai, Sharjah and customers across the UAE.
        </p>
      </div>

      <div>
        <h2>Quick links</h2>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/">Home</a>
          <a href="/free-quote" data-analytics-quote-cta="footer">Free Quote</a>
          <a href="/contact-us/">Contact Us</a>
          <a href="/faqs/">FAQs</a>
          <a href="/blogs">Blogs</a>
          <a href="/locations/">UAE Locations</a>
        </nav>
      </div>

      <div>
        <h2>Dubai</h2>
        <div class="location-list">
          {footerDubaiLocations.map((location) => <span><i class="ph ph-map-pin" aria-hidden="true"></i>{location}</span>)}
        </div>
      </div>

      <div>
        <h2>Across the UAE</h2>
        <div class="location-list">
          {footerUaeLocations.map((location) => <span><i class="ph ph-map-pin" aria-hidden="true"></i>{location}</span>)}
        </div>
      </div>
    </div>

    <div class="smc-container contact-strip">
      <div>
        <span class="label"><i class="ph ph-map-pin" aria-hidden="true"></i>Address</span>
        <span>Al Sajaa Industrial Area, Sajaa, Sharjah</span>
      </div>
      <div>
        <span class="label"><i class="ph ph-phone-call" aria-hidden="true"></i>Phone</span>
        <a href="tel:+971557458322">055 745 83 22</a>
      </div>
      <div>
        <span class="label"><i class="ph ph-envelope-simple" aria-hidden="true"></i>Email</span>
        <a href="mailto:info@scrapmycaruae.com">info@scrapmycaruae.com</a>
      </div>
      <div>
        <span class="label"><img class="wa-icon" src="/whatsapp.svg" alt="" aria-hidden="true" />WhatsApp</span>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">+971 55 745 8322</a>
      </div>
    </div>
  </div>

  <div class="smc-footer-bottom">
    <div class="smc-container bottom-inner">
      <span>© {year} Scrap My Car UAE</span>
      <div>
        <a href="/terms-conditions/">Terms</a>
        <a href="/privacy-policy">Privacy</a>
        <button class="cookie-settings-trigger" type="button" data-cookie-settings>
          <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>
          Cookie Settings
        </button>
      </div>
    </div>
  </div>
</footer>

<div class="cookie-consent-banner" data-cookie-banner hidden>
  <div class="cookie-consent-banner__copy">
    <strong>Your privacy choices</strong>
    <span>We use necessary cookies and, with your permission, optional analytics cookies.</span>
  </div>
  <div class="cookie-consent-banner__actions">
    <button class="cookie-consent-banner__manage" type="button" data-cookie-settings>Manage choices</button>
    <button type="button" data-cookie-reject>Reject optional</button>
    <button class="is-primary" type="button" data-cookie-accept>Accept cookies</button>
  </div>
</div>

<div class="cookie-modal" data-cookie-modal hidden>
  <div class="cookie-modal__backdrop" data-cookie-backdrop></div>
  <section class="cookie-modal__panel" role="dialog" aria-modal="true" aria-labelledby="cookie-modal-title" aria-describedby="cookie-modal-description" tabindex="-1">
    <button class="cookie-modal__close" type="button" data-cookie-close aria-label="Close cookie preferences">
      <i class="ph ph-x" aria-hidden="true"></i>
    </button>

    <div class="cookie-modal__heading-icon" aria-hidden="true"><i class="ph ph-shield-check"></i></div>
    <p class="cookie-modal__eyebrow">Privacy controls</p>
    <h2 id="cookie-modal-title">Your cookie preferences</h2>
    <p id="cookie-modal-description">We use necessary cookies to operate the website. With your permission, optional analytics cookies help us understand how visitors use the site.</p>

    <div class="cookie-preference-list">
      <div class="cookie-preference-row">
        <div>
          <strong>Necessary cookies</strong>
          <span>Required for core website features and saved privacy choices.</span>
        </div>
        <span class="cookie-always-active"><i class="ph ph-check-circle" aria-hidden="true"></i>Always active</span>
      </div>
      <label class="cookie-preference-row" for="analytics-cookies-toggle">
        <div>
          <strong>Analytics cookies</strong>
          <span>Help us understand site use so we can improve the experience.</span>
        </div>
        <span class="cookie-toggle">
          <input id="analytics-cookies-toggle" type="checkbox" data-analytics-toggle />
          <span aria-hidden="true"></span>
        </span>
      </label>
    </div>

    <div class="cookie-modal__actions">
      <button type="button" data-modal-reject>Reject optional</button>
      <button type="button" data-cookie-save>Save preferences</button>
      <button class="is-primary" type="button" data-modal-accept>Accept all</button>
    </div>
  </section>
</div>

<style>
  .smc-footer {
    margin-top: 0;
    background: #102912;
    color: #eef5ed;
  }

  .smc-footer-main {
    padding: 58px 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr .8fr .8fr .8fr;
    gap: 44px;
  }

  .footer-brand img {
    display: block;
    width: 165px;
    height: auto;
    max-height: 64px;
    object-fit: contain;
    filter: brightness(1.08);
  }

  .footer-brand p {
    max-width: 380px;
    margin: 18px 0 0;
    color: #c8d5c7;
    line-height: 1.65;
  }

  .smc-footer h2 {
    margin: 4px 0 17px;
    color: #fff;
    font-size: 14px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .footer-links,
  .location-list {
    display: grid;
    gap: 10px;
  }

  .footer-links a,
  .location-list span {
    color: #c8d5c7;
    text-decoration: none;
    font-size: 14px;
  }

  .location-list span { display: flex; align-items: center; gap: 7px; }
  .location-list i { color: #8fc682; font-size: 14px; }

  .footer-links a:hover {
    color: #fff;
  }

  .contact-strip {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid rgba(255,255,255,.11);
    display: grid;
    grid-template-columns: 1.25fr .65fr 1fr .75fr;
    gap: 24px;
  }

  .contact-strip > div {
    display: grid;
    gap: 5px;
    color: #e1eae0;
    font-size: 14px;
  }

  .contact-strip .label {
    color: #88a687;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .contact-strip .label .ph {
    font-size: 14px;
  }

  .contact-strip .label .wa-icon {
    width: 14px;
    height: 14px;
  }

  .contact-strip a {
    color: #e1eae0;
    text-decoration: none;
  }

  .smc-footer-bottom {
    border-top: 1px solid rgba(255,255,255,.1);
    padding: 18px 0;
    color: #aebdad;
    font-size: 12px;
  }

  .bottom-inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .bottom-inner div {
    display: flex;
    gap: 18px;
  }

  .bottom-inner a,
  .cookie-settings-trigger {
    color: #aebdad;
    text-decoration: none;
  }

  .cookie-settings-trigger {
    min-height: 24px;
    margin: -5px 0;
    padding: 5px 0;
    border: 0;
    background: transparent;
    font: inherit;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .bottom-inner a:hover,
  .cookie-settings-trigger:hover {
    color: #fff;
  }

  .cookie-settings-trigger i { color: #8fc682; font-size: 14px; }

  .cookie-settings-trigger:focus-visible,
  .cookie-consent-banner button:focus-visible,
  .cookie-modal button:focus-visible,
  .cookie-toggle input:focus-visible + span {
    outline: 3px solid rgba(160, 223, 142, .62);
    outline-offset: 3px;
  }

  .cookie-consent-banner {
    position: fixed;
    z-index: 1990;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 20px clamp(24px, 5vw, 76px);
    border-top: 1px solid #d8e2d5;
    background: rgba(255, 255, 255, .98);
    box-shadow: 0 -12px 38px rgba(12, 38, 17, .12);
    color: #17351d;
    display: grid;
    grid-template-columns: minmax(280px, 1fr) auto;
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    animation: cookie-banner-in .28s ease both;
  }

  .cookie-consent-banner[hidden],
  .cookie-modal[hidden] { display: none !important; }

  .cookie-consent-banner__copy { display: grid; gap: 5px; }
  .cookie-consent-banner__copy strong { color: #102d17; font-size: 17px; }
  .cookie-consent-banner__copy span { max-width: 650px; color: #536552; font-size: 13px; line-height: 1.55; }
  .cookie-consent-banner__actions { display: grid; grid-template-columns: repeat(3, minmax(145px, 1fr)); gap: 10px; }
  .cookie-consent-banner button,
  .cookie-modal__actions button {
    min-height: 46px;
    padding: 0 17px;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 12px;
    background: rgba(255, 255, 255, .06);
    color: #eff8ed;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: transform .18s ease, background-color .18s ease, border-color .18s ease;
  }

  .cookie-consent-banner button:hover,
  .cookie-modal__actions button:hover {
    background: rgba(255, 255, 255, .12);
    border-color: rgba(255, 255, 255, .3);
  }

  .cookie-consent-banner button:active,
  .cookie-modal__actions button:active { transform: translateY(1px); }
  .cookie-consent-banner button.is-primary,
  .cookie-modal__actions button.is-primary { background: #8ed77b; border-color: #8ed77b; color: #0a2b12; }
  .cookie-consent-banner button.is-primary:hover,
  .cookie-modal__actions button.is-primary:hover { background: #a1e28f; border-color: #a1e28f; }

  .cookie-consent-banner button {
    border-color: #c8d7c5;
    background: #fff;
    color: #17351d;
  }

  .cookie-consent-banner button:hover {
    border-color: #9db99a;
    background: #f1f7ef;
  }

  .cookie-consent-banner button.is-primary {
    border-color: #2f8d3d;
    background: #2f8d3d;
    color: #fff;
  }

  .cookie-consent-banner button.is-primary:hover {
    border-color: #267734;
    background: #267734;
  }

  .cookie-modal {
    position: fixed;
    z-index: 2000;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 22px;
  }

  .cookie-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 12, 6, .7);
    backdrop-filter: blur(9px);
    animation: cookie-fade-in .22s ease both;
  }

  .cookie-modal__panel {
    position: relative;
    width: min(620px, 100%);
    max-height: min(760px, calc(100dvh - 44px));
    overflow-y: auto;
    padding: 34px;
    border: 1px solid rgba(161, 213, 145, .24);
    border-radius: 20px;
    background:
      radial-gradient(circle at 8% 0%, rgba(65, 135, 70, .24), transparent 34%),
      #102a16;
    box-shadow: 0 30px 100px rgba(1, 10, 4, .55);
    color: #edf7eb;
    animation: cookie-panel-in .26s cubic-bezier(.2, .75, .25, 1) both;
  }

  .cookie-modal__close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 12px;
    background: rgba(255, 255, 255, .06);
    color: #edf7eb;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .cookie-modal__close:hover { background: rgba(255, 255, 255, .12); }
  .cookie-modal__close i { font-size: 20px; }
  .cookie-modal__heading-icon {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: rgba(142, 215, 123, .14);
    color: #9de189;
    display: grid;
    place-items: center;
    font-size: 24px;
  }

  .cookie-modal__eyebrow {
    margin: 22px 0 7px;
    color: #9cdb8a;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .cookie-modal h2 { margin: 0; color: #fff; font-size: clamp(26px, 4vw, 34px); line-height: 1.1; }
  .cookie-modal h2 + p { margin: 14px 0 25px; color: #c2d0c0; line-height: 1.65; font-size: 14px; max-width: 530px; }

  .cookie-preference-list {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .11);
    border-radius: 16px;
    background: rgba(2, 19, 7, .22);
  }

  .cookie-preference-row {
    min-height: 88px;
    padding: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
  }

  .cookie-preference-row + .cookie-preference-row { border-top: 1px solid rgba(255, 255, 255, .09); }
  .cookie-preference-row > div { display: grid; gap: 5px; }
  .cookie-preference-row strong { color: #f5faf3; font-size: 15px; }
  .cookie-preference-row > div span { color: #aebdac; font-size: 12px; line-height: 1.45; }
  .cookie-always-active { color: #a9e398; font-size: 12px; font-weight: 800; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }

  .cookie-toggle { position: relative; flex: 0 0 auto; }
  .cookie-toggle input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .cookie-toggle span {
    width: 54px;
    height: 30px;
    padding: 3px;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 999px;
    background: #263c2b;
    display: block;
    cursor: pointer;
    transition: background-color .2s ease, border-color .2s ease;
  }

  .cookie-toggle span::after {
    content: '';
    display: block;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 7px rgba(0, 0, 0, .25);
    transition: transform .2s ease;
  }

  .cookie-toggle input:checked + span { background: #58aa4f; border-color: #72ca68; }
  .cookie-toggle input:checked + span::after { transform: translateX(24px); }

  .cookie-modal__actions { margin-top: 24px; display: grid; grid-template-columns: 1fr 1.1fr 1fr; gap: 10px; }

  @keyframes cookie-fade-in { from { opacity: 0; } }
  @keyframes cookie-panel-in { from { opacity: 0; transform: translateY(10px) scale(.975); } }
  @keyframes cookie-banner-in { from { opacity: 0; transform: translateY(9px); } }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .contact-strip {
      grid-template-columns: 1fr 1fr;
    }

    .cookie-consent-banner {
      grid-template-columns: 1fr;
      gap: 15px;
    }
  }

  @media (max-width: 620px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 34px 26px;
    }

    .footer-brand,
    .footer-grid > div:nth-child(2) {
      grid-column: 1 / -1;
    }

    .contact-strip {
      grid-template-columns: 1fr;
    }

    .bottom-inner {
      flex-direction: column;
    }

    .bottom-inner div { flex-wrap: wrap; gap: 12px 18px; }
    .cookie-consent-banner {
      right: 0;
      bottom: 0;
      width: 100%;
      padding: 13px 14px calc(13px + env(safe-area-inset-bottom));
      align-items: stretch;
      gap: 10px;
      border-radius: 0;
      box-shadow: 0 -8px 28px rgba(12, 38, 17, .1);
    }

    .cookie-consent-banner__copy { gap: 2px; }
    .cookie-consent-banner__copy strong { font-size: 15px; line-height: 1.25; }
    .cookie-consent-banner__copy span {
      max-width: none;
      font-size: 11.5px;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    .cookie-consent-banner__actions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 7px;
    }

    .cookie-consent-banner__manage { grid-column: auto; }
    .cookie-consent-banner button {
      min-height: 44px;
      padding: 0 7px;
      border-radius: 10px;
      font-size: 11px;
      line-height: 1.15;
    }
    .cookie-modal { padding: 12px; align-items: end; }
    .cookie-modal__panel { max-height: calc(100dvh - 24px); padding: 26px 18px 18px; border-radius: 20px; }
    .cookie-modal__close { top: 14px; right: 14px; }
    .cookie-modal__heading-icon { width: 42px; height: 42px; }
    .cookie-modal__eyebrow { margin-top: 18px; }
    .cookie-modal h2 { padding-right: 38px; }
    .cookie-preference-row { min-height: 94px; padding: 16px; gap: 14px; }
    .cookie-always-active { white-space: normal; justify-content: flex-end; text-align: right; }
    .cookie-modal__actions { grid-template-columns: 1fr; }
    .cookie-modal__actions button { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent-banner,
    .cookie-modal__backdrop,
    .cookie-modal__panel { animation: none; }
    .cookie-consent-banner button,
    .cookie-modal__actions button,
    .cookie-toggle span,
    .cookie-toggle span::after { transition: none; }
  }
</style>

<script>
  const COOKIE_PREFERENCE_KEY = 'smc_cookie_preferences_v1';

  type CookiePreference = { analytics: boolean; savedAt: string };

  const readCookiePreference = (): CookiePreference | null => {
    try {
      const stored = window.localStorage.getItem(COOKIE_PREFERENCE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (typeof parsed?.analytics === 'boolean') return parsed;
      }
    } catch {}

    const cookie = document.cookie
      .split('; ')
      .find((entry) => entry.startsWith(`${COOKIE_PREFERENCE_KEY}=`));
    if (!cookie) return null;
    const analytics = cookie.split('=')[1] === 'analytics-yes';
    return { analytics, savedAt: '' };
  };

  const initialiseCookieControls = () => {
    const modal = document.querySelector<HTMLElement>('[data-cookie-modal]');
    const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
    if (!modal || !banner || modal.dataset.ready === 'true') return;
    modal.dataset.ready = 'true';

    const panel = modal.querySelector<HTMLElement>('[role="dialog"]');
    const closeButton = modal.querySelector<HTMLButtonElement>('[data-cookie-close]');
    const toggle = modal.querySelector<HTMLInputElement>('[data-analytics-toggle]');
    const settingsButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cookie-settings]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let returnFocus: HTMLElement | null = null;
    let savedScrollY = 0;
    let savedBodyStyles = '';

    const focusableElements = () => Array.from(modal.querySelectorAll<HTMLElement>('button:not([disabled]), input:not([disabled]), a[href]'));

    const showBannerIfNeeded = () => {
      banner.hidden = readCookiePreference() !== null;
    };

    const applyPreference = (analytics: boolean) => {
      const preference: CookiePreference = { analytics, savedAt: new Date().toISOString() };
      try { window.localStorage.setItem(COOKIE_PREFERENCE_KEY, JSON.stringify(preference)); } catch {}
      document.cookie = `${COOKIE_PREFERENCE_KEY}=${analytics ? 'analytics-yes' : 'analytics-no'}; Max-Age=31536000; Path=/; SameSite=Lax; Secure`;
      window.dispatchEvent(new CustomEvent('smc:analytics-consent', { detail: { granted: analytics } }));
      banner.hidden = true;
    };

    const unlockBody = () => {
      document.body.style.cssText = savedBodyStyles;
      const scrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo({ top: savedScrollY, behavior: 'auto' });
      document.documentElement.style.scrollBehavior = scrollBehavior;
    };

    const closeModal = (restoreFocus = true) => {
      if (modal.hidden) return;
      modal.hidden = true;
      unlockBody();
      if (restoreFocus) returnFocus?.focus({ preventScroll: true });
    };

    const openModal = (trigger?: HTMLElement) => {
      const preference = readCookiePreference();
      if (toggle) toggle.checked = preference?.analytics === true;
      returnFocus = trigger || (document.activeElement instanceof HTMLElement ? document.activeElement : null);
      savedScrollY = window.scrollY;
      savedBodyStyles = document.body.style.cssText;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
      modal.hidden = false;
      if (!reducedMotion.matches) panel?.getBoundingClientRect();
      closeButton?.focus({ preventScroll: true });
    };

    const choose = (analytics: boolean) => {
      applyPreference(analytics);
      closeModal();
    };

    settingsButtons.forEach((button) => button.addEventListener('click', () => openModal(button)));
    banner.querySelector('[data-cookie-reject]')?.addEventListener('click', () => applyPreference(false));
    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => applyPreference(true));
    closeButton?.addEventListener('click', () => closeModal());
    modal.querySelector('[data-cookie-backdrop]')?.addEventListener('click', () => closeModal());
    modal.querySelector('[data-modal-reject]')?.addEventListener('click', () => choose(false));
    modal.querySelector('[data-modal-accept]')?.addEventListener('click', () => choose(true));
    modal.querySelector('[data-cookie-save]')?.addEventListener('click', () => choose(toggle?.checked === true));

    document.addEventListener('keydown', (event) => {
      if (modal.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeModal();
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = focusableElements();
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    showBannerIfNeeded();
  };

  initialiseCookieControls();
  document.addEventListener('astro:page-load', initialiseCookieControls);
</script>
