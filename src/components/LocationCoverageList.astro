---
import { priorityCoverageLocations, uaeLocationGroups } from '../lib/locations';

interface Props {
  variant?: 'cards' | 'lines';
  showAllLabel?: string;
}

const {
  variant = 'cards',
  showAllLabel = 'View all covered areas'
} = Astro.props;
---

<div class:list={['location-coverage', `location-coverage--${variant}`]}>
  <ul class="location-coverage__priority" aria-label="Priority UAE coverage locations">
    {priorityCoverageLocations.map((location) => (
      <li><i class="ph ph-map-pin" aria-hidden="true"></i>{location}</li>
    ))}
  </ul>

  <details class="location-coverage__all">
    <summary>
      <span>{showAllLabel}</span>
      <i class="ph ph-caret-down" aria-hidden="true"></i>
    </summary>
    <div class="location-coverage__groups">
      {uaeLocationGroups.map((group) => (
        <section aria-labelledby={`location-group-${group.id}`}>
          <h3 id={`location-group-${group.id}`}>{group.label}</h3>
          <ul>
            {group.locations.map((location) => <li>{location}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </details>
</div>

<style>
  .location-coverage__priority {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .location-coverage__priority li {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    color: #29442e;
    font-size: 14px;
    font-weight: 650;
  }

  .location-coverage--cards .location-coverage__priority li {
    min-height: 58px;
    padding: 14px;
    border: 1px solid #dce6d9;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 7px 18px rgba(20, 53, 29, .045);
  }

  .location-coverage--lines .location-coverage__priority {
    gap: 0 18px;
  }

  .location-coverage--lines .location-coverage__priority li {
    min-height: 39px;
    padding: 8px 0;
    border-bottom: 1px solid #dce6d9;
  }

  .location-coverage--lines .location-coverage__priority li:nth-child(-n + 2) {
    border-top: 1px solid #dce6d9;
  }

  .location-coverage__priority i {
    flex: 0 0 auto;
    color: #3c8e2f;
    font-size: 18px;
  }

  .location-coverage__all {
    margin-top: 14px;
    border: 1px solid #d4e2d1;
    border-radius: 14px;
    background: rgba(255, 255, 255, .82);
  }

  .location-coverage__all summary {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 15px;
    list-style: none;
    cursor: pointer;
    color: #245c2d;
    font-size: 13px;
    font-weight: 800;
  }

  .location-coverage__all summary::-webkit-details-marker { display: none; }
  .location-coverage__all summary i { transition: transform 160ms ease; }
  .location-coverage__all[open] summary i { transform: rotate(180deg); }

  .location-coverage__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    max-height: 360px;
    overflow: auto;
    padding: 6px 15px 17px;
    border-top: 1px solid #e1ebe0;
  }

  .location-coverage__groups section:first-child { grid-column: 1 / -1; }
  .location-coverage__groups h3 { margin: 12px 0 8px; color: #17331d; font-size: 13px; }
  .location-coverage__groups ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .location-coverage__groups li { color: #5c685d; font-size: 12px; line-height: 1.45; }

  @media (max-width: 620px) {
    .location-coverage__priority { gap: 8px; }
    .location-coverage--cards .location-coverage__priority li { min-height: 50px; padding: 11px; font-size: 13px; }
    .location-coverage__groups { grid-template-columns: 1fr; max-height: 420px; }
    .location-coverage__groups section:first-child { grid-column: auto; }
    .location-coverage__groups ul { grid-template-columns: 1fr; }
  }
</style>
