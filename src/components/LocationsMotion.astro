<script>
  function initialiseLocationHub() {
    const root = document.querySelector<HTMLElement>('[data-location-hub]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-region-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-region-panel]'));
    const selectRegion = (id: string, focusTab = false) => {
      tabs.forEach(tab => {
        const active = tab.dataset.regionTab === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focusTab) tab.focus();
      });
      panels.forEach(panel => {
        panel.hidden = panel.id !== id;
      });
    };

    // Without JavaScript all three regional guides remain readable.
    root.classList.add('tabs-ready');
    if (panels[0]) selectRegion(panels[0].id);
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectRegion(tab.dataset.regionTab!));
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        selectRegion(tabs[next].dataset.regionTab!, true);
      });
    });
    const revealDestination = (hash: string) => {
      const id = hash.replace(/^#/, '');
      const destination = document.getElementById(id);
      const panel = destination?.closest<HTMLElement>('[data-region-panel]');
      if (panel && root.contains(panel)) selectRegion(panel.id);
      if (destination instanceof HTMLDetailsElement && root.contains(destination)) destination.open = true;
    };
    root.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const destination = document.getElementById(link.hash.slice(1));
        if (!destination) return;
        event.preventDefault();
        revealDestination(link.hash);
        if (window.location.hash !== link.hash) window.history.pushState(null, '', link.hash);
        const focusTarget = destination instanceof HTMLDetailsElement ? destination.querySelector('summary') : destination;
        if (focusTarget instanceof HTMLElement) focusTarget.focus({ preventScroll: true });
        destination.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
      });
    });
    window.addEventListener('hashchange', () => revealDestination(window.location.hash));
    revealDestination(window.location.hash);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduced.matches || !('IntersectionObserver' in window)) return;
    const targets = root.querySelectorAll<HTMLElement>('[data-reveal]');
    targets.forEach((target, index) => target.style.setProperty('--reveal-delay', `${(index % 3) * 65}ms`));
    root.classList.add('motion-ready');
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('is-visible');
      observer.unobserve(entry.target);
    }), { threshold: .05, rootMargin: '0px 0px 65px 0px' });
    targets.forEach(target => observer.observe(target));

    const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
    const progress = root.querySelector<HTMLElement>('[data-scroll-progress]');
    const desktop = window.matchMedia('(min-width: 981px)');
    let frame = 0;
    const update = () => {
      frame = 0;
      const bounds = root.getBoundingClientRect();
      const value = Math.max(0, Math.min(1, -bounds.top / Math.max(1, root.offsetHeight - window.innerHeight)));
      progress?.style.setProperty('--scroll-progress', String(value));
      scenes.forEach(scene => {
        const rect = scene.getBoundingClientRect();
        const shift = desktop.matches && !reduced.matches ? Math.max(-12, Math.min(12, (rect.top + rect.height / 2 - window.innerHeight / 2) * -.025)) : 0;
        scene.style.setProperty('--scene-shift', `${shift.toFixed(1)}px`);
      });
    };
    const requestUpdate = () => { if (!frame) frame = window.requestAnimationFrame(update); };
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    reduced.addEventListener('change', () => {
      if (reduced.matches) {
        root.classList.remove('motion-ready');
        observer.disconnect();
      }
      requestUpdate();
    });
    update();
  }
  initialiseLocationHub();
  document.addEventListener('astro:page-load', initialiseLocationHub);
</script>
