# Development and preview must remain blocked from search engines.
PUBLIC_SEO_ENV=staging
PUBLIC_SITE_URL=https://www.scrapmycaruae.com
WIX_QUOTE_REQUESTS_COLLECTION_ID=QuoteRequestsStaging

# Google Tag Manager is the only frontend analytics loader. Keep preview disabled.
PUBLIC_GTM_ID=GTM-TFQ7BDGX
PUBLIC_ANALYTICS_ENABLED=false

# Production only: set these in the manual production deployment environment.
# `npm run deploy` refuses to deploy unless both SEO values are exact. The
# production deployment uses `wrangler deploy --env production`, which targets
# smc-headless-production. Never use the staging Worker for production.
# PUBLIC_SEO_ENV=production
# PUBLIC_SITE_URL=https://www.scrapmycaruae.com
# WIX_QUOTE_REQUESTS_COLLECTION_ID=QuoteRequests
# PUBLIC_GTM_ID=GTM-TFQ7BDGX
# PUBLIC_ANALYTICS_ENABLED=true
