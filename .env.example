# Development and preview must remain blocked from search engines.
PUBLIC_SEO_ENV=staging
PUBLIC_SITE_URL=https://www.scrapmycaruae.com
WIX_QUOTE_REQUESTS_COLLECTION_ID=QuoteRequestsStaging

# Optional frontend analytics require consent. Keep preview disabled.
PUBLIC_GTM_ID=GTM-TFQ7BDGX
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_CLOUDFLARE_ANALYTICS_ENABLED=false
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
PUBLIC_POSTHOG_ENABLED=false
PUBLIC_POSTHOG_PROJECT_TOKEN=

# Production only: set these in the production deployment environment.
# `npm run deploy` refuses to deploy unless both values are exact.
# PUBLIC_SEO_ENV=production
# PUBLIC_SITE_URL=https://www.scrapmycaruae.com
# WIX_QUOTE_REQUESTS_COLLECTION_ID=QuoteRequests
# PUBLIC_GTM_ID=GTM-TFQ7BDGX
# PUBLIC_ANALYTICS_ENABLED=true

# Optional Cloudflare Web Analytics: after a separate production target is approved.
# Use manual setup; disable Cloudflare automatic injection and any GTM Cloudflare tag.
# PUBLIC_CLOUDFLARE_ANALYTICS_ENABLED=true
# PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=49956eb062ca47e2b1c53997795bee44

# Optional PostHog EU project (public client token; not a personal API key).
# Enable only after approved production deployment and privacy/consent verification.
# PUBLIC_POSTHOG_ENABLED=true
# PUBLIC_POSTHOG_PROJECT_TOKEN=phc_zG9bjERuCQj24G35otmpmEgD3Ui9j7AoJJv85wHivfpc
