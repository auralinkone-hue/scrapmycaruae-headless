# Development and preview must remain blocked from search engines.
PUBLIC_SEO_ENV=staging
PUBLIC_SITE_URL=https://www.scrapmycaruae.com
WIX_QUOTE_REQUESTS_COLLECTION_ID=QuoteRequestsStaging

# Production only: set these in the production deployment environment.
# `npm run deploy` refuses to deploy unless both values are exact.
# PUBLIC_SEO_ENV=production
# PUBLIC_SITE_URL=https://www.scrapmycaruae.com
# WIX_QUOTE_REQUESTS_COLLECTION_ID=QuoteRequests
